// Generates the street layout of a city district as a graph.
//
// The land is one big rectangle. Roads are laid across it about 100 meters
// apart, each centerline nudged off its ideal position so that block sizes
// vary, which gives a Manhattan grid that is regular without being uniform. A
// few interior street segments are then dropped, leaving a T-junction at either
// end and merging the two blocks the segment separated into one bigger lot.
//
// The layout becomes a graph of nodes. A node is an intersection, a street
// segment or a lot, and owns a polygon with exactly 4 vertices along with the
// nodes surrounding it: a lot is bordered by streets, and a street runs between
// two intersections with a lot on either side.
//
// All positions and dimensions are in meters, on the XZ ground plane, with X
// pointing east and Z pointing south. Y would be up.

// --- Constants ---

// Extent of the land
let LAND_W = 1000.0;
let LAND_D = 1000.0;

// Roads are laid down about this far apart
let SPACING = 100.0;

// How far a road centerline may sit from its ideal position on the grid
let OFFSET = 18.0;

// Every third road is a 4-lane avenue, the rest are 2-lane streets
let AVENUE_EVERY = 3;

// A road is its lanes plus a sidewalk on either side
let LANE_W = 3.5;
let SIDEWALK_W = 2.5;

// Chance in percent that a street segment is dropped to leave a T-junction
let DROP_PERCENT = 12;

let WIN_SIZE = 800;
let MARGIN = 16.0;

fun rgb32(r, g, b) {
    return 0xFF_00_00_00 | (r << 16) | (g << 8) | b;
}

let BACKGROUND = rgb32(22, 25, 31);
let GROUND_COLOR = rgb32(60, 64, 70);
let LOT_COLOR = rgb32(150, 150, 150);
let ROAD_COLOR = rgb32(0, 0, 0);
let NODE_COLOR = rgb32(255, 214, 0);

// --- Random numbers ---
//
// A linear congruential generator, kept here so this program is self-contained.

let var lcg_seed = 1;

fun rand_init(seed) {
    lcg_seed = seed & 0x7FFF_FFFF;
}

fun rand_next() {
    lcg_seed = (lcg_seed * 1073716837 + 12345) & 0x7FFF_FFFF;
    return lcg_seed;
}

// Random integer in [min_val, max_val). The low bits of an LCG are the least
// random, so they get dropped.
fun rand_int(min_val, max_val) {
    return min_val + ((rand_next() >> 8) % (max_val - min_val));
}

// Random float in [min_val, max_val)
fun rand_float(min_val, max_val) {
    let t = rand_next().to_f() / 2147483648.0;
    return min_val + t * (max_val - min_val);
}

// --- Geometry ---

// A point on the ground plane, in meters
class Vec2 {
    init(self, x, z) {
        self.x = x;
        self.z = z;
    }
}

// An axis-aligned rectangle as a polygon with 4 vertices, corners in order
fun rect(x0, z0, x1, z1) {
    return [Vec2(x0, z0), Vec2(x1, z0), Vec2(x1, z1), Vec2(x0, z1)];
}

fun poly_center(poly) {
    let var x = 0.0;
    let var z = 0.0;
    for (let var k = 0; k < poly.len; ++k) {
        x = x + poly[k].x;
        z = z + poly[k].z;
    }
    return Vec2(x / poly.len.to_f(), z / poly.len.to_f());
}

// Shoelace formula, in square meters
fun poly_area(poly) {
    let var s = 0.0;
    for (let var k = 0; k < poly.len; ++k) {
        let a = poly[k];
        let b = poly[(k + 1) % poly.len];
        s = s + a.x * b.z - b.x * a.z;
    }
    return (s * 0.5).abs();
}

// --- Road dimensions ---

// Width of the right-of-way, roadway plus sidewalks
fun road_width(num_lanes) {
    return num_lanes.to_f() * LANE_W + 2.0 * SIDEWALK_W;
}

fun half_width(num_lanes) {
    return road_width(num_lanes) * 0.5;
}

// How many parallel roads fit across a span at the target spacing
fun num_roads(span) {
    return (span / SPACING + 0.5).floor() + 1;
}

fun lane_counts(count) {
    let out = [];
    for (let var i = 0; i < count; ++i) {
        if (i % AVENUE_EVERY == 0)
            out.push(4);
        else
            out.push(2);
    }
    return out;
}

// Road centerlines along one axis. The two outer roads hug the border so that
// the whole network fits on the land, and each road in between sits a small
// random offset away from its ideal position on the grid, which is what makes
// the blocks vary in size.
fun centerlines(span, lanes) {
    let last = lanes.len - 1;
    let out = [];

    for (let var i = 0; i <= last; ++i) {
        if (i == 0)
            out.push(half_width(lanes[i]));
        else if (i == last)
            out.push(span - half_width(lanes[i]));
        else
            out.push(span * i.to_f() / last.to_f() + rand_float(-OFFSET, OFFSET));
    }

    return out;
}

// --- City graph ---

class Node {
    init(self, id, kind, poly) {
        self.id = id;
        self.kind = kind;       // "intersection", "street" or "lot"
        self.poly = poly;       // Polygon with 4 vertices, in meters
        self.neighbors = [];    // The nodes surrounding this one
        self.num_lanes = nil;   // Streets only: 2 or 4
    }

    center(self) { return poly_center(self.poly); }
    area(self) { return poly_area(self.poly); }

    link(self, other) {
        self.neighbors.push(other);
        other.neighbors.push(self);
    }
}

// The grid is described by the centerlines of the roads running each way. A
// north-south road i runs down x = xs[i], an east-west road j runs along
// z = zs[j], and the two cross at a crossing (i, j). The stretch of road
// between two adjacent crossings is a street segment, and the block of land
// enclosed by four crossings is a cell.
class CityLayout {
    init(self) {
        self.width = LAND_W;
        self.depth = LAND_D;
        self.land = rect(0.0, 0.0, LAND_W, LAND_D);
        self.nodes = [];

        self.x_lanes = lane_counts(num_roads(LAND_W));
        self.z_lanes = lane_counts(num_roads(LAND_D));
        self.xs = centerlines(LAND_W, self.x_lanes);
        self.zs = centerlines(LAND_D, self.z_lanes);

        self.hx = [];
        for (let var i = 0; i < self.x_lanes.len; ++i)
            self.hx.push(half_width(self.x_lanes[i]));
        self.hz = [];
        for (let var j = 0; j < self.z_lanes.len; ++j)
            self.hz.push(half_width(self.z_lanes[j]));

        self.init_grid();
        self.drop_streets();
        self.build_graph();
    }

    add(self, node) {
        self.nodes.push(node);
        return node;
    }

    // All the nodes of one kind: "intersection", "street" or "lot"
    nodes_of(self, kind) {
        let out = [];
        for (let var i = 0; i < self.nodes.len; ++i) {
            if (self.nodes[i].kind == kind)
                out.push(self.nodes[i]);
        }
        return out;
    }

    // Which street segments are still there, how many roads leave each
    // crossing, and how many cells each block of land covers
    init_grid(self) {
        let nx = self.xs.len;
        let nz = self.zs.len;

        // ew_open[i][j] is the segment along road j, between roads i and i + 1,
        // and ns_open[i][j] the one down road i, between roads j and j + 1
        self.ew_open = [];
        self.ns_open = [];
        self.legs = [];
        for (let var i = 0; i < nx; ++i) {
            let ew = [];
            let ns = [];
            let legs = [];
            for (let var j = 0; j < nz; ++j) {
                ew.push(i < nx - 1);
                ns.push(j < nz - 1);

                // A road leaves the crossing in each direction that stays on the land
                let var n = 0;
                if (i > 0) n = n + 1;
                if (i < nx - 1) n = n + 1;
                if (j > 0) n = n + 1;
                if (j < nz - 1) n = n + 1;
                legs.push(n);
            }
            self.ew_open.push(ew);
            self.ns_open.push(ns);
            self.legs.push(legs);
        }

        // A cell that grew into its neighbor covers 2 cells on one axis, and the
        // one that got swallowed is left out of the layout
        self.lot_w = [];
        self.lot_d = [];
        self.absorbed = [];
        for (let var i = 0; i < nx - 1; ++i) {
            let w = [];
            let d = [];
            let a = [];
            for (let var j = 0; j < nz - 1; ++j) {
                w.push(1);
                d.push(1);
                a.push(false);
            }
            self.lot_w.push(w);
            self.lot_d.push(d);
            self.absorbed.push(a);
        }
    }

    // A cell that is still on its own, and so free to grow into a neighbor
    free_cell(self, i, j) {
        return !self.absorbed[i][j] && self.lot_w[i][j] == 1 && self.lot_d[i][j] == 1;
    }

    // Drops a few street segments, so that the grid is not all 4-way crossings
    drop_streets(self) {
        let nx = self.xs.len;
        let nz = self.zs.len;

        for (let var i = 0; i < nx - 1; ++i) {
            for (let var j = 0; j < nz; ++j) {
                if (rand_int(0, 100) < DROP_PERCENT)
                    self.drop_ew(i, j);
            }
        }

        for (let var i = 0; i < nx; ++i) {
            for (let var j = 0; j < nz - 1; ++j) {
                if (rand_int(0, 100) < DROP_PERCENT)
                    self.drop_ns(i, j);
            }
        }
    }

    // A segment only goes away if both of its ends are 4-way crossings, which
    // keeps the border of the land intact and leaves a T-junction at either end.
    // The two blocks it separated become one, and since a block only ever grows
    // once, every lot stays a rectangle.
    drop_ew(self, i, j) {
        if (self.legs[i][j] != 4 || self.legs[i + 1][j] != 4)
            return;
        if (!self.free_cell(i, j - 1) || !self.free_cell(i, j))
            return;

        self.ew_open[i][j] = false;
        self.legs[i][j] = 3;
        self.legs[i + 1][j] = 3;
        self.lot_d[i][j - 1] = 2;
        self.absorbed[i][j] = true;
    }

    drop_ns(self, i, j) {
        if (self.legs[i][j] != 4 || self.legs[i][j + 1] != 4)
            return;
        if (!self.free_cell(i - 1, j) || !self.free_cell(i, j))
            return;

        self.ns_open[i][j] = false;
        self.legs[i][j] = 3;
        self.legs[i][j + 1] = 3;
        self.lot_w[i - 1][j] = 2;
        self.absorbed[i][j] = true;
    }

    build_graph(self) {
        let crossings = self.add_intersections();
        let cells = self.add_lots();
        self.add_streets(crossings, cells);
    }

    // One node per crossing, returned indexed by [i][j]
    add_intersections(self) {
        let out = [];

        for (let var i = 0; i < self.xs.len; ++i) {
            let col = [];
            for (let var j = 0; j < self.zs.len; ++j) {
                col.push(self.add(Node(self.nodes.len, "intersection", rect(
                    self.xs[i] - self.hx[i], self.zs[j] - self.hz[j],
                    self.xs[i] + self.hx[i], self.zs[j] + self.hz[j]
                ))));
            }
            out.push(col);
        }

        return out;
    }

    // One node per block of land, returned indexed by [i][j] so that every cell
    // the block covers points at it
    add_lots(self) {
        let out = [];
        for (let var i = 0; i < self.xs.len - 1; ++i)
            out.push(Array.with_size(self.zs.len - 1, nil));

        for (let var i = 0; i < self.xs.len - 1; ++i) {
            for (let var j = 0; j < self.zs.len - 1; ++j) {
                if (self.absorbed[i][j])
                    continue;

                let w = self.lot_w[i][j];
                let d = self.lot_d[i][j];
                let lot = self.add(Node(self.nodes.len, "lot", rect(
                    self.xs[i] + self.hx[i], self.zs[j] + self.hz[j],
                    self.xs[i + w] - self.hx[i + w], self.zs[j + d] - self.hz[j + d]
                )));

                for (let var a = 0; a < w; ++a) {
                    for (let var b = 0; b < d; ++b)
                        out[i + a][j + b] = lot;
                }
            }
        }

        return out;
    }

    // One node per stretch of road between two crossings. Every edge of the
    // graph is drawn from here: a street links the intersection at either end
    // and the lot on either side, which is all the neighbors any node has.
    add_streets(self, crossings, cells) {
        let nx = self.xs.len;
        let nz = self.zs.len;

        for (let var i = 0; i < nx; ++i) {
            for (let var j = 0; j < nz; ++j) {
                if (i < nx - 1 && self.ew_open[i][j]) {
                    let street = self.add_street(rect(
                        self.xs[i] + self.hx[i], self.zs[j] - self.hz[j],
                        self.xs[i + 1] - self.hx[i + 1], self.zs[j] + self.hz[j]
                    ), self.z_lanes[j]);

                    street.link(crossings[i][j]);
                    street.link(crossings[i + 1][j]);
                    if (j > 0)
                        street.link(cells[i][j - 1]);
                    if (j < nz - 1)
                        street.link(cells[i][j]);
                }

                if (j < nz - 1 && self.ns_open[i][j]) {
                    let street = self.add_street(rect(
                        self.xs[i] - self.hx[i], self.zs[j] + self.hz[j],
                        self.xs[i] + self.hx[i], self.zs[j + 1] - self.hz[j + 1]
                    ), self.x_lanes[i]);

                    street.link(crossings[i][j]);
                    street.link(crossings[i][j + 1]);
                    if (i > 0)
                        street.link(cells[i - 1][j]);
                    if (i < nx - 1)
                        street.link(cells[i][j]);
                }
            }
        }
    }

    add_street(self, poly, num_lanes) {
        let street = self.add(Node(self.nodes.len, "street", poly));
        street.num_lanes = num_lanes;
        return street;
    }
}

// --- Rendering ---

class View {
    init(self, size) {
        self.size = size;
        self.scale = (size.to_f() - 2.0 * MARGIN) / LAND_W.max(LAND_D);
        self.fb = ByteArray.with_size(size * size * 4);
    }

    // Meters to pixels
    px(self, v) {
        return Vec2(MARGIN + v.x * self.scale, MARGIN + v.z * self.scale);
    }

    // Scanline fill of a convex polygon
    fill(self, poly, color) {
        let p = [];
        let var top = 1.0e9;
        let var bot = -1.0e9;
        for (let var k = 0; k < poly.len; ++k) {
            let s = self.px(poly[k]);
            p.push(s);
            top = top.min(s.z);
            bot = bot.max(s.z);
        }

        let y0 = top.floor().max(0);
        let y1 = bot.ceil().min(self.size);

        for (let var y = y0; y < y1; ++y) {
            let yc = y.to_f() + 0.5;
            let var lo = 1.0e9;
            let var hi = -1.0e9;

            // Where the scanline crosses the outline of the polygon
            for (let var k = 0; k < p.len; ++k) {
                let a = p[k];
                let b = p[(k + 1) % p.len];
                if ((a.z <= yc && b.z > yc) || (b.z <= yc && a.z > yc)) {
                    let x = a.x + (b.x - a.x) * (yc - a.z) / (b.z - a.z);
                    lo = lo.min(x);
                    hi = hi.max(x);
                }
            }

            let x0 = lo.floor().max(0);
            let x1 = hi.ceil().min(self.size);
            if (x1 > x0)
                self.fb.fill_u32(y * self.size + x0, x1 - x0, color);
        }
    }

    fill_kind(self, layout, kind, color) {
        let nodes = layout.nodes_of(kind);
        for (let var i = 0; i < nodes.len; ++i)
            self.fill(nodes[i].poly, color);
    }

    // The lots first, then the roads over them and the intersections on top
    draw(self, layout) {
        self.fb.fill_u32(0, self.size * self.size, BACKGROUND);
        self.fill(layout.land, GROUND_COLOR);
        self.fill_kind(layout, "lot", LOT_COLOR);
        self.fill_kind(layout, "street", ROAD_COLOR);
        self.fill_kind(layout, "intersection", NODE_COLOR);
    }
}

// --- Main ---

fun print_summary(layout) {
    let crossings = layout.nodes_of("intersection");
    let streets = layout.nodes_of("street");
    let lots = layout.nodes_of("lot");

    let var tees = 0;
    for (let var i = 0; i < crossings.len; ++i) {
        if (crossings[i].neighbors.len == 3)
            tees = tees + 1;
    }

    let var avenues = 0;
    for (let var i = 0; i < streets.len; ++i) {
        if (streets[i].num_lanes == 4)
            avenues = avenues + 1;
    }

    let var lot_area = 0.0;
    for (let var i = 0; i < lots.len; ++i)
        lot_area = lot_area + lots[i].area();

    $println("land:          " + LAND_W.format_decimals(0) + " x " + LAND_D.format_decimals(0) + " m");
    $println("intersections: " + crossings.len.to_s() + " (" + tees.to_s() + " T-junctions)");
    $println("streets:       " + streets.len.to_s() + " (" + avenues.to_s() + " on 4-lane avenues)");
    $println("lots:          " + lots.len.to_s() + " (mean " + (lot_area / lots.len.to_f()).format_decimals(0) + " m2)");
    $println("nodes:         " + layout.nodes.len.to_s());
}

rand_init($time_current_ms());

let var layout = CityLayout();
let view = View(WIN_SIZE);
let window = $window_create(WIN_SIZE, WIN_SIZE, "City Layout (any key for a new city)", 0);

print_summary(layout);
view.draw(layout);
$window_draw_frame(window, view.fb);

loop {
    let msg = $actor_recv();

    if (msg instanceof UIEvent) {
        if (msg.kind == 'CLOSE_WINDOW' || (msg.kind == 'KEY_DOWN' && msg.key == 'ESCAPE'))
            break;

        if (msg.kind == 'KEY_DOWN') {
            layout = CityLayout();
            $println("");
            print_summary(layout);
            view.draw(layout);
            $window_draw_frame(window, view.fb);
        }
    }
}
