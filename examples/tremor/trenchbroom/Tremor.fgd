// Entity definitions for editing tremor maps in TrenchBroom.
// One unit is 2.5 cm (40 units to the meter), and +Z is up.

@SolidClass = worldspawn : "World entity"
[
    moonlight(float) : "Brightness of the light from the moon in the sky, 0 for none" : "0"
]

@SolidClass = func_brush : "Level geometry with a forced light level, an alpha, or a flow override"
[
    light(integer) : "Light level for every face to show at instead of baking one, 0 to 15. Not needed for lamps: light_* textures are full bright anyway"
    alpha(float) : "Opacity, 0 to 1. Below 1 the brush is see-through and lets light through" : "1"
    flow(choices) : "Whether the faces swim and burn at full brightness. By default lava* and water* textures do" =
    [
        0 : "No"
        1 : "Yes"
    ]
]

@SolidClass = func_door : "Door that slides up when the player comes close. Its texture is shown once across each face."
[
    lift(integer) : "How far it rises to open, in units" : 128
    from(choices) : "Open only for someone on this side, and then stay open" =
    [
        "nx" : "-X side"
        "px" : "+X side"
        "ny" : "-Y side"
        "py" : "+Y side"
    ]
    key(choices) : "Keycard the player needs to open it" =
    [
        "blue" : "Blue keycard"
    ]
]

@PointClass size(-16 -16 0, 16 16 68) color(0 255 0) = info_player_start : "Where the player starts, standing at the origin"
[
    angle(integer) : "Facing, in degrees" : 0
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 255 0) = light : "Point light"
[
    radius(float) : "How far it reaches, in units" : "400"
    brightness(float) : "How strong it is" : "1"
]

@baseclass size(-16 -16 0, 16 16 16) color(0 200 255) = Pickup
[
    angle(integer) : "Facing, in degrees" : 0
]

@PointClass base(Pickup) = health_kit : "Health kit, 25 health" []
@PointClass base(Pickup) = armor_shard : "Armor shard" []
@PointClass base(Pickup) = shotgun : "Shotgun, with 8 shells" []
@PointClass base(Pickup) = shotgun_ammo : "Box of 10 shotgun shells" []
@PointClass base(Pickup) = keycard : "Keycard, turning on the spot. Set the origin above the floor to have it float." []

@PointClass size(-24 -24 0, 24 24 80) color(255 0 0) = claw_cyborg : "Claw cyborg"
[
    angle(integer) : "Facing, in degrees" : 0
]

@PointClass size(-16 -16 0, 16 16 68) color(255 128 0) = anime_girl : "Figure playing its idle animation"
[
    angle(integer) : "Facing, in degrees" : 0
]

@PointClass size(-16 -16 0, 16 16 24) color(255 255 255) = relic : "Skull hanging in the air at full brightness, with a white aura. It hangs with its base at the origin."
[
    angle(integer) : "Facing, in degrees" : 0
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 0 128) = gib_chute : "Drops gibs from here, with a squish when they land"
[
]
