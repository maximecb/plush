// The renderer: turns the world's BSP tree and a camera into a frame.
//
// Every frame the faces are handed to the rasterizer front to back, in an
// order a BSP tree over their own planes makes exact, and an s-buffer keeps a
// list of the parts of each scanline already covered, so a pixel is only ever
// written once however much geometry stands behind it.
//
// A face given an alpha in the map is the exception, and the one thing the
// front to back order cannot serve directly: what it blends over has not been
// drawn yet. It is met like anything else and asks the s-buffer which parts of
// it are in view, which is already the final answer at that moment, but claims
// none of them; those spans are written down and replayed once the frame is
// otherwise finished, in reverse, so each one blends over completed pixels and
// glass behind glass falls out in the right order.
//
// What no polygon claimed is sky, and the s-buffer already knows which pixels
// those are: its intervals are sorted and coalesced, so the gaps between them
// need only be walked once a scanline and painted from a gradient baked along
// the world's up axis. This runs between the two passes rather than after them
// both, because the opaque pass is what decides where the sky is and the blend
// pass needs it already there to composite against. Drawing the moon and stars
// through the same walk is what lets a building eclipse them.
//
// The span loop is the one from examples/textured_cube.psh: u and v are packed
// into the two halves of one integer so a single add steps both. Here it runs
// over sub-spans, with the perspective divide done once per sub-span, which is
// what keeps long walls and floors from shearing. How long a sub-span runs
// follows how fast 1/z is changing, so a wall square to the eye is covered in
// one piece and only a surface seen edge on pays for a divide every few pixels.
//
// Light is baked per face at load time (see lighting.psh), and applied per
// pixel by scaling each texel as it is read.
//
// Frames are rendered by a pool of actors, each drawing horizontal bands.

from image import Image;
from random import Xoshiro128;
from ./config import FRAME_WIDTH, FRAME_HEIGHT;
from ./world import MOON_AZ, MOON_EL;
from ./models import models, Projection, Light;

// Projection. FOCAL is half the frame width over the tangent of half the
// horizontal field of view, so this is a 90 degree view.
let FOCAL = FRAME_WIDTH.to_f() * 0.5;
let CENTER_X = (FRAME_WIDTH.idiv(2)).to_f();
let CENTER_Y = (FRAME_HEIGHT.idiv(2)).to_f();
let NEAR = 0.2;

// The span loop interpolates texture coordinates in fixed point, with u and v
// packed into the two halves of one integer:
//
//   bits 63..32: v, as 16.16 fixed point
//   bits 31..0:  u, as 16.16 fixed point
//
// Integers in this VM are 62-bit fixnums, and going past that boxes the value
// and allocates, which would be ruinous per pixel. Both halves are therefore
// wrapped into their texture dimensions before the sub-span starts, which
// keeps them under 2^24, and then biased by EXC_FX so that a half stepping backwards
// stays positive instead of borrowing from the half above it. The bias is a
// whole number of texture widths, so the mask at lookup time removes it again.
let FP_BITS = 16;
let FP_ONE = 65536.0;
let U_SHIFT = FP_BITS;
let BIAS_TEXELS = 8192.0;

// The longest a sub-span may run, and the matching cap on how far u or v may
// travel in one pixel. Their product is the backwards step the bias has to
// cover, and the bias in turn bounds how large the packed pair can grow: at a
// length of 64 the packed value passes the 62-bit fixnum limit, and every
// pixel would box.
let SUB_MAX = 32;
let GRAD_LIMIT_FX = 64;
let GRAD_LIMIT = 64.0;
let EXC_FX = (SUB_MAX * GRAD_LIMIT_FX) << FP_BITS;

// How far 1/z may swing across one sub-span, as a fraction of itself. The
// affine step between the ends of a sub-span is exact wherever 1/z holds
// still, so this is what sets the length rather than a fixed count: a wall
// square to the eye runs in one piece, a floor seen edge on is cut fine.
let PERSP_TOL = 0.04;

// The scale is baked per face and evaluated across it, in an accumulator
// carrying this many fractional bits
let L_FRAC = 16;
let L_ONE = 65536.0;
let L_SHIFT = L_FRAC;

// Both ends of a sub-span are clamped to this range before the step between
// them is taken, which is what keeps every pixel along it in range too.
//
// The floor is one whole scale step rather than zero because the step is
// itself floored, so walking a sub-span can undershoot its far end by up to
// one fixed point unit per pixel. Nothing is ever this dark in practice: the
// dimmest a surface goes is MIN_SHADE of the way up.
let L_MIN_FX = 65536;
let L_MAX_FX = 16711680;

// Red and blue sit sixteen bits apart in a pixel, which is what lets them
// share a multiply with green once green is moved out of the way
let MASK_RB = 0x00FF00FF;
let MASK_G = 0x0000FF00;

// The framebuffer consumer currently ignores alpha, so the span loop leaves
// its high byte clear instead of ORing the same constant into every pixel.

// --- Camera state, set with `set_view` ---

let var cam_x = 0.0;
let var cam_y = 1.6;
let var cam_z = 0.0;
let var cam_yaw = 0.0;
let var cam_pitch = 0.0;
let var sin_yaw = 0.0;
let var cos_yaw = 1.0;
let var sin_pitch = 0.0;
let var cos_pitch = 1.0;

// Roll turns the view about the way it looks, after yaw and pitch: eye x and
// y become x cos + y sin and y cos - x sin
let var sin_roll = 0.0;
let var cos_roll = 1.0;

// --- Scratch buffers, reused so that drawing a frame allocates no arrays ---

let MAX_VERTS = 32;

let var aX = Array.with_size(MAX_VERTS, 0.0);
let var aY = Array.with_size(MAX_VERTS, 0.0);
let var aZ = Array.with_size(MAX_VERTS, 0.0);
let var aU = Array.with_size(MAX_VERTS, 0.0);
let var aV = Array.with_size(MAX_VERTS, 0.0);

let var bX = Array.with_size(MAX_VERTS, 0.0);
let var bY = Array.with_size(MAX_VERTS, 0.0);
let var bZ = Array.with_size(MAX_VERTS, 0.0);
let var bU = Array.with_size(MAX_VERTS, 0.0);
let var bV = Array.with_size(MAX_VERTS, 0.0);

// Projected vertices: screen position, and u/z, v/z, 1/z, which are the three
// quantities that are linear in screen space
let pX = Array.with_size(MAX_VERTS, 0.0);
let pY = Array.with_size(MAX_VERTS, 0.0);
let pUZ = Array.with_size(MAX_VERTS, 0.0);
let pVZ = Array.with_size(MAX_VERTS, 0.0);
let pW = Array.with_size(MAX_VERTS, 0.0);

// Reciprocals of the sub-span lengths, so the per-sub-span gradient is a
// multiply rather than a divide
let INV_N = Array.with_size(SUB_MAX + 1, 0.0);
for (let var i = 1; i <= SUB_MAX; ++i) INV_N[i] = 1.0 / i.to_f();

// Gradients of the face being drawn, and its texture
let var g_duzdx = 0.0; let var g_duzdy = 0.0;
let var g_dvzdx = 0.0; let var g_dvzdy = 0.0;
let var g_dwdx = 0.0;  let var g_dwdy = 0.0;
let var g_uz0 = 0.0;   let var g_vz0 = 0.0;   let var g_w0 = 0.0;

// The level of the face being drawn, as a bilinear function of its texture
// coordinates: k + a * cu + b * cv + c * cu * cv, with cu and cv measured from
// the point the fit was centred on. The span loop already carries a
// perspective correct u and v, so this rides in on them and needs no
// interpolant of its own.
let var g_lu0 = 0.0; let var g_lv0 = 0.0;
let var g_l_k = 0.0; let var g_l_u = 0.0; let var g_l_v = 0.0; let var g_l_uv = 0.0;
let var g_ref_x = 0.0; let var g_ref_y = 0.0;
let var g_pix = nil;
let var g_umask = 0;
let var g_vshift = 0;
let var g_vmask = 0;
let var g_uwrap = 0;
let var g_vwrap = 0;

// How much of the destination the face lets through, 0 for an opaque one, and
// the range the interpolated light multiplier is held to. Opaque faces run the
// full scale; a blended one is capped at its own alpha, so that its share and
// the destination's cannot together carry a channel past sixteen bits.
let var g_inv_alpha = 0;
let var g_l_min = L_MIN_FX;
let var g_l_max = L_MAX_FX;

// Whether the polygon being rasterized is one whose spans are being taken down
// for the blending pass rather than drawn. It cannot change inside a polygon,
// so the span loop reads it once and picks its scanline loop with it.
let var g_collecting = false;

let var bsp_root = nil;

// Lava swell. The surface is cut into small quads at load and their corners
// ride a pair of sine waves, one running along x and one along z, so the lava
// actually moves rather than having its texture slid across it. The waves are
// a function of world position, so neighbouring quads agree along the edge they
// share and the surface stays watertight.
let WAVE_AMP = 0.15;
let WAVE_FREQ = 0.98;
let var warp_phase = 0.0;

let var pixels_drawn = 0;
let var rect_faces_skipped = 0;
let var rect_nodes_skipped = 0;

// What the last frame drawn by `render_frame_parallel` cost
class FrameStats {
    init(self) {
        self.pixels_drawn = 0;
        self.faces_skipped = 0;
        self.nodes_skipped = 0;
    }
}

let frame_stats = FrameStats();

let frame_image = Image(FRAME_WIDTH, FRAME_HEIGHT);
let frame_buffer = frame_image.bytes;

// Each render actor owns one horizontal band. These remain full-frame in the
// main actor and are changed only in the private heap of each worker.
let var render_y0 = 0;
let var render_y1 = FRAME_HEIGHT;
let BAND_HEIGHT = 45;

// --- The s-buffer ---

// One covered interval of a scanline. The intervals of a scanline are kept
// sorted, disjoint and coalesced, so what is left between them is exactly what
// is still visible.
//
// They live in parallel arrays and link by index rather than being objects.
// The whole structure is thrown away and rebuilt each frame, so handing them
// out of a bump allocator that resets with it means drawing a frame allocates
// nothing at all, and the collector never runs inside one.
let MAX_SPANS = 16384;
let NO_SPAN = 0 - 1;

let sp_x0 = Array.with_size(MAX_SPANS, 0);
let sp_x1 = Array.with_size(MAX_SPANS, 0);
let sp_next = Array.with_size(MAX_SPANS, NO_SPAN);
let var sp_top = 0;

let sb_head = Array.with_size(FRAME_HEIGHT, NO_SPAN);
let sb_full = ByteArray.with_size(FRAME_HEIGHT * 4);
let var sb_num_full = 0;
let var screen_done = false;

let MAX_VIS = 128;
let vis_x0 = Array.with_size(MAX_VIS, 0);
let vis_x1 = Array.with_size(MAX_VIS, 0);

// --- The model s-buffer ---
//
// Models are not split by the tree's planes, so they get a second s-buffer
// whose spans know how far away they are, the one from
// examples/model_viewer.psh. Each span keeps 1/z as its value at x = 0 and its
// step per pixel, which is linear along a scanline, and a new span takes the
// pixels where it is nearer.
//
// Models are drawn as the tree walk meets them (see `place_models`), and a
// weapon held in view before anything. A face drawn after a model has to be
// nearer than it where it lands, which `mesh_clip` works out from the face's
// own 1/z, and where it is not, the model shows through. The face still marks
// those pixels covered in the face s-buffer, which is right: everything drawn
// after it is behind it, and so behind the model too. What no face claims
// stays the model's, which is why the sky has to go around these spans.
//
// A scanline no model reached has no spans here, and costs a face one test.
let MAX_MESH_SPANS = 65536;

let msp_x0 = Array.with_size(MAX_MESH_SPANS, 0);
let msp_x1 = Array.with_size(MAX_MESH_SPANS, 0);
let msp_w = Array.with_size(MAX_MESH_SPANS, 0.0);
let msp_dw = Array.with_size(MAX_MESH_SPANS, 0.0);
let msp_next = Array.with_size(MAX_MESH_SPANS, NO_SPAN);
let var msp_top = 0;
let var msp_free = NO_SPAN;

let mb_head = Array.with_size(FRAME_HEIGHT, NO_SPAN);

// Whether any model was drawn into this band since the last reset
let var mesh_used = false;

// Where `mesh_clip` gathers the pieces it keeps before copying them back
let clip_x0 = Array.with_size(MAX_VIS, 0);
let clip_x1 = Array.with_size(MAX_VIS, 0);

// Called at the end of a frame, while render_y0/render_y1 are still the band
// the spans were made in
fun mesh_reset() {
    if (!mesh_used) return;
    for (let var y = render_y0; y < render_y1; ++y) mb_head[y] = NO_SPAN;
    msp_top = 0;
    msp_free = NO_SPAN;
    mesh_used = false;
}

// Link a new span into scanline y, between two spans that follow each other,
// either of which may be NO_SPAN. Returns the new span, or the one before if
// the pool is spent, in which case the pixels are left as not covered.
fun msb_link(y, prev, next, x0, x1, w, dw) {
    let var s = msp_free;
    if (s != NO_SPAN) {
        msp_free = msp_next[s];
    } else if (msp_top < MAX_MESH_SPANS) {
        s = msp_top;
        msp_top = msp_top + 1;
    } else {
        return prev;
    }

    msp_x0[s] = x0;
    msp_x1[s] = x1;
    msp_w[s] = w;
    msp_dw[s] = dw;
    msp_next[s] = next;
    if (prev == NO_SPAN) mb_head[y] = s; else msp_next[prev] = s;
    return s;
}

// Insert [x0, x1) into scanline y, with 1/z being w at x = 0 and changing by
// dw per pixel, and report which parts of it are to be drawn, in
// vis_x0/vis_x1: those not covered yet, and those nearer than what is there.
fun msb_insert(y, x0, x1, w, dw) {
    let var n_vis = 0;
    let var prev = NO_SPAN;
    let var cur = mb_head[y];

    // Skip the spans entirely left of x0
    while (cur != NO_SPAN && msp_x1[cur] <= x0) {
        prev = cur;
        cur = msp_next[cur];
    }

    // Everything left of cx has been dealt with. Pixels from run up to cx are
    // a part to draw that is not in the list yet, if run is not negative. It
    // belongs between prev and cur.
    let var cx = x0;
    let var run = 0 - 1;

    while (cur != NO_SPAN && cx < x1) {
        let sx0 = msp_x0[cur];
        if (sx0 >= x1) break;
        let sx1 = msp_x1[cur];

        // Nothing is in the way before this span
        if (sx0 > cx) {
            if (run < 0) run = cx;
            cx = sx0;
        }

        // The pixels shared with this span, and how much nearer the new span
        // is at the first and the last of them
        let var end = sx1 < x1 ? sx1 : x1;
        let dw_diff = dw - msp_dw[cur];
        let w_diff = w - msp_w[cur];
        let near_start = w_diff + cx * dw_diff;
        let near_end = w_diff + (end - 1) * dw_diff;

        // If it is nearer at one end only, the two cross. Stop at the
        // crossing, and the rest comes around again.
        if ((near_start > 0.0) != (near_end > 0.0)) {
            end = ((cx - near_start / dw_diff).floor() + 1).clip(cx + 1, end - 1);
        }

        if (near_start > 0.0) {
            // The new span takes these pixels, and what was there keeps the
            // pixels on either side of them
            if (cx > sx0) {
                let next = msp_next[cur];
                msp_x1[cur] = cx;
                prev = cur;
                cur = next;
                if (end < sx1) cur = msb_link(y, prev, next, end, sx1, msp_w[prev], msp_dw[prev]);
                if (cur == prev) cur = next;
            } else if (end < sx1) {
                msp_x0[cur] = end;
            } else {
                // Nothing is left of it
                let next = msp_next[cur];
                if (prev == NO_SPAN) mb_head[y] = next; else msp_next[prev] = next;
                msp_next[cur] = msp_free;
                msp_free = cur;
                cur = next;
            }

            if (run < 0) run = cx;
            cx = end;
        } else {
            // The new span is hidden here, which ends the part to draw
            if (run >= 0) {
                if (n_vis < MAX_VIS) {
                    vis_x0[n_vis] = run;
                    vis_x1[n_vis] = cx;
                    n_vis = n_vis + 1;
                }
                prev = msb_link(y, prev, cur, run, cx, w, dw);
                run = 0 - 1;
            }

            cx = end;
            if (end == sx1) {
                prev = cur;
                cur = msp_next[cur];
            }
        }
    }

    // Nothing is in the way after the last span
    if (cx < x1) {
        if (run < 0) run = cx;
        cx = x1;
    }

    if (run >= 0) {
        if (n_vis < MAX_VIS) {
            vis_x0[n_vis] = run;
            vis_x1[n_vis] = cx;
            n_vis = n_vis + 1;
        }
        msb_link(y, prev, cur, run, cx, w, dw);
    }

    return n_vis;
}

// Keep the parts of the n pieces in vis_x0/vis_x1 on scanline y where a face
// whose 1/z is w at x = 0, changing by dw per pixel, is nearer than any model
// span there. The pieces left are written back to vis_x0/vis_x1, and their
// number returned. The model spans are left as they are.
fun mesh_clip(y, n, w, dw) {
    let var m = 0;

    for (let var k = 0; k < n; ++k) {
        let var cx = vis_x0[k];
        let x1 = vis_x1[k];
        let var cur = mb_head[y];
        while (cur != NO_SPAN && msp_x1[cur] <= cx) cur = msp_next[cur];

        while (cx < x1 && m < MAX_VIS) {
            // Clear of every model span from here on
            if (cur == NO_SPAN || msp_x0[cur] >= x1) {
                clip_x0[m] = cx; clip_x1[m] = x1; m = m + 1;
                break;
            }

            // Clear up to the next model span
            let sx0 = msp_x0[cur];
            if (sx0 > cx) {
                clip_x0[m] = cx; clip_x1[m] = sx0; m = m + 1;
                cx = sx0;
                if (m >= MAX_VIS) break;
            }

            // Over the pixels shared with that span, the face is kept where it
            // is nearer, and the two may cross once
            let sx1 = msp_x1[cur];
            let var end = sx1 < x1 ? sx1 : x1;
            let dw_diff = dw - msp_dw[cur];
            let w_diff = w - msp_w[cur];
            let near_start = w_diff + cx * dw_diff;
            let near_end = w_diff + (end - 1) * dw_diff;

            if ((near_start > 0.0) == (near_end > 0.0)) {
                if (near_start > 0.0) { clip_x0[m] = cx; clip_x1[m] = end; m = m + 1; }
            } else {
                let cross = ((cx - near_start / dw_diff).floor() + 1).clip(cx + 1, end - 1);
                if (near_start > 0.0) { clip_x0[m] = cx; clip_x1[m] = cross; }
                else { clip_x0[m] = cross; clip_x1[m] = end; }
                m = m + 1;
            }

            cx = end;
            if (end == sx1) cur = msp_next[cur];
        }
    }

    for (let var k = 0; k < m; ++k) {
        vis_x0[k] = clip_x0[k];
        vis_x1[k] = clip_x1[k];
    }
    return m;
}

// Is pixel x of scanline y covered by a model?
fun mesh_at(y, x) {
    let var cur = mb_head[y];
    while (cur != NO_SPAN) {
        if (msp_x0[cur] > x) return false;
        if (msp_x1[cur] > x) return true;
        cur = msp_next[cur];
    }
    return false;
}

// --- Faces held back to blend ---
//
// A face you can see through cannot be drawn where it is met, because what it
// blends over has not been drawn yet: the traversal is front to back, so the
// wall behind a pane of glass comes later. What it can do at that moment is ask
// the s-buffer which parts of it are in view, since that answer is already
// final, and write them down.
//
// The spans go in a flat pool and each face keeps a run of it. Once the opaque
// pass has finished the frame, the faces are replayed in reverse, which is back
// to front among themselves, and each one blends over a frame buffer that is by
// then complete underneath it. Glass behind glass composites in the right order
// for the same reason.
let MAX_DEFER_FACES = 256;
let MAX_DEFER_SPANS = 8192;

let df_face = Array.with_size(MAX_DEFER_FACES, nil);
let df_first = Array.with_size(MAX_DEFER_FACES, 0);
let df_count = Array.with_size(MAX_DEFER_FACES, 0);
let var df_num = 0;

let ds_y = Array.with_size(MAX_DEFER_SPANS, 0);
let ds_x0 = Array.with_size(MAX_DEFER_SPANS, 0);
let ds_x1 = Array.with_size(MAX_DEFER_SPANS, 0);
let var ds_top = 0;

fun sbuf_reset() {
    for (let var y = 0; y < FRAME_HEIGHT; ++y) sb_head[y] = NO_SPAN;
    sb_full.zero_fill();
    sb_num_full = 0;
    sp_top = 0;
    screen_done = false;
    df_num = 0;
    ds_top = 0;
}

// Insert [x0, x1) into scanline y and report which parts of it were not already
// covered, in vis_x0/vis_x1. The covered set becomes the union.
fun sbuf_insert(y, x0, x1) {
    if (sb_full.get_u32(y) != 0) return 0;

    let var n_vis = 0;
    let var prev = NO_SPAN;
    let var cur = sb_head[y];

    // Skip the intervals entirely left of x0. One ending exactly at x0 touches
    // it, so it joins the run below and the two coalesce.
    while (cur != NO_SPAN && sp_x1[cur] < x0) {
        prev = cur;
        cur = sp_next[cur];
    }

    // Walk the overlapped run: the gaps in it are what is visible, and the
    // whole run merges into one interval
    let var mx0 = x0;
    let var mx1 = x1;
    let var cx = x0;
    let var scan = cur;
    while (scan != NO_SPAN) {
        let sx0 = sp_x0[scan];
        if (sx0 > x1) break;
        let sx1 = sp_x1[scan];

        if (sx0 > cx && n_vis < MAX_VIS) {
            vis_x0[n_vis] = cx;
            vis_x1[n_vis] = sx0;
            n_vis = n_vis + 1;
        }
        if (sx1 > cx) cx = sx1;
        if (sx0 < mx0) mx0 = sx0;
        if (sx1 > mx1) mx1 = sx1;
        scan = sp_next[scan];
    }
    if (cx < x1 && n_vis < MAX_VIS) {
        vis_x0[n_vis] = cx;
        vis_x1[n_vis] = x1;
        n_vis = n_vis + 1;
    }

    // Hidden behind what is already there, so the covered set is unchanged
    if (n_vis == 0) return 0;

    if (cur == scan) {
        // Nothing overlapped: link in a new interval
        if (sp_top >= MAX_SPANS) {
            // The pool is spent. Retiring the scanline keeps what is already
            // on it, which is the nearest geometry, and stops anything behind
            // that from being let through out of order.
            sb_full.set_u32(y, 1);
            sb_num_full = sb_num_full + 1;
            if (sb_num_full >= render_y1 - render_y0) screen_done = true;
            return 0;
        }

        let s = sp_top;
        sp_top = sp_top + 1;
        sp_x0[s] = mx0;
        sp_x1[s] = mx1;
        sp_next[s] = scan;
        if (prev == NO_SPAN) sb_head[y] = s; else sp_next[prev] = s;
    } else {
        // Widen the first interval of the run over the whole of it and drop the
        // rest, which stay in the pool unused until the frame ends
        sp_x0[cur] = mx0;
        sp_x1[cur] = mx1;
        sp_next[cur] = scan;
    }

    if (mx0 <= 0 && mx1 >= FRAME_WIDTH) {
        sb_full.set_u32(y, 1);
        sb_num_full = sb_num_full + 1;
        if (sb_num_full >= render_y1 - render_y0) screen_done = true;
    }
    return n_vis;
}

// The same walk as `sbuf_insert`, reporting what of [x0, x1) is still visible
// without claiming any of it.
//
// This is what a face you can see through asks instead. Front to back order
// means the covered set at the moment a face is reached is exactly the geometry
// nearer than it, so the gaps it comes back with are already the right answer
// for which parts of it are in view. What it must not do is fill those gaps in:
// whatever stands behind still has to be drawn, because the blend is going to
// need it.
fun sbuf_visible(y, x0, x1) {
    if (sb_full.get_u32(y) != 0) return 0;

    let var n_vis = 0;
    let var cur = sb_head[y];
    while (cur != NO_SPAN && sp_x1[cur] < x0) cur = sp_next[cur];

    let var cx = x0;
    while (cur != NO_SPAN) {
        let sx0 = sp_x0[cur];
        if (sx0 > x1) break;

        if (sx0 > cx && n_vis < MAX_VIS) {
            vis_x0[n_vis] = cx;
            vis_x1[n_vis] = sx0;
            n_vis = n_vis + 1;
        }
        let sx1 = sp_x1[cur];
        if (sx1 > cx) cx = sx1;
        cur = sp_next[cur];
    }
    if (cx < x1 && n_vis < MAX_VIS) {
        vis_x0[n_vis] = cx;
        vis_x1[n_vis] = x1;
        n_vis = n_vis + 1;
    }
    return n_vis;
}

// Is every pixel in this screen-space rectangle already covered? This is a
// deliberately conservative polygon occlusion test: a polygon fits inside its
// bounding rectangle, so covering the whole rectangle proves that the polygon
// cannot contribute a pixel. The reverse is not true, but a missed rejection
// only costs time and cannot change the image.
fun sbuf_covers_rect(x0, y0, x1, y1) {
    let var ry0 = y0.max(render_y0);
    let ry1 = y1.min(render_y1);
    if (ry0 >= ry1) return true;

    for (let var y = ry0; y < ry1; ++y) {
        if (sb_full.get_u32(y) != 0) continue;

        let var cur = sb_head[y];
        while (cur != NO_SPAN && sp_x1[cur] <= x0) cur = sp_next[cur];
        if (cur == NO_SPAN || sp_x0[cur] > x0 || sp_x1[cur] < x1) return false;
    }
    return true;
}

// --- Colors ---

fun color_lerp(a, b, t) {
    let it = 1.0 - t;
    let r = (((a >> 16) & 0xFF).to_f() * it + ((b >> 16) & 0xFF).to_f() * t).floor();
    let g = (((a >> 8) & 0xFF).to_f() * it + ((b >> 8) & 0xFF).to_f() * t).floor();
    let bl = ((a & 0xFF).to_f() * it + (b & 0xFF).to_f() * t).floor();
    return 0xFF000000 | (r << 16) | (g << 8) | bl;
}

fun color_scale(c, t) {
    let r = (((c >> 16) & 0xFF).to_f() * t).floor().min(255).max(0);
    let g = (((c >> 8) & 0xFF).to_f() * t).floor().min(255).max(0);
    let b = ((c & 0xFF).to_f() * t).floor().min(255).max(0);
    return 0xFF000000 | (r << 16) | (g << 8) | b;
}

// Saturating per-channel add. SWAR: the per-byte carry-out is detected in one
// shot and used to force the overflowed bytes to 0xFF.
fun color_add_sat(a, b) {
    let x = a & 0x00FFFFFF;
    let y = b & 0x00FFFFFF;
    let s = x + y;
    let m = ((x & y) | ((x | y) & (s ^ -1))) & 0x00808080;
    return 0xFF000000 | ((s | ((m << 1) - (m >> 7))) & 0x00FFFFFF);
}

// --- Sky ---
//
// The gradient runs along the world's up axis, so it is baked once into a table
// indexed by height above the horizon and then sampled through the camera.
// Pitch slides the whole table up or down the frame, which is what looking up
// at the sky should do. Without roll the mapping is exact; with it, the rows
// lean, and each is painted in short runs of the color at their middle.

let SKY_ZENITH = 0xFF0A0614;
let SKY_HAZE = 0xFF2A2038;
let SKY_NADIR = 0xFF08040E;

// Indexed by row of a level view, where the horizon sits at the frame's center
let bg_rows = Array.with_size(FRAME_HEIGHT, 0);
for (let var y = 0; y < FRAME_HEIGHT; ++y) {
    if (y.to_f() < CENTER_Y) {
        // Near-black at the zenith, warming into the haze at the horizon
        let t = y.to_f() / CENTER_Y;
        bg_rows[y] = color_lerp(SKY_ZENITH, SKY_HAZE, t * t * t);
    } else {
        // Below the horizon is open air falling away rather than a ground
        // plane, so it drops off into the dark
        let t = ((y.to_f() - CENTER_Y) / (FRAME_HEIGHT.to_f() - CENTER_Y) * 4.0).min(1.0);
        bg_rows[y] = color_lerp(SKY_HAZE, SKY_NADIR, t);
    }
}

// Where a screen row falls in the baked gradient. World up in eye space is
// (0, cos_pitch, sin_pitch), and level with the horizon this is y -> y.
fun sky_row(y) {
    let vy = (CENTER_Y + (y.to_f() - CENTER_Y) * cos_pitch - FOCAL * sin_pitch).floor();
    return bg_rows[vy.max(0).min(FRAME_HEIGHT - 1)];
}

// The same at pixel (x, y), taking the roll off first
fun sky_at_xy(x, y) {
    let ry = CENTER_Y - ((x.to_f() - CENTER_X) * sin_roll + (CENTER_Y - y.to_f()) * cos_roll);
    let vy = (CENTER_Y + (ry - CENTER_Y) * cos_pitch - FOCAL * sin_pitch).floor();
    return bg_rows[vy.max(0).min(FRAME_HEIGHT - 1)];
}

let SKY_RUN = 8;

// Paint the parts of [x0, x1) on scanline y that no polygon claimed. The
// s-buffer's intervals are sorted, disjoint and coalesced, so the gaps between
// them are already exactly what is still uncovered and one walk finds them all.
fun sky_span(y, x0, x1, c) {
    let row = y * FRAME_WIDTH;
    let var cx = x0;
    let var cur = sb_head[y];
    while (cur != NO_SPAN && sp_x1[cur] <= x0) cur = sp_next[cur];

    while (cur != NO_SPAN) {
        let sx0 = sp_x0[cur];
        if (sx0 >= x1) break;
        if (sx0 > cx) sky_fill(y, row, cx, sx0, c);
        let sx1 = sp_x1[cur];
        if (sx1 > cx) cx = sx1;
        cur = sp_next[cur];
    }
    if (cx < x1) sky_fill(y, row, cx, x1, c);
}

// Paint [x0, x1) of scanline y, which no face claimed, around whatever models
// were drawn there
fun sky_fill(y, row, x0, x1, c) {
    let fb = frame_buffer;
    let var cur = mb_head[y];
    if (cur == NO_SPAN) {
        fb.fill_u32(row + x0, x1 - x0, c);
        return;
    }

    let var cx = x0;
    while (cur != NO_SPAN && msp_x1[cur] <= x0) cur = msp_next[cur];
    while (cur != NO_SPAN) {
        let sx0 = msp_x0[cur];
        if (sx0 >= x1) break;
        if (sx0 > cx) fb.fill_u32(row + cx, sx0 - cx, c);
        let sx1 = msp_x1[cur];
        if (sx1 > cx) cx = sx1;
        cur = msp_next[cur];
    }
    if (cx < x1) fb.fill_u32(row + cx, x1 - cx, c);
}

// Is this pixel sky? The same walk, stopped at the first interval that reaches
// it.
fun sky_at(y, x) {
    let var cur = sb_head[y];
    while (cur != NO_SPAN) {
        if (sp_x0[cur] > x) return !mesh_at(y, x);
        if (sp_x1[cur] > x) return false;
        cur = sp_next[cur];
    }
    return !mesh_at(y, x);
}

// This replaces clearing the frame: every pixel is either covered by the opaque
// pass or is sky, so nothing is left needing a background color under it.
//
// Reports whether the band had any sky at all, which is what keeps a level with
// a roof over it from paying for a moon and stars it cannot see.
fun draw_sky() {
    let var any = false;
    for (let var y = render_y0; y < render_y1; ++y) {
        // The intervals are coalesced, so one reaching both edges is the only
        // shape a fully covered row can take
        let cur = sb_head[y];
        if (cur != NO_SPAN && sp_x0[cur] <= 0 && sp_x1[cur] >= FRAME_WIDTH) continue;

        if (sin_roll == 0.0) {
            sky_span(y, 0, FRAME_WIDTH, sky_row(y));
        } else {
            for (let var x = 0; x < FRAME_WIDTH; x = x + SKY_RUN) {
                sky_span(y, x, (x + SKY_RUN).min(FRAME_WIDTH), sky_at_xy(x + SKY_RUN.idiv(2), y));
            }
        }
        any = true;
    }
    return any;
}

// --- Moon and stars ---
//
// Both sit at fixed world directions, since the sky is effectively at infinity,
// so they swing across the frame as the camera turns. Drawing them through
// `sky_span` is what lets a building eclipse them: they only reach the pixels
// the opaque pass left behind.

let var proj_x = 0.0;
let var proj_y = 0.0;

// A direction at infinity: the same yaw then pitch the faces go through, with
// no translation and no divide by distance. False when it is behind us.
fun project_dir(dx, dy, dz) {
    let rx = dx * cos_yaw - dz * sin_yaw;
    let rz = dx * sin_yaw + dz * cos_yaw;
    let ey = dy * cos_pitch - rz * sin_pitch;
    let ez = rz * cos_pitch + dy * sin_pitch;
    if (ez <= 0.01) return false;
    let s = FOCAL / ez;
    proj_x = CENTER_X + (rx * cos_roll + ey * sin_roll) * s;
    proj_y = CENTER_Y - (ey * cos_roll - rx * sin_roll) * s;
    return true;
}

let MOON_R = (FRAME_HEIGHT.idiv(29)).max(6);
let MOON_HALO_R = MOON_R * 4;
// One step every couple of pixels, otherwise the falloff shows as rings
let MOON_HALO_STEPS = (MOON_HALO_R.idiv(2)).max(8);
let MOON_COLOR = 0xFFF2F5FF;
let MOON_GLOW = 0xFFA8C4FF;

fun sky_disc(cx, cy, r, color) {
    let y0 = (cy - r).max(render_y0);
    let y1 = (cy + r + 1).min(render_y1);
    let rr = (r * r).to_f();
    for (let var y = y0; y < y1; ++y) {
        let dy = (y - cy).to_f();
        let h2 = rr - dy * dy;
        if (h2 <= 0.0) continue;
        let h = h2.sqrt().floor();
        let xa = (cx - h).max(0);
        let xb = (cx + h + 1).min(FRAME_WIDTH);
        if (xa < xb) sky_span(y, xa, xb, color);
    }
}

// Same shape, but each row is the gradient underneath plus the glow, so the
// halo adds to the sky rather than painting over it
fun glow_disc(cx, cy, r, add) {
    let y0 = (cy - r).max(render_y0);
    let y1 = (cy + r + 1).min(render_y1);
    let rr = (r * r).to_f();
    for (let var y = y0; y < y1; ++y) {
        let dy = (y - cy).to_f();
        let h2 = rr - dy * dy;
        if (h2 <= 0.0) continue;
        let h = h2.sqrt().floor();
        let xa = (cx - h).max(0);
        let xb = (cx + h + 1).min(FRAME_WIDTH);
        let under = sin_roll == 0.0 ? sky_row(y) : sky_at_xy(cx, y);
        if (xa < xb) sky_span(y, xa, xb, color_add_sat(under, add));
    }
}

fun draw_moon() {
    let ce = MOON_EL.cos();
    if (!project_dir(ce * MOON_AZ.sin(), MOON_EL.sin(), ce * MOON_AZ.cos())) return;
    let mx = proj_x.floor();
    let my = proj_y.floor();
    if (mx < 0 - MOON_HALO_R || mx > FRAME_WIDTH + MOON_HALO_R) return;
    if (my < render_y0 - MOON_HALO_R || my > render_y1 + MOON_HALO_R) return;

    // Halo, drawn outside in so each smaller disc steps the falloff up
    for (let var i = MOON_HALO_STEPS; i >= 1; --i) {
        let t = i.to_f() / MOON_HALO_STEPS.to_f();
        let k = 1.0 - t;
        glow_disc(mx, my, MOON_R + (MOON_HALO_R.to_f() * t).floor(),
                  color_scale(MOON_GLOW, k * k * 0.5));
    }

    sky_disc(mx, my, MOON_R, MOON_COLOR);

    // A couple of maria, just enough that it reads as a moon and not a lamp
    let m = color_scale(MOON_COLOR, 0.90);
    sky_disc(mx - MOON_R.idiv(3), my - MOON_R.idiv(4), MOON_R.idiv(3), m);
    sky_disc(mx + MOON_R.idiv(4), my + MOON_R.idiv(3), MOON_R.idiv(4), m);
}

let NUM_STARS = 400;
let star_dx = Array.with_size(NUM_STARS, 0.0);
let star_dy = Array.with_size(NUM_STARS, 0.0);
let star_dz = Array.with_size(NUM_STARS, 0.0);
let star_color = Array.with_size(NUM_STARS, 0);

let star_rng = Xoshiro128(12345);

// Spread over the whole dome, since the player can turn to face any of it
for (let var i = 0; i < NUM_STARS; ++i) {
    let az = star_rng.float(0.0, 1.0) * 6.2831853;
    let el = 0.05 + star_rng.float(0.0, 1.0) * 1.4;
    let ce = el.cos();
    star_dx[i] = ce * az.sin();
    star_dy[i] = el.sin();
    star_dz[i] = ce * az.cos();
    star_color[i] = color_scale(0xFFFFFFFF, 0.25 + star_rng.float(0.0, 1.0) * 0.6);
}

fun draw_stars() {
    for (let var i = 0; i < NUM_STARS; ++i) {
        if (!project_dir(star_dx[i], star_dy[i], star_dz[i])) continue;
        let sx = proj_x.floor();
        if (sx < 0 || sx >= FRAME_WIDTH) continue;
        let sy = proj_y.floor();
        if (sy < render_y0 || sy >= render_y1) continue;
        if (sky_at(sy, sx)) frame_buffer.set_u32(sy * FRAME_WIDTH + sx, star_color[i]);
    }
}


// --- Rasterization ---

// Clip the polygon in the a buffers against ax*x + ay*y + az*z + aw >= 0,
// leaving the result in the a buffers again. Returns the vertex count.
fun clip_plane(n, ax, ay, az, aw) {
    let var m = 0;
    for (let var i = 0; i < n; ++i) {
        let var j = i + 1;
        if (j == n) j = 0;

        let di = ax * aX[i] + ay * aY[i] + az * aZ[i] + aw;
        let dj = ax * aX[j] + ay * aY[j] + az * aZ[j] + aw;

        if (di >= 0.0) {
            bX[m] = aX[i]; bY[m] = aY[i]; bZ[m] = aZ[i];
            bU[m] = aU[i]; bV[m] = aV[i];
            m = m + 1;
        }

        if ((di >= 0.0) != (dj >= 0.0)) {
            let t = di / (di - dj);
            bX[m] = aX[i] + (aX[j] - aX[i]) * t;
            bY[m] = aY[i] + (aY[j] - aY[i]) * t;
            bZ[m] = aZ[i] + (aZ[j] - aZ[i]) * t;
            bU[m] = aU[i] + (aU[j] - aU[i]) * t;
            bV[m] = aV[i] + (aV[j] - aV[i]) * t;
            m = m + 1;
        }
    }

    // Swap the buffers rather than copying back
    let tx = aX; aX = bX; bX = tx;
    let ty = aY; aY = bY; bY = ty;
    let tz = aZ; aZ = bZ; bZ = tz;
    let tu = aU; aU = bU; bU = tu;
    let tv = aV; aV = bV; bV = tv;
    return m;
}

// Walk the convex polygon in pX/pY scanline by scanline, hand each span to the
// s-buffer, and draw whatever comes back as visible.
fun raster_poly(m) {
    let var top = 0;
    let var y_min = pY[0];
    let var bot = 0;
    let var y_max = pY[0];
    for (let var i = 1; i < m; ++i) {
        if (pY[i] < y_min) { y_min = pY[i]; top = i; }
        if (pY[i] > y_max) { y_max = pY[i]; bot = i; }
    }

    // Start at the band's first row, not the polygon's: the edges and
    // interpolants are worked out for whichever row the walk starts on
    let var scan_y = y_min.floor();
    if (scan_y < render_y0) scan_y = render_y0;
    let var end_y = y_max.floor();
    if (end_y > render_y1) end_y = render_y1;
    if (scan_y >= end_y) return;

    // Which way round the left chain runs, from the winding on screen
    let var area = 0.0;
    for (let var i = 0; i < m; ++i) {
        let var j = i + 1;
        if (j == m) j = 0;
        area = area + pX[i] * pY[j] - pX[j] * pY[i];
    }
    let var step_l = 1;
    if (area > 0.0) step_l = m - 1;
    let step_r = m - step_l;

    // Texture coordinates over z, and 1/z, at x = 0 of the current scanline.
    // These stay floats: at x = 0 the value can sit far outside the polygon,
    // which a float carries without losing the precision that matters once a
    // span start brings it back inside.
    let y_off = scan_y + 0.5 - g_ref_y;
    let x_off = 0.5 - g_ref_x;
    let var uz_row = g_uz0 + x_off * g_duzdx + y_off * g_duzdy;
    let var vz_row = g_vz0 + x_off * g_dvzdx + y_off * g_dvzdy;
    let var w_row = g_w0 + x_off * g_dwdx + y_off * g_dwdy;

    let duzdx = g_duzdx; let dvzdx = g_dvzdx; let dwdx = g_dwdx;
    let lu0 = g_lu0; let lv0 = g_lv0;
    let l_k = g_l_k; let l_u = g_l_u; let l_v = g_l_v; let l_uv = g_l_uv;
    let pix = g_pix;
    let umask = g_umask;
    let vshift = g_vshift;
    let vmask = g_vmask;
    let uwrap = g_uwrap;
    let vwrap = g_vwrap;
    // MASK_RB is non-contiguous and worth holding in a register. MASK_G stays
    // a constant so codegen can fold its contiguous field into the operation.
    let mask_rb = MASK_RB;
    let fb = frame_buffer;
    let l_min = g_l_min;
    let l_max = g_l_max;
    let collecting = g_collecting;

    // Per chain: the corner reached so far, the current x, how far x moves per
    // scanline, and the scanline its current edge runs out on
    let var cl = top; let var xl = 0.0; let var dxl = 0.0; let var end_l = scan_y;
    let var cr = top; let var xr = 0.0; let var dxr = 0.0; let var end_r = scan_y;
    let var row = scan_y * FRAME_WIDTH;

    // Counted locally and handed to the global once the polygon is done, so
    // the inner loops touch a register rather than a global per sub-span
    let var span_px = 0;

    while (scan_y < end_y) {
        // Step either chain the current scanline has run past. Edges too short
        // to cover a scanline are skipped by the same loop.
        while (scan_y >= end_l && cl != bot) {
            let ya = pY[cl];
            let xa = pX[cl];
            cl = (cl + step_l) % m;
            let yb = pY[cl];
            let var e = yb.floor();
            if (e > end_y) e = end_y;
            end_l = e;
            if (end_l > scan_y && yb > ya) {
                dxl = (pX[cl] - xa) / (yb - ya);
                xl = xa + (scan_y + 1 - ya) * dxl;
            }
        }
        while (scan_y >= end_r && cr != bot) {
            let ya = pY[cr];
            let xa = pX[cr];
            cr = (cr + step_r) % m;
            let yb = pY[cr];
            let var e = yb.floor();
            if (e > end_y) e = end_y;
            end_r = e;
            if (end_r > scan_y && yb > ya) {
                dxr = (pX[cr] - xa) / (yb - ya);
                xr = xa + (scan_y + 1 - ya) * dxr;
            }
        }

        // Both edges hold for this band, so it runs with no further checks
        let var band_end = end_l;
        if (end_r < band_end) band_end = end_r;
        if (band_end <= scan_y) { pixels_drawn = pixels_drawn + span_px; return; }

        // A face you can see through only wants to know where it is visible, so
        // it runs a band of its own: no interpolants to carry down the rows and
        // no s-buffer to fill in. Which of the two runs is settled once a band
        // rather than once a scanline, because it cannot change inside one.
        if (collecting) {
            while (scan_y < band_end) {
                let var xa = xl.floor();
                if (xa < 0) xa = 0;
                let var xb = xr.floor();
                if (xb > FRAME_WIDTH) xb = FRAME_WIDTH;

                if (scan_y >= render_y0 && xa < xb) {
                    let var n_vis = sbuf_visible(scan_y, xa, xb);

                    // The rows of this run carry no interpolants, so 1/z for
                    // the model test comes straight off the gradients
                    if (n_vis > 0 && mb_head[scan_y] != NO_SPAN) {
                        let w0 = g_w0 + (0.5 - g_ref_x) * dwdx + (scan_y + 0.5 - g_ref_y) * g_dwdy;
                        n_vis = mesh_clip(scan_y, n_vis, w0, dwdx);
                    }

                    for (let var k = 0; k < n_vis; ++k) {
                        if (ds_top >= MAX_DEFER_SPANS) break;
                        ds_y[ds_top] = scan_y;
                        ds_x0[ds_top] = vis_x0[k];
                        ds_x1[ds_top] = vis_x1[k];
                        ds_top = ds_top + 1;
                    }
                }

                xl = xl + dxl;
                xr = xr + dxr;
                scan_y = scan_y + 1;
            }
            continue;
        }

        while (scan_y < band_end) {
            let var xa = xl.floor();
            if (xa < 0) xa = 0;
            let var xb = xr.floor();
            if (xb > FRAME_WIDTH) xb = FRAME_WIDTH;

            // Start edge interpolation at the polygon's true first scanline,
            // even when this actor owns a lower band. Advancing to the band
            // one row at a time preserves the serial renderer's floating
            // point rounding at polygon edges; this branch is per row, never
            // in the pixel hot path.
            if (scan_y >= render_y0 && xa < xb) {
                let var n_vis = sbuf_insert(scan_y, xa, xb);
                if (n_vis > 0 && mb_head[scan_y] != NO_SPAN) {
                    n_vis = mesh_clip(scan_y, n_vis, w_row, dwdx);
                }

                for (let var k = 0; k < n_vis; ++k) {
                    let var x = vis_x0[k];
                    let piece_end = vis_x1[k];

                    // Perspective values at the start of this piece
                    let var uz = uz_row + x * duzdx;
                    let var vz = vz_row + x * dvzdx;
                    let var w = w_row + x * dwdx;
                    let var z = 1.0 / w;
                    let var u = uz * z;
                    let var v = vz * z;

                    // The level is a bilinear function of u and v, so it comes
                    // out of the pair the loop already has rather than riding
                    // an interpolant of its own
                    let cu = u - lu0;
                    let cv = v - lv0;
                    let l = l_k + l_u * cu + cv * (l_v + l_uv * cu);

                    // 1/z is what makes the affine step inside a sub-span
                    // drift, so the length follows it: the longest run with
                    // run * |dwdx| <= PERSP_TOL * w. The divide is hoisted
                    // here, leaving a multiply per sub-span. A face square to
                    // the eye has no swing at all and runs at full length.
                    let var wscale = 0.0;
                    let adw = dwdx.abs();
                    if (adw > 0.0) wscale = PERSP_TOL / adw;

                    // The light at the near end of the run, clamped. Each
                    // sub-span ends where the next one begins, so the far end
                    // worked out below carries over instead of being floored
                    // and clamped a second time.
                    let var lfx = (l * L_ONE).floor();
                    if (lfx < l_min) lfx = l_min;
                    else if (lfx > l_max) lfx = l_max;

                    while (x < piece_end) {
                        let var run = SUB_MAX;
                        if (wscale > 0.0) {
                            // Compare as a float so a near-zero dwdx can't
                            // overflow the integer conversion
                            let nf = w * wscale;
                            if (nf < SUB_MAX.to_f()) {
                                run = nf.floor();
                                if (run < 1) run = 1;
                            }
                        }

                        let var xe = x + run;
                        if (xe > piece_end) xe = piece_end;
                        let len = xe - x;

                        // One divide per sub-span buys a correct u and v at its
                        // far end; in between the step is affine
                        let uz_e = uz + len * duzdx;
                        let vz_e = vz + len * dvzdx;
                        let w_e = w + len * dwdx;
                        let z_e = 1.0 / w_e;
                        let u_e = uz_e * z_e;
                        let v_e = vz_e * z_e;
                        let cu_e = u_e - lu0;
                        let cv_e = v_e - lv0;
                        let l_e = l_k + l_u * cu_e + cv_e * (l_v + l_uv * cu_e);

                        let inv_len = INV_N[len];
                        let var du = (u_e - u) * inv_len;
                        let var dv = (v_e - v) * inv_len;
                        if (du > GRAD_LIMIT) du = GRAD_LIMIT;
                        else if (du < 0.0 - GRAD_LIMIT) du = 0.0 - GRAD_LIMIT;
                        if (dv > GRAD_LIMIT) dv = GRAD_LIMIT;
                        else if (dv < 0.0 - GRAD_LIMIT) dv = 0.0 - GRAD_LIMIT;

                        let ufx = ((((u + BIAS_TEXELS) * FP_ONE).floor()) & uwrap) + EXC_FX;
                        let vfx = ((((v + BIAS_TEXELS) * FP_ONE).floor()) & vwrap) + EXC_FX;
                        let var t = (vfx << 32) + ufx;
                        let dt = ((dv * FP_ONE).floor() << 32) + (du * FP_ONE).floor();

                        // Both ends of the sub-span are clamped and the step
                        // is taken between the clamped pair, so every pixel
                        // along it is in range as well. Clamping only the start
                        // would leave the step free to run the scale off the
                        // end of a channel: a face seen almost edge on is a
                        // sliver a pixel or two wide carrying the whole
                        // perspective range, and its step is enormous.
                        let var lfx_e = (l_e * L_ONE).floor();
                        if (lfx_e < l_min) lfx_e = l_min;
                        else if (lfx_e > l_max) lfx_e = l_max;

                        let dl = ((lfx_e - lfx).to_f() * inv_len).floor();

                        let var lp = lfx;
                        let var i = row + x;
                        let end_i = row + xe;
                        span_px = span_px + len;
                        while (i < end_i) {
                            let c = pix.get_u32(((t >> vshift) & vmask)
                                              | ((t >> U_SHIFT) & umask));

                            // Red and blue are already sixteen bits apart;
                            // moving green up to bit 32 puts all three that far
                            // apart, so one multiply scales them without their
                            // products running into each other. Sixty-two bit
                            // fixnums are what make the third channel fit: in
                            // thirty-two bits this takes two multiplies.
                            let x = ((c & mask_rb) | ((c & MASK_G) << 24))
                                  * (lp >> L_SHIFT);

                            // Red and blue come back out together: they are
                            // still sixteen apart after the shift, so the mask
                            // that separated them separates the products too
                            fb.set_u32(i, ((x >> 8) & mask_rb)
                                        | ((x >> 32) & 0xFF00));
                            t = t + dt;
                            lp = lp + dl;
                            i = i + 1;
                        }

                        lfx = lfx_e;
                        uz = uz_e; vz = vz_e; w = w_e;
                        u = u_e; v = v_e;
                        x = xe;
                    }
                }
            }

            xl = xl + dxl;
            xr = xr + dxr;
            uz_row = uz_row + g_duzdy;
            vz_row = vz_row + g_dvzdy;
            w_row = w_row + g_dwdy;
            row = row + FRAME_WIDTH;
            scan_y = scan_y + 1;
        }
    }

    pixels_drawn = pixels_drawn + span_px;
}

// Draw a run of spans taken down earlier, blending each pixel over what is
// already in the frame buffer.
//
// There is no edge walking here: which pixels belong to the face was settled in
// the first pass, and a row's starting values come straight off the gradients
// rather than by stepping down from the top of the polygon. The sub-span loop
// below is the one in `raster_poly`, repeated rather than shared because the
// only way to share it would be a call per pixel.
//
// The blend is the same trick as the shading multiply. Both texel and
// destination are unpacked so their three channels sit sixteen bits apart, each
// is scaled by its own share, and the two are added while still packed: one
// extra load, one extra multiply and an add over an opaque pixel. It cannot
// carry between channels because the shares sum to 255 and a channel is at
// most 255, which puts the worst case at 255 * 255, just inside sixteen bits.
// That is the whole reason alpha is baked into the light rather than applied
// here: the source share arrives already multiplied by it and already bounded.
fun raster_spans(first, count) {
    let duzdx = g_duzdx; let dvzdx = g_dvzdx; let dwdx = g_dwdx;
    let lu0 = g_lu0; let lv0 = g_lv0;
    let l_k = g_l_k; let l_u = g_l_u; let l_v = g_l_v; let l_uv = g_l_uv;
    let pix = g_pix;
    let umask = g_umask;
    let vshift = g_vshift;
    let vmask = g_vmask;
    let uwrap = g_uwrap;
    let vwrap = g_vwrap;
    let mask_rb = MASK_RB;
    let fb = frame_buffer;
    let l_min = g_l_min;
    let l_max = g_l_max;
    let inv_alpha = g_inv_alpha;
    let x_off = 0.5 - g_ref_x;

    let var span_px = 0;
    let end_s = first + count;

    for (let var s = first; s < end_s; ++s) {
        let scan_y = ds_y[s];
        let piece_end = ds_x1[s];
        let row = scan_y * FRAME_WIDTH;

        let y_off = scan_y + 0.5 - g_ref_y;
        let uz_row = g_uz0 + x_off * duzdx + y_off * g_duzdy;
        let vz_row = g_vz0 + x_off * dvzdx + y_off * g_dvzdy;
        let w_row = g_w0 + x_off * dwdx + y_off * g_dwdy;

        let var x = ds_x0[s];
        let var uz = uz_row + x * duzdx;
        let var vz = vz_row + x * dvzdx;
        let var w = w_row + x * dwdx;
        let var z = 1.0 / w;
        let var u = uz * z;
        let var v = vz * z;
        let cu = u - lu0;
        let cv = v - lv0;
        let l = l_k + l_u * cu + cv * (l_v + l_uv * cu);

        let var wscale = 0.0;
        let adw = dwdx.abs();
        if (adw > 0.0) wscale = PERSP_TOL / adw;

        let var lfx = (l * L_ONE).floor();
        if (lfx < l_min) lfx = l_min;
        else if (lfx > l_max) lfx = l_max;

        while (x < piece_end) {
            let var run = SUB_MAX;
            if (wscale > 0.0) {
                let n = (w * wscale).floor();
                if (n < run) run = n;
                if (run < 1) run = 1;
            }

            let var xe = x + run;
            if (xe > piece_end) xe = piece_end;
            let len = xe - x;

            let uz_e = uz + len * duzdx;
            let vz_e = vz + len * dvzdx;
            let w_e = w + len * dwdx;
            let z_e = 1.0 / w_e;
            let u_e = uz_e * z_e;
            let v_e = vz_e * z_e;
            let cu_e = u_e - lu0;
            let cv_e = v_e - lv0;
            let l_e = l_k + l_u * cu_e + cv_e * (l_v + l_uv * cu_e);

            let inv_len = INV_N[len];
            let var du = (u_e - u) * inv_len;
            let var dv = (v_e - v) * inv_len;
            if (du > GRAD_LIMIT) du = GRAD_LIMIT;
            else if (du < 0.0 - GRAD_LIMIT) du = 0.0 - GRAD_LIMIT;
            if (dv > GRAD_LIMIT) dv = GRAD_LIMIT;
            else if (dv < 0.0 - GRAD_LIMIT) dv = 0.0 - GRAD_LIMIT;

            let ufx = ((((u + BIAS_TEXELS) * FP_ONE).floor()) & uwrap) + EXC_FX;
            let vfx = ((((v + BIAS_TEXELS) * FP_ONE).floor()) & vwrap) + EXC_FX;
            let var t = (vfx << 32) + ufx;
            let dt = ((dv * FP_ONE).floor() << 32) + (du * FP_ONE).floor();

            let var lfx_e = (l_e * L_ONE).floor();
            if (lfx_e < l_min) lfx_e = l_min;
            else if (lfx_e > l_max) lfx_e = l_max;

            let dl = ((lfx_e - lfx).to_f() * inv_len).floor();

            let var lp = lfx;
            let var i = row + x;
            let end_i = row + xe;
            span_px = span_px + len;
            while (i < end_i) {
                let c = pix.get_u32(((t >> vshift) & vmask)
                                  | ((t >> U_SHIFT) & umask));
                let d = fb.get_u32(i);

                let acc = ((c & mask_rb) | ((c & MASK_G) << 24)) * (lp >> L_SHIFT)
                        + ((d & mask_rb) | ((d & MASK_G) << 24)) * inv_alpha;

                fb.set_u32(i, ((acc >> 8) & mask_rb)
                            | ((acc >> 32) & 0xFF00));
                t = t + dt;
                lp = lp + dl;
                i = i + 1;
            }

            lfx = lfx_e;
            uz = uz_e; vz = vz_e; w = w_e;
            u = u_e; v = v_e;
            x = xe;
        }
    }

    pixels_drawn = pixels_drawn + span_px;
}

// The five planes of the view frustum, in world space, as normal and offset.
// A point is inside a plane when nx*x + ny*y + nz*z - d >= 0.
let fr_nx = Array.with_size(5, 0.0);
let fr_ny = Array.with_size(5, 0.0);
let fr_nz = Array.with_size(5, 0.0);
let fr_d = Array.with_size(5, 0.0);

// Cull, transform, clip and project one face, and work out the gradients the
// span loop runs on. Returns the vertex count left after clipping, or 0 if
// there is nothing to draw.
//
// `cull` asks for the cheap rejection against the s-buffer, which only the
// first pass wants: by the time a held back face is replayed the s-buffer holds
// the whole frame, and a pane of glass is covered in it by the very wall it is
// meant to be blended over. Everything else here reads only the face and the
// camera, so the second pass gets gradients identical to the first.
fun face_setup(f, cull) {
    // Faces pointing away from the eye are the inside of a solid
    if (f.nx * cam_x + f.ny * cam_y + f.nz * cam_z - f.d <= 0.0) return 0;

    // Outside this actor's part of the frustum, found from a bounding sphere
    // before paying to transform the corners
    for (let var i = 0; i < 5; ++i) {
        if (fr_nx[i] * f.bx + fr_ny[i] * f.by + fr_nz[i] * f.bz - fr_d[i] + f.br < 0.0) return 0;
    }

    let ux = f.ux; let uy = f.uy; let uz = f.uz; let ou = f.ou;
    let vx = f.vx; let vy = f.vy; let vz = f.vz; let ov = f.ov;
    let n = f.v.len.idiv(3);
    if (n > MAX_VERTS - 8) return 0;

    for (let var i = 0; i < n; ++i) {
        let wx = f.v[i * 3];
        let var wy = f.v[i * 3 + 1];
        let wz = f.v[i * 3 + 2];

        // Lava swells: the corner itself rides two sine waves, one along x and
        // one along z. The texture of a floor comes from x and z, so lifting y
        // moves the surface without touching the mapping, and nothing seams.
        if (f.flow) {
            wy = wy + WAVE_AMP * (wx * WAVE_FREQ + warp_phase).sin()
                    + WAVE_AMP * (wz * WAVE_FREQ + warp_phase * 0.83).sin();
        }

        let u = ux * wx + uy * wy + uz * wz + ou;
        let v = vx * wx + vy * wy + vz * wz + ov;

        // Into view space: yaw about the up axis, then pitch, then roll
        let dx = wx - cam_x;
        let dy = wy - cam_y;
        let dz = wz - cam_z;
        let rx = dx * cos_yaw - dz * sin_yaw;
        let rz = dx * sin_yaw + dz * cos_yaw;
        let ry = dy * cos_pitch - rz * sin_pitch;

        aX[i] = rx * cos_roll + ry * sin_roll;
        aY[i] = ry * cos_roll - rx * sin_roll;
        aZ[i] = rz * cos_pitch + dy * sin_pitch;
        aU[i] = u;
        aV[i] = v;
    }

    // Only the near plane needs clipping: it is what keeps the projection from
    // dividing by a z at or behind the eye. Clipping to the sides as well would
    // put vertices exactly on the frame edge, where rounding drops them a hair
    // inside and leaves an uncovered row along the border; the span and
    // scanline clamps below handle off-screen geometry anyway.
    let m = clip_plane(n, 0.0, 0.0, 1.0, 0.0 - NEAR);
    if (m < 3) return 0;

    let var box_x0 = 0.0; let var box_y0 = 0.0;
    let var box_x1 = 0.0; let var box_y1 = 0.0;
    for (let var i = 0; i < m; ++i) {
        let w = 1.0 / aZ[i];
        pX[i] = CENTER_X + FOCAL * aX[i] * w;
        pY[i] = CENTER_Y - FOCAL * aY[i] * w;
        pW[i] = w;
        pUZ[i] = aU[i] * w;
        pVZ[i] = aV[i] * w;

        if (i == 0) {
            box_x0 = pX[i]; box_x1 = pX[i];
            box_y0 = pY[i]; box_y1 = pY[i];
        } else {
            if (pX[i] < box_x0) box_x0 = pX[i];
            if (pX[i] > box_x1) box_x1 = pX[i];
            if (pY[i] < box_y0) box_y0 = pY[i];
            if (pY[i] > box_y1) box_y1 = pY[i];
        }
    }

    // Match the rasterizer's floor-and-clamp convention. Requiring this
    // enclosing rectangle to be covered is stronger than necessary, but lets
    // a fully hidden face skip gradient setup and edge walking cheaply.
    let rx0 = box_x0.floor().max(0);
    let ry0 = box_y0.floor().max(0);
    let rx1 = box_x1.floor().min(FRAME_WIDTH);
    let ry1 = box_y1.floor().min(FRAME_HEIGHT);
    if (cull && rx0 < rx1 && ry0 < ry1 && sbuf_covers_rect(rx0, ry0, rx1, ry1)) {
        rect_faces_skipped = rect_faces_skipped + 1;
        return 0;
    }

    // u/z, v/z and 1/z are linear in screen space, so their gradients come from
    // any three vertices. The triple with the largest area is the best
    // conditioned, which matters after clipping leaves near-collinear corners.
    let var bi = 1;
    let var bj = 2;
    let var best = 0.0;
    for (let var i = 1; i + 1 < m; ++i) {
        let e1x = pX[i] - pX[0];
        let e1y = pY[i] - pY[0];
        let e2x = pX[i + 1] - pX[0];
        let e2y = pY[i + 1] - pY[0];
        let det = (e1x * e2y - e2x * e1y).abs();
        if (det > best) { best = det; bi = i; bj = i + 1; }
    }
    if (best < 0.000001) return 0;

    let x0 = pX[0]; let y0 = pY[0];
    let e1x = pX[bi] - x0; let e1y = pY[bi] - y0;
    let e2x = pX[bj] - x0; let e2y = pY[bj] - y0;
    let inv_det = 1.0 / (e1x * e2y - e2x * e1y);

    let uz0 = pUZ[0];
    let d1u = pUZ[bi] - uz0;
    let d2u = pUZ[bj] - uz0;
    g_duzdx = (d1u * e2y - d2u * e1y) * inv_det;
    g_duzdy = (d2u * e1x - d1u * e2x) * inv_det;

    let vz0 = pVZ[0];
    let d1v = pVZ[bi] - vz0;
    let d2v = pVZ[bj] - vz0;
    g_dvzdx = (d1v * e2y - d2v * e1y) * inv_det;
    g_dvzdy = (d2v * e1x - d1v * e2x) * inv_det;

    let w0 = pW[0];
    let d1w = pW[bi] - w0;
    let d2w = pW[bj] - w0;
    g_dwdx = (d1w * e2y - d2w * e1y) * inv_det;
    g_dwdy = (d2w * e1x - d1w * e2x) * inv_det;

    g_lu0 = f.lu0; g_lv0 = f.lv0;
    g_l_k = f.l_k; g_l_u = f.l_u; g_l_v = f.l_v; g_l_uv = f.l_uv;

    g_uz0 = uz0; g_vz0 = vz0; g_w0 = w0;
    g_ref_x = x0; g_ref_y = y0;
    g_pix = f.pix;
    g_umask = f.umask;
    g_vshift = f.vshift;
    g_vmask = f.vmask;
    g_uwrap = f.uwrap;
    g_vwrap = f.vwrap;

    // What the face lets through, and the ceiling that puts on its share of a
    // blended pixel. The floor comes down with it so that a nearly clear pane
    // is not held above its own alpha by it.
    g_inv_alpha = f.inv_alpha8;
    g_l_max = f.alpha8 << L_SHIFT;
    g_l_min = L_MIN_FX;
    if (g_l_min > g_l_max) g_l_min = g_l_max;

    return m;
}

// Draw one face, or, if you can see through it, take down where it is visible
// and leave it for `draw_deferred`
fun draw_face(f) {
    if (f.alpha >= 1.0) {
        let m = face_setup(f, true);
        if (m > 0) raster_poly(m);
        return;
    }

    if (df_num >= MAX_DEFER_FACES || ds_top >= MAX_DEFER_SPANS) return;

    let first = ds_top;
    g_collecting = true;
    let m = face_setup(f, true);
    if (m > 0) raster_poly(m);
    g_collecting = false;

    // Every part of it was hidden, so it never reaches the second pass
    if (ds_top == first) return;

    df_face[df_num] = f;
    df_first[df_num] = first;
    df_count[df_num] = ds_top - first;
    df_num = df_num + 1;
}

// The second pass: the faces held back, replayed furthest first, each over a
// frame buffer that is finished underneath it
fun draw_deferred() {
    for (let var i = df_num - 1; i >= 0; --i) {
        let f = df_face[i];
        if (face_setup(f, false) > 0) raster_spans(df_first[i], df_count[i]);
    }
}

// --- Models in the tree ---
//
// Each model in the world is pushed down the tree by its box until it either
// crosses a plane or reaches an empty side of a node, and is drawn where the
// walk meets it, so that it hides what is behind it and is hidden by what is
// in front the way faces are.
//
// One in an empty side is like a face there: nothing drawn after it can be in
// front of it, so what it draws joins the face s-buffer, and can rule out
// whole nodes behind it. Those sharing a side are drawn nearest first, and
// only join once all of them are done, since they may overlap each other.
//
// One crossing a plane goes on down the side the eye is on. Whatever is in the
// face s-buffer when it is drawn is still nearer than all of it, even the part
// beyond the plane. What is drawn after it may not be, which the model
// s-buffer sorts out, so it only joins the face s-buffer once the walk is done
// with the first node it crossed.
//
// The lists live in a pool, linked by index. Nodes keep the heads, which are
// only good for the frame numbered place_frame.
let MAX_PLACED = 512;
let pl_inst = Array.with_size(MAX_PLACED, nil);
let pl_next = Array.with_size(MAX_PLACED, 0);
let pl_owner = Array.with_size(MAX_PLACED, nil);
let pl_dist = Array.with_size(MAX_PLACED, 0.0);
let pl_cx = Array.with_size(MAX_PLACED, 0.0);
let pl_cy = Array.with_size(MAX_PLACED, 0.0);
let pl_cz = Array.with_size(MAX_PLACED, 0.0);
let pl_hx = Array.with_size(MAX_PLACED, 0.0);
let pl_hy = Array.with_size(MAX_PLACED, 0.0);
let pl_hz = Array.with_size(MAX_PLACED, 0.0);
let var pl_num = 0;
let var place_frame = 0;

// How far a box may poke through a plane and still count as on one side of
// it, for rounding: the part poking through would show over the face there
let PLACE_SLACK = 0.002;

// Whether the model being drawn is clipped against the face s-buffer, which
// is right for one met in the tree walk, since all of it is nearer, and
// whether the pieces it draws are written down to join that s-buffer later
let var g_model_clip = false;
let var g_recording = false;

// The node whose end the pieces being drawn wait for, nil for none
let var g_rec_owner = nil;

// Where a scanline of a model is left after the face s-buffer
let cov_x0 = Array.with_size(MAX_VIS, 0);
let cov_x1 = Array.with_size(MAX_VIS, 0);

// The pieces models have drawn this frame, waiting to be added to the face
// s-buffer. Running out only means fewer of them are added, which costs time
// but not correctness, since faces still meet them in the model s-buffer.
let MAX_REC = 32768;
let rec_y = Array.with_size(MAX_REC, 0);
let rec_x0 = Array.with_size(MAX_REC, 0);
let rec_x1 = Array.with_size(MAX_REC, 0);
let rec_owner = Array.with_size(MAX_REC, nil);
let var rec_top = 0;

// Add the pieces recorded from first on that wait for owner
fun rec_flush(first, owner) {
    for (let var i = first; i < rec_top; ++i) {
        if (screen_done) return;
        if (rec_owner[i] == owner) sbuf_insert(rec_y[i], rec_x0[i], rec_x1[i]);
    }
}

// Where the last box `box_occluded` projected landed on screen, if all of it
// was in front of the eye
let var box_on_screen = false;
let var box_rx0 = 0; let var box_ry0 = 0;
let var box_rx1 = 0; let var box_ry1 = 0;

// What the face s-buffer leaves visible of the rectangle a model can reach,
// row by row, so that its triangles are not each walking the whole row
let MAX_GAPS = 16384;
let gap_x0 = Array.with_size(MAX_GAPS, 0);
let gap_x1 = Array.with_size(MAX_GAPS, 0);
let gap_first = Array.with_size(FRAME_HEIGHT, 0);
let gap_count = Array.with_size(FRAME_HEIGHT, 0);
let var gaps_x0 = 0; let var gaps_x1 = 0;
let var gaps_y0 = 0; let var gaps_y1 = 0;

// Kept at unit length, so the distance to a plane can be held against a radius
fun set_frustum_plane(i, nx, ny, nz, d) {
    let s = 1.0 / (nx * nx + ny * ny + nz * nz).sqrt();
    fr_nx[i] = nx * s; fr_ny[i] = ny * s; fr_nz[i] = nz * s; fr_d[i] = d * s;
}

// Rebuild the frustum for where the camera is now. The camera's own axes come
// straight out of the yaw and pitch the view transform uses.
fun update_frustum() {
    let fx = cos_pitch * sin_yaw;
    let fy = sin_pitch;
    let fz = cos_pitch * cos_yaw;

    // Right and up before the roll, and then turned by it
    let rx0 = cos_yaw;
    let rz0 = 0.0 - sin_yaw;
    let ux0 = 0.0 - sin_pitch * sin_yaw;
    let uy0 = cos_pitch;
    let uz0 = 0.0 - sin_pitch * cos_yaw;

    let rx = rx0 * cos_roll + ux0 * sin_roll;
    let ry = uy0 * sin_roll;
    let rz = rz0 * cos_roll + uz0 * sin_roll;
    let ux = ux0 * cos_roll - rx0 * sin_roll;
    let uy = uy0 * cos_roll;
    let uz = uz0 * cos_roll - rz0 * sin_roll;

    // How far the frustum opens out sideways, per unit of depth
    let tan_h = CENTER_X / FOCAL;

    set_frustum_plane(0, fx, fy, fz, fx * cam_x + fy * cam_y + fz * cam_z + NEAR);

    let lx = rx + tan_h * fx; let ly = ry + tan_h * fy; let lz = rz + tan_h * fz;
    set_frustum_plane(1, lx, ly, lz, lx * cam_x + ly * cam_y + lz * cam_z);

    let sx = tan_h * fx - rx; let sy = tan_h * fy - ry; let sz = tan_h * fz - rz;
    set_frustum_plane(2, sx, sy, sz, sx * cam_x + sy * cam_y + sz * cam_z);

    // The top and bottom planes go through the edges of this actor's band
    // rather than the frame's, so the walk turns away subtrees outside it
    let tan_b = (render_y1.to_f() - CENTER_Y) / FOCAL;
    let bx = ux + tan_b * fx; let by = uy + tan_b * fy; let bz = uz + tan_b * fz;
    set_frustum_plane(3, bx, by, bz, bx * cam_x + by * cam_y + bz * cam_z);

    let tan_t = (CENTER_Y - render_y0.to_f()) / FOCAL;
    let tx = tan_t * fx - ux; let ty = tan_t * fy - uy; let tz = tan_t * fz - uz;
    set_frustum_plane(4, tx, ty, tz, tx * cam_x + ty * cam_y + tz * cam_z);
}

// Is this subtree's box entirely outside one of the frustum planes?
fun node_hidden(node) {
    if (node.empty) return true;

    for (let var i = 0; i < 5; ++i) {
        let nx = fr_nx[i];
        let ny = fr_ny[i];
        let nz = fr_nz[i];
        let reach = nx.abs() * node.hx + ny.abs() * node.hy + nz.abs() * node.hz;
        if (nx * node.cx + ny * node.cy + nz * node.cz - fr_d[i] + reach < 0.0) return true;
    }
    return false;
}

// Project a subtree's world-space box and reject it when the s-buffer already
// covers the box's whole screen rectangle. If the box crosses the near plane,
// projection is unbounded and its corners no longer give a useful enclosure,
// so that case deliberately falls back to normal traversal.
fun node_occluded(node) {
    // Moving lava can leave the static box computed from its source face.
    if (node.moving) return false;
    return box_occluded(node.cx, node.cy, node.cz, node.hx, node.hy, node.hz);
}

// The same for any box, given by its center and half extents. This only
// proves it hidden if everything in the s-buffer is known to be nearer.
fun box_occluded(cx, cy, cz, hx, hy, hz) {
    box_on_screen = false;
    let var box_x0 = 0.0; let var box_y0 = 0.0;
    let var box_x1 = 0.0; let var box_y1 = 0.0;
    for (let var i = 0; i < 8; ++i) {
        let var wx = cx - hx;
        let var wy = cy - hy;
        let var wz = cz - hz;
        if ((i & 1) != 0) wx = cx + hx;
        if ((i & 2) != 0) wy = cy + hy;
        if ((i & 4) != 0) wz = cz + hz;

        let dx = wx - cam_x;
        let dy = wy - cam_y;
        let dz = wz - cam_z;
        let rx = dx * cos_yaw - dz * sin_yaw;
        let rz = dx * sin_yaw + dz * cos_yaw;
        let ry = dy * cos_pitch - rz * sin_pitch;
        let vz = rz * cos_pitch + dy * sin_pitch;
        if (vz <= NEAR) return false;
        let vx = rx * cos_roll + ry * sin_roll;
        let vy = ry * cos_roll - rx * sin_roll;

        let sx = CENTER_X + FOCAL * vx / vz;
        let sy = CENTER_Y - FOCAL * vy / vz;
        if (i == 0) {
            box_x0 = sx; box_x1 = sx;
            box_y0 = sy; box_y1 = sy;
        } else {
            if (sx < box_x0) box_x0 = sx;
            if (sx > box_x1) box_x1 = sx;
            if (sy < box_y0) box_y0 = sy;
            if (sy > box_y1) box_y1 = sy;
        }
    }

    let rx0 = box_x0.floor().max(0);
    let ry0 = box_y0.floor().max(0);
    let rx1 = box_x1.floor().min(FRAME_WIDTH);
    let ry1 = box_y1.floor().min(FRAME_HEIGHT);
    box_rx0 = rx0; box_ry0 = ry0; box_rx1 = rx1; box_ry1 = ry1;
    box_on_screen = true;
    return rx0 < rx1 && ry0 < ry1 && sbuf_covers_rect(rx0, ry0, rx1, ry1);
}

// Take down the gaps for the box `box_occluded` last projected, a pixel wider
// all around for rounding, or for the whole band if it reached behind the eye.
// A row whose gaps did not fit gets a count of -1. Returns whether nothing at
// all is in the way there.
fun cache_gaps() {
    gaps_x0 = 0; gaps_x1 = FRAME_WIDTH;
    gaps_y0 = render_y0; gaps_y1 = render_y1;
    if (box_on_screen) {
        gaps_x0 = (box_rx0 - 1).max(0);
        gaps_x1 = (box_rx1 + 1).min(FRAME_WIDTH);
        gaps_y0 = (box_ry0 - 1).max(render_y0);
        gaps_y1 = (box_ry1 + 1).min(render_y1);
    }

    let var top = 0;
    let var clear = true;
    for (let var y = gaps_y0; y < gaps_y1; ++y) {
        let n = sbuf_visible(y, gaps_x0, gaps_x1);
        if (n != 1 || vis_x0[0] != gaps_x0 || vis_x1[0] != gaps_x1) clear = false;
        if (top + n > MAX_GAPS) {
            gap_count[y] = 0 - 1;
            continue;
        }
        gap_first[y] = top;
        gap_count[y] = n;
        for (let var k = 0; k < n; ++k) {
            gap_x0[top] = vis_x0[k];
            gap_x1[top] = vis_x1[k];
            top = top + 1;
        }
    }
    return clear;
}

// The parts of [x0, x1) on scanline y the face s-buffer leaves visible, into
// cov_x0/cov_x1, and their number
fun model_gaps(y, x0, x1) {
    if (y < gaps_y0 || y >= gaps_y1 || x0 < gaps_x0 || x1 > gaps_x1 || gap_count[y] < 0) {
        let n = sbuf_visible(y, x0, x1);
        for (let var k = 0; k < n; ++k) { cov_x0[k] = vis_x0[k]; cov_x1[k] = vis_x1[k]; }
        return n;
    }

    let var n = 0;
    let end = gap_first[y] + gap_count[y];
    for (let var g = gap_first[y]; g < end; ++g) {
        let lo = gap_x0[g].max(x0);
        let hi = gap_x1[g].min(x1);
        if (lo < hi) { cov_x0[n] = lo; cov_x1[n] = hi; n = n + 1; }
    }
    return n;
}


// Walk the tree from the eye: everything on the near side of a plane, then the
// faces lying in it, then everything beyond. Models placed in the tree are met
// along the way, see `place_models`.
fun bsp_draw(node) {
    if (node == nil) return;
    if (screen_done) return;

    // The box is around the faces only, so models in a subtree it rules out
    // still have to be visited on their own
    if (node_hidden(node)) {
        draw_placed_tree(node);
        return;
    }
    if (node_occluded(node)) {
        rect_nodes_skipped = rect_nodes_skipped + 1;
        draw_placed_tree(node);
        return;
    }

    let placed = node.m_frame == place_frame && node.m_count > 0;
    let first = rec_top;

    let near_front = node.nx * cam_x + node.ny * cam_y + node.nz * cam_z - node.d >= 0.0;
    let var near_child = node.back;
    let var far_child = node.front;
    if (near_front) { near_child = node.front; far_child = node.back; }

    if (near_child != nil) bsp_draw(near_child);
    else if (placed) draw_placed(near_front ? node.m_front : node.m_back);

    let on = node.on;
    for (let var i = 0; i < on.len; ++i) {
        if (screen_done) return;
        draw_face(on[i]);
    }

    if (far_child != nil) bsp_draw(far_child);
    else if (placed) draw_placed(near_front ? node.m_back : node.m_front);

    // What models crossing this plane drew can stand in front of nothing
    // from here on
    if (placed && node.m_cross) rec_flush(first, node);
}

// Visit only the models placed in a subtree, in the same order
fun draw_placed_tree(node) {
    if (node == nil || screen_done) return;
    if (node.m_frame != place_frame || node.m_count == 0) return;
    let first = rec_top;

    let near_front = node.nx * cam_x + node.ny * cam_y + node.nz * cam_z - node.d >= 0.0;
    if (near_front) {
        if (node.front != nil) draw_placed_tree(node.front); else draw_placed(node.m_front);
        if (node.back != nil) draw_placed_tree(node.back); else draw_placed(node.m_back);
    } else {
        if (node.back != nil) draw_placed_tree(node.back); else draw_placed(node.m_back);
        if (node.front != nil) draw_placed_tree(node.front); else draw_placed(node.m_front);
    }

    if (node.m_cross) rec_flush(first, node);
}

// --- Models ---
//
// Each frame comes with a draw list, one entry per model to draw:
//
//   [model id, animation, time, x, y, z, yaw, scale, light level, in view, pitch]
//
// The model stands with the middle of its base at x, y, z, facing along yaw
// the way the player does. The light level is on the 0..255 scale the bake
// uses, sampled where the model stands.
//
// With `in view` set, the model is held in front of the eye rather than placed
// in the world, like a weapon: x, y, z are where its middle goes in view space,
// with x to the right, y up and z ahead, and it is drawn in front of anything
// in the world, however close. Pitch tips it up after the yaw has turned it,
// and is only used in view.

let var draw_list = [];

// The light on a model: mostly from above, a little from the side it is seen
// from, so that it has some shape to it. Unit length, in world space.
let MODEL_LIGHT_X = 0.3;
let MODEL_LIGHT_Y = 0.9;
let MODEL_LIGHT_Z = 0.3;
let MODEL_LIGHT_LEN = (MODEL_LIGHT_X * MODEL_LIGHT_X + MODEL_LIGHT_Y * MODEL_LIGHT_Y
    + MODEL_LIGHT_Z * MODEL_LIGHT_Z).sqrt();

// How much of the level a model takes facing away from that light, and how
// much more it takes facing it
let MODEL_AMBIENT = 0.6;
let MODEL_DIFFUSE = 0.55;

let model_proj = Projection(FOCAL, CENTER_X, CENTER_Y);

// The transform from the model being drawn to view space
let model_mat = Array.with_size(12, 0.0);

// The 1/z-weighted light of the triangle being drawn, which models carry per
// vertex and faces do not
let var g_dlzdx = 0.0; let var g_dlzdy = 0.0; let var g_lz0 = 0.0;

// What the 1/z of the model being drawn is scaled by in the model s-buffer:
// 1 for one standing in the world, HELD_DEPTH_SCALE for one held in view
let var g_wk = 1.0;
let HELD_DEPTH_SCALE = 1000.0;

// The corners of the triangle being drawn are pX/pY[0..3]

// Walk the triangle in pX/pY scanline by scanline, hand each span to the model
// s-buffer, and draw whatever comes back as visible. Rows outside this actor's
// band are stepped over but not drawn.
fun raster_triangle() {
    let var top = 0;
    let var y_min = pY[0];
    let var bot = 0;
    let var y_max = pY[0];
    for (let var i = 1; i < 3; ++i) {
        if (pY[i] < y_min) { y_min = pY[i]; top = i; }
        if (pY[i] > y_max) { y_max = pY[i]; bot = i; }
    }

    // Start at the band's first row, as `raster_poly` does
    let var scan_y = y_min.floor();
    if (scan_y < render_y0) scan_y = render_y0;
    let var end_y = y_max.floor();
    if (end_y > render_y1) end_y = render_y1;
    if (scan_y >= end_y) return;

    let y_off = scan_y + 0.5 - g_ref_y;
    let x_off = 0.5 - g_ref_x;
    let var uz_row = g_uz0 + x_off * g_duzdx + y_off * g_duzdy;
    let var vz_row = g_vz0 + x_off * g_dvzdx + y_off * g_dvzdy;
    let var lz_row = g_lz0 + x_off * g_dlzdx + y_off * g_dlzdy;
    let var w_row = g_w0 + x_off * g_dwdx + y_off * g_dwdy;

    let duzdx = g_duzdx; let dvzdx = g_dvzdx;
    let dlzdx = g_dlzdx; let dwdx = g_dwdx;
    let pix = g_pix;
    let umask = g_umask;
    let vshift = g_vshift;
    let vmask = g_vmask;
    let uwrap = g_uwrap;
    let vwrap = g_vwrap;
    let mask_rb = MASK_RB;
    let fb = frame_buffer;

    // Every triangle drawn faces the eye, so the corners after the top one run
    // down its left side, and those before it down its right side
    let var cl = top; let var xl = 0.0; let var dxl = 0.0; let var end_l = scan_y;
    let var cr = top; let var xr = 0.0; let var dxr = 0.0; let var end_r = scan_y;
    let var row = scan_y * FRAME_WIDTH;
    let var span_px = 0;

    while (scan_y < end_y) {
        while (scan_y >= end_l && cl != bot) {
            let ya = pY[cl];
            let xa = pX[cl];
            cl = (cl + 1) % 3;
            let yb = pY[cl];
            let var e = yb.floor();
            if (e > end_y) e = end_y;
            end_l = e;
            if (end_l > scan_y && yb > ya) {
                dxl = (pX[cl] - xa) / (yb - ya);
                xl = xa + (scan_y + 1 - ya) * dxl;
            }
        }
        while (scan_y >= end_r && cr != bot) {
            let ya = pY[cr];
            let xa = pX[cr];
            cr = (cr + 2) % 3;
            let yb = pY[cr];
            let var e = yb.floor();
            if (e > end_y) e = end_y;
            end_r = e;
            if (end_r > scan_y && yb > ya) {
                dxr = (pX[cr] - xa) / (yb - ya);
                xr = xa + (scan_y + 1 - ya) * dxr;
            }
        }

        let var band_end = end_l;
        if (end_r < band_end) band_end = end_r;
        if (band_end <= scan_y) break;

        while (scan_y < band_end) {
            let var xa = xl.floor();
            if (xa < 0) xa = 0;
            let var xb = xr.floor();
            if (xb > FRAME_WIDTH) xb = FRAME_WIDTH;

            // What the face s-buffer already covers is nearer, so only the
            // gaps in it go on to the depth test against other models
            let var n_cov = 0;
            if (scan_y >= render_y0 && xa < xb) {
                if (g_model_clip) {
                    n_cov = model_gaps(scan_y, xa, xb);
                } else {
                    n_cov = 1; cov_x0[0] = xa; cov_x1[0] = xb;
                }
            }

            for (let var ci = 0; ci < n_cov; ++ci) {
                let n_vis = msb_insert(scan_y, cov_x0[ci], cov_x1[ci], w_row * g_wk, dwdx * g_wk);
                if (g_recording) {
                    for (let var k = 0; k < n_vis && rec_top < MAX_REC; ++k) {
                        rec_y[rec_top] = scan_y;
                        rec_x0[rec_top] = vis_x0[k];
                        rec_x1[rec_top] = vis_x1[k];
                        rec_owner[rec_top] = g_rec_owner;
                        rec_top = rec_top + 1;
                    }
                }
                for (let var k = 0; k < n_vis; ++k) {
                    let var x = vis_x0[k];
                    let piece_end = vis_x1[k];

                    let var uz = uz_row + x * duzdx;
                    let var vz = vz_row + x * dvzdx;
                    let var lz = lz_row + x * dlzdx;
                    let var w = w_row + x * dwdx;
                    let var z = 1.0 / w;
                    let var u = uz * z;
                    let var v = vz * z;

                    let var wscale = 0.0;
                    let adw = dwdx.abs();
                    if (adw > 0.0) wscale = PERSP_TOL / adw;

                    let var lfx = (lz * z * L_ONE).floor();
                    if (lfx < L_MIN_FX) lfx = L_MIN_FX;
                    else if (lfx > L_MAX_FX) lfx = L_MAX_FX;

                    while (x < piece_end) {
                        let var run = SUB_MAX;
                        if (wscale > 0.0) {
                            let nf = w * wscale;
                            if (nf < SUB_MAX.to_f()) {
                                run = nf.floor();
                                if (run < 1) run = 1;
                            }
                        }

                        let var xe = x + run;
                        if (xe > piece_end) xe = piece_end;
                        let len = xe - x;

                        let uz_e = uz + len * duzdx;
                        let vz_e = vz + len * dvzdx;
                        let lz_e = lz + len * dlzdx;
                        let w_e = w + len * dwdx;
                        let z_e = 1.0 / w_e;
                        let u_e = uz_e * z_e;
                        let v_e = vz_e * z_e;

                        let inv_len = INV_N[len];
                        let var du = (u_e - u) * inv_len;
                        let var dv = (v_e - v) * inv_len;
                        if (du > GRAD_LIMIT) du = GRAD_LIMIT;
                        else if (du < 0.0 - GRAD_LIMIT) du = 0.0 - GRAD_LIMIT;
                        if (dv > GRAD_LIMIT) dv = GRAD_LIMIT;
                        else if (dv < 0.0 - GRAD_LIMIT) dv = 0.0 - GRAD_LIMIT;

                        let ufx = ((((u + BIAS_TEXELS) * FP_ONE).floor()) & uwrap) + EXC_FX;
                        let vfx = ((((v + BIAS_TEXELS) * FP_ONE).floor()) & vwrap) + EXC_FX;
                        let var t = (vfx << 32) + ufx;
                        let dt = ((dv * FP_ONE).floor() << 32) + (du * FP_ONE).floor();

                        let var lfx_e = (lz_e * z_e * L_ONE).floor();
                        if (lfx_e < L_MIN_FX) lfx_e = L_MIN_FX;
                        else if (lfx_e > L_MAX_FX) lfx_e = L_MAX_FX;

                        let dl = ((lfx_e - lfx).to_f() * inv_len).floor();

                        let var lp = lfx;
                        let var i = row + x;
                        let end_i = row + xe;
                        span_px = span_px + len;
                        while (i < end_i) {
                            let c = pix.get_u32(((t >> vshift) & vmask)
                                              | ((t >> U_SHIFT) & umask));
                            let x = ((c & mask_rb) | ((c & MASK_G) << 24))
                                  * (lp >> L_SHIFT);
                            fb.set_u32(i, ((x >> 8) & mask_rb)
                                        | ((x >> 32) & 0xFF00));
                            t = t + dt;
                            lp = lp + dl;
                            i = i + 1;
                        }

                        lfx = lfx_e;
                        uz = uz_e; vz = vz_e; lz = lz_e; w = w_e;
                        u = u_e; v = v_e;
                        x = xe;
                    }
                }
            }

            xl = xl + dxl;
            xr = xr + dxr;
            uz_row = uz_row + g_duzdy;
            vz_row = vz_row + g_dvzdy;
            lz_row = lz_row + g_dlzdy;
            w_row = w_row + g_dwdy;
            row = row + FRAME_WIDTH;
            scan_y = scan_y + 1;
        }
    }

    pixels_drawn = pixels_drawn + span_px;
}

// Work out the gradients the span loop runs on for a triangle given by its
// three corners on screen, each with its 1/z and u, v and light over z, and
// draw it with the texture already set
fun draw_projected(x0, y0, w0, uz0, vz0, lz0, x1, y1, w1, uz1, vz1, lz1, x2, y2, w2, uz2, vz2, lz2) {
    pX[0] = x0; pY[0] = y0;
    pX[1] = x1; pY[1] = y1;
    pX[2] = x2; pY[2] = y2;

    // Too thin to cover a pixel, or to take gradients from
    let e1x = x1 - x0; let e1y = y1 - y0;
    let e2x = x2 - x0; let e2y = y2 - y0;
    let det = e1x * e2y - e2x * e1y;
    if (det > -0.000001) return;
    let inv_det = 1.0 / det;

    let d1u = uz1 - uz0;
    let d2u = uz2 - uz0;
    g_duzdx = (d1u * e2y - d2u * e1y) * inv_det;
    g_duzdy = (d2u * e1x - d1u * e2x) * inv_det;

    let d1v = vz1 - vz0;
    let d2v = vz2 - vz0;
    g_dvzdx = (d1v * e2y - d2v * e1y) * inv_det;
    g_dvzdy = (d2v * e1x - d1v * e2x) * inv_det;

    let d1l = lz1 - lz0;
    let d2l = lz2 - lz0;
    g_dlzdx = (d1l * e2y - d2l * e1y) * inv_det;
    g_dlzdy = (d2l * e1x - d1l * e2x) * inv_det;

    let d1w = w1 - w0;
    let d2w = w2 - w0;
    g_dwdx = (d1w * e2y - d2w * e1y) * inv_det;
    g_dwdy = (d2w * e1x - d1w * e2x) * inv_det;

    g_uz0 = uz0; g_vz0 = vz0; g_lz0 = lz0; g_w0 = w0;
    g_ref_x = x0; g_ref_y = y0;

    raster_triangle();
}

// A triangle cut by the near plane, in view space: up to four corners, each
// a position, texture coordinates in texels and a light level
let clip_x = Array.with_size(4, 0.0);
let clip_y = Array.with_size(4, 0.0);
let clip_z = Array.with_size(4, 0.0);
let clip_u = Array.with_size(4, 0.0);
let clip_v = Array.with_size(4, 0.0);
let clip_l = Array.with_size(4, 0.0);
let var clip_n = 0;

// Add the corner a fraction f of the way from vertex a to vertex b
fun clip_add(model, a, b, f) {
    let n = clip_n;
    clip_x[n] = model.vVX[a] + (model.vVX[b] - model.vVX[a]) * f;
    clip_y[n] = model.vVY[a] + (model.vVY[b] - model.vVY[a]) * f;
    clip_z[n] = model.vD[a] + (model.vD[b] - model.vD[a]) * f;
    clip_u[n] = model.vert_u[a] + (model.vert_u[b] - model.vert_u[a]) * f;
    clip_v[n] = model.vert_v[a] + (model.vert_v[b] - model.vert_v[a]) * f;
    clip_l[n] = model.vL[a] + (model.vL[b] - model.vL[a]) * f;
    clip_n = n + 1;
}

// Keep the start of the edge from a to b if it is in front of the near plane,
// and where the edge crosses it if it does
fun clip_edge(model, a, b) {
    let da = model.vD[a];
    let db = model.vD[b];
    if (da >= NEAR) clip_add(model, a, b, 0.0);
    if ((da >= NEAR) != (db >= NEAR)) clip_add(model, a, b, (NEAR - da) / (db - da));
}

// Draw corners 0, i and j of the clipped polygon
fun draw_clipped(i, j) {
    let w0 = 1.0 / clip_z[0]; let w1 = 1.0 / clip_z[i]; let w2 = 1.0 / clip_z[j];
    draw_projected(
        CENTER_X + FOCAL * clip_x[0] * w0, CENTER_Y - FOCAL * clip_y[0] * w0, w0,
        clip_u[0] * w0, clip_v[0] * w0, clip_l[0] * w0,
        CENTER_X + FOCAL * clip_x[i] * w1, CENTER_Y - FOCAL * clip_y[i] * w1, w1,
        clip_u[i] * w1, clip_v[i] * w1, clip_l[i] * w1,
        CENTER_X + FOCAL * clip_x[j] * w2, CENTER_Y - FOCAL * clip_y[j] * w2, w2,
        clip_u[j] * w2, clip_v[j] * w2, clip_l[j] * w2);
}

// Draw one triangle of a model that transform() has left in view space. One
// that reaches through the near plane is cut off at it, which matters for big
// flat models such as doors, whose few triangles span more than the view.
fun draw_triangle(model, t) {
    let indices = model.indices;
    let vD = model.vD;

    let a = indices[t * 3];
    let b = indices[t * 3 + 1];
    let c = indices[t * 3 + 2];

    let in_a = vD[a] >= NEAR;
    let in_b = vD[b] >= NEAR;
    let in_c = vD[c] >= NEAR;
    if (!in_a && !in_b && !in_c) return;

    let tex = model.tri_tex[t];
    g_pix = tex.pix;
    g_umask = tex.umask;
    g_vshift = tex.vshift;
    g_vmask = tex.vmask;
    g_uwrap = tex.uwrap;
    g_vwrap = tex.vwrap;

    if (in_a && in_b && in_c) {
        let vX = model.vX; let vY = model.vY; let vW = model.vW;
        let vUZ = model.vUZ; let vVZ = model.vVZ; let vLZ = model.vLZ;
        draw_projected(vX[a], vY[a], vW[a], vUZ[a], vVZ[a], vLZ[a],
                       vX[b], vY[b], vW[b], vUZ[b], vVZ[b], vLZ[b],
                       vX[c], vY[c], vW[c], vUZ[c], vVZ[c], vLZ[c]);
        return;
    }

    clip_n = 0;
    clip_edge(model, a, b);
    clip_edge(model, b, c);
    clip_edge(model, c, a);
    for (let var i = 1; i + 1 < clip_n; ++i) draw_clipped(i, i + 1);
}

// A direction in world space, turned into view space
fun view_dir_x(x, y, z) {
    let rx = x * cos_yaw - z * sin_yaw;
    let ry = y * cos_pitch - (x * sin_yaw + z * cos_yaw) * sin_pitch;
    return rx * cos_roll + ry * sin_roll;
}
fun view_dir_y(x, y, z) {
    let rx = x * cos_yaw - z * sin_yaw;
    let ry = y * cos_pitch - (x * sin_yaw + z * cos_yaw) * sin_pitch;
    return ry * cos_roll - rx * sin_roll;
}
fun view_dir_z(x, y, z) { return (x * sin_yaw + z * cos_yaw) * cos_pitch + y * sin_pitch; }

// The transform of a model held in front of the eye, into m: x, y, z are
// where the middle of the model goes in view space, yaw turns it about the
// view's up axis and then pitch about its right axis, tipping its front up.
// The axes are those of a model standing in the world, without the camera.
fun held_matrix(m, model, x, y, z, yaw, pitch, s) {
    let ce = yaw.cos(); let se = yaw.sin();
    let cp = pitch.cos(); let sp = pitch.sin();

    m[0] = (0.0 - ce) * s; m[4] = se * sp * s; m[8] = se * cp * s;
    m[1] = 0.0;            m[5] = cp * s;      m[9] = (0.0 - sp) * s;
    m[2] = se * s;         m[6] = ce * sp * s; m[10] = ce * cp * s;

    let bx = model.mid_x; let by = model.mid_y; let bz = model.mid_z;
    m[3] = x - (m[0] * bx + m[1] * by + m[2] * bz);
    m[7] = y - (m[4] * bx + m[5] * by + m[6] * bz);
    m[11] = z - (m[8] * bx + m[9] * by + m[10] * bz);
}

// Could this entry of the draw list, standing in the world, show in the view
// and in this actor's band? Tested with the sphere around it in all its poses.
fun instance_in_band(inst) {
    let model = models[inst[0]];
    let s = inst[7];
    let yaw = inst[6];
    let sp = inst[10].sin();
    let r = model.radius * s;
    let up = (model.mid_y - model.min_y) * s;
    let cx = inst[3] - up * sp * yaw.sin();
    let cy = inst[4] + up * inst[10].cos();
    let cz = inst[5] - up * sp * yaw.cos();

    for (let var i = 0; i < 5; ++i) {
        let nx = fr_nx[i]; let ny = fr_ny[i]; let nz = fr_nz[i];
        let len = (nx * nx + ny * ny + nz * nz).sqrt();
        if (nx * cx + ny * cy + nz * cz - fr_d[i] + r * len < 0.0) return false;
    }
    let depth = view_dir_z(cx - cam_x, cy - cam_y, cz - cam_z);
    if (depth > r + NEAR) {
        let sy = CENTER_Y - FOCAL * view_dir_y(cx - cam_x, cy - cam_y, cz - cam_z) / depth;
        let sr = FOCAL * r / (depth - r);
        if (sy + sr < render_y0.to_f() || sy - sr > render_y1.to_f()) return false;
    }
    return true;
}

// Draw one entry of the draw list into the model s-buffer. One standing in
// the world has been through `instance_in_band` already.
fun draw_instance(inst) {
    let model = models[inst[0]];
    let ex = inst[3]; let ey = inst[4]; let ez = inst[5];
    let yaw = inst[6];
    let s = inst[7];
    let level = inst[8];
    let in_view = inst[9];

    let ce = yaw.cos();
    let se = yaw.sin();
    let m = model_mat;

    if (in_view) {
        held_matrix(m, model, ex, ey, ez, yaw, inst[10], s);

        // Its 1/z is stored scaled up by this much, so that it wins against
        // any wall the eye is standing close enough to for it to reach into.
        // Its own triangles keep their order among themselves.
        g_wk = HELD_DEPTH_SCALE;
    } else {
        // Tipped over backwards by pitch, about the middle of its base. 0 is
        // upright and PI / 2 is lying on its back.
        let cp = inst[10].cos();
        let sp = inst[10].sin();

        // The model's own space is right-handed with its front along +z, and
        // the world's is left-handed. Turning its x around makes it left-handed
        // with its front still along +z, and the yaw then turns +z to face
        // where the entity does. Tipping it back swings its up axis towards
        // its back and its front towards the sky. Each column here is where
        // one of the model's axes goes in view space, scaled.
        let yx = 0.0 - sp * se; let yz = 0.0 - sp * ce;
        let zx = cp * se; let zz = cp * ce;
        m[0] = view_dir_x(0.0 - ce, 0.0, se) * s;
        m[4] = view_dir_y(0.0 - ce, 0.0, se) * s;
        m[8] = view_dir_z(0.0 - ce, 0.0, se) * s;
        m[1] = view_dir_x(yx, cp, yz) * s;
        m[5] = view_dir_y(yx, cp, yz) * s;
        m[9] = view_dir_z(yx, cp, yz) * s;
        m[2] = view_dir_x(zx, sp, zz) * s;
        m[6] = view_dir_y(zx, sp, zz) * s;
        m[10] = view_dir_z(zx, sp, zz) * s;

        // The middle of the model's base goes where the entity stands
        let bx = model.mid_x; let by = model.min_y; let bz = model.mid_z;
        let dx = ex - cam_x; let dy = ey - cam_y; let dz = ez - cam_z;
        m[3] = view_dir_x(dx, dy, dz) - (m[0] * bx + m[1] * by + m[2] * bz);
        m[7] = view_dir_y(dx, dy, dz) - (m[4] * bx + m[5] * by + m[6] * bz);
        m[11] = view_dir_z(dx, dy, dz) - (m[8] * bx + m[9] * by + m[10] * bz);

        g_wk = 1.0;
    }

    // An entry can bring a light of its own: [ambient, diffuse, x, y, z]
    let k = level / 255.0;
    let var lx = MODEL_LIGHT_X / MODEL_LIGHT_LEN;
    let var ly = MODEL_LIGHT_Y / MODEL_LIGHT_LEN;
    let var lz = MODEL_LIGHT_Z / MODEL_LIGHT_LEN;
    let var ambient = MODEL_AMBIENT;
    let var diffuse = MODEL_DIFFUSE;
    if (inst.len > 11) {
        let own = inst[11];
        ambient = own[0];
        diffuse = own[1];
        let len = (own[2] * own[2] + own[3] * own[3] + own[4] * own[4]).sqrt();
        lx = own[2] / len; ly = own[3] / len; lz = own[4] / len;
    }
    let light = Light(view_dir_x(lx, ly, lz), view_dir_y(lx, ly, lz), view_dir_z(lx, ly, lz),
        ambient * k, diffuse * k);

    model.set_pose(inst[1], inst[2]);
    model.transform(m, s, model_proj, light);
    model.sort();

    let draw_order = model.draw_order;
    for (let var i = 0; i < model.tris_drawn; ++i) {
        draw_triangle(model, draw_order[i]);
    }
    mesh_used = true;
}

// --- Models in the tree, see the top of the BSP walk ---

// Link placed model i into the list starting at head, nearest first, and
// return the new head
fun pl_link(head, i) {
    let d = pl_dist[i];
    if (head < 0 || d <= pl_dist[head]) {
        pl_next[i] = head;
        return i;
    }
    let var cur = head;
    while (pl_next[cur] >= 0 && pl_dist[pl_next[cur]] < d) cur = pl_next[cur];
    pl_next[i] = pl_next[cur];
    pl_next[cur] = i;
    return head;
}

// Place the models of the draw list in the tree. Those that cannot be, such as
// one held in view, are drawn right away, ahead of everything.
fun place_models() {
    place_frame = place_frame + 1;
    pl_num = 0;
    rec_top = 0;

    for (let var k = 0; k < draw_list.len; ++k) {
        let inst = draw_list[k];
        if (!inst[9] && !instance_in_band(inst)) continue;
        if (inst[9] || bsp_root == nil || pl_num >= MAX_PLACED) {
            draw_instance(inst);
            continue;
        }

        let model = models[inst[0]];
        let s = inst[7];
        let pitch = inst[10];
        let i = pl_num;
        pl_num = pl_num + 1;
        pl_inst[i] = inst;

        if (pitch.abs() < 0.001) {
            // Upright, its own box turned by its yaw, all poses included
            let ce = inst[6].cos().abs(); let se = inst[6].sin().abs();
            let ax = model.half_x * s; let az = model.half_z * s;
            let half_h = (model.max_y - model.min_y) * s * 0.5;
            pl_cx[i] = inst[3]; pl_cy[i] = inst[4] + half_h; pl_cz[i] = inst[5];
            pl_hx[i] = ce * ax + se * az; pl_hy[i] = half_h; pl_hz[i] = se * ax + ce * az;
        } else {
            // Tipped over, the sphere around it, as `draw_instance` has it
            let r = model.radius * s;
            let up = (model.mid_y - model.min_y) * s;
            let sp = pitch.sin();
            let yaw = inst[6];
            pl_cx[i] = inst[3] - up * sp * yaw.sin();
            pl_cy[i] = inst[4] + up * pitch.cos();
            pl_cz[i] = inst[5] - up * sp * yaw.cos();
            pl_hx[i] = r; pl_hy[i] = r; pl_hz[i] = r;
        }

        let cx = pl_cx[i]; let cy = pl_cy[i]; let cz = pl_cz[i];
        let hx = pl_hx[i]; let hy = pl_hy[i]; let hz = pl_hz[i];
        let dx = cx - cam_x; let dy = cy - cam_y; let dz = cz - cam_z;
        pl_dist[i] = dx * dx + dy * dy + dz * dz;

        pl_owner[i] = nil;
        let var node = bsp_root;
        loop {
            if (node.m_frame != place_frame) {
                node.m_frame = place_frame;
                node.m_count = 0;
                node.m_cross = false;
                node.m_front = 0 - 1;
                node.m_back = 0 - 1;
            }
            node.m_count = node.m_count + 1;

            let dist = node.nx * cx + node.ny * cy + node.nz * cz - node.d;
            let reach = node.nx.abs() * hx + node.ny.abs() * hy + node.nz.abs() * hz;
            let var front = dist - reach >= 0.0 - PLACE_SLACK;
            if (!front && dist + reach > PLACE_SLACK) {
                // Across the plane: on with the eye's side, waiting for the
                // first such node to be done
                front = node.nx * cam_x + node.ny * cam_y + node.nz * cam_z - node.d >= 0.0;
                if (pl_owner[i] == nil) {
                    pl_owner[i] = node;
                    node.m_cross = true;
                }
            }

            if (front) {
                if (node.front == nil) { node.m_front = pl_link(node.m_front, i); break; }
                node = node.front;
            } else {
                if (node.back == nil) { node.m_back = pl_link(node.m_back, i); break; }
                node = node.back;
            }
        }
    }
}

// Draw the models placed in an empty side of a node. Those that crossed no
// plane on the way join the face s-buffer once they are all done.
fun draw_placed(head) {
    if (head < 0) return;
    let first = rec_top;

    g_recording = true;
    for (let var i = head; i >= 0; i = pl_next[i]) {
        if (screen_done) break;

        // Everything in the face s-buffer is nearer, so covering the box's
        // rectangle there hides it
        if (box_occluded(pl_cx[i], pl_cy[i], pl_cz[i], pl_hx[i], pl_hy[i], pl_hz[i])) continue;

        // With nothing in the way, its triangles can skip the face s-buffer
        g_model_clip = !cache_gaps();
        g_rec_owner = pl_owner[i];
        draw_instance(pl_inst[i]);
    }
    g_model_clip = false;
    g_recording = false;
    g_rec_owner = nil;

    rec_flush(first, nil);
}

// --- Muzzle flash ---
//
// No lamp can be added to the baked light for a frame, so a shot shows as a
// glow added over the finished frame where the muzzle is, the way a bright
// light blooms in a camera. Each render actor adds it to its own band, last,
// over everything, which is where a weapon held in view is anyway.

let FLASH_CORE = 0xFFFFF0C8;
let FLASH_HALO = 0xFFFF8A28;

// The flash of this frame: where on screen, its size in pixels per unit of
// the model it comes out of, and its strength, 0 for no flash
let var flash_x = 0.0;
let var flash_y = 0.0;
let var flash_unit = 0.0;
let var flash_strength = 0.0;

// How a glow fades from its middle out to its edge, as 256ths, indexed by the
// squared distance as a fraction of the squared radius, so that drawing one
// takes no square root. The fraction of the radius left is raised to a power:
// higher is a smaller, hotter middle.
let GLOW_STEPS = 256;

fun glow_table(power) {
    let t = Array.with_size(GLOW_STEPS + 1, 0);
    for (let var i = 0; i < GLOW_STEPS; ++i) {
        let f = 1.0 - (i.to_f() / GLOW_STEPS.to_f()).sqrt();
        t[i] = (f.pow(power) * 256.0).floor();
    }
    return t;
}

let HALO_TABLE = glow_table(1.6);
let CORE_TABLE = glow_table(1.5);

// A span of the model s-buffer belongs to a model held in view when its 1/z
// is past anything a model standing in the world could have, since a held one
// is stored scaled up by HELD_DEPTH_SCALE
let HELD_MIN_W = 50.0;

fun held_span(s) {
    return msp_w[s] + msp_x0[s].to_f() * msp_dw[s] > HELD_MIN_W;
}

// Add color to this band of the frame around a pixel, fading out to nothing
// at radius r along the table. Strength 1 adds the whole color at the middle.
//
// The flash comes out of the far end of the barrel, so the weapon it comes out
// of stands in front of it: pixels a model held in view covers are left alone.
fun draw_glow(cx, cy, r, color, strength, table) {
    if (r < 1.0) return;

    // The color as it is added at the middle, times 256
    let cr = (((color >> 16) & 0xFF).to_f() * strength).floor();
    let cg = (((color >> 8) & 0xFF).to_f() * strength).floor();
    let cb = ((color & 0xFF).to_f() * strength).floor();

    let rr = r * r;
    let scale = GLOW_STEPS.to_f() / rr;
    let y0 = (cy - r).floor().max(render_y0);
    let y1 = (cy + r).floor().min(render_y1 - 1);

    for (let var y = y0; y <= y1; ++y) {
        let dy = y.to_f() + 0.5 - cy;
        let h2 = rr - dy * dy;
        if (h2 <= 0.0) continue;

        // Only the part of the row inside the circle
        let h = h2.sqrt();
        let x0 = (cx - h).floor().max(0);
        let x1 = (cx + h).floor().min(FRAME_WIDTH - 1) + 1;
        let row = y * FRAME_WIDTH;
        let dy2 = dy * dy;

        // And of that, the runs between the spans of a held model
        let var x = x0;
        let var cur = mb_head[y];
        while (x < x1) {
            while (cur != NO_SPAN && (msp_x1[cur] <= x || !held_span(cur))) cur = msp_next[cur];

            let var end = x1;
            if (cur != NO_SPAN && msp_x0[cur] < end) end = msp_x0[cur];
            if (end > x) glow_run(row, x, end, cx, dy2, scale, table, cr, cg, cb);

            if (cur == NO_SPAN) break;
            x = msp_x1[cur].max(x);
            cur = msp_next[cur];
        }
    }
}

// Add the glow to pixels [x0, x1) of a row. It is smooth enough that a pair of
// pixels can share a level, which halves the work of finding it.
fun glow_run(row, x0, x1, cx, dy2, scale, table, cr, cg, cb) {
    let fb = frame_buffer;
    let var x = x0;
    while (x < x1) {
        let dx = x.to_f() + 1.0 - cx;
        let k = table[((dx * dx + dy2) * scale).floor().min(GLOW_STEPS)];
        let ar = (cr * k) >> 8;
        let ag = (cg * k) >> 8;
        let ab = (cb * k) >> 8;

        let end = (x + 2).min(x1);
        while (x < end) {
            let i = row + x;
            let c = fb.get_u32(i);
            let r8 = (((c >> 16) & 0xFF) + ar).min(255);
            let g8 = (((c >> 8) & 0xFF) + ag).min(255);
            let b8 = ((c & 0xFF) + ab).min(255);
            fb.set_u32(i, (r8 << 16) | (g8 << 8) | b8);
            x = x + 1;
        }
    }
}

fun draw_flash() {
    if (flash_strength <= 0.0) return;
    draw_glow(flash_x, flash_y, 0.3 * flash_unit, FLASH_HALO, 0.75 * flash_strength, HALO_TABLE);
    draw_glow(flash_x, flash_y, 0.16 * flash_unit, FLASH_CORE, 1.0 * flash_strength, CORE_TABLE);
}

// Flash the muzzle of a model held in view this frame, given by its draw list
// entry, at a point of the model in its own space, which is where the muzzle
// is. Strength runs from 1 as the shot goes off down to 0, which is no flash.
fun set_muzzle_flash(inst, px, py, pz, strength) {
    flash_strength = 0.0;
    if (inst == nil || strength <= 0.0) return;

    let model = models[inst[0]];
    let s = inst[7];
    let m = Array.with_size(12, 0.0);
    held_matrix(m, model, inst[3], inst[4], inst[5], inst[6], inst[10], s);

    let vx = m[0] * px + m[1] * py + m[2] * pz + m[3];
    let vy = m[4] * px + m[5] * py + m[6] * pz + m[7];
    let vz = m[8] * px + m[9] * py + m[10] * pz + m[11];
    if (vz <= NEAR) return;

    // Sized with the model, so that it stays the same against the gun
    flash_x = CENTER_X + FOCAL * vx / vz;
    flash_y = CENTER_Y - FOCAL * vy / vz;
    flash_unit = FOCAL * s / vz;
    flash_strength = strength;
}

// --- Particles and the screen tint ---

// Particles of this frame, such as blood, as a flat list of x, y, z, size in
// meters and color, five numbers for each
let var particles = [];

fun set_particles(list) {
    particles = list;
}

// Fill [x0, x1) x [y0, y1) of this band with a color, except where a model
// held in view covers it, since particles are out in the world beyond it
fun fill_unheld(x0, y0, x1, y1, color) {
    let fb = frame_buffer;
    for (let var y = y0.max(render_y0); y < y1.min(render_y1); ++y) {
        let row = y * FRAME_WIDTH;
        let var x = x0;
        let var cur = mb_head[y];
        while (x < x1) {
            while (cur != NO_SPAN && (msp_x1[cur] <= x || !held_span(cur))) cur = msp_next[cur];
            let var end = x1;
            if (cur != NO_SPAN && msp_x0[cur] < end) end = msp_x0[cur];
            for (let var i = row + x; i < row + end; ++i) fb.set_u32(i, color);
            if (cur == NO_SPAN) break;
            x = msp_x1[cur].max(x);
            cur = msp_next[cur];
        }
    }
}

// Draw each particle as a square facing the eye. They are not tested against
// what stands in front of them: they only ever start where a shot could see.
fun draw_particles() {
    let p = particles;
    for (let var i = 0; i + 4 < p.len; i += 5) {
        let dx = p[i] - cam_x; let dy = p[i + 1] - cam_y; let dz = p[i + 2] - cam_z;
        let vz = view_dir_z(dx, dy, dz);
        if (vz <= NEAR) continue;
        let sx = CENTER_X + FOCAL * view_dir_x(dx, dy, dz) / vz;
        let sy = CENTER_Y - FOCAL * view_dir_y(dx, dy, dz) / vz;
        let half = (FOCAL * p[i + 3] / vz * 0.5).max(0.5);
        let x0 = (sx - half).floor().max(0);
        let x1 = (sx + half).ceil().min(FRAME_WIDTH);
        let y0 = (sy - half).floor();
        let y1 = (sy + half).ceil();
        if (x0 >= x1 || y1 <= render_y0 || y0 >= render_y1) continue;
        fill_unheld(x0, y0, x1, y1, p[i + 4]);
    }
}

// A color the whole frame is pulled towards, such as red when the player is
// hurt, and how far, in 256ths, 0 for none
let var tint_color = 0;
let var tint_amount = 0;

fun set_screen_tint(color, amount) {
    tint_color = color;
    tint_amount = amount.clip(0, 256);
}

fun draw_tint() {
    if (tint_amount <= 0) return;
    let fb = frame_buffer;
    let keep = 256 - tint_amount;
    let add_rb = (tint_color & 0xFF00FF) * tint_amount;
    let add_g = (tint_color & 0xFF00) * tint_amount;
    let end = render_y1 * FRAME_WIDTH;
    for (let var i = render_y0 * FRAME_WIDTH; i < end; ++i) {
        let c = fb.get_u32(i);
        let rb = (((c & 0xFF00FF) * keep + add_rb) >> 8) & 0xFF00FF;
        let g = (((c & 0xFF00) * keep + add_g) >> 8) & 0xFF00;
        fb.set_u32(i, rb | g);
    }
}

// The models to draw from now on, as a list of entries described above
fun set_draw_list(list) {
    draw_list = list;
}

fun render_frame() {
    pixels_drawn = 0;
    rect_faces_skipped = 0;
    rect_nodes_skipped = 0;
    sbuf_reset();
    update_frustum();

    // Models are met in the tree walk, apart from those drawn up front here
    place_models();
    bsp_draw(bsp_root);

    // The opaque pass is what decides which pixels are sky, and the blend pass
    // below needs the sky already under it, so this falls between the two
    if (draw_sky()) {
        draw_stars();
        draw_moon();
    }

    // Everything opaque is down, so what was held back can be blended over it
    draw_deferred();

    draw_particles();

    // Over everything, including the weapon it comes out of
    draw_flash();
    draw_tint();

    // While this is still the band the model spans were made in, since the
    // next frame may hand this actor another
    mesh_reset();
}

// Where the camera is and which way it looks, and how far along the lava swell
// is. This is what each render actor is sent along with its band.
fun set_view(x, y, z, yaw, pitch, phase) {
    cam_x = x;
    cam_y = y;
    cam_z = z;
    cam_yaw = yaw;
    cam_pitch = pitch;
    sin_yaw = yaw.sin();
    cos_yaw = yaw.cos();
    sin_pitch = pitch.sin();
    cos_pitch = pitch.cos();
    warp_phase = phase;
    set_roll(0.0);
}

// Turn the view about the way it looks, in radians. Call after set_view(),
// which levels it.
fun set_roll(roll) {
    sin_roll = roll == 0.0 ? 0.0 : roll.sin();
    cos_roll = roll.cos();
}

// Hang each piece's texture on it, along with the masks the span loop wraps it
// with, so that drawing one is a straight read. The tree may have cut a piece
// up on the way in; every fragment carries the light of the piece it came out
// of.
fun prepare_node(node) {
    if (node == nil) return;

    for (let var i = 0; i < node.on.len; ++i) {
        let g = node.on[i];
        let t = g.tex;

        let var shift = 0;
        while ((1 << shift) < t.width) shift = shift + 1;

        g.pix = t.base;
        g.umask = t.width - 1;
        g.vshift = 32 + FP_BITS - shift;
        g.vmask = (t.height - 1) << shift;
        g.uwrap = (t.width << FP_BITS) - 1;
        g.vwrap = (t.height << FP_BITS) - 1;

        // A sphere around the corners for `face_setup` to cull with, grown by
        // how far lava swells
        let v = g.v;
        let var x0 = v[0]; let var y0 = v[1]; let var z0 = v[2];
        let var x1 = x0; let var y1 = y0; let var z1 = z0;
        for (let var k = 3; k < v.len; k = k + 3) {
            x0 = x0.min(v[k]); y0 = y0.min(v[k + 1]); z0 = z0.min(v[k + 2]);
            x1 = x1.max(v[k]); y1 = y1.max(v[k + 1]); z1 = z1.max(v[k + 2]);
        }
        let hx = (x1 - x0) * 0.5; let hy = (y1 - y0) * 0.5; let hz = (z1 - z0) * 0.5;
        g.bx = x0 + hx; g.by = y0 + hy; g.bz = z0 + hz;
        g.br = (hx * hx + hy * hy + hz * hz).sqrt() + (g.flow ? 2.0 * WAVE_AMP : 0.0) + 0.01;
    }

    prepare_node(node.front);
    prepare_node(node.back);
}

// Take the tree to draw. This has to happen before the render actors are
// started, since each one gets its own copy of it when it is spawned.
fun set_scene(root) {
    prepare_node(root);
    bsp_root = root;
}

class RenderBandRequest {
    init(self, frame_id, y0, y1) {
        self.frame_id = frame_id;
        self.y0 = y0;
        self.y1 = y1;
        self.cam_x = cam_x;
        self.cam_y = cam_y;
        self.cam_z = cam_z;
        self.cam_yaw = cam_yaw;
        self.cam_pitch = cam_pitch;
        self.sin_yaw = sin_yaw;
        self.cos_yaw = cos_yaw;
        self.sin_pitch = sin_pitch;
        self.cos_pitch = cos_pitch;
        self.sin_roll = sin_roll;
        self.cos_roll = cos_roll;
        self.warp_phase = warp_phase;
        self.draw_list = draw_list;
        self.flash_x = flash_x;
        self.flash_y = flash_y;
        self.flash_unit = flash_unit;
        self.flash_strength = flash_strength;
        self.particles = particles;
        self.tint_color = tint_color;
        self.tint_amount = tint_amount;
    }
}

class RenderBandResult {
    init(self, frame_id, actor_id, y0, num_bytes, pixels, num_pixels, num_faces_skipped, num_nodes_skipped) {
        self.frame_id = frame_id;
        self.actor_id = actor_id;
        self.y0 = y0;
        self.num_bytes = num_bytes;
        self.pixels = pixels;
        self.num_pixels = num_pixels;
        self.num_faces_skipped = num_faces_skipped;
        self.num_nodes_skipped = num_nodes_skipped;
    }
}

// Workers are forked only after the map has been prepared, so actor spawning
// gives each one a private copy of the finished BSP, textures and light data.
// The main actor dynamically hands out small row bands, so a worker running on
// a faster core naturally renders more of the frame.
fun render_actor_loop() {
    // Reused for every result. Sending copies it synchronously, so it is safe
    // for the worker to overwrite once the next request arrives.
    let pixels = ByteArray.with_size(BAND_HEIGHT * FRAME_WIDTH * 4);
    let actor_id = $actor_id();

    loop {
        let msg = $actor_recv();
        if (msg == nil) return;

        render_y0 = msg.y0;
        render_y1 = msg.y1;
        cam_x = msg.cam_x;
        cam_y = msg.cam_y;
        cam_z = msg.cam_z;
        cam_yaw = msg.cam_yaw;
        cam_pitch = msg.cam_pitch;
        sin_yaw = msg.sin_yaw;
        cos_yaw = msg.cos_yaw;
        sin_pitch = msg.sin_pitch;
        cos_pitch = msg.cos_pitch;
        sin_roll = msg.sin_roll;
        cos_roll = msg.cos_roll;
        warp_phase = msg.warp_phase;
        draw_list = msg.draw_list;
        flash_x = msg.flash_x;
        flash_y = msg.flash_y;
        flash_unit = msg.flash_unit;
        flash_strength = msg.flash_strength;
        particles = msg.particles;
        tint_color = msg.tint_color;
        tint_amount = msg.tint_amount;

        render_frame();
        let band_start = render_y0 * FRAME_WIDTH * 4;
        let band_bytes = (render_y1 - render_y0) * FRAME_WIDTH * 4;
        pixels.memcpy(0, frame_buffer, band_start, band_bytes);
        $actor_send($actor_parent(), RenderBandResult(
            msg.frame_id,
            actor_id,
            render_y0,
            band_bytes,
            pixels,
            pixels_drawn,
            rect_faces_skipped,
            rect_nodes_skipped
        ));
    }
}

let var render_actor_ids = nil;
let pending_ui_events = [];

fun start_render_actors(num_actors) {
    let ids = [];
    for (let var i = 0; i < num_actors; ++i) {
        ids.push($actor_spawn(render_actor_loop));
    }
    render_actor_ids = ids;
}

fun render_frame_parallel(frame_id) {
    let num_bands = (FRAME_HEIGHT + BAND_HEIGHT - 1).idiv(BAND_HEIGHT);
    let var next_y = 0;

    // Give every actor one band initially. From then on, whichever actor
    // returns first receives the next one.
    for (let var i = 0; i < render_actor_ids.len && next_y < FRAME_HEIGHT; ++i) {
        let y1 = (next_y + BAND_HEIGHT).min(FRAME_HEIGHT);
        $actor_send(render_actor_ids[i], RenderBandRequest(frame_id, next_y, y1));
        next_y = y1;
    }

    pixels_drawn = 0;
    rect_faces_skipped = 0;
    rect_nodes_skipped = 0;

    let var received = 0;
    while (received < num_bands) {
        let msg = $actor_recv();
        if (msg instanceof UIEvent) {
            pending_ui_events.push(msg);
            continue;
        }
        if (msg == nil || msg.frame_id != frame_id) continue;

        // Keep the returning actor busy before assembling its completed band.
        if (next_y < FRAME_HEIGHT) {
            let y1 = (next_y + BAND_HEIGHT).min(FRAME_HEIGHT);
            $actor_send(msg.actor_id, RenderBandRequest(frame_id, next_y, y1));
            next_y = y1;
        }

        frame_buffer.memcpy(
            msg.y0 * FRAME_WIDTH * 4,
            msg.pixels,
            0,
            msg.num_bytes
        );
        pixels_drawn = pixels_drawn + msg.num_pixels;
        rect_faces_skipped = rect_faces_skipped + msg.num_faces_skipped;
        rect_nodes_skipped = rect_nodes_skipped + msg.num_nodes_skipped;
        received = received + 1;
    }

    frame_stats.pixels_drawn = pixels_drawn;
    frame_stats.faces_skipped = rect_faces_skipped;
    frame_stats.nodes_skipped = rect_nodes_skipped;
}

fun stop_render_actors() {
    for (let var i = 0; i < render_actor_ids.len; ++i) {
        $actor_send(render_actor_ids[i], nil);
    }
    for (let var i = 0; i < render_actor_ids.len; ++i) {
        $actor_join(render_actor_ids[i]);
    }
}
