// Sound effects, synthesized as they play, but for a few recorded splats that
// are loaded from examples/tremor/sounds/ when this is imported.
//
// An actor of its own owns the audio device and fills a buffer whenever the
// device asks for one. The game sends it a message for each sound to start.
// It should be spawned as early as possible, since an actor starts with a copy
// of its parent's heap, and this one needs nothing from the world.
//
// Each sound playing is a voice: an object that adds its next n samples into
// the mix and says whether it has finished. Picking which kind of sound to
// synthesize happens once per buffer rather than once per sample, and as many
// can overlap as the pool has room for.
//
// The building blocks are those of the synthesizer in examples/space_fighter.psh:
// white noise from a linear congruential generator, one-pole low passes, the
// state variable filter for band passes, exponential decays and a soft limit.
// The sounds are noise shaped by those, plus a few tones. Then the mix goes
// through a short reverb, since the level is all stone rooms.
//
// To add a sound: write a Voice subclass and give it a name in make_voice().

from wav import load_wav;

let SAMPLE_RATE = 44100;
let DT = 1.0 / SAMPLE_RATE.to_f();
let PI = 3.14159265358979;
let TAU = 2.0 * PI;

// The most sounds that can play at once. A new one past that is dropped.
let MAX_VOICES = 24;

// How loud everything is, before the soft limit
let MASTER_GAIN = 0.8;

// What gets through each brush between a sound and the listener. Close by, a
// wall or two in the way only takes the edge off, since sound finds its way
// round; far off, each one counts for more. In between, the two are blended.
let MUFFLE_NEAR = 0.88;
let MUFFLE_FAR = 0.65;
let MUFFLE_NEAR_DIST = 15.0;
let MUFFLE_FAR_DIST = 25.0;

// And how dull it is: the cutoff of its low pass is MUFFLE_HZ through one far
// brush, and falls by half for each more, never past the bounds. Near brushes
// count for as much less as they take less of the level.
let MUFFLE_HZ = 2000.0;
let MUFFLE_HZ_MIN = 200.0;
let MUFFLE_HZ_MAX = 8000.0;

// --- Building blocks ---

let var noise_seed = 22222;

// White noise in [-1, 1)
fun noise() {
    noise_seed = (noise_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return noise_seed / 1073741824.0 - 1.0;
}

// A random number in [lo, hi), for varying one sound from the next
fun rand_range(lo, hi) {
    return lo + (hi - lo) * (noise() * 0.5 + 0.5);
}

// What to multiply a level by every sample for it to fall to about a third
// (1/e) in this many seconds
fun decay_rate(seconds) {
    return (-1.0 / (seconds * SAMPLE_RATE.to_f())).exp();
}

// The coefficient of a one-pole low pass with this cutoff:
//   y = y + (x - y) * k
fun lp_coef(hz) {
    return 1.0 - (-TAU * hz / SAMPLE_RATE.to_f()).exp();
}

// The coefficient of a state variable filter with this center or cutoff:
//   low = low + f * band
//   band = band + f * (x - low - damp * band)
// where low is the low pass and band the band pass. A damping of 2 does not
// ring at all, and the lower it is the more it rings.
fun svf_coef(hz) {
    return 2.0 * (PI * hz / SAMPLE_RATE.to_f()).sin();
}

// Squash peaks smoothly rather than clipping them
fun soft_clip(v) {
    return v / (1.0 + v.abs());
}

fun note_freq(note) {
    return 440.0 * (2.0).pow((note - 69) / 12.0);
}

// --- Voices ---

// A sound that is playing. Subclasses override render().
class Voice {
    init(self, gain) {
        self.gain = gain;
        self.t = 0.0;
    }

    // Add the next n samples into mix, a ByteArray of f32. Returns false
    // once the sound has finished, after which it is dropped.
    render(self, mix, n) {
        return false;
    }
}

// The shotgun's report: Space Fighter's cannon made bigger. A burst of noise
// heard through a broad band in the middle that is the bark, a low band that
// is the boom and a trace of the top that is the crack, driven hard into the
// limit. The boom has its own, slower decay, so it rolls on after the bark.
let SHOT_LEN = 1.1;
let SHOT_FADE = 0.5;

class ShotgunVoice extends Voice {
    init(self, gain) {
        Voice.init(self, gain);
        self.env = 1.0;
        self.boom = 1.0;
        self.crack = 1.0;
        self.keep = decay_rate(0.11);
        self.boom_keep = decay_rate(0.15);
        self.crack_keep = decay_rate(0.006);

        self.bark_f = svf_coef(rand_range(380.0, 560.0));
        self.bark_lo = 0.0; self.bark_bp = 0.0;
        self.thump_k = lp_coef(rand_range(110.0, 150.0));
        self.thump1 = 0.0; self.thump2 = 0.0;
        self.top_hp = 0.0;
    }

    render(self, mix, n) {
        for (let var i = 0; i < n; ++i) {
            let white = noise();
            self.t = self.t + DT;

            self.env = self.env * self.keep;
            let burst = white * self.env;
            self.bark_lo = self.bark_lo + self.bark_f * self.bark_bp;
            self.bark_bp = self.bark_bp + self.bark_f * (burst - self.bark_lo - 1.0 * self.bark_bp);

            self.boom = self.boom * self.boom_keep;
            self.thump1 = self.thump1 + (white * self.boom - self.thump1) * self.thump_k;
            self.thump2 = self.thump2 + (self.thump1 - self.thump2) * self.thump_k;

            self.crack = self.crack * self.crack_keep;
            let top = white * self.crack;
            self.top_hp = self.top_hp + (top - self.top_hp) * 0.35;

            // The drive keeps the boom's tail audible for a while, so it is
            // faded out rather than stopped dead
            let fade = ((SHOT_LEN - self.t) / SHOT_FADE).clip(0.0, 1.0);
            let shot = soft_clip((self.bark_bp + self.thump2 * 7.0 + (top - self.top_hp) * 0.3) * 3.0);
            mix.set_f32(i, mix.get_f32(i) + shot * fade * 2.6 * self.gain);
        }
        return self.t < SHOT_LEN;
    }
}

// A footstep: a soft, muffled pad of noise. It swells in over a few
// milliseconds rather than starting at full level, since a sharp start is
// what makes a step sound like a click. Each one is a little different.
class StepVoice extends Voice {
    init(self, gain) {
        Voice.init(self, gain);
        self.attack = rand_range(0.005, 0.008);
        self.keep = decay_rate(0.03);
        self.level = 1.0;
        self.lp_k = lp_coef(rand_range(250.0, 380.0));
        self.lp1 = 0.0; self.lp2 = 0.0;
        self.weight = 0.25;
        self.len = 0.15;
    }

    render(self, mix, n) {
        for (let var i = 0; i < n; ++i) {
            self.t = self.t + DT;

            // Rise linearly, then fall away
            let var env = 1.0;
            if (self.t < self.attack) {
                env = self.t / self.attack;
            } else {
                self.level = self.level * self.keep;
                env = self.level;
            }

            self.lp1 = self.lp1 + (noise() * env - self.lp1) * self.lp_k;
            self.lp2 = self.lp2 + (self.lp1 - self.lp2) * self.lp_k;
            mix.set_f32(i, mix.get_f32(i) + self.lp2 * self.weight * self.gain);
        }
        return self.t < self.len;
    }
}

// Landing from a jump or a fall: a footstep, heavier, lower and longer
class LandVoice extends StepVoice {
    init(self, gain) {
        StepVoice.init(self, gain);
        self.attack = rand_range(0.008, 0.012);
        self.keep = decay_rate(0.05);
        self.lp_k = lp_coef(rand_range(160.0, 220.0));
        self.weight = 0.6;
        self.len = 0.3;
    }
}

// Picking something up: two short clacks, like a gun's action being worked.
// Each is a burst of noise through a band around 1.1 kHz.
let PICKUP_LEVEL = 0.675;

class PickupVoice extends Voice {
    init(self, gain) {
        Voice.init(self, gain);
        self.clack = 0.6;
        self.clack_keep = decay_rate(0.012);
        self.clack_f = svf_coef(1100.0);
        self.clack_lo = 0.0; self.clack_bp = 0.0;
        self.second = false;
    }

    render(self, mix, n) {
        for (let var i = 0; i < n; ++i) {
            self.t = self.t + DT;
            if (!self.second && self.t >= 0.12) {
                self.second = true;
                self.clack = 0.8;
            }
            self.clack = self.clack * self.clack_keep;
            let c = noise() * self.clack;
            self.clack_lo = self.clack_lo + self.clack_f * self.clack_bp;
            self.clack_bp = self.clack_bp + self.clack_f * (c - self.clack_lo - 0.8 * self.clack_bp);
            mix.set_f32(i, mix.get_f32(i) + self.clack_bp * PICKUP_LEVEL * self.gain);
        }
        return self.t < 0.25;
    }
}

// A heavy door sliding open or shut, over `duration` seconds: a clunk as it
// lets go, the rumble of it running in its track with the hum of the motor
// driving it, then a heavier clunk as it hits the end.
class DoorVoice extends Voice {
    init(self, gain, duration) {
        Voice.init(self, gain);
        self.duration = duration;

        self.clunk = 1.0;
        self.clunk_keep = decay_rate(0.05);
        self.clunk_k = lp_coef(110.0);
        self.cl1 = 0.0; self.cl2 = 0.0;
        self.stopped = false;

        self.rumble_k = lp_coef(260.0);
        self.ru1 = 0.0; self.ru2 = 0.0;
        self.grind_f = svf_coef(900.0);
        self.gr_lo = 0.0; self.gr_bp = 0.0;
        self.wobble = 0.0;

        self.motor = 0.0;
        self.motor_k = lp_coef(400.0);
        self.mo_lp = 0.0;
    }

    render(self, mix, n) {
        let d = self.duration;
        for (let var i = 0; i < n; ++i) {
            let white = noise();
            self.t = self.t + DT;
            let t = self.t;

            // Ramps in and out over a tenth of a second at either end of the run
            let run = (t / 0.1).min((d - t) / 0.1).clip(0.0, 1.0);

            // Rumble and grind, which wander a little in level
            self.wobble = self.wobble + (white - self.wobble) * 0.0008;
            self.ru1 = self.ru1 + (white - self.ru1) * self.rumble_k;
            self.ru2 = self.ru2 + (self.ru1 - self.ru2) * self.rumble_k;
            self.gr_lo = self.gr_lo + self.grind_f * self.gr_bp;
            self.gr_bp = self.gr_bp + self.grind_f * (white - self.gr_lo - 0.5 * self.gr_bp);
            let track = (self.ru2 * 5.0 + self.gr_bp * 0.05) * (0.8 + 6.0 * self.wobble);

            // The motor: a low saw, its pitch rising as it takes the load
            self.motor = self.motor + (55.0 + 8.0 * run) * DT;
            if (self.motor >= 1.0) self.motor = self.motor - 1.0;
            self.mo_lp = self.mo_lp + ((self.motor * 2.0 - 1.0) - self.mo_lp) * self.motor_k;

            // The clunk at the end restarts the one from the start, heavier
            if (!self.stopped && t >= d) {
                self.stopped = true;
                self.clunk = 1.6;
            }
            self.clunk = self.clunk * self.clunk_keep;
            self.cl1 = self.cl1 + (white * self.clunk - self.cl1) * self.clunk_k;
            self.cl2 = self.cl2 + (self.cl1 - self.cl2) * self.clunk_k;

            let v = (track * 0.5 + self.mo_lp * 0.12) * run + self.cl2 * 8.0;
            mix.set_f32(i, mix.get_f32(i) + v * self.gain);
        }
        return self.t < d + 0.4;
    }
}

// A heavy armored foot coming down: a deep thud, and the clank of metal
// plates ringing at two pitches that are not in tune with each other. Each
// one is a little different.
class StompVoice extends Voice {
    init(self, gain) {
        Voice.init(self, gain);
        self.attack = 0.004;
        self.level = 1.0;
        self.keep = decay_rate(0.05);
        self.lp_k = lp_coef(rand_range(70.0, 95.0));
        self.lp1 = 0.0; self.lp2 = 0.0;

        self.ring = 1.0;
        self.ring_keep = decay_rate(0.002);
        self.f1 = svf_coef(rand_range(480.0, 560.0));
        self.lo1 = 0.0; self.bp1 = 0.0;
        self.f2 = svf_coef(rand_range(1250.0, 1450.0));
        self.lo2 = 0.0; self.bp2 = 0.0;
    }

    render(self, mix, n) {
        for (let var i = 0; i < n; ++i) {
            let white = noise();
            self.t = self.t + DT;

            let var env = 1.0;
            if (self.t < self.attack) {
                env = self.t / self.attack;
            } else {
                self.level = self.level * self.keep;
                env = self.level;
            }
            self.lp1 = self.lp1 + (white * env - self.lp1) * self.lp_k;
            self.lp2 = self.lp2 + (self.lp1 - self.lp2) * self.lp_k;

            // A click that sets the two plates ringing, lightly damped
            self.ring = self.ring * self.ring_keep;
            let x = white * self.ring;
            self.lo1 = self.lo1 + self.f1 * self.bp1;
            self.bp1 = self.bp1 + self.f1 * (x - self.lo1 - 0.03 * self.bp1);
            self.lo2 = self.lo2 + self.f2 * self.bp2;
            self.bp2 = self.bp2 + self.f2 * (x - self.lo2 - 0.05 * self.bp2);

            let v = self.lp2 * 4.0 + (self.bp1 * 0.05 + self.bp2 * 0.03);
            mix.set_f32(i, mix.get_f32(i) + v * self.gain);
        }
        return self.t < 0.3;
    }
}

// An arm swung hard through the air: noise through a band that sweeps up as
// the swing picks up speed and back down as it passes, swelling and fading
// with it. The loudest moment is `peak` seconds in, which is when the blow
// lands.
class SwipeVoice extends Voice {
    init(self, gain, peak) {
        Voice.init(self, gain);
        self.peak = peak.max(0.05);
        self.len = self.peak + 0.15;
        self.lo = 0.0; self.bp = 0.0;
        self.pitch = rand_range(0.85, 1.15);
    }

    render(self, mix, n) {
        for (let var i = 0; i < n; ++i) {
            self.t = self.t + DT;

            // 0 at the start and end, 1 at the peak, and smooth in between
            let var s = self.t / self.peak;
            if (self.t > self.peak) s = 1.0 - (self.t - self.peak) / (self.len - self.peak);
            s = s.clip(0.0, 1.0);
            let env = s * s * (3.0 - 2.0 * s);

            let f = svf_coef((350.0 + 1500.0 * env) * self.pitch);
            self.lo = self.lo + f * self.bp;
            self.bp = self.bp + f * (noise() - self.lo - 1.2 * self.bp);
            mix.set_f32(i, mix.get_f32(i) + self.bp * env * env * 0.5 * self.gain);
        }
        return self.t < self.len;
    }
}

// A claw or a fist landing on the player: a heavy body thump and a short
// tearing rasp on top of it
class ClawHitVoice extends Voice {
    init(self, gain) {
        Voice.init(self, gain);
        self.env = 1.0;
        self.keep = decay_rate(0.06);
        self.lp_k = lp_coef(rand_range(130.0, 170.0));
        self.lp1 = 0.0; self.lp2 = 0.0;
        self.rasp = 1.0;
        self.rasp_keep = decay_rate(0.035);
        self.rf = svf_coef(rand_range(1800.0, 2400.0));
        self.rlo = 0.0; self.rbp = 0.0;
    }

    render(self, mix, n) {
        for (let var i = 0; i < n; ++i) {
            let white = noise();
            self.t = self.t + DT;

            self.env = self.env * self.keep;
            self.lp1 = self.lp1 + (white * self.env - self.lp1) * self.lp_k;
            self.lp2 = self.lp2 + (self.lp1 - self.lp2) * self.lp_k;

            self.rasp = self.rasp * self.rasp_keep;
            self.rlo = self.rlo + self.rf * self.rbp;
            self.rbp = self.rbp + self.rf * (white * self.rasp - self.rlo - 0.8 * self.rbp);

            let v = soft_clip(self.lp2 * 9.0) * 0.8 + self.rbp * 0.25;
            mix.set_f32(i, mix.get_f32(i) + v * self.gain);
        }
        return self.t < 0.35;
    }
}

// A body bursting: a deep thump, and a wet splatter over it, which is noise
// in a middle band broken up into many little bursts that thin out as the
// pieces land
class GibVoice extends Voice {
    init(self, gain) {
        Voice.init(self, gain);
        self.env = 1.0;
        self.keep = decay_rate(0.09);
        self.lp_k = lp_coef(110.0);
        self.lp1 = 0.0; self.lp2 = 0.0;

        self.wet = 1.0;
        self.wet_keep = decay_rate(0.25);
        self.wf = svf_coef(rand_range(700.0, 1000.0));
        self.wlo = 0.0; self.wbp = 0.0;
        self.burst = 0.0;
        self.burst_keep = decay_rate(0.006);
    }

    render(self, mix, n) {
        for (let var i = 0; i < n; ++i) {
            let white = noise();
            self.t = self.t + DT;

            self.env = self.env * self.keep;
            self.lp1 = self.lp1 + (white * self.env - self.lp1) * self.lp_k;
            self.lp2 = self.lp2 + (self.lp1 - self.lp2) * self.lp_k;

            // Little bursts, at random, fewer as the splatter dies down
            self.wet = self.wet * self.wet_keep;
            if (noise() * 0.5 + 0.5 < 0.004 * self.wet) self.burst = rand_range(0.5, 1.0);
            self.burst = self.burst * self.burst_keep;
            self.wlo = self.wlo + self.wf * self.wbp;
            self.wbp = self.wbp + self.wf * (white * (self.burst + 0.15 * self.wet) - self.wlo - 0.7 * self.wbp);

            let v = soft_clip(self.lp2 * 12.0) * 0.8 + self.wbp * 0.5;
            mix.set_f32(i, mix.get_f32(i) + v * self.gain);
        }
        return self.t < 1.0;
    }
}

// A recorded sound, played once through at a pitch a little off its own each
// time, so the same few don't sound like a loop. The clip is mono, at any
// rate, and is stepped through at its rate times the pitch.
class SampleVoice extends Voice {
    init(self, gain, clip, pitch) {
        Voice.init(self, gain);
        self.data = clip.samples;
        self.len = clip.num_frames();
        self.step = clip.sample_rate.to_f() / SAMPLE_RATE.to_f() * pitch;
        self.pos = 0.0;
    }

    render(self, mix, n) {
        let data = self.data;
        let last = self.len - 1;
        for (let var i = 0; i < n; ++i) {
            let k = self.pos.floor();
            if (k >= last) return false;
            let f = self.pos - k.to_f();
            let a = data.get_f32(k);
            let v = a + (data.get_f32(k + 1) - a) * f;
            mix.set_f32(i, mix.get_f32(i) + v * self.gain);
            self.pos = self.pos + self.step;
        }
        return true;
    }
}

// Splats of meat, cut out of a recording (CC0, by Independent.nu: "2 wooden
// squish splatter sequences" on OpenGameArt), one picked at random each time
let SOUND_DIR = "examples/tremor/sounds/";
let NUM_SPLATS = 5;
let splat_clips = [];
for (let var i = 1; i <= NUM_SPLATS; ++i) {
    let clip = load_wav(SOUND_DIR + "splat_" + i.to_s() + ".wav");
    if (clip != nil) splat_clips.push(clip);
}

// A low groan of pain: a buzzing saw with a growl an octave under it, heard
// through two vowel-like bands, that barks up in pitch as it starts and then
// sags. Its pitch wanders and its level flutters, like a rough throat. With
// `dying` set it is longer, lower and falls further. Each one is different.
// It starts a moment late, as a reaction, which also keeps the shotgun's
// blast from drowning it out.
class GroanVoice extends Voice {
    init(self, gain, dying) {
        Voice.init(self, gain);
        self.t = 0.0 - rand_range(0.12, 0.2);
        self.len = rand_range(0.3, 0.45);
        self.base = rand_range(62.0, 84.0);
        self.sag = 0.22;
        if (dying) {
            self.len = rand_range(1.0, 1.3);
            self.base = self.base * 0.85;
            self.sag = 0.4;
        }

        self.phase = 0.0;
        self.sub = 0.0;
        self.drift = 0.0;
        self.flutter_hz = rand_range(18.0, 28.0);
        self.growl = rand_range(0.3, 0.6);

        self.f1 = svf_coef(rand_range(380.0, 520.0));
        self.lo1 = 0.0; self.bp1 = 0.0;
        self.f2 = svf_coef(rand_range(850.0, 1150.0));
        self.lo2 = 0.0; self.bp2 = 0.0;
        self.f3 = svf_coef(rand_range(2200.0, 2700.0));
        self.lo3 = 0.0; self.bp3 = 0.0;
        self.breath_k = lp_coef(1200.0);
        self.breath = 0.0;
    }

    render(self, mix, n) {
        for (let var i = 0; i < n; ++i) {
            let white = noise();
            self.t = self.t + DT;
            let t = self.t;
            if (t < 0.0) continue;
            let s = (t / self.len).min(1.0);

            // In quickly, then dying away over the last part of it
            let env = (t / 0.04).min(1.0) * ((self.len - t) / (self.len * 0.6)).clip(0.0, 1.0);

            // The bark up at the start, the sag after, and the wander
            self.drift = self.drift + (white - self.drift) * 0.002;
            let f = self.base * (1.0 + 0.3 * (-t / 0.08).exp()) * (1.0 - self.sag * s) * (1.0 + 1.5 * self.drift);
            self.phase = self.phase + f * DT;
            if (self.phase >= 1.0) self.phase = self.phase - 1.0;
            self.sub = self.sub + f * 0.5 * DT;
            if (self.sub >= 1.0) self.sub = self.sub - 1.0;

            let saw = self.phase * 2.0 - 1.0;
            let var sq = 1.0;
            if (self.sub >= 0.5) sq = -1.0;
            self.breath = self.breath + (white - self.breath) * self.breath_k;
            let src = saw + sq * self.growl + self.breath * 0.6;

            self.lo1 = self.lo1 + self.f1 * self.bp1;
            self.bp1 = self.bp1 + self.f1 * (src - self.lo1 - 0.35 * self.bp1);
            self.lo2 = self.lo2 + self.f2 * self.bp2;
            self.bp2 = self.bp2 + self.f2 * (src - self.lo2 - 0.4 * self.bp2);
            self.lo3 = self.lo3 + self.f3 * self.bp3;
            self.bp3 = self.bp3 + self.f3 * (src - self.lo3 - 0.5 * self.bp3);

            let flutter = 1.0 - 0.35 * (0.5 + 0.5 * (TAU * self.flutter_hz * t).sin());
            let v = soft_clip((self.lo1 * 0.25 + self.bp1 + self.bp2 * 0.6 + self.bp3 * 0.35) * 2.5) * env * flutter;
            mix.set_f32(i, mix.get_f32(i) + v * self.gain);
        }
        return self.t < self.len;
    }
}

// A voice heard through walls: it renders into a buffer of its own, which goes
// through two one-pole low passes on its way into the mix, so that what is
// left of it is dull as well as quiet
class MuffledVoice extends Voice {
    init(self, inner, hz) {
        Voice.init(self, 1.0);
        self.inner = inner;
        self.k = lp_coef(hz);
        self.lp1 = 0.0;
        self.lp2 = 0.0;
        self.buf = ByteArray.with_size(0);
    }

    render(self, mix, n) {
        let var buf = self.buf;
        if (buf.len != n * 4) {
            buf = ByteArray.with_size(n * 4);
            self.buf = buf;
        }
        buf.fill_u32(0, n, 0);
        let more = self.inner.render(buf, n);

        let k = self.k;
        let var lp1 = self.lp1;
        let var lp2 = self.lp2;
        for (let var i = 0; i < n; ++i) {
            lp1 = lp1 + (buf.get_f32(i) - lp1) * k;
            lp2 = lp2 + (lp1 - lp2) * k;
            mix.set_f32(i, mix.get_f32(i) + lp2);
        }
        self.lp1 = lp1;
        self.lp2 = lp2;
        return more;
    }
}

// The voice for a sound, by name. `param` means what each sound says it does,
// such as a door's duration.
fun make_voice(kind, gain, param) {
    if (kind == "shotgun") return ShotgunVoice(gain);
    if (kind == "step") return StepVoice(gain);
    if (kind == "land") return LandVoice(gain);
    if (kind == "pickup") return PickupVoice(gain);
    if (kind == "door") return DoorVoice(gain, param);
    if (kind == "stomp") return StompVoice(gain);
    if (kind == "swipe") return SwipeVoice(gain, param);
    if (kind == "claw_hit") return ClawHitVoice(gain);
    if (kind == "gib") return GibVoice(gain);
    if (kind == "groan") return GroanVoice(gain, param > 0.0);
    if (kind == "squish") {
        if (splat_clips.len == 0) return nil;
        let k = rand_range(0.0, splat_clips.len.to_f()).floor().min(splat_clips.len - 1);
        return SampleVoice(gain, splat_clips[k], rand_range(0.9, 1.1));
    }
    $println("unknown sound: " + kind);
    return nil;
}

// --- The mix ---

let voices = [];

// The reverb: a few echoes feeding back on themselves, each darkened a little
// every time around, which reads as a stone room rather than a canyon. The
// lengths share no factor, so that the echoes don't pile up on one another.
let ECHO_LENS = [1557, 1993, 2371, 2803];
let ECHO_FEEDBACK = 0.4;
let ECHO_DAMP = 0.35;
let REVERB_MIX = 0.05;

let echo_bufs = [];
let echo_pos = [0, 0, 0, 0];
let echo_lp = [0.0, 0.0, 0.0, 0.0];
for (let var k = 0; k < ECHO_LENS.len; ++k) echo_bufs.push(ByteArray.with_size(ECHO_LENS[k] * 4));

// Start a sound, through a low pass at `hz`, or none if 0
fun start_voice(kind, gain, param, hz) {
    if (voices.len >= MAX_VOICES) return;
    let var v = make_voice(kind, gain, param);
    if (v == nil) return;
    if (hz > 0.0) v = MuffledVoice(v, hz);
    voices.push(v);
}

// Fill buf with the next n samples of everything playing
fun mix_into(buf, n) {
    // A float of zero is all zero bits
    buf.fill_u32(0, n, 0);

    for (let var k = voices.len - 1; k >= 0; --k) {
        if (!voices[k].render(buf, n)) voices.remove(k);
    }

    let b0 = echo_bufs[0]; let b1 = echo_bufs[1]; let b2 = echo_bufs[2]; let b3 = echo_bufs[3];
    let var p0 = echo_pos[0]; let var p1 = echo_pos[1]; let var p2 = echo_pos[2]; let var p3 = echo_pos[3];
    let var l0 = echo_lp[0]; let var l1 = echo_lp[1]; let var l2 = echo_lp[2]; let var l3 = echo_lp[3];
    let n0 = ECHO_LENS[0]; let n1 = ECHO_LENS[1]; let n2 = ECHO_LENS[2]; let n3 = ECHO_LENS[3];

    for (let var i = 0; i < n; ++i) {
        let dry = buf.get_f32(i);

        let e0 = b0.get_f32(p0); let e1 = b1.get_f32(p1);
        let e2 = b2.get_f32(p2); let e3 = b3.get_f32(p3);
        l0 = l0 + (e0 - l0) * (1.0 - ECHO_DAMP);
        l1 = l1 + (e1 - l1) * (1.0 - ECHO_DAMP);
        l2 = l2 + (e2 - l2) * (1.0 - ECHO_DAMP);
        l3 = l3 + (e3 - l3) * (1.0 - ECHO_DAMP);
        b0.set_f32(p0, dry + l0 * ECHO_FEEDBACK);
        b1.set_f32(p1, dry + l1 * ECHO_FEEDBACK);
        b2.set_f32(p2, dry + l2 * ECHO_FEEDBACK);
        b3.set_f32(p3, dry + l3 * ECHO_FEEDBACK);
        p0 = p0 + 1; if (p0 >= n0) p0 = 0;
        p1 = p1 + 1; if (p1 >= n1) p1 = 0;
        p2 = p2 + 1; if (p2 >= n2) p2 = 0;
        p3 = p3 + 1; if (p3 >= n3) p3 = 0;

        let wet = (l0 + l1 + l2 + l3) * 0.25;
        buf.set_f32(i, soft_clip((dry + wet * REVERB_MIX) * MASTER_GAIN));
    }

    echo_pos[0] = p0; echo_pos[1] = p1; echo_pos[2] = p2; echo_pos[3] = p3;
    echo_lp[0] = l0; echo_lp[1] = l1; echo_lp[2] = l2; echo_lp[3] = l3;
}

// --- The audio actor ---

// A sound to start, sent to the audio actor, and the cutoff of the low pass
// it is heard through, 0 for none
class SoundPlay {
    init(self, kind, gain, param, hz) {
        self.kind = kind;
        self.gain = gain;
        self.param = param;
        self.hz = hz;
    }
}

class SoundStop {
    init(self) {}
}

fun audio_actor() {
    let dev = $audio_open_output(SAMPLE_RATE, 1);
    if (dev == nil) $println("no audio device, running silent");

    // Reused, to give the collector nothing to do
    let var buf = ByteArray.with_size(0);

    // Without a device this still runs, to take the game's messages
    loop {
        let msg = $actor_recv();

        if (msg instanceof SoundPlay) {
            start_voice(msg.kind, msg.gain, msg.param, msg.hz);
            continue;
        }
        if (msg instanceof SoundStop) break;
        if (dev == nil || !(msg instanceof AudioNeeded)) continue;

        let n = msg.num_samples;
        if (buf.len != n * 4) buf = ByteArray.with_size(n * 4);
        mix_into(buf, n);
        $audio_write_samples(dev, buf);
    }

    return 0;
}

// --- What the game calls ---

let var sound_actor = nil;

// Start the audio actor. Call this early, before the world is loaded.
fun start_sound() {
    sound_actor = $actor_spawn(audio_actor);
}

fun stop_sound() {
    if (sound_actor == nil) return;
    $actor_send(sound_actor, SoundStop());
    $actor_join(sound_actor);
    sound_actor = nil;
}

// Play a sound at a level from 0 to 1. Does nothing if sound isn't started.
fun play_sound(kind, gain, param) {
    if (sound_actor == nil) return;
    $actor_send(sound_actor, SoundPlay(kind, gain, param, 0.0));
}

// How far away a sound is at half its level
let SOUND_REF_DIST = 6.0;

// Play a sound made somewhere in the world, quieter the further it is from
// the listener, and quieter and duller for each of the `walls` brushes in
// between. There is one channel, so it can't tell which side it came from.
fun play_sound_at(kind, x, y, z, lx, ly, lz, gain, param, walls) {
    let dx = x - lx; let dy = y - ly; let dz = z - lz;
    let d = (dx * dx + dy * dy + dz * dz).sqrt();
    let through = muffle_through(d).pow(walls.to_f());
    let g = gain * through / (1.0 + d / SOUND_REF_DIST);
    if (g < 0.02) return;
    if (sound_actor == nil) return;
    $actor_send(sound_actor, SoundPlay(kind, g, param, muffle_hz(walls, through)));
}

// What gets through each brush between a sound and a listener this far away
fun muffle_through(d) {
    let t = ((d - MUFFLE_NEAR_DIST) / (MUFFLE_FAR_DIST - MUFFLE_NEAR_DIST)).clip(0.0, 1.0);
    let s = t * t * (3.0 - 2.0 * t);
    return MUFFLE_NEAR + (MUFFLE_FAR - MUFFLE_NEAR) * s;
}

// The low pass cutoff for a sound through `walls` brushes that let `through`
// of it by, or 0 for none. It is as dull as it would be through the number of
// far brushes that take the same off it.
fun muffle_hz(walls, through) {
    if (walls == 0) return 0.0;
    let far_walls = through.ln() / MUFFLE_FAR.ln();
    return (MUFFLE_HZ * 0.5.pow(far_walls - 1.0)).clip(MUFFLE_HZ_MIN, MUFFLE_HZ_MAX);
}
