// Settings, from the command line.
//
// These are parsed here, at import time, rather than in main.psh, because the
// renderer sizes its buffers and projection from them as immutable globals.
// An immutable global that is already set when a function is compiled is
// folded into it as a constant, which matters in the span loop.

from args import ArgParser;

let args = ArgParser("Walk around a texture-mapped level, Quake style")
    .opt_int("width", 1280, "Frame width in pixels")
    .opt_int("height", 720, "Frame height in pixels")
    .opt_int("actors", 8, "Number of actors rendering bands of the frame")
    .flag("bench", "Render a set tour of the level without a window and report the time per frame")
    .opt_int("frames", 120, "Number of frames to render with --bench")
    .opt_str("shots", nil, "Write each viewpoint of the tour to this directory with --bench")
    .pos_str("map", "examples/tremor/maps/level1.map", "Level file to load")
    .parse_args();

let FRAME_WIDTH = args.width;
let FRAME_HEIGHT = args.height;

let MAP_PATH = args.map;
let NUM_RENDER_ACTORS = args.actors;
let BENCH = args.bench;
let BENCH_FRAMES = args.frames;
let SHOT_DIR = args.shots;

if (FRAME_WIDTH < 1 || FRAME_HEIGHT < 1) {
    $println("width and height must be positive integers");
    $exit(1);
}
if (args.bench && args.frames < 1) {
    $println("expected at least one frame");
    $exit(1);
}
if (NUM_RENDER_ACTORS < 1 || NUM_RENDER_ACTORS > FRAME_HEIGHT) {
    $println("worker count must be between 1 and " + FRAME_HEIGHT.to_s());
    $exit(1);
}
