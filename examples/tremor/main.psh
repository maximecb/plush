// Walk around a texture-mapped level, Quake style
//
// The program is split by purpose:
//
//   config.psh    settings, from the command line
//   world.psh     the level: map parsing, brushes, faces, textures, BSP tree
//   lighting.psh  the light bake
//   render.psh    the s-buffer renderer and its pool of render actors
//   physics.psh   collision and moving bodies under gravity
//   entities.psh  things that move about in the world, the player included
//   models.psh    3D models that entities are drawn with
//   sound.psh     synthesized sound effects
//   hud.psh       the health and ammunition display
//
// This file wires them together: it loads and prepares the level, then either
// runs the benchmark tour or opens a window and runs the game loop.
//
// Usage: plush examples/tremor/main.psh [map file] [--width 1280] [--height 720] [--actors 8]
//        plush examples/tremor/main.psh [map file] --bench [--frames 120] [--shots directory]
//
//   W A S D     move
//   arrows      turn and look
//   space       jump, or rise while noclipping
//   c           sink, while noclipping
//   n           toggle noclip
//   left mouse  fire, also alt (option on a Mac)
//   escape / q  quit
//
// With --bench, it renders a number of frames of a set tour of the level
// without opening a window, and reports the time per frame and how many pixels
// were written. Given --shots as well, it writes each viewpoint of the tour to
// that directory as a TGA screenshot.

from image import save_tga;
from pixelfont import PixelFont;
from ./config import FRAME_WIDTH, FRAME_HEIGHT, MAP_PATH, NUM_RENDER_ACTORS, BENCH, BENCH_FRAMES, SHOT_DIR;
from ./world import load_map, build_bsp;
from ./lighting import light_world, light_level_at;
from ./render import frame_image, frame_buffer, frame_stats, pending_ui_events, BAND_HEIGHT,
    set_scene, set_view, set_draw_list, set_muzzle_flash, set_particles, set_screen_tint,
    render_frame_parallel, start_render_actors, stop_render_actors;
from ./entities import Player, spawn_entities, touch_entities, load_weapons, load_gibs, shoot, update_blood, update_gibs, sound_events,
    EYE_HEIGHT, TURN_SPEED, MOUSE_SENS, PITCH_LIMIT;
from ./models import models;
from ./sound import start_sound, stop_sound, play_sound, play_sound_at;
from ./hud import draw_hud;

// The audio actor starts with a copy of this actor's heap, so it is spawned
// before the world is loaded into it. The benchmark runs silent.
if (!BENCH) start_sound();

// --- Setup ---

let world = load_map(MAP_PATH);

let light_start_ms = $time_current_ms();
let lit_faces = light_world(world);
let light_ms = $time_current_ms() - light_start_ms;

let bsp = build_bsp(lit_faces);
set_scene(bsp.root);
let main_mem_bytes = $gc_mem_size();

let var tex_bytes = 0;
for (let var i = 0; i < world.textures.len; ++i) {
    let t = world.textures[i];
    tex_bytes = tex_bytes + t.width * t.height * 4;
}

let num_lit_faces = lit_faces.len;
$println(world.textures.len.to_s() + " textures, " + world.brushes.len.to_s() + " brushes, "
    + world.faces.len.to_s() + " faces, " + num_lit_faces.to_s() + " lit pieces, "
    + world.lights.len.to_s() + " lights");
$println("bsp: " + bsp.nodes.to_s() + " nodes, " + bsp.splits.to_s() + " splits, "
    + (num_lit_faces + bsp.splits).to_s() + " pieces drawn from");
$println("lighting: " + light_ms.to_s() + " ms to cut and bake");
$println("texture memory: " + (tex_bytes.to_f() / 1048576.0).format_decimals(1) + " MiB, shaded per pixel");
$println("main actor GC/message heaps: "
    + (main_mem_bytes.to_f() / 1048576.0).format_decimals(1) + " MiB");

let player = Player(world.spawn_x, world.spawn_y - EYE_HEIGHT, world.spawn_z, world.spawn_yaw);

// The entities load their models as they are made, which has to happen before
// the render actors are spawned with their copy of every model
let models_start_ms = $time_current_ms();
let entities = spawn_entities(world, player);
load_weapons();
load_gibs();
if (entities.len > 0) {
    $println("entities: " + entities.len.to_s() + ", with " + models.len.to_s() + " models loaded in "
        + ($time_current_ms() - models_start_ms).to_s() + " ms");
}

// The light level on an entity, taken `up` above its base, and taken again
// only once the entity has moved a little
fun entity_light(e, up) {
    if (e.fixed_light) return e.light;
    let dx = e.x - e.lit_x; let dy = e.y - e.lit_y; let dz = e.z - e.lit_z;
    if (!e.lit || dx * dx + dy * dy + dz * dz > 0.0625) {
        e.light = light_level_at(e.x, e.y + up, e.z);
        e.lit_x = e.x; e.lit_y = e.y; e.lit_z = e.z;
        e.lit = true;
    }
    return e.light;
}

// How loud each of the player's own sounds is
fun player_sound_gain(kind) {
    if (kind == "step") return 0.7;
    if (kind == "land") return 0.9;
    return 0.8;
}

// Play what the player and everything else did this frame that makes a sound
fun play_sounds() {
    let events = player.events;
    for (let var i = 0; i < events.len; ++i) play_sound(events[i], player_sound_gain(events[i]), 0.0);
    events.resize(0, nil);

    for (let var i = 0; i < sound_events.len; ++i) {
        let s = sound_events[i];
        play_sound_at(s[0], s[1], s[2], s[3], player.x, player.eye_y(), player.z, s[5], s[4]);
    }
    sound_events.resize(0, nil);
}

// The red the view is pulled towards when the player is hurt, and how far at
// the moment it happens, in 256ths
let HURT_TINT = 0xFF_C0_00_00;
let HURT_TINT_MAX = 110.0;

// Move every entity on by dt, let the player pick up what they walk into, and
// hand the renderer what it has to draw
fun update_entities(dt) {
    touch_entities(world, player, entities);

    let list = [];
    for (let var i = 0; i < entities.len; ++i) {
        let e = entities[i];
        e.update(world, dt);
        if (e.model == nil) continue;

        let level = entity_light(e, (e.model.max_y - e.model.min_y) * e.model_scale * 0.5);
        list.push([e.model.id, e.anim, e.anim_time, e.x, e.y, e.z, e.yaw, e.model_scale, level, false, e.pitch]);
    }

    update_gibs(dt, list);
    set_particles(update_blood(dt, player.x, player.eye_y(), player.z));

    // The view goes red for a moment when the player is hurt
    set_screen_tint(HURT_TINT, (player.hurt_flash() * HURT_TINT_MAX).floor());

    // The weapon in hand, lit by where the player stands, and its flash
    let h = player.held;
    if (h != nil) {
        let held = player.held_entry(entity_light(player, EYE_HEIGHT));
        list.push(held);
        set_muzzle_flash(held, h.muzzle_x, h.muzzle_y, h.muzzle_z, player.flash());
    } else {
        set_muzzle_flash(nil, 0.0, 0.0, 0.0, 0.0);
    }

    set_draw_list(list);
}

// A set tour of the level: x, y, z, yaw, pitch. Used by the headless mode
// below, which renders the tour without opening a window, times it, and can
// write each viewpoint out as a screenshot.
let TOUR = [
    [  0.0, 1.6, -15.0,  0.0,  0.0],
    [  0.0, 1.6,  -4.5,  0.0,  0.05],
    [  0.0, 1.6,   3.0,  0.0,  0.0],
    [-12.0, 1.6,   8.0, -1.57, 0.0],
    [-21.5, 1.6,   8.0, -1.57, 0.0],
    [ 12.0, 1.6,   8.0,  1.57, 0.0],
    [ 21.5, 1.6,   8.0,  1.57, 0.0],
    [  0.0, 1.6,  16.0,  0.35, -0.05],
    [ 12.0, 7.8,  25.5, -2.1, -0.28],
    [  0.0, 1.6,  29.0,  0.0,  0.0],
    [  0.0, 1.6,  40.5,  0.0,  0.0],
    [  0.0, 1.6,  47.5,  0.0, -0.05],
    [-38.0, 8.0,  29.6, -1.57, 0.1],
    [-60.0, 20.0, 29.6,  1.57, 0.0],
    [ 21.0, 1.6,  80.0,  1.57, 0.1],
    [ 45.5, 20.8, 90.0, -2.4, -0.2],
    [ 52.0, 20.8, 80.0,  1.57, 0.0]
];

let actor_start_ms = $time_current_ms();
start_render_actors(NUM_RENDER_ACTORS);
$println("render workers: " + NUM_RENDER_ACTORS.to_s() + " actors forked in "
    + ($time_current_ms() - actor_start_ms).to_s() + " ms, dynamic "
    + BAND_HEIGHT.to_s() + "-row bands");

if (BENCH) {
    let var total_ms = 0;
    let var worst_ms = 0;
    let var total_pixels = 0;
    let var total_rect_skipped = 0;
    let var total_nodes_skipped = 0;

    for (let var i = 0; i < BENCH_FRAMES; ++i) {
        let view = TOUR[i % TOUR.len];
        set_view(view[0], view[1], view[2], view[3], view[4], i.to_f() * 0.21);
        update_entities(1.0 / 60.0);

        let t0 = $time_current_ms();
        render_frame_parallel(i);
        let ms = $time_current_ms() - t0;
        total_ms = total_ms + ms;
        total_pixels = total_pixels + frame_stats.pixels_drawn;
        total_rect_skipped = total_rect_skipped + frame_stats.faces_skipped;
        total_nodes_skipped = total_nodes_skipped + frame_stats.nodes_skipped;
        if (ms > worst_ms) worst_ms = ms;

        if (SHOT_DIR != nil && i < TOUR.len) {
            draw_hud(frame_image, player);
            let path = SHOT_DIR + "/view" + i.to_s() + ".tga";
            if (!save_tga(path, frame_image)) $println("could not write " + path);
        }
    }

    let avg = total_ms.to_f() / BENCH_FRAMES.to_f();
    let avg_px = total_pixels.to_f() / BENCH_FRAMES.to_f();
    $println(BENCH_FRAMES.to_s() + " frames: " + avg.format_decimals(2) + " ms/frame ("
        + (1000.0 / avg.max(0.001)).format_decimals(1) + " fps), worst " + worst_ms.to_s() + " ms");
    $println("pixels drawn per frame: " + avg_px.floor().to_s() + " of "
        + (FRAME_WIDTH * FRAME_HEIGHT).to_s() + ", overdraw "
        + (avg_px / (FRAME_WIDTH * FRAME_HEIGHT).to_f()).format_decimals(3) + "x");
    $println("rectangle-occluded faces per frame: "
        + (total_rect_skipped.to_f() / BENCH_FRAMES.to_f()).format_decimals(1));
    $println("rectangle-occluded BSP nodes per frame: "
        + (total_nodes_skipped.to_f() / BENCH_FRAMES.to_f()).format_decimals(1));
    stop_render_actors();
    $exit(0);
}

let window = $window_create(FRAME_WIDTH, FRAME_HEIGHT, "Tremor", 0);
let fps_font = PixelFont(2, 0xFFFFFFFF, 0xFF000000);
let FPS_FIELD_WIDTH = 5;
let var fps_text = "FPS: " + "--".lpad(FPS_FIELD_WIDTH, " ");

fun draw_fps_counter() {
    fps_font.draw_text(frame_image, FRAME_WIDTH - fps_font.text_width(fps_text) - 8, 8, fps_text);
}

// Hide the cursor and aim with raw mouse motion. SDL suspends this while the
// window is not focused and resumes it when focus returns.
$window_lock_mouse(window, true);

// --- Input state ---

let var key_fwd = false;
let var key_back = false;
let var key_left = false;
let var key_right = false;
let var key_turn_l = false;
let var key_turn_r = false;
let var key_look_u = false;
let var key_look_d = false;
let var key_up = false;
let var key_down = false;

// The right mouse button jumps, tracked apart from SPACE so that releasing
// one does not cancel the other
let var mouse_up = false;

// Fire, held down to keep firing as fast as the weapon allows. The left mouse
// button and ALT are tracked apart for the same reason.
let var key_fire = false;
let var mouse_fire = false;

fun set_key(key, down) {
    if (key == 'W') key_fwd = down;
    else if (key == 'S') key_back = down;
    else if (key == 'A') key_left = down;
    else if (key == 'D') key_right = down;
    else if (key == 'LEFT') key_turn_l = down;
    else if (key == 'RIGHT') key_turn_r = down;
    else if (key == 'UP') key_look_u = down;
    else if (key == 'DOWN') key_look_d = down;
    else if (key == 'SPACE') key_up = down;
    else if (key == 'C') key_down = down;
    else if (key == 'ALT') key_fire = down;
}

// --- Main loop ---

let start_ms = $time_current_ms();
let var last_ms = start_ms;
let var frame_count = 0;
let var render_ms_total = 0;
let var last_report_ms = start_ms;
let var render_frame_id = 0;

loop {
    let now_ms = $time_current_ms();
    let var dt = (now_ms - last_ms).to_f() * 0.001;
    last_ms = now_ms;
    if (dt > 0.1) dt = 0.1;

    let time_s = (now_ms - start_ms).to_f() * 0.001;

    // Events first, so that turning responds in the frame the key arrives
    let var quit = false;
    loop {
        let var msg = nil;
        // These were queued in arrival order while render workers were
        // running, so consume the oldest first. Using pop() here reversed a
        // KEY_DOWN/KEY_UP pair and could leave the key stuck down.
        if (pending_ui_events.len > 0) msg = pending_ui_events.remove(0);
        else msg = $actor_poll();
        if (msg == nil) break;
        if (!(msg instanceof UIEvent)) continue;

        if (msg.kind == 'CLOSE_WINDOW') {
            quit = true; break;
        }

        if (msg.kind == 'KEY_DOWN') {
            if (msg.key == 'ESCAPE' || msg.key == 'Q') {
                quit = true;
                break;
            }
            if (msg.key == 'N') {
                player.noclip = !player.noclip;
                $println('noclip=' + player.noclip.to_s());
            }

            set_key(msg.key, true);
        }
        else if (msg.kind == 'KEY_UP') {
            set_key(msg.key, false);
        }
        else if (msg.kind == 'MOUSE_MOVE') {
            player.yaw = player.yaw + msg.dx * MOUSE_SENS;
            player.pitch = player.pitch - msg.dy * MOUSE_SENS;
        }
        else if (msg.kind == 'MOUSE_DOWN') {
            if (msg.button == 'RIGHT') mouse_up = true;
            if (msg.button == 'LEFT') mouse_fire = true;
        }
        else if (msg.kind == 'MOUSE_UP') {
            if (msg.button == 'RIGHT') mouse_up = false;
            if (msg.button == 'LEFT') mouse_fire = false;
        }
    }
    if (quit) break;

    // Turning and looking
    if (key_turn_l) player.yaw = player.yaw - TURN_SPEED * dt;
    if (key_turn_r) player.yaw = player.yaw + TURN_SPEED * dt;
    if (key_look_u) player.pitch = player.pitch + TURN_SPEED * dt;
    if (key_look_d) player.pitch = player.pitch - TURN_SPEED * dt;
    player.pitch = player.pitch.clip(0.0 - PITCH_LIMIT, PITCH_LIMIT);

    let var mf = 0.0;
    let var ms = 0.0;
    if (key_fwd) mf = mf + 1.0;
    if (key_back) mf = mf - 1.0;
    if (key_right) ms = ms + 1.0;
    if (key_left) ms = ms - 1.0;

    player.move(world, dt, mf, ms, key_up || mouse_up, key_down);

    // The last shot plays on first, so that a new one starts from its very
    // first frame
    player.update_weapon(dt);
    player.update_effects(dt);
    if ((key_fire || mouse_fire) && player.fire()) {
        play_sound(player.weapon, 1.0, 0.0);
        shoot(player, entities);
    }
    update_entities(dt);
    play_sounds();

    set_view(player.x, player.eye_y(), player.z, player.yaw, player.pitch, time_s * 1.1);

    let render_start = $time_current_ms();
    render_frame_parallel(render_frame_id);
    render_frame_id = render_frame_id + 1;
    render_ms_total = render_ms_total + ($time_current_ms() - render_start);

    frame_count = frame_count + 1;
    let report_ms = $time_current_ms();
    if (report_ms - last_report_ms >= 1000) {
        let render_ms = render_ms_total.to_f() / frame_count.to_f();
        let fps = 1000.0 / render_ms.max(0.001);
        let fps_count = fps.format_decimals(1);
        fps_text = "FPS: " + fps_count.lpad(FPS_FIELD_WIDTH, " ");
        $println("render: " + render_ms.format_decimals(1) + "ms (" + fps_count + " fps)");
        frame_count = 0;
        render_ms_total = 0;
        last_report_ms = report_ms;
    }

    draw_hud(frame_image, player);
    draw_fps_counter();
    $window_draw_frame(window, frame_buffer);
}

stop_render_actors();
stop_sound();

// Give the cursor back before exiting
$window_lock_mouse(window, false);
