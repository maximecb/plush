// Things that move about in the world. An entity is a body that physics.psh
// can move: a position, a size, and how it is falling. The position is at the
// bottom middle of its box, so y is where the feet are for one that walks.
// The player is the first kind.
//
// An entity may have a 3D model, which is drawn standing at its position and
// facing along its yaw, posed by the animation it is playing.

from ./physics import move_body;
from ./models import get_model;

// --- Player ---

let EYE_HEIGHT = 1.6;
let PLAYER_RADIUS = 0.45;
let PLAYER_HEIGHT = 1.7;
let STEP_HEIGHT = 0.7;

let WALK_SPEED = 7.5;
let FLY_SPEED = 15.0;

// A jump clears about 1.5 m, which is twice the height of a step and enough
// to hop onto the low ledges, but nowhere near the parapet
let JUMP_SPEED = 8.25;

let TURN_SPEED = 2.6;
let MOUSE_SENS = 0.0032;

// Look up/down limit. Just shy of fully up/down.
let PITCH_LIMIT = 1.55;

class Entity {
    init(self, x, y, z, yaw) {
        self.x = x;
        self.y = y;
        self.z = z;
        self.yaw = yaw;
        self.pitch = 0.0;

        // The box it collides with, and the tallest step it climbs without
        // jumping
        self.radius = 0.5;
        self.height = 1.0;
        self.step_height = 0.5;

        self.vel_x = 0.0;
        self.vel_y = 0.0;
        self.vel_z = 0.0;
        self.slide_speed = 0.0;
        self.on_ground = false;
        self.jump_speed = 0.0;

        // The Model it is drawn with, or nil for none, how much it is scaled,
        // and the animation it is playing, -1 for none, and how far into it
        self.model = nil;
        self.model_scale = 1.0;
        self.anim = 0 - 1;
        self.anim_time = 0.0;

        // The light level the model was last drawn with, and where, so that it
        // is only sampled again once the entity has moved
        self.light = 0.0;
        self.lit_x = 0.0;
        self.lit_y = 0.0;
        self.lit_z = 0.0;
        self.lit = false;
    }

    // Give the entity a model, by its name under examples/tremor/models/,
    // scaled so that it stands `height` meters tall
    set_model(self, name, height) {
        self.model = get_model(name);
        self.model_scale = height / (self.model.max_y - self.model.min_y);
    }

    // Called once per frame. Kinds of entity that change over time, whether a
    // monster, a door or a projectile, override this.
    update(self, w, dt) {
        self.anim_time = self.anim_time + dt;
    }

    // Called when the player's box overlaps this one. Returns true if the
    // entity is used up and should be removed from the world.
    touch(self, w, player) {
        return false;
    }

    // Does this entity's box overlap another's?
    overlaps(self, e) {
        let dx = self.x - e.x;
        let dz = self.z - e.z;
        let r = self.radius + e.radius;
        if (dx * dx + dz * dz >= r * r) return false;
        return self.y < e.y + e.height && e.y < self.y + self.height;
    }
}

// Something placed in a map to be seen, standing still or turning on the spot
// as pickups do, and possibly picked up
class Prop extends Entity {
    init(self, x, y, z, yaw, model, height, anim, spin) {
        Entity.init(self, x, y, z, yaw);
        self.set_model(model, height);
        self.anim = anim;

        // How fast it turns, in radians per second
        self.spin = spin;

        // What the player gets for walking into it, or nil if it can't be
        // picked up
        self.pickup = nil;

        // Touched within the reach of its model as it turns
        self.radius = (self.model.radius * self.model_scale).min(1.0);
        self.height = height;
    }

    update(self, w, dt) {
        Entity.update(self, w, dt);
        self.yaw = self.yaw + self.spin * dt;
    }

    touch(self, w, player) {
        if (self.pickup == nil) return false;
        player.give(self.pickup);
        return true;
    }
}

// Make the entity a map's `entity` line asks for
fun spawn_entity(spec) {
    let k = spec.kind;
    let x = spec.x; let y = spec.y; let z = spec.z; let yaw = spec.yaw;

    // Pickups. Those that would look odd spinning stay put, the rest turn
    // slowly.
    if (k == "health_kit") return Prop(x, y, z, yaw, "health_kit", 0.675, 0 - 1, 0.0);
    if (k == "armor_shard") return Prop(x, y, z, yaw, "armor_shard", 0.675, 0 - 1, 1.2);
    if (k == "shotgun") {
        let p = Prop(x, y, z, yaw, "shotgun", 0.6, 0 - 1, 1.2);
        p.pickup = "shotgun";
        return p;
    }
    if (k == "shotgun_ammo") return Prop(x, y, z, yaw, "shotgun_ammo", 0.35, 0 - 1, 0.0);

    // Figures, playing their idle animation
    if (k == "claw_cyborg") return Prop(x, y, z, yaw, "claw_cyborg", 1.9, 1, 0.0);
    if (k == "anime_girl") return Prop(x, y, z, yaw, "anime_girl", 1.7, 0, 0.0);

    $println("unknown entity type: " + k);
    $exit(1);
}

// Make every entity a map places
fun spawn_entities(w) {
    let out = [];
    for (let var i = 0; i < w.entity_specs.len; ++i) out.push(spawn_entity(w.entity_specs[i]));
    return out;
}

// Let the player touch whatever entities they overlap, and take out of the
// list those that are used up by it
fun touch_entities(w, player, list) {
    for (let var i = list.len - 1; i >= 0; --i) {
        let e = list[i];
        if (e.overlaps(player) && e.touch(w, player)) list.remove(i);
    }
}

// --- Weapons ---

// How a weapon is held: its model, how much that is scaled, where its middle
// sits in view space (to the right, up and ahead of the eye), and its turn
// about the view's up axis, which aims its barrel.
//
// It is drawn in front of everything, so its distance only sets how big it
// looks against its scale: twice as far and twice the scale looks the same.
// It is kept well out, clear of the near plane.
//
// The model has to have been loaded before the render actors were spawned,
// which load_weapons() sees to.
class HeldPose {
    init(self, model, scale, x, y, z, yaw) {
        self.model = get_model(model);
        self.scale = scale;
        self.x = x;
        self.y = y;
        self.z = z;
        self.yaw = yaw;
    }
}

let WEAPONS = ["shotgun"];

fun held_pose(weapon) {
    if (weapon == "shotgun") return HeldPose("shotgun", 1.2, 0.42, 0 - 0.42, 1.0, 1.4);
    return nil;
}

// Load the model of every weapon, which has to happen before the render
// actors are spawned, whether or not the map has one lying about
fun load_weapons() {
    for (let var i = 0; i < WEAPONS.len; ++i) held_pose(WEAPONS[i]);
}

class Player extends Entity {
    init(self, x, y, z, yaw) {
        Entity.init(self, x, y, z, yaw);
        self.radius = PLAYER_RADIUS;
        self.height = PLAYER_HEIGHT;
        self.step_height = STEP_HEIGHT;
        self.jump_speed = JUMP_SPEED;
        self.noclip = false;

        // The weapon in hand, nil for none, and how it is held
        self.weapon = nil;
        self.held = nil;
    }

    eye_y(self) {
        return self.y + EYE_HEIGHT;
    }

    // Take something picked up
    give(self, item) {
        let pose = held_pose(item);
        if (pose != nil) {
            self.weapon = item;
            self.held = pose;
        }
    }

    // Advance the player by one frame. `mf` and `ms` are how hard they are
    // pushing forward and sideways, each -1, 0 or 1.
    move(self, w, dt, mf, ms, want_up, want_down) {
        let sin_yaw = self.yaw.sin();
        let cos_yaw = self.yaw.cos();

        if (self.noclip) {
            // Off the leash: move along the way the camera is actually
            // pointing, pitch included, and pass through everything
            let step = FLY_SPEED * dt;
            let sin_pitch = self.pitch.sin();
            let cos_pitch = self.pitch.cos();
            self.x = self.x + (sin_yaw * cos_pitch * mf + cos_yaw * ms) * step;
            self.z = self.z + (cos_yaw * cos_pitch * mf - sin_yaw * ms) * step;
            self.y = self.y + sin_pitch * mf * step;

            if (want_up) self.y = self.y + FLY_SPEED * dt;
            if (want_down) self.y = self.y - FLY_SPEED * dt;

            self.vel_x = 0.0;
            self.vel_y = 0.0;
            self.vel_z = 0.0;
            self.slide_speed = 0.0;
            self.on_ground = false;
            return;
        }

        // Walking. Forward is where the camera looks, flattened onto the floor.
        let vx = (sin_yaw * mf + cos_yaw * ms) * WALK_SPEED;
        let vz = (cos_yaw * mf - sin_yaw * ms) * WALK_SPEED;
        move_body(w, self, dt, vx, vz, want_up);
    }
}
