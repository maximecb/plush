// Flight sim over procedural terrain
//
// The world is a heightmap generated from fractal noise at startup, which
// wraps around at its edges so that it can be flown over forever. Colors
// are picked from height and slope, and sunlight is baked into them, so the
// rasterizer only has to interpolate a color across each triangle.
//
// The terrain is drawn as nested rings of grid cells around the camera, each
// ring twice as coarse as the one inside it. Cells are visited front to back
// and an s-buffer tracks which parts of each scanline are covered, so that
// every pixel is written once. What the terrain leaves uncovered is sky.
// Towards the outside of a ring its vertices slide onto the surface of the
// coarser ring beyond, so that detail fades in instead of popping.
//
// Usage:
//   plush examples/flight_sim.psh
//   plush examples/flight_sim.psh --bench [num_frames] [shot_dir]
//
//   up / down     pitch the nose down / up
//   left / right  roll
//   A / D         rudder
//   W / S         throttle up / down
//   shift         boost, while the charge lasts
//   space         fire the cannon
//   M             music on / off
//   R             start over
//   escape / Q    quit
//
// With --bench, a set flight is rendered without opening a window and the
// time per frame is reported. Given a directory as well, a TGA screenshot
// is written there every so often.

from noise import FractalNoise;
from image import Image, save_tga;
from random import Xoshiro128;
from ./monogram_font import Font;

let rng = Xoshiro128(2025);

let FRAME_WIDTH = 960;
let FRAME_HEIGHT = 540;

let PI = 3.1415926535;
let FOV_X_DEG = 75.0;
let CX = FRAME_WIDTH.to_f() * 0.5;
let CY = FRAME_HEIGHT.to_f() * 0.5;
let FOCAL = CX / ((FOV_X_DEG * PI / 180.0) * 0.5).tan();

// Anything closer than this is clipped away. It has to be well inside
// the distance at which the ground counts as hit, or the clipping shows.
let NEAR_Z = 0.4;

// --- World ---

// The heightmap is a power of two on a side so that wrapping is a mask
let MAP_SHIFT = 10;
let MAP_SIZE = 1 << MAP_SHIFT;
let MAP_MASK = MAP_SIZE - 1;

// Size of a heightmap cell and of the whole world, in meters
let CELL = 64.0;
let WORLD = MAP_SIZE.to_f() * CELL;

// Width of the band, in cells, over which the far edges of the map are
// blended into the near ones to make the terrain tile
let WRAP_MARGIN = 96;

let TERRAIN_SEED = 4242;

// Direction towards the sun
let SUN_X = 0.48;
let SUN_Y = 0.62;
let SUN_Z = 0.62;
let AMBIENT = 0.38;
let DIFFUSE = 0.80;

// --- Level of detail ---

// Each level is a square of 2 * LOD_RADIUS cells on a side, with cells twice
// the size of the level before. The radius must be even for levels to nest.
let LOD_RADIUS = 32;
let LOD_LEVELS = 5;
let LOD_GRID = 2 * LOD_RADIUS;
let LOD_VERTS = LOD_GRID + 1;

// Distances from the camera, in cells of a level, between which the level
// blends into the shape of the next one out. The blend has to start outside
// the hole left for the finer level, which reaches LOD_RADIUS / 2 + 2 cells,
// and be complete by the nearest edge of the level, at LOD_RADIUS - 2.
let MORPH_START = LOD_RADIUS * 0.6;
let MORPH_END = LOD_RADIUS - 2.0;

// Terrain fades into the haze between these distances, the far one
// being just short of where the last level ends
let FOG_START = 1500.0;
let FOG_END = 30000.0;
let FOG_R = 196.0;
let FOG_G = 214.0;
let FOG_B = 232.0;

// --- Colors ---

fun rgb32(r, g, b) {
    return 0xFF000000 | (r << 16) | (g << 8) | b;
}

fun lerp(a, b, t) {
    return a + (b - a) * t;
}

// Ramp from 0 to 1 as x goes from lo to hi, with eased ends
fun smoothstep(lo, hi, x) {
    let t = ((x - lo) / (hi - lo)).clip(0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

// --- Audio ---
//
// All sound is synthesized by an actor of its own, which the main loop
// keeps informed with a message every frame. It is spawned before the
// terrain exists, since an actor starts with a copy of its parent's heap.

let SAMPLE_RATE = 44100;
let BENCH_MODE = $cmd_get_arg_or(1, "") == "--bench";

// Bursts per second of the cannon's buzz with the barrels at full speed
let GUN_SOUND_HZ = 100.0;

// The pull up warning is a tone that slides upwards, then a gap
let WARN_PERIOD = 0.62;
let WARN_TONE = 0.47;

// What the main loop tells the audio actor
class AudioState {
    init(self, power, wind, gun, warn, crashes, gain, music, stop) {
        // Whether the music is playing
        self.music = music;

        // Engine power, from idle at 0 to 1, and beyond with the boost
        self.power = power;

        // Rush of air past the canopy, from 0 to 1
        self.wind = wind;

        // How fast the cannon is firing, from 0 to 1
        self.gun = gun;

        // Whether the pull up warning is sounding
        self.warn = warn;

        // Number of crashes so far, each new one setting off an explosion
        self.crashes = crashes;

        // Level of the engine and wind, which a crash silences
        self.gain = gain;

        // Set to make the actor exit
        self.stop = stop;
    }
}

// What was last asked for
let var au_power_tgt = 0.0;
let var au_wind_tgt = 0.0;
let var au_gain_tgt = 0.0;
let var au_gun = 0.0;
let var au_warn = false;
let var au_crashes = 0;

// Smoothed values, so that nothing steps from one buffer to the next
let var au_power = 0.0;
let var au_wind = 0.0;
let var au_gain = 0.0;

let var au_seed = 12345;
let var en_lp1 = 0.0;
let var en_lp2 = 0.0;
let var en_rumble = 0.0;
let var en_crackle = 0.0;
let var en_phase = 0.0;
let var wind_lp = 0.0;
let var gn_phase = 0.0;
let var gn_env = 0.0;
let var gn_lp = 0.0;
let var gn_body = 0.0;
let var gn_ring1 = 0.0;
let var gn_ring2 = 0.0;
let var wr_level = 0.0;
let var wr_time = 0.0;
let var wr_phase = 0.0;
let var ex_env = 0.0;
let var ex_lp = 0.0;
let var ex_body = 0.0;

// --- Music ---
//
// A synthwave track: a pulsing bass, drums, a pad holding the chord and an
// arpeggio through an echo. The chords and the rhythm are written out by
// hand. What is left to chance is the path the arpeggio takes through each
// chord, which is drawn afresh for every section.

let MUSIC_BPM = 108;
let MUSIC_LEVEL = 0.42;

// Samples in a sixteenth note, which is one step of the sequencer
let MU_STEP = (SAMPLE_RATE * 60).idiv(MUSIC_BPM * 4);

// The echo on the arpeggio trails it by three steps
let ECHO_LEN = 3 * MU_STEP;
let echo_buf = ByteArray.with_size(ECHO_LEN * 4);

// One chord per bar, in A minor: Am, F, C, G. The bass plays the root, and
// the pad a voicing of each chord that moves as little as possible.
let BASS_NOTES = [45, 41, 48, 43];
let PAD_NOTES = [
    [57, 60, 64],
    [57, 60, 65],
    [55, 60, 64],
    [55, 59, 62],
];

// Steps of the bar on which the bass jumps up an octave
let BASS_JUMP = [0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 1, 0, 1];

// The parts that can play in a section
let PART_PAD = 1;
let PART_BASS = 2;
let PART_KICK = 4;
let PART_HAT = 8;
let PART_SNARE = 16;
let PART_ARP = 32;
let PART_ALL = 63;

// The parts playing in each section of eight bars. Having played through,
// the track goes back to MU_LOOP_TO, so the opening is only heard once.
let MU_SECTIONS = [
    PART_PAD | PART_BASS,
    PART_PAD | PART_BASS | PART_KICK | PART_HAT,
    PART_PAD | PART_BASS | PART_KICK | PART_HAT | PART_ARP,
    PART_ALL,
    PART_ALL,
    PART_PAD | PART_ARP,
    PART_PAD | PART_BASS | PART_ARP | PART_HAT,
    PART_ALL,
    PART_ALL,
];
let MU_LOOP_TO = 2;

let var mu_on = false;
let var mu_gain = 0.0;
let var mu_count = MU_STEP;
let var mu_step = 15;
let var mu_bar = -1;
let var mu_section = -1;
let var mu_parts = 0;

// Which note of the chord the arpeggio plays on each step, counting up
// through the chord's three notes over two octaves
let arp_pattern = [0, 1, 2, 3, 4, 5, 4, 3, 2, 1, 2, 3, 4, 3, 2, 1];

let var kick_env = 0.0;
let var kick_drop = 0.0;
let var kick_phase = 0.0;
let var snare_env = 0.0;
let var snare_lp = 0.0;
let var snare_phase = 0.0;
let var hat_env = 0.0;
let var hat_decay = 0.997;
let var hat_lp = 0.0;
let var bass_freq = 110.0;
let var bass_phase = 0.0;
let var bass_env = 0.0;
let var bass_lp1 = 0.0;
let var bass_lp2 = 0.0;
let var arp_freq = 440.0;
let var arp_phase = 0.0;
let var arp_env = 0.0;
let var arp_lp = 0.0;
let var echo_pos = 0;
let var pad_gain = 0.0;
let var pad_lfo = 0.0;
let var pad_lp1 = 0.0;
let var pad_lp2 = 0.0;

// Two slightly detuned oscillators for each of the pad's three notes
let pad_freq = Array.with_size(6, 220.0);
let pad_phase = [0.0, 0.31, 0.62, 0.17, 0.48, 0.79];

// Frequency of a MIDI note number
fun note_freq(note) {
    return 440.0 * (2.0).pow((note - 69) / 12.0);
}

// A random integer in [0, n), from the same generator as the noise
fun au_rand(n) {
    au_seed = (au_seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return (au_seed >> 8) % n;
}

// Draw a new path for the arpeggio: a walk up and down the notes of the
// chord, which mostly keeps going the way it was, sometimes skips a note
// and sometimes turns back
fun new_arp_pattern() {
    let var idx = au_rand(3);
    let var dir = 1;

    for (let var s = 0; s < 16; ++s) {
        arp_pattern[s] = idx;

        let roll = au_rand(100);
        if (roll < 18) dir = 0 - dir;
        if (roll >= 82) idx = idx + 2 * dir; else idx = idx + dir;

        // Turn round at either end of the range
        if (idx > 5) { idx = 4; dir = -1; }
        if (idx < 0) { idx = 1; dir = 1; }
    }
}

// Advance the sequencer by one sixteenth note and trigger what falls on it
fun music_step() {
    mu_step = (mu_step + 1) % 16;

    if (mu_step == 0) {
        mu_bar = mu_bar + 1;

        // A new section every eight bars
        if (mu_bar % 8 == 0) {
            mu_section = mu_section + 1;
            if (mu_section >= MU_SECTIONS.len) mu_section = MU_LOOP_TO;
            mu_parts = MU_SECTIONS[mu_section];
            if (mu_section > MU_LOOP_TO) new_arp_pattern();
        }

        // Move the pad to the chord of this bar
        let notes = PAD_NOTES[mu_bar % 4];
        for (let var k = 0; k < 3; ++k) {
            let f = note_freq(notes[k]);
            pad_freq[k * 2] = f * 0.9965;
            pad_freq[k * 2 + 1] = f * 1.0035;
        }
    }

    let step = mu_step;
    let chord = mu_bar % 4;
    let parts = mu_parts;

    if ((parts & PART_BASS) != 0) {
        bass_freq = note_freq(BASS_NOTES[chord] + 12 * BASS_JUMP[step]);
        bass_env = 1.0;
        if (step % 4 != 0) bass_env = 0.8;
    }

    if ((parts & PART_KICK) != 0 && step % 4 == 0) {
        kick_env = 1.0;
        kick_drop = 1.0;
        kick_phase = 0.0;
    }

    if ((parts & PART_SNARE) != 0) {
        // The last bar of a section ends on a roll
        let roll = mu_bar % 8 == 7 && step >= 12;
        if (step == 4 || step == 12) snare_env = 1.0;
        else if (roll) snare_env = 0.45 + 0.12 * (step - 12);
    }

    // Open hats on the off beats, and quiet closed ones in between
    if ((parts & PART_HAT) != 0) {
        if (step % 4 == 2) {
            hat_env = 1.0;
            hat_decay = 0.9990;
        } else {
            hat_env = 0.35;
            hat_decay = 0.9965;
        }
    }

    if ((parts & PART_ARP) != 0) {
        let idx = arp_pattern[step];
        let note = PAD_NOTES[chord][idx % 3] + 12 * idx.idiv(3) + 12;
        arp_freq = note_freq(note);
        arp_env = 1.0;
    }
}

// Synthesize one sample of music, given a sample of white noise
fun music_sample(white) {
    let step = 1.0 / SAMPLE_RATE;
    let tau = 2.0 * PI;

    mu_count = mu_count + 1;
    if (mu_count >= MU_STEP) {
        mu_count = 0;
        music_step();
    }

    // Kick: a sine that drops quickly in pitch
    let var kick = 0.0;
    if (kick_env > 0.001) {
        kick_phase = kick_phase + (46.0 + 120.0 * kick_drop) * step;
        kick = (kick_phase * tau).sin() * kick_env;
        kick_env = kick_env * 0.99982;
        kick_drop = kick_drop * 0.9990;
    }

    // Everything sustained ducks under the kick, which is the pumping
    // that the style is known for
    let duck = 1.0 - 0.55 * kick_env;

    // Snare: the top of the noise, over a short tone
    let var snare = 0.0;
    if (snare_env > 0.001) {
        snare_lp = snare_lp + (white - snare_lp) * 0.25;
        snare_phase = snare_phase + 190.0 * step;
        if (snare_phase >= 1.0) snare_phase = snare_phase - 1.0;
        snare = ((white - snare_lp) * 0.8 + (snare_phase * tau).sin() * 0.5 * snare_env) * snare_env;
        snare_env = snare_env * 0.99945;
    }

    // Hats: only the very top of the noise
    let var hat = 0.0;
    if (hat_env > 0.001) {
        hat_lp = hat_lp + (white - hat_lp) * 0.6;
        hat = (white - hat_lp) * hat_env;
        hat_env = hat_env * hat_decay;
    }

    // Bass: a saw through a filter that snaps shut after each note
    bass_phase = bass_phase + bass_freq * step;
    if (bass_phase >= 1.0) bass_phase = bass_phase - 1.0;
    let bass_cut = 0.02 + 0.22 * bass_env * bass_env;
    bass_lp1 = bass_lp1 + ((bass_phase * 2.0 - 1.0) * bass_env - bass_lp1) * bass_cut;
    bass_lp2 = bass_lp2 + (bass_lp1 - bass_lp2) * bass_cut;
    bass_env = bass_env * 0.99975;

    // Pad: six saws, through a filter that slowly opens and closes
    let var pad = 0.0;
    for (let var k = 0; k < 6; ++k) {
        let var ph = pad_phase[k] + pad_freq[k] * step;
        if (ph >= 1.0) ph = ph - 1.0;
        pad_phase[k] = ph;
        pad = pad + ph;
    }
    pad_lfo = pad_lfo + 0.07 * step;
    if (pad_lfo >= 1.0) pad_lfo = pad_lfo - 1.0;
    let pad_cut = 0.045 + 0.025 * (pad_lfo * tau).sin();
    pad_lp1 = pad_lp1 + ((pad - 3.0) * 0.33 - pad_lp1) * pad_cut;
    pad_lp2 = pad_lp2 + (pad_lp1 - pad_lp2) * pad_cut;
    let var pad_tgt = 0.0;
    if ((mu_parts & PART_PAD) != 0) pad_tgt = 1.0;
    pad_gain = pad_gain + (pad_tgt - pad_gain) * 0.00005;

    // Arpeggio: a plucked saw, repeated by an echo three steps behind
    arp_phase = arp_phase + arp_freq * step;
    if (arp_phase >= 1.0) arp_phase = arp_phase - 1.0;
    arp_lp = arp_lp + ((arp_phase * 2.0 - 1.0) * arp_env - arp_lp) * (0.06 + 0.30 * arp_env);
    arp_env = arp_env * 0.99965;
    let echo = echo_buf.get_f32(echo_pos);
    let arp = arp_lp + echo * 0.5;
    echo_buf.set_f32(echo_pos, arp_lp + echo * 0.42);
    echo_pos = echo_pos + 1;
    if (echo_pos >= ECHO_LEN) echo_pos = 0;

    return kick * 0.85 + snare * 0.30 + hat * 0.11
         + (bass_lp2 * 0.9 + pad_lp2 * pad_gain * 0.9 + arp * 0.42) * duck;
}

// Synthesize the next n samples into a buffer
fun audio_fill(buf, n) {
    let step = 1.0 / SAMPLE_RATE;
    let tau = 2.0 * PI;
    let gun_step = GUN_SOUND_HZ * au_gun * step;
    let var warn_tgt = 0.0;
    if (au_warn) warn_tgt = 1.0;

    // The boost builds more slowly than the throttle
    let var spool = 0.00004;
    if (au_power_tgt > 1.0) spool = spool / 3.0;

    for (let var i = 0; i < n; ++i) {
        // The engine takes a moment to spool up or down
        au_power = au_power + (au_power_tgt - au_power) * spool;
        au_wind = au_wind + (au_wind_tgt - au_wind) * 0.0002;
        au_gain = au_gain + (au_gain_tgt - au_gain) * 0.0005;
        let power = au_power;

        // White noise from a linear congruential generator
        au_seed = (au_seed * 1103515245 + 12345) & 0x7FFFFFFF;
        let white = au_seed / 1073741824.0 - 1.0;

        // Jet roar: filtered noise that opens up and gets louder with power,
        // over a deeper rumble
        let cutoff = 0.0067 + 0.027 * power.min(1.0);
        en_lp1 = en_lp1 + (white - en_lp1) * cutoff;
        en_lp2 = en_lp2 + (en_lp1 - en_lp2) * cutoff;
        en_rumble = en_rumble + (white - en_rumble) * 0.003;
        let var roar = en_lp2 * (1.6 + 4.0 * power) + en_rumble * 5.0 * power;

        // The boost tears at it
        if (power > 1.0) {
            en_crackle = en_crackle + (white - en_crackle) * 0.01;
            roar = roar * (1.0 + (power - 1.0) * (1.6 + en_crackle * 9.0));
        }

        // Whine of the turbine, climbing with power
        en_phase = en_phase + (268.0 + 770.0 * power.min(1.2)) * step;
        if (en_phase >= 1.0) en_phase = en_phase - 1.0;
        let c = en_phase * tau;
        let whine = (c.sin() * 0.030 + (c * 2.0).sin() * 0.012) * (0.4 + 0.6 * power);

        // Wind is the top of the noise, growing with the square of the speed
        wind_lp = wind_lp + (white - wind_lp) * 0.3;
        let wind = (white - wind_lp) * 0.09 * au_wind * au_wind;

        let var v = (roar * 0.345 + whine + wind) * 0.8 * au_gain;

        // Cannon: a burst of noise for every round, which run together into
        // a buzz. The rate follows the barrels as they spin up.
        if (gun_step > 0.0) {
            gn_phase = gn_phase + gun_step;
            if (gn_phase >= 1.0) {
                gn_phase = gn_phase - 1.0;
                gn_env = 0.75 + 0.25 * white.abs();
            }
        }
        gn_env = gn_env * 0.9958;
        let shot = white * gn_env;
        gn_lp = gn_lp + (shot - gn_lp) * 0.50;
        gn_body = gn_body + (gn_lp - gn_body) * 0.09;

        // Each burst also rings a resonator, for a hard metallic edge
        let ring = shot + gn_ring1 * 1.8846 - gn_ring2 * 0.9604;
        gn_ring2 = gn_ring1;
        gn_ring1 = ring;

        // Most of the level is in what the low pass removed, which is the crack
        v = v + (shot - gn_lp) * 0.95 + gn_lp * 0.70 + gn_body * 1.0 + ring * 0.045;

        // Pull up warning. The cycle restarts once the warning has faded
        // out, so that the next one opens with a whole tone.
        wr_level = wr_level + (warn_tgt - wr_level) * 0.002;
        if (wr_level > 0.001) {
            wr_time = wr_time + step;
            if (wr_time >= WARN_PERIOD) wr_time = wr_time - WARN_PERIOD;

            if (wr_time < WARN_TONE) {
                // The pitch holds, then slides up towards the end
                let u = wr_time / WARN_TONE;
                wr_phase = wr_phase + (780.0 + 640.0 * u * u * u) * step;
                if (wr_phase >= 1.0) wr_phase = wr_phase - 1.0;

                // Short ramps at either end keep it from clicking
                let env = (wr_time * 100.0).min((WARN_TONE - wr_time) * 50.0).min(1.0);
                let w = wr_phase * tau;
                v = v + (w.sin() * 0.6 + (w * 3.0).sin() * 0.2) * env * wr_level * 0.32;
            }
        } else {
            wr_time = 0.0;
            wr_phase = 0.0;
        }

        // Explosion: a burst of noise that dulls as it dies away
        if (ex_env > 0.0005) {
            ex_env = ex_env * 0.99996;
            ex_lp = ex_lp + (white * ex_env - ex_lp) * (0.02 + 0.3 * ex_env * ex_env);
            ex_body = ex_body + (ex_lp - ex_body) * 0.02;
            v = v + ex_lp * 2.2 + ex_body * 7.0;
        }

        // The music fades in and out, and the sequencer holds its place
        // while it is silent
        if (mu_on) mu_gain = mu_gain + (1.0 - mu_gain) * 0.0002;
        else mu_gain = mu_gain * 0.9998;
        if (mu_gain > 0.0005) v = v + music_sample(white) * mu_gain * MUSIC_LEVEL;

        // Squash the peaks instead of clipping them
        v = v * 0.7;
        buf.set_f32(i, v / (1.0 + v.abs()));
    }
}

// Take in the latest state from the main loop
fun audio_set(state) {
    au_power_tgt = state.power;
    au_wind_tgt = state.wind;
    au_gain_tgt = state.gain;
    au_gun = state.gun;
    au_warn = state.warn;
    mu_on = state.music;

    if (state.crashes != au_crashes) {
        au_crashes = state.crashes;
        ex_env = 1.0;
    }
}

// Body of the audio actor: fill a buffer whenever the device asks for one
fun audio_actor() {
    let dev = $audio_open_output(SAMPLE_RATE, 1);
    if (dev == nil) $println("no audio device, running silent");

    let var buf = ByteArray.with_size(0);

    // Without a device this still runs, to take the main loop's messages
    loop {
        let msg = $actor_recv();

        if (msg instanceof AudioState) {
            if (msg.stop) break;
            audio_set(msg);
            continue;
        }
        if (dev == nil || !(msg instanceof AudioNeeded)) continue;

        // The buffer is reused, to give the collector nothing to do
        let n = msg.num_samples;
        if (buf.len != n * 4) buf = ByteArray.with_size(n * 4);
        audio_fill(buf, n);
        $audio_write_samples(dev, buf);
    }

    return 0;
}

let var audio_id = nil;
if (!BENCH_MODE) audio_id = $actor_spawn(audio_actor);

// --- Terrain generation ---

// Broad shape of the land, with features several kilometers across
let base_noise = FractalNoise({
    seed: TERRAIN_SEED,
    frequency: 1.0 / 220.0,
    octaves: 5,
});

// Finer detail, which is given more weight the higher the ground is
let rough_noise = FractalNoise({
    seed: TERRAIN_SEED + 100,
    frequency: 1.0 / 28.0,
    octaves: 5,
});

// Blend a noise function across the map edges so that it tiles
fun sample_tiled(noise, x, z) {
    let size = MAP_SIZE;
    let edge = size - WRAP_MARGIN;
    let var v = noise.sample2d(x, z);

    if (x >= edge) {
        let t = (x - edge).to_f() / WRAP_MARGIN;
        v = lerp(v, noise.sample2d(x - size, z), t);
    }

    if (z >= edge) {
        let var w = noise.sample2d(x, z - size);
        if (x >= edge) {
            let t = (x - edge).to_f() / WRAP_MARGIN;
            w = lerp(w, noise.sample2d(x - size, z - size), t);
        }
        v = lerp(v, w, (z - edge).to_f() / WRAP_MARGIN);
    }

    return v;
}

// Ground height in meters at each grid point. Water is flat at zero.
let height_map = ByteArray.with_size(MAP_SIZE * MAP_SIZE * 4);

// Sunlit color of each grid point, as 0xRRGGBB
let color_map = ByteArray.with_size(MAP_SIZE * MAP_SIZE * 4);

// Fill in the height map. The signed elevation and the detail noise are
// kept as well, since choosing the colors needs them.
fun generate_heights(elev_map, rough_map) {
    for (let var z = 0; z < MAP_SIZE; ++z) {
        for (let var x = 0; x < MAP_SIZE; ++x) {
            let rough = sample_tiled(rough_noise, x, z) * 2.0;
            let elev = sample_tiled(base_noise, x, z) * 2.1 + 0.06 + rough * 0.03;

            // Raising the elevation to a power flattens the lowlands
            // and leaves the peaks steep
            let var h = 0.0;
            if (elev > 0.0) {
                h = elev.pow(1.7) * 3400.0 + rough * elev * 520.0;
                if (h < 0.0) h = 0.0;
            }

            let idx = (z << MAP_SHIFT) | x;
            height_map.set_f32(idx, h);
            elev_map.set_f32(idx, elev);
            rough_map.set_f32(idx, rough);
        }
    }
}

// Pick the color of each grid point from its height and slope,
// and bake the sunlight into it
fun generate_colors(elev_map, rough_map) {
    let sun_len = (SUN_X * SUN_X + SUN_Y * SUN_Y + SUN_Z * SUN_Z).sqrt();
    let sun_x = SUN_X / sun_len;
    let sun_y = SUN_Y / sun_len;
    let sun_z = SUN_Z / sun_len;

    for (let var z = 0; z < MAP_SIZE; ++z) {
        let row = z << MAP_SHIFT;
        let row_n = ((z - 1) & MAP_MASK) << MAP_SHIFT;
        let row_s = ((z + 1) & MAP_MASK) << MAP_SHIFT;

        for (let var x = 0; x < MAP_SIZE; ++x) {
            let idx = row | x;
            let h = height_map.get_f32(idx);
            let elev = elev_map.get_f32(idx);
            let rough = rough_map.get_f32(idx);

            // Surface normal from the heights of the four neighbors
            let var nx = height_map.get_f32(row | ((x - 1) & MAP_MASK))
                       - height_map.get_f32(row | ((x + 1) & MAP_MASK));
            let var nz = height_map.get_f32(row_n | x) - height_map.get_f32(row_s | x);
            let var ny = 2.0 * CELL;
            let n_len = (nx * nx + ny * ny + nz * nz).sqrt();
            nx = nx / n_len;
            ny = ny / n_len;
            nz = nz / n_len;

            let var r = 0.0;
            let var g = 0.0;
            let var b = 0.0;

            if (h <= 0.0) {
                // Water, turquoise in the shallows and darker with depth
                let t = smoothstep(0.0, 0.35, 0.0 - elev);
                r = lerp(62.0, 16.0, t);
                g = lerp(150.0, 62.0, t);
                b = lerp(168.0, 128.0, t);
            } else {
                // Grass thinning out into darker upland with height
                let up = smoothstep(150.0, 1100.0, h + rough * 250.0);
                r = lerp(92.0, 58.0, up) + rough * 22.0;
                g = lerp(132.0, 96.0, up) + rough * 16.0;
                b = lerp(58.0, 50.0, up) + rough * 8.0;

                // Sand along the shore
                let sand = 1.0 - smoothstep(4.0, 26.0, h);
                r = lerp(r, 214.0, sand);
                g = lerp(g, 200.0, sand);
                b = lerp(b, 150.0, sand);

                // Bare rock where it is steep or high
                let steep = smoothstep(0.10, 0.26, 1.0 - ny);
                let high = smoothstep(1300.0, 1900.0, h + rough * 300.0);
                let rock = steep.max(high);
                r = lerp(r, 124.0 + rough * 20.0, rock);
                g = lerp(g, 114.0 + rough * 18.0, rock);
                b = lerp(b, 104.0 + rough * 16.0, rock);

                // Snow on the peaks, which does not hold on the steepest faces
                let snow = smoothstep(2000.0, 2400.0, h + rough * 350.0)
                         * (1.0 - smoothstep(0.30, 0.50, 1.0 - ny));
                r = lerp(r, 242.0, snow);
                g = lerp(g, 246.0, snow);
                b = lerp(b, 252.0, snow);
            }

            let sun = (nx * sun_x + ny * sun_y + nz * sun_z).max(0.0);
            let lum = AMBIENT + DIFFUSE * sun;

            // Channels stay clear of 0 and 255 so that rounding in the
            // rasterizer cannot carry from one channel into the next
            let ri = (r * lum).floor().clip(4, 251);
            let gi = (g * lum).floor().clip(4, 251);
            let bi = (b * lum).floor().clip(4, 251);
            color_map.set_u32(idx, (ri << 16) | (gi << 8) | bi);
        }
    }
}

// Generate the world
fun generate_terrain() {
    let start_ms = $time_current_ms();
    let elev_map = ByteArray.with_size(MAP_SIZE * MAP_SIZE * 4);
    let rough_map = ByteArray.with_size(MAP_SIZE * MAP_SIZE * 4);

    generate_heights(elev_map, rough_map);
    generate_colors(elev_map, rough_map);

    $println("Generated terrain in " + ($time_current_ms() - start_ms).to_s() + " ms");
}

// Ground height at a world position. This follows the two triangles a cell
// is drawn as, so that it agrees exactly with the surface on screen.
fun ground_height(x, z) {
    let gx = x / CELL;
    let gz = z / CELL;
    let ix = gx.floor();
    let iz = gz.floor();
    let tx = gx - ix;
    let tz = gz - iz;

    let x0 = ix & MAP_MASK;
    let x1 = (ix + 1) & MAP_MASK;
    let row0 = (iz & MAP_MASK) << MAP_SHIFT;
    let row1 = ((iz + 1) & MAP_MASK) << MAP_SHIFT;

    let ha = height_map.get_f32(row0 | x0);
    let hd = height_map.get_f32(row1 | x1);

    // The cell is split along the diagonal from a to d
    if (tx > tz) {
        let hb = height_map.get_f32(row0 | x1);
        return ha + (hb - ha) * tx + (hd - hb) * tz;
    }

    let hc = height_map.get_f32(row1 | x0);
    return ha + (hc - ha) * tz + (hd - hc) * tx;
}

// --- Camera ---

// Position in world space, where x is east, y is up and z is north
let var cam_x = 0.0;
let var cam_y = 0.0;
let var cam_z = 0.0;

// Orientation, as the three axes of the camera in world space
let var right_x = 1.0;
let var right_y = 0.0;
let var right_z = 0.0;
let var up_x = 0.0;
let var up_y = 1.0;
let var up_z = 0.0;
let var fwd_x = 0.0;
let var fwd_y = 0.0;
let var fwd_z = 1.0;

// Pitch the nose up by an angle in radians
fun cam_pitch(angle) {
    let c = angle.cos();
    let s = angle.sin();
    let fx = fwd_x * c + up_x * s;
    let fy = fwd_y * c + up_y * s;
    let fz = fwd_z * c + up_z * s;
    up_x = up_x * c - fwd_x * s;
    up_y = up_y * c - fwd_y * s;
    up_z = up_z * c - fwd_z * s;
    fwd_x = fx;
    fwd_y = fy;
    fwd_z = fz;
}

// Roll to the right, lowering the right wing
fun cam_roll(angle) {
    let c = angle.cos();
    let s = angle.sin();
    let rx = right_x * c - up_x * s;
    let ry = right_y * c - up_y * s;
    let rz = right_z * c - up_z * s;
    up_x = up_x * c + right_x * s;
    up_y = up_y * c + right_y * s;
    up_z = up_z * c + right_z * s;
    right_x = rx;
    right_y = ry;
    right_z = rz;
}

// Yaw the nose to the right
fun cam_yaw(angle) {
    let c = angle.cos();
    let s = angle.sin();
    let fx = fwd_x * c + right_x * s;
    let fy = fwd_y * c + right_y * s;
    let fz = fwd_z * c + right_z * s;
    right_x = right_x * c - fwd_x * s;
    right_y = right_y * c - fwd_y * s;
    right_z = right_z * c - fwd_z * s;
    fwd_x = fx;
    fwd_y = fy;
    fwd_z = fz;
}

// Make the axes unit length and square to each other again, since
// rotating them a little every frame lets them drift
fun cam_normalize() {
    let f_len = (fwd_x * fwd_x + fwd_y * fwd_y + fwd_z * fwd_z).sqrt();
    fwd_x = fwd_x / f_len;
    fwd_y = fwd_y / f_len;
    fwd_z = fwd_z / f_len;

    // right = up x fwd
    let rx = up_y * fwd_z - up_z * fwd_y;
    let ry = up_z * fwd_x - up_x * fwd_z;
    let rz = up_x * fwd_y - up_y * fwd_x;
    let r_len = (rx * rx + ry * ry + rz * rz).sqrt();
    right_x = rx / r_len;
    right_y = ry / r_len;
    right_z = rz / r_len;

    // up = fwd x right
    up_x = fwd_y * right_z - fwd_z * right_y;
    up_y = fwd_z * right_x - fwd_x * right_z;
    up_z = fwd_x * right_y - fwd_y * right_x;
}

// --- Frame buffer ---

let frame_image = Image(FRAME_WIDTH, FRAME_HEIGHT);
let frame_buffer = frame_image.bytes;

// --- The s-buffer ---
//
// The covered intervals of each scanline, kept sorted, disjoint and
// coalesced. They live in parallel arrays and link by index, and are handed
// out by a bump allocator that resets each frame, so drawing allocates nothing.

let MAX_SPANS = 16384;
let NO_SPAN = -1;

let sp_x0 = Array.with_size(MAX_SPANS, 0);
let sp_x1 = Array.with_size(MAX_SPANS, 0);
let sp_next = Array.with_size(MAX_SPANS, NO_SPAN);
let var sp_top = 0;

let sb_head = Array.with_size(FRAME_HEIGHT, NO_SPAN);
let sb_full = Array.with_size(FRAME_HEIGHT, false);
let var sb_num_full = 0;

// Set once every scanline is covered, at which point drawing can stop
let var screen_done = false;

// The visible parts of the last interval inserted
let MAX_VIS = 64;
let vis_x0 = Array.with_size(MAX_VIS, 0);
let vis_x1 = Array.with_size(MAX_VIS, 0);

// Empty the s-buffer at the start of a frame
fun sbuf_reset() {
    for (let var y = 0; y < FRAME_HEIGHT; ++y) {
        sb_head[y] = NO_SPAN;
        sb_full[y] = false;
    }

    sb_num_full = 0;
    sp_top = 0;
    screen_done = false;
}

// Mark a scanline as needing nothing more drawn on it
fun sbuf_retire(y) {
    sb_full[y] = true;
    sb_num_full = sb_num_full + 1;
    if (sb_num_full >= FRAME_HEIGHT) screen_done = true;
}

// Insert [x0, x1) into scanline y. The parts of it that were not already
// covered are left in vis_x0/vis_x1, and their number is returned.
fun sbuf_insert(y, x0, x1) {
    if (sb_full[y]) return 0;

    let var n_vis = 0;
    let var prev = NO_SPAN;
    let var cur = sb_head[y];

    // Skip the intervals left of x0. One ending exactly at x0 is kept,
    // so that the two coalesce.
    while (cur != NO_SPAN && sp_x1[cur] < x0) {
        prev = cur;
        cur = sp_next[cur];
    }

    // Walk the overlapped run. The gaps in it are what is visible,
    // and the whole run merges into one interval.
    let var mx0 = x0;
    let var mx1 = x1;
    let var cx = x0;
    let var scan = cur;
    while (scan != NO_SPAN) {
        let sx0 = sp_x0[scan];
        if (sx0 > x1) break;
        let sx1 = sp_x1[scan];

        if (sx0 > cx && n_vis < MAX_VIS) {
            vis_x0[n_vis] = cx;
            vis_x1[n_vis] = sx0;
            n_vis = n_vis + 1;
        }

        if (sx1 > cx) cx = sx1;
        if (sx0 < mx0) mx0 = sx0;
        if (sx1 > mx1) mx1 = sx1;
        scan = sp_next[scan];
    }

    if (cx < x1 && n_vis < MAX_VIS) {
        vis_x0[n_vis] = cx;
        vis_x1[n_vis] = x1;
        n_vis = n_vis + 1;
    }

    // Hidden behind what is already there
    if (n_vis == 0) return 0;

    if (cur == scan) {
        // Nothing overlapped, link in a new interval. If the pool is
        // spent, retiring the scanline keeps what is nearest on it.
        if (sp_top >= MAX_SPANS) {
            sbuf_retire(y);
            return 0;
        }

        let s = sp_top;
        sp_top = sp_top + 1;
        sp_x0[s] = mx0;
        sp_x1[s] = mx1;
        sp_next[s] = scan;
        if (prev == NO_SPAN) sb_head[y] = s; else sp_next[prev] = s;
    } else {
        // Widen the first interval of the run over all of it
        sp_x0[cur] = mx0;
        sp_x1[cur] = mx1;
        sp_next[cur] = scan;
    }

    if (mx0 <= 0 && mx1 >= FRAME_WIDTH) sbuf_retire(y);
    return n_vis;
}

// --- Vertex buffer ---
//
// The vertices of the level being drawn, transformed once and shared by
// the triangles around them. A few spare slots at the end hold the
// vertices made by clipping a triangle against the near plane.

let CLIP_SLOT = LOD_VERTS * LOD_VERTS;
let NUM_SLOTS = CLIP_SLOT + 8;

// Position in view space
let v_vx = Array.with_size(NUM_SLOTS, 0.0);
let v_vy = Array.with_size(NUM_SLOTS, 0.0);
let v_vz = Array.with_size(NUM_SLOTS, 0.0);

// Position on screen, only valid in front of the near plane
let v_sx = Array.with_size(NUM_SLOTS, 0.0);
let v_sy = Array.with_size(NUM_SLOTS, 0.0);

// Color with the haze applied, each channel in 0..255
let v_r = Array.with_size(NUM_SLOTS, 0.0);
let v_g = Array.with_size(NUM_SLOTS, 0.0);
let v_b = Array.with_size(NUM_SLOTS, 0.0);

// Which of the frustum planes the vertex is outside of
let v_code = Array.with_size(NUM_SLOTS, 0);

let CODE_LEFT = 1;
let CODE_RIGHT = 2;
let CODE_TOP = 4;
let CODE_BOTTOM = 8;
let CODE_NEAR = 16;

// --- Rasterization ---

// Colors are interpolated along a span as three 8.12 fixed point channels
// packed into one integer, twenty bits apart, so that one add steps them all
let COL_ONE = 4096.0;
let R_SHIFT = 40;
let G_SHIFT = 20;

// Past this much color change per pixel a triangle is a sliver,
// and gets a single color instead
let GRAD_LIMIT = 48.0;

let FP_ONE = 65536.0;
let FRAME_WIDTH_F = FRAME_WIDTH.to_f();

let var tris_drawn = 0;

// Position of an edge at the center of a scanline, less half a pixel, so
// that rounding it up gives the first pixel whose center is right of the
// edge. An edge shared by two triangles gets the same value from both, as
// long as it is given from the same end, which makes the mesh watertight.
//
// Edges are walked as floats. Up close a triangle can reach thousands of
// pixels off screen, and its edges only stay true there if nothing along
// the way is clamped to fit a fixed point range.
fun edge_start(x_top, y_top, slope, y) {
    return x_top + (y.to_f() + 0.5 - y_top) * slope - 0.5;
}

// Draw the parts of a Gouraud shaded triangle that nothing nearer covers.
// Takes three vertex buffer slots.
fun raster_tri(ia, ib, ic) {
    let ax = v_sx[ia];
    let ay = v_sy[ia];
    let bx = v_sx[ib];
    let by = v_sy[ib];
    let cx = v_sx[ic];
    let cy = v_sy[ic];

    // Triangles facing away are behind the ground that is facing us
    let det = (bx - ax) * (cy - ay) - (cx - ax) * (by - ay);
    if (det <= 0.000001) return;

    // Sort the vertices by height on screen
    let var i0 = ia;
    let var i1 = ib;
    let var i2 = ic;
    if (v_sy[i0] > v_sy[i1]) { let t = i0; i0 = i1; i1 = t; }
    if (v_sy[i0] > v_sy[i2]) { let t = i0; i0 = i2; i2 = t; }
    if (v_sy[i1] > v_sy[i2]) { let t = i1; i1 = i2; i2 = t; }

    let x0 = v_sx[i0];
    let y0 = v_sy[i0];
    let x1 = v_sx[i1];
    let y1 = v_sy[i1];
    let x2 = v_sx[i2];
    let y2 = v_sy[i2];

    // Rows whose centers fall inside the triangle
    let y_start = (y0 - 0.5).ceil().max(0);
    let y_end = (y2 - 0.5).ceil().min(FRAME_HEIGHT);
    if (y_start >= y_end) return;
    let y_mid = (y1 - 0.5).ceil();

    // Sorting may have flipped the winding. A positive determinant here
    // puts the middle vertex right of the long edge.
    let e1x = x1 - x0;
    let e1y = y1 - y0;
    let e2x = x2 - x0;
    let e2y = y2 - y0;
    let sdet = e1x * e2y - e2x * e1y;
    let long_left = sdet > 0.0;
    let inv_det = 1.0 / sdet;

    // Color gradients, which are constant over the triangle
    let var r0 = v_r[i0];
    let var g0 = v_g[i0];
    let var b0 = v_b[i0];
    let e1r = v_r[i1] - r0;
    let e2r = v_r[i2] - r0;
    let e1g = v_g[i1] - g0;
    let e2g = v_g[i2] - g0;
    let e1b = v_b[i1] - b0;
    let e2b = v_b[i2] - b0;

    let var drdx = (e1r * e2y - e2r * e1y) * inv_det;
    let var drdy = (e2r * e1x - e1r * e2x) * inv_det;
    let var dgdx = (e1g * e2y - e2g * e1y) * inv_det;
    let var dgdy = (e2g * e1x - e1g * e2x) * inv_det;
    let var dbdx = (e1b * e2y - e2b * e1y) * inv_det;
    let var dbdy = (e2b * e1x - e1b * e2x) * inv_det;

    // A sliver gets the average of its corners
    let grad = drdx.abs().max(drdy.abs()).max(dgdx.abs()).max(dgdy.abs())
        .max(dbdx.abs()).max(dbdy.abs());
    if (grad > GRAD_LIMIT) {
        r0 = r0 + (e1r + e2r) / 3.0;
        g0 = g0 + (e1g + e2g) / 3.0;
        b0 = b0 + (e1b + e2b) / 3.0;
        drdx = 0.0; drdy = 0.0;
        dgdx = 0.0; dgdy = 0.0;
        dbdx = 0.0; dbdy = 0.0;
    }

    // Packed step from one pixel to the next
    let drdx_fx = drdx * COL_ONE;
    let dgdx_fx = dgdx * COL_ONE;
    let dbdx_fx = dbdx * COL_ONE;
    let drdy_fx = drdy * COL_ONE;
    let dgdy_fx = dgdy * COL_ONE;
    let dbdy_fx = dbdy * COL_ONE;
    let dc = (drdx_fx.floor() << R_SHIFT) + (dgdx_fx.floor() << G_SHIFT) + dbdx_fx.floor();

    // Colors at the center of pixel 0 of the first row
    let x_off = 0.5 - x0;
    let y_off = y_start.to_f() + 0.5 - y0;
    let var r_row = (r0 + x_off * drdx + y_off * drdy) * COL_ONE;
    let var g_row = (g0 + x_off * dgdx + y_off * dgdy) * COL_ONE;
    let var b_row = (b0 + x_off * dbdx + y_off * dbdy) * COL_ONE;

    // The long edge runs the full height, the other side is two edges
    let long_slope = e2x / e2y;
    let long_x = edge_start(x0, y0, long_slope, y_start);

    let var short_x = 0.0;
    let var short_slope = 0.0;
    if (y_start < y_mid) {
        short_slope = e1x / e1y;
        short_x = edge_start(x0, y0, short_slope, y_start);
    }

    let var xl = short_x;
    let var xl_step = short_slope;
    let var xr = long_x;
    let var xr_step = long_slope;
    if (long_left) {
        xl = long_x;
        xl_step = long_slope;
        xr = short_x;
        xr_step = short_slope;
    }

    let fb = frame_buffer;
    let width = FRAME_WIDTH;
    let width_f = FRAME_WIDTH_F;
    let var row = y_start * width;
    tris_drawn = tris_drawn + 1;

    for (let var y = y_start; y < y_end; ++y) {
        // Switch to the lower of the two short edges
        if (y == y_mid || (y == y_start && y >= y_mid)) {
            let slope = (x2 - x1) / (y2 - y1);
            let x = edge_start(x1, y1, slope, y);
            if (long_left) {
                xr = x;
                xr_step = slope;
            } else {
                xl = x;
                xl_step = slope;
            }
        }

        // Round the edges to pixels, keeping to the frame
        let var span_x0 = 0;
        if (xl > 0.0) {
            if (xl < width_f) span_x0 = xl.ceil(); else span_x0 = width;
        }
        let var span_x1 = width;
        if (xr < width_f) {
            if (xr > 0.0) span_x1 = xr.ceil(); else span_x1 = 0;
        }

        if (span_x0 < span_x1) {
            let n_vis = sbuf_insert(y, span_x0, span_x1);

            if (n_vis > 0) {
                // Packed color at the start of the span
                let c0 = ((r_row + span_x0 * drdx_fx).floor() << R_SHIFT)
                       + ((g_row + span_x0 * dgdx_fx).floor() << G_SHIFT)
                       + (b_row + span_x0 * dbdx_fx).floor();

                for (let var k = 0; k < n_vis; ++k) {
                    let vx0 = vis_x0[k];
                    let var c = c0 + (vx0 - span_x0) * dc;
                    let var i = row + vx0;
                    let end_i = row + vis_x1[k];

                    while (i < end_i) {
                        fb.set_u32(i, ((c >> 36) & 0xFF0000)
                                    | ((c >> 24) & 0xFF00)
                                    | ((c >> 12) & 0xFF));
                        c = c + dc;
                        ++i;
                    }
                }
            }
        }

        xl = xl + xl_step;
        xr = xr + xr_step;
        r_row = r_row + drdy_fx;
        g_row = g_row + dgdy_fx;
        b_row = b_row + dbdy_fx;
        row = row + width;
    }
}

// Project a vertex in front of the near plane onto the screen
fun project_slot(i) {
    let inv = FOCAL / v_vz[i];
    v_sx[i] = CX + v_vx[i] * inv;
    v_sy[i] = CY - v_vy[i] * inv;
}

// Write the point where an edge crosses the near plane into a slot
fun clip_edge(dst, a, b) {
    let t = (NEAR_Z - v_vz[a]) / (v_vz[b] - v_vz[a]);
    v_vx[dst] = lerp(v_vx[a], v_vx[b], t);
    v_vy[dst] = lerp(v_vy[a], v_vy[b], t);
    v_vz[dst] = NEAR_Z;
    v_r[dst] = lerp(v_r[a], v_r[b], t);
    v_g[dst] = lerp(v_g[a], v_g[b], t);
    v_b[dst] = lerp(v_b[a], v_b[b], t);
    project_slot(dst);
}

// Triangle being clipped, and the polygon that comes out
let clip_in = [0, 0, 0];
let clip_out = [0, 0, 0, 0];

// Draw a triangle that crosses the near plane, by clipping it first
fun raster_tri_clipped(ia, ib, ic) {
    clip_in[0] = ia;
    clip_in[1] = ib;
    clip_in[2] = ic;
    let var n = 0;
    let var slot = CLIP_SLOT;

    // Keep the vertices in front, adding one wherever an edge crosses
    for (let var k = 0; k < 3; ++k) {
        let a = clip_in[k];
        let b = clip_in[(k + 1) % 3];
        let a_in = v_vz[a] >= NEAR_Z;
        let b_in = v_vz[b] >= NEAR_Z;

        if (a_in) {
            clip_out[n] = a;
            n = n + 1;
        }

        if (a_in != b_in) {
            // Always clip from the same end, so that an edge shared by
            // two triangles is cut at exactly the same point
            if (a_in) clip_edge(slot, a, b); else clip_edge(slot, b, a);
            clip_out[n] = slot;
            n = n + 1;
            slot = slot + 1;
        }
    }

    if (n < 3) return;
    raster_tri(clip_out[0], clip_out[1], clip_out[2]);
    if (n == 4) raster_tri(clip_out[0], clip_out[2], clip_out[3]);
}

// --- Terrain ---

// Order in which the columns and rows of a level are visited
let order_i = Array.with_size(LOD_GRID, 0);
let order_j = Array.with_size(LOD_GRID, 0);

// Fill an array with the indices 0..LOD_GRID, starting from a given
// one and working outwards on both sides of it
fun fill_order(order, start) {
    let var n = 0;
    for (let var i = start; i < LOD_GRID; ++i) {
        order[n] = i;
        n = n + 1;
    }

    for (let var i = start - 1; i >= 0; --i) {
        order[n] = i;
        n = n + 1;
    }
}

// Transform the vertices of one level into the vertex buffer. The level's
// origin is given in units of its own cells, as is the hole left in it for
// the finer level inside, and the position of the camera.
fun transform_level(stride, bx0, bz0, cam_u, cam_v, hole_x, hole_z, has_hole) {
    let step = CELL * stride;
    let fog_scale = 1.0 / (FOG_END - FOG_START);
    let morph_scale = 1.0 / (MORPH_END - MORPH_START);
    let hole_x1 = hole_x + LOD_RADIUS;
    let hole_z1 = hole_z + LOD_RADIUS;

    // View space step from one vertex to the next along a row
    let step_vx = step * right_x;
    let step_vy = step * up_x;
    let step_vz = step * fwd_x;

    let var slot = 0;
    for (let var j = 0; j <= LOD_GRID; ++j) {
        let gz = (bz0 + j) * stride;
        let map_row = (gz & MAP_MASK) << MAP_SHIFT;
        let dist_j = (j - cam_v).abs();
        let in_hole_rows = has_hole && j > hole_z && j < hole_z1;

        // View space position of the start of the row, at the height of the camera
        let dx = (bx0 * stride).to_f() * CELL - cam_x;
        let dz = gz.to_f() * CELL - cam_z;
        let var row_vx = dx * right_x + dz * right_z - cam_y * right_y;
        let var row_vy = dx * up_x + dz * up_z - cam_y * up_y;
        let var row_vz = dx * fwd_x + dz * fwd_z - cam_y * fwd_y;

        for (let var i = 0; i <= LOD_GRID; ++i) {
            // Vertices inside the hole are not part of any triangle
            if (in_hole_rows && i > hole_x && i < hole_x1) {
                row_vx = row_vx + step_vx;
                row_vy = row_vy + step_vy;
                row_vz = row_vz + step_vz;
                ++slot;
                continue;
            }

            let gx = (bx0 + i) * stride;
            let idx = map_row | (gx & MAP_MASK);
            let color = color_map.get_u32(idx);
            let var h = height_map.get_f32(idx);
            let var r = ((color >> 16) & 255).to_f();
            let var g = ((color >> 8) & 255).to_f();
            let var b = (color & 255).to_f();

            // A vertex at an odd position has no counterpart in the next
            // level out. Moving it midway between the two neighbors that do
            // puts it on that level's surface: along an edge of one of its
            // cells, or along the diagonal a cell is split by. Doing so by
            // degrees is what fades the detail out, and having it complete
            // at the edge is what keeps the two levels from cracking apart.
            if (((i | j) & 1) != 0) {
                let dist_i = (i - cam_u).abs();
                let dist = dist_i.max(dist_j);

                if (dist > MORPH_START) {
                    let m = ((dist - MORPH_START) * morph_scale).min(1.0);
                    let ox = (i & 1) * stride;
                    let oz = (j & 1) * stride;
                    let ia = (((gz - oz) & MAP_MASK) << MAP_SHIFT) | ((gx - ox) & MAP_MASK);
                    let ib = (((gz + oz) & MAP_MASK) << MAP_SHIFT) | ((gx + ox) & MAP_MASK);
                    let ca = color_map.get_u32(ia);
                    let cb = color_map.get_u32(ib);

                    h = h + ((height_map.get_f32(ia) + height_map.get_f32(ib)) * 0.5 - h) * m;
                    r = r + ((((ca >> 16) & 255) + ((cb >> 16) & 255)) * 0.5 - r) * m;
                    g = g + ((((ca >> 8) & 255) + ((cb >> 8) & 255)) * 0.5 - g) * m;
                    b = b + (((ca & 255) + (cb & 255)) * 0.5 - b) * m;
                }
            }

            let vx = row_vx + h * right_y;
            let vy = row_vy + h * up_y;
            let vz = row_vz + h * fwd_y;
            row_vx = row_vx + step_vx;
            row_vy = row_vy + step_vy;
            row_vz = row_vz + step_vz;

            // Each side of the frustum is a plane through the eye, so the
            // test holds for points behind the camera as well
            let var code = 0;
            let fx = vx * FOCAL;
            let fy = vy * FOCAL;
            if (fx < 0.0 - vz * CX) code = CODE_LEFT;
            else if (fx > vz * CX) code = CODE_RIGHT;
            if (fy > vz * CY) code = code | CODE_TOP;
            else if (fy < 0.0 - vz * CY) code = code | CODE_BOTTOM;

            if (vz < NEAR_Z) {
                code = code | CODE_NEAR;
            } else {
                let inv = FOCAL / vz;
                v_sx[slot] = CX + vx * inv;
                v_sy[slot] = CY - vy * inv;
            }

            // Fade into the haze with distance
            let dist = (vx * vx + vy * vy + vz * vz).sqrt();
            let fog = ((dist - FOG_START) * fog_scale).clip(0.0, 1.0);

            v_vx[slot] = vx;
            v_vy[slot] = vy;
            v_vz[slot] = vz;
            v_r[slot] = r + (FOG_R - r) * fog;
            v_g[slot] = g + (FOG_G - g) * fog;
            v_b[slot] = b + (FOG_B - b) * fog;
            v_code[slot] = code;
            ++slot;
        }
    }
}

// Draw the cells of one level front to back
fun draw_level(cam_u, cam_v, hole_x, hole_z, has_hole) {
    let hole_x1 = hole_x + LOD_RADIUS;
    let hole_z1 = hole_z + LOD_RADIUS;

    // Starting from the camera's own row and column and working outwards
    // visits the cells in an order where none can hide an earlier one
    fill_order(order_i, cam_u.floor().clip(0, LOD_GRID - 1));
    fill_order(order_j, cam_v.floor().clip(0, LOD_GRID - 1));

    for (let var nj = 0; nj < LOD_GRID; ++nj) {
        let j = order_j[nj];
        let in_hole_rows = has_hole && j >= hole_z && j < hole_z1;
        let row_slot = j * LOD_VERTS;
        let local_v = cam_v - j;

        for (let var ni = 0; ni < LOD_GRID; ++ni) {
            let i = order_i[ni];
            if (in_hole_rows && i >= hole_x && i < hole_x1) continue;

            // Corners of the cell
            let a = row_slot + i;
            let b = a + 1;
            let c = a + LOD_VERTS;
            let d = c + 1;

            let code_a = v_code[a];
            let code_b = v_code[b];
            let code_c = v_code[c];
            let code_d = v_code[d];
            if ((code_a & code_b & code_c & code_d) != 0) continue;

            // The cell is split along the diagonal from a to d. The half
            // on the camera's side of it is the nearer one.
            let b_first = (cam_u - i) > local_v;

            if (((code_a | code_b | code_c | code_d) & CODE_NEAR) != 0) {
                if (b_first) {
                    raster_tri_clipped(a, d, b);
                    raster_tri_clipped(a, c, d);
                } else {
                    raster_tri_clipped(a, c, d);
                    raster_tri_clipped(a, d, b);
                }
            } else if (b_first) {
                if ((code_a & code_d & code_b) == 0) raster_tri(a, d, b);
                if ((code_a & code_c & code_d) == 0) raster_tri(a, c, d);
            } else {
                if ((code_a & code_c & code_d) == 0) raster_tri(a, c, d);
                if ((code_a & code_d & code_b) == 0) raster_tri(a, d, b);
            }
        }

        if (screen_done) return;
    }
}

// Draw the terrain around the camera, nearest level first
fun draw_terrain() {
    let var prev_bx0 = 0;
    let var prev_bz0 = 0;

    for (let var level = 0; level < LOD_LEVELS; ++level) {
        let stride = 1 << level;
        let step = CELL * stride;

        // Camera position in units of this level's cells
        let cam_cu = cam_x / step;
        let cam_cv = cam_z / step;

        // The origin is kept even so that the next level's cells,
        // which are twice the size, line up with the edges of this one
        let bx0 = ((cam_cu.floor() >> 1) << 1) - LOD_RADIUS;
        let bz0 = ((cam_cv.floor() >> 1) << 1) - LOD_RADIUS;

        // The level before covers the middle of this one
        let has_hole = level > 0;
        let hole_x = (prev_bx0 >> 1) - bx0;
        let hole_z = (prev_bz0 >> 1) - bz0;

        transform_level(stride, bx0, bz0, cam_cu - bx0, cam_cv - bz0, hole_x, hole_z, has_hole);
        draw_level(cam_cu - bx0, cam_cv - bz0, hole_x, hole_z, has_hole);
        if (screen_done) return;

        prev_bx0 = bx0;
        prev_bz0 = bz0;
    }
}

// --- Sky ---

// The sky is a gradient running from the horizon to the zenith, baked into
// a table indexed by how steeply a pixel's view ray climbs. That slope is
// linear in screen x and y, so a span walks the table at a constant rate.
let SKY_ENTRIES = 1024;
let SKY_RANGE = 2.3;
let SKY_SCALE = SKY_ENTRIES.to_f() / (2.0 * SKY_RANGE);
let sky_table = ByteArray.with_size(SKY_ENTRIES * 4);

// Bake the sky gradient
fun build_sky() {
    for (let var i = 0; i < SKY_ENTRIES; ++i) {
        let slope = (i.to_f() + 0.5) / SKY_SCALE - SKY_RANGE;

        // Haze at the horizon, which thins out quickly, then a slow
        // deepening of the blue towards the zenith
        let low = smoothstep(0.0, 0.30, slope);
        let high = smoothstep(0.15, 1.60, slope);
        let r = lerp(lerp(FOG_R, 112.0, low), 40.0, high);
        let g = lerp(lerp(FOG_G, 164.0, low), 92.0, high);
        let b = lerp(lerp(FOG_B, 226.0, low), 182.0, high);

        sky_table.set_u32(i, rgb32(r.floor(), g.floor(), b.floor()));
    }
}

// Paint [x0, x1) of a scanline with sky
fun sky_fill(y, x0, x1) {
    let fb = frame_buffer;
    let row = y * FRAME_WIDTH;

    // Table position at the first pixel, and its step per pixel, in 16.16
    let slope = fwd_y + ((x0.to_f() + 0.5 - CX) * right_y + (CY - y.to_f() - 0.5) * up_y) / FOCAL;
    let var pos = ((slope + SKY_RANGE) * SKY_SCALE * FP_ONE).floor();
    let step = (right_y / FOCAL * SKY_SCALE * FP_ONE).floor();

    // With the wings level a whole scanline is one color
    if (step == 0) {
        fb.fill_u32(row + x0, x1 - x0, sky_table.get_u32(pos >> 16));
        return;
    }

    // The gradient is shallow, so each table entry covers a run of pixels
    let var x = x0;
    while (x < x1) {
        let idx = pos >> 16;
        let var n = 0;
        if (step > 0) n = (((idx + 1) << 16) - pos + step - 1).idiv(step);
        else n = (pos - (idx << 16)).idiv(0 - step) + 1;
        if (n > x1 - x) n = x1 - x;

        fb.fill_u32(row + x, n, sky_table.get_u32(idx));
        x = x + n;
        pos = pos + n * step;
    }
}

// Fill in everything the terrain left uncovered. The s-buffer's intervals
// are sorted and coalesced, so the gaps between them are exactly that.
fun draw_sky() {
    for (let var y = 0; y < FRAME_HEIGHT; ++y) {
        if (sb_full[y]) continue;

        let var x = 0;
        let var cur = sb_head[y];
        while (cur != NO_SPAN) {
            let sx0 = sp_x0[cur];
            if (sx0 > x) sky_fill(y, x, sx0.min(FRAME_WIDTH));
            let sx1 = sp_x1[cur];
            if (sx1 > x) x = sx1;
            cur = sp_next[cur];
        }

        if (x < FRAME_WIDTH) sky_fill(y, x, FRAME_WIDTH);
    }
}

// Render the world as seen from the camera
fun render_world() {
    tris_drawn = 0;
    sbuf_reset();
    draw_terrain();
    draw_sky();
}

// --- Flight ---

// An arcade flight model. The plane always moves along its nose, and its
// speed is the balance of thrust, drag and the pull of gravity on a climb.

let GRAVITY = 9.81;

// Turn rates at full deflection, in radians per second
let PITCH_RATE = 1.1;
let ROLL_RATE = 2.2;
let YAW_RATE = 0.35;

// How quickly the controls follow the keys
let CONTROL_LAG = 7.0;

// Below this speed the controls lose their bite
let CORNER_SPEED = 140.0;

// How strongly banking turns the plane, relative to a real coordinated turn
let BANK_TURN = 2.5;

// Acceleration at full throttle, and the speed in level flight at which
// drag cancels it. Drag grows with the square of the speed.
let THRUST = 32.0;
let TOP_SPEED = 290.0;
let DRAG = THRUST / (TOP_SPEED * TOP_SPEED);

// Speed lost to pulling hard, in m/s per second
let TURN_DRAG = 7.0;

// Below this speed the wings stop holding the plane up
let STALL_SPEED = 62.0;

// The boost multiplies thrust while its charge lasts. Once spent, it has
// to recharge part of the way before it can be lit again.
let BOOST_THRUST = 2.4;
let BOOST_TIME = 6.0;
let BOOST_RECHARGE = 18.0;
let BOOST_RESTART = 0.25;

// Coming closer to the ground than this is a crash
let CRASH_CLEARANCE = 3.0;
let CRASH_TIME = 3.0;

// Control inputs, each from -1 to 1
let var in_pitch = 0.0;
let var in_roll = 0.0;
let var in_yaw = 0.0;
let var in_throttle = 0.0;
let var in_boost = false;
let var in_fire = false;

// Barrel temperature of the cannon from 0 to 1, whether it has overheated,
// and whether rounds are leaving it
let var gun_heat = 0.0;
let var gun_hot = false;
let var gun_firing = false;

// Whether the ground is coming up fast enough to warn about
let var pull_up = false;

// How many times the plane has crashed
let var crash_count = 0;

let var music_on = true;

// Where the control surfaces are, which trails the inputs
let var ctl_pitch = 0.0;
let var ctl_roll = 0.0;
let var ctl_yaw = 0.0;

let var speed = 0.0;
let var throttle = 0.0;
let var climb_rate = 0.0;
let var stalled = false;
let var boost_charge = 1.0;
let var boost_on = false;
let var boost_spent = false;

// Counts down after a crash, until the flight starts over
let var crash_timer = 0.0;

// Turn the camera to the right about the world's vertical axis
fun cam_turn(angle) {
    let c = angle.cos();
    let s = angle.sin();

    let rx = right_x * c + right_z * s;
    right_z = right_z * c - right_x * s;
    right_x = rx;

    let ux = up_x * c + up_z * s;
    up_z = up_z * c - up_x * s;
    up_x = ux;

    let fx = fwd_x * c + fwd_z * s;
    fwd_z = fwd_z * c - fwd_x * s;
    fwd_x = fx;
}

// Start the flight over, level and heading north
fun reset_flight() {
    cam_x = WORLD * 0.5;
    cam_z = WORLD * 0.5;
    cam_y = ground_height(cam_x, cam_z) + 900.0;

    right_x = 1.0; right_y = 0.0; right_z = 0.0;
    up_x = 0.0; up_y = 1.0; up_z = 0.0;
    fwd_x = 0.0; fwd_y = 0.0; fwd_z = 1.0;

    ctl_pitch = 0.0;
    ctl_roll = 0.0;
    ctl_yaw = 0.0;
    speed = 220.0;
    throttle = 0.7;
    climb_rate = 0.0;
    stalled = false;
    boost_charge = 1.0;
    boost_on = false;
    boost_spent = false;
    crash_timer = 0.0;
    clear_cannon();
}

// Highest ground within the crash clearance of a position. On a steep
// slope the ground beside the plane is much nearer than the ground below
// it, so the height underneath alone would let a wing into the hillside.
fun ground_near(x, z) {
    let d = CRASH_CLEARANCE;
    return ground_height(x, z)
        .max(ground_height(x - d, z))
        .max(ground_height(x + d, z))
        .max(ground_height(x, z - d))
        .max(ground_height(x, z + d));
}

// Advance the flight by one time step
fun update_flight(dt) {
    // Sit in the wreckage for a moment, then start over
    if (crash_timer > 0.0) {
        crash_timer = crash_timer - dt;
        if (crash_timer <= 0.0) reset_flight();
        return;
    }

    // Ease the controls towards the inputs
    let ease = (CONTROL_LAG * dt).min(1.0);
    ctl_pitch = ctl_pitch + (in_pitch - ctl_pitch) * ease;
    ctl_roll = ctl_roll + (in_roll - ctl_roll) * ease;
    ctl_yaw = ctl_yaw + (in_yaw - ctl_yaw) * ease;

    let authority = (speed / CORNER_SPEED).clip(0.25, 1.0);
    cam_pitch(ctl_pitch * PITCH_RATE * authority * dt);
    cam_roll(ctl_roll * ROLL_RATE * authority * dt);
    cam_yaw(ctl_yaw * YAW_RATE * authority * dt);

    // A banked wing pulls the plane round towards its low side
    cam_turn((0.0 - right_y) * BANK_TURN * GRAVITY / speed.max(STALL_SPEED) * dt);

    throttle = (throttle + in_throttle * 0.6 * dt).clip(0.0, 1.0);

    // Boost burns its charge while held and recovers when released
    if (boost_spent && boost_charge >= BOOST_RESTART) boost_spent = false;
    boost_on = in_boost && !boost_spent && boost_charge > 0.0;
    if (boost_on) {
        boost_charge = boost_charge - dt / BOOST_TIME;
        if (boost_charge <= 0.0) {
            boost_charge = 0.0;
            boost_spent = true;
        }
    } else {
        boost_charge = (boost_charge + dt / BOOST_RECHARGE).min(1.0);
    }

    let var thrust = THRUST * throttle;
    if (boost_on) thrust = THRUST * BOOST_THRUST;
    let accel = thrust - DRAG * speed * speed - GRAVITY * fwd_y
              - TURN_DRAG * ctl_pitch.abs() * authority;
    speed = (speed + accel * dt).max(15.0);

    // Too slow, and the nose drops and the plane sinks until it picks
    // up speed again
    let lift = speed / STALL_SPEED;
    let stall = (1.0 - lift * lift).clip(0.0, 1.0);
    stalled = stall > 0.0;
    fwd_y = fwd_y - stall * 0.9 * dt;
    cam_normalize();

    climb_rate = fwd_y * speed - stall * 45.0;
    cam_x = cam_x + fwd_x * speed * dt;
    cam_y = cam_y + climb_rate * dt;
    cam_z = cam_z + fwd_z * speed * dt;

    // The terrain repeats, so wrapping the position goes unnoticed
    if (cam_x < 0.0) cam_x = cam_x + WORLD;
    if (cam_x >= WORLD) cam_x = cam_x - WORLD;
    if (cam_z < 0.0) cam_z = cam_z + WORLD;
    if (cam_z >= WORLD) cam_z = cam_z - WORLD;

    // Hitting the ground ends the flight. The camera is left just above
    // the surface, to keep the wreck from looking out from under it.
    let floor_y = ground_near(cam_x, cam_z) + CRASH_CLEARANCE;
    if (cam_y < floor_y) {
        cam_y = floor_y;
        crash_timer = CRASH_TIME;
        crash_count = crash_count + 1;
    }
}

// --- Head-up display ---

let HUD_GREEN = 0xFF38FF58;
let HUD_SHADOW = 0xFF000000;
let WARN_RED = 0xFFFF2A1E;

// Glyphs are rendered on a background of zero and used as masks
let font_small = Font(1, HUD_GREEN, 0);
let font_large = Font(2, HUD_GREEN, 0);
let font_warn = Font(4, HUD_GREEN, 0);
let font_title = Font(5, HUD_GREEN, 0);

// Lines are clipped to this rectangle
let var clip_x0 = 0;
let var clip_y0 = 0;
let var clip_x1 = FRAME_WIDTH;
let var clip_y1 = FRAME_HEIGHT;

// Seconds since the start, for things that blink
let var hud_time = 0.0;

// Restrict lines to a rectangle of the frame
fun hud_clip(x0, y0, x1, y1) {
    clip_x0 = x0.max(0);
    clip_y0 = y0.max(0);
    clip_x1 = x1.min(FRAME_WIDTH);
    clip_y1 = y1.min(FRAME_HEIGHT);
}

// Draw a line between two points given as floats
fun draw_line(x0, y0, x1, y1, color) {
    let dx = x1 - x0;
    let dy = y1 - y0;
    let n = dx.abs().max(dy.abs()).ceil().max(1);
    if (n > 4000) return;

    let step_x = dx / n;
    let step_y = dy / n;
    let fb = frame_buffer;

    for (let var k = 0; k <= n; ++k) {
        let x = (x0 + step_x * k).floor();
        let y = (y0 + step_y * k).floor();
        if (x >= clip_x0 && x < clip_x1 && y >= clip_y0 && y < clip_y1) {
            fb.set_u32(y * FRAME_WIDTH + x, color);
        }
    }
}

// Draw a line in the color of the display
fun hud_line(x0, y0, x1, y1) {
    draw_line(x0, y0, x1, y1, HUD_GREEN);
}

// Fill a rectangle
fun fill_rect(x, y, w, h, color) {
    let x0 = x.max(0);
    let x1 = (x + w).min(FRAME_WIDTH);
    let y0 = y.max(0);
    let y1 = (y + h).min(FRAME_HEIGHT);
    if (x0 >= x1) return;

    for (let var row = y0; row < y1; ++row) {
        frame_buffer.fill_u32(row * FRAME_WIDTH + x0, x1 - x0, color);
    }
}

// Fill a rectangle in the color of the display
fun hud_rect(x, y, w, h) {
    fill_rect(x, y, w, h, HUD_GREEN);
}

// Draw the outline of a rectangle
fun hud_frame(x, y, w, h) {
    hud_rect(x, y, w, 1);
    hud_rect(x, y + h - 1, w, 1);
    hud_rect(x, y, 1, h);
    hud_rect(x + w - 1, y, 1, h);
}

// Paint the lit pixels of a glyph in one color
fun draw_glyph(glyph, x, y, color) {
    let fb = frame_buffer;
    let bits = glyph.bytes;
    let w = glyph.width;

    for (let var gy = 0; gy < glyph.height; ++gy) {
        let py = y + gy;
        if (py < 0 || py >= FRAME_HEIGHT) continue;

        for (let var gx = 0; gx < w; ++gx) {
            let px = x + gx;
            if (px < 0 || px >= FRAME_WIDTH) continue;
            if (bits.get_u32(gy * w + gx) != 0) fb.set_u32(py * FRAME_WIDTH + px, color);
        }
    }
}

// Draw a string with its top left corner at (x, y), over a drop shadow
// that keeps it readable against snow and sky
fun draw_text(font, text, x, y, color) {
    for (let var i = 0; i < text.len; ++i) {
        let glyph = font.render_char(text.char_at(i));
        let gx = x + i * font.char_w;
        draw_glyph(glyph, gx + 1, y + 1, HUD_SHADOW);
        draw_glyph(glyph, gx, y, color);
    }
}

// Draw a string in the color of the display
fun hud_text(font, text, x, y) {
    draw_text(font, text, x, y, HUD_GREEN);
}

// Draw a string centered on a point
fun hud_text_centered(font, text, cx, cy) {
    hud_text(font, text, cx - (text.len * font.char_w).idiv(2), cy - font.char_h.idiv(2));
}

// Angle of the point (x, y) from the x axis, in radians
fun atan2(y, x) {
    if (x > 0.0) return (y / x).atan();
    if (x < 0.0) {
        if (y >= 0.0) return (y / x).atan() + PI;
        return (y / x).atan() - PI;
    }
    if (y > 0.0) return PI * 0.5;
    if (y < 0.0) return 0.0 - PI * 0.5;
    return 0.0;
}

// The fixed cross that marks where the nose is pointing
fun draw_boresight() {
    hud_line(CX - 18.0, CY, CX - 6.0, CY);
    hud_line(CX + 6.0, CY, CX + 18.0, CY);
    hud_line(CX, CY - 18.0, CX, CY - 6.0);
    hud_line(CX, CY + 6.0, CX, CY + 18.0);
    hud_rect(CX.floor(), CY.floor(), 1, 1);
}

// The pitch ladder: a line for every ten degrees of climb or dive, drawn
// where that elevation really is, so the zero line lies on the horizon
fun draw_ladder() {
    // Heading along the ground, which is undefined looking straight up or down
    let h_len = (fwd_x * fwd_x + fwd_z * fwd_z).sqrt();
    if (h_len < 0.05) return;
    let hx = fwd_x / h_len;
    let hz = fwd_z / h_len;

    // Direction on screen of a level line, and of down the ladder
    let var ux = hz * right_x - hx * right_z;
    let var uy = hx * up_z - hz * up_x;
    let u_len = (ux * ux + uy * uy).sqrt();
    if (u_len < 0.01) return;
    ux = ux / u_len;
    uy = uy / u_len;
    let down_x = 0.0 - uy;
    let down_y = ux;

    let pitch_deg = atan2(fwd_y, h_len) * 180.0 / PI;
    hud_clip(CX.floor() - 230, CY.floor() - 160, CX.floor() + 230, CY.floor() + 160);

    for (let var deg = -90; deg <= 90; deg += 10) {
        if ((deg - pitch_deg).abs() > 30.0) continue;

        // Where a point at this elevation, dead ahead, falls on screen
        let angle = deg * PI / 180.0;
        let dx = hx * angle.cos();
        let dy = angle.sin();
        let dz = hz * angle.cos();
        let vz = dx * fwd_x + dy * fwd_y + dz * fwd_z;
        if (vz < 0.2) continue;
        let px = CX + FOCAL * (dx * right_x + dy * right_y + dz * right_z) / vz;
        let py = CY - FOCAL * (dx * up_x + dy * up_y + dz * up_z) / vz;

        // The horizon is one long line with a gap for the boresight
        if (deg == 0) {
            hud_line(px - ux * 220.0, py - uy * 220.0, px - ux * 44.0, py - uy * 44.0);
            hud_line(px + ux * 44.0, py + uy * 44.0, px + ux * 220.0, py + uy * 220.0);
            continue;
        }

        for (let var side = -1; side <= 1; side += 2) {
            let sx = ux * side;
            let sy = uy * side;

            // Solid above the horizon, dashed below
            if (deg > 0) {
                hud_line(px + sx * 40.0, py + sy * 40.0, px + sx * 96.0, py + sy * 96.0);
            } else {
                hud_line(px + sx * 40.0, py + sy * 40.0, px + sx * 60.0, py + sy * 60.0);
                hud_line(px + sx * 76.0, py + sy * 76.0, px + sx * 96.0, py + sy * 96.0);
            }

            // The end of each rung is turned towards the horizon
            let var tick = 7.0;
            if (deg < 0) tick = -7.0;
            let ex = px + sx * 96.0;
            let ey = py + sy * 96.0;
            hud_line(ex, ey, ex + down_x * tick, ey + down_y * tick);

            let lx = (px + sx * 112.0).floor();
            let ly = (py + sy * 112.0).floor();
            if (lx > clip_x0 + 8 && lx < clip_x1 - 8 && ly > clip_y0 + 8 && ly < clip_y1 - 8) {
                hud_text_centered(font_small, deg.abs().to_s(), lx, ly);
            }
        }
    }

    hud_clip(0, 0, FRAME_WIDTH, FRAME_HEIGHT);
}

// The compass strip along the top of the screen
fun draw_heading() {
    let var heading = atan2(fwd_x, fwd_z) * 180.0 / PI;
    if (heading < 0.0) heading = heading + 360.0;

    let px_per_deg = 4.0;
    let span = 32.0;
    let base_y = 34;

    // A tick every five degrees and a label every ten
    let first = ((heading - span) / 5.0).ceil() * 5;
    for (let var deg = first; deg <= heading + span; deg += 5) {
        let x = (CX + (deg - heading) * px_per_deg).floor();

        if (deg % 10 != 0) {
            hud_rect(x, base_y - 4, 1, 4);
            continue;
        }
        hud_rect(x, base_y - 8, 1, 8);

        let compass = ((deg % 360) + 360) % 360;
        let var label = compass.idiv(10).to_s().lpad(2, "0");
        if (compass == 0) label = "N";
        else if (compass == 90) label = "E";
        else if (compass == 180) label = "S";
        else if (compass == 270) label = "W";
        hud_text_centered(font_small, label, x, base_y - 16);
    }

    // Pointer and readout under the strip
    hud_line(CX, base_y + 3.0, CX - 5.0, base_y + 9.0);
    hud_line(CX, base_y + 3.0, CX + 5.0, base_y + 9.0);
    let readout = (heading.floor() % 360).to_s().lpad(3, "0");
    hud_text_centered(font_small, readout, CX.floor(), base_y + 18);
}

// A boxed number with a caption to the right of it
fun draw_readout(x, y, value, caption) {
    let w = 5 * font_large.char_w + 12;
    let h = font_large.char_h + 6;
    hud_frame(x, y, w, h);

    let text = value.to_s();
    hud_text(font_large, text, x + w - 6 - text.len * font_large.char_w, y + 3);
    hud_text(font_small, caption, x + w + 6, y + (h - font_small.char_h).idiv(2));
}

// A labelled bar filled to a fraction of its length
fun draw_bar(x, y, label, frac, color) {
    hud_text(font_small, label, x, y - 2);
    let bx = x + 4 * font_small.char_w;
    hud_frame(bx, y, 104, 9);
    fill_rect(bx + 2, y + 2, (frac.clip(0.0, 1.0) * 100.0).floor(), 5, color);
}

// Color for a temperature from 0 to 1, going from green through
// yellow to red
fun heat_color(heat) {
    let t = heat.clip(0.0, 1.0) * 2.0;
    if (t < 1.0) {
        return rgb32(lerp(56.0, 255.0, t).floor(), lerp(255.0, 220.0, t).floor(),
            lerp(88.0, 40.0, t).floor());
    }
    return rgb32(255, lerp(220.0, 42.0, t - 1.0).floor(), lerp(40.0, 30.0, t - 1.0).floor());
}

// Would the plane hit the ground within a few seconds on its present course?
fun ground_ahead() {
    for (let var k = 1; k <= 3; ++k) {
        let t = k.to_f();
        let x = cam_x + fwd_x * speed * t;
        let z = cam_z + fwd_z * speed * t;
        if (cam_y + climb_rate * t < ground_height(x, z) + 25.0) return true;
    }
    return false;
}

// Draw the head-up display over the finished frame
fun draw_hud() {
    draw_boresight();
    draw_ladder();
    draw_heading();

    let low_y = FRAME_HEIGHT - 46;
    draw_readout(CX.floor() - 210, low_y, (speed * 3.6).floor(), "KM/H");
    draw_readout(CX.floor() + 100, low_y, cam_y.floor(), "ALT M");

    draw_bar(24, FRAME_HEIGHT - 64, "GUN", gun_heat, heat_color(gun_heat));
    if (gun_hot) draw_text(font_small, "OVERHEAT", 164, FRAME_HEIGHT - 66, WARN_RED);
    draw_bar(24, FRAME_HEIGHT - 46, "THR", throttle, HUD_GREEN);
    draw_bar(24, FRAME_HEIGHT - 28, "BST", boost_charge, HUD_GREEN);
    if (boost_on) hud_text(font_small, "BOOST", 164, FRAME_HEIGHT - 30);
    else if (boost_spent) hud_text(font_small, "CHARGING", 164, FRAME_HEIGHT - 30);

    // Warnings blink under the boresight
    let blink = (hud_time * 4.0).floor() % 2 == 0;
    if (blink) {
        if (stalled) {
            hud_text_centered(font_large, "STALL", CX.floor(), CY.floor() + 100);
        } else if (pull_up) {
            let text = "PULL UP";
            let x = CX.floor() - (text.len * font_warn.char_w).idiv(2);
            draw_text(font_warn, text, x, CY.floor() + 76, WARN_RED);
        }
    }
}

// Blend the whole frame towards a color, by an amount from 0 to 256
fun tint_frame(r, g, b, amount) {
    let fb = frame_buffer;
    let keep = 256 - amount;
    let add_rb = ((r << 16) | b) * amount;
    let add_g = (g << 8) * amount;

    // Red and blue are far enough apart to share a multiply
    for (let var i = 0; i < FRAME_WIDTH * FRAME_HEIGHT; ++i) {
        let c = fb.get_u32(i);
        let rb = (((c & 0xFF00FF) * keep + add_rb) >> 8) & 0xFF00FF;
        let gg = (((c & 0xFF00) * keep + add_g) >> 8) & 0xFF00;
        fb.set_u32(i, rb | gg);
    }
}

// The moments after a crash: a flash that burns down into the dark
fun draw_crash() {
    let t = (1.0 - crash_timer / CRASH_TIME).clip(0.0, 1.0);
    let glow = (1.0 - t * 3.0).max(0.0);
    let r = lerp(70.0, 255.0, glow).floor();
    let g = lerp(8.0, 225.0, glow * glow).floor();
    let b = lerp(4.0, 150.0, glow * glow * glow).floor();
    let amount = lerp(150.0, 235.0, (glow).max(t * t)).floor();

    tint_frame(r, g, b, amount);
    if (t > 0.2) hud_text_centered(font_title, "CRASHED", CX.floor(), CY.floor());
}

// --- Cannon ---
//
// A rotary cannon, which takes a moment to spin up to its full rate of
// fire. Every round drawn is a tracer. They fly on their own once fired,
// carrying the plane's speed and dropping under gravity.

// Tracers per second with the barrels at full speed
let GUN_RATE = 40.0;
let MUZZLE_SPEED = 1050.0;

// Seconds for the barrels to spin up and to run down again
let GUN_SPIN_UP = 0.3;
let GUN_SPIN_DOWN = 0.8;

// Where the muzzle is relative to the pilot's eye, which is under the nose,
// and the distance ahead at which the rounds cross the line of sight
let GUN_RIGHT = 0.0;
let GUN_UP = -1.0;
let GUN_FWD = 1.5;
let GUN_CONVERGE = 700.0;

// Seconds of firing to overheat from cold, and to cool back down. Once
// overheated, the gun stays out until it has cooled to the restart level.
let GUN_HEAT_TIME = 4.0;
let GUN_COOL_TIME = 7.0;
let GUN_RESTART = 0.35;

// Scatter of the rounds, in radians
let GUN_SPREAD = 0.0022;

let ROUND_LIFE = 2.6;
let TRACER_LENGTH = 34.0;
let TRACER_BODY = 0xFFFFD21E;
let TRACER_HEAD = 0xFFFFF7B4;

// Rounds in flight. A negative age marks a free slot.
let MAX_ROUNDS = 128;
let rd_x = Array.with_size(MAX_ROUNDS, 0.0);
let rd_y = Array.with_size(MAX_ROUNDS, 0.0);
let rd_z = Array.with_size(MAX_ROUNDS, 0.0);
let rd_vx = Array.with_size(MAX_ROUNDS, 0.0);
let rd_vy = Array.with_size(MAX_ROUNDS, 0.0);
let rd_vz = Array.with_size(MAX_ROUNDS, 0.0);
let rd_age = Array.with_size(MAX_ROUNDS, -1.0);
let var rd_next = 0;

// Puffs thrown up where rounds hit the ground
let MAX_IMPACTS = 48;
let IMPACT_LIFE = 0.4;
let im_x = Array.with_size(MAX_IMPACTS, 0.0);
let im_y = Array.with_size(MAX_IMPACTS, 0.0);
let im_z = Array.with_size(MAX_IMPACTS, 0.0);
let im_age = Array.with_size(MAX_IMPACTS, -1.0);
let var im_next = 0;

let var gun_spin = 0.0;
let var gun_accum = 0.0;

// Remove every round and puff, and cool the gun
fun clear_cannon() {
    for (let var i = 0; i < MAX_ROUNDS; ++i) rd_age[i] = -1.0;
    for (let var i = 0; i < MAX_IMPACTS; ++i) im_age[i] = -1.0;
    gun_spin = 0.0;
    gun_accum = 0.0;
    gun_heat = 0.0;
    gun_hot = false;
}

// Fire one round, which left the muzzle `lead` seconds ago
fun fire_round(lead) {
    // Aim along the nose, angled in to cross the line of sight, and scattered
    let side = rng.normal(0.0, GUN_SPREAD) - GUN_RIGHT / GUN_CONVERGE;
    let rise = rng.normal(0.0, GUN_SPREAD) - GUN_UP / GUN_CONVERGE;
    let dx = fwd_x + right_x * side + up_x * rise;
    let dy = fwd_y + right_y * side + up_y * rise;
    let dz = fwd_z + right_z * side + up_z * rise;

    // The round keeps the speed the plane gave it
    let vx = dx * MUZZLE_SPEED + fwd_x * speed;
    let vy = dy * MUZZLE_SPEED + climb_rate;
    let vz = dz * MUZZLE_SPEED + fwd_z * speed;

    let i = rd_next;
    rd_next = (rd_next + 1) % MAX_ROUNDS;
    rd_x[i] = cam_x + right_x * GUN_RIGHT + up_x * GUN_UP + fwd_x * GUN_FWD + vx * lead;
    rd_y[i] = cam_y + right_y * GUN_RIGHT + up_y * GUN_UP + fwd_y * GUN_FWD + vy * lead;
    rd_z[i] = cam_z + right_z * GUN_RIGHT + up_z * GUN_UP + fwd_z * GUN_FWD + vz * lead;
    rd_vx[i] = vx;
    rd_vy[i] = vy;
    rd_vz[i] = vz;
    rd_age[i] = lead;
}

// Leave a puff where a round came down
fun add_impact(x, y, z) {
    let i = im_next;
    im_next = (im_next + 1) % MAX_IMPACTS;
    im_x[i] = x;
    im_y[i] = y;
    im_z[i] = z;
    im_age[i] = 0.0;
}

// Advance the cannon and everything it has fired by one time step
fun update_cannon(dt) {
    // Move the rounds already in flight
    for (let var i = 0; i < MAX_ROUNDS; ++i) {
        let age = rd_age[i];
        if (age < 0.0) continue;

        rd_vy[i] = rd_vy[i] - GRAVITY * dt;
        let x = rd_x[i] + rd_vx[i] * dt;
        let y = rd_y[i] + rd_vy[i] * dt;
        let z = rd_z[i] + rd_vz[i] * dt;
        rd_x[i] = x;
        rd_y[i] = y;
        rd_z[i] = z;
        rd_age[i] = age + dt;

        let ground = ground_height(x, z);
        if (y <= ground) {
            add_impact(x, ground, z);
            rd_age[i] = -1.0;
        } else if (age + dt > ROUND_LIFE) {
            rd_age[i] = -1.0;
        }
    }

    for (let var i = 0; i < MAX_IMPACTS; ++i) {
        let age = im_age[i];
        if (age < 0.0) continue;
        im_age[i] = age + dt;
        if (age + dt > IMPACT_LIFE) im_age[i] = -1.0;
    }

    // Spin the barrels up while the trigger is held
    if (gun_hot && gun_heat <= GUN_RESTART) gun_hot = false;
    let firing = in_fire && !gun_hot && crash_timer <= 0.0;
    if (firing) gun_spin = (gun_spin + dt / GUN_SPIN_UP).min(1.0);
    else gun_spin = (gun_spin - dt / GUN_SPIN_DOWN).max(0.0);

    // The barrels cool whenever no rounds are going through them
    gun_firing = firing && gun_spin >= 0.3;
    if (!gun_firing) {
        gun_heat = (gun_heat - dt / GUN_COOL_TIME).max(0.0);
        return;
    }

    gun_heat = gun_heat + dt / GUN_HEAT_TIME;
    if (gun_heat >= 1.0) {
        gun_heat = 1.0;
        gun_hot = true;
    }

    // Rounds due within this step are spread back along it, so that
    // they stay evenly spaced whatever the frame rate
    let rate = GUN_RATE * gun_spin;
    gun_accum = gun_accum + rate * dt;
    while (gun_accum >= 1.0) {
        gun_accum = gun_accum - 1.0;
        fire_round(gun_accum / rate);
    }
}

// Position of the last point passed to `view_point`, in view space
let var pt_x = 0.0;
let var pt_y = 0.0;
let var pt_z = 0.0;

// Transform a world position into view space. The world wraps, so the
// copy of the point nearest the camera is the one that is used.
fun view_point(x, y, z) {
    let var dx = x - cam_x;
    let var dz = z - cam_z;
    let dy = y - cam_y;
    if (dx > WORLD * 0.5) dx = dx - WORLD;
    else if (dx < WORLD * -0.5) dx = dx + WORLD;
    if (dz > WORLD * 0.5) dz = dz - WORLD;
    else if (dz < WORLD * -0.5) dz = dz + WORLD;

    pt_x = dx * right_x + dy * right_y + dz * right_z;
    pt_y = dx * up_x + dy * up_y + dz * up_z;
    pt_z = dx * fwd_x + dy * fwd_y + dz * fwd_z;
}

// Can a point be seen from the camera, or is there ground in the way?
// The terrain is drawn without a depth buffer, so anything drawn over it
// has to find this out by walking the line of sight.
fun sight_clear(x, y, z) {
    let var dx = x - cam_x;
    let var dz = z - cam_z;
    let dy = y - cam_y;
    if (dx > WORLD * 0.5) dx = dx - WORLD;
    else if (dx < WORLD * -0.5) dx = dx + WORLD;
    if (dz > WORLD * 0.5) dz = dz - WORLD;
    else if (dz < WORLD * -0.5) dz = dz + WORLD;

    for (let var k = 1; k <= 7; ++k) {
        let t = k / 8.0;
        if (ground_height(cam_x + dx * t, cam_z + dz * t) > cam_y + dy * t) return false;
    }
    return true;
}

// Draw a line several pixels wide
fun draw_wide_line(x0, y0, x1, y1, width, color) {
    let steep = (y1 - y0).abs() > (x1 - x0).abs();

    for (let var k = 0; k < width; ++k) {
        let off = k.to_f() - (width - 1) * 0.5;
        if (steep) draw_line(x0 + off, y0, x1 + off, y1, color);
        else draw_line(x0, y0 + off, x1, y1 + off, color);
    }
}

// Fill a disc
fun fill_disc(cx, cy, radius, color) {
    let r = radius.max(0.5);
    let y0 = (cy - r).ceil().max(0);
    let y1 = (cy + r).floor().min(FRAME_HEIGHT - 1);

    for (let var y = y0; y <= y1; ++y) {
        let dy = y - cy;
        let half = (r * r - dy * dy).max(0.0).sqrt();
        let x0 = (cx - half).ceil().max(0);
        let x1 = (cx + half).floor().min(FRAME_WIDTH - 1);
        if (x0 <= x1) frame_buffer.fill_u32(y * FRAME_WIDTH + x0, x1 - x0 + 1, color);
    }
}

// Draw the puffs where rounds have hit: a flash, then dust or spray
fun draw_impacts() {
    for (let var i = 0; i < MAX_IMPACTS; ++i) {
        let age = im_age[i];
        if (age < 0.0) continue;

        view_point(im_x[i], im_y[i] + 2.0, im_z[i]);
        if (pt_z < 2.0) continue;
        if (!sight_clear(im_x[i], im_y[i] + 3.0, im_z[i])) continue;

        let var color = 0xFFFFF0A0;
        if (age > 0.06) {
            if (im_y[i] <= 0.0) color = 0xFFE6EEF6; else color = 0xFFB6A488;
        }

        let scale = FOCAL / pt_z;
        let radius = (1.2 + age * 12.0) * scale;
        fill_disc(CX + pt_x * scale, CY - pt_y * scale, radius.min(40.0), color);
    }
}

// Draw the rounds in flight as streaks
fun draw_tracers() {
    for (let var i = 0; i < MAX_ROUNDS; ++i) {
        let age = rd_age[i];
        if (age < 0.0) continue;

        let x = rd_x[i];
        let y = rd_y[i];
        let z = rd_z[i];
        let vx = rd_vx[i];
        let vy = rd_vy[i];
        let vz = rd_vz[i];

        view_point(x, y, z);
        let var hx = pt_x;
        let var hy = pt_y;
        let var hz = pt_z;

        // The streak trails back along the path, but not past the muzzle
        let v_len = (vx * vx + vy * vy + vz * vz).sqrt();
        let back = TRACER_LENGTH.min(age * MUZZLE_SPEED) / v_len;
        view_point(x - vx * back, y - vy * back, z - vz * back);
        let var tx = pt_x;
        let var ty = pt_y;
        let var tz = pt_z;

        // Clip whichever end is behind the camera
        let near = 0.5;
        if (hz < near && tz < near) continue;
        if (tz < near) {
            let t = (near - tz) / (hz - tz);
            tx = tx + (hx - tx) * t;
            ty = ty + (hy - ty) * t;
            tz = near;
        } else if (hz < near) {
            let t = (near - hz) / (tz - hz);
            hx = hx + (tx - hx) * t;
            hy = hy + (ty - hy) * t;
            hz = near;
        }

        if (hz > 60.0 && !sight_clear(x, y, z)) continue;

        let head_x = CX + hx * FOCAL / hz;
        let head_y = CY - hy * FOCAL / hz;
        let tail_x = CX + tx * FOCAL / tz;
        let tail_y = CY - ty * FOCAL / tz;

        // Thicker up close, and brightest at the head
        let width = (FOCAL * 0.3 / hz).floor().clip(1, 4);
        draw_wide_line(tail_x, tail_y, head_x, head_y, width, TRACER_BODY);
        draw_wide_line(lerp(tail_x, head_x, 0.65), lerp(tail_y, head_y, 0.65),
            head_x, head_y, width, TRACER_HEAD);
    }
}

// Advance the whole simulation by one time step
fun update_sim(dt) {
    update_flight(dt);
    update_cannon(dt);
    pull_up = crash_timer <= 0.0 && !stalled && ground_ahead();
}

// Tell the audio actor what it should be playing
fun send_audio() {
    let crashed = crash_timer > 0.0;

    let var power = 0.15 + 0.85 * throttle;
    if (boost_on) power = 1.6;

    let var gun = 0.0;
    if (gun_firing) gun = gun_spin;

    let var gain = 1.0;
    if (crashed) gain = 0.0;

    $actor_send(audio_id, AudioState(power, (speed / 450.0).min(1.0), gun,
        pull_up, crash_count, gain, music_on, false));
}

// Render one frame
fun render_frame() {
    render_world();
    draw_impacts();
    draw_tracers();
    if (crash_timer > 0.0) draw_crash(); else draw_hud();
}

// --- Benchmark ---

// Render a set flight without a window and report the time per frame
fun run_bench(num_frames, shot_dir) {
    let dt = 1.0 / 30.0;
    let var render_ms = 0;
    let var tri_total = 0;

    if (shot_dir != "") $make_dir(shot_dir);

    for (let var frame = 0; frame < num_frames; ++frame) {
        // Weave and porpoise, so that the view rolls and the horizon moves
        let t = frame.to_f() * dt;
        in_roll = (t * 0.7).cos() * 0.4;
        in_pitch = (t * 0.45).sin() * 0.25;
        in_yaw = (t * 0.3).sin() * 0.5;
        hud_time = t;
        in_fire = frame % 60 >= 20 && frame % 60 < 50;
        update_sim(dt);

        let start_ms = $time_current_ms();
        render_frame();
        render_ms = render_ms + ($time_current_ms() - start_ms);
        tri_total = tri_total + tris_drawn;

        if (shot_dir != "" && frame % 30 == 29) {
            // The rasterizer leaves the alpha channel unset
            for (let var i = 0; i < FRAME_WIDTH * FRAME_HEIGHT; ++i) {
                frame_buffer.set_u32(i, frame_buffer.get_u32(i) | 0xFF000000);
            }
            save_tga(shot_dir + "/frame" + frame.to_s().lpad(4, "0") + ".tga", frame_image);
        }
    }

    let ms = render_ms.to_f() / num_frames;
    $println(num_frames.to_s() + " frames, " + ms.format_decimals(2) + " ms/frame ("
        + (1000.0 / ms).format_decimals(1) + " fps), "
        + tri_total.idiv(num_frames).to_s() + " triangles/frame");
}

// --- Main ---

generate_terrain();
build_sky();
reset_flight();

if (BENCH_MODE) {
    let num_frames = $cmd_get_arg_or(2, "120").parse_int(10);
    if (num_frames == nil || num_frames < 1) {
        $println("expected a number of frames");
        $exit(1);
    }

    run_bench(num_frames, $cmd_get_arg_or(3, ""));
    $exit(0);
}

let window = $window_create(FRAME_WIDTH, FRAME_HEIGHT, "Flight Sim", 0);

let var key_pitch_up = false;
let var key_pitch_down = false;
let var key_roll_left = false;
let var key_roll_right = false;
let var key_yaw_left = false;
let var key_yaw_right = false;
let var key_faster = false;
let var key_slower = false;

// The input along one axis from the pair of keys that push it either way
fun key_axis(negative, positive) {
    let var v = 0.0;
    if (positive) v = v + 1.0;
    if (negative) v = v - 1.0;
    return v;
}

// Record a key going down or coming up
fun set_key(key, down) {
    if (key == 'DOWN') key_pitch_up = down;
    else if (key == 'UP') key_pitch_down = down;
    else if (key == 'LEFT') key_roll_left = down;
    else if (key == 'RIGHT') key_roll_right = down;
    else if (key == 'A') key_yaw_left = down;
    else if (key == 'D') key_yaw_right = down;
    else if (key == 'W') key_faster = down;
    else if (key == 'S') key_slower = down;
    else if (key == 'SHIFT') in_boost = down;
    else if (key == 'SPACE') in_fire = down;
}

let start_ms = $time_current_ms();
let var last_ms = start_ms;
let var last_report_ms = last_ms;
let var frame_count = 0;
let var render_ms_total = 0;

loop {
    let now_ms = $time_current_ms();
    let dt = ((now_ms - last_ms).to_f() * 0.001).min(0.1);
    last_ms = now_ms;

    // Handle pending events
    let var quit = false;
    loop {
        let msg = $actor_poll();
        if (msg == nil) break;
        if (!(msg instanceof UIEvent)) continue;

        if (msg.kind == 'CLOSE_WINDOW') {
            quit = true;
        } else if (msg.kind == 'KEY_DOWN') {
            if (msg.key == 'ESCAPE' || msg.key == 'Q') quit = true;
            if (msg.key == 'R') reset_flight();
            if (msg.key == 'M') music_on = !music_on;
            set_key(msg.key, true);
        } else if (msg.kind == 'KEY_UP') {
            set_key(msg.key, false);
        }
    }
    if (quit) break;

    // Controls
    in_pitch = key_axis(key_pitch_down, key_pitch_up);
    in_roll = key_axis(key_roll_left, key_roll_right);
    in_yaw = key_axis(key_yaw_left, key_yaw_right);
    in_throttle = key_axis(key_slower, key_faster);
    hud_time = (now_ms - start_ms).to_f() * 0.001;
    update_sim(dt);
    send_audio();

    let render_start = $time_current_ms();
    render_frame();
    render_ms_total = render_ms_total + ($time_current_ms() - render_start);
    frame_count = frame_count + 1;

    // Report the frame time once a second
    if (now_ms - last_report_ms >= 1000) {
        let ms = render_ms_total.to_f() / frame_count;
        $println("render: " + ms.format_decimals(1) + " ms, "
            + (1000.0 / ms.max(0.001)).format_decimals(1) + " fps, "
            + tris_drawn.to_s() + " triangles, speed " + (speed * 3.6).floor().to_s() + " km/h, altitude "
            + cam_y.floor().to_s() + " m");
        frame_count = 0;
        render_ms_total = 0;
        last_report_ms = now_ms;
    }

    $window_draw_frame(window, frame_buffer);
}

// Shut the audio actor down
$actor_send(audio_id, AudioState(0.0, 0.0, 0.0, false, crash_count, 0.0, false, true));
$actor_join(audio_id);
