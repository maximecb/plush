// --- Letter-to-sound rules ---

// Letter groups and the sounds they usually make, for words that aren't in
// the dictionary. English spelling is nowhere near this regular, but the
// result is usually recognizable. Longer groups are matched first.
let LETTER_RULES = {
    "ation": "ey sh ax n", "ition": "ih sh ax n",
    "tion": "sh ax n", "sion": "zh ax n", "ough": "ao",
    "tch": "ch", "sch": "s k", "igh": "ay", "air": "eh r", "ear": "ih r",
    "ck": "k", "ch": "ch", "sh": "sh", "th": "th", "ph": "f", "wh": "w",
    "gh": "", "ng": "ng", "qu": "k w", "kn": "n", "wr": "r",
    "ee": "iy", "ea": "iy", "oo": "uw", "ou": "aw", "ow": "ow",
    "oi": "oy", "oy": "oy", "ai": "ey", "ay": "ey", "au": "ao", "aw": "ao",
    "oa": "ow", "ie": "iy", "ei": "iy", "ue": "uw", "ew": "uw", "eu": "y uw",
    "ar": "aa r", "or": "ao r", "er": "er", "ir": "er", "ur": "er",
    "a": "ae", "b": "b", "c": "k", "d": "d", "e": "eh", "f": "f", "g": "g",
    "h": "hh", "i": "ih", "j": "jh", "k": "k", "l": "l", "m": "m", "n": "n",
    "o": "aa", "p": "p", "q": "k", "r": "r", "s": "s", "t": "t", "u": "ah",
    "v": "v", "w": "w", "x": "k s", "y": "y", "z": "z",
};

// A vowel followed by a consonant and a silent "e" is long: "make", "time"
let LONG_VOWELS = { "a": "ey", "e": "iy", "i": "ay", "o": "ow", "u": "uw" };

fun is_vowel(c)
{
    return c == "a" || c == "e" || c == "i" || c == "o" || c == "u";
}

fun join_chars(chars, start, count)
{
    let var s = "";
    for (let var i = 0; i < count; ++i)
        s = s + chars[start + i];
    return s;
}

fun ends_with(s, suffix)
{
    if (suffix.len > s.len)
        return false;
    let var i = 0;
    while (i < suffix.len) {
        if (s.byte_at(s.len - suffix.len + i) != suffix.byte_at(i))
            return false;
        ++i;
    }
    return true;
}

fun drop_last(s, count)
{
    let var r = "";
    for (let var i = 0; i < s.len - count; ++i)
        r = r + s.char_at(i);
    return r;
}

// Sound out a word one letter group at a time
fun spell(word)
{
    let chars = [];
    for (let var i = 0; i < word.len; ++i) {
        let c = word.char_at(i);
        // char_at returns nil in the middle of a multi-byte character
        if (c != nil && c != "'")
            chars.push(c);
    }

    let n = chars.len;
    if (n == 0)
        return "";

    // A final "e" is usually silent
    let var limit = n;
    if (n >= 3 && chars[n - 1] == "e" && !is_vowel(chars[n - 2]))
        limit = n - 1;
    let silent_e = limit < n;

    let out = [];
    let var i = 0;

    while (i < limit) {
        let c = chars[i];

        // Doubled consonants are pronounced once
        if (i + 1 < limit && c == chars[i + 1] && !is_vowel(c)) {
            ++i;
            continue;
        }

        // The silent "e" lengthens the vowel two letters back
        if (silent_e && i + 2 == limit && LONG_VOWELS.has(c)) {
            out.push(LONG_VOWELS[c]);
            ++i;
            continue;
        }

        // The "e" of a final "ed" is silent, except after "t" or "d"
        if (c == "e" && i + 2 == limit && chars[i + 1] == "d" && i > 0 &&
            chars[i - 1] != "t" && chars[i - 1] != "d") {
            out.push("d");
            i = i + 2;
            continue;
        }

        // Soft "c" before a front vowel, soft "g" before a silent "e"
        if (c == "c" && i + 1 < n &&
            (chars[i + 1] == "e" || chars[i + 1] == "i" || chars[i + 1] == "y")) {
            out.push("s");
            ++i;
            continue;
        }
        if (c == "g" && silent_e && i + 1 == limit) {
            out.push("jh");
            ++i;
            continue;
        }

        // Only a leading "y" is a consonant: "happy", "system"
        if (c == "y" && i > 0) {
            if (i + 1 == limit)
                out.push("iy");
            else
                out.push("ih");
            ++i;
            continue;
        }

        let var matched = false;
        for (let var k = 5; k >= 1; --k) {
            if (i + k > limit)
                continue;

            let key = join_chars(chars, i, k);
            if (LETTER_RULES.has(key)) {
                if (LETTER_RULES[key] != "")
                    out.push(LETTER_RULES[key]);
                i = i + k;
                matched = true;
                break;
            }
        }

        // Skip anything the rules don't cover
        if (!matched)
            ++i;
    }

    let var s = "";
    for (let var j = 0; j < out.len; ++j) {
        if (j > 0)
            s = s + " ";
        s = s + out[j];
    }
    return s;
}

// Add a plural or possessive ending, which takes its voicing from the
// sound before it: "cats", "dogs", "boxes"
fun add_s(phonemes)
{
    let parts = phonemes.split(" ");
    let last = parts[parts.len - 1];

    if (last == "s" || last == "z" || last == "sh" || last == "zh" ||
        last == "ch" || last == "jh")
        return phonemes + " ih z";

    if (last == "p" || last == "t" || last == "k" || last == "f" || last == "th")
        return phonemes + " s";

    return phonemes + " z";
}

fun word_phonemes(word)
{
    if (WORDS.has(word))
        return WORDS[word];

    // Numbers are read out digit by digit
    if (DIGITS.has(word.char_at(0))) {
        let var s = "";
        for (let var i = 0; i < word.len; ++i) {
            let c = word.char_at(i);
            if (!DIGITS.has(c))
                continue;
            if (s != "")
                s = s + " ";
            s = s + DIGITS[c];
        }
        return s;
    }

    // Possessives and plurals of known words
    if (ends_with(word, "'s") || ends_with(word, "s'")) {
        let base = drop_last(word, 2);
        if (WORDS.has(base))
            return add_s(WORDS[base]);
    }
    if (ends_with(word, "s")) {
        let base = drop_last(word, 1);
        if (WORDS.has(base))
            return add_s(WORDS[base]);
    }

    return spell(word);
}

// --- Text parsing ---

// Split text into word tokens and the pause markers "," and "."
fun tokenize(text)
{
    let s = text.lower();
    let toks = [];
    let var word = "";

    for (let var i = 0; i < s.len; ++i) {
        let b = s.byte_at(i);

        // Letters, digits and apostrophes build up the current word
        if ((b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 39) {
            word = word + s.char_at(i);
            continue;
        }

        // A typographic right single quote is an apostrophe too
        if (b == 0xE2 && i + 2 < s.len && s.byte_at(i + 1) == 0x80 && s.byte_at(i + 2) == 0x99) {
            word = word + "'";
            i = i + 2;
            continue;
        }

        if (word != "") {
            toks.push(word);
            word = "";
        }

        // Commas break up a sentence, the other marks end one. Question and
        // exclamation marks get no intonation of their own, just the pause.
        if (b == 44 || b == 59 || b == 58)
            toks.push(",");
        else if (b == 46 || b == 63 || b == 33)
            toks.push(".");
    }

    if (word != "")
        toks.push(word);

    return toks;
}

fun is_pause(tok)
{
    return tok == "," || tok == ".";
}

fun text_to_phonemes(text)
{
    let toks = tokenize(text);
    let parts = [];

    for (let var i = 0; i < toks.len; ++i) {
        let tok = toks[i];

        if (is_pause(tok)) {
            // Nothing to pause between yet
            if (parts.len == 0)
                continue;

            // Collapse runs of punctuation, keeping the longest pause
            let last = parts[parts.len - 1];
            if (is_pause(last)) {
                if (tok == ".")
                    parts[parts.len - 1] = ".";
                continue;
            }

            parts.push(tok);
            continue;
        }

        let ph = word_phonemes(tok);
        if (ph == "")
            continue;

        // Words are separated by a short pause, clauses by their own marker
        if (parts.len > 0 && !is_pause(parts[parts.len - 1]))
            parts.push("_");

        parts.push(ph);
    }

    let var s = "";
    for (let var i = 0; i < parts.len; ++i) {
        if (i > 0)
            s = s + " ";
        s = s + parts[i];
    }
    return s;
}

// --- Utterance building ---

// Expand a space-separated phoneme string into a flat list of targets
fun build_segments(phoneme_str)
{
    let names = phoneme_str.trim().split(" ");
    let segs = [];

    for (let var i = 0; i < names.len; ++i) {
        let name = names[i].trim();
        if (name == "")
            continue;

        if (!PHONEMES.has(name)) {
            $println("unknown phoneme: " + name);
            continue;
        }

        let parts = PHONEMES[name];
        for (let var j = 0; j < parts.len; ++j) {
            let s = copy_seg(parts[j]);
            s.follow = parts[j].follow;
            segs.push(s);
        }
    }

    // Ramp down at the end so a vowel-final utterance doesn't click
    if (segs.len > 0)
        segs.push(copy_seg(gap(30, 0.0)));

    // Resolve anticipatory segments to the formants of what follows them
    for (let var i = 0; i < segs.len; ++i) {
        if (segs[i].follow && i + 1 < segs.len) {
            segs[i].f1 = segs[i + 1].f1;
            segs[i].f2 = segs[i + 1].f2;
            segs[i].f3 = segs[i + 1].f3;
        }
    }

    return segs;
}

fun ms_to_samples(ms)
{
    return (ms.to_f() * SAMPLE_RATE.to_f() / 1000.0).floor();
}

fun lerp(a, b, t)
{
    return a + (b - a) * t;
}

// --- Synthesis ---

fun render(segs)
{
    let var total = 0;
    for (let var i = 0; i < segs.len; ++i)
        total = total + ms_to_samples(segs[i].dur);

    let out = ByteArray.with_size(total * 4);

    let glottis = Glottis();
    let r1 = Reson();
    let r2 = Reson();
    let r3 = Reson();
    let r4 = Reson();
    let r5 = Reson();
    r4.set_coeffs(F4, 250.0);
    r5.set_coeffs(F5, 300.0);

    // The previous target, used as the starting point for each transition
    let var prev = gap(0, 0.0);

    let var out_idx = 0;
    let var peak = 0.0;

    for (let var si = 0; si < segs.len; ++si) {
        let s = segs[si];
        let n = ms_to_samples(s.dur);

        for (let var i = 0; i < n; ++i) {
            // Smoothstep from the previous target over the blend fraction
            let p = i.to_f() / n.to_f();
            let var t = 1.0;
            if (s.blend > 0.0 && p < s.blend) {
                let u = p / s.blend;
                t = u * u * (3.0 - 2.0 * u);
            }

            if (i % CONTROL_PERIOD == 0) {
                r1.set_coeffs(lerp(prev.f1, s.f1, t), lerp(prev.b1, s.b1, t));
                r2.set_coeffs(lerp(prev.f2, s.f2, t), lerp(prev.b2, s.b2, t));
                r3.set_coeffs(lerp(prev.f3, s.f3, t), lerp(prev.b3, s.b3, t));
            }

            let av = lerp(prev.av, s.av, t);
            let af = lerp(prev.af, s.af, t);
            let a1 = lerp(prev.a1, s.a1, t);
            let a2 = lerp(prev.a2, s.a2, t);
            let a3 = lerp(prev.a3, s.a3, t);

            // Pitch falls gradually across the utterance
            let progress = out_idx.to_f() / total.to_f();
            let f0 = F0_BASE * (1.0 - F0_DECLINE * progress);

            let src = av * glottis.update(f0) + af * noise();

            // Alternating signs keep adjacent formants from cancelling
            let sample = a1 * r1.update(src) - a2 * r2.update(src) + a3 * r3.update(src)
                       - A4 * r4.update(src) + A5 * r5.update(src);

            out.set_f32(out_idx, sample);
            ++out_idx;

            let mag = sample.abs();
            if (mag > peak)
                peak = mag;
        }

        prev = s;
    }

    // Normalize
    if (peak > 0.0) {
        let gain = 0.85 / peak;
        for (let var i = 0; i < total; ++i)
            out.set_f32(i, out.get_f32(i) * gain);
    }

    return out;
}

// --- WAV output ---

fun write_wav(path, samples)
{
    let num_samples = samples.len.idiv(4);
    let data_size = num_samples * 2;
    let buf = ByteArray.with_size(44 + data_size);

    buf.store_u32(0, 0x46464952);            // "RIFF"
    buf.store_u32(4, 36 + data_size);
    buf.store_u32(8, 0x45564157);            // "WAVE"
    buf.store_u32(12, 0x20746D66);           // "fmt "
    buf.store_u32(16, 16);
    buf.store_u16(20, 1);                    // PCM
    buf.store_u16(22, 1);                    // mono
    buf.store_u32(24, SAMPLE_RATE);
    buf.store_u32(28, SAMPLE_RATE * 2);      // byte rate
    buf.store_u16(32, 2);                    // block align
    buf.store_u16(34, 16);                   // bits per sample
    buf.store_u32(36, 0x61746164);           // "data"
    buf.store_u32(40, data_size);

    for (let var i = 0; i < num_samples; ++i) {
        let v = (samples.get_f32(i).clip(-1.0, 1.0) * 32767.0).floor();
        buf.store_u16(44 + i * 2, v & 0xFFFF);
    }

    $write_file(path, buf);
}

// --- Demo ---

let DEFAULT_TEXT =
    "Hello world. I'm very happy to see that you are trying out the Plush " +
    "language. If you run into any issue or want to request new features, " +
    "please open an issue on GitHub.";

fun main()
{
    let text = $cmd_get_arg_or(1, DEFAULT_TEXT);
    let out_path = $cmd_get_arg_or(2, nil);

    let phonemes = text_to_phonemes(text);
    $println("Text: " + text);
    $println("Phonemes: " + phonemes);

    let segs = build_segments(phonemes);
    if (segs.len == 0) {
        $println("nothing to say");
        return;
    }

    let t0 = $time_current_ms();
    let samples = render(segs);
    let gen_ms = $time_current_ms() - t0;

    let num_samples = samples.len.idiv(4);
    let duration_ms = (num_samples * 1000).idiv(SAMPLE_RATE);

    // Ratio kept in tenths so it can be printed without float formatting
    let ratio = (duration_ms * 10).idiv(gen_ms.max(1));
    $println(
        "Generated " + duration_ms.to_s() + "ms of audio in " + gen_ms.to_s() + "ms " +
        "(" + (ratio.idiv(10)).to_s() + "." + (ratio % 10).to_s() + "x realtime)"
    );

    if (out_path != nil) {
        write_wav(out_path, samples);
        $println("wrote " + out_path);
        return;
    }

    let dev = $audio_open_output(SAMPLE_RATE, 1);
    if (dev == nil) {
        $println("could not open audio device");
        return;
    }

    $audio_write_samples(dev, samples);
    $actor_sleep(duration_ms + 200);
}

main();
