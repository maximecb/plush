// A-Life Islands, an artificial life experiment
//
// Agents with small recurrent neural nets live on a grid world, foraging for
// plants and water. Nothing scores them: an agent that fails to feed runs out
// of energy and dies, and one that banks enough energy can choose to
// reproduce. Foraging is selected for only because the alternative is
// extinction, so there is no fitness function anywhere in this file.
//
// Agents are coloured by projecting their genome onto two fixed random
// vectors and taking the angle as a hue, so related agents share a colour and
// you can watch lineages spread across the world.
//
// Inspired by Gradient (2011), https://github.com/maximecb/Gradient
//
// Controls:
//   drag / arrows   pan
//   Z / X           zoom out / in
//   SPACE           pause
//   F               fast mode, simulate hard and draw rarely
//   S               save the population
//
// Quitting is the window's close button, and no key discards a population: a
// run that has been evolving for an hour should not be one keystroke from
// gone.
//
// Options:
//   --islands N        islands in the ring, laid out as a grid (default 4)
//   --width / --height window size in pixels
//   --seed N           repeat a particular world
//   --headless --ticks N   evolve without a window, for long runs
//   --plants N, --seed-hatch N, --gate-period N, --gate-crossings N
//
// For long evolution runs, skip the window entirely:
//   plush examples/alife_islands.psh --headless --ticks 1000000

from random import Xoshiro128;

// --- Command line ---

fun has_flag(name) {
    for (let var i = 0; i < $cmd_num_args(); ++i) {
        if ($cmd_get_arg(i) == name)
            return true;
    }
    return false;
}

fun flag_int(name, default) {
    for (let var i = 0; i < $cmd_num_args() - 1; ++i) {
        if ($cmd_get_arg(i) == name) {
            let v = $cmd_get_arg(i + 1).parse_int(10);
            if (v != nil)
                return v;
        }
    }
    return default;
}

let HEADLESS = has_flag("--headless");
let MAX_TICKS = flag_int("--ticks", 0);
// A fresh world every run, since a fixed seed makes every run the same run:
// the same founder wins and the population comes out the same colour. The
// seed is printed so that a run worth keeping can be repeated with --seed
let WORLD_SEED = flag_int("--seed", $time_current_ms());

// --- Islands ---
//
// Each island is a world of its own, run by its own actor, and they are
// joined in a ring by gates. Evolution is the part of this that parallelises
// perfectly: the islands share nothing, so the throughput is the core count,
// and long stretches of isolation let each one find its own local answer
// before a handful of migrants carry it next door.
//
// They are laid out side by side in one coordinate space, so the camera pans
// across the whole ring as if it were a single world. Each island already
// carries a two-cell wall border, so neighbours in the layout are separated
// by four cells of wall without anything extra being drawn
let NUM_ISLANDS = flag_int("--islands", 4);

// Ticks a gate stays shut, and how many may cross before it shuts again.
// The gate is an opening in the wall that reads as ordinary ground, so
// somebody wanders through it sooner or later without needing to be lured
let GATE_PERIOD = flag_int("--gate-period", 300_000);
let GATE_CROSSINGS = flag_int("--gate-crossings", 20);
let GATE_WIDTH = 3;

// --- Display ---

let PANEL_W = 190;

// Floors chosen so the stats panel still has a view left beside it, rather
// than the world being squeezed out of existence by a stray argument
let FRAME_WIDTH = flag_int("--width", 1024).max(PANEL_W + 200);
let FRAME_HEIGHT = flag_int("--height", 768).max(240);
let VIEW_W = FRAME_WIDTH - PANEL_W;

// Zoom is in pixels per cell. The floor is not 1 because a whole screen of
// single-pixel cells costs one host call each and outruns the frame budget
let ZOOM_LEVELS = [1, 2, 3, 4, 6, 8, 12, 16];

let DRAW_PERIOD_MS = 33;

// Slow mode is paced in wall clock time, not in frames, so that an agent
// takes a couple of actions a second and you can actually follow what it is
// doing. Fast mode is the one that runs flat out
let SLOW_TICK_MS = 200;
// How often the renderer asks the islands for a fresh picture. Well under
// the frame rate, since a snapshot copies a grid per island and the world
// does not change fast enough at a distance to be worth more
let SNAP_PERIOD_MS = 100;

// --- World ---

let WORLD_W = 128;
let WORLD_H = 128;

// A two-cell wall border means the view never needs a bounds check, and a
// read past the edge comes back as wall, which is what an island edge is
let BORDER = 2;
let GRID_W = WORLD_W + 2 * BORDER;
let GRID_H = WORLD_H + 2 * BORDER;

// The islands tiled into one rectangle, as square as the count allows, and
// the combined coordinate space the camera moves over
fun isqrt_ceil(n) {
    let var r = 1;
    while (r * r < n)
        r = r + 1;
    return r;
}

let TILE_COLS = isqrt_ceil(NUM_ISLANDS);
let TILE_ROWS = (NUM_ISLANDS + TILE_COLS - 1).idiv(TILE_COLS);

// Neighbours are laid down overlapping by one border, so the wall between
// two islands is BORDER cells rather than twice that. Both islands draw wall
// on those cells, so the overlap is invisible, and each island keeps the
// full two-cell border its sensing depends on: the view reaches two cells
// ahead, and that border is what lets it skip bounds checks altogether
let TILE_STEP_X = GRID_W - BORDER;
let TILE_STEP_Y = GRID_H - BORDER;
let WORLD_CELLS_W = TILE_COLS * TILE_STEP_X + BORDER;
let WORLD_CELLS_H = TILE_ROWS * TILE_STEP_Y + BORDER;

// Opens on the whole ring, whatever its size, so a bigger island count is
// still something you can take in at a glance before zooming in
fun fit_zoom() {
    let var best = 0;

    for (let var i = 0; i < ZOOM_LEVELS.len; ++i) {
        let z = ZOOM_LEVELS[i];
        if (WORLD_CELLS_W * z <= VIEW_W && WORLD_CELLS_H * z <= FRAME_HEIGHT)
            best = i;
    }

    return best;
}

let DEFAULT_ZOOM = fit_zoom();

// A grid cell is the terrain type in the low byte and the occupying agent's
// slot, plus one, above it. One read answers both questions
let CELL_ROCK = 0;
let CELL_WALL = 1;
let CELL_WATER = 2;
let CELL_PLANT = 3;
let CELL_SEED = 4;
let CELL_CORPSE = 5;
let CELL_EMPTY = 7;

// Plant flux is what sets the population. See MAX_POP for the arithmetic,
// which gives an upper bound: measured, the population lands about 20% under
// it, because agents carrying something pay CARRY_COST on top of living and
// because a few plants always sit around waiting to be found
// Terrain is grown rather than sprinkled, the way the original Gradient did
// it. Scattering single cells at random gives a world with no shape: ponds
// with no banks, and a plant density so even that the scent field comes out
// nearly flat and there is no gradient left to climb
let WATER_SEED_PROB = 0.0012;
let WATER_PASSES = 23;

// An empty cell with plants beside it is far likelier to become a plant than
// one on its own, which is what turns scattered seeds into patches
let PLANT_SEED_PROB = 0.003;
let PLANT_SPREAD = 0.04;
let PLANT_PASSES = 11;

// Rock ridges, drawn as straight runs rather than confetti, which is what
// gives the world corridors and dead ends. These are rock, not wall, so they
// can be quarried and rebuilt by whoever wants to
let RIDGE_MEAN = 10;
let RIDGE_SD = 1;
let RIDGE_MIN_LEN = 5;

// Eating a plant leaves its seed behind, and the seed grows back into a
// plant. Nothing in the world creates or destroys a plant, so the food
// supply is fixed and farming is about moving seeds somewhere better rather
// than making more of them. Picking a seed up restarts its clock
// This is the knob that sets how much food the world can supply: with the
// plant count fixed, at most one plant per seed per hatch time can ever be
// eaten, so the whole population lives inside that rate
let SEED_HATCH = flag_int("--seed-hatch", 2400);

// The seed list is walked in full rather than in hatching order, so it is
// walked every few ticks instead of every tick. Measured, the walk costs
// under 1% either way; this is headroom for a bigger world, and a seed
// sprouting a few ticks late is nothing against a hatch time in the thousands
let SEED_PERIOD = 8;
let CORPSE_DECAY = 900;     // Ticks before an uneaten corpse disappears

// --- Agent senses ---
//
// The first three groups are sparse and are cleared by one fill_u32 per tick.
// Everything after them is overwritten every tick anyway, and the bias sits
// past the cleared region so it is written once and never again
let VIEW_BASE = 0;     // 8 cells x 7 one-hot channels, empty is all-zeros
let KIN_BASE = 56;     // Genetic tag of the agent directly ahead
let CARRY_BASE = 58;   // Carried item, one-hot, nothing set when empty
let SPARSE_LEN = 62;
let SCENT_BASE = 62;   // Per channel: level, forward gradient, side gradient
let BODY_BASE = 71;    // Food, water, energy
let AGE_IDX = 74;

// Noise, which the original Gradient also fed its agents. Without it a fresh
// random brain picks the same action on every tick and simply freezes: argmax
// over a recurrent net settles on one output and stays there. A few noise
// inputs are what make an untrained agent wander instead, which is the only
// way the first lineage ever stumbles onto food
let RND_BASE = 75;
let NUM_RND = 4;

let BIAS_IDX = 79;
let NUM_SENSORS = 80;

let NUM_CHANNELS = 7;  // rock, wall, water, plant, seed, corpse, agent
let CHAN_AGENT = 6;

// --- Brain ---

let NUM_HIDDEN = 16;
let NUM_ACTIONS = 8;
let NUM_INPUTS = NUM_SENSORS + NUM_HIDDEN;
let NUM_WEIGHTS = NUM_HIDDEN * NUM_INPUTS + NUM_ACTIONS * NUM_HIDDEN;
let ACT_BASE = NUM_HIDDEN * NUM_INPUTS;

// ReLU, clamped so the recurrent loop cannot run away. Unlike a saturating
// activation it stays graded in its active range instead of pinning to +-1
let ACT_CAP = 8.0;

let ACT_NOOP = 0;
let ACT_FORWARD = 1;
let ACT_LEFT = 2;
let ACT_RIGHT = 3;
let ACT_EAT = 4;
let ACT_PICK_UP = 5;
let ACT_DROP = 6;
let ACT_REPRODUCE = 7;

// Attacking is not an action of its own: EAT strikes whatever agent is in
// front and otherwise consumes what is there. An agent can only ever stand
// on bare ground or a seed, neither of which EAT does anything with, so the
// two cases can never be the same cell and there is nothing to disambiguate.
//
// Folding it in keeps the action count at eight. A ninth action would dilute
// every useful one by a ninth, and the first lineage that can feed itself is
// found by chance, so that rate is exactly what bootstrap depends on. It
// also makes the loop tight: strike, strike, strike, and the carcass is now
// the thing in front of you, taken with the same action.
//
// The cost is that predation comes for free with foraging rather than having
// to be discovered, and offspring appear right beside their parent, so a
// lineage that eats whatever is ahead of it eats its own young until
// selection or the kin tag input teaches it otherwise
let ATTACK_COST = 5.0;
let ATTACK_DAMAGE = 50.0;

let ITEM_NONE = 0;
let ITEM_ROCK = 1;
let ITEM_SEED = 2;
let ITEM_CORPSE = 3;

// --- Scent ---
//
// Kept at a quarter resolution and padded by one cell, so a sample one step
// off the agent's coarse cell never needs clamping. Close range is already
// covered by the eight-cell view, so this only has to carry the long-range
// gradient that makes foraging one mutation away from random
let SCENT_PLANT = 0;
let SCENT_WATER = 1;
let SCENT_CORPSE = 2;
let NUM_SCENTS = 3;

let SCENT_SHIFT = 2;
let SCENT_W = (GRID_W >> SCENT_SHIFT) + 2;
let SCENT_H = (GRID_H >> SCENT_SHIFT) + 2;
let SCENT_PLANE = SCENT_W * SCENT_H;

// Decay sets how far the field carries: the gradient reaches roughly
// sqrt(spread / (1 - decay)) coarse cells, so 0.995 is worth about 25 fine
// cells while 0.9 would be worth 6, which is barely past the agent's own
// eyes and would leave the field doing no work at all. The source is then
// scaled so a typical cell sits near the middle of the squash rather than
// pinned at the top, where differences stop being visible
let SCENT_PERIOD = 8;      // Ticks between diffusion passes
let SCENT_SPREAD = 0.20;   // Share of a cell handed to each neighbour
let SCENT_DECAY = 0.995;
let SCENT_SOURCE = 0.0025; // Injected per source cell per pass

// --- Metabolism ---
//
// Food and water are burned a little at a time rather than banked all at
// once, so that hunger and thirst are states an agent can sense and act on

// Reserves are set so that a single successful meal is enough to pay for one
// offspring, the way the original balanced it. Requiring a whole foraging
// career instead makes the first lineage vanishingly unlikely to appear.
// Water starts high so that food is the thing an agent has to go and find
let START_FOOD = 150.0;
let START_WATER = 800.0;
let START_ENERGY = 150.0;
let MAX_FOOD = 2000.0;
let MAX_WATER = 1000.0;
let MAX_ENERGY = 2500.0;

let FOOD_PER_PLANT = 250.0;

// A corpse is worth whatever the agent still had, plus its body. That makes
// carcasses genuinely rich, since an agent that dies of thirst or old age
// dies with a full stomach, without the world inventing the food: an agent
// dies with no energy left, so a flat corpse value is energy created out of
// nothing, and deaths then feed births which feed deaths. At a flat 200 that
// loop was enough to live on and the population never left MIN_POP in 900k
// ticks, because nothing was pushing anyone to learn to forage
let CORPSE_BODY_FOOD = 60.0;
let WATER_PER_DRINK = 250.0;

let METAB_RATE = 1.0;
let ENERGY_PER_UNIT = 2.0;
let LIVING_COST = 1.0;
let CARRY_COST = 0.25;

// Above what a full set of starting reserves can ever buy, so an agent that
// never eats cannot reproduce and the pressure to forage is real
// Exactly what a newborn is endowed with: START_ENERGY, plus START_FOOD at
// ENERGY_PER_UNIT once it is metabolised. Matching the two makes a birth move
// energy around instead of creating it, which is what makes the population
// ceiling below hold. A non-eating agent still tops out at 300, well under
// this, so an agent that never finds food can never reproduce
let REPRO_COST = START_ENERGY + START_FOOD * ENERGY_PER_UNIT;
let MAX_AGE = 20_000;

// --- Evolution ---

// How many random agents the world is kept topped up to until it can
// sustain itself. This is the bootstrap lottery: the first lineage that can
// forage has to be stumbled on by chance, so the rate of fresh genomes is
// the rate at which tickets are drawn
let MIN_POP = 25;
// Not a balance knob: the population is meant to be limited by food, not by
// this. With births costing exactly what a newborn is endowed with, the
// energy the world supplies per tick is the plant flux, and every agent
// burns LIVING_COST per tick, so the population settles at
//
//   (total_plants / SEED_HATCH) * FOOD_PER_PLANT * ENERGY_PER_UNIT / LIVING_COST
//
// which is about 300, independent of how many plants an agent eats in its
// life. This ceiling only exists so that a runaway cannot exhaust memory
let MAX_POP = 5000;
let MUT_RATE = 0.02;
let MUT_SIGMA = 0.15;
let MUT_RESET_PROB = 0.1;

let SAVE_PREFIX = "alife_pop_";
let SAVE_MAGIC = 0x464C4150;
let SAVE_VERSION = 1;

// --- Directions ---

let DIR_UP = 0;
let DIR_RIGHT = 1;
let DIR_DOWN = 2;
let DIR_LEFT = 3;

let FRONT_X = [0, 1, 0, -1];
let FRONT_Y = [-1, 0, 1, 0];
let SIDE_X = [1, 0, -1, 0];
let SIDE_Y = [0, 1, 0, -1];

// The 3x3 block reaching two cells forward, less the agent's own cell.
// Directly ahead comes first, so the kin lookup does not have to search
let VIEW_SIDE = [0, -1, 1, -1, 1, -1, 0, 1];
let VIEW_FWD = [1, 0, 0, 1, 1, 2, 2, 2];

fun build_view_offsets() {
    let offs = Array.with_size(4 * 8, 0);

    for (let var dir = 0; dir < 4; ++dir) {
        for (let var i = 0; i < 8; ++i) {
            let sx = VIEW_SIDE[i];
            let fy = VIEW_FWD[i];
            let dx = FRONT_X[dir] * fy + SIDE_X[dir] * sx;
            let dy = FRONT_Y[dir] * fy + SIDE_Y[dir] * sx;
            offs[dir * 8 + i] = dy * GRID_W + dx;
        }
    }

    return offs;
}

let VIEW_OFFS = build_view_offsets();

// Ground with nothing standing on it. Eaten ground counts, since the plant
// that was there is gone until it grows back
fun is_bare(terrain) {
    return terrain == CELL_EMPTY;
}

// Only bare ground and loose seeds can be walked into
fun is_passable(terrain) {
    return is_bare(terrain) || terrain == CELL_SEED;
}

// --- Math helpers ---

fun rgb32(r, g, b) {
    return 0xFF000000 | (r << 16) | (g << 8) | b;
}

fun atan2(y, x) {
    if (x > 0.0)
        return (y / x).atan();
    if (x < 0.0) {
        if (y >= 0.0)
            return (y / x).atan() + 3.14159265358979;
        return (y / x).atan() - 3.14159265358979;
    }
    if (y > 0.0)
        return 1.5707963267949;
    if (y < 0.0)
        return -1.5707963267949;
    return 0.0;
}

// Hue in [0, 1), saturation and value in [0, 1]
fun hsv_to_rgb(h, s, v) {
    let i = (h * 6.0).floor();
    let f = h * 6.0 - i.to_f();
    let p = v * (1.0 - s);
    let q = v * (1.0 - s * f);
    let t = v * (1.0 - s * (1.0 - f));

    let var r = v;
    let var g = t;
    let var b = p;

    let sector = i % 6;
    if (sector == 1) { r = q; g = v; b = p; }
    else if (sector == 2) { r = p; g = v; b = t; }
    else if (sector == 3) { r = p; g = q; b = v; }
    else if (sector == 4) { r = t; g = p; b = v; }
    else if (sector == 5) { r = v; g = p; b = q; }

    return rgb32(
        (r * 255.0).floor().clip(0, 255),
        (g * 255.0).floor().clip(0, 255),
        (b * 255.0).floor().clip(0, 255)
    );
}

// --- Genomes ---
//
// A genome is one flat run of f32: the hidden rows first, each NUM_INPUTS
// long, then the action rows, each NUM_HIDDEN long. Keeping it flat is what
// makes mutation, the colour projection and, later, sending an agent to
// another island all trivial, and it is what dot_f32 wants to read

// Scaled by the fan-in, which keeps a unit's pre-activation near unit
// variance instead of pinning it to the clamp on the very first tick
let W_SCALE = 1.0 / NUM_INPUTS.to_f().sqrt();

class Gauss
{
    init(self, rng)
    {
        self.rng = rng;
        self.spare = 0.0;
        self.has_spare = false;
    }

    // Box-Muller, which produces two values at a time
    next(self)
    {
        if (self.has_spare) {
            self.has_spare = false;
            return self.spare;
        }

        let u1 = self.rng.float(1.0e-9, 1.0);
        let u2 = self.rng.float(0.0, 1.0);
        let mag = (-2.0 * u1.ln()).sqrt();
        let theta = 6.28318530717959 * u2;

        self.spare = mag * theta.sin();
        self.has_spare = true;
        return mag * theta.cos();
    }
}

fun new_genome(rng) {
    let g = ByteArray.with_size(NUM_WEIGHTS * 4);

    for (let var i = 0; i < NUM_WEIGHTS; ++i)
        g.set_f32(i, rng.float(-W_SCALE, W_SCALE));

    return g;
}

// Gaussian perturbation of a handful of weights, which is what lets a nearly
// right behaviour be nudged into a right one. Drawing the count up front
// instead of rolling against every weight saves a few thousand rng calls
fun mutate_genome(rng, gauss, src) {
    let g = ByteArray.with_size(NUM_WEIGHTS * 4);
    g.memcpy(0, src, 0, NUM_WEIGHTS * 4);

    let num_mut = (NUM_WEIGHTS.to_f() * MUT_RATE).floor().max(1);

    for (let var i = 0; i < num_mut; ++i) {
        let idx = rng.index(NUM_WEIGHTS);

        // Most mutations nudge, a few redraw, which is how a lineage gets out
        // of a corner that nudging alone cannot leave
        if (rng.float(0.0, 1.0) < MUT_RESET_PROB)
            g.set_f32(idx, rng.float(-W_SCALE, W_SCALE));
        else
            g.set_f32(idx, g.get_f32(idx) + gauss.next() * MUT_SIGMA);
    }

    return g;
}

// Two fixed random vectors, built from a constant seed so that a genome gets
// the same colour in every run and on every island
fun build_projection() {
    let prng = Xoshiro128(0x5EED);
    let p = ByteArray.with_size(2 * NUM_WEIGHTS * 4);

    for (let var i = 0; i < 2 * NUM_WEIGHTS; ++i)
        p.set_f32(i, prng.float(-1.0, 1.0));

    return p;
}

let PROJ = build_projection();

// The angle of a genome's 2D projection, taken as a hue. An angle needs no
// normalising, which is why this is a hue and not an RGB triple: a random
// projection of a high dimensional vector concentrates around its mean, and
// mapping that straight to RGB would make every agent the same muddy brown
fun genome_tags(genome) {
    let p1 = PROJ.dot_f32(0, 1, genome, 0, 1, NUM_WEIGHTS);
    let p2 = PROJ.dot_f32(NUM_WEIGHTS, 1, genome, 0, 1, NUM_WEIGHTS);

    let hue = (atan2(p2, p1) / 6.28318530717959) + 0.5;
    let color = hsv_to_rgb(hue.clip(0.0, 0.9999), 0.85, 0.95);

    // Squashed into -1..1 for the neighbour who senses them
    return [color, p1 / (1.0 + p1.abs()), p2 / (1.0 + p2.abs())];
}

// --- Agents ---

class Agent
{
    init(self, genome, slot, x, y, dir)
    {
        self.genome = genome;
        self.slot = slot;
        self.x = x;
        self.y = y;
        self.dir = dir;

        self.food = START_FOOD;
        self.water = START_WATER;
        self.energy = START_ENERGY;
        self.carried = ITEM_NONE;
        self.carried_food = 0.0;
        self.carried_due = 0;
        self.hit_tick = -1;
        self.emigrated = false;
        self.age = 0;
        self.alive = true;

        let inputs = ByteArray.with_size(NUM_INPUTS * 4);
        inputs.set_f32(BIAS_IDX, 1.0);
        self.inputs = inputs;
        self.hidden = ByteArray.with_size(NUM_HIDDEN * 4);

        let tags = genome_tags(genome);
        self.color = tags[0];
        self.tag1 = tags[1];
        self.tag2 = tags[2];
    }

    // Reads the world into the input vector. Only the entries that are not
    // zero get written, which is what makes the one-hot view cheap
    sense(self, island)
    {
        let inputs = self.inputs;
        let g = island.grid;
        let slots = island.slots;

        inputs.fill_u32(0, SPARSE_LEN, 0);

        let pos = self.y * GRID_W + self.x;
        let offs = VIEW_OFFS;
        let base = self.dir * 8;

        for (let var i = 0; i < 8; ++i) {
            let cell = g.get_u32(pos + offs[base + i]);
            let terrain = cell & 0xFF;

            // Bare ground of either kind sets no bit, and the test is
            // against the agent channel so a terrain past it cannot collide
            if (terrain < CHAN_AGENT)
                inputs.set_f32(i * NUM_CHANNELS + terrain, 1.0);

            let slot = cell >> 8;
            if (slot != 0) {
                inputs.set_f32(i * NUM_CHANNELS + CHAN_AGENT, 1.0);

                // Whoever is directly ahead is cell zero. Their tag is what
                // makes telling kin from stranger an evolvable thing to do
                if (i == 0) {
                    let other = slots[slot];
                    if (other != nil) {
                        inputs.set_f32(KIN_BASE, other.tag1);
                        inputs.set_f32(KIN_BASE + 1, other.tag2);
                    }
                }
            }
        }

        if (self.carried != ITEM_NONE)
            inputs.set_f32(CARRY_BASE + self.carried, 1.0);

        // Scent, as a level and two gradients in the agent's own frame. A
        // single positive weight on the forward gradient already produces a
        // competent forager, which is the whole point of the scent field
        let s = island.scent;
        let cx = (self.x >> SCENT_SHIFT) + 1;
        let cy = (self.y >> SCENT_SHIFT) + 1;
        let here = cy * SCENT_W + cx;
        let fwd = FRONT_Y[self.dir] * SCENT_W + FRONT_X[self.dir];
        let side = SIDE_Y[self.dir] * SCENT_W + SIDE_X[self.dir];

        for (let var c = 0; c < NUM_SCENTS; ++c) {
            let o = c * SCENT_PLANE + here;

            let v0 = s.get_f32(o);
            let v1 = s.get_f32(o + fwd);
            let v2 = s.get_f32(o + side);
            let v3 = s.get_f32(o - side);

            // Squashed into 0..1, so a difference of two is already bounded
            // and the gradient stays usable at any distance from a source
            let q0 = v0 / (1.0 + v0);
            let i = SCENT_BASE + c * 3;
            inputs.set_f32(i, q0);
            inputs.set_f32(i + 1, v1 / (1.0 + v1) - q0);
            inputs.set_f32(i + 2, v2 / (1.0 + v2) - v3 / (1.0 + v3));
        }

        let f = self.food;
        let w = self.water;
        let e = self.energy;
        inputs.set_f32(BODY_BASE, f / (100.0 + f));
        inputs.set_f32(BODY_BASE + 1, w / (100.0 + w));
        inputs.set_f32(BODY_BASE + 2, e / (100.0 + e));
        inputs.set_f32(AGE_IDX, self.age.to_f() / (1000.0 + self.age.to_f()));

        let rng = island.rng;
        for (let var i = 0; i < NUM_RND; ++i)
            inputs.set_f32(RND_BASE + i, rng.float(-1.0, 1.0));
    }

    // The new hidden values land in their own buffer and are copied back only
    // once the layer is done, so every unit reads the same previous state
    think(self)
    {
        let w = self.genome;
        let inputs = self.inputs;
        let hidden = self.hidden;
        let num_inputs = NUM_INPUTS;
        let cap = ACT_CAP;

        for (let var i = 0; i < NUM_HIDDEN; ++i) {
            let sum = w.dot_f32(i * num_inputs, 1, inputs, 0, 1, num_inputs);
            hidden.set_f32(i, sum.clip(0.0, cap));
        }

        inputs.memcpy(NUM_SENSORS * 4, hidden, 0, NUM_HIDDEN * 4);

        let var best = 0;
        let var best_val = -1.0e30;

        for (let var i = 0; i < NUM_ACTIONS; ++i) {
            let sum = w.dot_f32(ACT_BASE + i * NUM_HIDDEN, 1, hidden, 0, 1, NUM_HIDDEN);
            if (sum > best_val) {
                best_val = sum;
                best = i;
            }
        }

        return best;
    }

    front_idx(self)
    {
        return (self.y + FRONT_Y[self.dir]) * GRID_W + self.x + FRONT_X[self.dir];
    }

    act(self, island, action)
    {
        if (action == ACT_FORWARD) {
            let dst = self.front_idx();
            let cell = island.grid.get_u32(dst);

            // The border means a move can never leave the grid
            if (is_passable(cell & 0xFF) && (cell >> 8) == 0) {
                // Stepping into an open doorway carries you next door
                let side = island.gate_at(dst);
                if (side >= 0)
                    island.emigrate(self, side);
                else
                    island.move_agent(self, dst);
            }
        }
        else if (action == ACT_LEFT) {
            self.dir = (self.dir + 3) % 4;
        }
        else if (action == ACT_RIGHT) {
            self.dir = (self.dir + 1) % 4;
        }
        else if (action == ACT_EAT) {
            self.eat(island);
        }
        else if (action == ACT_PICK_UP) {
            self.pick_up(island);
        }
        else if (action == ACT_DROP) {
            self.drop(island);
        }
        else if (action == ACT_REPRODUCE) {
            island.reproduce(self);
        }
    }

    eat(self, island)
    {
        let idx = self.front_idx();
        let cell = island.grid.get_u32(idx);

        // Somebody in the way is struck instead. Nothing else can be on
        // their cell that EAT would have taken anyway
        if ((cell >> 8) != 0) {
            self.strike(island, cell >> 8);
            return;
        }

        let terrain = cell & 0xFF;

        // A meal that would overflow is taken up to the limit rather than
        // refused. Refusing it meant a rich carcass was edible by nobody and
        // simply rotted, so killing a well fed agent produced a meal for
        // whoever came along hungry instead of for the one that did the work.
        // Capping only ever destroys the surplus, so it cannot mint anything
        if (terrain == CELL_PLANT) {
            self.food = (self.food + FOOD_PER_PLANT).min(MAX_FOOD);
            island.eat_plant(idx);
        }
        else if (terrain == CELL_CORPSE) {
            self.food = (self.food + island.corpse_food.get_f32(idx)).min(MAX_FOOD);
            island.take_corpse(idx);
        }
        else if (terrain == CELL_WATER) {
            self.water = (self.water + WATER_PER_DRINK).min(MAX_WATER);
        }
    }

    // Nothing stops an agent striking its own kin. Offspring appear right
    // beside their parent, so a lineage that attacks whatever is in front of
    // it eats its own young, and the tag of the agent ahead is already an
    // input. Whether that gets used is left to selection
    strike(self, island, slot)
    {
        let target = island.slots[slot];
        if (target == nil || !target.alive)
            return;

        self.energy = self.energy - ATTACK_COST;
        target.energy = target.energy - ATTACK_DAMAGE;
        target.hit_tick = island.tick_count;

        // Marked dead now rather than waiting for its own turn, so it cannot
        // act again after a killing blow
        if (target.energy <= 0.0) {
            target.alive = false;
            island.num_killed = island.num_killed + 1;
        }
    }

    pick_up(self, island)
    {
        if (self.carried != ITEM_NONE)
            return;

        let idx = self.front_idx();
        let terrain = island.grid.get_u32(idx) & 0xFF;

        if (terrain == CELL_ROCK) {
            self.carried = ITEM_ROCK;
        }
        else if (terrain == CELL_SEED) {
            // The seed keeps ripening in hand: carrying it holds on to when
            // it is due, rather than starting it over on every drop
            self.carried = ITEM_SEED;
            self.carried_due = island.seed_due.get_u32(idx);
        }
        else if (terrain == CELL_CORPSE) {
            // The carcass keeps its value while it is being hauled around
            self.carried = ITEM_CORPSE;
            self.carried_food = island.corpse_food.get_f32(idx);
            island.take_corpse(idx);
            return;
        }
        else {
            return;
        }

        island.set_terrain(idx, CELL_EMPTY);
    }

    // What lands on the ground is decided by what is being carried, which is
    // why there is no separate build action: dropping a rock is building
    drop(self, island)
    {
        if (self.carried == ITEM_NONE)
            return;

        let idx = self.front_idx();
        let cell = island.grid.get_u32(idx);

        if (!is_bare(cell & 0xFF) || (cell >> 8) != 0)
            return;

        if (self.carried == ITEM_ROCK) {
            island.set_terrain(idx, CELL_ROCK);
        }
        else if (self.carried == ITEM_SEED) {
            island.set_terrain(idx, CELL_SEED);
            island.plant_seed(idx, self.carried_due);
        }
        else if (self.carried == ITEM_CORPSE) {
            island.place_corpse(idx, self.carried_food);
        }

        self.carried = ITEM_NONE;
        self.carried_food = 0.0;
    }

    metabolize(self)
    {
        self.age = self.age + 1;

        // Food and water are only useful together, so the scarcer one sets
        // the rate and an agent has to find both to stay ahead of the cost
        if (self.food > 0.0 && self.water > 0.0) {
            let m = METAB_RATE.min(self.food).min(self.water);
            self.food = self.food - m;
            self.water = self.water - m;
            self.energy = (self.energy + m * ENERGY_PER_UNIT).min(MAX_ENERGY);
        }

        self.energy = self.energy - LIVING_COST;
        if (self.carried != ITEM_NONE)
            self.energy = self.energy - CARRY_COST;

        if (self.energy <= 0.0 || self.age >= MAX_AGE)
            self.alive = false;
    }
}

// --- Island ---
//
// One world and the population living in it. This class knows nothing about
// actors or windows on purpose: V0 runs a single island right here in the
// main actor, and giving each island an actor of its own later is a matter of
// wrapping this in a message loop rather than rewriting it

class Island
{
    init(self, seed)
    {
        self.rng = Xoshiro128(seed);
        self.gauss = Gauss(self.rng);
        self.seed_val = seed;

        self.grid = ByteArray.with_size(GRID_W * GRID_H * 4);

        // Two buffers, because a diffusion pass cannot read and write the
        // same grid, plus the per-cell source counts that feed it
        self.scent = ByteArray.with_size(NUM_SCENTS * SCENT_PLANE * 4);
        self.scent_next = ByteArray.with_size(NUM_SCENTS * SCENT_PLANE * 4);
        self.scent_src = ByteArray.with_size(NUM_SCENTS * SCENT_PLANE * 4);
        self.scent_open = ByteArray.with_size(SCENT_PLANE * 4);

        self.pop = [];
        self.births = [];
        self.slots = Array.with_size(MAX_POP + 1, nil);
        self.free_slots = [];

        // Queues of pending world events. Every entry in one queue has the
        // same delay, so each is already in order and only the head is due
        // Cells that currently hold a seed, and the tick each one is due to
        // hatch. The due time lives per cell rather than in the list because
        // a carried seed keeps its own, so the list can no longer be assumed
        // to be in hatching order the way the corpse queue still is
        self.seeds = [];
        self.seed_due = ByteArray.with_size(GRID_W * GRID_H * 4);
        self.corpses = [];
        self.corpses_head = 0;

        // How much food the carcass on each cell is worth. A plain array
        // rather than a map, because it is read on every corpse an agent
        // walks into and indexing a grid is a single load
        self.corpse_food = ByteArray.with_size(GRID_W * GRID_H * 4);

        self.tick_count = 0;
        self.num_born = 0;
        self.num_seeded = 0;
        self.num_died = 0;

        // Deaths by violence, counted separately. These are a subset of
        // num_died, so the two read together say how much of the dying is
        // being done to each other rather than by starving
        self.num_killed = 0;
        self.num_plants = 0;
        self.total_plants = 0;
        self.num_eaten = 0;

        // What the population actually spends its ticks doing. The cheapest
        // way to tell a world that has learned something from one that has
        // not: a population still picking every action uniformly has not
        self.act_counts = Array.with_size(NUM_ACTIONS, 0);

        // Gates. Index 0 leads to the next island around the ring and index
        // 1 to the previous one. Emigrants are queued here rather than sent,
        // so that this class stays free of any knowledge of actors: whoever
        // is driving it flushes the outbox wherever it needs to go
        self.gate_open = [false, false];
        self.gate_count = [0, 0];
        self.gate_cells = [self.gate_span(0), self.gate_span(1)];
        self.outbox = [];
        self.num_left = 0;
        self.num_arrived = 0;

        self.generate();
    }

    // --- World generation ---

    generate(self)
    {
        let rng = self.rng;
        let grid = self.grid;

        for (let var y = 0; y < GRID_H; ++y) {
            for (let var x = 0; x < GRID_W; ++x) {
                let in_border =
                    x < BORDER || y < BORDER ||
                    x >= GRID_W - BORDER || y >= GRID_H - BORDER;

                grid.set_u32(y * GRID_W + x, in_border ? CELL_WALL : CELL_EMPTY);
            }
        }

        self.grow_water();
        self.grow_ridges();
        self.grow_plants();

        // The plant count comes out of the growth rather than being chosen,
        // so it is counted once here and then conserved for the whole run
        self.total_plants = self.num_plants;

        self.build_openness();
        self.rebuild_sources();

        // Run the field to something near equilibrium before anyone lives in
        // it, so the first generation is not born into a flat world. A slow
        // decay needs roughly 1/(1 - decay) passes to settle
        for (let var i = 0; i < 800; ++i)
            self.diffuse();

        self.seed_population();
    }

    // --- Gates ---
    //
    // A gate is a few cells cut out of the middle of the east or west wall.
    // Nothing marks it as special to an agent: it reads as ordinary ground,
    // which is why one gets used without having to be advertised

    gate_span(self, side)
    {
        let x = side == 0 ? GRID_W - BORDER - 1 : BORDER;
        let y0 = (GRID_H - GATE_WIDTH).idiv(2);
        let cells = [];

        for (let var i = 0; i < GATE_WIDTH; ++i)
            cells.push((y0 + i) * GRID_W + x);

        return cells;
    }

    set_gate(self, side, open)
    {
        if (self.gate_open[side] == open)
            return;

        self.gate_open[side] = open;
        self.gate_count[side] = 0;

        let cells = self.gate_cells[side];
        for (let var i = 0; i < cells.len; ++i) {
            let idx = cells[i];

            // Anything standing in the doorway when it shuts is simply
            // walled in, so the cell is only changed when it is clear
            let cell = self.grid.get_u32(idx);
            if ((cell >> 8) != 0)
                continue;

            self.set_terrain(idx, open ? CELL_EMPTY : CELL_WALL);
        }
    }

    // Which gate, if any, a cell belongs to
    gate_at(self, idx)
    {
        for (let var side = 0; side < 2; ++side) {
            if (!self.gate_open[side])
                continue;

            let cells = self.gate_cells[side];
            for (let var i = 0; i < cells.len; ++i) {
                if (cells[i] == idx)
                    return side;
            }
        }

        return -1;
    }

    // Packs an agent up and hands it to the outbox. What it was carrying is
    // left behind, because plants are conserved per island and a seed taken
    // through a gate would put both sides' books out
    emigrate(self, agent, side)
    {
        if (agent.carried == ITEM_SEED) {
            let spot = self.free_cell_around(agent.x, agent.y);
            if (spot >= 0) {
                self.set_terrain(spot, CELL_SEED);
                self.plant_seed(spot, agent.carried_due);
            }
        }
        agent.carried = ITEM_NONE;

        // Its own energy and stores travel with it, so crossing neither
        // costs nor creates anything
        self.outbox.push([
            side,
            agent.genome,
            agent.energy,
            agent.food,
            agent.water,
            agent.age
        ]);

        // Released here rather than by the usual route: it left, so it
        // leaves no carcass and does not count among the dead
        let idx = agent.y * GRID_W + agent.x;
        self.grid.set_u32(idx, self.grid.get_u32(idx) & 0xFF);
        self.slots[agent.slot] = nil;
        self.free_slots.push(agent.slot);

        agent.alive = false;
        agent.emigrated = true;
        self.num_left = self.num_left + 1;

        self.gate_count[side] = self.gate_count[side] + 1;
        if (self.gate_count[side] >= GATE_CROSSINGS)
            self.set_gate(side, false);
    }

    // An arrival is placed just inside the gate it came through, or anywhere
    // free if the doorway is crowded
    immigrate(self, record)
    {
        let side = record[0];
        let entry = self.gate_cells[1 - side];

        let var idx = -1;
        for (let var i = 0; i < entry.len && idx < 0; ++i) {
            let near = self.free_cell_around(entry[i] % GRID_W, entry[i].idiv(GRID_W));
            if (near >= 0)
                idx = near;
        }

        if (idx < 0)
            idx = self.random_free_cell();
        if (idx < 0)
            return;

        let agent = self.place_agent(record[1], idx);
        if (agent == nil)
            return;

        agent.energy = record[2];
        agent.food = record[3];
        agent.water = record[4];
        agent.age = record[5];

        self.pop.push(agent);
        self.num_arrived = self.num_arrived + 1;
    }

    // Cells of a given type among the eight around this one. The border
    // means the interior never has to bounds check
    count_neighbors(self, x, y, type)
    {
        let grid = self.grid;
        let idx = y * GRID_W + x;
        let var n = 0;

        for (let var dy = -1; dy <= 1; ++dy) {
            let row = idx + dy * GRID_W;
            for (let var dx = -1; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0)
                    continue;
                if ((grid.get_u32(row + dx) & 0xFF) == type)
                    n = n + 1;
            }
        }

        return n;
    }

    // Sparse seeds flooded outwards. The exponential term is what rounds the
    // ponds off: a cell with four water neighbours floods about a third of
    // the time, one with six almost certainly, so bays and notches fill in
    // instead of leaving the ragged edges a random walk produces
    grow_water(self)
    {
        let rng = self.rng;
        let grid = self.grid;

        for (let var y = BORDER; y < GRID_H - BORDER; ++y) {
            for (let var x = BORDER; x < GRID_W - BORDER; ++x) {
                if (rng.float(0.0, 1.0) < WATER_SEED_PROB)
                    grid.set_u32(y * GRID_W + x, CELL_WATER);
            }
        }

        for (let var pass = 0; pass < WATER_PASSES; ++pass) {
            for (let var y = BORDER; y < GRID_H - BORDER; ++y) {
                for (let var x = BORDER; x < GRID_W - BORDER; ++x) {
                    let idx = y * GRID_W + x;
                    if ((grid.get_u32(idx) & 0xFF) == CELL_WATER)
                        continue;

                    let n = self.count_neighbors(x, y, CELL_WATER);
                    if (n == 0)
                        continue;

                    let nf = n.to_f();
                    if (rng.float(0.0, 1.0) < 0.02 * nf + 0.004 * nf.exp())
                        grid.set_u32(idx, CELL_WATER);
                }
            }
        }
    }

    norm_int(self, mean, sd)
    {
        return (mean.to_f() + self.gauss.next() * sd.to_f() + 0.5).floor().max(0);
    }

    // Straight runs of rock, laid down row-wise and column-wise. Neither is
    // allowed to sit right beside another, so they stay as separate ridges
    // rather than merging into one slab
    grow_ridges(self)
    {
        let rng = self.rng;
        let grid = self.grid;

        let max_len = (GRID_W.min(GRID_H)).idiv(4);
        let used = Array.with_size(GRID_W.max(GRID_H), false);

        for (let var axis = 0; axis < 2; ++axis) {
            let horiz = axis == 0;
            let span = horiz ? GRID_W : GRID_H;
            let cross = horiz ? GRID_H : GRID_W;

            for (let var i = 0; i < used.len; ++i)
                used[i] = false;

            let target = self.norm_int(RIDGE_MEAN, RIDGE_SD);
            let var made = 0;

            // Capped, since a run can be rejected for several reasons and
            // there is no guarantee a valid one is ever drawn
            for (let var tries = 0; made < target && tries < 400; ++tries) {
                let c = rng.int(BORDER + 1, cross - BORDER - 1);
                if (used[c - 1] || used[c] || used[c + 1])
                    continue;

                let a = rng.int(BORDER, span - BORDER);
                let b = rng.int(BORDER, span - BORDER);
                let len = (a - b).abs();
                if (len < RIDGE_MIN_LEN || len > max_len)
                    continue;

                let step = b > a ? 1 : -1;
                for (let var p = a; p != b; p = p + step) {
                    let x = horiz ? p : c;
                    let y = horiz ? c : p;
                    let idx = y * GRID_W + x;

                    // Runs stop at water, and the second axis also stops
                    // where it would run flush against an existing ridge
                    if ((grid.get_u32(idx) & 0xFF) == CELL_WATER)
                        break;
                    if (!horiz && self.count_neighbors(x, y, CELL_ROCK) > 1)
                        break;

                    grid.set_u32(idx, CELL_ROCK);
                }

                used[c] = true;
                made = made + 1;
            }
        }
    }

    // Plants spread from isolated seeds, so they come out in patches. Even
    // scatter would leave every coarse cell holding about the same count,
    // and the scent field it feeds would have no gradient worth climbing.
    // Nothing grows on the shoreline, which keeps food and water apart and
    // makes the trip between them a problem worth solving
    grow_plants(self)
    {
        let rng = self.rng;
        let grid = self.grid;

        for (let var pass = 0; pass < PLANT_PASSES; ++pass) {
            for (let var y = BORDER; y < GRID_H - BORDER; ++y) {
                for (let var x = BORDER; x < GRID_W - BORDER; ++x) {
                    let idx = y * GRID_W + x;
                    if ((grid.get_u32(idx) & 0xFF) != CELL_EMPTY)
                        continue;

                    if (self.count_neighbors(x, y, CELL_WATER) > 0)
                        continue;

                    let n = self.count_neighbors(x, y, CELL_PLANT);
                    let p = n == 0 ? PLANT_SEED_PROB : PLANT_SPREAD * n.to_f();

                    if (rng.float(0.0, 1.0) < p)
                        self.set_terrain(idx, CELL_PLANT);
                }
            }
        }
    }

    random_empty(self)
    {
        let rng = self.rng;

        for (let var tries = 0; tries < 200; ++tries) {
            let x = rng.int(BORDER, GRID_W - BORDER);
            let y = rng.int(BORDER, GRID_H - BORDER);
            let idx = y * GRID_W + x;
            if (self.grid.get_u32(idx) == CELL_EMPTY)
                return idx;
        }

        return -1;
    }

    // How much of each coarse cell can hold scent at all. Walls and water do
    // not conduct, so a field built this way flows around obstacles instead
    // of straight through them
    build_openness(self)
    {
        let step = 1 << SCENT_SHIFT;
        let area = (step * step).to_f();

        for (let var cy = 0; cy < SCENT_H; ++cy) {
            for (let var cx = 0; cx < SCENT_W; ++cx) {
                let x0 = (cx - 1) * step;
                let y0 = (cy - 1) * step;
                let var open = 0;

                for (let var dy = 0; dy < step; ++dy) {
                    for (let var dx = 0; dx < step; ++dx) {
                        let x = x0 + dx;
                        let y = y0 + dy;
                        if (x < 0 || y < 0 || x >= GRID_W || y >= GRID_H)
                            continue;

                        let t = self.grid.get_u32(y * GRID_W + x) & 0xFF;
                        if (t != CELL_WALL && t != CELL_WATER)
                            open = open + 1;
                    }
                }

                self.scent_open.set_f32(cy * SCENT_W + cx, open.to_f() / area);
            }
        }
    }

    // Source counts are kept up to date as cells change, so a diffusion pass
    // never has to rescan the grid
    rebuild_sources(self)
    {
        for (let var i = 0; i < NUM_SCENTS * SCENT_PLANE; ++i)
            self.scent_src.set_f32(i, 0.0);

        for (let var y = BORDER; y < GRID_H - BORDER; ++y) {
            for (let var x = BORDER; x < GRID_W - BORDER; ++x) {
                let t = self.grid.get_u32(y * GRID_W + x) & 0xFF;
                let chan = self.source_channel(t);
                if (chan >= 0)
                    self.add_source(x, y, chan, 1.0);
            }
        }
    }

    source_channel(self, terrain)
    {
        if (terrain == CELL_PLANT)
            return SCENT_PLANT;
        if (terrain == CELL_WATER)
            return SCENT_WATER;
        if (terrain == CELL_CORPSE)
            return SCENT_CORPSE;
        return -1;
    }

    add_source(self, x, y, chan, amount)
    {
        let cx = (x >> SCENT_SHIFT) + 1;
        let cy = (y >> SCENT_SHIFT) + 1;
        let idx = chan * SCENT_PLANE + cy * SCENT_W + cx;
        self.scent_src.set_f32(idx, self.scent_src.get_f32(idx) + amount);
    }

    // One five-point diffusion pass per channel. The west neighbour is the
    // cell just written and the centre is the cell just read, so both are
    // carried in locals and only two reads per cell actually happen
    diffuse(self)
    {
        let cur = self.scent;
        let next = self.scent_next;
        let src = self.scent_src;
        let open = self.scent_open;
        let spread = SCENT_SPREAD;
        let keep = 1.0 - 4.0 * SCENT_SPREAD;
        let decay = SCENT_DECAY;

        for (let var c = 0; c < NUM_SCENTS; ++c) {
            let plane = c * SCENT_PLANE;

            for (let var y = 1; y < SCENT_H - 1; ++y) {
                let row = plane + y * SCENT_W;
                let var west = cur.get_f32(row);
                let var here = cur.get_f32(row + 1);

                for (let var x = 1; x < SCENT_W - 1; ++x) {
                    let i = row + x;
                    let east = cur.get_f32(i + 1);
                    let north = cur.get_f32(i - SCENT_W);
                    let south = cur.get_f32(i + SCENT_W);

                    let v =
                        (here * keep + spread * (west + east + north + south)) * decay +
                        src.get_f32(i) * SCENT_SOURCE;

                    next.set_f32(i, v * open.get_f32(y * SCENT_W + x));

                    west = here;
                    here = east;
                }
            }
        }

        self.scent = next;
        self.scent_next = cur;
    }

    // --- Cell updates ---
    //
    // Everything that changes terrain goes through here, so the scent source
    // counts can never drift out of step with the grid

    set_terrain(self, idx, terrain)
    {
        let grid = self.grid;
        let cell = grid.get_u32(idx);
        let old = cell & 0xFF;
        if (old == terrain)
            return;

        let x = idx % GRID_W;
        let y = idx.idiv(GRID_W);

        let old_chan = self.source_channel(old);
        if (old_chan >= 0)
            self.add_source(x, y, old_chan, -1.0);

        let new_chan = self.source_channel(terrain);
        if (new_chan >= 0)
            self.add_source(x, y, new_chan, 1.0);

        // Counted here rather than at the call sites, so that every route a
        // plant can appear or vanish by is accounted for exactly once
        if (old == CELL_PLANT)
            self.num_plants = self.num_plants - 1;
        if (terrain == CELL_PLANT)
            self.num_plants = self.num_plants + 1;

        grid.set_u32(idx, terrain | (cell & 0xFFFFFF00));
    }

    // What is left where a plant stood is its seed, which grows back into a
    // plant unless somebody carries it off first
    eat_plant(self, idx)
    {
        self.set_terrain(idx, CELL_SEED);
        self.num_eaten = self.num_eaten + 1;
        self.plant_seed(idx, self.tick_count + SEED_HATCH);
    }

    // Puts a seed on a cell, due at an absolute tick. A seed that came due
    // while it was being carried is already past its time and hatches on the
    // next pass, so carrying never costs the seed anything but never lets it
    // sprout in hand either
    plant_seed(self, idx, due)
    {
        self.seed_due.set_u32(idx, due);
        self.seeds.push(idx);
    }

    // Walked in full every tick, because the list is not in hatching order.
    // Entries whose cell no longer holds a seed were picked up or built over
    // and are dropped here, which is what keeps the list bounded
    tick_seeds(self)
    {
        let seeds = self.seeds;
        let due = self.seed_due;
        let now = self.tick_count;
        let var w = 0;

        for (let var i = 0; i < seeds.len; ++i) {
            let idx = seeds[i];

            if ((self.grid.get_u32(idx) & 0xFF) != CELL_SEED)
                continue;

            if (due.get_u32(idx) > now) {
                seeds[w] = idx;
                w = w + 1;
                continue;
            }

            self.set_terrain(idx, CELL_PLANT);
        }

        seeds.resize(w, nil);
    }

    place_corpse(self, idx, value)
    {
        self.set_terrain(idx, CELL_CORPSE);
        self.corpse_food.set_f32(idx, value);
        self.corpses.push(self.tick_count + CORPSE_DECAY);
        self.corpses.push(idx);
    }

    // Removes a carcass, whether it was eaten or picked up. The stored value
    // is cleared so a later corpse on the same cell cannot inherit it
    take_corpse(self, idx)
    {
        self.set_terrain(idx, CELL_EMPTY);
        self.corpse_food.set_f32(idx, 0.0);
    }

    move_agent(self, agent, dst)
    {
        let grid = self.grid;
        let src = agent.y * GRID_W + agent.x;

        grid.set_u32(src, grid.get_u32(src) & 0xFF);
        grid.set_u32(dst, (grid.get_u32(dst) & 0xFF) | (agent.slot << 8));

        agent.x = dst % GRID_W;
        agent.y = dst.idiv(GRID_W);
    }

    // --- Population ---

    alloc_slot(self)
    {
        if (self.free_slots.len > 0)
            return self.free_slots.pop();

        for (let var i = 1; i <= MAX_POP; ++i) {
            if (self.slots[i] == nil)
                return i;
        }

        return 0;
    }

    place_agent(self, genome, idx)
    {
        let slot = self.alloc_slot();
        if (slot == 0)
            return nil;

        let agent = Agent(
            genome,
            slot,
            idx % GRID_W,
            idx.idiv(GRID_W),
            self.rng.int(0, 4)
        );

        self.slots[slot] = agent;
        let grid = self.grid;
        grid.set_u32(idx, (grid.get_u32(idx) & 0xFF) | (slot << 8));

        return agent;
    }

    // An empty cell with nobody standing in it
    random_free_cell(self)
    {
        let rng = self.rng;

        for (let var tries = 0; tries < 200; ++tries) {
            let x = rng.int(BORDER, GRID_W - BORDER);
            let y = rng.int(BORDER, GRID_H - BORDER);
            let idx = y * GRID_W + x;
            let cell = self.grid.get_u32(idx);
            if (is_bare(cell & 0xFF) && (cell >> 8) == 0)
                return idx;
        }

        return -1;
    }

    free_cell_near(self, x, y)
    {
        let grid = self.grid;

        for (let var dy = -1; dy <= 1; ++dy) {
            for (let var dx = -1; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0)
                    continue;

                let nx = x + dx;
                let ny = y + dy;
                if (nx < BORDER || ny < BORDER ||
                    nx >= GRID_W - BORDER || ny >= GRID_H - BORDER)
                    continue;

                let idx = ny * GRID_W + nx;
                let cell = grid.get_u32(idx);
                if (is_bare(cell & 0xFF) && (cell >> 8) == 0)
                    return idx;
            }
        }

        return -1;
    }

    // The nearest bare cell, searched in widening rings. Unlike
    // free_cell_near this does not give up after the eight neighbours, so
    // what a dying agent was carrying always finds somewhere to land: the
    // plant count has to be conserved exactly, and a seed that fell through
    // the cracks because a crowd happened to be standing around would take a
    // plant out of the world permanently
    free_cell_around(self, x, y)
    {
        let grid = self.grid;
        let max_r = GRID_W.max(GRID_H);

        for (let var r = 1; r < max_r; ++r) {
            for (let var dy = -r; dy <= r; ++dy) {
                let ny = y + dy;
                if (ny < BORDER || ny >= GRID_H - BORDER)
                    continue;

                // Only the edge of the ring, since everything inside it was
                // covered by a previous, smaller ring
                let edge = dy.abs() == r;
                let step = edge ? 1 : 2 * r;

                for (let var dx = -r; dx <= r; dx = dx + step) {
                    let nx = x + dx;
                    if (nx < BORDER || nx >= GRID_W - BORDER)
                        continue;

                    let idx = ny * GRID_W + nx;
                    let cell = grid.get_u32(idx);
                    if (is_bare(cell & 0xFF) && (cell >> 8) == 0)
                        return idx;
                }
            }
        }

        return -1;
    }

    // Nothing here decides who deserves to reproduce. An agent reproduces
    // because it chose to and had banked the energy to pay for it
    reproduce(self, parent)
    {
        if (parent.energy < REPRO_COST)
            return;
        if (self.pop.len + self.births.len >= MAX_POP)
            return;

        let idx = self.free_cell_near(parent.x, parent.y);
        if (idx < 0)
            return;

        parent.energy = parent.energy - REPRO_COST;

        let genome = mutate_genome(self.rng, self.gauss, parent.genome);
        let child = self.place_agent(genome, idx);
        if (child == nil) {
            parent.energy = parent.energy + REPRO_COST;
            return;
        }

        self.births.push(child);
        self.num_born = self.num_born + 1;
    }

    // Fresh random agents, to keep a world that has not solved foraging yet
    // from emptying out completely
    seed_population(self)
    {
        while (self.pop.len + self.births.len < MIN_POP) {
            let idx = self.random_free_cell();
            if (idx < 0)
                return;

            let agent = self.place_agent(new_genome(self.rng), idx);
            if (agent == nil)
                return;

            self.pop.push(agent);
            self.num_seeded = self.num_seeded + 1;
        }
    }

    bury(self, agent)
    {
        let idx = agent.y * GRID_W + agent.x;
        let grid = self.grid;

        grid.set_u32(idx, grid.get_u32(idx) & 0xFF);
        self.slots[agent.slot] = nil;
        self.free_slots.push(agent.slot);
        self.num_died = self.num_died + 1;

        // Whatever it was carrying falls nearby, keeping its ripeness or its
        // food value. The search widens until it finds ground, so a seed is
        // never lost and the plant count stays exactly conserved
        if (agent.carried != ITEM_NONE) {
            let spot = self.free_cell_around(agent.x, agent.y);
            if (spot >= 0) {
                if (agent.carried == ITEM_ROCK) {
                    self.set_terrain(spot, CELL_ROCK);
                }
                else if (agent.carried == ITEM_SEED) {
                    self.set_terrain(spot, CELL_SEED);
                    self.plant_seed(spot, agent.carried_due);
                }
                else {
                    self.place_corpse(spot, agent.carried_food);
                }
            }
        }

        // What an agent leaves behind is its body and whatever it had not
        // digested yet, so an agent that dies of thirst or of old age on a
        // full stomach is a far richer find than one that starved
        if (is_bare(grid.get_u32(idx) & 0xFF))
            self.place_corpse(idx, agent.food + CORPSE_BODY_FOOD);
    }

    // --- Pending world events ---
    //
    // Each queue holds pairs of due tick and cell index, oldest first. The
    // head walks forward and the queue is compacted once it has fallen behind

    // A seed only sprouts while the world has room for another plant.
    // Without this, farming is a one-way ratchet: eaten plants grow back
    // where they stood and dropped seeds add new ones on top, so the world
    // fills up solid and there is nothing left to select for
    drain_queue(self, queue, head, terrain, required)
    {
        let var h = head;

        while (h < queue.len && queue[h] <= self.tick_count) {
            let idx = queue[h + 1];
            h = h + 2;

            // The cell has to still hold what the entry was filed against.
            // A seed that somebody picked up and carried off leaves a stale
            // entry behind, and this is what stops it hatching where it no
            // longer is. Dropping it files a fresh entry
            if ((self.grid.get_u32(idx) & 0xFF) != required)
                continue;

            self.set_terrain(idx, terrain);
        }

        if (h > 4096) {
            let remaining = queue.len - h;
            for (let var i = 0; i < remaining; ++i)
                queue[i] = queue[h + i];
            queue.resize(remaining, nil);
            return 0;
        }

        return h;
    }

    tick(self)
    {
        let pop = self.pop;

        // Compacted in place while walking, which keeps removal linear and
        // avoids the index bugs that splicing mid-loop invites
        let var w = 0;
        for (let var i = 0; i < pop.len; ++i) {
            let agent = pop[i];

            // Something may have killed this one earlier in the same tick,
            // in which case it neither digests nor acts, and the corpse it
            // leaves is whatever it was holding at the moment it was struck
            if (agent.alive)
                agent.metabolize();

            if (agent.alive) {
                agent.sense(self);
                let action = agent.think();
                self.act_counts[action] = self.act_counts[action] + 1;
                agent.act(self, action);
            }

            if (agent.alive) {
                pop[w] = agent;
                w = w + 1;
            } else if (!agent.emigrated) {
                self.bury(agent);
            }
        }
        pop.resize(w, nil);

        // Newborns join after the walk, so nobody acts on the tick they are
        // born and the compaction above never sees a moving target
        for (let var i = 0; i < self.births.len; ++i)
            pop.push(self.births[i]);
        self.births.resize(0, nil);

        // Offset from the scent pass so the two do not land on the same tick
        if (self.tick_count % SEED_PERIOD == 4)
            self.tick_seeds();
        self.corpses_head = self.drain_queue(self.corpses, self.corpses_head, CELL_EMPTY, CELL_CORPSE);

        if (self.tick_count % SCENT_PERIOD == 0)
            self.diffuse();

        self.seed_population();

        // Long isolation, then a brief opening. The point of the quiet
        // stretch is that each island gets to settle on its own answer
        // before a few migrants carry it next door
        if (NUM_ISLANDS > 1 && self.tick_count % GATE_PERIOD == 0) {
            self.set_gate(0, true);
            self.set_gate(1, true);
        }

        self.tick_count = self.tick_count + 1;
    }

    // --- Persistence ---

    save(self, path)
    {
        let n = self.pop.len;
        let row = NUM_WEIGHTS * 4;
        let out = ByteArray.with_size(16 + n * row);

        out.store_u32(0, SAVE_MAGIC);
        out.store_u32(4, SAVE_VERSION);
        out.store_u32(8, NUM_WEIGHTS);
        out.store_u32(12, n);

        for (let var i = 0; i < n; ++i)
            out.memcpy(16 + i * row, self.pop[i].genome, 0, row);

        return $write_file(path, out) ? n : -1;
    }

    load(self, path)
    {
        let data = $read_file(path);
        if (data == nil || data.len < 16)
            return -1;

        if (data.load_u32(0) != SAVE_MAGIC)
            return -1;
        if (data.load_u32(4) != SAVE_VERSION)
            return -1;
        if (data.load_u32(8) != NUM_WEIGHTS)
            return -1;

        let row = NUM_WEIGHTS * 4;
        let n = data.load_u32(12).min(MAX_POP);
        if (data.len < 16 + n * row)
            return -1;

        // Everyone alive makes way for the population being restored
        for (let var i = 0; i < self.pop.len; ++i) {
            let agent = self.pop[i];
            let idx = agent.y * GRID_W + agent.x;
            self.grid.set_u32(idx, self.grid.get_u32(idx) & 0xFF);
            self.slots[agent.slot] = nil;
            self.free_slots.push(agent.slot);
        }
        self.pop.resize(0, nil);

        let var loaded = 0;
        for (let var i = 0; i < n; ++i) {
            let idx = self.random_free_cell();
            if (idx < 0)
                break;

            let genome = ByteArray.with_size(row);
            genome.memcpy(0, data, 16 + i * row, row);

            let agent = self.place_agent(genome, idx);
            if (agent == nil)
                break;

            self.pop.push(agent);
            loaded = loaded + 1;
        }

        return loaded;
    }

    // Everything the renderer needs and nothing it does not. Sending the
    // island itself would be simpler, but a message is deep copied and the
    // population's genomes are about two megabytes of weights that the
    // renderer never looks at, against seventy kilobytes for this
    snapshot(self)
    {
        let grid = ByteArray.with_size(GRID_W * GRID_H * 4);
        grid.memcpy(0, self.grid, 0, GRID_W * GRID_H * 4);

        // Agents are looked up by slot while drawing, so their drawable
        // state is packed into flat runs indexed the same way
        let colors = ByteArray.with_size((MAX_POP + 1) * 4);
        let dirs = ByteArray.with_size((MAX_POP + 1) * 4);
        let hits = ByteArray.with_size((MAX_POP + 1) * 4);

        let pop = self.pop;
        for (let var i = 0; i < pop.len; ++i) {
            let agent = pop[i];
            colors.set_u32(agent.slot, agent.color);
            dirs.set_u32(agent.slot, agent.dir);
            hits.set_u32(agent.slot, agent.hit_tick == self.tick_count ? 1 : 0);
        }

        return {
            grid: grid,
            colors: colors,
            dirs: dirs,
            hits: hits,
            tick_count: self.tick_count,
            pop: pop.len,
            born: self.num_born,
            seeded: self.num_seeded,
            died: self.num_died,
            killed: self.num_killed,
            eaten: self.num_eaten,
            plants: self.num_plants,
            total_plants: self.total_plants,
            left: self.num_left,
            arrived: self.num_arrived,
            gates: self.gate_open[0] || self.gate_open[1],
            mean_age: self.mean_age(),
            mean_energy: self.mean_energy()
        };
    }

    mean_age(self)
    {
        if (self.pop.len == 0)
            return 0;

        let var total = 0;
        for (let var i = 0; i < self.pop.len; ++i)
            total = total + self.pop[i].age;

        return total.idiv(self.pop.len);
    }

    // How far the population is from starving, on average. It climbs as
    // foraging improves, and REPRO_COST is the level worth comparing it to
    mean_energy(self)
    {
        if (self.pop.len == 0)
            return 0;

        let var total = 0.0;
        for (let var i = 0; i < self.pop.len; ++i)
            total = total + self.pop[i].energy;

        return (total / self.pop.len.to_f()).floor();
    }
}

// --- Rendering ---

let COL_EMPTY = rgb32(26, 28, 24);
let COL_ROCK = rgb32(0x98, 0x98, 0x98);
let COL_WALL = rgb32(206, 112, 30);
let COL_WATER = rgb32(38, 78, 168);
let COL_PLANT = rgb32(78, 214, 74);
let COL_SEED = rgb32(150, 106, 52);
let COL_CORPSE = rgb32(122, 44, 44);
let COL_HIT = rgb32(220, 40, 40);
let COL_PANEL = rgb32(16, 17, 15);
let COL_TEXT = rgb32(190, 200, 185);
let COL_DIM = rgb32(110, 118, 108);

// Indexed by terrain value, so the gap at 6 is the agent channel's slot
let TERRAIN_COLORS = [
    COL_ROCK, COL_WALL, COL_WATER, COL_PLANT,
    COL_SEED, COL_CORPSE, COL_EMPTY, COL_EMPTY
];

// --- Cell pictograms ---
//
// Each shape is built once per zoom level and kept as a flat list of
// horizontal runs, since a run is exactly one fill_u32. Rebuilding on a zoom
// change costs a few hundred operations and saves doing the shape arithmetic
// per cell per frame.
//
// Water, wall and bare ground stay flat fills: they are background, and
// giving them outlines would only make the foreground harder to pick out
let MIN_SHAPE_ZOOM = 4;

// Runs of a filled ellipse centred in a cell, as fractions of the cell size
fun ellipse_runs(z, rx_frac, ry_frac, color) {
    let runs = [];
    let c = (z - 1).to_f() / 2.0;
    let rx = rx_frac * z.to_f() / 2.0;
    let ry = ry_frac * z.to_f() / 2.0;

    for (let var y = 0; y < z; ++y) {
        let dy = (y.to_f() - c) / ry;
        if (dy * dy > 1.0)
            continue;

        let half = rx * (1.0 - dy * dy).sqrt();
        let x0 = (c - half + 0.5).floor().max(0);
        let x1 = (c + half + 0.5).floor().min(z - 1);
        if (x1 < x0)
            continue;

        runs.push(y);
        runs.push(x0);
        runs.push(x1 - x0 + 1);
        runs.push(color);
    }

    return runs;
}

// Runs of a filled diamond, which reads as leaves next to the round stones
fun diamond_runs(z, frac, color) {
    let runs = [];
    let c = (z - 1).to_f() / 2.0;
    let r = frac * z.to_f() / 2.0;

    for (let var y = 0; y < z; ++y) {
        let half = r - (y.to_f() - c).abs();
        if (half < 0.0)
            continue;

        let x0 = (c - half + 0.5).floor().max(0);
        let x1 = (c + half + 0.5).floor().min(z - 1);
        if (x1 < x0)
            continue;

        runs.push(y);
        runs.push(x0);
        runs.push(x1 - x0 + 1);
        runs.push(color);
    }

    return runs;
}

// A triangle filling the cell and pointing the way the agent is facing. The
// shape carries no colour, because every agent draws it in its own
fun arrow_runs(z, dir) {
    let runs = [];

    let c = (z - 1).to_f() / 2.0;

    for (let var y = 0; y < z; ++y) {
        let var x0 = 0;
        let var len = 0;

        if (dir == DIR_UP || dir == DIR_DOWN) {
            // Half width grows from nothing at the apex to the whole cell at
            // the base, measured either side of centre. Taking the width and
            // then halving it instead leans the triangle to one side, which
            // reads as a right triangle rather than as an arrow
            let row = (dir == DIR_UP ? y : z - 1 - y).to_f();
            let half = row / 2.0;
            let a = (c - half + 0.5).floor().max(0);
            let b = (c + half + 0.5).floor().min(z - 1);
            x0 = a;
            len = b - a + 1;
        } else {
            // Sideways. The reach has to be scaled across the whole cell the
            // same way the vertical taper is: using the distance from centre
            // directly only narrows the shape to half width, which comes out
            // as a square with a small triangle stuck on it
            let d = (y.to_f() - c).abs();
            let reach = ((z - 1).to_f() * (1.0 - d / c) + 0.5).floor();
            if (reach < 0)
                continue;

            len = reach + 1;
            x0 = dir == DIR_LEFT ? z - 1 - reach : 0;
        }

        if (len <= 0)
            continue;

        runs.push(y);
        runs.push(x0);
        runs.push(len);
    }

    return runs;
}

let var shape_zoom = 0;
let var terrain_shapes = nil;
let var agent_shapes = nil;

fun build_shapes(z) {
    let shapes = Array.with_size(8, nil);

    shapes[CELL_ROCK] = ellipse_runs(z, 0.9, 0.8, COL_ROCK);
    shapes[CELL_PLANT] = diamond_runs(z, 1.0, COL_PLANT);
    shapes[CELL_SEED] = ellipse_runs(z, 0.45, 0.8, COL_SEED);
    shapes[CELL_CORPSE] = ellipse_runs(z, 0.8, 0.6, COL_CORPSE);

    let arrows = Array.with_size(4, nil);
    for (let var d = 0; d < 4; ++d)
        arrows[d] = arrow_runs(z, d);

    terrain_shapes = shapes;
    agent_shapes = arrows;
    shape_zoom = z;
}

fun draw_terrain_runs(buf, px, py, runs) {
    for (let var i = 0; i < runs.len; i = i + 4)
        fill_rect(buf, px + runs[i + 1], py + runs[i], runs[i + 2], 1, runs[i + 3]);
}

fun draw_agent_runs(buf, px, py, runs, color) {
    for (let var i = 0; i < runs.len; i = i + 3)
        fill_rect(buf, px + runs[i + 1], py + runs[i], runs[i + 2], 1, color);
}

// A 3x5 pixel font, one row of three bits per entry, so a glyph is five
// small numbers and the whole alphabet fits in a literal
let FONT = {
    "0": [7,5,5,5,7], "1": [2,6,2,2,7], "2": [7,1,7,4,7], "3": [7,1,7,1,7],
    "4": [5,5,7,1,1], "5": [7,4,7,1,7], "6": [7,4,7,5,7], "7": [7,1,1,1,1],
    "8": [7,5,7,5,7], "9": [7,5,7,1,7],
    "A": [7,5,7,5,5], "B": [6,5,6,5,6], "C": [7,4,4,4,7], "D": [6,5,5,5,6],
    "E": [7,4,7,4,7], "F": [7,4,7,4,4], "G": [7,4,5,5,7], "H": [5,5,7,5,5],
    "I": [7,2,2,2,7], "J": [1,1,1,5,7], "K": [5,5,6,5,5], "L": [4,4,4,4,7],
    "M": [5,7,7,5,5], "N": [6,5,5,5,5], "O": [7,5,5,5,7], "P": [7,5,7,4,4],
    "Q": [7,5,5,7,1], "R": [7,5,6,5,5], "S": [7,4,7,1,7], "T": [7,2,2,2,2],
    "U": [5,5,5,5,7], "V": [5,5,5,5,2], "W": [5,5,7,7,5], "X": [5,5,2,5,5],
    "Y": [5,5,2,2,2], "Z": [7,1,2,4,7],
    " ": [0,0,0,0,0], ":": [0,2,0,2,0], ".": [0,0,0,0,2], "/": [1,1,2,4,4],
    "-": [0,0,7,0,0], "%": [5,1,2,4,5], "+": [0,2,7,2,0]
};

fun fill_rect(buf, x, y, w, h, color) {
    let x0 = x.max(0);
    let y0 = y.max(0);
    let x1 = (x + w).min(FRAME_WIDTH);
    let y1 = (y + h).min(FRAME_HEIGHT);
    let run = x1 - x0;
    if (run <= 0)
        return;

    for (let var py = y0; py < y1; ++py)
        buf.fill_u32(py * FRAME_WIDTH + x0, run, color);
}

fun draw_text(buf, x, y, text, color, scale) {
    let var cx = x;

    for (let var i = 0; i < text.len; ++i) {
        let ch = text.char_at(i);

        if (FONT.has(ch)) {
            let rows = FONT[ch];
            for (let var r = 0; r < 5; ++r) {
                let bits = rows[r];
                for (let var c = 0; c < 3; ++c) {
                    if (((bits >> (2 - c)) & 1) != 0)
                        fill_rect(buf, cx + c * scale, y + r * scale, scale, scale, color);
                }
            }
        }

        cx = cx + 4 * scale;
    }
}

// The world, drawn cell by cell. Only the cells the viewport actually covers
// are visited, so the cost is bounded by the smaller of world and screen
// One island, drawn at an offset into the combined world. Takes a snapshot
// rather than an Island, since the renderer lives in the main actor and the
// islands live in their own
fun draw_island(buf, snap, origin_x, origin_y, cam_x, cam_y, zoom, shaped) {
    let grid = snap.grid;
    let colors = snap.colors;
    let dirs = snap.dirs;
    let hits = snap.hits;

    // The rows and columns of this island that fall inside the view
    let j0 = (origin_y - cam_y) * zoom < 0 ? (cam_y - origin_y) : 0;
    let i0 = (origin_x - cam_x) * zoom < 0 ? (cam_x - origin_x) : 0;
    let j1 = GRID_H.min(cam_y + FRAME_HEIGHT.idiv(zoom) + 1 - origin_y);
    let i1 = GRID_W.min(cam_x + VIEW_W.idiv(zoom) + 1 - origin_x);

    for (let var wy = j0.max(0); wy < j1; ++wy) {
        let py = (origin_y + wy - cam_y) * zoom;
        let row = wy * GRID_W;

        for (let var wx = i0.max(0); wx < i1; ++wx) {
            let cell = grid.get_u32(row + wx);
            let px = (origin_x + wx - cam_x) * zoom;
            let slot = cell >> 8;
            let terrain = cell & 0xFF;

            let has_agent = slot != 0;
            let hit = has_agent && hits.get_u32(slot) != 0;

            if (!shaped) {
                let var flat = TERRAIN_COLORS[terrain];
                if (has_agent)
                    flat = hit ? COL_HIT : colors.get_u32(slot);
                fill_rect(buf, px, py, zoom, zoom, flat);
                continue;
            }

            // The ground goes down first and the pictogram sits on top, so a
            // shape can be any outline without carrying its own background
            let shape = terrain_shapes[terrain];
            if (shape == nil) {
                fill_rect(buf, px, py, zoom, zoom, TERRAIN_COLORS[terrain]);
            } else {
                fill_rect(buf, px, py, zoom, zoom, COL_EMPTY);
                draw_terrain_runs(buf, px, py, shape);
            }

            if (!has_agent)
                continue;

            // The cell behind the agent goes red, so the arrow stays its own
            // colour and it is the one being hit that is marked, not the
            // one doing the hitting
            if (hit)
                fill_rect(buf, px, py, zoom, zoom, COL_HIT);

            draw_agent_runs(buf, px, py, agent_shapes[dirs.get_u32(slot)],
                            colors.get_u32(slot));
        }
    }
}

// The whole ring, laid out side by side so the camera crosses from one
// island to the next without anything special happening at the seam
fun draw_world(buf, snaps, cam_x, cam_y, zoom) {
    let shaped = zoom >= MIN_SHAPE_ZOOM;
    if (shaped && zoom != shape_zoom)
        build_shapes(zoom);

    for (let var i = 0; i < snaps.len; ++i) {
        let snap = snaps[i];
        if (snap == nil)
            continue;

        let ox = (i % TILE_COLS) * TILE_STEP_X;
        let oy = i.idiv(TILE_COLS) * TILE_STEP_Y;

        // Skip an island that falls entirely outside the view
        if ((ox + GRID_W - cam_x) * zoom < 0 || (ox - cam_x) * zoom > VIEW_W)
            continue;
        if ((oy + GRID_H - cam_y) * zoom < 0 || (oy - cam_y) * zoom > FRAME_HEIGHT)
            continue;

        draw_island(buf, snap, ox, oy, cam_x, cam_y, zoom, shaped);
    }
}

// Summed across the ring, except the tick count, which is per island and is
// taken as the slowest, and the averages, which are averaged again
// Seconds as HH:MM:SS, zero padded so the column does not jitter as the
// figures roll over
fun hhmmss(secs) {
    let h = secs.idiv(3600);
    let m = secs.idiv(60) % 60;
    let s = secs % 60;

    return h.to_s().lpad(2, '0') + ":" +
           m.to_s().lpad(2, '0') + ":" +
           s.to_s().lpad(2, '0');
}

fun draw_panel(buf, snaps, ticks_per_sec, zoom, paused, fast, status, elapsed) {
    fill_rect(buf, VIEW_W, 0, PANEL_W, FRAME_HEIGHT, COL_PANEL);

    let x = VIEW_W + 10;
    let var y = 12;

    let var ticks = 0;
    let var pop = 0; let var born = 0; let var seeded = 0;
    let var died = 0; let var killed = 0; let var eaten = 0;
    let var plants = 0; let var total_plants = 0;
    let var age = 0; let var energy = 0;
    let var crossed = 0; let var have = 0; let var gates = false;

    for (let var i = 0; i < snaps.len; ++i) {
        let s = snaps[i];
        if (s == nil)
            continue;

        // Summed, not the slowest island's count. Once the islands stop
        // being alike a populated one ticks far slower than one still down
        // at MIN_POP, so a minimum would report the laggard and hide the
        // rest. The sum is the work the ring has actually done, and TICKS/S
        // is the same quantity differenced, so the two agree
        ticks = ticks + s.tick_count;
        have = have + 1;
        pop = pop + s.pop;
        born = born + s.born;
        seeded = seeded + s.seeded;
        died = died + s.died;
        killed = killed + s.killed;
        eaten = eaten + s.eaten;
        plants = plants + s.plants;
        total_plants = total_plants + s.total_plants;
        age = age + s.mean_age;
        energy = energy + s.mean_energy;
        crossed = crossed + s.arrived;
        gates = gates || s.gates;
    }

    if (have == 0)
        have = 1;

    fun line(label, value, color) {
        draw_text(buf, x, y, label, COL_DIM, 2);
        draw_text(buf, x, y + 12, value, color, 2);
        y = y + 30;
    }

    draw_text(buf, x, y, "A-LIFE ISLANDS", COL_TEXT, 2);
    y = y + 26;

    // Wall clock the run has been going, as against the tick counts below,
    // which are the world's own clock
    line("RUN TIME", hhmmss(elapsed), COL_TEXT);

    line("TOTAL TICKS", ticks.comma_sep(), COL_TEXT);
    line("TICKS/S", ticks_per_sec.comma_sep(), COL_TEXT);
    line("AGENTS", pop.to_s(), COL_TEXT);
    line("BORN", born.comma_sep(), COL_TEXT);
    line("SEEDED", seeded.comma_sep(), COL_TEXT);
    line("DIED", died.comma_sep(), COL_TEXT);
    line("KILLED", killed.comma_sep(), COL_TEXT);
    line("EATEN", eaten.comma_sep(), COL_TEXT);

    // Plants and seeds together are conserved, so this is the share of the
    // world's food that is grown and edible right now rather than waiting to
    // hatch. It falls as the population learns to forage and then settles
    let avail = 100.0 * plants.to_f() / total_plants.max(1).to_f();
    line("PLANTS AVAIL", avail.format_decimals(1) + "%", COL_TEXT);

    line("MEAN AGE", age.idiv(have).comma_sep(), COL_TEXT);
    line("MEAN ENERGY", energy.idiv(have).comma_sep(), COL_TEXT);
    line("CROSSED", crossed.comma_sep(), gates ? COL_HIT : COL_TEXT);
    line("ZOOM", zoom.to_s(), COL_TEXT);

    let legend = [
        "DRAG   PAN",
        "ARROWS PAN",
        "Z X    ZOOM",
        "SPACE  PAUSE",
        "F      FAST",
        "S      SAVE"
    ];

    let legend_y = FRAME_HEIGHT - 16 - legend.len * 14;
    for (let var i = 0; i < legend.len; ++i)
        draw_text(buf, x, legend_y + i * 14, legend[i], COL_DIM, 2);

    if (paused)
        draw_text(buf, x, legend_y - 42, "PAUSED", COL_TEXT, 2);
    else if (fast)
        draw_text(buf, x, legend_y - 42, "FAST", COL_TEXT, 2);

    if (status != "")
        draw_text(buf, x, legend_y - 22, status, COL_TEXT, 2);
}

// --- Island actors ---
//
// One actor per island. They share nothing, so they run flat out on separate
// cores, and migrants go straight from one to its neighbour without passing
// through the main actor. An island never blocks on its mailbox: it polls
// between batches of ticks, because a blocked island is one that has stopped
// evolving

let MSG_SETUP = 0;     // index, seed, actor ids around the ring
let MSG_SPEED = 1;     // ms between ticks, or 0 to run flat out
let MSG_SNAP = 2;      // send the renderer a fresh snapshot
let MSG_MIGRANT = 3;   // an agent arriving from next door
let MSG_SAVE = 4;      // write this island's population to its own file

// How many ticks an island runs between mailbox polls when going flat out.
// Small enough that a migrant or a snapshot request is never held up long
let TICK_BATCH = 64;

fun island_actor() {
    let setup = $actor_recv();
    let index = setup[1];
    let ids = setup[3];
    let parent = $actor_parent();

    // Each island gets its own stream, so they do not evolve in lockstep
    let island = Island(setup[2] + index * 7919);

    // Around the ring. Gate 0 leads forward, gate 1 back
    let neighbours = [
        ids[(index + 1) % ids.len],
        ids[(index + ids.len - 1) % ids.len]
    ];

    let var tick_ms = 0;
    let var next_tick = 0;

    loop {
        loop {
            let msg = $actor_poll();
            if (msg == nil)
                break;

            let kind = msg[0];
            if (kind == MSG_SPEED)
                tick_ms = msg[1];
            else if (kind == MSG_SNAP) {
                let snap = island.snapshot();
                snap.index = index;
                $actor_send(parent, snap);
            }
            else if (kind == MSG_MIGRANT)
                island.immigrate(msg[1]);
            else if (kind == MSG_SAVE) {
                // One file per island, since each holds its own population
                let path = SAVE_PREFIX + index.to_s() + ".bin";
                let n = island.save(path);
                if (n >= 0)
                    $println("Saved " + n.to_s() + " genomes to " + path);
                else
                    $println("Failed to save to " + path);
            }
        }

        if (tick_ms == 0) {
            for (let var i = 0; i < TICK_BATCH; ++i)
                island.tick();
        }
        else {
            let now = $time_current_ms();
            if (now >= next_tick) {
                island.tick();
                next_tick = now + tick_ms;
            } else {
                $actor_sleep(2);
            }
        }

        // Anybody who walked through a gate goes to whoever is on the other
        // side of it
        let outbox = island.outbox;
        for (let var i = 0; i < outbox.len; ++i) {
            let record = outbox[i];
            $actor_send(neighbours[record[0]], [MSG_MIGRANT, record]);
        }
        outbox.resize(0, nil);
    }
}

// Spawns the ring and tells every island who its neighbours are. The actor
// ids only exist once everything has been spawned, which is why setup is a
// message rather than an argument
fun spawn_islands(seed) {
    let ids = [];
    for (let var i = 0; i < NUM_ISLANDS; ++i)
        ids.push($actor_spawn(island_actor));

    for (let var i = 0; i < NUM_ISLANDS; ++i)
        $actor_send(ids[i], [MSG_SETUP, i, seed, ids]);

    return ids;
}

fun broadcast(ids, msg) {
    for (let var i = 0; i < ids.len; ++i)
        $actor_send(ids[i], msg);
}

// --- Headless ---

// Polls every island for a snapshot and blocks until they all answer. Only
// used by the headless reporter, where there is nothing else to get on with
fun gather(ids, snaps) {
    broadcast(ids, [MSG_SNAP]);

    for (let var got = 0; got < ids.len; ++got) {
        let reply = $actor_recv();
        snaps[reply.index] = reply;
    }
}

fun run_headless(ids) {
    let limit = MAX_TICKS > 0 ? MAX_TICKS : 1000000;
    let snaps = Array.with_size(ids.len, nil);
    let start = $time_current_ms();

    $println(
        "Running headless to " + limit.comma_sep() + " ticks on " +
        ids.len.to_s() + " island" + (ids.len == 1 ? "" : "s") +
        ", seed " + WORLD_SEED.to_s()
    );
    $println("tick  agents  born  seeded  died  killed  eaten  plants  crossed  mean_age  ticks/s");

    let var last = start;
    let var last_total = 0;

    loop {
        $actor_sleep(1000);
        gather(ids, snaps);

        // Summed across the ring, except the tick count, which is per island
        // and is the slowest one, since that is what the run has reached
        // The slowest island's count, so that --ticks means every island
        // has run that far. The rate below is still the summed throughput
        let var ticks = -1;
        let var pop = 0; let var born = 0; let var seeded = 0;
        let var died = 0; let var killed = 0; let var eaten = 0;
        let var plants = 0; let var age = 0; let var total_ticks = 0;
        let var crossed = 0;

        for (let var i = 0; i < snaps.len; ++i) {
            let s = snaps[i];
            ticks = ticks < 0 ? s.tick_count : ticks.min(s.tick_count);
            total_ticks = total_ticks + s.tick_count;
            pop = pop + s.pop;
            born = born + s.born;
            seeded = seeded + s.seeded;
            died = died + s.died;
            killed = killed + s.killed;
            eaten = eaten + s.eaten;
            plants = plants + s.plants;
            age = age + s.mean_age;
            crossed = crossed + s.arrived;
        }

        let now = $time_current_ms();
        let rate = ((total_ticks - last_total).to_f() * 1000.0 /
                    (now - last).max(1).to_f()).floor();

        $println(
            ticks.comma_sep().rpad(10, ' ') +
            pop.to_s().rpad(8, ' ') +
            born.comma_sep().rpad(8, ' ') +
            seeded.comma_sep().rpad(8, ' ') +
            died.comma_sep().rpad(8, ' ') +
            killed.comma_sep().rpad(8, ' ') +
            eaten.comma_sep().rpad(8, ' ') +
            plants.comma_sep().rpad(8, ' ') +
            crossed.comma_sep().rpad(9, ' ') +
            age.idiv(snaps.len).comma_sep().rpad(10, ' ') +
            rate.comma_sep()
        );

        last = now;
        last_total = total_ticks;

        if (ticks >= limit)
            break;
    }
}

// --- Main ---

$println("World seed: " + WORLD_SEED.to_s() + "  (repeat this run with --seed " + WORLD_SEED.to_s() + ")");

let island_ids = spawn_islands(WORLD_SEED);
broadcast(island_ids, [MSG_SPEED, 0]);

if (HEADLESS) {
    run_headless(island_ids);
    $exit(0);
}

// The last snapshot each island sent. The renderer never waits on one: it
// draws whatever has arrived and asks again, so a busy island slows its own
// picture down rather than the whole window
let snaps = Array.with_size(NUM_ISLANDS, nil);
let var snap_pending = false;
let var last_snap = 0;

let frame_buffer = ByteArray.with_size(FRAME_WIDTH * FRAME_HEIGHT * 4);
let window = $window_create(FRAME_WIDTH, FRAME_HEIGHT, "A-Life Islands", 0);

let var zoom_idx = DEFAULT_ZOOM;
let var zoom = ZOOM_LEVELS[zoom_idx];
let var cam_x = 0;
let var cam_y = 0;
let var paused = false;
let var fast = true;
let var status = "";

let var dragging = false;
let var drag_x = 0;
let var drag_y = 0;

let var last_draw = 0;
let var sent_speed = -2;
let start_ms = $time_current_ms();
let var rate_time = $time_current_ms();
let var rate_tick = 0;
let var ticks_per_sec = 0;

fun clamp_camera() {
    let cells_w = VIEW_W.idiv(zoom);
    let cells_h = FRAME_HEIGHT.idiv(zoom);
    cam_x = cam_x.clip(0, (WORLD_CELLS_W - cells_w).max(0));
    cam_y = cam_y.clip(0, (WORLD_CELLS_H - cells_h).max(0));
}

// Zooming keeps whatever is at the centre of the view at the centre
fun set_zoom(new_idx) {
    let idx = new_idx.clip(0, ZOOM_LEVELS.len - 1);
    if (idx == zoom_idx)
        return;

    let cx = cam_x + VIEW_W.idiv(zoom).idiv(2);
    let cy = cam_y + FRAME_HEIGHT.idiv(zoom).idiv(2);

    zoom_idx = idx;
    zoom = ZOOM_LEVELS[idx];
    cam_x = cx - VIEW_W.idiv(zoom).idiv(2);
    cam_y = cy - FRAME_HEIGHT.idiv(zoom).idiv(2);
    clamp_camera();
}

clamp_camera();

loop {
    // Drain the event queue without blocking, since the simulation has to
    // keep running whether or not anything was clicked
    loop {
        let event = $actor_poll();
        if (event == nil)
            break;

        // Snapshots land in the same mailbox as the window events. A
        // snapshot is a dict and a window event is an object, so the two
        // need nothing added to tell them apart
        if (event instanceof Dict) {
            snaps[event.index] = event;
            snap_pending = false;
            continue;
        }

        if (event.kind == "CLOSE_WINDOW")
            $exit(0);

        if (event.kind == "KEY_DOWN") {
            let key = event.key;

            if (key == "SPACE")
                paused = !paused;
            else if (key == "F")
                fast = !fast;
            else if (key == "X")
                set_zoom(zoom_idx + 1);
            else if (key == "Z")
                set_zoom(zoom_idx - 1);
            else if (key == "LEFT")
                cam_x = cam_x - 8;
            else if (key == "RIGHT")
                cam_x = cam_x + 8;
            else if (key == "UP")
                cam_y = cam_y - 8;
            else if (key == "DOWN")
                cam_y = cam_y + 8;
            else if (key == "S") {
                // Each island writes its own file, and reports as it does
                broadcast(island_ids, [MSG_SAVE]);
                status = "SAVING";
            }

            clamp_camera();
        }
        else if (event.kind == "MOUSE_DOWN") {
            dragging = true;
            drag_x = event.x;
            drag_y = event.y;
        }
        else if (event.kind == "MOUSE_UP") {
            dragging = false;
        }
        else if (event.kind == "MOUSE_MOVE") {
            if (dragging) {
                cam_x = cam_x - (event.x - drag_x).idiv(zoom);
                cam_y = cam_y - (event.y - drag_y).idiv(zoom);

                // Only consume the motion that moved a whole cell, so the
                // remainder is not thrown away on every event
                drag_x = drag_x - (event.x - drag_x).idiv(zoom) * zoom;
                drag_y = drag_y - (event.y - drag_y).idiv(zoom) * zoom;
                drag_x = event.x;
                drag_y = event.y;
                clamp_camera();
            }
        }
    }

    // The main actor no longer simulates anything: it only says how fast the
    // islands should run, and they get on with it
    let want_speed = paused ? -1 : (fast ? 0 : SLOW_TICK_MS);
    if (want_speed != sent_speed) {
        broadcast(island_ids, [MSG_SPEED, want_speed.max(0)]);
        if (paused)
            broadcast(island_ids, [MSG_SPEED, 1_000_000]);
        sent_speed = want_speed;
    }

    let now = $time_current_ms();

    // Asking again only once the last round has landed, so a slow island
    // cannot pile up requests it will never catch up with
    if (!snap_pending && now >= last_snap + SNAP_PERIOD_MS) {
        broadcast(island_ids, [MSG_SNAP]);
        snap_pending = true;
        last_snap = now;
    }

    if (now >= rate_time + 1000) {
        let var total = 0;
        for (let var i = 0; i < snaps.len; ++i)
            if (snaps[i] != nil)
                total = total + snaps[i].tick_count;

        ticks_per_sec = ((total - rate_tick).to_f() * 1000.0 /
                         (now - rate_time).to_f()).floor().max(0);
        rate_time = now;
        rate_tick = total;
    }

    if (now >= last_draw + DRAW_PERIOD_MS) {
        fill_rect(frame_buffer, 0, 0, VIEW_W, FRAME_HEIGHT, COL_EMPTY);
        draw_world(frame_buffer, snaps, cam_x, cam_y, zoom);
        draw_panel(frame_buffer, snaps, ticks_per_sec, zoom, paused, fast, status,
                   (now - start_ms).idiv(1000));
        $window_draw_frame(window, frame_buffer);
        last_draw = now;
    }

    // The islands are off on their own actors, so this one has nothing to do
    // between frames but wait for them
    $actor_sleep(2);
}
