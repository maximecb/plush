// Spoken word detector.
//
// Records short clips from your microphone and trains a small neural net, in
// the background, to recognize one spoken word. Once the net is confident
// enough, hearing that word plays a beep.
//
// Controls:
//   SPACE  start recording, press again to stop
//   P      save the recording as a positive example (the word to detect)
//   N      save it as a negative example (silence, noise, other words)
//   Close the window to quit
//
// A red dot in the top-right corner shows while recording. Record a dozen or
// so examples of each kind, keeping them short. Training runs continuously and
// prints its loss and example counts to the console.

from ./random import *;

// Constants
let SAMPLE_RATE = 44100;
let NUM_CHANNELS = 1;
let WINDOW_WIDTH = 400;
let WINDOW_HEIGHT = 300;
let FFT_SIZE = 512; // Must be a power of 2
let NUM_MEL_BINS = 32;
let PI = 3.141592653589793;

let MIN_FREQ = 300.0;
let MAX_FREQ = 3500.0;

let MAX_FRAMES = 64;
let HIDDEN_SIZE = 64;
let LEARNING_RATE = 0.01;
let INPUT_SIZE = MAX_FRAMES * NUM_MEL_BINS;
let OUTPUT_SIZE = 1;
let DETECTION_THRESHOLD = 0.92;
let NOISE_MAGNITUDE = 0.12;
let GRADIENT_CLIP_THRESHOLD = 1.0;
let MAX_ZERO_FRAMES_TO_ADD = 10;

// Helper function to convert RGB values to a 32-bit color
fun rgb32(r, g, b) {
    // The alpha channel is set to 0xFF (fully opaque)
    return 0xFF000000 | (r << 16) | (g << 8) | b;
}

fun random_f32(size, lo, hi) {
    let ba = ByteArray.with_size(size * 4);
    for (let var i = 0; i < size; ++i) {
        ba.set_f32(i, rand_float(lo, hi));
    }
    return ba;
}

// --- MLP Definition ---
//
// Every weight and activation lives in a ByteArray of float32 rather than an
// array of boxed floats. That is what lets the layers be written as calls to
// `dot_f32`, which sums a run of float32 products on the host instead of one
// bytecode multiply and add at a time.
//
// Both weight matrices are stored row-major in one flat run, so row `r` of W1
// is the `input_size` floats starting at `r * input_size`.
class MLP {
    init(self, input_size, hidden_size, output_size) {
        self.input_size = input_size;
        self.hidden_size = hidden_size;
        self.output_size = output_size;

        self.W1 = random_f32(hidden_size * input_size, -0.5, 0.5);
        self.b1 = random_f32(hidden_size, -0.5, 0.5);
        self.W2 = random_f32(output_size * hidden_size, -0.5, 0.5);
        self.b2 = random_f32(output_size, -0.5, 0.5);

        // Held on the model and written in place, so that a training step
        // allocates nothing
        self.z1 = ByteArray.with_size(hidden_size * 4);
        self.a1 = ByteArray.with_size(hidden_size * 4);
        self.d_z1 = ByteArray.with_size(hidden_size * 4);
        self.d_loss = ByteArray.with_size(output_size * 4);
    }

    // `x` is a ByteArray of input_size float32 values
    forward(self, x) {
        let n = self.input_size;
        let h = self.hidden_size;
        let W1 = self.W1;
        let b1 = self.b1;
        let z1 = self.z1;
        let a1 = self.a1;

        // Hidden layer: one row of W1 against the input, then ReLU
        for (let var r = 0; r < h; ++r) {
            let z = W1.dot_f32(r * n, 1, x, 0, 1, n) + b1.get_f32(r);
            z1.set_f32(r, z);
            a1.set_f32(r, z.max(0.0));
        }

        // Output layer, then the sigmoid
        let y_pred = Array.with_size(self.output_size, 0.0);
        for (let var o = 0; o < self.output_size; ++o) {
            let z = self.W2.dot_f32(o * h, 1, a1, 0, 1, h) + self.b2.get_f32(o);
            y_pred[o] = 1.0 / (1.0 + (-z).exp());
        }

        return y_pred;
    }

    // Leaves the gradients of the pre-activations in d_loss and d_z1. The
    // weight gradients themselves are outer products, and are never built:
    // `update` uses each element once, where it is needed.
    backward(self, y_true, y_pred) {
        let h = self.hidden_size;
        let d_loss = self.d_loss;

        for (let var o = 0; o < self.output_size; ++o) {
            d_loss.set_f32(o, y_pred[o] - y_true[o]);
        }

        // d_a1 is W2 transposed times d_loss. Column `r` of W2 is a run with
        // a stride of hidden_size, which dot_f32 reads without transposing.
        for (let var r = 0; r < h; ++r) {
            let d_a1 = self.W2.dot_f32(r, h, d_loss, 0, 1, self.output_size);

            // ReLU passes a gradient through only where it was active
            if (self.z1.get_f32(r) > 0.0) {
                self.d_z1.set_f32(r, d_a1);
            } else {
                self.d_z1.set_f32(r, 0.0);
            }
        }
    }

    update(self, x, learning_rate) {
        let n = self.input_size;
        let h = self.hidden_size;
        let W1 = self.W1;
        let b1 = self.b1;

        for (let var r = 0; r < h; ++r) {
            let g = learning_rate * self.d_z1.get_f32(r);

            // ReLU leaves most rows with no gradient at all, and the row is
            // the expensive part
            if (g != 0.0) {
                let row = r * n;
                for (let var c = 0; c < n; ++c) {
                    W1.set_f32(row + c, W1.get_f32(row + c) - g * x.get_f32(c));
                }
            }

            b1.set_f32(r, b1.get_f32(r) - g);
        }

        for (let var o = 0; o < self.output_size; ++o) {
            let g = learning_rate * self.d_loss.get_f32(o);
            let row = o * h;
            for (let var c = 0; c < h; ++c) {
                self.W2.set_f32(row + c, self.W2.get_f32(row + c) - g * self.a1.get_f32(c));
            }
            self.b2.set_f32(o, self.b2.get_f32(o) - g);
        }
    }
}

// Function to perform in-place iterative FFT (Cooley-Tukey)
fun fft(real_parts, imag_parts, inverse) {
    let n = real_parts.num_f32();
    if (n == 0) {
        return;
    }
    let var i = 0;
    let var j = 0;
    while (i < n) {
        if (j > i) {
            let temp_re = real_parts.get_f32(i);
            real_parts.set_f32(i, real_parts.get_f32(j));
            real_parts.set_f32(j, temp_re);
            let temp_im = imag_parts.get_f32(i);
            imag_parts.set_f32(i, imag_parts.get_f32(j));
            imag_parts.set_f32(j, temp_im);
        }
        let var m = n.idiv(2);
        while (m >= 1 && j >= m) {
            j = j - m;
            m = m.idiv(2);
        }
        j = j + m;
        i = i + 1;
    }
    let var len = 2;
    while (len <= n) {
        let var ang = 2.0 * PI / len;
        if (inverse) {
            ang = -ang;
        }
        let wlen_re = ang.cos();
        let wlen_im = ang.sin();
        let var i = 0;
        while (i < n) {
            let var w_re = 1.0;
            let var w_im = 0.0;
            let var j = 0;
            while (j < len.idiv(2)) {
                let u_re = real_parts.get_f32(i + j);
                let u_im = imag_parts.get_f32(i + j);
                let x_half_re = real_parts.get_f32(i + j + len.idiv(2));
                let x_half_im = imag_parts.get_f32(i + j + len.idiv(2));
                let v_re = x_half_re * w_re - x_half_im * w_im;
                let v_im = x_half_re * w_im + x_half_im * w_re;
                real_parts.set_f32(i + j, u_re + v_re);
                imag_parts.set_f32(i + j, u_im + v_im);
                real_parts.set_f32(i + j + len.idiv(2), u_re - v_re);
                imag_parts.set_f32(i + j + len.idiv(2), u_im - v_im);
                let next_w_re = w_re * wlen_re - w_im * wlen_im;
                let next_w_im = w_re * wlen_im + w_im * wlen_re;
                w_re = next_w_re;
                w_im = next_w_im;
                j = j + 1;
            }
            i = i + len;
        }
        len = len * 2;
    }
    if (inverse) {
        for (let var k = 0; k < n; ++k) {
            real_parts.set_f32(k, real_parts.get_f32(k) / n);
            imag_parts.set_f32(k, imag_parts.get_f32(k) / n);
        }
    }
}

fun hanning_window(buffer) {
    let n = buffer.num_f32();
    for (let var i = 0; i < n; ++i) {
        let multiplier = 0.5 * (1.0 - (2.0 * PI * i / (n - 1)).cos());
        buffer.set_f32(i, buffer.get_f32(i) * multiplier);
    }
}

fun normalize_magnitudes(magnitudes) {
    let var max_mag = 1e-9;
    for (let var i = 0; i < magnitudes.len; ++i) {
        if (magnitudes[i] > max_mag) {
            max_mag = magnitudes[i];
        }
    }

    // Don't amplify silence or near-silence
    if (max_mag < 1.0) {
        return magnitudes;
    }

    for (let var i = 0; i < magnitudes.len; ++i) {
        magnitudes[i] = magnitudes[i] / max_mag;
    }

    return magnitudes;
}

fun mel_bins(real_parts, imag_parts, num_bins, min_freq, max_freq, fft_size, sample_rate) {
    let fft_bins = Array.with_size(num_bins + 2, 0);
    for (let var i = 0; i < fft_bins.len; ++i) {
        let freq = min_freq * (max_freq/min_freq).pow(i.to_f() / (num_bins + 1).to_f());
        fft_bins[i] = (freq * fft_size / sample_rate).floor();
    }
    let magnitudes = Array.with_size(num_bins, 0.0);
    for (let var band_idx = 0; band_idx < num_bins; ++band_idx) {
        let var band_magnitude = 0.0;
        let start_bin = fft_bins[band_idx];
        let center_bin = fft_bins[band_idx + 1];
        let end_bin = fft_bins[band_idx + 2];
        let max_bin = (fft_size / 2) - 1;
        if (start_bin > max_bin) continue;
        for (let var bin = start_bin; bin <= end_bin; ++bin) {
            if (bin > max_bin) break;
            let re = real_parts.get_f32(bin);
            let im = imag_parts.get_f32(bin);
            let magnitude = (re * re + im * im).sqrt();
            let var weight = 0.0;
            if (bin >= start_bin && bin <= center_bin) {
                if (center_bin - start_bin > 0) {
                    weight = (bin - start_bin).to_f() / (center_bin - start_bin);
                } else if (bin == center_bin) {
                    weight = 1.0;
                }
            } else if (bin > center_bin && bin <= end_bin) {
                if (end_bin - center_bin > 0) {
                    weight = (end_bin - bin).to_f() / (end_bin - center_bin);
                }
            }
            band_magnitude = band_magnitude + magnitude * weight;
        }
        magnitudes[band_idx] = band_magnitude;
    }
    return magnitudes;
}

// Produces the network's input: one ByteArray of float32, which is what
// `MLP.forward` reads. A new ByteArray is zeroed, so the padding is already
// in place when there are fewer frames than fit.
fun flatten_and_pad(frames, max_frames, num_bins) {
    let flat = ByteArray.with_size(max_frames * num_bins * 4);
    let num_frames = frames.len.min(max_frames);

    // Write frames in reverse order, so the most recent frames are at the end of the flattened array
    for (let var i = 0; i < num_frames; ++i) {
        let frame = frames[num_frames - 1 - i]; // Get frames in reverse chronological order
        let flat_start_idx = (max_frames - 1 - i) * num_bins; // Calculate target index in flat array
        for (let var j = 0; j < num_bins; ++j) {
            flat.set_f32(flat_start_idx + j, frame[j]);
        }
    }

    return flat;
}

fun training_actor(detection_actor_id) {
    rand_init($time_current_ms());
    let mlp = MLP(INPUT_SIZE, HIDDEN_SIZE, OUTPUT_SIZE);

    let training_data = [];
    let var iteration_count = 0;
    let var positive_examples_count = 0;
    let var negative_examples_count = 0;

    // The loss of any one example swings too much to read anything from, so
    // what gets printed is an exponential moving average of it. The weight
    // gives it a memory of roughly the last hundred steps.
    let LOSS_SMOOTHING = 0.01;
    let var avg_loss = nil;

    for (let var training_itr = 1;; ++training_itr) {
        let msg = $actor_poll();
        if (msg != nil) {
            training_data.push(msg);
            if (msg[1] == 1.0) {
                positive_examples_count = positive_examples_count + 1;
            } else {
                negative_examples_count = negative_examples_count + 1;
            }
            $println("Positive samples: " + positive_examples_count.to_s() + ", negative samples: " + negative_examples_count.to_s());
        }

        if (training_data.len > 0) {
            let idx = rand_int(0, training_data.len);
            let sample = training_data[idx];
            let frames = sample[0];
            let label = sample[1];

            let var current_frames = frames;

            // For negative examples, randomly truncate the frames
            if (label == 0.0 && frames.len > 1) {
                let max_len = frames.len;
                let var start_idx = rand_int(0, max_len);
                let var end_idx = rand_int(start_idx, max_len);
                if (start_idx == end_idx) {
                    // Ensure at least one frame is selected
                    end_idx = start_idx + 1;
                    if (end_idx > max_len) end_idx = max_len;
                }

                let truncated_len = end_idx - start_idx;
                let truncated_frames = Array.with_size(truncated_len, nil);
                for (let var i = 0; i < truncated_len; ++i) {
                    truncated_frames[i] = frames[start_idx + i];
                }
                current_frames = truncated_frames;
            }

            // For negative examples, randomly append zero frames
            if (label == 0.0 && MAX_ZERO_FRAMES_TO_ADD > 0) {
                let num_zero_frames = rand_int(0, MAX_ZERO_FRAMES_TO_ADD + 1);
                if (num_zero_frames > 0) {
                    let zero_frame = Array.with_size(NUM_MEL_BINS, 0.0);
                    for (let var i = 0; i < num_zero_frames; ++i) {
                        current_frames.push(zero_frame);
                    }
                }
            }

            // With a small probability, for negative examples only, randomly permute the frames
            if (label == 0.0 && current_frames.len > 1 && rand_float(0.0, 1.0) < 0.30) {
                let n = current_frames.len;
                for (let var i = n - 1; i > 0; --i) {
                    let j = rand_int(0, i + 1);
                    let temp = current_frames[i];
                    current_frames[i] = current_frames[j];
                    current_frames[j] = temp;
                }
            }

            let x = flatten_and_pad(current_frames, MAX_FRAMES, NUM_MEL_BINS);

            // Data augmentation: scale the whole example, then add noise
            let scale_factor = 1.0 + (rand_float(-0.5, 0.5) * 0.35);
            for (let var i = 0; i < INPUT_SIZE; ++i) {
                x.set_f32(i, x.get_f32(i) * scale_factor + rand_float(-0.5, 0.5) * NOISE_MAGNITUDE);
            }

            let y_true = [label];

            let y_pred = mlp.forward(x);
            mlp.backward(y_true, y_pred);
            mlp.update(x, LEARNING_RATE);

            let p = y_pred[0].max(1e-9).min(1.0 - 1e-9);
            let y = y_true[0];
            let loss = -(y * p.ln() + (1.0 - y) * (1.0 - p).ln());

            // The first example has nothing to average with, so it starts
            // the average off rather than being blended into zero
            if (avg_loss == nil) {
                avg_loss = loss;
            } else {
                avg_loss = avg_loss + LOSS_SMOOTHING * (loss - avg_loss);
            }

            if (iteration_count % 1 == 0) {
                $println(
                    "Itr#" + training_itr.to_s() +
                    ", loss: " + avg_loss.format_decimals(5) +
                    ", pos: " +
                    positive_examples_count.to_s() +
                    ", neg: " +
                    negative_examples_count.to_s()
                );
            }

            iteration_count = iteration_count + 1;
            if (iteration_count % 100 == 0) {
                // Send the current model to the detection actor
                //$println("Sending model update to detection actor.");
                $actor_send(detection_actor_id, mlp);
            }
        }

        $actor_sleep(10);
    }
}

fun detection_actor(beep_actor_id) {
    let var current_mlp = nil;
    let var frame_buffer = []; // To store recent magnitudes

    while (true) {
        let msg = $actor_poll(); // Blocks until a message is received

        if (msg instanceof MLP) {
            // Received a new MLP model from the training actor
            current_mlp = msg;
            continue;
        }

        if (msg instanceof Array) {
            // Received magnitudes from the main actor
            let magnitudes = msg;
            frame_buffer.push(magnitudes);

            // Keep only the latest MAX_FRAMES
            if (frame_buffer.len > MAX_FRAMES) {
                // If buffer is full, remove the oldest frame (at index 0)
                // and add the new one at the end.
                // Plush arrays don't have a direct slice/shift, so we'll rebuild.
                let new_frame_buffer = Array.with_size(MAX_FRAMES, nil);
                for (let var i = 0; i < MAX_FRAMES - 1; ++i) {
                    new_frame_buffer[i] = frame_buffer[i + 1];
                }
                new_frame_buffer[MAX_FRAMES - 1] = magnitudes;
                frame_buffer = new_frame_buffer;
            }
            assert(frame_buffer.len <= MAX_FRAMES);
        }

        // Only make a prediction if we have enough frames
        if (msg == nil && current_mlp != nil && frame_buffer.len == MAX_FRAMES) {
            let x = flatten_and_pad(frame_buffer, MAX_FRAMES, NUM_MEL_BINS);
            let y_pred = current_mlp.forward(x);

            if (y_pred[0] > DETECTION_THRESHOLD) {
                $println("DETECTED: " + y_pred[0].format_decimals(1));
                $actor_send(beep_actor_id, "detected");
            }
        }
    }
}

fun beep_actor() {
    let audio_out_id = $audio_open_output(SAMPLE_RATE, NUM_CHANNELS);

    let var is_recording = false;
    let var last_beep_time = 0;
    let cooldown_ms = 1200;

    let beep_duration_ms = 80;
    let pause_duration_ms = 30;
    let beep_freq = 1200.0;

    let beep_duration_samples = (SAMPLE_RATE * beep_duration_ms).idiv(1000);
    let pause_duration_samples = (SAMPLE_RATE * pause_duration_ms).idiv(1000);

    let var beep_state = 0; // 0:idle, 1:beep1, 2:pause1, 3:beep2, 4:pause2, 5:beep3
    let var samples_in_state = 0;
    let var time_in_beep = 0;

    loop {
        let msg = $actor_recv();

        if (msg == true || msg == false) {
            is_recording = msg;
            last_beep_time = $time_current_ms();
            continue;
        }

        if (msg == "detected" && !is_recording) {
            let current_time = $time_current_ms();
            if (current_time - last_beep_time > cooldown_ms) {
                last_beep_time = current_time;
                if (beep_state == 0) { // Start only if idle
                    beep_state = 1;
                    samples_in_state = 0;
                    time_in_beep = 0;
                }
            }
            continue;
        }

        if (msg instanceof AudioNeeded) {
            let num_samples_needed = msg.num_samples;
            let samples = ByteArray.with_size(num_samples_needed * 4);

            for (let var i = 0; i < num_samples_needed; ++i) {
                let var sample_val = 0.0;

                if (beep_state == 1 || beep_state == 3 || beep_state == 5) { // Beeping
                    let period_samples = (SAMPLE_RATE.to_f() / beep_freq).trunc();
                    let pos_in_period = time_in_beep % period_samples;
                    let half_period = (period_samples / 2).trunc();

                    if (pos_in_period < half_period) {
                        sample_val = -0.5 + (pos_in_period.to_f() / half_period.to_f());
                    } else {
                        sample_val = 0.5 - ((pos_in_period - half_period).to_f() / half_period.to_f());
                    }
                    time_in_beep = time_in_beep + 1;

                    samples_in_state = samples_in_state + 1;
                    if (samples_in_state >= beep_duration_samples) {
                        beep_state = beep_state + 1; // to pause or idle
                        samples_in_state = 0;
                        if (beep_state == 6) { beep_state = 0; } // End of sequence
                    }
                }
                else if (beep_state == 2 || beep_state == 4) { // Pausing
                    samples_in_state = samples_in_state + 1;
                    if (samples_in_state >= pause_duration_samples) {
                        beep_state = beep_state + 1; // to next beep
                        samples_in_state = 0;
                        time_in_beep = 0; // Reset phase for next beep
                    }
                }

                samples.set_f32(i, sample_val);
            }

            $audio_write_samples(audio_out_id, samples);
        }
    }
}

fun print_usage() {
    $println("Word detector");
    $println("");
    $println("  SPACE  start recording, press again to stop");
    $println("  P      save the recording as a positive example (the word to detect)");
    $println("  N      save it as a negative example (silence, noise, other words)");
    $println("  Close the window to quit");
    $println("");
    $println("Record a dozen or so short examples of each kind. Training runs");
    $println("continuously, and a beep plays once the word is detected.");
    $println("");
}

fun main() {
    print_usage();

    let beep_actor_id = $actor_spawn(beep_actor);
    let detector_id = $actor_spawn(|| detection_actor(beep_actor_id));
    let trainer_id = $actor_spawn(|| training_actor(detector_id));

    let window_id = $window_create(WINDOW_WIDTH, WINDOW_HEIGHT, "Word Detector", 0);
    let audio_input_device_id = $audio_open_input(SAMPLE_RATE, NUM_CHANNELS);

    let real_parts = ByteArray.with_size(FFT_SIZE * 4);
    let imag_parts = ByteArray.with_size(FFT_SIZE * 4);
    imag_parts.zero_fill();

    let frame_buffer = ByteArray.with_size(WINDOW_WIDTH * WINDOW_HEIGHT * 4);

    let var running = true;
    let var recording = false;
    let var recorded_frames = [];

    while (running) {
        $audio_read_samples(audio_input_device_id, FFT_SIZE, real_parts, 0);
        imag_parts.zero_fill();
        hanning_window(real_parts);
        fft(real_parts, imag_parts, false);
        let var magnitudes = mel_bins(real_parts, imag_parts, NUM_MEL_BINS, MIN_FREQ, MAX_FREQ, FFT_SIZE, SAMPLE_RATE);
        magnitudes = normalize_magnitudes(magnitudes);
        $actor_send(detector_id, magnitudes);

        if (recording) {
            recorded_frames.push(magnitudes);
        }

        frame_buffer.zero_fill();
        if (recording) {
            let cx = WINDOW_WIDTH - 30;
            let cy = 30;
            let radius = 20;
            for (let var y = cy - radius; y < cy + radius; ++y) {
                for (let var x = cx - radius; x < cx + radius; ++x) {
                    let dx = x - cx;
                    let dy = y - cy;
                    if (dx*dx + dy*dy < radius*radius) {
                        let pixel_idx = (y * WINDOW_WIDTH + x);
                        frame_buffer.set_u32(pixel_idx, rgb32(255, 0, 0));
                    }
                }
            }
        }

        $window_draw_frame(window_id, frame_buffer);

        let event = $actor_poll();
        if (event instanceof UIEvent) {
            if (event.kind == "CLOSE_WINDOW") {
                running = false;
            }

            if (event.kind == "KEY_DOWN") {
                if (event.key == "SPACE") {
                    recording = !recording;
                    $actor_send(beep_actor_id, recording);
                    if (!recording && recorded_frames.len > 0) {
                        $println("Recording stopped. Press P for positive, N for negative.");
                    } else if (recording) {
                        $println("Recording started...");
                        recorded_frames = [];
                    }
                } else if (recorded_frames.len > 0) {
                    if (event.key == "P") {
                        $println("Saved as positive example.");
                        $actor_send(trainer_id, [recorded_frames, 1.0]);
                        recorded_frames = [];
                        recording = false; // Stop recording when labeled
                        $actor_send(beep_actor_id, recording);
                    } else if (event.key == "N") {
                        $println("Saved as negative example.");
                        $actor_send(trainer_id, [recorded_frames, 0.0]);
                        recorded_frames = [];
                        recording = false; // Stop recording when labeled
                        $actor_send(beep_actor_id, recording);
                    }
                }
            }
        }
    }
}

main();
