// Spoken word detector.
//
// Records short clips from your microphone and trains a small neural net, in
// the background, to recognize the words you name. Every word you teach it
// gets its own output on the shared network. Hearing the wake word plays a
// beep; every other word just lights up in the list.
//
// Controls:
//   Hold ENTER   record, release to stop. The clip plays back trimmed.
//   Then type    the word that was just said, ENTER to save it
//   "noise"      label a clip that is not a word at all
//   Empty + ENTER  save as a negative sample, teaching no output at all
//   BACKSPACE    delete a character, or discard the recording when empty
//   ESC or the X button   discard the recording
//   Close the window to quit
//
// Record a dozen or so examples of each word, keeping them short, plus a good
// number of noise clips. Training runs continuously in the background.
//
// Every sample is saved as a WAV file in ./speech_data, labeled in
// speech_data/labels.csv, and the samples there are loaded on startup.

from random import Xoshiro128;
from image import Image, rgb, COLOR_BLACK, COLOR_WHITE, COLOR_RED, COLOR_GREY;
from pixelfont import PixelFont;
from wav import AudioData, load_wav, save_wav;
from csv import parse_csv_file, format_csv;

let rng = Xoshiro128(1);

// Constants
let SAMPLE_RATE = 44100;
let NUM_CHANNELS = 1;
let WINDOW_WIDTH = 760;
let WINDOW_HEIGHT = 560;
let FFT_SIZE = 512; // Must be a power of 2
let NUM_MEL_BINS = 32;
let PI = 3.141592653589793;

let MIN_FREQ = 300.0;
let MAX_FREQ = 3500.0;

let MAX_FRAMES = 96;
let HIDDEN_SIZE = 64;
// Higher than an MLP with large initial weights would use, since the layers
// start at the He scale and learn slowly at 0.01
let LEARNING_RATE = 0.05;
let INPUT_SIZE = MAX_FRAMES * NUM_MEL_BINS;
let DETECTION_THRESHOLD = 0.92;

// Consecutive frames the same word must win before a detection counts, to
// smooth out flickers on words that briefly cross the threshold. At 2, the
// start or middle of a word still triggered other words several times as
// often, for about 23ms less delay.
let CONFIRM_FRAMES = 4;

// Frames of enforced quiet after a detection fires, before another can
let COOLDOWN_FRAMES = 12;
let NOISE_MAGNITUDE = 0.12;
let GRADIENT_CLIP_THRESHOLD = 1.0;

// Probability of dropping each output of the hidden layer in training. It
// detected more words in new recordings, for as many wrong ones. Dropout in
// the convolutional layers did worse.
let HIDDEN_DROPOUT = 0.5;

// Data augmentation: probability of dropping any given frame in training
let FRAME_DROP_PROB = 0.05;

// Data augmentation: probability of repeating any given frame, so words are
// also seen stretched, as if spoken more slowly, rather than only shortened
let FRAME_DUP_PROB = 0.1;

// Data augmentation: probability of shifting the pitch of a whole example,
// and by how many semitones at most, up or down. Every frequency is scaled,
// which moves the formants along with the voice. Larger shifts did worse on
// the recordings tested.
let PITCH_SHIFT_PROB = 0.5;
let PITCH_SHIFT_MAX_SEMITONES = 3.0;

// Strength of the log compression of the network's input, see
// compress_input(). Without it, the end of "one" fired "no" far more often.
let LOG_COMPRESSION = 100.0;

// Data augmentation: probability of adding background noise to an example,
// and the range of its level, as an RMS amplitude, picked on a log scale.
// Without it, training only ever saw exact silence around words, and words
// were often missed over a noisy room.
let BG_NOISE_PROB = 0.5;
let BG_NOISE_MIN_RMS = 0.0001;
let BG_NOISE_MAX_RMS = 0.01;

// Highest FFT bin any mel band reads
let MEL_TOP_BIN = (MAX_FREQ * FFT_SIZE / SAMPLE_RATE).floor();

// FFT magnitudes kept per frame for training, enough for the mel bands to
// read from when the pitch is shifted down as far as it goes
let SPEC_BINS = ((MEL_TOP_BIN.to_f() * 2.0.pow(PITCH_SHIFT_MAX_SEMITONES / 12.0)).floor() + 2).min(FFT_SIZE.idiv(2));

// Probability that an example drawn from a word clip is made into a negative
// example, trained as no word at all, rather than a positive one
let NEG_FROM_WORD_PROB = 0.5;

// Of the negative examples made from words, the fraction that are the whole
// word followed by more silence than the grace period below. The rest are a
// crop of the word, of 1 frame up to NEG_CROP_MAX_FRAC of it, so the window
// catching part of one word doesn't fire another. Crops are never trained
// as the word itself: the first sound of a word can't tell it apart from
// other words.
let NEG_WORD_THEN_SILENCE_PROB = 0.5;
let NEG_CROP_MAX_FRAC = 0.75;

// Which part of a word a crop is taken from: the end with this probability,
// anywhere in the word with the next, and otherwise the start. Crops from
// the end roughly halved how often "one" fired "no".
let NEG_CROP_SUFFIX_PROB = 0.25;
let NEG_CROP_ANYWHERE_PROB = 0.25;

// Negative examples get their frames reordered: fully shuffled with this
// probability, and otherwise with each neighbouring pair swapped with the
// next probability
let NEG_SHUFFLE_PROB = 0.2;
let NEG_SWAP_PROB = 0.1;

// Probability of trailing silence after a crop or a recorded negative
// example, anywhere up to a full window of it. Off, since it cost hits on
// new recordings.
let NEG_TRAILING_SILENCE_PROB = 0.0;

// Positive examples may be followed by a little silence, up to a grace
// period, so a slight lag catching the end of a word still reads as a hit.
// Past the grace period the word is gone, and nothing, including it,
// should still be firing. Off, since it made words fire others more often.
let POS_TRAILING_SILENCE_PROB = 0.0;
let TRAILING_SILENCE_GRACE_MS = 150;
let TRAILING_SILENCE_GRACE_FRAMES = (SAMPLE_RATE * TRAILING_SILENCE_GRACE_MS).idiv(1000 * FFT_SIZE);
let TRAILING_SILENCE_MAX_FRAMES = MAX_FRAMES;

// The one word that plays a beep. Every other word you teach is still
// detected and shown, it just doesn't make a sound.
let WAKE_WORD = "computer";

// Label for sounds that are not a word at all. It is an ordinary output as
// far as the network is concerned, and only the display treats it specially:
// pinned to the bottom of the list and lit in red rather than green.
let NOISE_WORD = "noise";

// Label of negative samples, and name of the network's output for no word
let NONE_LABEL = "";

// Longest clip that gets kept for playback
let MAX_RECORD_SECS = 5;
let MAX_RECORD_SAMPLES = SAMPLE_RATE * MAX_RECORD_SECS;

// Cut off both ends of every recording: first a fixed amount, to remove the
// key press and release, then any silence left past that
let TRIM_MS = 50;
let TRIM_FRAMES = (SAMPLE_RATE * TRIM_MS).idiv(1000 * FFT_SIZE);
let SILENCE_THRESHOLD = 0.05;

// Frames this loud, for at least this many in a row, are taken for speech
// when trimming. A key click is louder than silence but only lasts a frame
// or two, and would otherwise be kept along with the silence after it.
let SPEECH_THRESHOLD = 0.3;
let SPEECH_MIN_RUN = 3;

// Where recorded samples are saved, one WAV file each, and loaded from on
// startup. The CSV file gives the label of each WAV file, empty for a
// negative sample.
let DATA_DIR = "speech_data";
let LABELS_PATH = DATA_DIR + "/labels.csv";

// Longest label the input box accepts
let MAX_LABEL_LEN = 16;

// How long a detected word stays lit in the list
let HIGHLIGHT_MS = 900;

// How often the window is redrawn. Drawing once per block of audio would tie
// the rate this loop reads the microphone to the rate it can paint, and the
// reader has to keep up with the input device or the recording gets holes in
// it. Audio is read every pass; only the painting is paced.
let DRAW_INTERVAL_MS = 33;

// --- Layout ---
//
// The body text is drawn at scale 2 (14x24 per character) and the label box
// at scale 3, so every position here is in those units.
let TEXT_SCALE = 2;
let BOX_SCALE = 3;

let MARGIN = 20;
let TITLE_Y = 14;
let STATUS_Y = 46;
let BOX_Y = 84;
let BOX_H = 46;
let XBTN_W = 46;
let BOX_W = WINDOW_WIDTH - 2 * MARGIN - XBTN_W - 8;
let XBTN_X = MARGIN + BOX_W + 8;
let HELP_Y = 142;
let HELP_Y2 = 168;
let LIST_Y = 236;
let ROW_H = 28;

// Where each column of a word's row starts, measured from the margin
let COL_COUNT = 260;
let COL_BEEPS = 440;
let COL_CONF = 560;

let COLOR_BOX = rgb(38, 38, 48);
let COLOR_XBTN = rgb(170, 45, 45);
let COLOR_HILITE = rgb(90, 220, 120);
let COLOR_NOISE_HILITE = rgb(225, 80, 80);

// Uniform random weights for units with fan_in inputs each, scaled so that
// ReLU activations keep about the same variance from layer to layer
fun he_init_f32(size, fan_in) {
    let lim = (6.0 / fan_in.to_f()).sqrt();
    let ba = ByteArray.with_size(size * 4);
    for (let var i = 0; i < size; ++i) {
        ba.set_f32(i, rng.float(-lim, lim));
    }
    return ba;
}

// --- Network Definition ---
//
// A 1D convnet that slides along time, with the mel bins of each frame as its
// input channels. Strided convolutions shrink the time axis while the
// channels grow, then a dense layer sees every remaining time step:
//
//   input   96 x 32
//   conv1   k=5 s=2  ->  46 x 32    sees 5 frames, about a phoneme
//   conv2   k=3 s=2  ->  22 x 48    sees 9 frames
//   conv3   k=3 s=2  ->  10 x 64    sees 17 frames, about a syllable
//   dense   640      ->  64
//   output  64       ->  softmax over "nothing" and each word
//
// The features are flattened rather than pooled over time, because the
// network has to know where in the window a word is: it is trained to stop
// firing once a word is followed by enough silence.
//
// Every weight and activation lives in a ByteArray of float32, so that the
// layers can be written as calls to `dot_f32` and `axpy_f32`, which run on
// the host instead of one bytecode multiply and add at a time.

// A convolution along time, followed by a ReLU. Activations are stored
// time-major, with the channels of each time step together, and each output
// channel's weights as k rows of c_in. The input under the kernel at one
// time step is then a single run of k * c_in floats, so each output is one
// `dot_f32` against that channel's weights.
class ConvLayer {
    init(self, t_in, c_in, c_out, k, stride) {
        self.t_in = t_in;
        self.c_in = c_in;
        self.c_out = c_out;
        self.k = k;
        self.stride = stride;
        self.t_out = (t_in - k).idiv(stride) + 1;
        self.row = k * c_in;

        self.W = he_init_f32(c_out * self.row, self.row);
        self.b = ByteArray.with_size(c_out * 4);
        self.a = ByteArray.with_size(self.t_out * c_out * 4);

        // Gradients, and the gradient with respect to the input, which
        // backpropagates to the layer before
        self.dW = ByteArray.with_size(c_out * self.row * 4);
        self.db = ByteArray.with_size(c_out * 4);
        self.dx = ByteArray.with_size(t_in * c_in * 4);

        // Dropout, applied only while `dropping` is set, in training. Kept
        // outputs are scaled up to make up for the dropped ones, so that
        // detection, without dropout, sees outputs of the same size.
        self.drop_prob = 0.0;
        self.dropping = false;
        self.keep_scale = 1.0;
    }

    num_params(self) {
        return self.c_out * (self.row + 1);
    }

    forward(self, x) {
        let W = self.W;
        let b = self.b;
        let a = self.a;
        let row = self.row;
        let c_out = self.c_out;
        let step = self.stride * self.c_in;

        for (let var t = 0; t < self.t_out; ++t) {
            let xs = t * step;
            let out = t * c_out;
            for (let var c = 0; c < c_out; ++c) {
                let z = W.dot_f32(c * row, 1, x, xs, 1, row) + b.get_f32(c);
                a.set_f32(out + c, z.max(0.0));
            }
        }

        self.keep_scale = 1.0;
        if (self.dropping && self.drop_prob > 0.0) {
            self.keep_scale = 1.0 / (1.0 - self.drop_prob);
            for (let var i = 0; i < self.t_out * c_out; ++i) {
                if (rng.float(0.0, 1.0) < self.drop_prob) {
                    a.set_f32(i, 0.0);
                } else {
                    a.set_f32(i, a.get_f32(i) * self.keep_scale);
                }
            }
        }

        return a;
    }

    // Adds to dW and db given da, the gradient of the loss with respect to
    // this layer's output, and fills dx if need_dx is set. Overlapping
    // windows of the input add up in dx, since axpy_f32 accumulates.
    backward(self, x, da, need_dx) {
        let W = self.W;
        let a = self.a;
        let dW = self.dW;
        let db = self.db;
        let dx = self.dx;
        let row = self.row;
        let c_out = self.c_out;
        let step = self.stride * self.c_in;

        if (need_dx) {
            dx.zero_fill();
        }

        for (let var t = 0; t < self.t_out; ++t) {
            let xs = t * step;
            let out = t * c_out;
            for (let var c = 0; c < c_out; ++c) {
                // ReLU passes a gradient through only where it was active,
                // and dropout only where the output was kept
                if (a.get_f32(out + c) <= 0.0) {
                    continue;
                }

                let g = da.get_f32(out + c) * self.keep_scale;
                dW.axpy_f32(c * row, 1, x, xs, 1, row, g);
                db.set_f32(c, db.get_f32(c) + g);
                if (need_dx) {
                    dx.axpy_f32(xs, 1, W, c * row, 1, row, g);
                }
            }
        }

        return dx;
    }

    zero_grad(self) {
        self.dW.zero_fill();
        self.db.zero_fill();
    }

    grad_sq(self) {
        return self.dW.dot_f32(0, 1, self.dW, 0, 1, self.dW.num_f32()) +
               self.db.dot_f32(0, 1, self.db, 0, 1, self.db.num_f32());
    }

    apply_grad(self, scale) {
        self.W.axpy_f32(0, 1, self.dW, 0, 1, self.W.num_f32(), -scale);
        self.b.axpy_f32(0, 1, self.db, 0, 1, self.b.num_f32(), -scale);
    }
}

// The network starts with one output, for hearing no word at all, and grows
// one for each word it is taught. See `add_output` for why the words share a
// network rather than getting one each.
class ConvNet {
    init(self) {
        self.output_size = 0;

        // Names of the words, in the same order as the rows of W_out
        self.words = [];

        let conv1 = ConvLayer(MAX_FRAMES, NUM_MEL_BINS, 32, 5, 2);
        let conv2 = ConvLayer(conv1.t_out, conv1.c_out, 48, 3, 2);
        let conv3 = ConvLayer(conv2.t_out, conv2.c_out, 64, 3, 2);

        // A kernel spanning every time step left is a dense layer over the
        // flattened features
        let dense = ConvLayer(conv3.t_out, conv3.c_out, HIDDEN_SIZE, conv3.t_out, 1);
        assert(dense.t_out == 1);

        self.layers = [conv1, conv2, conv3, dense];
        dense.drop_prob = HIDDEN_DROPOUT;

        self.W_out = ByteArray.with_size(0);
        self.b_out = ByteArray.with_size(0);
        self.dW_out = ByteArray.with_size(0);
        self.db_out = ByteArray.with_size(0);
        self.d_loss = ByteArray.with_size(0);
        self.d_hidden = ByteArray.with_size(HIDDEN_SIZE * 4);

        // The outputs compete in a softmax, so hearing no word at all needs
        // an output of its own. It is named by the empty label negative
        // samples have.
        self.add_output(NONE_LABEL);
    }

    num_params(self) {
        let var n = (HIDDEN_SIZE + 1) * self.output_size;
        for (let var i = 0; i < self.layers.len; ++i) {
            n = n + self.layers[i].num_params();
        }
        return n;
    }

    // Which output stands for a word, or -1 if it has no output yet
    word_index(self, name) {
        for (let var i = 0; i < self.words.len; ++i) {
            if (self.words[i] == name) {
                return i;
            }
        }
        return -1;
    }

    // Teach the network one more word by giving it one more output.
    //
    // The words share every layer but the last, because those layers hold
    // nearly all the weights, and sharing them means every recording trains
    // the features all the words are recognized from. A sample of one word
    // also doubles as a negative for the others.
    //
    // Growing costs one row: the rows already there keep their weights. The
    // outputs share a softmax, so the words compete, and confidence in one
    // word is evidence against the others.
    add_output(self, name) {
        let h = HIDDEN_SIZE;
        let o = self.output_size;
        let lim = (6.0 / (h + 1).to_f()).sqrt();

        self.W_out.resize((o + 1) * h * 4);
        for (let var c = 0; c < h; ++c) {
            self.W_out.set_f32(o * h + c, rng.float(-lim, lim));
        }

        self.b_out.resize((o + 1) * 4);
        self.dW_out.resize((o + 1) * h * 4);
        self.db_out.resize((o + 1) * 4);
        self.d_loss.resize((o + 1) * 4);

        self.words.push(name);
        self.output_size = o + 1;

        return o;
    }

    // `x` is a ByteArray of MAX_FRAMES * NUM_MEL_BINS float32 values
    forward(self, x) {
        let var a = x;
        for (let var i = 0; i < self.layers.len; ++i) {
            a = self.layers[i].forward(a);
        }

        let h = HIDDEN_SIZE;
        let y_pred = Array.with_size(self.output_size, 0.0);
        let var z_max = nil;
        for (let var o = 0; o < self.output_size; ++o) {
            let z = self.W_out.dot_f32(o * h, 1, a, 0, 1, h) + self.b_out.get_f32(o);
            y_pred[o] = z;
            if (z_max == nil || z > z_max) {
                z_max = z;
            }
        }

        // Softmax, shifted by the largest logit so exp() can't overflow
        let var sum = 0.0;
        for (let var o = 0; o < self.output_size; ++o) {
            y_pred[o] = (y_pred[o] - z_max).exp();
            sum = sum + y_pred[o];
        }
        for (let var o = 0; o < self.output_size; ++o) {
            y_pred[o] = y_pred[o] / sum;
        }

        return y_pred;
    }

    // Like `forward`, with dropout, for training
    forward_train(self, x) {
        for (let var i = 0; i < self.layers.len; ++i) {
            self.layers[i].dropping = true;
        }
        let y_pred = self.forward(x);
        for (let var i = 0; i < self.layers.len; ++i) {
            self.layers[i].dropping = false;
        }
        return y_pred;
    }

    // Computes the gradients for one example, after a call to `forward` or
    // `forward_train` on it
    backward(self, x, y_true, y_pred) {
        let h = HIDDEN_SIZE;
        let num_out = self.output_size;
        let layers = self.layers;
        let hidden = layers[layers.len - 1].a;
        let d_loss = self.d_loss;

        // For a softmax with cross-entropy, the gradient at the logits is
        // simply the error
        for (let var o = 0; o < num_out; ++o) {
            d_loss.set_f32(o, y_pred[o] - y_true[o]);
        }

        self.dW_out.zero_fill();
        for (let var o = 0; o < num_out; ++o) {
            let g = d_loss.get_f32(o);
            self.dW_out.axpy_f32(o * h, 1, hidden, 0, 1, h, g);
            self.db_out.set_f32(o, g);
        }

        // W_out transposed times d_loss. Column `r` of W_out is a run with a
        // stride of h, which dot_f32 reads without transposing.
        for (let var r = 0; r < h; ++r) {
            self.d_hidden.set_f32(r, self.W_out.dot_f32(r, h, d_loss, 0, 1, num_out));
        }

        // The first layer's input is the example, which needs no gradient
        let var da = self.d_hidden;
        for (let var i = layers.len - 1; i >= 0; --i) {
            let input = i > 0 ? layers[i - 1].a : x;
            layers[i].zero_grad();
            da = layers[i].backward(input, da, i > 0);
        }
    }

    // One step of gradient descent, with the gradient's norm clipped
    update(self, learning_rate) {
        let n_out = self.dW_out.num_f32();
        let var sq = self.dW_out.dot_f32(0, 1, self.dW_out, 0, 1, n_out) +
                     self.db_out.dot_f32(0, 1, self.db_out, 0, 1, self.output_size);
        for (let var i = 0; i < self.layers.len; ++i) {
            sq = sq + self.layers[i].grad_sq();
        }

        let norm = sq.sqrt();
        let var scale = learning_rate;
        if (norm > GRADIENT_CLIP_THRESHOLD) {
            scale = learning_rate * GRADIENT_CLIP_THRESHOLD / norm;
        }

        for (let var i = 0; i < self.layers.len; ++i) {
            self.layers[i].apply_grad(scale);
        }
        self.W_out.axpy_f32(0, 1, self.dW_out, 0, 1, n_out, -scale);
        self.b_out.axpy_f32(0, 1, self.db_out, 0, 1, self.output_size, -scale);
    }
}

// Function to perform in-place iterative FFT (Cooley-Tukey)
fun fft(real_parts, imag_parts, inverse) {
    let n = real_parts.num_f32();
    if (n == 0) {
        return;
    }
    let var i = 0;
    let var j = 0;
    while (i < n) {
        if (j > i) {
            let temp_re = real_parts.get_f32(i);
            real_parts.set_f32(i, real_parts.get_f32(j));
            real_parts.set_f32(j, temp_re);
            let temp_im = imag_parts.get_f32(i);
            imag_parts.set_f32(i, imag_parts.get_f32(j));
            imag_parts.set_f32(j, temp_im);
        }
        let var m = n.idiv(2);
        while (m >= 1 && j >= m) {
            j = j - m;
            m = m.idiv(2);
        }
        j = j + m;
        i = i + 1;
    }
    let var len = 2;
    while (len <= n) {
        let var ang = 2.0 * PI / len;
        if (inverse) {
            ang = -ang;
        }
        let wlen_re = ang.cos();
        let wlen_im = ang.sin();
        let var i = 0;
        while (i < n) {
            let var w_re = 1.0;
            let var w_im = 0.0;
            let var j = 0;
            while (j < len.idiv(2)) {
                let u_re = real_parts.get_f32(i + j);
                let u_im = imag_parts.get_f32(i + j);
                let x_half_re = real_parts.get_f32(i + j + len.idiv(2));
                let x_half_im = imag_parts.get_f32(i + j + len.idiv(2));
                let v_re = x_half_re * w_re - x_half_im * w_im;
                let v_im = x_half_re * w_im + x_half_im * w_re;
                real_parts.set_f32(i + j, u_re + v_re);
                imag_parts.set_f32(i + j, u_im + v_im);
                real_parts.set_f32(i + j + len.idiv(2), u_re - v_re);
                imag_parts.set_f32(i + j + len.idiv(2), u_im - v_im);
                let next_w_re = w_re * wlen_re - w_im * wlen_im;
                let next_w_im = w_re * wlen_im + w_im * wlen_re;
                w_re = next_w_re;
                w_im = next_w_im;
                j = j + 1;
            }
            i = i + len;
        }
        len = len * 2;
    }
    if (inverse) {
        for (let var k = 0; k < n; ++k) {
            real_parts.set_f32(k, real_parts.get_f32(k) / n);
            imag_parts.set_f32(k, imag_parts.get_f32(k) / n);
        }
    }
}

fun hanning_window(buffer) {
    let n = buffer.num_f32();
    for (let var i = 0; i < n; ++i) {
        let multiplier = 0.5 * (1.0 - (2.0 * PI * i / (n - 1)).cos());
        buffer.set_f32(i, buffer.get_f32(i) * multiplier);
    }
}

// Weights of the mel bands over the FFT bins, NUM_MEL_BINS rows of SPEC_BINS.
// Each band is a triangle peaking at its center bin, with the centers spaced
// geometrically between MIN_FREQ and MAX_FREQ. Computing the bands as a
// matrix product is what lets training shift their pitch cheaply.
fun make_mel_bank() {
    let edges = Array.with_size(NUM_MEL_BINS + 2, 0);
    for (let var i = 0; i < edges.len; ++i) {
        let freq = MIN_FREQ * (MAX_FREQ / MIN_FREQ).pow(i.to_f() / (NUM_MEL_BINS + 1).to_f());
        edges[i] = (freq * FFT_SIZE / SAMPLE_RATE).floor();
    }

    let bank = ByteArray.with_size(NUM_MEL_BINS * SPEC_BINS * 4);
    for (let var band = 0; band < NUM_MEL_BINS; ++band) {
        let start_bin = edges[band];
        let center_bin = edges[band + 1];
        let end_bin = edges[band + 2];

        for (let var bin = start_bin; bin <= end_bin && bin < SPEC_BINS; ++bin) {
            let var weight = 0.0;
            if (bin <= center_bin) {
                if (center_bin > start_bin) {
                    weight = (bin - start_bin).to_f() / (center_bin - start_bin).to_f();
                } else if (bin == center_bin) {
                    weight = 1.0;
                }
            } else if (end_bin > center_bin) {
                weight = (end_bin - bin).to_f() / (end_bin - center_bin).to_f();
            }
            bank.set_f32(band * SPEC_BINS + bin, weight);
        }
    }

    return bank;
}

let MEL_BANK = make_mel_bank();

// The mel bank for audio with every frequency scaled by `ratio`. Bin k of the
// shifted audio is bin k / ratio of the original, read by interpolating
// between its two neighbours, so each weight is split between those two.
fun shifted_mel_bank(ratio) {
    let bank = ByteArray.with_size(NUM_MEL_BINS * SPEC_BINS * 4);
    for (let var band = 0; band < NUM_MEL_BINS; ++band) {
        let row = band * SPEC_BINS;
        for (let var k = 0; k <= MEL_TOP_BIN; ++k) {
            let w = MEL_BANK.get_f32(row + k);
            if (w == 0.0) {
                continue;
            }

            let pos = k.to_f() / ratio;
            let j = pos.floor();
            let f = pos - j.to_f();
            if (j < SPEC_BINS) {
                bank.set_f32(row + j, bank.get_f32(row + j) + w * (1.0 - f));
            }
            if (j + 1 < SPEC_BINS) {
                bank.set_f32(row + j + 1, bank.get_f32(row + j + 1) + w * f);
            }
        }
    }
    return bank;
}

// Magnitudes of the first SPEC_BINS bins of the spectrum of FFT_SIZE samples
// of audio. Overwrites real_parts and imag_parts.
fun compute_spectrum(real_parts, imag_parts) {
    imag_parts.zero_fill();
    hanning_window(real_parts);
    fft(real_parts, imag_parts, false);

    let spec = ByteArray.with_size(SPEC_BINS * 4);
    for (let var k = 0; k < SPEC_BINS; ++k) {
        let re = real_parts.get_f32(k);
        let im = imag_parts.get_f32(k);
        spec.set_f32(k, (re * re + im * im).sqrt());
    }
    return spec;
}

// Writes the mel bands of a spectrum, read through a bank, to `out` from
// element `idx`. A loud frame is scaled so its peak is 1.0, while silence and
// near-silence are left as they are rather than amplified.
fun write_mel(spec, bank, out, idx) {
    let var peak = 0.0;
    for (let var b = 0; b < NUM_MEL_BINS; ++b) {
        let v = bank.dot_f32(b * SPEC_BINS, 1, spec, 0, 1, SPEC_BINS);
        out.set_f32(idx + b, v);
        peak = peak.max(v);
    }

    if (peak >= 1.0) {
        for (let var b = 0; b < NUM_MEL_BINS; ++b) {
            out.set_f32(idx + b, out.get_f32(idx + b) / peak);
        }
    }
}

// One normalized frame of mel bands, as an array, from a spectrum
fun spectrum_frame(spec) {
    let tmp = ByteArray.with_size(NUM_MEL_BINS * 4);
    write_mel(spec, MEL_BANK, tmp, 0);
    let frame = Array.with_size(NUM_MEL_BINS, 0.0);
    for (let var j = 0; j < NUM_MEL_BINS; ++j) {
        frame[j] = tmp.get_f32(j);
    }
    return frame;
}

fun spectra_frames(spectra) {
    let frames = Array.with_size(spectra.len, nil);
    for (let var i = 0; i < spectra.len; ++i) {
        frames[i] = spectrum_frame(spectra[i]);
    }
    return frames;
}

// Turns FFT_SIZE samples of audio into one normalized frame of mel bands.
// Overwrites real_parts and imag_parts.
fun compute_frame(real_parts, imag_parts) {
    return spectrum_frame(compute_spectrum(real_parts, imag_parts));
}

// Spectra for a ByteArray of f32 samples, one per FFT_SIZE samples, the same
// way they are computed from the microphone
fun audio_spectra(samples, real_parts, imag_parts) {
    let spectra = [];
    let num_blocks = samples.num_f32().idiv(FFT_SIZE);
    for (let var b = 0; b < num_blocks; ++b) {
        real_parts.memcpy(0, samples, b * FFT_SIZE * 4, FFT_SIZE * 4);
        spectra.push(compute_spectrum(real_parts, imag_parts));
    }
    return spectra;
}

// The network's input for a training example, from its spectra, with the
// mel bands read through `bank`. Laid out the same as `flatten_and_pad`.
fun spectra_to_input(spectra, bank) {
    let x = ByteArray.with_size(INPUT_SIZE * 4);
    let n = spectra.len.min(MAX_FRAMES);
    for (let var i = 0; i < n; ++i) {
        write_mel(spectra[spectra.len - 1 - i], bank, x, (MAX_FRAMES - 1 - i) * NUM_MEL_BINS);
    }
    return x;
}

// Produces the network's input: one ByteArray of float32, which is what
// `ConvNet.forward` reads. A new ByteArray is zeroed, so the padding is already
// in place when there are fewer frames than fit.
fun flatten_and_pad(frames, max_frames, num_bins) {
    let flat = ByteArray.with_size(max_frames * num_bins * 4);
    let num_frames = frames.len.min(max_frames);

    // Filled from the end backwards, so the most recent frame lands in the
    // last slot. Counting back from `frames.len` rather than from
    // `num_frames` matters when a recording is longer than the window: the
    // detector's window always holds the newest frames, and a training clip
    // has to be presented the same way round or the two never line up.
    for (let var i = 0; i < num_frames; ++i) {
        let frame = frames[frames.len - 1 - i]; // Get frames in reverse chronological order
        let flat_start_idx = (max_frames - 1 - i) * num_bins; // Calculate target index in flat array
        for (let var j = 0; j < num_bins; ++j) {
            flat.set_f32(flat_start_idx + j, frame[j]);
        }
    }

    return flat;
}

// True when a frame is quiet enough to be silence rather than speech. Frames
// this quiet are left unscaled by `write_mel`, so the threshold
// sits on the same scale as a loud frame's peak of 1.0.
fun frame_is_silent(frame, threshold) {
    let var peak = 0.0;
    for (let var i = 0; i < frame.len; ++i) {
        if (frame[i] > peak) {
            peak = frame[i];
        }
    }
    return peak < threshold;
}

// Range [start, end) of the speech within frames[lo..hi), or nil if there is
// none. Speech starts with the first run of loud frames, widened back while
// frames stay above silence. A run has to be a few frames long, so that a key
// click isn't taken for speech, and the quiet gap after a click stops the
// widening. The end only has silence trimmed off, since words can trail off
// quietly, as the "s" of "yes" does, with a near-silent frame in between.
fun find_speech(frames, lo, hi) {
    let var first = -1;
    let var run = 0;

    for (let var i = lo; i < hi; ++i) {
        if (frame_is_silent(frames[i], SPEECH_THRESHOLD)) {
            run = 0;
            continue;
        }

        run = run + 1;
        if (run >= SPEECH_MIN_RUN) {
            first = i - run + 1;
            break;
        }
    }

    if (first < 0) {
        return nil;
    }

    while (first > lo && !frame_is_silent(frames[first - 1], SILENCE_THRESHOLD)) {
        first = first - 1;
    }
    let var last = hi;
    while (last > first && frame_is_silent(frames[last - 1], SILENCE_THRESHOLD)) {
        last = last - 1;
    }

    return [first, last];
}

// Range [start, end) of `frames` to keep: a fixed number of frames off each
// end, to cut the key press and release, then the speech within what's left.
// Without loud enough speech, only silence is trimmed, and failing that the
// whole recording is kept, rather than throw away a short or quiet recording.
fun trim_range(frames, trim_frames, silence_threshold) {
    let n = frames.len;
    let var start = trim_frames.min(n);
    let var end = (n - trim_frames).max(start);

    let speech = find_speech(frames, start, end);
    if (speech != nil) {
        return speech;
    }

    while (start < end && frame_is_silent(frames[start], silence_threshold)) {
        start = start + 1;
    }
    while (end > start && frame_is_silent(frames[end - 1], silence_threshold)) {
        end = end - 1;
    }

    if (end <= start && n > 0) {
        return [0, n];
    }
    return [start, end];
}

// Plush arrays have no slice, so this rebuilds one
fun array_slice(arr, start, end) {
    let out = Array.with_size(end - start, nil);
    for (let var i = 0; i < end - start; ++i) {
        out[i] = arr[start + i];
    }
    return out;
}

// Compresses the network's input in place, as log(1 + c * x), scaled so
// that 1 stays 1. Quiet sounds are spread out and loud ones squeezed
// together, so the network sees the shape of a sound more than its loudness.
let LOG_NORM = 1.0 / (1.0 + LOG_COMPRESSION).ln();
fun compress_input(x) {
    for (let var i = 0; i < INPUT_SIZE; ++i) {
        x.set_f32(i, (1.0 + LOG_COMPRESSION * x.get_f32(i).max(0.0)).ln() * LOG_NORM);
    }
    return x;
}

// Mel frames of white noise, at an RMS of BG_REF_RMS, to scale and add as
// background noise
let BG_REF_RMS = 0.001;
fun make_bg_frames() {
    let real_parts = ByteArray.with_size(FFT_SIZE * 4);
    let imag_parts = ByteArray.with_size(FFT_SIZE * 4);
    let frames = [];
    for (let var k = 0; k < 64; ++k) {
        for (let var i = 0; i < FFT_SIZE; ++i) {
            real_parts.set_f32(i, rng.float(-1.0, 1.0) * BG_REF_RMS * 1.732);
        }
        frames.push(compute_frame(real_parts, imag_parts));
    }
    return frames;
}
let BG_FRAMES = make_bg_frames();

// Adds background noise to every frame of an input, padding included, at a
// random level, since the microphone never hears true silence
fun add_background_noise(x) {
    let lo = BG_NOISE_MIN_RMS.ln();
    let hi = BG_NOISE_MAX_RMS.ln();
    let level = rng.float(lo, hi).exp() / BG_REF_RMS;

    for (let var t = 0; t < MAX_FRAMES; ++t) {
        let frame = BG_FRAMES[rng.int(0, BG_FRAMES.len)];
        let base = t * NUM_MEL_BINS;
        for (let var b = 0; b < NUM_MEL_BINS; ++b) {
            x.set_f32(base + b, x.get_f32(base + b) + frame[b] * level);
        }
    }
}

let SILENT_SPECTRUM = ByteArray.with_size(SPEC_BINS * 4);

// Appends n frames of silence
fun push_silence(spectra, n) {
    for (let var i = 0; i < n; ++i) {
        spectra.push(SILENT_SPECTRUM);
    }
}

// A crop of a word to train as no word, from 1 frame up to
// NEG_CROP_MAX_FRAC of it
fun crop_word(spectra) {
    let n = spectra.len;
    let len = rng.int(1, (n.to_f() * NEG_CROP_MAX_FRAC).floor().max(1) + 1);

    let r = rng.float(0.0, 1.0);
    let var start = 0;
    if (r < NEG_CROP_SUFFIX_PROB) {
        start = n - len;
    } else if (r < NEG_CROP_SUFFIX_PROB + NEG_CROP_ANYWHERE_PROB) {
        start = rng.int(0, n - len + 1);
    }

    return array_slice(spectra, start, start + len);
}

// Reorders frames in place, so that the network learns from negative
// examples that the order of sounds matters, not just which ones are there
fun permute_frames(spectra) {
    if (rng.float(0.0, 1.0) < NEG_SHUFFLE_PROB) {
        rng.shuffle(spectra);
        return;
    }

    for (let var i = 0; i + 1 < spectra.len; ++i) {
        if (rng.float(0.0, 1.0) < NEG_SWAP_PROB) {
            let tmp = spectra[i];
            spectra[i] = spectra[i + 1];
            spectra[i + 1] = tmp;

            // A frame moves one place at most
            i = i + 1;
        }
    }
}

// Randomly drops a few frames, so the network isn't relying on every frame
// of a word being there, and repeats a few others, as if spoken more slowly
fun drop_and_repeat(spectra) {
    let out = [];
    for (let var i = 0; i < spectra.len; ++i) {
        if (rng.float(0.0, 1.0) < FRAME_DROP_PROB) {
            continue;
        }
        out.push(spectra[i]);
        if (rng.float(0.0, 1.0) < FRAME_DUP_PROB) {
            out.push(spectra[i]);
        }
    }
    return (out.len > 0) ? out : spectra;
}

// Makes one training example from a sample's spectra and label, with a
// random augmentation. Returns [network input, label to train], where the
// label is NONE_LABEL for a negative example.
fun make_example(spectra, label) {
    let var frames = nil;
    let var target = label;

    // Silence that goes after the example, as the window sees once a word
    // has ended
    let var silence = 0;

    if (label == NONE_LABEL) {
        // Any part of a recorded negative example is still one
        let len = rng.int(1, spectra.len + 1);
        let start = rng.int(0, spectra.len - len + 1);
        frames = array_slice(spectra, start, start + len);
    } else if (rng.float(0.0, 1.0) < NEG_FROM_WORD_PROB) {
        target = NONE_LABEL;
        if (rng.float(0.0, 1.0) < NEG_WORD_THEN_SILENCE_PROB) {
            frames = array_slice(spectra, 0, spectra.len);
            silence = rng.int(TRAILING_SILENCE_GRACE_FRAMES + 1, TRAILING_SILENCE_MAX_FRAMES + 1);
        } else {
            frames = crop_word(spectra);
        }
    } else {
        frames = array_slice(spectra, 0, spectra.len);
        if (rng.float(0.0, 1.0) < POS_TRAILING_SILENCE_PROB) {
            silence = rng.int(1, TRAILING_SILENCE_GRACE_FRAMES + 1);
        }
    }

    if (target == NONE_LABEL && silence == 0 && rng.float(0.0, 1.0) < NEG_TRAILING_SILENCE_PROB) {
        silence = rng.int(1, TRAILING_SILENCE_MAX_FRAMES + 1);
    }

    if (target == NONE_LABEL) {
        permute_frames(frames);
    }

    // Silence goes on last, so that how much there is stays exact
    frames = drop_and_repeat(frames);
    push_silence(frames, silence);

    // Shift the pitch of the whole example
    let var bank = MEL_BANK;
    if (rng.float(0.0, 1.0) < PITCH_SHIFT_PROB) {
        let semitones = rng.float(-PITCH_SHIFT_MAX_SEMITONES, PITCH_SHIFT_MAX_SEMITONES);
        bank = shifted_mel_bank(2.0.pow(semitones / 12.0));
    }
    let x = spectra_to_input(frames, bank);

    if (rng.float(0.0, 1.0) < BG_NOISE_PROB) {
        add_background_noise(x);
    }

    compress_input(x);

    // Scale the whole example, then add noise
    let scale_factor = 1.0 + (rng.float(-0.5, 0.5) * 0.35);
    for (let var i = 0; i < INPUT_SIZE; ++i) {
        x.set_f32(i, x.get_f32(i) * scale_factor + rng.float(-0.5, 0.5) * NOISE_MAGNITUDE);
    }

    return [x, target];
}

fun training_actor(detection_actor_id) {
    rng.seed($time_current_ms());
    let mlp = ConvNet();
    $println("Network parameters: " + mlp.num_params().comma_sep() + " + " + (HIDDEN_SIZE + 1).to_s() + " per word");

    let training_data = [];
    let var iteration_count = 0;
    let var positive_examples_count = 0;
    let var negative_examples_count = 0;

    // The loss of any one example swings too much to read anything from, so
    // what gets printed is an exponential moving average of it. The weight
    // gives it a memory of roughly the last thousand steps, about half a
    // second of training.
    let LOSS_SMOOTHING = 0.001;
    let var avg_loss = nil;

    // Fraction of examples whose most probable output was the target,
    // averaged the same way
    let var avg_acc = nil;

    // Training steps per second, counted over a window rather than timed one
    // step at a time, so the number holds still long enough to read
    let RATE_WINDOW_MS = 500;
    let var rate_start_ms = $time_current_ms();
    let var rate_count = 0;
    let var itrs_per_sec = 0.0;

    for (let var training_itr = 1;; ++training_itr) {
        // A sample arrives as [spectra, word], with the spectrum of each
        // frame rather than its mel bands, so that its pitch can be shifted.
        // An empty word means the clip is a negative example: no output
        // should fire for it.
        let msg = $actor_poll();
        if (msg != nil) {
            training_data.push(msg);
            let word = msg[1];

            if (word == "") {
                negative_examples_count = negative_examples_count + 1;
            } else {
                positive_examples_count = positive_examples_count + 1;

                // A word heard for the first time gets an output of its own
                if (mlp.word_index(word) < 0) {
                    mlp.add_output(word);
                    $println("Learning a new word: \"" + word + "\"");
                }
            }

            $println("Positive samples: " + positive_examples_count.to_s() + ", negative samples: " + negative_examples_count.to_s());

            // The detector needs the new output right away, so that a word
            // just taught can be recognized before the next model update
            $actor_send(detection_actor_id, mlp);
        }

        // Nothing to learn until at least one word has an output
        let can_train = training_data.len > 0 && mlp.output_size > 1;

        if (can_train) {
            let sample = training_data[rng.int(0, training_data.len)];
            let example = make_example(sample[0], sample[1]);
            let x = example[0];

            // One-hot on the word the example is of, which is the output
            // for no word when it is a negative example
            let y_true = Array.with_size(mlp.output_size, 0.0);
            let label_idx = mlp.word_index(example[1]);
            y_true[label_idx] = 1.0;

            let y_pred = mlp.forward_train(x);
            mlp.backward(x, y_true, y_pred);
            mlp.update(LEARNING_RATE);

            // Cross-entropy, of the target output alone with a softmax
            let loss = -(y_pred[label_idx].max(1e-9).ln());

            // The first example has nothing to average with, so it starts
            // the average off rather than being blended into zero
            let var best = 0;
            for (let var o = 1; o < y_pred.len; ++o) {
                if (y_pred[o] > y_pred[best]) {
                    best = o;
                }
            }
            let correct = (best == label_idx) ? 1.0 : 0.0;

            if (avg_loss == nil) {
                avg_loss = loss;
                avg_acc = correct;
            } else {
                avg_loss = avg_loss + LOSS_SMOOTHING * (loss - avg_loss);
                avg_acc = avg_acc + LOSS_SMOOTHING * (correct - avg_acc);
            }

            // Status is printed once per rate window, rather than on every
            // step, which scrolled thousands of lines a second
            rate_count = rate_count + 1;
            let rate_elapsed = $time_current_ms() - rate_start_ms;
            if (rate_elapsed >= RATE_WINDOW_MS) {
                itrs_per_sec = rate_count.to_f() * 1000.0 / rate_elapsed.to_f();
                rate_start_ms = $time_current_ms();
                rate_count = 0;
                $println(
                    "Itr#" + training_itr.to_s() +
                    ", " + itrs_per_sec.format_decimals(1) + " itr/s" +
                    ", loss: " + avg_loss.format_decimals(4) +
                    ", acc: " + (avg_acc * 100.0).format_decimals(1) + "%" +
                    ", words: " + (mlp.output_size - 1).to_s() +
                    ", pos: " +
                    positive_examples_count.to_s() +
                    ", neg: " +
                    negative_examples_count.to_s()
                );
            }

            iteration_count = iteration_count + 1;
            if (iteration_count % 100 == 0) {
                // Send the current model to the detection actor
                //$println("Sending model update to detection actor.");
                $actor_send(detection_actor_id, mlp);
            }
        }

        // Idle only when there is nothing to learn from. `$actor_poll` does
        // not block, so without this the loop would spin before any sample
        // has been recorded. Sleeping after every step instead would cap
        // training near 90 steps a second, where a step costs about 1ms.
        if (!can_train) {
            $actor_sleep(10);
        }
    }
}

fun detection_actor(beep_actor_id) {
    // The main actor draws what was heard, so it is told too
    let main_id = $actor_parent();

    let var current_mlp = nil;
    let var frame_buffer = []; // To store recent magnitudes

    // Which word is winning and for how many frames running, for the
    // consecutive-frame debounce below
    let var pending_word = nil;
    let var pending_count = 0;

    // Frames left in the post-detection cooldown, during which nothing is
    // classified at all
    let var cooldown_remaining = 0;

    while (true) {
        let msg = $actor_poll(); // Returns nil when nothing is waiting

        // With nothing to do, wait rather than spin. Predicting here instead
        // would re-run the network over frames that have not changed, which
        // burns a core for nothing and slows the actor that draws the window.
        if (msg == nil) {
            $actor_sleep(2);
            continue;
        }

        if (msg instanceof ConvNet) {
            // Received a new model from the training actor
            current_mlp = msg;
            continue;
        }

        if (msg instanceof Array) {
            // Received magnitudes from the main actor
            let magnitudes = msg;
            frame_buffer.push(magnitudes);

            // Keep only the latest MAX_FRAMES
            if (frame_buffer.len > MAX_FRAMES) {
                // If buffer is full, remove the oldest frame (at index 0)
                // and add the new one at the end.
                // Plush arrays don't have a direct slice/shift, so we'll rebuild.
                let new_frame_buffer = Array.with_size(MAX_FRAMES, nil);
                for (let var i = 0; i < MAX_FRAMES - 1; ++i) {
                    new_frame_buffer[i] = frame_buffer[i + 1];
                }
                new_frame_buffer[MAX_FRAMES - 1] = magnitudes;
                frame_buffer = new_frame_buffer;
            }
            assert(frame_buffer.len <= MAX_FRAMES);
        }

        // One prediction per frame of audio that arrives, once there are
        // enough frames to fill the window the network expects
        if (msg instanceof Array && current_mlp != nil && frame_buffer.len == MAX_FRAMES) {
            // Nothing is classified during the post-detection cooldown
            if (cooldown_remaining > 0) {
                cooldown_remaining = cooldown_remaining - 1;
            } else {
                let x = compress_input(flatten_and_pad(frame_buffer, MAX_FRAMES, NUM_MEL_BINS));
                let y_pred = current_mlp.forward(x);

                // The most probable word wins if it is above the threshold.
                // Output 0 is for hearing no word, and is never reported.
                let var best = -1;
                let var best_conf = DETECTION_THRESHOLD;
                for (let var o = 1; o < y_pred.len; ++o) {
                    if (y_pred[o] > best_conf) {
                        best_conf = y_pred[o];
                        best = o;
                    }
                }

                if (best >= 0) {
                    let word = current_mlp.words[best];

                    if (word == pending_word) {
                        pending_count = pending_count + 1;
                    } else {
                        pending_word = word;
                        pending_count = 1;
                    }

                    // Require a few consecutive hits on the same word before
                    // it counts, since a genuine detection keeps winning as
                    // the window shifts one frame at a time, but a wrong
                    // word triggered by a partial or trailing glimpse of
                    // another tends to win for only a frame or two
                    if (pending_count >= CONFIRM_FRAMES) {
                        // Detections are shown by lighting the word up in
                        // the list rather than printed, since they arrive
                        // many times a second
                        $actor_send(main_id, [word, best_conf]);

                        // Only the wake word makes a sound
                        if (word == WAKE_WORD) {
                            $actor_send(beep_actor_id, "detected");
                        }

                        // Hold off on any further detection for a while, so
                        // this one doesn't immediately re-trigger itself or
                        // bleed into a false hit for another word
                        cooldown_remaining = COOLDOWN_FRAMES;
                        pending_word = nil;
                        pending_count = 0;
                    }
                } else {
                    pending_word = nil;
                    pending_count = 0;
                }
            }
        }
    }
}

fun beep_actor() {
    let audio_out_id = $audio_open_output(SAMPLE_RATE, NUM_CHANNELS);

    let var is_recording = false;
    let var last_beep_time = 0;
    let cooldown_ms = 1200;

    let beep_duration_ms = 80;
    let pause_duration_ms = 30;
    let beep_freq = 1200.0;

    let beep_duration_samples = (SAMPLE_RATE * beep_duration_ms).idiv(1000);
    let pause_duration_samples = (SAMPLE_RATE * pause_duration_ms).idiv(1000);

    let var beep_state = 0; // 0:idle, 1:beep1, 2:pause1, 3:beep2, 4:pause2, 5:beep3
    let var samples_in_state = 0;
    let var time_in_beep = 0;

    // A clip waiting to be played back, and how far through it we are
    let var play_clip = nil;
    let var play_pos = 0;

    loop {
        let msg = $actor_recv();

        if (msg == true || msg == false) {
            is_recording = msg;
            last_beep_time = $time_current_ms();
            continue;
        }

        // The clip that was just recorded, to be played straight back
        if (msg instanceof ByteArray) {
            play_clip = msg;
            play_pos = 0;
            continue;
        }

        if (msg == "detected" && !is_recording) {
            let current_time = $time_current_ms();
            if (current_time - last_beep_time > cooldown_ms) {
                last_beep_time = current_time;
                if (beep_state == 0) { // Start only if idle
                    beep_state = 1;
                    samples_in_state = 0;
                    time_in_beep = 0;
                }
            }
            continue;
        }

        if (msg instanceof AudioNeeded) {
            let num_samples_needed = msg.num_samples;
            let samples = ByteArray.with_size(num_samples_needed * 4);

            for (let var i = 0; i < num_samples_needed; ++i) {
                let var sample_val = 0.0;

                if (play_clip != nil) { // Playing back a recording
                    sample_val = play_clip.get_f32(play_pos);
                    play_pos = play_pos + 1;
                    if (play_pos >= play_clip.num_f32()) {
                        play_clip = nil;
                        play_pos = 0;
                    }
                }
                else if (beep_state == 1 || beep_state == 3 || beep_state == 5) { // Beeping
                    let period_samples = (SAMPLE_RATE.to_f() / beep_freq).trunc();
                    let pos_in_period = time_in_beep % period_samples;
                    let half_period = (period_samples / 2).trunc();

                    if (pos_in_period < half_period) {
                        sample_val = -0.5 + (pos_in_period.to_f() / half_period.to_f());
                    } else {
                        sample_val = 0.5 - ((pos_in_period - half_period).to_f() / half_period.to_f());
                    }
                    time_in_beep = time_in_beep + 1;

                    samples_in_state = samples_in_state + 1;
                    if (samples_in_state >= beep_duration_samples) {
                        beep_state = beep_state + 1; // to pause or idle
                        samples_in_state = 0;
                        if (beep_state == 6) { beep_state = 0; } // End of sequence
                    }
                }
                else if (beep_state == 2 || beep_state == 4) { // Pausing
                    samples_in_state = samples_in_state + 1;
                    if (samples_in_state >= pause_duration_samples) {
                        beep_state = beep_state + 1; // to next beep
                        samples_in_state = 0;
                        time_in_beep = 0; // Reset phase for next beep
                    }
                }

                samples.set_f32(i, sample_val);
            }

            $audio_write_samples(audio_out_id, samples);
        }
    }
}

// --- Dataset ---
//
// Samples saved on disk, along with how many there are of each word, for the
// display. The network keeps its own list of words, in output order.
class Dataset {
    init(self) {
        // Rows of labels.csv, as [file name, label]
        self.rows = [];
        self.next_id = 0;

        self.words = [];
        self.counts = [];
        self.neg_count = 0;
    }

    count(self, word) {
        if (word == "") {
            self.neg_count = self.neg_count + 1;
            return;
        }

        for (let var i = 0; i < self.words.len; ++i) {
            if (self.words[i] == word) {
                self.counts[i] = self.counts[i] + 1;
                return;
            }
        }

        self.words.push(word);
        self.counts.push(1);
    }

    // Loads every sample listed in labels.csv, recomputes its frames and
    // sends them to the trainer. Files that are missing or in another format
    // are skipped, but stay listed.
    load(self, trainer_id, real_parts, imag_parts) {
        let rows = parse_csv_file(LABELS_PATH);
        if (rows == nil) {
            return;
        }

        let var num_loaded = 0;

        for (let var i = 0; i < rows.len; ++i) {
            let row = rows[i];

            // The header, or a row edited by hand into the wrong shape
            if (row.len < 2 || (i == 0 && row[0] == "file")) {
                continue;
            }

            let file = row[0];
            let word = row[1].trim().lower();
            self.rows.push([file, word]);

            // Numbering resumes after the highest numbered file
            if (file.len == 15 && file.slice(0, 7) == "sample_" && file.slice(11, 15) == ".wav") {
                let id = file.slice(7, 11).parse_int(10);
                if (id != nil && id >= self.next_id) {
                    self.next_id = id + 1;
                }
            }

            let audio = load_wav(DATA_DIR + "/" + file);
            if (audio == nil || audio.num_channels != NUM_CHANNELS || audio.sample_rate != SAMPLE_RATE) {
                $println("Skipping " + file + ": missing, or not " + SAMPLE_RATE.to_s() + " Hz mono");
                continue;
            }

            // Same frames as when the clip was recorded, since the clip
            // starts on a frame boundary
            let var spectra = audio_spectra(audio.samples, real_parts, imag_parts);

            // Clips saved before trimming found speech by its loud core can
            // still have a click and silence at the start. The fixed cut was
            // already made when the clip was saved.
            let speech = find_speech(spectra_frames(spectra), 0, spectra.len);
            if (speech != nil) {
                spectra = array_slice(spectra, speech[0], speech[1]);
            }

            if (spectra.len == 0) {
                continue;
            }

            $actor_send(trainer_id, [spectra, word]);
            self.count(word);
            num_loaded = num_loaded + 1;
        }

        $println("Loaded " + num_loaded.to_s() + " samples from " + DATA_DIR);
    }

    // Writes a clip to its own WAV file and lists it in labels.csv
    save(self, clip, word) {
        if (!$make_dir(DATA_DIR)) {
            $println("Error: could not create " + DATA_DIR);
            return;
        }

        let file = "sample_" + self.next_id.to_s().lpad(4, "0") + ".wav";
        self.next_id = self.next_id + 1;

        let audio = AudioData(NUM_CHANNELS, SAMPLE_RATE, 0);
        audio.samples = clip;
        if (!save_wav(DATA_DIR + "/" + file, audio)) {
            $println("Error: could not write " + file);
            return;
        }

        self.rows.push([file, word]);

        // Rewritten whole, as there is no way to append to a file
        let table = [["file", "label"]];
        table.append(self.rows);
        let text = ByteArray.with_size(0);
        text.push_string(format_csv(table));
        if (!$write_file(LABELS_PATH, text)) {
            $println("Error: could not write " + LABELS_PATH);
        }
    }
}

// --- Drawing helpers ---

fun draw_text(img, font, x, y, text) {
    font.draw_text(img, x, y, text);
}

// The label being typed is kept as an array of one-character strings,
// because a string has no way to drop its last character
fun draw_chars(img, font, x, y, chars) {
    for (let var i = 0; i < chars.len; ++i) {
        font.draw_text(img, x + i * font.char_w, y, chars[i]);
    }
}

fun point_in_rect(px, py, x, y, w, h) {
    return px >= x && px < x + w && py >= y && py < y + h;
}

fun print_usage() {
    $println("Word detector");
    $println("");
    $println("  Hold ENTER to record, release to stop. The clip plays back.");
    $println("  Then type the word that was said and press ENTER to save it");
    $println("  Type \"" + NOISE_WORD + "\" for a clip that is not a word at all");
    $println("  Press ENTER on an empty box to save a negative sample");
    $println("  BACKSPACE deletes a character, or discards the clip when empty");
    $println("  ESC or the X button discards the clip");
    $println("  Close the window to quit");
    $println("");
    $println("Samples are saved to ./" + DATA_DIR + " and loaded on startup.");
    $println("Every word you name gets its own output on one shared network.");
    $println("Only \"" + WAKE_WORD + "\" plays a beep; the others just light up.");
    $println("");
}

fun main() {
    print_usage();

    let beep_actor_id = $actor_spawn(beep_actor);
    let detector_id = $actor_spawn(|| detection_actor(beep_actor_id));
    let trainer_id = $actor_spawn(|| training_actor(detector_id));

    let real_parts = ByteArray.with_size(FFT_SIZE * 4);
    let imag_parts = ByteArray.with_size(FFT_SIZE * 4);

    // Before the microphone is opened, so that its input doesn't back up
    let dataset = Dataset();
    dataset.load(trainer_id, real_parts, imag_parts);

    let window_id = $window_create(WINDOW_WIDTH, WINDOW_HEIGHT, "Word Detector", 0);
    let audio_input_device_id = $audio_open_input(SAMPLE_RATE, NUM_CHANNELS);

    let screen = Image(WINDOW_WIDTH, WINDOW_HEIGHT);

    // Characters are blitted opaquely, so each font carries the background it
    // will be drawn on
    let font = PixelFont(TEXT_SCALE, COLOR_WHITE, COLOR_BLACK);
    let font_dim = PixelFont(TEXT_SCALE, COLOR_GREY, COLOR_BLACK);
    let font_box = PixelFont(BOX_SCALE, COLOR_WHITE, COLOR_BOX);
    let font_btn = PixelFont(BOX_SCALE, COLOR_WHITE, COLOR_XBTN);
    let font_lit = PixelFont(TEXT_SCALE, COLOR_BLACK, COLOR_HILITE);
    let font_noise_lit = PixelFont(TEXT_SCALE, COLOR_WHITE, COLOR_NOISE_HILITE);

    let var running = true;
    let var recording = false;

    // A clip that has been recorded and is waiting to be named
    let var labeling = false;
    let var recorded_spectra = [];
    let var label_chars = [];

    // The raw samples of the clip, kept so it can be played back. Allocated
    // once at its largest, with the part actually filled tracked alongside.
    let recorded_audio = ByteArray.with_size(MAX_RECORD_SAMPLES * 4);
    let var recorded_len = 0;

    // The trimmed clip, which is what gets saved along with its label
    let var recorded_clip = nil;

    let words = dataset.words;
    let counts = dataset.counts;

    // The word the detector reported last, and when it said so
    let var last_word = nil;
    let var last_conf = 0.0;
    let var last_detect_ms = 0;

    let var last_draw_ms = 0;

    while (running) {
        $audio_read_samples(audio_input_device_id, FFT_SIZE, real_parts, 0);

        // Keep the raw samples for playback. This has to happen before the
        // window and the FFT below, which both rewrite real_parts in place.
        if (recording && recorded_len + FFT_SIZE <= MAX_RECORD_SAMPLES) {
            recorded_audio.memcpy(recorded_len * 4, real_parts, 0, FFT_SIZE * 4);
            recorded_len = recorded_len + FFT_SIZE;
        }

        let spectrum = compute_spectrum(real_parts, imag_parts);
        let magnitudes = spectrum_frame(spectrum);
        $actor_send(detector_id, magnitudes);

        if (recording) {
            recorded_spectra.push(spectrum);
        }

        let now = $time_current_ms();

        // --- Draw ---
        //
        // Paced, so that reading the microphone is not tied to painting
        if (now - last_draw_ms >= DRAW_INTERVAL_MS) {
            last_draw_ms = now;

            screen.clear(COLOR_BLACK);
            draw_text(screen, font, MARGIN, TITLE_Y, "WORD DETECTOR");

            if (recording) {
                screen.fill_circle(WINDOW_WIDTH - 44, TITLE_Y + 12, 13, COLOR_RED);
                draw_text(screen, font, MARGIN, STATUS_Y, "Recording, release ENTER to stop");
            } else if (labeling) {
                draw_text(screen, font, MARGIN, STATUS_Y, "What word was that? ENTER saves it");
                draw_text(screen, font_dim, MARGIN, HELP_Y, "empty + ENTER = negative sample");
                draw_text(screen, font_dim, MARGIN, HELP_Y2, "BACKSPACE / ESC / X = discard");
            } else {
                draw_text(screen, font, MARGIN, STATUS_Y, "Hold ENTER to record a sample");
            }

            if (labeling) {
                screen.fill_rect(MARGIN, BOX_Y, BOX_W, BOX_H, COLOR_BOX);
                draw_chars(screen, font_box, MARGIN + 8, BOX_Y + 5, label_chars);

                // Caret
                screen.fill_rect(
                    MARGIN + 8 + label_chars.len * font_box.char_w, BOX_Y + 6,
                    3, font_box.char_h, COLOR_WHITE
                );

                screen.fill_rect(XBTN_X, BOX_Y, XBTN_W, BOX_H, COLOR_XBTN);
                font_btn.draw_text(screen, XBTN_X + 12, BOX_Y + 5, "X");
            }

            // The words that have samples, lit up while one is being heard
            draw_text(screen, font_dim, MARGIN, LIST_Y - 30,
                      "WORDS: " + words.len.to_s() + "   NEGATIVE SAMPLES: " + dataset.neg_count.to_s());

            if (words.len == 0) {
                draw_text(screen, font_dim, MARGIN, LIST_Y, "none yet");
            }

            // Noise is kept at the bottom, whenever it was first recorded
            let order = [];
            for (let var i = 0; i < words.len; ++i) {
                if (words[i] != NOISE_WORD) order.push(i);
            }
            for (let var i = 0; i < words.len; ++i) {
                if (words[i] == NOISE_WORD) order.push(i);
            }

            for (let var row = 0; row < order.len; ++row) {
                let i = order[row];
                let y = LIST_Y + row * ROW_H;
                let noise = words[i] == NOISE_WORD;
                let lit = (words[i] == last_word) && (now - last_detect_ms < HIGHLIGHT_MS);

                if (lit) {
                    screen.fill_rect(
                        MARGIN - 6, y - 2, WINDOW_WIDTH - 2 * MARGIN + 12, ROW_H,
                        noise? COLOR_NOISE_HILITE : COLOR_HILITE
                    );
                }

                let var f = font;
                if (lit) {
                    f = noise? font_noise_lit : font_lit;
                } else if (noise) {
                    f = font_dim;
                }

                draw_text(screen, f, MARGIN, y, words[i]);
                draw_text(screen, f, MARGIN + COL_COUNT, y, counts[i].to_s() + " samples");

                if (words[i] == WAKE_WORD) {
                    draw_text(screen, lit? font_lit : font_dim, MARGIN + COL_BEEPS, y, "beeps");
                }
                if (lit) {
                    draw_text(screen, f, MARGIN + COL_CONF, y, last_conf.format_decimals(2));
                }
            }

            $window_draw_frame(window_id, screen.bytes);
        }

        // --- Events ---
        //
        // Every event waiting is handled, not one per frame. This loop runs at
        // the rate audio arrives, about 86 times a second, and moving the mouse
        // over the window produces events faster than that. Taking one at a
        // time leaves the rest queued, so the backlog grows without bound, the
        // input falls further and further behind, and the window stops looking
        // like it is responding at all.
        loop {
            let event = $actor_poll();
            if (event == nil) {
                break;
            }

            // The detector reports what it heard, as [word, confidence]
            if (event instanceof Array) {
                last_word = event[0];
                last_conf = event[1];
                last_detect_ms = now;
            }

            if (event instanceof UIEvent) {
                if (event.kind == "CLOSE_WINDOW") {
                    running = false;
                }

                if (event.kind == "KEY_DOWN" && event.key == "RETURN") {
                    if (labeling) {
                        // Words are looked up by name, so the case and any
                        // stray spaces have to be taken off first, or
                        // "Computer" and "computer " would each get an
                        // output of their own
                        let word = "".join(label_chars).trim().lower();
                        $actor_send(trainer_id, [recorded_spectra, word]);
                        dataset.count(word);

                        // Audio is kept only up to MAX_RECORD_SECS, so a clip
                        // trimmed to past that is trained on but not saved
                        if (recorded_clip != nil) {
                            dataset.save(recorded_clip, word);
                        }

                        if (word == "") {
                            $println("Saved a negative sample.");
                        } else {
                            $println("Saved a sample of \"" + word + "\".");
                        }

                        labeling = false;
                        recorded_spectra = [];
                        label_chars = [];
                    }
                    else if (!recording) {
                        // Held down, so the repeats this produces are ignored
                        recording = true;
                        recorded_spectra = [];
                        recorded_len = 0;
                        $actor_send(beep_actor_id, true);
                        $println("Recording...");
                    }
                }

                if (event.kind == "KEY_UP" && event.key == "RETURN" && recording) {
                    recording = false;
                    $actor_send(beep_actor_id, false);

                    if (recorded_spectra.len > 0) {
                        // Cut the key press/release and any leftover silence
                        // off both ends, so this is what gets trained on
                        let range = trim_range(spectra_frames(recorded_spectra), TRIM_FRAMES, SILENCE_THRESHOLD);
                        let start_frame = range[0];
                        let end_frame = range[1];
                        recorded_spectra = array_slice(recorded_spectra, start_frame, end_frame);

                        labeling = true;
                        label_chars = [];

                        // Play back the same range that was just trimmed to,
                        // so what you hear is what the training loop gets.
                        // Clamped to what was filled, because the buffer is
                        // sized for the longest clip allowed.
                        let start_sample = start_frame * FFT_SIZE;
                        let end_sample = (end_frame * FFT_SIZE).min(recorded_len);
                        let clip_len = end_sample - start_sample;
                        recorded_clip = nil;
                        if (clip_len > 0) {
                            let clip = ByteArray.with_size(clip_len * 4);
                            clip.memcpy(0, recorded_audio, start_sample * 4, clip_len * 4);
                            $actor_send(beep_actor_id, clip);
                            recorded_clip = clip;
                        }
                    } else {
                        recorded_spectra = [];
                    }
                }

                if (labeling && event.kind == "KEY_DOWN") {
                    // Backspace deletes a character, and discards the clip
                    // once there is nothing left to delete
                    if (event.key == "BACKSPACE") {
                        if (label_chars.len > 0) {
                            label_chars.pop();
                        } else {
                            labeling = false;
                            recorded_spectra = [];
                            $println("Discarded the recording.");
                        }
                    }

                    if (event.key == "ESCAPE") {
                        labeling = false;
                        recorded_spectra = [];
                        label_chars = [];
                        $println("Discarded the recording.");
                    }
                }

                if (labeling && event.kind == "TEXT_INPUT") {
                    for (let var i = 0; i < event.text.len; ++i) {
                        if (label_chars.len < MAX_LABEL_LEN) {
                            label_chars.push(event.text.char_at(i));
                        }
                    }
                }

                if (labeling && event.kind == "MOUSE_DOWN" && event.button == "LEFT") {
                    if (point_in_rect(event.x, event.y, XBTN_X, BOX_Y, XBTN_W, BOX_H)) {
                        labeling = false;
                        recorded_spectra = [];
                        label_chars = [];
                        $println("Discarded the recording.");
                    }
                }
            }
        }
    }
}

// Only run when this is the main unit, so that the network can be imported
if ($MAIN_UNIT) {
    main();
}
