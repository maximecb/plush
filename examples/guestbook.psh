// Circuit simulation
//
// The circuit is a square grid of cells, each empty or holding a node: a
// piece of wire, a clock, a switch, an LED, a logic gate or a D flip-flop.
// The value of a cell is type | rot << 8 | param << 16, where rot is the
// number of quarter turns clockwise, and param depends on the type: the bit
// of the tick counter a clock follows, whether a switch is on, the color of
// an LED.
//
// Nodes have ports on their sides, which connect to the ports facing them
// on the cells next to them. Ports joined by wires form a net. A net is on
// when anything drives it: a clock or switch that is on, or the output of a
// gate or flip-flop. Gates read the nets on their input sides, ignoring the
// sides nothing is connected to.
//
// Signals propagate instantly through wires and gates. Time advances in
// ticks, TICKS_PER_SEC of them per second, and clocks only change from one
// tick to the next. A flip-flop outputs what it holds, and is the only node
// that remembers anything. It has a data input opposite its output, and a
// clock input on its right as seen from the data input. When its clock
// input turns on, it takes in what its data input was just before, and
// outputs it from then on, within the same tick. Flip-flops whose clock
// inputs turn on together all take in what the others held before.
//
// A loop of gates with no flip-flop in it has no defined value: its gates
// output nothing, and are reported as broken, while the rest of the
// circuit keeps working.

let TICKS_PER_SEC = 32;

// Node types
let EMPTY = 0;
let WIRE = 1;
let BEND = 2;
let TEE = 3;
let CROSS = 4;
let BRIDGE = 5;
let CLOCK = 6;
let SWITCH = 7;
let LED = 8;
let AND = 9;
let OR = 10;
let XOR = 11;
let NOT = 12;
let DFF = 13;
let NUM_TYPES = 14;

// Most times flip-flops can change within a tick, one setting off another.
// Those still to change do so on the next tick.
let MAX_PASSES = 16;

// Bits of the state of a flip-flop, see Sim
let FF_ON = 1;
let FF_CLOCK = 2;
let FF_KNOWN = 4;

// Sides of a cell, in clockwise order, and the cell each one faces. A set
// of sides is a mask with bit `side` set for each.
let NORTH = 0;
let EAST = 1;
let SOUTH = 2;
let WEST = 3;
let SIDE_DX = [0, 1, 0, -1];
let SIDE_DY = [-1, 0, 1, 0];

// Sides of each type's ports before it is turned. Wires join the sides of
// each of their groups: the bridge has two, which cross without touching.
// Gates output to the east and read the other three sides, except the NOT,
// which only reads the west. Flip-flops output to the east, and read data
// from the west and their clock from the south.
let WIRE_GROUPS = [[], [10], [3], [14], [15], [5, 10], [], [], [], [], [], [], [], []];
let OUT_SIDES = [0, 0, 0, 0, 0, 0, 15, 15, 0, 2, 2, 2, 2, 2];
let IN_SIDES = [0, 0, 0, 0, 0, 0, 0, 0, 15, 13, 13, 13, 8, 12];

// Number of ways each type can be turned that look different
let NUM_ROTS = [1, 2, 4, 4, 1, 1, 1, 1, 1, 4, 4, 4, 4, 4];

// Builds the value of a cell
fun cell_value(type, rot, param)
{
    return type | (rot << 8) | (param << 16);
}

// Type of the node in a cell. Types this version doesn't know are empty.
fun cell_type(value)
{
    let type = value & 0xFF;
    return type < NUM_TYPES ? type : EMPTY;
}

// Quarter turns of the node in a cell
fun cell_rot(value)
{
    return (value >> 8) & 3;
}

// Param of the node in a cell
fun cell_param(value)
{
    return (value >> 16) & 0xFF;
}

// Turns a set of sides clockwise by a number of quarter turns
fun turn_sides(sides, rot)
{
    return ((sides << rot) | (sides >> (4 - rot))) & 15;
}

// Port tables, indexed by type * 4 + rot: the sides with an output or an
// input. GROUPS has four entries for each, one per side: the sides joined
// to that one inside the cell, itself included, or 0 if the side has no
// port.
let OUTS = [];
let INS = [];
let GROUPS = [];

for (let var type = 0; type < NUM_TYPES; ++type) {
    for (let var rot = 0; rot < 4; ++rot) {
        let outs = turn_sides(OUT_SIDES[type], rot);
        let ins = turn_sides(IN_SIDES[type], rot);
        let groups = [];

        for (let var i = 0; i < WIRE_GROUPS[type].len; ++i)
            groups.push(turn_sides(WIRE_GROUPS[type][i], rot));

        OUTS.push(outs);
        INS.push(ins);

        for (let var side = 0; side < 4; ++side) {
            let var group = (((outs | ins) >> side) & 1) == 1 ? (1 << side) : 0;

            for (let var i = 0; i < groups.len; ++i) {
                if (((groups[i] >> side) & 1) == 1)
                    group = groups[i];
            }

            GROUPS.push(group);
        }
    }
}

// Index of a cell's node in the port tables
fun port_key(value)
{
    return cell_type(value) * 4 + cell_rot(value);
}

// Sides of a cell's wire groups, one set of sides per group
fun wire_groups(value)
{
    let groups = [];
    let base = WIRE_GROUPS[cell_type(value)];

    for (let var i = 0; i < base.len; ++i)
        groups.push(turn_sides(base[i], cell_rot(value)));

    return groups;
}

// Sides of a cell's outputs
fun out_sides(value)
{
    return OUTS[port_key(value)];
}

// Sides of a cell's inputs
fun in_sides(value)
{
    return INS[port_key(value)];
}

// Frequency of a clock in Hz, given its param
fun clock_hz(param)
{
    return TICKS_PER_SEC.to_f() / (2 << param);
}

// Simulation of a circuit of size by size cells
class Sim
{
    // Creates the simulation of an empty grid
    init(self, size)
    {
        self.size = size;

        // Number of ticks so far
        self.t = 0;

        // Net of each side of each cell, as a u32, or 0 if it has no port.
        // Nets are numbered from 1.
        self.slot_net = ByteArray.with_size(size * size * 16);
        self.num_nets = 0;

        // Whether each net is on, one byte per net
        self.net_on = ByteArray.with_size(1);

        // For each cell, one byte. For a flip-flop: FF_ON if it holds a
        // one, FF_CLOCK if its clock input was on when last looked at, and
        // FF_KNOWN once it has been. Then whether a gate there is part of a
        // loop.
        self.ff_state = ByteArray.with_size(size * size);
        self.broken = ByteArray.with_size(size * size);
        self.num_broken = 0;

        // Clocks and switches, gates in the order to evaluate them, and
        // flip-flops, each with the nets it reads and drives
        self.sources = [];
        self.gates = [];
        self.flipflops = [];

        // Bits of the tick counter that some clock follows
        self.clock_bits = 0;

        // Whether flip-flops were still changing at the end of the tick
        self.unsettled = false;
    }

    // Sides of a cell whose nets are on
    sides_on(self, idx)
    {
        let var sides = 0;

        for (let var side = 0; side < 4; ++side) {
            let net = self.slot_net.get_u32(idx * 4 + side);
            if (net != 0 && self.net_on[net] != 0)
                sides = sides | (1 << side);
        }

        return sides;
    }

    // Tests if the gate in a cell is part of a loop
    is_broken(self, idx)
    {
        return self.broken[idx] != 0;
    }

    // Works out the nets and the order to evaluate the gates in, from the
    // values of the cells, held as u32 values whose top byte is ignored.
    // To be called when cells change. Flip-flops in cells that did not
    // change keep what they hold.
    compile(self, cells)
    {
        let size = self.size;
        let slot_net = self.slot_net;

        // Cells with a node
        let nodes = [];
        let num_cells = size * size;
        for (let var idx = 0; idx < num_cells; ++idx) {
            let type = cells.get_u32(idx) & 0xFF;
            if (type != EMPTY && type < NUM_TYPES)
                nodes.push(idx);
        }

        // Flood fill the nets from each port, through wires and into the
        // ports they face. has_src says whether a net has more than gate
        // inputs to it.
        slot_net.zero_fill();
        let has_src = [false];
        let stack = [];
        let var num_nets = 0;

        for (let var i = 0; i < nodes.len; ++i) {
            let key = port_key(cells.get_u32(nodes[i]));

            for (let var side = 0; side < 4; ++side) {
                if (GROUPS[key * 4 + side] == 0 || slot_net.get_u32(nodes[i] * 4 + side) != 0)
                    continue;

                num_nets += 1;
                has_src.push(false);
                slot_net.set_u32(nodes[i] * 4 + side, num_nets);
                stack.push(nodes[i] * 4 + side);

                while (stack.len > 0) {
                    let slot = stack.pop();
                    let idx = slot >> 2;
                    let s = slot & 3;
                    let k = port_key(cells.get_u32(idx));
                    let group = GROUPS[k * 4 + s];

                    if (((INS[k] >> s) & 1) == 0)
                        has_src[num_nets] = true;

                    // Other sides of the same piece of wire
                    for (let var s2 = 0; s2 < 4; ++s2) {
                        if (((group >> s2) & 1) == 1 && slot_net.get_u32(idx * 4 + s2) == 0) {
                            slot_net.set_u32(idx * 4 + s2, num_nets);
                            stack.push(idx * 4 + s2);
                        }
                    }

                    // Port facing this one
                    let x = idx % size + SIDE_DX[s];
                    let y = idx.idiv(size) + SIDE_DY[s];
                    if (x < 0 || y < 0 || x >= size || y >= size)
                        continue;

                    let facing = (y * size + x) * 4 + ((s + 2) & 3);
                    let fk = port_key(cells.get_u32(y * size + x));
                    if (GROUPS[fk * 4 + ((s + 2) & 3)] != 0 && slot_net.get_u32(facing) == 0) {
                        slot_net.set_u32(facing, num_nets);
                        stack.push(facing);
                    }
                }
            }
        }

        self.num_nets = num_nets;
        self.net_on = ByteArray.with_size(num_nets + 1);

        // Nets on a set of sides of a cell. Input sides that nothing is
        // connected to are left out.
        fun nets_on(idx, sides, inputs) {
            let nets = [];

            for (let var side = 0; side < 4; ++side) {
                let net = slot_net.get_u32(idx * 4 + side);
                if (((sides >> side) & 1) == 1 && (!inputs || has_src[net]))
                    nets.push(net);
            }

            return nets;
        }

        // Net of an input side of a cell, or 0 if nothing is connected to it
        fun net_in(idx, side) {
            let net = slot_net.get_u32(idx * 4 + (side & 3));
            return has_src[net] ? net : 0;
        }

        let old_flipflops = self.flipflops;
        let gates = [];
        self.sources = [];
        self.flipflops = [];
        self.clock_bits = 0;

        for (let var i = 0; i < nodes.len; ++i) {
            let idx = nodes[i];
            let value = cells.get_u32(idx) & 0xFF_FF_FF;
            let type = cell_type(value);
            let key = port_key(value);

            if (type == CLOCK || type == SWITCH) {
                self.sources.push({type: type, param: cell_param(value), outs: nets_on(idx, 15, false)});
                if (type == CLOCK)
                    self.clock_bits = self.clock_bits | (1 << cell_param(value));
            } else if (type == DFF) {
                self.flipflops.push({
                    idx: idx,
                    value: value,
                    data: net_in(idx, WEST + cell_rot(value)),
                    clock: net_in(idx, SOUTH + cell_rot(value)),
                    out: nets_on(idx, OUTS[key], false)[0],
                });
            } else if (type >= AND) {
                gates.push({
                    type: type,
                    idx: idx,
                    ins: nets_on(idx, INS[key], true),
                    out: nets_on(idx, OUTS[key], false)[0],
                });
            }
        }

        // A flip-flop that was replaced starts over
        for (let var i = 0; i < old_flipflops.len; ++i) {
            if ((cells.get_u32(old_flipflops[i].idx) & 0xFF_FF_FF) != old_flipflops[i].value)
                self.ff_state[old_flipflops[i].idx] = 0;
        }

        self.order_gates(gates);
        self.settle();
    }

    // Sorts the gates so that each one comes after those driving its
    // inputs, and marks as broken those that can't be, being part of a loop
    order_gates(self, gates)
    {
        // Gates that read and drive each net, by index, once per input
        let readers = Array.with_size(self.num_nets + 1, nil);
        let drivers = Array.with_size(self.num_nets + 1, nil);

        for (let var g = 0; g < gates.len; ++g) {
            let gate = gates[g];

            if (drivers[gate.out] == nil)
                drivers[gate.out] = [];
            drivers[gate.out].push(g);

            for (let var i = 0; i < gate.ins.len; ++i) {
                if (readers[gate.ins[i]] == nil)
                    readers[gate.ins[i]] = [];
                readers[gate.ins[i]].push(g);
            }
        }

        // Number of gates left to place before each gate
        let waiting = [];
        for (let var g = 0; g < gates.len; ++g) {
            let var count = 0;
            for (let var i = 0; i < gates[g].ins.len; ++i) {
                let from = drivers[gates[g].ins[i]];
                count += from == nil ? 0 : from.len;
            }
            waiting.push(count);
        }

        let order = [];
        let ready = [];
        for (let var g = 0; g < gates.len; ++g) {
            if (waiting[g] == 0)
                ready.push(g);
        }

        // The gates reading a net no longer wait for one of its drivers
        fun release(net) {
            let to = readers[net];
            if (to == nil)
                return;

            for (let var i = 0; i < to.len; ++i) {
                waiting[to[i]] -= 1;
                if (waiting[to[i]] == 0)
                    ready.push(to[i]);
            }
        }

        // Places the gates that are ready, and those this makes ready
        fun place_ready() {
            while (ready.len > 0) {
                let g = ready.pop();
                order.push(gates[g]);
                release(gates[g].out);
            }
        }

        place_ready();

        self.broken.zero_fill();
        self.num_broken = 0;

        if (order.len < gates.len) {
            // The gates left are in loops, or after one. Those after one
            // lead to no loop: take away the gates that lead to no gate
            // left, until none do.
            let left = [];
            let leads_to = [];
            let ends = [];

            for (let var g = 0; g < gates.len; ++g)
                left.push(waiting[g] > 0);

            for (let var g = 0; g < gates.len; ++g) {
                let var count = 0;
                let to = readers[gates[g].out];

                for (let var i = 0; left[g] && to != nil && i < to.len; ++i) {
                    if (left[to[i]])
                        count += 1;
                }

                leads_to.push(count);
                if (left[g] && count == 0)
                    ends.push(g);
            }

            while (ends.len > 0) {
                let g = ends.pop();
                left[g] = false;

                for (let var i = 0; i < gates[g].ins.len; ++i) {
                    let from = drivers[gates[g].ins[i]];

                    for (let var j = 0; from != nil && j < from.len; ++j) {
                        leads_to[from[j]] -= 1;
                        if (left[from[j]] && leads_to[from[j]] == 0)
                            ends.push(from[j]);
                    }
                }
            }

            // What remains is broken and outputs nothing, which lets the
            // gates after the loops be placed
            for (let var g = 0; g < gates.len; ++g) {
                if (left[g]) {
                    self.broken[gates[g].idx] = 1;
                    self.num_broken += 1;

                    // Never ready
                    waiting[g] = gates.len * 4 + 1;
                }
            }

            for (let var g = 0; g < gates.len; ++g) {
                if (left[g])
                    release(gates[g].out);
            }

            place_ready();
        }

        self.gates = order;
    }

    // Works out which nets are on, given the tick and what flip-flops hold
    eval(self)
    {
        let on = self.net_on;
        on.zero_fill();

        for (let var i = 0; i < self.sources.len; ++i) {
            let src = self.sources[i];
            let lit = src.type == CLOCK ? (self.t >> src.param) & 1 : src.param & 1;

            if (lit == 1) {
                for (let var j = 0; j < src.outs.len; ++j)
                    on[src.outs[j]] = 1;
            }
        }

        for (let var i = 0; i < self.flipflops.len; ++i) {
            if ((self.ff_state[self.flipflops[i].idx] & FF_ON) != 0)
                on[self.flipflops[i].out] = 1;
        }

        for (let var i = 0; i < self.gates.len; ++i) {
            let gate = self.gates[i];
            let ins = gate.ins;
            let var count = 0;

            for (let var j = 0; j < ins.len; ++j)
                count += on[ins[j]];

            let var out = false;
            if (gate.type == AND)
                out = ins.len > 0 && count == ins.len;
            else if (gate.type == OR)
                out = count > 0;
            else if (gate.type == XOR)
                out = (count & 1) == 1;
            else
                out = count == 0;

            if (out)
                on[gate.out] = 1;
        }
    }

    // Has the flip-flops whose clock input turned on take in their data
    // input, all from the nets as they are. Returns whether any changed.
    latch(self)
    {
        let on = self.net_on;
        let var changed = false;

        for (let var i = 0; i < self.flipflops.len; ++i) {
            let ff = self.flipflops[i];
            let state = self.ff_state[ff.idx];
            let clock = on[ff.clock];
            let var held = state & FF_ON;

            // A flip-flop just placed doesn't take a clock input that is on
            // for one that turned on
            if (clock == 1 && (state & FF_KNOWN) != 0 && (state & FF_CLOCK) == 0)
                held = on[ff.data];

            if (held != (state & FF_ON))
                changed = true;

            self.ff_state[ff.idx] = FF_KNOWN | (clock == 1 ? FF_CLOCK : 0) | held;
        }

        return changed;
    }

    // Works out which nets are on, with the flip-flops this sets off taken
    // into account, and those that these set off in turn
    settle(self)
    {
        self.unsettled = false;

        for (let var pass = 0; pass < MAX_PASSES; ++pass) {
            self.eval();

            if (!self.latch())
                return;
        }

        self.eval();
        self.unsettled = true;
    }

    // Advances the simulation by one tick. Returns false if nothing
    // changed, as no clock did.
    tick(self)
    {
        self.t += 1;

        if (((self.t ^ (self.t - 1)) & self.clock_bits) == 0 && !self.unsettled)
            return false;

        self.settle();
        return true;
    }
}

// Sizes of a circuit cell on screen, like ZOOMS. Nodes can be placed from
// zoom MIN_EDIT_ZOOM up, and grid lines show from cells of GRID_LINES_FROM
// pixels. Nodes are drawn with their outlines from cells of OUTLINES_FROM
// pixels, and in full from cells of DETAILS_FROM pixels.
let CIRCUIT_ZOOMS = [4, 8, 16, 32, 64];
let CIRCUIT_DEFAULT_ZOOM = 4;
let MIN_EDIT_ZOOM = 1;
let GRID_LINES_FROM = 8;
let OUTLINES_FROM = 16;
let DETAILS_FROM = 28;

// Size of the picture of the node picked, under the nodes to pick from
let PREVIEW = 64;

// Most ticks of the circuit simulated per frame. Past that, the circuit
// falls behind rather than skip ticks.
let MAX_TICKS_PER_FRAME = 4;

// Nodes to build circuits with, in the order they are shown, four per row.
// The eraser, which empties cells, comes last.
let NODES = [
    {name: "wire", value: cell_value(WIRE, 0, 0)},
    {name: "bend", value: cell_value(BEND, 0, 0)},
    {name: "tee", value: cell_value(TEE, 0, 0)},
    {name: "cross", value: cell_value(CROSS, 0, 0)},
    {name: "bridge", value: cell_value(BRIDGE, 0, 0)},
    {name: "red LED", value: cell_value(LED, 0, 0)},
    {name: "green LED", value: cell_value(LED, 0, 1)},
    {name: "blue LED", value: cell_value(LED, 0, 2)},
    {name: "1 Hz clock", value: cell_value(CLOCK, 0, 4)},
    {name: "2 Hz clock", value: cell_value(CLOCK, 0, 3)},
    {name: "4 Hz clock", value: cell_value(CLOCK, 0, 2)},
    {name: "8 Hz clock", value: cell_value(CLOCK, 0, 1)},
    {name: "AND", value: cell_value(AND, 0, 0)},
    {name: "OR", value: cell_value(OR, 0, 0)},
    {name: "XOR", value: cell_value(XOR, 0, 0)},
    {name: "NOT", value: cell_value(NOT, 0, 0)},
    {name: "switch", value: cell_value(SWITCH, 0, 0)},
    {name: "flip-flop", value: cell_value(DFF, 0, 0)},
    {name: "eraser", value: 0},
];

// Circuit colors: the grid, wires and the lines of nodes, those that are
// on, and nodes in a loop
let CELL_BG = rgb(14, 12, 24);
let GRID_LINE = rgb(46, 46, 54);
let WIRE_OFF = rgb(240, 240, 245);
let WIRE_ON = rgb(255, 45, 45);
let BROKEN = rgb(255, 70, 180);
let UNKNOWN = rgb(80, 80, 90);

// Body color of each node type that has one
let NODE_COLORS = Array.with_size(NUM_TYPES, UNKNOWN);
NODE_COLORS[CLOCK] = rgb(190, 150, 30);
NODE_COLORS[SWITCH] = rgb(84, 84, 104);
NODE_COLORS[AND] = rgb(50, 100, 210);
NODE_COLORS[OR] = rgb(40, 150, 80);
NODE_COLORS[XOR] = rgb(140, 70, 200);
NODE_COLORS[NOT] = rgb(205, 95, 40);
NODE_COLORS[DFF] = rgb(30, 140, 150);

// Square wave drawn on clocks, as the x and y of each of its corners
let CLOCK_WAVE = [0.26, 0.41, 0.26, 0.25, 0.42, 0.25, 0.42, 0.41, 0.58, 0.41, 0.58, 0.25, 0.74, 0.25, 0.74, 0.41];

// Colors of LEDs that are on, by param
let LED_COLORS = [
    rgb(255, 60, 60),
    rgb(80, 255, 100),
    rgb(80, 150, 255),
    rgb(255, 230, 60),
    rgb(255, 150, 40),
    rgb(210, 90, 255),
    rgb(70, 230, 230),
    rgb(255, 255, 255),
];

// Colors to paint with: the 12-band rainbow, then black, grey, white and
// brown
let PALETTE = [];
for (let var i = 0; i < RAINBOW12.len; ++i)
    PALETTE.push(RAINBOW12[i]);
PALETTE.push(rgb(0, 0, 0));
PALETTE.push(rgb(128, 128, 128));
PALETTE.push(rgb(255, 255, 255));
PALETTE.push(rgb(139, 69, 19));

// Characters per line in the compose box and the message list
let COMPOSE_COLS = (WIDTH - 2 * MARGIN - 2 * TEXT_PAD).idiv(CHAR_W);
let MSG_COLS = (WIDTH - 2 * MARGIN - SCROLLBAR_W - 2 * TEXT_PAD).idiv(CHAR_W);

// Splits a string into an array of single-character strings
fun chars(s)
{
    let out = [];
    let var i = 0;

    while (i < s.len) {
        let ch = s.char_at(i);

        if (ch == nil) {
            i = i + 1;
            continue;
        }

        out.push(ch);
        i = i + ch.len;
    }

    return out;
}

// Joins an array of strings into one
fun join(parts)
{
    let out = ByteArray.with_size(0);

    for (let var i = 0; i < parts.len; ++i)
        out.push_string(parts[i]);

    return String.from_utf8(out, 0, out.len);
}

// Number of characters in a string
fun num_chars(s)
{
    return chars(s).len;
}

// Wraps text into lines of at most cols characters, breaking at spaces
// where possible
fun wrap(text, cols)
{
    let cs = chars(text);
    cs.push(" ");

    let lines = [];
    let var line = [];
    let var word = [];

    for (let var i = 0; i < cs.len; ++i) {
        if (cs[i] != " ") {
            word.push(cs[i]);
            continue;
        }

        let sep = line.len > 0 ? 1 : 0;

        if (line.len + sep + word.len <= cols) {
            if (sep == 1)
                line.push(" ");
            line.append(word);
        } else {
            if (line.len > 0)
                lines.push(join(line));

            // Words longer than a line are split
            while (word.len > cols) {
                lines.push(join(word.slice(0, cols)));
                word = word.slice(cols, word.len);
            }

            line = word;
        }

        word = [];
    }

    if (line.len > 0 || lines.len == 0)
        lines.push(join(line));

    return lines;
}

// Describes how long ago a Unix timestamp was
fun time_ago(time)
{
    let secs = $time_current_ms().idiv(1000) - time;

    if (secs < 60) return "just now";

    let mins = secs.idiv(60);
    if (mins < 60) return mins.to_s() + " min ago";

    let hours = mins.idiv(60);
    if (hours < 24) return hours.to_s() + (hours == 1 ? " hour ago" : " hours ago");

    let days = hours.idiv(24);
    if (days < 30) return days.to_s() + (days == 1 ? " day ago" : " days ago");

    let months = days.idiv(30);
    if (months < 12) return months.to_s() + (months == 1 ? " month ago" : " months ago");

    let years = days.idiv(365);
    return years.to_s() + (years == 1 ? " year ago" : " years ago");
}

// Picks a rainbow color for a username, so that each user keeps theirs
fun name_color(name)
{
    let var sum = 0;

    for (let var i = 0; i < name.len; ++i)
        sum = sum + name.byte_at(i);

    return RAINBOW[sum % RAINBOW.len];
}

// Tests if a byte can be part of a username: an ASCII letter or digit, or
// an underscore
fun is_name_byte(b)
{
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95;
}

// Tests if a username has only the characters the server accepts
fun valid_username(name)
{
    if (name.len < 2 || name.len > MAX_NAME_LEN)
        return false;

    for (let var i = 0; i < name.len; ++i) {
        if (!is_name_byte(name.byte_at(i)))
            return false;
    }

    return true;
}

// Hash of a password, as the server expects it
fun password_hash(password)
{
    return sha256(HASH_PREFIX + password).to_hex();
}

// Converts a hue in [0, 360) and a saturation and value in [0, 1] to a color
fun hsv_to_rgb(h, s, v)
{
    let sector = (h / 60.0).floor();
    let f = h / 60.0 - sector;
    let p = v * (1.0 - s);
    let q = v * (1.0 - s * f);
    let t = v * (1.0 - s * (1.0 - f));

    // Scales a component to [0, 255]
    fun byte(c) {
        return (c * 255.0 + 0.5).floor().clip(0, 255);
    }

    let i = sector % 6;
    if (i == 0) return rgb(byte(v), byte(t), byte(p));
    if (i == 1) return rgb(byte(q), byte(v), byte(p));
    if (i == 2) return rgb(byte(p), byte(v), byte(t));
    if (i == 3) return rgb(byte(p), byte(q), byte(v));
    if (i == 4) return rgb(byte(t), byte(p), byte(v));
    return rgb(byte(v), byte(p), byte(q));
}

// Converts a color to its hue, saturation and value, see hsv_to_rgb
fun rgb_to_hsv(color)
{
    let r = ((color >> 16) & 0xFF) / 255.0;
    let g = ((color >> 8) & 0xFF) / 255.0;
    let b = (color & 0xFF) / 255.0;
    let hi = r.max(g).max(b);
    let d = hi - r.min(g).min(b);
    let var h = 0.0;

    if (d > 0.0) {
        if (hi == r)
            h = 60.0 * ((g - b) / d);
        else if (hi == g)
            h = 60.0 * ((b - r) / d + 2.0);
        else
            h = 60.0 * ((r - g) / d + 4.0);

        if (h < 0.0)
            h = h + 360.0;
    }

    return {h: h, s: hi > 0.0 ? d / hi : 0.0, v: hi};
}

// Draws a filled ellipse
fun fill_ellipse(img, cx, cy, rx, ry, color)
{
    for (let var dy = -ry; dy <= ry; ++dy) {
        let t = dy.to_f() / ry;
        let half = (rx * (1.0 - t * t).max(0.0).sqrt()).floor();
        img.fill_rect(cx - half, cy + dy, 2 * half + 1, 1, color);
    }
}

// Draws the outline of a rectangle
fun draw_rect(img, x, y, w, h, color)
{
    img.fill_rect(x, y, w, 1, color);
    img.fill_rect(x, y + h - 1, w, 1, color);
    img.fill_rect(x, y, 1, h, color);
    img.fill_rect(x + w - 1, y, 1, h, color);
}

// Draws a teddy bear in a size by size box. If shades_y is not nil, the
// bear wears sunglasses, shades_y units below where they sit on its face,
// so that they can be animated falling into place. Without them, its eyes
// show.
fun draw_bear(img, x, y, size, shades_y)
{
    let s = size / 100.0;

    // Draws an ellipse given in the bear's 100 by 100 coordinates
    fun part(cx, cy, rx, ry, color) {
        fill_ellipse(img, x + (cx * s).floor(), y + (cy * s).floor(), (rx * s).floor().max(1), (ry * s).floor().max(1), color);
    }

    // Ears
    part(24, 19, 10, 10, FUR);
    part(76, 19, 10, 10, FUR);
    part(24, 19, 5, 5, FUR_LIGHT);
    part(76, 19, 5, 5, FUR_LIGHT);

    // Body, arms and feet
    part(50, 78, 28, 22, FUR);
    part(50, 81, 16, 13, FUR_LIGHT);
    part(21, 74, 9, 13, FUR);
    part(79, 74, 9, 13, FUR);
    part(32, 94, 12, 6, FUR);
    part(68, 94, 12, 6, FUR);

    // Head, muzzle, nose and eyes
    part(50, 40, 32, 29, FUR);
    part(50, 54, 13, 9, FUR_LIGHT);
    part(50, 50, 5, 3, FUR_DARK);
    part(38, 38, 4, 4, FUR_DARK);
    part(62, 38, 4, 4, FUR_DARK);

    if (shades_y != nil) {
        let sy = 36 + shades_y;
        part(38, sy, 10, 6, FUR_DARK);
        part(62, sy, 10, 6, FUR_DARK);
        img.fill_rect(x + (44 * s).floor(), y + ((sy - 2) * s).floor(), (12 * s).floor().max(1), (3 * s).floor().max(1), FUR_DARK);
    }
}

// Height of the logo for a given size
fun logo_height(size)
{
    return NUM_STRIPES * (size.stripe + size.gap) - size.gap;
}

// Width of the logo, letters and bear, for a given size
fun logo_width(size)
{
    return 56 * size.cell + logo_height(size);
}

// Draws the logo: the letters of PLUSH in rainbow colors, each made of
// horizontal stripes, followed by the teddy bear. letter_stripes says how
// many stripes of each letter to draw. The bear is only drawn if show_bear
// is true, with its sunglasses at shades_y (see draw_bear).
fun draw_logo(img, x, y, size, letter_stripes, show_bear, shades_y)
{
    let period = size.stripe + size.gap;

    for (let var i = 0; i < LOGO_LETTERS.len; ++i) {
        let rows = LOGO_LETTERS[i];
        let lx = x + i * (LETTER_COLS + 2) * size.cell;

        for (let var r = 0; r < letter_stripes[i]; ++r) {
            let row = rows[r];
            let var c = 0;

            // Draw each run of filled cells as one bar
            while (c < LETTER_COLS) {
                if (row.byte_at(c) != 35) {
                    c = c + 1;
                    continue;
                }

                let start = c;
                while (c < LETTER_COLS && row.byte_at(c) == 35)
                    c = c + 1;

                img.fill_rect(lx + start * size.cell, y + r * period, (c - start) * size.cell, size.stripe, RAINBOW[i]);
            }
        }
    }

    if (show_bear)
        draw_bear(img, x + 56 * size.cell, y - size.bear_up, logo_height(size), shades_y);
}

// Draws the complete logo
fun draw_full_logo(img, x, y, size)
{
    draw_logo(img, x, y, size, [8, 8, 8, 8, 8], true, 0);
}

// Actor that connects to the server, then reads lines from the socket and
// forwards each parsed message to the main actor. gen tells messages from
// an old connection apart from the current one.
fun net_actor(addr, gen)
{
    let parent = $actor_parent();
    let sock = $net_connect(addr);

    if (sock == nil) {
        $actor_send(parent, {net: "failed", gen: gen});
        return;
    }

    // Wait for data as long as it takes, the server sends nothing when idle
    $net_set_timeout(sock, 0);
    $actor_send(parent, {net: "connected", gen: gen, sock: sock});

    let buf = ByteArray.with_size(1 << 20);
    let var len = 0;

    // Raw data being read, which follows a message with a `bytes` field,
    // and is forwarded with it in its `data` field
    let var blob = nil;
    let var blob_len = 0;
    let var blob_msg = nil;

    loop {
        let num_read = $net_read(sock, buf, len, buf.len - len);

        if (num_read == nil || (num_read == 0 && len == buf.len))
            break;

        len = len + num_read;

        // Forward every complete line, and the raw data after it, if any
        let var start = 0;
        let var i = 0;

        while (i < len) {
            if (blob != nil) {
                let num = (len - i).min(blob.len - blob_len);
                blob.memcpy(blob_len, buf, i, num);
                blob_len = blob_len + num;
                i = i + num;
                start = i;

                if (blob_len == blob.len) {
                    blob_msg.data = blob;
                    $actor_send(parent, {net: "msg", gen: gen, msg: blob_msg});
                    blob = nil;
                }

                continue;
            }

            if (buf[i] != 10) {
                i = i + 1;
                continue;
            }

            let line = String.from_utf8(buf, start, i - start);
            i = i + 1;
            start = i;

            if (line == nil)
                continue;

            let msg = parse_json(line);
            if (!(msg instanceof Dict))
                continue;

            if (msg.has("bytes") && msg.bytes instanceof Int64 && msg.bytes > 0 && msg.bytes <= MAX_BLOB) {
                blob = ByteArray.with_size(msg.bytes);
                blob_len = 0;
                blob_msg = msg;
            } else {
                $actor_send(parent, {net: "msg", gen: gen, msg: msg});
            }
        }

        buf.memcpy(0, buf, start, len - start);
        len = len - start;
    }

    $actor_send(parent, {net: "closed", gen: gen});
}

// Distance from a point to the segment from a to b
fun seg_dist(u, v, ax, ay, bx, by)
{
    let dx = bx - ax;
    let dy = by - ay;
    let t = (((u - ax) * dx + (v - ay) * dy) / (dx * dx + dy * dy)).clip(0.0, 1.0);
    let ex = u - ax - t * dx;
    let ey = v - ay - t * dy;
    return (ex * ex + ey * ey).sqrt();
}

// Tests if a point is in the body of a circuit node of a given type. Nodes
// are drawn in a unit square, with their output to the east. Gates have the
// shapes of their schematic symbols, LEDs are round, and the rest square.
// Flip-flops are larger, to fit their labels.
fun in_body(type, u, v)
{
    let du = u - 0.5;
    let dv = v - 0.5;
    let half = type == DFF ? 0.38 : 0.34;

    if (dv.abs() > half)
        return false;

    if (type == AND)
        return u >= 0.16 && (u <= 0.5 || du * du + dv * dv <= 0.1156);

    if (type == OR || type == XOR) {
        // A hollow back, further in for the XOR, and two arcs that meet
        // at the output
        let bu = u - (type == XOR ? 0.01 : -0.09);
        let fu = u - 0.16;

        if (bu * bu + dv * dv < 0.178)
            return false;

        return fu * fu + (v - 0.96) * (v - 0.96) <= 0.674 && fu * fu + (v - 0.04) * (v - 0.04) <= 0.674;
    }

    // A triangle at the back, whose tip its bubble covers
    if (type == NOT)
        return u >= 0.19 && dv.abs() <= 0.34 * (1.0 - (u - 0.19) / 0.46);

    if (type == LED)
        return du * du + dv * dv <= 0.1156;

    return du.abs() <= half;
}

// What to draw at a point of the picture of a circuit node, in a cell of c
// pixels: 0 for nothing, 1 for its body, 2 for its lines, 3 for its details
fun node_shade(type, on, u, v, c)
{
    let du = u - 0.5;
    let dv = v - 0.5;
    let outlined = c >= OUTLINES_FROM;

    // Half the thickness of thin lines, at least most of a pixel
    let thin = (0.6 / c).max(0.022);

    // Second arc at the back of the XOR
    if (type == XOR && outlined && u > 0.0 && dv.abs() <= 0.34) {
        let d = ((u + 0.09) * (u + 0.09) + dv * dv).sqrt();
        if ((d - 0.422).abs() <= thin)
            return 2;
    }

    // Bubble at the tip of the NOT
    if (type == NOT) {
        let d = ((u - 0.7) * (u - 0.7) + dv * dv).sqrt();
        if (d <= 0.14)
            return outlined && d >= 0.105 ? 2 : 1;
    }

    if (!in_body(type, u, v))
        return 0;

    if (type == SWITCH) {
        if (!outlined)
            return on && du.abs() <= 0.17 && dv.abs() <= 0.17 ? 3 : 1;

        // Two contacts, and a lever that joins them when on
        if (seg_dist(u, v, 0.3, 0.6, on ? 0.7 : 0.66, on ? 0.6 : 0.36) <= thin)
            return 3;
        if ((du.abs() - 0.2) * (du.abs() - 0.2) + (v - 0.6) * (v - 0.6) <= 0.0049)
            return 2;
    }

    // Wedge at the clock input of the flip-flop, to the south
    if (type == DFF && outlined && v >= 0.7 && v <= 0.84 && du.abs() <= 0.12 * (v - 0.7) / 0.14)
        return 2;

    if (type == CLOCK && c >= DETAILS_FROM) {
        for (let var i = 0; i + 3 < CLOCK_WAVE.len; i += 2) {
            if (seg_dist(u, v, CLOCK_WAVE[i], CLOCK_WAVE[i + 1], CLOCK_WAVE[i + 2], CLOCK_WAVE[i + 3]) <= thin)
                return 3;
        }
    }

    // Diode in the LED: a triangle pointing at a bar
    if (type == LED && c >= DETAILS_FROM) {
        if (u >= 0.36 && u <= 0.6 && dv.abs() <= 0.16 * (0.6 - u) / 0.24)
            return 3;
        if (u > 0.6 && u <= 0.66 && dv.abs() <= 0.16)
            return 3;
    }

    // Points near the edge leave the body when moved away from its middle,
    // which for the triangle of the NOT is further back
    if (outlined) {
        let mid = type == NOT ? 0.36 : 0.5;
        let grow = type == NOT ? 1.26 : 1.16;
        if (!in_body(type, mid + (u - mid) * grow, 0.5 + dv * grow))
            return 2;
    }

    return 1;
}

// The part of a grid shown on screen, in a square of VIEW_SIZE pixels
class View
{
    // zooms are the sizes of a cell on screen, in pixels, from zoomed out
    // to zoomed in, which all divide VIEW_SIZE
    init(self, zooms, default_zoom)
    {
        self.zooms = zooms;
        self.default_zoom = default_zoom;

        // Size of the grid, zoom level, and top-left cell in view
        self.size = 0;
        self.zoom = default_zoom;
        self.x = 0;
        self.y = 0;

        // Image of the view at that zoom, redrawn when dirty is set
        self.img = Image(VIEW_SIZE, VIEW_SIZE);
        self.dirty = true;
    }

    // Size of a cell on screen at the current zoom, in pixels
    cell(self)
    {
        return self.zooms[self.zoom];
    }

    // Number of cells across the view at the current zoom
    visible(self)
    {
        return VIEW_SIZE.idiv(self.cell());
    }

    // Shows the middle of a grid of a given size, at the default zoom
    reset(self, size)
    {
        self.size = size;
        self.zoom = self.default_zoom;
        self.x = (size - self.visible()).idiv(2);
        self.y = self.x;
        self.clamp();
    }

    // Keeps the view within the grid
    clamp(self)
    {
        let max_pos = (self.size - self.visible()).max(0);
        self.x = self.x.clip(0, max_pos);
        self.y = self.y.clip(0, max_pos);
        self.dirty = true;
    }

    // Moves the view by a number of steps, each the same distance on screen
    // at every zoom: one cell of the canvas at its starting zoom
    pan(self, dx, dy)
    {
        let step = self.visible().idiv(64).max(1);
        self.x = self.x + dx * step;
        self.y = self.y + dy * step;
        self.clamp();
    }

    // Zooms in or out by a number of levels, around the middle of the view
    zoom_by(self, levels)
    {
        let mid_x = self.x + self.visible().idiv(2);
        let mid_y = self.y + self.visible().idiv(2);
        self.zoom = (self.zoom + levels).clip(0, self.zooms.len - 1);
        self.x = mid_x - self.visible().idiv(2);
        self.y = mid_y - self.visible().idiv(2);
        self.clamp();
    }

    // Cell at a position in the frame, or nil outside of the view or of
    // the grid
    cell_at(self, x, y)
    {
        if (x < VIEW_X || y < VIEW_Y || x >= VIEW_X + VIEW_SIZE || y >= VIEW_Y + VIEW_SIZE)
            return nil;

        let cx = self.x + (x - VIEW_X).idiv(self.cell());
        let cy = self.y + (y - VIEW_Y).idiv(self.cell());

        if (cx >= self.size || cy >= self.size)
            return nil;

        return {x: cx, y: cy};
    }
}

// A grid of cells shared with the server, the pixel canvas or the circuit:
// our copy of it, and what it takes to keep it up to date. Requests are
// sent through the app, which hands their responses back.
class Grid
{
    // name starts the types of the grid's requests, value_key is the field
    // of a set request that holds the value of a cell, blank is what cells
    // hold until they are fetched, and view is the part of the grid shown
    init(self, name, value_key, blank, view)
    {
        self.name = name;
        self.value_key = value_key;
        self.blank = blank;
        self.view = view;

        // Our copy of the grid, created once the server tells its size,
        // and for each tile, the server's change counter when we fetched it,
        // or -1 if it has to be fetched, and whether a request is on its way
        self.img = nil;
        self.size = 0;
        self.tile_size = 0;
        self.tiles = [];

        // Epoch and seq of the last poll response, which the next poll sends
        self.epoch = nil;
        self.seq = nil;
        self.polling = false;
        self.last_poll_ms = 0;
        self.error = "";

        // Cells we changed that are waiting to be sent
        self.set_queue = [];
        self.last_set_ms = 0;

        // Set when cells change, for the circuit to be worked out again
        self.changed = false;
    }

    // Notes that cells changed
    touch(self)
    {
        self.changed = true;
        self.view.dirty = true;
    }

    // Tests if the grid, or part of it, is still to be fetched
    loading(self)
    {
        for (let var i = 0; i < self.tiles.len; ++i) {
            if (self.tiles[i].have == -1)
                return true;
        }

        return self.img == nil;
    }

    // Forgets the requests that were lost with the connection, and undoes
    // the changes that were not sent
    reset_requests(self)
    {
        self.polling = false;

        for (let var i = 0; i < self.tiles.len; ++i)
            self.tiles[i].requested = false;

        for (let var i = self.set_queue.len - 1; i >= 0; i = i - 1) {
            let set = self.set_queue[i];
            self.img.bytes.set_u32(set.y * self.size + set.x, set.prev);
        }

        self.set_queue = [];
        self.touch();
    }

    // Asks the server for the cells that changed since the last poll
    poll(self, app)
    {
        let req = {type: self.name + "_poll"};

        if (self.epoch != nil) {
            req.epoch = self.epoch;
            req.since = self.seq;
        }

        if (app.send(req, self)) {
            self.polling = true;
            self.last_poll_ms = $time_current_ms();
        }
    }

    // Creates our copy of the grid, with every tile still to fetch, and
    // the view on its middle
    create(self, size, tile_size)
    {
        self.img = Image(size, size);
        self.img.clear(self.blank);
        self.size = size;
        self.tile_size = tile_size;
        self.epoch = nil;
        self.set_queue = [];

        self.tiles = [];
        let per_row = size.idiv(tile_size);
        for (let var i = 0; i < per_row * per_row; ++i)
            self.tiles.push({have: -1, requested: false});

        self.view.reset(size);
        self.touch();
    }

    // Handles the response to a poll: either the cells that changed, or,
    // when the server can't tell which did, the change counter of each tile
    on_poll(self, app, res)
    {
        self.polling = false;

        if (!res.ok) {
            // Servers older than the grid don't know the request
            self.error = res.error == "unknown request type" ? "no " + self.name + " here" : res.error;
            return;
        }

        if (self.img == nil || self.size != res.size || self.tile_size != res.tile_size)
            self.create(res.size, res.tile_size);

        if (res.has("tiles")) {
            // After a server restart, any tile may have changed
            let restarted = self.epoch != res.epoch;

            for (let var i = 0; i < self.tiles.len && i < res.tiles.len; ++i) {
                if (restarted || self.tiles[i].have != res.tiles[i])
                    self.tiles[i].have = -1;
            }
        } else {
            let pixels = res.pixels;

            for (let var i = 0; i + 2 < pixels.len; i = i + 3) {
                if (pixels[i] < self.size && pixels[i + 1] < self.size)
                    self.img.set_pixel(pixels[i], pixels[i + 1], rgb(0, 0, 0) | pixels[i + 2]);
            }

            if (pixels.len > 0)
                self.touch();
        }

        self.epoch = res.epoch;
        self.seq = res.seq;
        self.request_tiles(app);
    }

    // Requests the tiles that have to be fetched, nearest to the middle of
    // the view first
    request_tiles(self, app)
    {
        let per_row = self.size.idiv(self.tile_size);
        let mid_x = self.view.x + self.view.visible().idiv(2);
        let mid_y = self.view.y + self.view.visible().idiv(2);

        // Distance from the middle of a tile to the middle of the view
        let dists = [];
        for (let var i = 0; i < self.tiles.len; ++i) {
            let dx = (i % per_row) * self.tile_size + self.tile_size.idiv(2) - mid_x;
            let dy = i.idiv(per_row) * self.tile_size + self.tile_size.idiv(2) - mid_y;
            dists.push(dx * dx + dy * dy);
        }

        loop {
            let var best = nil;

            for (let var i = 0; i < self.tiles.len; ++i) {
                let tile = self.tiles[i];
                if (tile.have == -1 && !tile.requested && (best == nil || dists[i] < dists[best]))
                    best = i;
            }

            if (best == nil || !app.send({type: self.name + "_tile", tx: best % per_row, ty: best.idiv(per_row)}, self))
                break;

            self.tiles[best].requested = true;
        }
    }

    // Handles the response to a tile request, whose data is a TGA file
    on_tile(self, req, res)
    {
        let per_row = self.size.idiv(self.tile_size);
        let tile = self.tiles[req.ty * per_row + req.tx];
        tile.requested = false;

        if (!res.ok || !res.has("data"))
            return;

        let img = decode_tga(res.data);

        if (img == nil || img.width != self.tile_size || img.height != self.tile_size)
            return;

        self.img.blit(img, req.tx * self.tile_size, req.ty * self.tile_size);
        tile.have = res.seq;
        self.touch();
    }

    // Value of a cell, as stored in our copy of the grid
    get(self, x, y)
    {
        return self.img.bytes.get_u32(y * self.size + x);
    }

    // Changes the value of a cell. It shows right away, and is sent to the
    // server from update(), a few per second at most. Returns false if the
    // cell can't be changed for now, or already has that value.
    put(self, x, y, value)
    {
        let per_row = self.size.idiv(self.tile_size);
        let tile = self.tiles[y.idiv(self.tile_size) * per_row + x.idiv(self.tile_size)];
        let prev = self.get(x, y);

        if (tile.have == -1 || prev == value || self.set_queue.len >= MAX_QUEUED_SETS)
            return false;

        self.img.bytes.set_u32(y * self.size + x, value);
        self.set_queue.push({x: x, y: y, value: value, prev: prev});
        self.touch();
        return true;
    }

    // Handles the response to a change we sent. A change the server
    // dropped is undone, unless the cell was changed again since.
    on_set(self, res, set)
    {
        if (!res.ok && self.get(set.x, set.y) == set.value) {
            self.img.bytes.set_u32(set.y * self.size + set.x, set.prev);
            self.touch();
        }
    }

    // Polls the server when it is time to, and sends the next change
    update(self, app, now)
    {
        if (!self.polling && self.error == "" && now - self.last_poll_ms >= CANVAS_POLL_MS)
            self.poll(app);

        if (self.set_queue.len > 0 && now - self.last_set_ms >= SET_INTERVAL_MS) {
            let set = self.set_queue.remove(0);
            let req = {type: self.name + "_set", x: set.x, y: set.y};
            req[self.value_key] = set.value & 0xFF_FF_FF;
            app.send(req, {grid: self, set: set});
            self.last_set_ms = now;
        }
    }
}

// State of the client and its screens: the intro animation, the guestbook,
// the canvas, the circuit and the admin page. The box to register or log
// in is drawn over the guestbook.
class App
{
    // Creates the client for a given server address
    init(self, addr)
    {
        self.addr = addr;
        self.frame = Image(WIDTH, HEIGHT);
        self.panel = Image(WIDTH - 2 * MARGIN, FOOTER_Y - 8 - PANEL_Y);
        self.fonts = {};

        // Pictures of circuit nodes, see node_sprite
        self.sprites = {};

        self.screen = "intro";
        self.start_ms = $time_current_ms();
        self.dirty = true;
        self.cursor_on = true;

        // Connection to the server
        self.conn = "connecting";
        self.sock = nil;
        self.gen = 0;
        self.pending = [];
        self.total_views = nil;
        self.messages_today = nil;
        self.num_accounts = nil;

        // Login box fields: username, password and password confirmation,
        // as arrays of characters. Confirmation is only used to register.
        self.fields = [[], [], []];
        self.focus = 0;
        self.status = "";
        self.status_color = DIM;

        // Whether the login box is open, its own status line, and whether
        // to send the message being written once logged in
        self.modal = false;
        self.modal_status = "";
        self.modal_status_color = DIM;
        self.post_after_auth = false;

        // Logged in user, and credentials to log in again after reconnecting
        self.username = nil;
        self.is_admin = false;
        self.auth = nil;
        self.admin_info = nil;
        self.admin_error = "";

        // Messages, newest first, with their wrapped lines
        self.messages = [];
        self.msg_ids = {};
        self.scroll_y = 0;
        self.loading_older = false;
        self.no_more_older = false;
        self.compose = [];

        // Clickable areas of the last frame drawn, and scrollbar dragging
        self.buttons = [];
        self.drag_offset = nil;

        // Id of the message the admin is about to delete, which then shows
        // the categories to delete it as
        self.deleting = nil;

        // The pixel canvas and the circuit, whose cells hold nodes. Cells
        // of the circuit are empty until they are fetched.
        self.canvas = Grid("canvas", "color", FIELD, View(ZOOMS, DEFAULT_ZOOM));
        self.circuit = Grid("circuit", "value", rgb(0, 0, 0), View(CIRCUIT_ZOOMS, CIRCUIT_DEFAULT_ZOOM));

        // Cell under the mouse on the canvas or circuit screen, or nil, and
        // the last cell changed while the mouse button is held, with
        // whether it is emptying cells
        self.hover = nil;
        self.painting = nil;

        // Simulation of the circuit, created with it, and the time up to
        // which it was run. Then the node to place, as an index in NODES,
        // and how far it is turned.
        self.sim = nil;
        self.sim_ms = 0.0;
        self.node = 0;
        self.rot = 0;

        // Color to paint with: one of the palette's, or the custom color
        // made with the color picker. Then the custom color's place in the
        // picker, the picker's images, and which part of the picker is
        // being dragged, if any.
        self.color = PALETTE[0];
        self.custom = self.color;
        self.custom_selected = false;
        self.hsv = rgb_to_hsv(self.custom);
        self.sv_img = Image(SIDE_W, PICK_H);
        self.sv_hue = nil;
        self.hue_img = Image(SIDE_W, HUE_H);
        self.pick_drag = nil;

        for (let var x = 0; x < SIDE_W; x = x + PICK_BLOCK)
            self.hue_img.fill_rect(x, 0, PICK_BLOCK, HUE_H, hsv_to_rgb(360.0 * x / SIDE_W, 1.0, 1.0));
    }

    // Returns a font of a given scale for a text color on a background color
    font(self, scale, color, bg)
    {
        let key = scale.to_s() + ":" + color.to_s() + ":" + bg.to_s();

        if (!self.fonts.has(key))
            self.fonts[key] = Font(scale, color, bg);

        return self.fonts[key];
    }

    // Draws a line of text into an image
    text(self, img, x, y, str, color, bg)
    {
        let font = self.font(2, color, bg);
        let cs = chars(str);

        for (let var i = 0; i < cs.len; ++i)
            font.draw_char(img, x + i * CHAR_W, y, cs[i]);
    }

    // Draws a line of text centered horizontally in the frame
    centered(self, y, str, color)
    {
        self.text(self.frame, (WIDTH - num_chars(str) * CHAR_W).idiv(2), y, str, color, BG);
    }

    // Shows a status message on the guestbook screen
    set_status(self, msg, color)
    {
        self.status = msg;
        self.status_color = color;
        self.dirty = true;
    }

    // Shows a status message in the login box
    set_modal_status(self, msg, color)
    {
        self.modal_status = msg;
        self.modal_status_color = color;
        self.dirty = true;
    }

    // Opens the login box. If post is true, the message being written is
    // sent once logged in.
    open_modal(self, post)
    {
        self.modal = true;
        self.post_after_auth = post;
        self.drag_offset = nil;
        self.deleting = nil;
        self.set_modal_status("", DIM);
    }

    // Closes the login box, forgetting the passwords typed
    close_modal(self)
    {
        self.modal = false;
        self.post_after_auth = false;
        self.fields[1] = [];
        self.fields[2] = [];
        self.focus = 0;
        self.dirty = true;
    }

    // Starts connecting to the server, in a new network actor
    connect(self)
    {
        self.gen = self.gen + 1;
        self.conn = "connecting";
        self.sock = nil;
        self.pending = [];
        self.loading_older = false;
        self.dirty = true;
        self.canvas.reset_requests();
        self.circuit.reset_requests();

        let addr = self.addr;
        let gen = self.gen;
        $actor_spawn(|| net_actor(addr, gen));
    }

    // Drops the connection, which the network actor notices and reports
    disconnect(self)
    {
        if (self.sock != nil)
            $net_close(self.sock);

        self.sock = nil;
        self.conn = "closed";
    }

    // Sends a request to the server. info is kept with it, to handle the
    // response, which comes back in the same order as the requests.
    send(self, req, info)
    {
        if (self.conn != "connected")
            return false;

        let out = ByteArray.with_size(0);
        out.push_string(format_json(req));
        out.push_u8(10);

        if ($net_write(self.sock, out, 0, out.len) == nil) {
            self.disconnect();
            return false;
        }

        self.pending.push({req: req, info: info});
        return true;
    }

    // Handles a message from the mailbox: a UI event, a timer tick, or a
    // message from the network actor
    handle(self, msg)
    {
        if (msg instanceof UIEvent) {
            self.handle_ui(msg);
            return;
        }

        if (msg == "tick") {
            self.on_tick();
            return;
        }

        if (msg instanceof Dict && msg.has("net"))
            self.handle_net(msg);
    }

    // Refreshes the current page every few seconds and reconnects when needed
    on_tick(self)
    {
        if (self.screen == "intro")
            return;

        if (self.conn == "failed" || self.conn == "closed") {
            self.connect();
            return;
        }

        if (self.screen == "main" && self.pending.len == 0) {
            self.request_newer();
            self.send({type: "stats"}, nil);
        } else if (self.screen == "admin" && self.is_admin && self.pending.len == 0) {
            self.send({type: "admin_info"}, nil);
        }
    }

    // Handles a message from the network actor
    handle_net(self, msg)
    {
        if (msg.gen != self.gen)
            return;

        self.dirty = true;

        if (msg.net == "failed") {
            self.conn = "failed";
            self.is_admin = false;
            self.admin_info = nil;
            self.admin_error = "";
            return;
        }

        if (msg.net == "connected") {
            self.conn = "connected";
            self.sock = msg.sock;
            return;
        }

        if (msg.net == "closed") {
            self.conn = "closed";
            self.sock = nil;
            self.pending = [];
            self.loading_older = false;
            self.is_admin = false;
            self.admin_info = nil;
            self.admin_error = "";
            self.canvas.reset_requests();
            self.circuit.reset_requests();

            // A login request in flight is lost
            if (self.modal && self.modal_status != "")
                self.set_modal_status("Connection lost, please try again", ERROR);
            return;
        }

        self.handle_response(msg.msg);
    }

    // Handles a response from the server
    handle_response(self, res)
    {
        // The hello comes unprompted when connecting
        if (res.type == "hello") {
            if (!res.ok) {
                self.set_status(res.error, ERROR);
                return;
            }

            self.total_views = res.total_views;
            self.messages_today = res.has("messages_today") ? res.messages_today : nil;
            self.num_accounts = res.has("num_accounts") ? res.num_accounts : nil;

            // Log back in after a reconnection, which then fetches messages
            if (self.auth != nil)
                self.send({type: "login", username: self.auth.username, hash: self.auth.hash}, {silent: true});
            else if (self.screen == "main" && self.pending.len == 0)
                self.request_newer();

            return;
        }

        if (self.pending.len == 0)
            return;

        let sent = self.pending.remove(0);
        let req = sent.req;
        let info = sent.info;

        if (req.type == "login" || req.type == "register") {
            let silent = info != nil && info.silent;

            if (res.ok) {
                self.username = res.username;
                self.is_admin = res.status == "ADMIN";
                self.auth = {username: req.username, hash: req.hash};

                if (self.screen == "admin" && self.is_admin)
                    self.send({type: "admin_info"}, nil);
                else
                    self.request_newer();

                if (!silent) {
                    let post = self.post_after_auth;
                    self.close_modal();
                    self.fields[0] = [];
                    self.set_status("Welcome, " + res.username + "!", SUCCESS);

                    if (post)
                        self.submit_post();
                }
            } else if (silent) {
                // Back to browsing as a guest
                self.auth = nil;
                self.username = nil;
                self.is_admin = false;
                self.admin_info = nil;
                self.screen = "main";
                self.set_status(res.error, ERROR);
            } else {
                self.set_modal_status(res.error, ERROR);
            }
            return;
        }

        if (req.type == "get_messages") {
            if (info.mode == "older")
                self.loading_older = false;

            if (res.ok) {
                self.add_messages(res.messages);

                if (info.mode != "newer" && res.messages.len < req.limit)
                    self.no_more_older = true;
            }
            return;
        }

        if (req.type == "post") {
            if (res.ok) {
                self.compose = [];
                self.set_status("Thanks for signing the guestbook!", SUCCESS);
                self.request_newer();
            } else {
                self.set_status(res.error, ERROR);
            }
            return;
        }

        if (req.type == "delete") {
            if (res.ok)
                self.remove_message(req.id);
            else
                self.set_status(res.error, ERROR);
            return;
        }

        if (req.type == "admin_info") {
            if (res.ok) {
                self.admin_info = res;
                self.admin_error = "";
            } else if (res.error == "not allowed") {
                self.is_admin = false;
                self.admin_info = nil;
                self.admin_error = "";
                if (self.screen == "admin")
                    self.leave_admin();
            } else {
                self.admin_info = nil;
                self.admin_error = res.error;
            }
            return;
        }

        // Requests of the canvas and the circuit are kept with their grid
        if (req.type == "canvas_poll" || req.type == "circuit_poll") {
            info.on_poll(self, res);
            return;
        }

        if (req.type == "canvas_tile" || req.type == "circuit_tile") {
            info.on_tile(req, res);
            return;
        }

        if (req.type == "canvas_set" || req.type == "circuit_set") {
            info.grid.on_set(res, info.set);
            return;
        }

        if (req.type == "stats" && res.ok) {
            self.total_views = res.total_views;
            self.messages_today = res.has("messages_today") ? res.messages_today : nil;
            self.num_accounts = res.has("num_accounts") ? res.num_accounts : nil;
        }
    }

    // Switches to the guestbook screen and fetches the latest messages
    enter_main(self)
    {
        self.screen = "main";
        self.messages = [];
        self.msg_ids = {};
        self.scroll_y = 0;
        self.no_more_older = false;
        self.loading_older = false;
        self.set_status("", DIM);
        self.send({type: "get_messages", limit: PAGE_SIZE}, {mode: "latest"});
    }

    // Opens the admin page and requests a fresh snapshot
    enter_admin(self)
    {
        self.screen = "admin";
        self.drag_offset = nil;
        self.admin_info = nil;
        self.admin_error = "";
        self.dirty = true;
        self.send({type: "admin_info"}, nil);
    }

    // Returns to the guestbook without losing the message list or draft
    leave_admin(self)
    {
        self.screen = "main";
        self.dirty = true;
        self.request_newer();
    }

    // Asks for messages newer than the newest one we have
    request_newer(self)
    {
        if (self.messages.len == 0)
            self.send({type: "get_messages", limit: PAGE_SIZE}, {mode: "latest"});
        else
            self.send({type: "get_messages", after: self.messages[0].id, limit: PAGE_SIZE}, {mode: "newer"});
    }

    // Height of a message in the list, in pixels
    block_height(self, msg)
    {
        return CHAR_H + msg.lines.len * CHAR_H + 18;
    }

    // Total height of the message list
    content_height(self)
    {
        let var h = 8;

        for (let var i = 0; i < self.messages.len; ++i)
            h = h + self.block_height(self.messages[i]);

        return h + 2 * CHAR_H;
    }

    // Adds messages from the server to the list, keeping it sorted from
    // newest to oldest. If the user has scrolled down, the view is kept on
    // the same messages as new ones appear above.
    add_messages(self, new_msgs)
    {
        for (let var i = 0; i < new_msgs.len; ++i) {
            let m = new_msgs[i];
            let key = m.id.to_s();

            if (self.msg_ids.has(key))
                continue;

            let msg = {id: m.id, username: m.username, text: m.text, time: m.time, lines: wrap(m.text, MSG_COLS)};
            self.msg_ids[key] = true;

            let var pos = 0;
            while (pos < self.messages.len && self.messages[pos].id > m.id)
                pos = pos + 1;

            self.messages.insert(pos, msg);

            if (pos == 0 && self.scroll_y > 0 && self.messages.len > 1)
                self.scroll_y = self.scroll_y + self.block_height(msg);
        }

        self.dirty = true;
    }

    // Removes a message from the list, after the admin deleted it
    remove_message(self, id)
    {
        for (let var i = 0; i < self.messages.len; ++i) {
            if (self.messages[i].id == id) {
                self.messages.remove(i);
                break;
            }
        }

        self.dirty = true;
    }

    // The grid of the current screen, the canvas or the circuit, or nil on
    // the other screens
    grid(self)
    {
        if (self.screen == "canvas")
            return self.canvas;

        return self.screen == "circuit" ? self.circuit : nil;
    }

    // Shows the canvas or the circuit, which update() then keeps up to date
    enter_grid(self, screen)
    {
        self.screen = screen;
        self.drag_offset = nil;
        self.pick_drag = nil;
        self.hover = nil;
        self.painting = nil;
        self.dirty = true;

        let grid = self.grid();
        grid.error = "";
        grid.last_poll_ms = 0;
        grid.view.dirty = true;

        // The circuit stood still while it wasn't shown
        self.sim_ms = $time_current_ms().to_f();
    }

    // Returns from the canvas or the circuit to the guestbook
    leave_grid(self)
    {
        self.screen = "main";
        self.pick_drag = nil;
        self.hover = nil;
        self.painting = nil;
        self.dirty = true;
        self.request_newer();
    }

    // Zooms the canvas or the circuit in or out by a number of levels
    zoom_by(self, levels)
    {
        let grid = self.grid();

        if (grid == nil || grid.img == nil)
            return;

        grid.view.zoom_by(levels);
        self.hover = nil;
        self.painting = nil;
    }

    // Cell of the current grid at a position in the frame, or nil
    cell_at(self, x, y)
    {
        let grid = self.grid();
        return grid == nil || grid.img == nil ? nil : grid.view.cell_at(x, y);
    }

    // Value of the node to place in the circuit: the one picked, turned
    node_value(self)
    {
        let value = NODES[self.node].value;
        let type = cell_type(value);
        return cell_value(type, self.rot % NUM_ROTS[type], cell_param(value));
    }

    // Changes a cell of the current grid: paints a pixel of the canvas with
    // the current color, or places the node picked in a cell of the
    // circuit, or empties it
    place(self, x, y, erase)
    {
        let grid = self.grid();

        if (self.conn != "connected")
            return;

        if (grid == self.canvas) {
            if (grid.view.zoom >= MIN_DRAW_ZOOM)
                grid.put(x, y, self.color);
        } else if (grid.view.zoom >= MIN_EDIT_ZOOM) {
            grid.put(x, y, rgb(0, 0, 0) | (erase ? 0 : self.node_value()));
        }
    }

    // Changes the cells from the last one changed to the one the mouse
    // moved to with its button held, so that fast moves leave no gaps
    paint_to(self, cell)
    {
        let from = self.painting;
        let dx = (cell.x - from.x).abs();
        let dy = (cell.y - from.y).abs();
        let sx = from.x < cell.x ? 1 : -1;
        let sy = from.y < cell.y ? 1 : -1;
        let var err = dx - dy;

        while (from.x != cell.x || from.y != cell.y) {
            let e2 = 2 * err;

            if (e2 > -dy) {
                err = err - dy;
                from.x = from.x + sx;
            }

            if (e2 < dx) {
                err = err + dx;
                from.y = from.y + sy;
            }

            self.place(from.x, from.y, from.erase);
        }
    }

    // Handles a click on a cell of the circuit, with the left button, or
    // with the right one, which empties cells
    circuit_mouse_down(self, x, y, erase)
    {
        let cell = self.cell_at(x, y);

        if (cell == nil)
            return;

        // Clicking a switch turns it on or off, unless erasing
        let value = self.circuit.get(cell.x, cell.y);
        if (!erase && self.node_value() != 0 && cell_type(value) == SWITCH) {
            if (self.conn == "connected" && self.circuit.view.zoom >= MIN_EDIT_ZOOM)
                self.circuit.put(cell.x, cell.y, value ^ (1 << 16));
            return;
        }

        self.place(cell.x, cell.y, erase);
        self.painting = {x: cell.x, y: cell.y, erase: erase};
    }

    // Runs the circuit up to the present, after working it out again if
    // its cells changed
    update_circuit(self, now)
    {
        let grid = self.circuit;

        if (grid.img == nil)
            return;

        if (self.sim == nil || self.sim.size != grid.size) {
            self.sim = Sim(grid.size);
            grid.changed = true;
        }

        if (grid.changed) {
            self.sim.compile(grid.img.bytes);
            grid.changed = false;
            grid.view.dirty = true;
        }

        let tick_ms = 1000.0 / TICKS_PER_SEC;
        let owed = ((now - self.sim_ms) / tick_ms).floor();
        let num_ticks = owed.clip(0, MAX_TICKS_PER_FRAME);

        for (let var i = 0; i < num_ticks; ++i) {
            if (self.sim.tick())
                grid.view.dirty = true;
        }

        // Ticks beyond that are no longer owed: the circuit falls behind
        self.sim_ms = owed > num_ticks ? now.to_f() : self.sim_ms + num_ticks * tick_ms;

        if (grid.view.dirty)
            self.dirty = true;
    }

    // Picks a color of the palette to paint with
    set_color(self, color)
    {
        self.color = color;
        self.custom_selected = false;
        self.dirty = true;
    }

    // Picks the custom color to paint with
    select_custom(self)
    {
        self.color = self.custom;
        self.custom_selected = true;
        self.dirty = true;
    }

    // Changes the custom color with the mouse in the part of the color
    // picker being dragged, the square of saturations and values or the bar
    // of hues, and picks it to paint with
    pick(self, x, y)
    {
        let fx = ((x - SIDE_X).to_f() / (SIDE_W - 1)).max(0.0).min(1.0);

        if (self.pick_drag == "hue") {
            self.hsv.h = fx * 359.9;
        } else {
            self.hsv.s = fx;
            self.hsv.v = 1.0 - ((y - PICK_Y).to_f() / (PICK_H - 1)).max(0.0).min(1.0);
        }

        self.custom = hsv_to_rgb(self.hsv.h, self.hsv.s, self.hsv.v);
        self.select_custom();
    }

    // Handles a click on the canvas screen that isn't on a button
    canvas_mouse_down(self, x, y)
    {
        let pixel = self.cell_at(x, y);

        if (pixel != nil) {
            self.place(pixel.x, pixel.y, false);
            self.painting = {x: pixel.x, y: pixel.y, erase: false};
            return;
        }

        if (x < SIDE_X || x >= SIDE_X + SIDE_W)
            return;

        if (y >= PICK_Y && y < PICK_Y + PICK_H)
            self.pick_drag = "sv";
        else if (y >= HUE_Y && y < HUE_Y + HUE_H)
            self.pick_drag = "hue";
        else
            return;

        self.pick(x, y);
    }

    // Validates the form and sends the requested login or register request
    submit_login(self, type)
    {
        let username = join(self.fields[0]);
        let password = join(self.fields[1]);

        if (!valid_username(username)) {
            self.set_modal_status("Usernames are 2 to 16 letters, digits or _", ERROR);
            return;
        }

        if (password.len == 0) {
            self.set_modal_status("Please enter a password", ERROR);
            return;
        }

        if (type == "register") {
            if (num_chars(password) < MIN_PASS_LEN) {
                self.set_modal_status("Please use at least " + MIN_PASS_LEN.to_s() + " characters for your password", ERROR);
                return;
            }

            if (join(self.fields[2]) != password) {
                self.set_modal_status("The passwords don't match", ERROR);
                return;
            }
        }

        if (!self.send({type: type, username: username, hash: password_hash(password)}, nil)) {
            self.set_modal_status("Not connected to the server, please try again", ERROR);
            return;
        }

        self.set_modal_status(type == "login" ? "Logging in..." : "Creating your account...", DIM);
    }

    // Sends the message being written. Guests are asked to register or log
    // in first, and the message is sent once they have.
    submit_post(self)
    {
        let text = join(self.compose).trim();

        if (num_chars(text) < 3) {
            self.set_status("Your message is a bit short", ERROR);
            return;
        }

        if (self.username == nil) {
            self.open_modal(true);
            return;
        }

        if (!self.send({type: "post", text: text}, nil)) {
            self.set_status("Not connected to the server, reconnecting...", ERROR);
            return;
        }

        self.set_status("Sending...", DIM);
    }

    // Logs out, reconnecting so that the server forgets the session. The
    // guestbook stays open, as a guest.
    log_out(self)
    {
        self.auth = nil;
        self.username = nil;
        self.is_admin = false;
        self.admin_info = nil;
        self.admin_error = "";
        self.deleting = nil;
        self.fields = [[], [], []];
        self.focus = 0;
        self.set_status("", DIM);
        self.disconnect();
        self.connect();
    }

    // Scrolls the message list, staying within bounds
    scroll_to(self, y)
    {
        let max_scroll = (self.content_height() - self.panel.height).max(0);
        self.scroll_y = y.clip(0, max_scroll);
        self.dirty = true;
    }

    // Geometry of the scrollbar, in frame coordinates
    scrollbar(self)
    {
        let track_h = self.panel.height;
        let content_h = self.content_height();
        let thumb_h = (track_h * track_h).idiv(content_h.max(track_h)).max(24);
        let max_scroll = (content_h - track_h).max(0);
        let thumb_y = max_scroll == 0 ? 0 : ((track_h - thumb_h) * self.scroll_y).idiv(max_scroll);

        return {
            x: MARGIN + self.panel.width - SCROLLBAR_W,
            y: PANEL_Y,
            h: track_h,
            thumb_y: PANEL_Y + thumb_y,
            thumb_h: thumb_h,
            max_scroll: max_scroll,
        };
    }

    // Handles a UI event
    handle_ui(self, ev)
    {
        self.dirty = true;

        if (self.screen == "intro") {
            if ((ev.kind == "KEY_DOWN" && ev.key != "F12") || ev.kind == "MOUSE_DOWN")
                self.enter_main();
            return;
        }

        if (ev.kind == "MOUSE_DOWN" && ev.button == "LEFT") {
            self.mouse_down(ev.x, ev.y);
            return;
        }

        if (ev.kind == "MOUSE_DOWN" && ev.button == "RIGHT") {
            if (self.screen == "circuit")
                self.circuit_mouse_down(ev.x, ev.y, true);
            return;
        }

        if (ev.kind == "MOUSE_UP") {
            self.drag_offset = nil;
            self.pick_drag = nil;
            self.painting = nil;
            return;
        }

        if (ev.kind == "MOUSE_MOVE") {
            if (self.grid() != nil) {
                self.hover = self.cell_at(ev.x, ev.y);
                if (self.pick_drag != nil)
                    self.pick(ev.x, ev.y);
                else if (self.painting != nil && self.hover != nil)
                    self.paint_to(self.hover);
            } else if (self.drag_offset != nil) {
                let bar = self.scrollbar();
                let span = (bar.h - bar.thumb_h).max(1);
                self.scroll_to(((ev.y - self.drag_offset - bar.y) * bar.max_scroll).idiv(span));
            }
            return;
        }

        if (ev.kind == "TEXT_INPUT") {
            self.text_input(ev.text);
            return;
        }

        if (ev.kind == "KEY_DOWN")
            self.key_down(ev.key);
    }

    // Handles a left click: on the scrollbar, or on a button
    mouse_down(self, x, y)
    {
        // With the login box open, only its own buttons are registered
        if (self.screen == "main" && !self.modal) {
            let bar = self.scrollbar();

            if (x >= bar.x && x < bar.x + SCROLLBAR_W && y >= bar.y && y < bar.y + bar.h) {
                if (y >= bar.thumb_y && y < bar.thumb_y + bar.thumb_h)
                    self.drag_offset = y - bar.thumb_y;
                else if (y < bar.thumb_y)
                    self.scroll_to(self.scroll_y - self.panel.height);
                else
                    self.scroll_to(self.scroll_y + self.panel.height);
                return;
            }
        }

        for (let var i = 0; i < self.buttons.len; ++i) {
            let b = self.buttons[i];

            if (x >= b.x && x < b.x + b.w && y >= b.y && y < b.y + b.h) {
                self.click(b.action, b.arg);
                return;
            }
        }

        if (self.screen == "canvas")
            self.canvas_mouse_down(x, y);
        else if (self.screen == "circuit")
            self.circuit_mouse_down(x, y, false);
    }

    // Switches to the view of a tab
    show_screen(self, screen)
    {
        if (screen == self.screen)
            return;

        if (screen != "main")
            self.enter_grid(screen);
        else if (self.screen == "admin")
            self.leave_admin();
        else
            self.leave_grid();
    }

    // Performs the action of a clicked button
    click(self, action, arg)
    {
        if (action == "focus") {
            self.focus = arg;
        } else if (action == "submit") {
            self.submit_login(arg);
        } else if (action == "send") {
            self.submit_post();
        } else if (action == "logout") {
            self.log_out();
        } else if (action == "screen") {
            self.show_screen(arg);
        } else if (action == "color") {
            self.set_color(arg);
        } else if (action == "custom") {
            self.select_custom();
        } else if (action == "zoom") {
            self.zoom_by(arg);
        } else if (action == "node") {
            self.node = arg;
        } else if (action == "open_modal") {
            self.open_modal(false);
        } else if (action == "close_modal") {
            self.close_modal();
        } else if (action == "start_delete") {
            self.deleting = arg;
        } else if (action == "cancel_delete") {
            self.deleting = nil;
        } else if (action == "delete") {
            self.send({type: "delete", id: arg.id, mod_tag: arg.tag}, nil);
            self.deleting = nil;
        }
    }

    // Handles typed text, for the focused field
    text_input(self, text)
    {
        let cs = chars(text);

        for (let var i = 0; i < cs.len; ++i) {
            let ch = cs[i];

            if (self.modal) {
                let field = self.fields[self.focus];

                if (self.focus == 0) {
                    if (field.len < MAX_NAME_LEN && ch.len == 1 && is_name_byte(ch.byte_at(0)))
                        field.push(ch);
                } else if (field.len < MAX_PASS_LEN) {
                    field.push(ch);
                }
            } else if (self.screen == "main" && self.compose.len < MAX_MSG_LEN) {
                self.compose.push(ch);
            } else if (self.grid() != nil) {
                if (ch == "+" || ch == "=")
                    self.zoom_by(1);
                else if (ch == "-" || ch == "_")
                    self.zoom_by(-1);
            }
        }
    }

    // Handles special keys
    key_down(self, key)
    {
        // The tabs' keys work on every screen, unless the login box is open
        for (let var i = 0; i < TABS.len && !self.modal; ++i) {
            if (key == TABS[i].key) {
                self.show_screen(TABS[i].screen);
                return;
            }
        }

        if (self.screen == "admin")
            return;

        if (self.grid() != nil) {
            let view = self.grid().view;

            if (key == "LEFT")
                view.pan(-1, 0);
            else if (key == "RIGHT")
                view.pan(1, 0);
            else if (key == "UP")
                view.pan(0, -1);
            else if (key == "DOWN")
                view.pan(0, 1);
            else if (key == "R" && self.screen == "circuit")
                self.rot = (self.rot + 1) % 4;
            else if (key == "D" && self.screen == "circuit")
                self.node = NODES.len - 1;
            return;
        }

        if (self.modal) {
            if (key == "ESCAPE")
                self.close_modal();
            else if (key == "TAB")
                self.focus = (self.focus + 1) % 3;
            else if (key == "RETURN")
                self.submit_login(self.focus == 2 ? "register" : "login");
            else if (key == "BACKSPACE" && self.fields[self.focus].len > 0)
                self.fields[self.focus].pop();
            return;
        }

        if (self.screen == "main") {
            if (key == "F12" && self.is_admin)
                self.enter_admin();
            else if (key == "ESCAPE")
                self.deleting = nil;
            else if (key == "RETURN")
                self.submit_post();
            else if (key == "BACKSPACE" && self.compose.len > 0)
                self.compose.pop();
            else if (key == "UP")
                self.scroll_to(self.scroll_y - 2 * CHAR_H);
            else if (key == "DOWN")
                self.scroll_to(self.scroll_y + 2 * CHAR_H);
        }
    }

    // Tests if the screen is animating and must be redrawn on every frame
    animating(self)
    {
        return self.screen == "intro";
    }

    // Updates state that depends on time: the end of the intro, the cursor
    // blink, and fetching older messages near the bottom of the list
    update(self)
    {
        let now = $time_current_ms();

        if (self.screen == "intro" && now - self.start_ms >= INTRO_END_MS)
            self.enter_main();

        let cursor_on = (now.idiv(500) % 2) == 0;
        if (cursor_on != self.cursor_on) {
            self.cursor_on = cursor_on;
            self.dirty = true;
        }

        if (self.grid() != nil && self.conn == "connected")
            self.grid().update(self, now);

        if (self.screen == "circuit")
            self.update_circuit(now);

        if (self.screen == "main" && !self.loading_older && !self.no_more_older && self.messages.len > 0) {
            let remaining = self.content_height() - self.scroll_y - self.panel.height;

            if (remaining < 200) {
                let oldest = self.messages[self.messages.len - 1].id;

                if (self.send({type: "get_messages", before: oldest, limit: PAGE_SIZE}, {mode: "older"}))
                    self.loading_older = true;
            }
        }
    }

    // Tests if the frame needs to be drawn again
    needs_redraw(self)
    {
        return self.dirty || self.animating();
    }

    // Draws the current screen into the frame
    render(self)
    {
        self.buttons = [];
        self.frame.clear(BG);

        if (self.screen == "intro")
            self.render_intro();
        else if (self.screen == "admin")
            self.render_admin();
        else if (self.screen == "canvas")
            self.render_canvas();
        else if (self.screen == "circuit")
            self.render_circuit();
        else
            self.render_main();

        if (self.screen != "intro")
            self.render_footer();

        if (self.modal && self.screen == "main")
            self.render_modal();

        self.dirty = false;
    }

    // Draws the intro: the letters of the logo appear one by one, stripe by
    // stripe, then the teddy bear, then its sunglasses drop into place
    render_intro(self)
    {
        let t = $time_current_ms() - self.start_ms;
        let stripes = [];

        for (let var i = 0; i < LOGO_LETTERS.len; ++i) {
            let letter_t = t - (LETTER_START_MS + i * LETTER_EVERY_MS);
            stripes.push(letter_t < 0 ? 0 : (letter_t.idiv(STRIPE_MS) + 1).min(NUM_STRIPES));
        }

        // The sunglasses fall quickly, then slow down as they land
        let var shades_y = nil;
        if (t >= SHADES_MS) {
            let p = ((t - SHADES_MS).to_f() / SHADES_DROP_MS).min(1.0);
            shades_y = -SHADES_DROP * (1.0 - p) * (1.0 - p);
        }

        let x = (WIDTH - logo_width(BIG_LOGO)).idiv(2);
        draw_logo(self.frame, x, INTRO_LOGO_Y, BIG_LOGO, stripes, t >= BEAR_MS, shades_y);

        if (t >= TAGLINE_MS)
            self.centered(INTRO_LOGO_Y + logo_height(BIG_LOGO) + 40, "guestbook", DIM);
    }

    // Draws a text field with its label
    field(self, x, y, w, label, value, index)
    {
        let h = 38;
        let focused = self.focus == index;

        self.text(self.frame, x, y, label, DIM, BG);
        let box_y = y + CHAR_H + 4;

        self.frame.fill_rect(x, box_y, w, h, FIELD);
        draw_rect(self.frame, x, box_y, w, h, focused ? FOCUS : BORDER);

        // Show the end of the value if it doesn't fit
        let max_chars = (w - 2 * TEXT_PAD).idiv(CHAR_W) - 1;
        let start = (value.len - max_chars).max(0);
        let shown = join(value.slice(start, value.len));
        let text_y = box_y + (h - CHAR_H).idiv(2);

        let placeholder = index == 0 && value.len == 0;
        if (placeholder)
            self.text(self.frame, x + TEXT_PAD, text_y, "choose a username", PLACEHOLDER, FIELD);
        else
            self.text(self.frame, x + TEXT_PAD, text_y, shown, TEXT, FIELD);

        if (focused && self.cursor_on) {
            let cursor_x = x + TEXT_PAD + num_chars(shown) * CHAR_W;
            if (placeholder)
                self.frame.fill_rect(cursor_x, text_y + CHAR_H - 4, CHAR_W, 2, FOCUS);
            else
                self.text(self.frame, cursor_x, text_y, "＿", FOCUS, FIELD);
        }

        self.buttons.push({x: x, y: box_y, w: w, h: h, action: "focus", arg: index});
    }

    // Draws a button and registers it for clicks
    button(self, x, y, w, h, label, color, action, arg)
    {
        self.frame.fill_rect(x, y, w, h, color);
        let tx = x + (w - num_chars(label) * CHAR_W).idiv(2);
        let text_color = color == PRIMARY_BUTTON ? BG : BUTTON_TEXT;
        self.text(self.frame, tx, y + (h - CHAR_H).idiv(2), label, text_color, color);
        self.buttons.push({x: x, y: y, w: w, h: h, action: action, arg: arg});
    }

    // Draws the box to register or log in, outlined, over the guestbook
    render_modal(self)
    {
        let frame = self.frame;
        let mx = (WIDTH - MODAL_W).idiv(2);
        let my = (HEIGHT - MODAL_H).idiv(2);

        // Only the box's own buttons can be clicked while it is open
        self.buttons = [];

        // A margin sets the outline apart from the messages behind
        frame.fill_rect(mx - 8, my - 8, MODAL_W + 16, MODAL_H + 16, BG);
        draw_rect(frame, mx, my, MODAL_W, MODAL_H, FOCUS);
        draw_rect(frame, mx + 1, my + 1, MODAL_W - 2, MODAL_H - 2, FOCUS);

        self.button(mx + MODAL_W - 40, my + 12, 28, 28, "x", FIELD, "close_modal", nil);

        let w = 360;
        let x = (WIDTH - w).idiv(2);
        let bw = 170;

        // Passwords are shown as stars
        fun stars(field) {
            let out = [];
            for (let var i = 0; i < field.len; ++i)
                out.push("*");
            return out;
        }

        let heading = self.post_after_auth ? "Register or log in to post your message" : "Create your new user account or sign in";
        self.centered(my + 24, heading, REGISTER_HEADING);
        self.field(x, my + 70, w, "Username", self.fields[0], 0);
        self.field(x, my + 144, w, "Password", stars(self.fields[1]), 1);
        self.field(x, my + 218, w, "Confirm (register only)", stars(self.fields[2]), 2);
        self.button(x, my + 302, bw, 40, "Register", PRIMARY_BUTTON, "submit", "register");
        self.button(x + w - bw, my + 302, bw, 40, "Log in", LOGIN_BUTTON, "submit", "login");
        self.centered(my + 356, self.modal_status, self.modal_status_color);
        self.centered(my + 392, "Enter logs in; in Confirm, Enter registers", DIM);
    }

    // Draws the admin page with the latest server snapshot
    render_admin(self)
    {
        let frame = self.frame;
        let panel_y = 72;
        let panel_w = WIDTH - 2 * MARGIN;
        let panel_h = FOOTER_Y - 8 - panel_y;
        let x = MARGIN + 24;
        let value_x = MARGIN + 310;

        draw_full_logo(frame, MARGIN, 14, SMALL_LOGO);
        self.text(frame, MARGIN + logo_width(SMALL_LOGO) + 12, 17, "admin", DIM, BG);

        frame.fill_rect(MARGIN, panel_y, panel_w, panel_h, PANEL);
        draw_rect(frame, MARGIN, panel_y, panel_w, panel_h, BORDER);

        if (self.conn != "connected") {
            self.text(frame, x, 100, "Connection lost, reconnecting...", ERROR, PANEL);
            return;
        }

        if (self.admin_info == nil) {
            let msg = self.admin_error == "" ? "Loading admin info..." : self.admin_error;
            self.text(frame, x, 100, msg, self.admin_error == "" ? DIM : ERROR, PANEL);
            return;
        }

        let info = self.admin_info;
        let x2 = MARGIN + 464;
        let value_x2 = MARGIN + 734;

        // Draws a count from the server, or n/a if it doesn't send it
        fun stat(x, value_x, y, label, name) {
            self.text(frame, x, y, label, DIM, PANEL);
            self.text(frame, value_x, y, info.has(name) ? info[name].comma_sep() : "n/a", TEXT, PANEL);
        }

        self.text(frame, x, 100, "Process uptime:", DIM, PANEL);
        self.text(frame, value_x, 100, info.uptime, TEXT, PANEL);
        stat(x, value_x, 136, "Total user accounts:", "num_accounts");
        stat(x, value_x, 172, "Filtered messages:", "num_filtered");
        stat(x, value_x, 208, "Total connections:", "total_conns");
        stat(x, value_x, 244, "Total get_messages:", "total_get_messages");

        // IPs that connected since the server started, by what they sent
        stat(x2, value_x2, 100, "Unique IPs:", "ips_unique");
        stat(x2, value_x2, 136, "IPs with requests:", "ips_valid");
        stat(x2, value_x2, 172, "IPs sent nothing:", "ips_silent");
        stat(x2, value_x2, 208, "IPs not JSON:", "ips_not_json");

        frame.fill_rect(x, 290, panel_w - 48, 1, FIELD);
        self.text(frame, x, 312, "Last 10 user accounts", TEXT, PANEL);

        for (let var i = 0; i < info.users.len; ++i) {
            let y = 354 + i * 34;
            self.text(frame, x, y, (i + 1).to_s() + ".", DIM, PANEL);
            self.text(frame, x + 4 * CHAR_W, y, info.users[i], name_color(info.users[i]), PANEL);
        }
    }

    // Draws the tabs at the bottom of the screen, one per view, each in its
    // own rainbow color: as the background of the tab of the current view,
    // and as the text color of the others
    render_footer(self)
    {
        let var x = MARGIN;

        for (let var i = 0; i < TABS.len; ++i) {
            let tab = TABS[i];
            let label = tab.key + " " + tab.label;
            let w = (num_chars(label) + 2) * CHAR_W;
            let active = tab.screen == self.screen;
            let bg = active ? RAINBOW[i] : FIELD;

            self.frame.fill_rect(x, FOOTER_Y, w, FOOTER_H, bg);
            self.text(self.frame, x + CHAR_W, FOOTER_Y + (FOOTER_H - CHAR_H).idiv(2), label, active ? BG : RAINBOW[i], bg);
            self.buttons.push({x: x, y: FOOTER_Y, w: w, h: FOOTER_H, action: "screen", arg: tab.screen});
            x = x + w + 8;
        }
    }

    // Draws the part of the canvas in view into the view image, each canvas
    // pixel as a square of the zoom's size
    render_view(self)
    {
        let view = self.canvas.view;
        let cell = view.cell();
        let size = self.canvas.size;
        let num = view.visible().min(size - view.x).min(size - view.y);
        let src = self.canvas.img.bytes;
        let dst = view.img.bytes;

        view.img.clear(BG);

        for (let var y = 0; y < num; ++y) {
            let src_row = (view.y + y) * size + view.x;
            let dst_row = y * cell * VIEW_SIZE;

            if (cell == 1) {
                dst.memcpy(dst_row * 4, src, src_row * 4, num * 4);
                continue;
            }

            // Draw the top line of the row of squares, then copy it down
            for (let var x = 0; x < num; ++x)
                dst.fill_u32(dst_row + x * cell, cell, src.get_u32(src_row + x));

            for (let var k = 1; k < cell; ++k)
                dst.memcpy((dst_row + k * VIEW_SIZE) * 4, dst, dst_row * 4, num * cell * 4);
        }

        view.dirty = false;
    }

    // Draws the square of saturations and values for the current hue
    render_sv(self)
    {
        let cols = SIDE_W.idiv(PICK_BLOCK);
        let rows = PICK_H.idiv(PICK_BLOCK);

        for (let var j = 0; j < rows; ++j) {
            for (let var i = 0; i < cols; ++i) {
                let color = hsv_to_rgb(self.hsv.h, i.to_f() / (cols - 1), 1.0 - j.to_f() / (rows - 1));
                self.sv_img.fill_rect(i * PICK_BLOCK, j * PICK_BLOCK, PICK_BLOCK, PICK_BLOCK, color);
            }
        }

        self.sv_hue = self.hsv.h;
    }

    // Draws a marker around a point, visible on any color
    marker(self, x, y, w, h)
    {
        draw_rect(self.frame, x - 1, y - 1, w + 2, h + 2, rgb(0, 0, 0));
        draw_rect(self.frame, x - 2, y - 2, w + 4, h + 4, rgb(255, 255, 255));
    }

    // Draws the canvas screen: the view of the canvas, and on its right
    // the colors, the color picker and the zoom
    render_canvas(self)
    {
        let frame = self.frame;
        let grid = self.canvas;
        let view = grid.view;

        draw_full_logo(frame, MARGIN, 14, SMALL_LOGO);
        self.text(frame, MARGIN + logo_width(SMALL_LOGO) + 12, 17, "canvas", DIM, BG);

        let status = self.grid_status(grid, view.zoom < MIN_DRAW_ZOOM ? "zoom in to draw" : "");

        if (grid.img == nil) {
            frame.fill_rect(VIEW_X, VIEW_Y, VIEW_SIZE, VIEW_SIZE, FIELD);
        } else {
            if (view.dirty)
                self.render_view();
            frame.blit(view.img, VIEW_X, VIEW_Y);
        }

        // Sets a dark canvas apart from the background
        draw_rect(frame, VIEW_X - 1, VIEW_Y - 1, VIEW_SIZE + 2, VIEW_SIZE + 2, BORDER);

        // The pixel under the mouse, in the color it would be painted
        let cell = view.cell();
        if (self.hover != nil && view.zoom >= MIN_DRAW_ZOOM) {
            let hx = VIEW_X + (self.hover.x - view.x) * cell;
            let hy = VIEW_Y + (self.hover.y - view.y) * cell;
            frame.fill_rect(hx, hy, cell, cell, self.color);
            self.marker(hx, hy, cell, cell);
        }

        // Colors to pick from
        for (let var i = 0; i < PALETTE.len; ++i) {
            let x = SIDE_X + (i % 4) * (SWATCH + SWATCH_GAP);
            let y = VIEW_Y + i.idiv(4) * (SWATCH + SWATCH_GAP);
            frame.fill_rect(x, y, SWATCH, SWATCH, PALETTE[i]);
            self.buttons.push({x: x, y: y, w: SWATCH, h: SWATCH, action: "color", arg: PALETTE[i]});

            if (!self.custom_selected && PALETTE[i] == self.color)
                self.marker(x, y, SWATCH, SWATCH);
        }

        // Color picker, with markers on the custom color
        if (self.sv_hue != self.hsv.h)
            self.render_sv();
        frame.blit(self.sv_img, SIDE_X, PICK_Y);
        frame.blit(self.hue_img, SIDE_X, HUE_Y);

        let sx = SIDE_X + (self.hsv.s * (SIDE_W - 1)).floor();
        let sy = PICK_Y + ((1.0 - self.hsv.v) * (PICK_H - 1)).floor();
        self.marker(sx - 3, sy - 3, 6, 6);
        let hue_x = SIDE_X + (self.hsv.h / 360.0 * (SIDE_W - 1)).floor();
        self.marker(hue_x - 2, HUE_Y, 4, HUE_H);

        // Custom color, which can be clicked like the palette's, and its
        // hex code
        let var y = HUE_Y + HUE_H + 16;
        frame.fill_rect(SIDE_X, y, SWATCH, 40, self.custom);
        self.buttons.push({x: SIDE_X, y: y, w: SWATCH, h: 40, action: "custom", arg: nil});

        if (self.custom_selected)
            self.marker(SIDE_X, y, SWATCH, 40);
        else
            draw_rect(frame, SIDE_X, y, SWATCH, 40, BORDER);

        let hex = "#" + (self.custom & 0xFF_FF_FF).to_hex(6).upper();
        self.text(frame, SIDE_X + SWATCH + 12, y + 8, hex, TEXT, BG);

        y = y + 60;
        self.render_zoom(grid, y);
        self.text(frame, SIDE_X, y + 72, "arrows  move", DIM, BG);
        self.text(frame, SIDE_X, y + 98, "+ and -  zoom", DIM, BG);
        self.text(frame, SIDE_X, y + 130, status, self.conn == "connected" && grid.error == "" ? DIM : ERROR, BG);
    }

    // What is in the way of changing a grid, if anything. zoom_hint is
    // what to say when all that is, is the zoom.
    grid_status(self, grid, zoom_hint)
    {
        if (self.conn != "connected")
            return self.total_views == nil ? "connecting..." : "reconnecting...";

        if (grid.error != "")
            return grid.error;

        return grid.loading() ? "loading..." : zoom_hint;
    }

    // Draws the zoom of a grid's view at a given height on the side, with
    // buttons for the mouse, and under it the position of the cell under
    // the mouse, or of the middle of the view
    render_zoom(self, grid, y)
    {
        let frame = self.frame;
        let view = grid.view;

        self.text(frame, SIDE_X, y, "zoom " + view.cell().to_s() + "x", TEXT, BG);
        self.button(SIDE_X + SIDE_W - 76, y - 2, 34, 28, "-", FIELD, "zoom", -1);
        self.button(SIDE_X + SIDE_W - 34, y - 2, 34, 28, "+", FIELD, "zoom", 1);

        if (self.hover != nil)
            self.text(frame, SIDE_X, y + 40, self.hover.x.to_s() + ", " + self.hover.y.to_s(), TEXT, BG);
        else if (grid.img != nil)
            self.text(frame, SIDE_X, y + 40, (view.x + view.visible().idiv(2)).to_s() + ", " + (view.y + view.visible().idiv(2)).to_s(), DIM, BG);
    }

    // Draws the part of a wire that reaches a side of a cell of c pixels,
    // from that side in
    draw_stub(self, img, x, y, c, side, depth, color)
    {
        // Thickness of wires, and where they start across the cell
        let w = c.idiv(5).max(1);
        let o = (c - w).idiv(2);

        if (side == NORTH)
            img.fill_rect(x + o, y, w, depth, color);
        else if (side == EAST)
            img.fill_rect(x + c - depth, y + o, depth, w, color);
        else if (side == SOUTH)
            img.fill_rect(x + o, y + c - depth, w, depth, color);
        else
            img.fill_rect(x, y + o, depth, w, color);
    }

    // Draws text into an image, leaving what is around its letters as it is
    stamp(self, img, x, y, str, scale, color)
    {
        let font = self.font(scale, color, 0);

        for (let var i = 0; i < str.len; ++i) {
            let ch = font.render_char(str.char_at(i));

            for (let var j = 0; j < ch.width * ch.height; ++j) {
                if (ch.bytes.get_u32(j) != 0)
                    img.set_pixel(x + i * ch.width + j % ch.width, y + j.idiv(ch.width), color);
            }
        }
    }

    // Picture of a circuit node other than a wire, in a cell of c pixels:
    // its symbol, over the wires that reach its ports. on says whether it
    // outputs, or is lit for an LED, and lines whether to draw the lines of
    // the grid. Pictures are kept once drawn.
    node_sprite(self, value, c, on, broken, lines)
    {
        let key = value.to_s() + ":" + c.to_s() + (on ? "o" : "") + (broken ? "b" : "") + (lines ? "l" : "");

        if (self.sprites.has(key))
            return self.sprites[key];

        // Types this version doesn't know show as a question mark
        let type = cell_type(value);
        let param = cell_param(value);
        let rot = NUM_ROTS[type] == 1 ? 0 : cell_rot(value);
        let img = Image(c, c);
        img.clear(CELL_BG);

        if (lines) {
            img.fill_rect(0, 0, c, 1, GRID_LINE);
            img.fill_rect(0, 0, 1, c, GRID_LINE);
        }

        let outs = out_sides(value);
        let ports = outs | in_sides(value);
        let middle = c - (c - c.idiv(5).max(1)).idiv(2);
        for (let var side = 0; side < 4; ++side) {
            if (((ports >> side) & 1) == 1)
                self.draw_stub(img, 0, 0, c, side, middle, on && ((outs >> side) & 1) == 1 ? WIRE_ON : WIRE_OFF);
        }

        // Colors of the body, its lines and its details
        let var fill = broken ? BROKEN : NODE_COLORS[type];
        let var detail = BG;

        if (type == LED) {
            // Dim when off
            let lit = LED_COLORS[param % LED_COLORS.len];
            fill = on ? lit : rgb(0, 0, 0) | ((lit >> 2) & 0x3F_3F_3F);
            detail = on ? BG : WIRE_OFF;
        } else if (type == SWITCH) {
            detail = on ? WIRE_ON : WIRE_OFF;
        }

        let colors = [0, fill, WIRE_OFF, detail];

        // Each pixel is the average of four points in it, turned back to
        // where they are with the output to the east
        for (let var py = 0; py < c; ++py) {
            for (let var px = 0; px < c; ++px) {
                let under = img.get_pixel(px, py);
                let var r = 0;
                let var g = 0;
                let var b = 0;
                let var hits = 0;

                for (let var s = 0; s < 4; ++s) {
                    let var u = (px + 0.25 + 0.5 * (s & 1)) / c;
                    let var v = (py + 0.25 + 0.5 * (s >> 1)) / c;

                    for (let var k = 0; k < rot; ++k) {
                        let old_u = u;
                        u = v;
                        v = 1.0 - old_u;
                    }

                    let code = node_shade(type, on, u, v, c);
                    let color = code == 0 ? under : colors[code];
                    hits += code == 0 ? 0 : 1;
                    r += (color >> 16) & 0xFF;
                    g += (color >> 8) & 0xFF;
                    b += color & 0xFF;
                }

                if (hits > 0)
                    img.set_pixel(px, py, rgb(r.idiv(4), g.idiv(4), b.idiv(4)));
            }
        }

        // Clocks show their rate under the wave, or alone in small cells
        // Flip-flops are labelled D by their data input and Q by their
        // output, each set a little in from the outline on its side.
        // Letters are 5 by 7, from the fourth row of the 7 by 12 they are
        // drawn in, with one more row for the tail of the Q.
        for (let var i = 0; type == DFF && c >= DETAILS_FROM && i < 2; ++i) {
            let size = c >= 48 ? 2 : 1;
            let height = (i == 0 ? 7 : 8) * size;
            let side = (WEST + rot + 2 * i) & 3;

            // Where the inside of the outline starts and ends
            let first = (0.1724 * c).ceil();
            let last = (0.8276 * c).floor();

            // One above the other, they leave less room at the ends
            let end_gap = last - first - 15 * size >= 2 * size + 2 ? size : 1;
            let var x = (c - 5 * size).idiv(2);
            let var y = (c - 7 * size).idiv(2);

            if (side == WEST)
                x = first + size;
            else if (side == EAST)
                x = last - 6 * size;
            else if (side == NORTH)
                y = first + end_gap;
            else
                y = last - end_gap - height;

            self.stamp(img, x, y - 3 * size, i == 0 ? "D" : "Q", size, WIRE_OFF);
        }

        let var symbol = type == EMPTY ? "?" : "";
        let var scale = c >= 56 ? 3 : (c >= DETAILS_FROM ? 2 : 1);

        if (type == CLOCK) {
            let hz = clock_hz(param);
            symbol = hz >= 1.0 ? hz.floor().to_s() : "~";
            scale = c >= 48 ? 2 : 1;
        }

        if (symbol != "" && c >= OUTLINES_FROM) {
            let sx = (c - 7 * scale * symbol.len).idiv(2);
            let var sy = (c - 12 * scale).idiv(2);

            if (type == CLOCK && c >= DETAILS_FROM)
                sy = (0.62 * c - 6.5 * scale).floor();

            self.stamp(img, sx, sy, symbol, scale, type == CLOCK ? BG : WIRE_OFF);
        }

        self.sprites[key] = img;
        return img;
    }

    // Draws the node of a circuit cell in a square of c pixels. lit is the
    // set of sides whose nets are on, broken whether it is in a loop, and
    // lines whether the lines of the grid show.
    draw_node(self, img, x, y, c, value, lit, broken, lines)
    {
        if ((value & 0xFF) == 0)
            return;

        let type = cell_type(value);
        let w = c.idiv(5).max(1);
        let o = (c - w).idiv(2);

        if (type >= WIRE && type <= BRIDGE) {
            let groups = wire_groups(value);

            // The second wire of a bridge passes under the first
            for (let var i = groups.len - 1; i >= 0; --i) {
                let color = (groups[i] & lit) != 0 ? WIRE_ON : WIRE_OFF;

                for (let var side = 0; side < 4; ++side) {
                    if (((groups[i] >> side) & 1) == 1)
                        self.draw_stub(img, x, y, c, side, c - o, color);
                }

                if (i == 1) {
                    let gap = w.idiv(2).max(1);
                    img.fill_rect(x + o - gap, y + o - gap, w + 2 * gap, w + 2 * gap, CELL_BG);
                }
            }

            return;
        }

        // A switch that is on shows it even where nothing simulates it
        let outs = out_sides(value);
        let var on = outs == 0 ? lit != 0 : (lit & outs) != 0;
        if (type == SWITCH)
            on = (cell_param(value) & 1) == 1;

        img.blit(self.node_sprite(value, c, on, broken, lines), x, y);

        // Inputs that are on are lit up to the body
        let ins = in_sides(value) & lit;
        let depth = type == DFF ? 0.12 : (type == NOT ? 0.19 : 0.16);
        for (let var side = 0; side < 4; ++side) {
            if (((ins >> side) & 1) == 1)
                self.draw_stub(img, x, y, c, side, (depth * c).floor().max(1), WIRE_ON);
        }
    }

    // Draws the part of the circuit in view into the view image
    render_circuit_view(self)
    {
        let grid = self.circuit;
        let view = grid.view;
        let img = view.img;
        let c = view.cell();
        let size = grid.size;
        let num_x = view.visible().min(size - view.x);
        let num_y = view.visible().min(size - view.y);
        let cells = grid.img.bytes;
        let sim = self.sim;

        img.clear(BG);
        img.fill_rect(0, 0, num_x * c, num_y * c, CELL_BG);

        if (c >= GRID_LINES_FROM) {
            for (let var i = 0; i < num_x; ++i)
                img.fill_rect(i * c, 0, 1, num_y * c, GRID_LINE);
            for (let var i = 0; i < num_y; ++i)
                img.fill_rect(0, i * c, num_x * c, 1, GRID_LINE);
        }

        for (let var j = 0; j < num_y; ++j) {
            let row = (view.y + j) * size + view.x;

            for (let var i = 0; i < num_x; ++i) {
                let value = cells.get_u32(row + i) & 0xFF_FF_FF;

                if (value != 0)
                    self.draw_node(img, i * c, j * c, c, value, sim.sides_on(row + i), sim.is_broken(row + i), c >= GRID_LINES_FROM);
            }
        }

        view.dirty = false;
    }

    // Draws the circuit screen: the view of the circuit, and on its right
    // the nodes to pick from, the one picked and the zoom
    render_circuit(self)
    {
        let frame = self.frame;
        let grid = self.circuit;
        let view = grid.view;
        let can_edit = view.zoom >= MIN_EDIT_ZOOM;

        draw_full_logo(frame, MARGIN, 14, SMALL_LOGO);
        self.text(frame, MARGIN + logo_width(SMALL_LOGO) + 12, 17, "circuit", DIM, BG);

        let var status = self.grid_status(grid, can_edit ? "" : "zoom in to edit");
        if (status == "" && self.sim != nil && self.sim.num_broken > 0)
            status = "loops in pink";

        if (grid.img == nil || self.sim == nil) {
            frame.fill_rect(VIEW_X, VIEW_Y, VIEW_SIZE, VIEW_SIZE, CELL_BG);
        } else {
            if (view.dirty)
                self.render_circuit_view();
            frame.blit(view.img, VIEW_X, VIEW_Y);
        }

        draw_rect(frame, VIEW_X - 1, VIEW_Y - 1, VIEW_SIZE + 2, VIEW_SIZE + 2, BORDER);

        // The cell under the mouse, with the node it would be given
        let cell = view.cell();
        let node = self.node_value();
        if (self.hover != nil && can_edit) {
            let hx = VIEW_X + (self.hover.x - view.x) * cell;
            let hy = VIEW_Y + (self.hover.y - view.y) * cell;

            // A switch is left to show, as clicking it turns it on or off
            let over_switch = cell_type(grid.get(self.hover.x, self.hover.y)) == SWITCH;

            if (node != 0 && self.painting == nil && !over_switch) {
                frame.fill_rect(hx, hy, cell, cell, CELL_BG);
                self.draw_node(frame, hx, hy, cell, node, 0, false, false);
            }

            self.marker(hx, hy, cell, cell);
        }

        // Nodes to pick from, as they are turned
        for (let var i = 0; i < NODES.len; ++i) {
            let x = SIDE_X + (i % 4) * (SWATCH + SWATCH_GAP);
            let y = VIEW_Y + i.idiv(4) * (SWATCH + SWATCH_GAP);
            let type = cell_type(NODES[i].value);
            let value = cell_value(type, self.rot % NUM_ROTS[type], cell_param(NODES[i].value));

            frame.fill_rect(x, y, SWATCH, SWATCH, CELL_BG);
            self.draw_node(frame, x, y, SWATCH, value, 0, false, false);
            self.buttons.push({x: x, y: y, w: SWATCH, h: SWATCH, action: "node", arg: i});

            // The eraser is a cross
            if (value == 0) {
                frame.draw_line(x + 16, y + 16, x + SWATCH - 17, y + SWATCH - 17, ERROR);
                frame.draw_line(x + SWATCH - 17, y + 16, x + 16, y + SWATCH - 17, ERROR);
            }

            if (i == self.node)
                self.marker(x, y, SWATCH, SWATCH);
            else
                draw_rect(frame, x, y, SWATCH, SWATCH, FIELD);
        }

        // The node picked, as it would be placed, and its name
        let var y = VIEW_Y + (NODES.len + 3).idiv(4) * (SWATCH + SWATCH_GAP) + 8;
        frame.fill_rect(SIDE_X, y, PREVIEW, PREVIEW, CELL_BG);
        draw_rect(frame, SIDE_X, y, PREVIEW, PREVIEW, BORDER);
        self.draw_node(frame, SIDE_X, y, PREVIEW, node, 0, false, false);
        self.text(frame, SIDE_X + PREVIEW + 12, y + (PREVIEW - CHAR_H).idiv(2), NODES[self.node].name, TEXT, BG);

        y = y + PREVIEW + 16;
        self.render_zoom(grid, y);
        self.text(frame, SIDE_X, y + 72, "arrows  move", DIM, BG);
        self.text(frame, SIDE_X, y + 98, "+ and -  zoom", DIM, BG);
        self.text(frame, SIDE_X, y + 124, "R  turn", DIM, BG);
        self.text(frame, SIDE_X, y + 150, "D  eraser", DIM, BG);
        self.text(frame, SIDE_X, y + 176, "right  erase", DIM, BG);
        self.text(frame, SIDE_X, y + 208, status, self.conn == "connected" && grid.error == "" ? DIM : ERROR, BG);
    }

    // Draws the guestbook screen: a header, the box to write a message,
    // and the list of messages
    render_main(self)
    {
        let frame = self.frame;

        // Header, with a small logo, the guestbook's stats and the user. The
        // stats that older servers don't send are left out.
        draw_full_logo(frame, MARGIN, 14, SMALL_LOGO);
        self.text(frame, MARGIN + logo_width(SMALL_LOGO) + 12, 17, "guestbook", DIM, BG);

        if (self.total_views != nil) {
            let var stats = self.total_views.comma_sep() + (self.total_views == 1 ? " view" : " views");
            if (self.messages_today != nil)
                stats = stats + ", " + self.messages_today.comma_sep() + (self.messages_today == 1 ? " message today" : " messages today");
            self.text(frame, WIDTH - MARGIN - num_chars(stats) * CHAR_W, 4, stats, DIM, BG);
        }

        // Guests get a button to register or log in instead of their name
        let var who_x = 0;
        if (self.username == nil) {
            let login_w = 18 * CHAR_W;
            who_x = WIDTH - MARGIN - login_w;
            self.button(who_x, 30, login_w, CHAR_H, "register / log in", LOGIN_BUTTON, "open_modal", nil);
        } else {
            let who = (self.is_admin ? "admin " : "") + self.username;
            let logout_w = 8 * CHAR_W;
            who_x = WIDTH - MARGIN - logout_w - 12 - num_chars(who) * CHAR_W;
            self.text(frame, who_x, 30, who, name_color(self.username), BG);
            self.button(WIDTH - MARGIN - logout_w, 30, logout_w, CHAR_H, "log out", FIELD, "logout", nil);
        }

        // Left out when a long username leaves no room next to the title
        if (self.num_accounts != nil) {
            let accounts = self.num_accounts.comma_sep() + (self.num_accounts == 1 ? " account" : " accounts");
            let accounts_x = who_x - 24 - num_chars(accounts) * CHAR_W;
            let title_end = MARGIN + logo_width(SMALL_LOGO) + 12 + num_chars("guestbook") * CHAR_W;

            if (accounts_x >= title_end + 12)
                self.text(frame, accounts_x, 30, accounts, DIM, BG);
        }

        // Box to write a message, showing its last lines
        let box_w = WIDTH - 2 * MARGIN;
        let box_h = COMPOSE_LINES * CHAR_H + 2 * TEXT_PAD;
        frame.fill_rect(MARGIN, COMPOSE_Y, box_w, box_h, FIELD);
        draw_rect(frame, MARGIN, COMPOSE_Y, box_w, box_h, FOCUS);

        let tx = MARGIN + TEXT_PAD;
        let ty = COMPOSE_Y + TEXT_PAD;

        // The cursor moves to the login box while it is open
        let cursor_on = self.cursor_on && !self.modal;

        if (self.compose.len == 0) {
            self.text(frame, tx, ty, "Write a message and press Enter...", DIM, FIELD);
            if (cursor_on)
                self.frame.fill_rect(tx, ty + CHAR_H - 4, CHAR_W, 2, FOCUS);
        } else {
            let lines = wrap(join(self.compose), COMPOSE_COLS);
            let first = (lines.len - COMPOSE_LINES).max(0);

            for (let var i = first; i < lines.len; ++i)
                self.text(frame, tx, ty + (i - first) * CHAR_H, lines[i], TEXT, FIELD);

            if (cursor_on) {
                let last = lines[lines.len - 1];
                let cx = tx + num_chars(last) * CHAR_W;
                self.text(frame, cx.min(MARGIN + box_w - TEXT_PAD - CHAR_W), ty + (lines.len - 1 - first) * CHAR_H, "＿", FOCUS, FIELD);
            }
        }

        // Character count, status and send button
        let row_y = COMPOSE_Y + box_h + 10;
        let count = self.compose.len.to_s() + "/" + MAX_MSG_LEN.to_s();
        self.text(frame, MARGIN, row_y + 6, count, self.compose.len >= MAX_MSG_LEN ? ERROR : DIM, BG);
        let status_x = MARGIN + 10 * CHAR_W;
        if (self.conn == "connected")
            self.text(frame, status_x, row_y + 6, self.status, self.status_color, BG);
        else if (self.total_views != nil)
            self.text(frame, status_x, row_y + 6, "Connection lost, reconnecting...", ERROR, BG);
        else if (self.conn == "connecting")
            self.text(frame, status_x, row_y + 6, "Connecting to " + self.addr + "...", DIM, BG);
        else
            self.text(frame, status_x, row_y + 6, "Could not connect to " + self.addr + ", retrying...", ERROR, BG);

        self.button(WIDTH - MARGIN - 110, row_y, 110, 36, "Send", BUTTON, "send", nil);

        self.render_messages();
        frame.blit(self.panel, MARGIN, PANEL_Y);

        // Scrollbar
        let bar = self.scrollbar();
        frame.fill_rect(bar.x, bar.y, SCROLLBAR_W, bar.h, FIELD);
        frame.fill_rect(bar.x + 2, bar.thumb_y, SCROLLBAR_W - 4, bar.thumb_h, self.drag_offset != nil ? FOCUS : BORDER);
    }

    // Draws the visible messages into the panel image
    render_messages(self)
    {
        let panel = self.panel;
        panel.clear(PANEL);

        let text_w = panel.width - SCROLLBAR_W;
        let var y = 8 - self.scroll_y;

        for (let var i = 0; i < self.messages.len; ++i) {
            let msg = self.messages[i];
            let h = self.block_height(msg);

            if (y + h > 0 && y < panel.height) {
                self.text(panel, TEXT_PAD, y, msg.username, name_color(msg.username), PANEL);
                self.text(panel, TEXT_PAD + (num_chars(msg.username) + 2) * CHAR_W, y, time_ago(msg.time), DIM, PANEL);

                for (let var j = 0; j < msg.lines.len; ++j)
                    self.text(panel, TEXT_PAD, y + (j + 1) * CHAR_H, msg.lines[j], TEXT, PANEL);

                if (self.is_admin)
                    self.admin_buttons(msg, y, text_w);

                panel.fill_rect(TEXT_PAD, y + h - 9, text_w - 2 * TEXT_PAD, 1, FIELD);
            }

            y = y + h;
        }

        let var footer = "";
        if (self.messages.len == 0)
            footer = self.no_more_older ? "No messages yet, be the first to sign!" : "Loading messages...";
        else if (self.no_more_older)
            footer = "You've reached the first message";
        else
            footer = "Loading older messages...";

        if (y < panel.height)
            self.text(panel, (text_w - num_chars(footer) * CHAR_W).idiv(2), y + 8, footer, DIM, PANEL);
    }

    // Draws a small button in the message list, from its right edge at x.
    // Returns the x coordinate of its left edge.
    list_button(self, x, y, label, color, action, arg)
    {
        let w = (num_chars(label) + 1) * CHAR_W;
        let left = x - w;
        self.panel.fill_rect(left, y, w, CHAR_H, color);
        self.text(self.panel, left + CHAR_W.idiv(2), y, label, BUTTON_TEXT, color);

        // Only clickable where it's visible
        if (y >= 0 && y + CHAR_H <= self.panel.height)
            self.buttons.push({x: MARGIN + left, y: PANEL_Y + y, w: w, h: CHAR_H, action: action, arg: arg});

        return left;
    }

    // Draws the admin's delete button for a message. Once clicked, it is
    // replaced by a button for each category to delete the message as, and
    // one to cancel.
    admin_buttons(self, msg, y, text_w)
    {
        let var x = text_w - TEXT_PAD;

        if (self.deleting != msg.id) {
            self.list_button(x, y, "delete", DANGER, "start_delete", msg.id);
            return;
        }

        x = self.list_button(x, y, "cancel", CANCEL, "cancel_delete", nil) - 12;

        // Drawn from right to left, so that they read hate, spam, other
        let tags = ["other", "spam", "hate"];
        for (let var i = 0; i < tags.len; ++i)
            x = self.list_button(x, y, tags[i], DANGER, "delete", {id: msg.id, tag: tags[i]}) - 6;
    }
}

// Server address from the command line: --local or --localhost for a
// server on this machine, an address, or the default server
fun server_addr()
{
    let arg = $cmd_get_arg_or(1, DEFAULT_SERVER);
    return arg == "--local" || arg == "--localhost" ? LOCAL_SERVER : arg;
}

// Opens the window and runs the client until the window is closed
fun main()
{
    let app = App(server_addr());
    let window = $window_create(WIDTH, HEIGHT, "Plush Guestbook", 0);

    app.connect();

    // Wakes us up every few seconds to check for new messages
    $actor_spawn(|| {
        loop {
            $actor_sleep(POLL_MS);
            $actor_send($actor_parent(), "tick");
        }
    });

    loop {
        loop {
            let msg = $actor_poll();

            if (msg == nil)
                break;

            if (msg instanceof UIEvent && msg.kind == "CLOSE_WINDOW")
                $exit(0);

            app.handle(msg);
        }

        app.update();

        if (app.needs_redraw()) {
            app.render();
            $window_draw_frame(window, app.frame.bytes);
        }

        $actor_sleep(16);
    }
}

if ($MAIN_UNIT) {
    main();
}
