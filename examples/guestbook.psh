    ],
    [
        "###...###",
        "###...###",
        "###...###",
        "###...###",
        "###...###",
        "###...###",
        "#########",
        ".#######.",
    ],
    [
        ".########",
        "###......",
        "###......",
        "###......",
        ".#######.",
        "......###",
