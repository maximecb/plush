let NUM_STRIPES = 8;
let LETTER_COLS = 9;

// Intro animation timing, in milliseconds: the letters appear one by one,
// then the bear, then the bear's sunglasses drop onto its face
let LETTER_START_MS = 300;
let LETTER_EVERY_MS = 380;
let STRIPE_MS = 35;
let BEAR_MS = 2350;
let SHADES_MS = 2850;
let SHADES_DROP_MS = 350;
let TAGLINE_MS = 3350;
let INTRO_END_MS = 4000;

// Height the sunglasses drop from, in the bear's units
let SHADES_DROP = 45;

// Logo sizes: cell width, stripe height and gap between stripes, and how
// far up the bear is moved to line up with the letters, in pixels
let BIG_LOGO = {cell: 10, stripe: 10, gap: 5, bear_up: 3};
let SMALL_LOGO = {cell: 3, stripe: 3, gap: 1, bear_up: 1};

// Vertical position of the big logo during the intro
let INTRO_LOGO_Y = 270;

// Size of the box to register or log in, centered over the guestbook
let MODAL_W = 720;
let MODAL_H = 436;

// Layout of the guestbook screen
let COMPOSE_Y = 64;
let COMPOSE_LINES = 3;
let PANEL_Y = 208;
let MARGIN = 16;
let SCROLLBAR_W = 12;
let TEXT_PAD = 12;

// Tabs at the bottom of the screen, one per view, in rainbow colors
let TABS = [
    {key: "F1", label: "guestbook", screen: "main"},
    {key: "F2", label: "canvas", screen: "canvas"},
];
let FOOTER_H = 28;
let FOOTER_Y = HEIGHT - FOOTER_H - 8;

// Layout of the canvas screen: the square view of the canvas on the left,
// and the colors on its right
let VIEW_SIZE = 640;
let VIEW_X = MARGIN;
let VIEW_Y = 52;
let SIDE_X = VIEW_X + VIEW_SIZE + 16;
let SIDE_W = WIDTH - MARGIN - SIDE_X;
let SWATCH = 52;
let SWATCH_GAP = 8;

// The color picker: a square of saturations and values for the current
// hue, drawn as blocks of PICK_BLOCK pixels, above a bar of hues
let PICK_Y = VIEW_Y + 4 * (SWATCH + SWATCH_GAP) + 8;
let PICK_H = 136;
let PICK_BLOCK = 4;
let HUE_Y = PICK_Y + PICK_H + 8;
let HUE_H = 20;

// Sizes of a canvas pixel on screen, in pixels, from zoomed out to zoomed
// in. All divide VIEW_SIZE. The view starts at zoom DEFAULT_ZOOM, and
// drawing needs pixels big enough to click, from zoom MIN_DRAW_ZOOM up.
let ZOOMS = [1, 2, 5, 10, 20];
let DEFAULT_ZOOM = 3;
let MIN_DRAW_ZOOM = 2;

// How often to ask for the pixels others changed, the minimum time between
// the pixel changes we send, kept under the server's limit, and how many
// clicks can wait to be sent
let CANVAS_POLL_MS = 1000;
let SET_INTERVAL_MS = 220;
let MAX_QUEUED_SETS = 8;

// Colors to paint with: the 12-band rainbow, then black, grey, white and
// brown
let PALETTE = [];
for (let var i = 0; i < RAINBOW12.len; ++i)
    PALETTE.push(RAINBOW12[i]);
PALETTE.push(rgb(0, 0, 0));
PALETTE.push(rgb(128, 128, 128));
PALETTE.push(rgb(255, 255, 255));
PALETTE.push(rgb(139, 69, 19));

// Characters per line in the compose box and the message list
let COMPOSE_COLS = (WIDTH - 2 * MARGIN - 2 * TEXT_PAD).idiv(CHAR_W);
let MSG_COLS = (WIDTH - 2 * MARGIN - SCROLLBAR_W - 2 * TEXT_PAD).idiv(CHAR_W);

// Splits a string into an array of single-character strings
fun chars(s)
{
    let out = [];
    let var i = 0;

    while (i < s.len) {
        let ch = s.char_at(i);

        if (ch == nil) {
            i = i + 1;
            continue;
        }

        out.push(ch);
        i = i + ch.len;
    }

    return out;
}

// Joins an array of strings into one
fun join(parts)
{
    let out = ByteArray.with_size(0);

    for (let var i = 0; i < parts.len; ++i)
        out.push_string(parts[i]);

    return String.from_utf8(out, 0, out.len);
}

// Number of characters in a string
fun num_chars(s)
{
    return chars(s).len;
}

// Wraps text into lines of at most cols characters, breaking at spaces
// where possible
fun wrap(text, cols)
{
    let cs = chars(text);
    cs.push(" ");

    let lines = [];
    let var line = [];
    let var word = [];

    for (let var i = 0; i < cs.len; ++i) {
        if (cs[i] != " ") {
            word.push(cs[i]);
            continue;
        }

        let sep = line.len > 0 ? 1 : 0;

        if (line.len + sep + word.len <= cols) {
            if (sep == 1)
                line.push(" ");
            line.append(word);
        } else {
            if (line.len > 0)
                lines.push(join(line));

            // Words longer than a line are split
            while (word.len > cols) {
                lines.push(join(word.slice(0, cols)));
                word = word.slice(cols, word.len);
            }

            line = word;
        }

        word = [];
    }

    if (line.len > 0 || lines.len == 0)
        lines.push(join(line));

    return lines;
}

// Describes how long ago a Unix timestamp was
fun time_ago(time)
{
    let secs = $time_current_ms().idiv(1000) - time;

    if (secs < 60) return "just now";

    let mins = secs.idiv(60);
    if (mins < 60) return mins.to_s() + " min ago";

    let hours = mins.idiv(60);
    if (hours < 24) return hours.to_s() + (hours == 1 ? " hour ago" : " hours ago");

    let days = hours.idiv(24);
    if (days < 30) return days.to_s() + (days == 1 ? " day ago" : " days ago");

    let months = days.idiv(30);
    if (months < 12) return months.to_s() + (months == 1 ? " month ago" : " months ago");

    let years = days.idiv(365);
    return years.to_s() + (years == 1 ? " year ago" : " years ago");
}

// Picks a rainbow color for a username, so that each user keeps theirs
fun name_color(name)
{
    let var sum = 0;

    for (let var i = 0; i < name.len; ++i)
        sum = sum + name.byte_at(i);

    return RAINBOW[sum % RAINBOW.len];
}

// Tests if a byte can be part of a username: an ASCII letter or digit, or
// an underscore
fun is_name_byte(b)
{
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95;
}

// Tests if a username has only the characters the server accepts
fun valid_username(name)
{
    if (name.len < 2 || name.len > MAX_NAME_LEN)
        return false;

    for (let var i = 0; i < name.len; ++i) {
        if (!is_name_byte(name.byte_at(i)))
            return false;
    }

    return true;
}

// Hash of a password, as the server expects it
fun password_hash(password)
{
    return sha256(HASH_PREFIX + password).to_hex();
}

// Converts a hue in [0, 360) and a saturation and value in [0, 1] to a color
fun hsv_to_rgb(h, s, v)
{
    let sector = (h / 60.0).floor();
    let f = h / 60.0 - sector;
    let p = v * (1.0 - s);
    let q = v * (1.0 - s * f);
    let t = v * (1.0 - s * (1.0 - f));

    // Scales a component to [0, 255]
    fun byte(c) {
        return (c * 255.0 + 0.5).floor().clip(0, 255);
    }

    let i = sector % 6;
    if (i == 0) return rgb(byte(v), byte(t), byte(p));
    if (i == 1) return rgb(byte(q), byte(v), byte(p));
    if (i == 2) return rgb(byte(p), byte(v), byte(t));
    if (i == 3) return rgb(byte(p), byte(q), byte(v));
    if (i == 4) return rgb(byte(t), byte(p), byte(v));
    return rgb(byte(v), byte(p), byte(q));
}

// Converts a color to its hue, saturation and value, see hsv_to_rgb
fun rgb_to_hsv(color)
{
    let r = ((color >> 16) & 0xFF) / 255.0;
    let g = ((color >> 8) & 0xFF) / 255.0;
    let b = (color & 0xFF) / 255.0;
    let hi = r.max(g).max(b);
    let d = hi - r.min(g).min(b);
    let var h = 0.0;

    if (d > 0.0) {
        if (hi == r)
            h = 60.0 * ((g - b) / d);
        else if (hi == g)
            h = 60.0 * ((b - r) / d + 2.0);
        else
            h = 60.0 * ((r - g) / d + 4.0);

        if (h < 0.0)
            h = h + 360.0;
    }

    return {h: h, s: hi > 0.0 ? d / hi : 0.0, v: hi};
}

// Draws a filled ellipse
fun fill_ellipse(img, cx, cy, rx, ry, color)
{
    for (let var dy = -ry; dy <= ry; ++dy) {
        let t = dy.to_f() / ry;
        let half = (rx * (1.0 - t * t).max(0.0).sqrt()).floor();
        img.fill_rect(cx - half, cy + dy, 2 * half + 1, 1, color);
    }
}

// Draws the outline of a rectangle
fun draw_rect(img, x, y, w, h, color)
{
    img.fill_rect(x, y, w, 1, color);
    img.fill_rect(x, y + h - 1, w, 1, color);
    img.fill_rect(x, y, 1, h, color);
    img.fill_rect(x + w - 1, y, 1, h, color);
}

// Draws a teddy bear in a size by size box. If shades_y is not nil, the
// bear wears sunglasses, shades_y units below where they sit on its face,
// so that they can be animated falling into place. Without them, its eyes
// show.
fun draw_bear(img, x, y, size, shades_y)
{
    let s = size / 100.0;

    // Draws an ellipse given in the bear's 100 by 100 coordinates
    fun part(cx, cy, rx, ry, color) {
        fill_ellipse(img, x + (cx * s).floor(), y + (cy * s).floor(), (rx * s).floor().max(1), (ry * s).floor().max(1), color);
    }

    // Ears
    part(24, 19, 10, 10, FUR);
    part(76, 19, 10, 10, FUR);
    part(24, 19, 5, 5, FUR_LIGHT);
    part(76, 19, 5, 5, FUR_LIGHT);

    // Body, arms and feet
    part(50, 78, 28, 22, FUR);
    part(50, 81, 16, 13, FUR_LIGHT);
    part(21, 74, 9, 13, FUR);
    part(79, 74, 9, 13, FUR);
    part(32, 94, 12, 6, FUR);
    part(68, 94, 12, 6, FUR);

    // Head, muzzle, nose and eyes
    part(50, 40, 32, 29, FUR);
    part(50, 54, 13, 9, FUR_LIGHT);
    part(50, 50, 5, 3, FUR_DARK);
    part(38, 38, 4, 4, FUR_DARK);
    part(62, 38, 4, 4, FUR_DARK);

    if (shades_y != nil) {
        let sy = 36 + shades_y;
        part(38, sy, 10, 6, FUR_DARK);
        part(62, sy, 10, 6, FUR_DARK);
        img.fill_rect(x + (44 * s).floor(), y + ((sy - 2) * s).floor(), (12 * s).floor().max(1), (3 * s).floor().max(1), FUR_DARK);
    }
}

// Height of the logo for a given size
fun logo_height(size)
{
    return NUM_STRIPES * (size.stripe + size.gap) - size.gap;
}

// Width of the logo, letters and bear, for a given size
fun logo_width(size)
{
    return 56 * size.cell + logo_height(size);
}

// Draws the logo: the letters of PLUSH in rainbow colors, each made of
// horizontal stripes, followed by the teddy bear. letter_stripes says how
// many stripes of each letter to draw. The bear is only drawn if show_bear
// is true, with its sunglasses at shades_y (see draw_bear).
fun draw_logo(img, x, y, size, letter_stripes, show_bear, shades_y)
{
    let period = size.stripe + size.gap;

    for (let var i = 0; i < LOGO_LETTERS.len; ++i) {
        let rows = LOGO_LETTERS[i];
        let lx = x + i * (LETTER_COLS + 2) * size.cell;

        for (let var r = 0; r < letter_stripes[i]; ++r) {
            let row = rows[r];
            let var c = 0;

            // Draw each run of filled cells as one bar
            while (c < LETTER_COLS) {
                if (row.byte_at(c) != 35) {
                    c = c + 1;
                    continue;
                }

                let start = c;
                while (c < LETTER_COLS && row.byte_at(c) == 35)
                    c = c + 1;

                img.fill_rect(lx + start * size.cell, y + r * period, (c - start) * size.cell, size.stripe, RAINBOW[i]);
            }
        }
    }

    if (show_bear)
        draw_bear(img, x + 56 * size.cell, y - size.bear_up, logo_height(size), shades_y);
}

// Draws the complete logo
fun draw_full_logo(img, x, y, size)
{
    draw_logo(img, x, y, size, [8, 8, 8, 8, 8], true, 0);
}

// Actor that connects to the server, then reads lines from the socket and
// forwards each parsed message to the main actor. gen tells messages from
// an old connection apart from the current one.
fun net_actor(addr, gen)
{
    let parent = $actor_parent();
    let sock = $net_connect(addr);

    if (sock == nil) {
        $actor_send(parent, {net: "failed", gen: gen});
        return;
    }

    // Wait for data as long as it takes, the server sends nothing when idle
    $net_set_timeout(sock, 0);
    $actor_send(parent, {net: "connected", gen: gen, sock: sock});

    let buf = ByteArray.with_size(1 << 20);
    let var len = 0;

    // Raw data being read, which follows a message with a `bytes` field,
    // and is forwarded with it in its `data` field
    let var blob = nil;
    let var blob_len = 0;
    let var blob_msg = nil;

    loop {
        let num_read = $net_read(sock, buf, len, buf.len - len);

        if (num_read == nil || (num_read == 0 && len == buf.len))
            break;

        len = len + num_read;

        // Forward every complete line, and the raw data after it, if any
        let var start = 0;
        let var i = 0;

        while (i < len) {
            if (blob != nil) {
                let num = (len - i).min(blob.len - blob_len);
                blob.memcpy(blob_len, buf, i, num);
                blob_len = blob_len + num;
                i = i + num;
                start = i;

                if (blob_len == blob.len) {
                    blob_msg.data = blob;
                    $actor_send(parent, {net: "msg", gen: gen, msg: blob_msg});
                    blob = nil;
                }

                continue;
            }

            if (buf[i] != 10) {
                i = i + 1;
                continue;
            }

            let line = String.from_utf8(buf, start, i - start);
            i = i + 1;
            start = i;

            if (line == nil)
                continue;

            let msg = parse_json(line);
            if (!(msg instanceof Dict))
                continue;

            if (msg.has("bytes") && msg.bytes instanceof Int64 && msg.bytes > 0 && msg.bytes <= MAX_BLOB) {
                blob = ByteArray.with_size(msg.bytes);
                blob_len = 0;
                blob_msg = msg;
            } else {
                $actor_send(parent, {net: "msg", gen: gen, msg: msg});
            }
        }

        buf.memcpy(0, buf, start, len - start);
        len = len - start;
    }

    $actor_send(parent, {net: "closed", gen: gen});
}

// State of the client and its three screens: the intro animation, the
// guestbook and the admin page. The box to register or log in is drawn
// over the guestbook.
class App
{
    // Creates the client for a given server address
    init(self, addr)
    {
        self.addr = addr;
        self.frame = Image(WIDTH, HEIGHT);
        self.panel = Image(WIDTH - 2 * MARGIN, FOOTER_Y - 8 - PANEL_Y);
        self.fonts = {};

        self.screen = "intro";
        self.start_ms = $time_current_ms();
        self.dirty = true;
        self.cursor_on = true;

        // Connection to the server
        self.conn = "connecting";
        self.sock = nil;
        self.gen = 0;
        self.pending = [];
        self.total_views = nil;
        self.messages_today = nil;
        self.num_accounts = nil;

        // Login box fields: username, password and password confirmation,
        // as arrays of characters. Confirmation is only used to register.
        self.fields = [[], [], []];
        self.focus = 0;
        self.status = "";
        self.status_color = DIM;

        // Whether the login box is open, its own status line, and whether
        // to send the message being written once logged in
        self.modal = false;
        self.modal_status = "";
        self.modal_status_color = DIM;
        self.post_after_auth = false;

        // Logged in user, and credentials to log in again after reconnecting
        self.username = nil;
        self.is_admin = false;
        self.auth = nil;
        self.admin_info = nil;
        self.admin_error = "";

        // Messages, newest first, with their wrapped lines
        self.messages = [];
        self.msg_ids = {};
        self.scroll_y = 0;
        self.loading_older = false;
        self.no_more_older = false;
        self.compose = [];

        // Clickable areas of the last frame drawn, and scrollbar dragging
        self.buttons = [];
        self.drag_offset = nil;

        // Id of the message the admin is about to delete, which then shows
        // the categories to delete it as
        self.deleting = nil;

        // Our copy of the canvas, created once the server tells its size,
        // and for each tile, the server's change counter when we fetched it,
        // or -1 if it has to be fetched, and whether a request is on its way
        self.canvas = nil;
        self.canvas_size = 0;
        self.tile_size = 0;
        self.tiles = [];

        // Epoch and seq of the last poll response, which the next poll sends
        self.canvas_epoch = nil;
        self.canvas_seq = nil;
        self.canvas_polling = false;
        self.last_poll_ms = 0;
        self.canvas_error = "";

        // Pixels we painted that are waiting to be sent
        self.set_queue = [];
        self.last_set_ms = 0;

        // Part of the canvas in view: zoom level, top-left canvas pixel, and
        // the image of it at that zoom, redrawn when view_dirty is set
        self.zoom = DEFAULT_ZOOM;
        self.view_x = 0;
        self.view_y = 0;
        self.view_img = Image(VIEW_SIZE, VIEW_SIZE);
        self.view_dirty = true;

        // Canvas pixel under the mouse, or nil
        self.hover = nil;

        // Color to paint with: one of the palette's, or the custom color
        // made with the color picker. Then the custom color's place in the
        // picker, the picker's images, and which part of the picker is
        // being dragged, if any.
        self.color = PALETTE[0];
        self.custom = self.color;
        self.custom_selected = false;
        self.hsv = rgb_to_hsv(self.custom);
        self.sv_img = Image(SIDE_W, PICK_H);
        self.sv_hue = nil;
        self.hue_img = Image(SIDE_W, HUE_H);
        self.pick_drag = nil;

        for (let var x = 0; x < SIDE_W; x = x + PICK_BLOCK)
            self.hue_img.fill_rect(x, 0, PICK_BLOCK, HUE_H, hsv_to_rgb(360.0 * x / SIDE_W, 1.0, 1.0));
    }

    // Returns a font for a text color on a background color
    font(self, color, bg)
    {
        let key = color.to_s() + ":" + bg.to_s();

        if (!self.fonts.has(key))
            self.fonts[key] = Font(2, color, bg);

        return self.fonts[key];
    }

    // Draws a line of text into an image
    text(self, img, x, y, str, color, bg)
    {
        let font = self.font(color, bg);
        let cs = chars(str);

        for (let var i = 0; i < cs.len; ++i)
            font.draw_char(img, x + i * CHAR_W, y, cs[i]);
    }

    // Draws a line of text centered horizontally in the frame
    centered(self, y, str, color)
    {
        self.text(self.frame, (WIDTH - num_chars(str) * CHAR_W).idiv(2), y, str, color, BG);
    }

    // Shows a status message on the guestbook screen
    set_status(self, msg, color)
    {
        self.status = msg;
        self.status_color = color;
        self.dirty = true;
    }

    // Shows a status message in the login box
    set_modal_status(self, msg, color)
    {
        self.modal_status = msg;
        self.modal_status_color = color;
        self.dirty = true;
    }

    // Opens the login box. If post is true, the message being written is
    // sent once logged in.
    open_modal(self, post)
    {
        self.modal = true;
        self.post_after_auth = post;
        self.drag_offset = nil;
        self.deleting = nil;
        self.set_modal_status("", DIM);
    }

    // Closes the login box, forgetting the passwords typed
    close_modal(self)
    {
        self.modal = false;
        self.post_after_auth = false;
        self.fields[1] = [];
        self.fields[2] = [];
        self.focus = 0;
        self.dirty = true;
    }

    // Starts connecting to the server, in a new network actor
    connect(self)
    {
        self.gen = self.gen + 1;
        self.conn = "connecting";
        self.sock = nil;
        self.pending = [];
        self.loading_older = false;
        self.dirty = true;
        self.reset_canvas_requests();

        let addr = self.addr;
        let gen = self.gen;
        $actor_spawn(|| net_actor(addr, gen));
    }

    // Drops the connection, which the network actor notices and reports
    disconnect(self)
    {
        if (self.sock != nil)
            $net_close(self.sock);

        self.sock = nil;
        self.conn = "closed";
    }

    // Sends a request to the server. info is kept with it, to handle the
    // response, which comes back in the same order as the requests.
    send(self, req, info)
    {
        if (self.conn != "connected")
            return false;

        let out = ByteArray.with_size(0);
        out.push_string(format_json(req));
        out.push_u8(10);

        if ($net_write(self.sock, out, 0, out.len) == nil) {
            self.disconnect();
            return false;
        }

        self.pending.push({req: req, info: info});
        return true;
    }

    // Handles a message from the mailbox: a UI event, a timer tick, or a
    // message from the network actor
    handle(self, msg)
    {
        if (msg instanceof UIEvent) {
            self.handle_ui(msg);
            return;
        }

        if (msg == "tick") {
            self.on_tick();
            return;
        }

        if (msg instanceof Dict && msg.has("net"))
            self.handle_net(msg);
    }

    // Refreshes the current page every few seconds and reconnects when needed
    on_tick(self)
    {
        if (self.screen == "intro")
            return;

        if (self.conn == "failed" || self.conn == "closed") {
            self.connect();
            return;
        }

        if (self.screen == "main" && self.pending.len == 0) {
            self.request_newer();
            self.send({type: "stats"}, nil);
        } else if (self.screen == "admin" && self.is_admin && self.pending.len == 0) {
            self.send({type: "admin_info"}, nil);
        }
    }

    // Handles a message from the network actor
    handle_net(self, msg)
    {
        if (msg.gen != self.gen)
            return;

        self.dirty = true;

        if (msg.net == "failed") {
            self.conn = "failed";
            self.is_admin = false;
            self.admin_info = nil;
            self.admin_error = "";
            return;
        }

        if (msg.net == "connected") {
            self.conn = "connected";
            self.sock = msg.sock;
            return;
        }

        if (msg.net == "closed") {
            self.conn = "closed";
            self.sock = nil;
            self.pending = [];
            self.loading_older = false;
            self.is_admin = false;
            self.admin_info = nil;
            self.admin_error = "";
            self.reset_canvas_requests();

            // A login request in flight is lost
            if (self.modal && self.modal_status != "")
                self.set_modal_status("Connection lost, please try again", ERROR);
            return;
        }

        self.handle_response(msg.msg);
    }

    // Handles a response from the server
    handle_response(self, res)
    {
        // The hello comes unprompted when connecting
        if (res.type == "hello") {
            if (!res.ok) {
                self.set_status(res.error, ERROR);
                return;
            }

            self.total_views = res.total_views;
            self.messages_today = res.has("messages_today") ? res.messages_today : nil;
            self.num_accounts = res.has("num_accounts") ? res.num_accounts : nil;

            // Log back in after a reconnection, which then fetches messages
            if (self.auth != nil)
                self.send({type: "login", username: self.auth.username, hash: self.auth.hash}, {silent: true});
            else if (self.screen == "main" && self.pending.len == 0)
                self.request_newer();

            return;
        }

        if (self.pending.len == 0)
            return;

        let sent = self.pending.remove(0);
        let req = sent.req;
        let info = sent.info;

        if (req.type == "login" || req.type == "register") {
            let silent = info != nil && info.silent;

            if (res.ok) {
                self.username = res.username;
                self.is_admin = res.status == "ADMIN";
                self.auth = {username: req.username, hash: req.hash};

                if (self.screen == "admin" && self.is_admin)
                    self.send({type: "admin_info"}, nil);
                else
                    self.request_newer();

                if (!silent) {
                    let post = self.post_after_auth;
                    self.close_modal();
                    self.fields[0] = [];
                    self.set_status("Welcome, " + res.username + "!", SUCCESS);

                    if (post)
                        self.submit_post();
                }
            } else if (silent) {
                // Back to browsing as a guest
                self.auth = nil;
                self.username = nil;
                self.is_admin = false;
                self.admin_info = nil;
                self.screen = "main";
                self.set_status(res.error, ERROR);
            } else {
                self.set_modal_status(res.error, ERROR);
            }
            return;
        }

        if (req.type == "get_messages") {
            if (info.mode == "older")
                self.loading_older = false;

            if (res.ok) {
                self.add_messages(res.messages);

                if (info.mode != "newer" && res.messages.len < req.limit)
                    self.no_more_older = true;
            }
            return;
        }

        if (req.type == "post") {
            if (res.ok) {
                self.compose = [];
                self.set_status("Thanks for signing the guestbook!", SUCCESS);
                self.request_newer();
            } else {
                self.set_status(res.error, ERROR);
            }
            return;
        }

        if (req.type == "delete") {
            if (res.ok)
                self.remove_message(req.id);
            else
                self.set_status(res.error, ERROR);
            return;
        }

        if (req.type == "admin_info") {
            if (res.ok) {
                self.admin_info = res;
                self.admin_error = "";
            } else if (res.error == "not allowed") {
                self.is_admin = false;
                self.admin_info = nil;
                self.admin_error = "";
                if (self.screen == "admin")
                    self.leave_admin();
            } else {
                self.admin_info = nil;
                self.admin_error = res.error;
            }
            return;
        }

        if (req.type == "canvas_poll") {
            self.on_canvas_poll(res);
            return;
        }

        if (req.type == "canvas_tile") {
            self.on_canvas_tile(req, res);
            return;
        }

        if (req.type == "canvas_set") {
            // A change the server dropped is undone, unless painted over
            let idx = info.y * self.canvas_size + info.x;
            if (!res.ok && self.canvas.bytes.get_u32(idx) == info.color) {
                self.canvas.bytes.set_u32(idx, info.prev);
                self.view_dirty = true;
            }
            return;
        }

        if (req.type == "stats" && res.ok) {
            self.total_views = res.total_views;
            self.messages_today = res.has("messages_today") ? res.messages_today : nil;
            self.num_accounts = res.has("num_accounts") ? res.num_accounts : nil;
        }
    }

    // Switches to the guestbook screen and fetches the latest messages
    enter_main(self)
    {
        self.screen = "main";
        self.messages = [];
        self.msg_ids = {};
        self.scroll_y = 0;
        self.no_more_older = false;
        self.loading_older = false;
        self.set_status("", DIM);
        self.send({type: "get_messages", limit: PAGE_SIZE}, {mode: "latest"});
    }

    // Opens the admin page and requests a fresh snapshot
    enter_admin(self)
    {
        self.screen = "admin";
        self.drag_offset = nil;
        self.admin_info = nil;
        self.admin_error = "";
        self.dirty = true;
        self.send({type: "admin_info"}, nil);
    }

    // Returns to the guestbook without losing the message list or draft
    leave_admin(self)
    {
        self.screen = "main";
        self.dirty = true;
        self.request_newer();
    }

    // Asks for messages newer than the newest one we have
    request_newer(self)
    {
        if (self.messages.len == 0)
            self.send({type: "get_messages", limit: PAGE_SIZE}, {mode: "latest"});
        else
            self.send({type: "get_messages", after: self.messages[0].id, limit: PAGE_SIZE}, {mode: "newer"});
    }

    // Height of a message in the list, in pixels
    block_height(self, msg)
    {
        return CHAR_H + msg.lines.len * CHAR_H + 18;
    }

    // Total height of the message list
    content_height(self)
    {
        let var h = 8;

        for (let var i = 0; i < self.messages.len; ++i)
            h = h + self.block_height(self.messages[i]);

        return h + 2 * CHAR_H;
    }

    // Adds messages from the server to the list, keeping it sorted from
    // newest to oldest. If the user has scrolled down, the view is kept on
    // the same messages as new ones appear above.
    add_messages(self, new_msgs)
    {
        for (let var i = 0; i < new_msgs.len; ++i) {
            let m = new_msgs[i];
            let key = m.id.to_s();

            if (self.msg_ids.has(key))
                continue;

            let msg = {id: m.id, username: m.username, text: m.text, time: m.time, lines: wrap(m.text, MSG_COLS)};
            self.msg_ids[key] = true;

            let var pos = 0;
            while (pos < self.messages.len && self.messages[pos].id > m.id)
                pos = pos + 1;

            self.messages.insert(pos, msg);

            if (pos == 0 && self.scroll_y > 0 && self.messages.len > 1)
                self.scroll_y = self.scroll_y + self.block_height(msg);
        }

        self.dirty = true;
    }

    // Removes a message from the list, after the admin deleted it
    remove_message(self, id)
    {
        for (let var i = 0; i < self.messages.len; ++i) {
            if (self.messages[i].id == id) {
                self.messages.remove(i);
                break;
            }
        }

        self.dirty = true;
    }

    // Shows the canvas, which update() then keeps up to date
    enter_canvas(self)
    {
        self.screen = "canvas";
        self.drag_offset = nil;
        self.canvas_error = "";
        self.last_poll_ms = 0;
        self.dirty = true;
    }

    // Returns from the canvas to the guestbook
    leave_canvas(self)
    {
        self.screen = "main";
        self.pick_drag = nil;
        self.hover = nil;
        self.dirty = true;
        self.request_newer();
    }

    // Forgets the canvas requests that were lost with the connection, and
    // undoes the pixels painted that were not sent
    reset_canvas_requests(self)
    {
        self.canvas_polling = false;

        for (let var i = 0; i < self.tiles.len; ++i)
            self.tiles[i].requested = false;

        for (let var i = self.set_queue.len - 1; i >= 0; i = i - 1) {
            let set = self.set_queue[i];
            self.canvas.bytes.set_u32(set.y * self.canvas_size + set.x, set.prev);
        }

        self.set_queue = [];
        self.view_dirty = true;
    }

    // Asks the server for the pixels that changed since the last poll
    poll_canvas(self)
    {
        let req = {type: "canvas_poll"};

        if (self.canvas_epoch != nil) {
            req.epoch = self.canvas_epoch;
            req.since = self.canvas_seq;
        }

        if (self.send(req, nil)) {
            self.canvas_polling = true;
            self.last_poll_ms = $time_current_ms();
        }
    }

    // Creates our copy of the canvas, with every tile still to fetch, and
    // the view on its middle
    create_canvas(self, size, tile_size)
    {
        self.canvas = Image(size, size);
        self.canvas.clear(FIELD);
        self.canvas_size = size;
        self.tile_size = tile_size;
        self.canvas_epoch = nil;
        self.set_queue = [];

        self.tiles = [];
        let per_row = size.idiv(tile_size);
        for (let var i = 0; i < per_row * per_row; ++i)
            self.tiles.push({have: -1, requested: false});

        self.zoom = DEFAULT_ZOOM;
        self.view_x = (size - self.visible()).idiv(2);
        self.view_y = self.view_x;
        self.clamp_view();
    }

    // Handles the response to a poll: either the pixels that changed, or,
    // when the server can't tell which did, the change counter of each tile
    on_canvas_poll(self, res)
    {
        self.canvas_polling = false;

        if (!res.ok) {
            // Servers older than the canvas don't know the request
            self.canvas_error = res.error == "unknown request type" ? "no canvas here" : res.error;
            return;
        }

        if (self.canvas == nil || self.canvas_size != res.size || self.tile_size != res.tile_size)
            self.create_canvas(res.size, res.tile_size);

        if (res.has("tiles")) {
            // After a server restart, any tile may have changed
            let restarted = self.canvas_epoch != res.epoch;

            for (let var i = 0; i < self.tiles.len && i < res.tiles.len; ++i) {
                if (restarted || self.tiles[i].have != res.tiles[i])
                    self.tiles[i].have = -1;
            }
        } else {
            let pixels = res.pixels;

            for (let var i = 0; i + 2 < pixels.len; i = i + 3) {
                if (pixels[i] < self.canvas_size && pixels[i + 1] < self.canvas_size)
                    self.canvas.set_pixel(pixels[i], pixels[i + 1], rgb(0, 0, 0) | pixels[i + 2]);
            }

            if (pixels.len > 0)
                self.view_dirty = true;
        }

        self.canvas_epoch = res.epoch;
        self.canvas_seq = res.seq;
        self.request_tiles();
    }

    // Requests the tiles that have to be fetched, nearest to the middle of
    // the view first
    request_tiles(self)
    {
        let per_row = self.canvas_size.idiv(self.tile_size);
        let mid_x = self.view_x + self.visible().idiv(2);
        let mid_y = self.view_y + self.visible().idiv(2);

        // Distance from the middle of a tile to the middle of the view
        let dists = [];
        for (let var i = 0; i < self.tiles.len; ++i) {
            let dx = (i % per_row) * self.tile_size + self.tile_size.idiv(2) - mid_x;
            let dy = i.idiv(per_row) * self.tile_size + self.tile_size.idiv(2) - mid_y;
            dists.push(dx * dx + dy * dy);
        }

        loop {
            let var best = nil;

            for (let var i = 0; i < self.tiles.len; ++i) {
                let tile = self.tiles[i];
                if (tile.have == -1 && !tile.requested && (best == nil || dists[i] < dists[best]))
                    best = i;
            }

            if (best == nil || !self.send({type: "canvas_tile", tx: best % per_row, ty: best.idiv(per_row)}, nil))
                break;

            self.tiles[best].requested = true;
        }
    }

    // Handles the response to a tile request, whose data is a TGA file
    on_canvas_tile(self, req, res)
    {
        let per_row = self.canvas_size.idiv(self.tile_size);
        let tile = self.tiles[req.ty * per_row + req.tx];
        tile.requested = false;

        if (!res.ok || !res.has("data"))
            return;

        let img = decode_tga(res.data);

        if (img == nil || img.width != self.tile_size || img.height != self.tile_size)
            return;

        self.canvas.blit(img, req.tx * self.tile_size, req.ty * self.tile_size);
        tile.have = res.seq;
        self.view_dirty = true;
    }

    // Number of canvas pixels across the view at the current zoom
    visible(self)
    {
        return VIEW_SIZE.idiv(ZOOMS[self.zoom]);
    }

    // Keeps the view within the canvas
    clamp_view(self)
    {
        let max_pos = (self.canvas_size - self.visible()).max(0);
        self.view_x = self.view_x.clip(0, max_pos);
        self.view_y = self.view_y.clip(0, max_pos);
        self.view_dirty = true;
        self.dirty = true;
    }

    // Moves the view by a number of steps, each the same distance on screen
    // at every zoom: one canvas pixel at the starting zoom
    pan(self, dx, dy)
    {
        let step = self.visible().idiv(64).max(1);
        self.view_x = self.view_x + dx * step;
        self.view_y = self.view_y + dy * step;
        self.clamp_view();
    }

    // Zooms in or out by a number of levels, around the middle of the view
    zoom_by(self, levels)
    {
        if (self.canvas == nil)
            return;

        let mid_x = self.view_x + self.visible().idiv(2);
        let mid_y = self.view_y + self.visible().idiv(2);
        self.zoom = (self.zoom + levels).clip(0, ZOOMS.len - 1);
        self.view_x = mid_x - self.visible().idiv(2);
        self.view_y = mid_y - self.visible().idiv(2);
        self.hover = nil;
        self.clamp_view();
    }

    // Canvas pixel at a position in the frame, or nil outside of the view
    // or of the canvas
    pixel_at(self, x, y)
    {
        if (self.canvas == nil || x < VIEW_X || y < VIEW_Y || x >= VIEW_X + VIEW_SIZE || y >= VIEW_Y + VIEW_SIZE)
            return nil;

        let cell = ZOOMS[self.zoom];
        let px = self.view_x + (x - VIEW_X).idiv(cell);
        let py = self.view_y + (y - VIEW_Y).idiv(cell);

        if (px >= self.canvas_size || py >= self.canvas_size)
            return nil;

        return {x: px, y: py};
    }

    // Paints a canvas pixel with the current color. It shows right away,
    // and is sent to the server from update(), a few per second at most.
    paint(self, x, y)
    {
        let per_row = self.canvas_size.idiv(self.tile_size);
        let tile = self.tiles[y.idiv(self.tile_size) * per_row + x.idiv(self.tile_size)];
        let idx = y * self.canvas_size + x;
        let prev = self.canvas.bytes.get_u32(idx);

        if (self.zoom < MIN_DRAW_ZOOM || self.conn != "connected" || tile.have == -1)
            return;

        if (prev == self.color || self.set_queue.len >= MAX_QUEUED_SETS)
            return;

        self.canvas.bytes.set_u32(idx, self.color);
        self.set_queue.push({x: x, y: y, color: self.color, prev: prev});
        self.view_dirty = true;
    }

    // Picks a color of the palette to paint with
    set_color(self, color)
    {
        self.color = color;
        self.custom_selected = false;
        self.dirty = true;
    }

    // Picks the custom color to paint with
    select_custom(self)
    {
        self.color = self.custom;
        self.custom_selected = true;
        self.dirty = true;
    }

    // Changes the custom color with the mouse in the part of the color
    // picker being dragged, the square of saturations and values or the bar
    // of hues, and picks it to paint with
    pick(self, x, y)
    {
        let fx = ((x - SIDE_X).to_f() / (SIDE_W - 1)).max(0.0).min(1.0);

        if (self.pick_drag == "hue") {
            self.hsv.h = fx * 359.9;
        } else {
            self.hsv.s = fx;
            self.hsv.v = 1.0 - ((y - PICK_Y).to_f() / (PICK_H - 1)).max(0.0).min(1.0);
        }

        self.custom = hsv_to_rgb(self.hsv.h, self.hsv.s, self.hsv.v);
        self.select_custom();
    }

    // Handles a click on the canvas screen that isn't on a button
    canvas_mouse_down(self, x, y)
    {
        let pixel = self.pixel_at(x, y);

        if (pixel != nil) {
            self.paint(pixel.x, pixel.y);
            return;
        }

        if (x < SIDE_X || x >= SIDE_X + SIDE_W)
            return;

        if (y >= PICK_Y && y < PICK_Y + PICK_H)
            self.pick_drag = "sv";
        else if (y >= HUE_Y && y < HUE_Y + HUE_H)
            self.pick_drag = "hue";
        else
            return;

        self.pick(x, y);
    }

    // Validates the form and sends the requested login or register request
    submit_login(self, type)
    {
        let username = join(self.fields[0]);
        let password = join(self.fields[1]);

        if (!valid_username(username)) {
            self.set_modal_status("Usernames are 2 to 16 letters, digits or _", ERROR);
            return;
        }

        if (password.len == 0) {
            self.set_modal_status("Please enter a password", ERROR);
            return;
        }

        if (type == "register") {
            if (num_chars(password) < MIN_PASS_LEN) {
                self.set_modal_status("Please use at least " + MIN_PASS_LEN.to_s() + " characters for your password", ERROR);
                return;
            }

            if (join(self.fields[2]) != password) {
                self.set_modal_status("The passwords don't match", ERROR);
                return;
            }
        }

        if (!self.send({type: type, username: username, hash: password_hash(password)}, nil)) {
            self.set_modal_status("Not connected to the server, please try again", ERROR);
            return;
        }

        self.set_modal_status(type == "login" ? "Logging in..." : "Creating your account...", DIM);
    }

    // Sends the message being written. Guests are asked to register or log
    // in first, and the message is sent once they have.
    submit_post(self)
    {
        let text = join(self.compose).trim();

        if (num_chars(text) < 3) {
            self.set_status("Your message is a bit short", ERROR);
            return;
        }

        if (self.username == nil) {
            self.open_modal(true);
            return;
        }

        if (!self.send({type: "post", text: text}, nil)) {
            self.set_status("Not connected to the server, reconnecting...", ERROR);
            return;
        }

        self.set_status("Sending...", DIM);
    }

    // Logs out, reconnecting so that the server forgets the session. The
    // guestbook stays open, as a guest.
    log_out(self)
    {
        self.auth = nil;
        self.username = nil;
        self.is_admin = false;
        self.admin_info = nil;
        self.admin_error = "";
        self.deleting = nil;
        self.fields = [[], [], []];
        self.focus = 0;
        self.set_status("", DIM);
        self.disconnect();
        self.connect();
    }

    // Scrolls the message list, staying within bounds
    scroll_to(self, y)
    {
        let max_scroll = (self.content_height() - self.panel.height).max(0);
        self.scroll_y = y.clip(0, max_scroll);
        self.dirty = true;
    }

    // Geometry of the scrollbar, in frame coordinates
    scrollbar(self)
    {
        let track_h = self.panel.height;
        let content_h = self.content_height();
        let thumb_h = (track_h * track_h).idiv(content_h.max(track_h)).max(24);
        let max_scroll = (content_h - track_h).max(0);
        let thumb_y = max_scroll == 0 ? 0 : ((track_h - thumb_h) * self.scroll_y).idiv(max_scroll);

        return {
            x: MARGIN + self.panel.width - SCROLLBAR_W,
            y: PANEL_Y,
            h: track_h,
            thumb_y: PANEL_Y + thumb_y,
            thumb_h: thumb_h,
            max_scroll: max_scroll,
        };
    }

    // Handles a UI event
    handle_ui(self, ev)
    {
        self.dirty = true;

        if (self.screen == "intro") {
            if ((ev.kind == "KEY_DOWN" && ev.key != "F12") || ev.kind == "MOUSE_DOWN")
                self.enter_main();
            return;
        }

        if (ev.kind == "MOUSE_DOWN" && ev.button == "LEFT") {
            self.mouse_down(ev.x, ev.y);
            return;
        }

        if (ev.kind == "MOUSE_UP") {
            self.drag_offset = nil;
            self.pick_drag = nil;
            return;
        }

        if (ev.kind == "MOUSE_MOVE") {
            if (self.screen == "canvas") {
                self.hover = self.pixel_at(ev.x, ev.y);
                if (self.pick_drag != nil)
                    self.pick(ev.x, ev.y);
            } else if (self.drag_offset != nil) {
                let bar = self.scrollbar();
                let span = (bar.h - bar.thumb_h).max(1);
                self.scroll_to(((ev.y - self.drag_offset - bar.y) * bar.max_scroll).idiv(span));
            }
            return;
        }

        if (ev.kind == "TEXT_INPUT") {
            self.text_input(ev.text);
            return;
        }

        if (ev.kind == "KEY_DOWN")
            self.key_down(ev.key);
    }

    // Handles a left click: on the scrollbar, or on a button
    mouse_down(self, x, y)
    {
        // With the login box open, only its own buttons are registered
        if (self.screen == "main" && !self.modal) {
            let bar = self.scrollbar();

            if (x >= bar.x && x < bar.x + SCROLLBAR_W && y >= bar.y && y < bar.y + bar.h) {
                if (y >= bar.thumb_y && y < bar.thumb_y + bar.thumb_h)
                    self.drag_offset = y - bar.thumb_y;
                else if (y < bar.thumb_y)
                    self.scroll_to(self.scroll_y - self.panel.height);
                else
                    self.scroll_to(self.scroll_y + self.panel.height);
                return;
            }
        }

        for (let var i = 0; i < self.buttons.len; ++i) {
            let b = self.buttons[i];

            if (x >= b.x && x < b.x + b.w && y >= b.y && y < b.y + b.h) {
                self.click(b.action, b.arg);
                return;
            }
        }

        if (self.screen == "canvas")
            self.canvas_mouse_down(x, y);
    }

    // Switches to the view of a tab
    show_screen(self, screen)
    {
        if (screen == self.screen)
            return;

        if (screen == "canvas")
            self.enter_canvas();
        else if (self.screen == "admin")
            self.leave_admin();
        else
            self.leave_canvas();
    }

    // Performs the action of a clicked button
    click(self, action, arg)
    {
        if (action == "focus") {
            self.focus = arg;
        } else if (action == "submit") {
            self.submit_login(arg);
        } else if (action == "send") {
            self.submit_post();
        } else if (action == "logout") {
            self.log_out();
        } else if (action == "screen") {
            self.show_screen(arg);
        } else if (action == "color") {
            self.set_color(arg);
        } else if (action == "custom") {
            self.select_custom();
        } else if (action == "zoom") {
            self.zoom_by(arg);
        } else if (action == "open_modal") {
            self.open_modal(false);
        } else if (action == "close_modal") {
            self.close_modal();
        } else if (action == "start_delete") {
            self.deleting = arg;
        } else if (action == "cancel_delete") {
            self.deleting = nil;
        } else if (action == "delete") {
            self.send({type: "delete", id: arg.id, mod_tag: arg.tag}, nil);
            self.deleting = nil;
        }
    }

    // Handles typed text, for the focused field
    text_input(self, text)
    {
        let cs = chars(text);

        for (let var i = 0; i < cs.len; ++i) {
            let ch = cs[i];

            if (self.modal) {
                let field = self.fields[self.focus];

                if (self.focus == 0) {
                    if (field.len < MAX_NAME_LEN && ch.len == 1 && is_name_byte(ch.byte_at(0)))
                        field.push(ch);
                } else if (field.len < MAX_PASS_LEN) {
                    field.push(ch);
                }
            } else if (self.screen == "main" && self.compose.len < MAX_MSG_LEN) {
                self.compose.push(ch);
            } else if (self.screen == "canvas") {
                if (ch == "+" || ch == "=")
                    self.zoom_by(1);
                else if (ch == "-" || ch == "_")
                    self.zoom_by(-1);
            }
        }
    }

    // Handles special keys
    key_down(self, key)
    {
        // The tabs' keys work on every screen, unless the login box is open
        for (let var i = 0; i < TABS.len && !self.modal; ++i) {
            if (key == TABS[i].key) {
                self.show_screen(TABS[i].screen);
                return;
            }
        }

        if (self.screen == "admin")
            return;

        if (self.screen == "canvas") {
            if (key == "LEFT")
                self.pan(-1, 0);
            else if (key == "RIGHT")
                self.pan(1, 0);
            else if (key == "UP")
                self.pan(0, -1);
            else if (key == "DOWN")
                self.pan(0, 1);
            return;
        }

        if (self.modal) {
            if (key == "ESCAPE")
                self.close_modal();
            else if (key == "TAB")
                self.focus = (self.focus + 1) % 3;
            else if (key == "RETURN")
                self.submit_login(self.focus == 2 ? "register" : "login");
            else if (key == "BACKSPACE" && self.fields[self.focus].len > 0)
                self.fields[self.focus].pop();
            return;
        }

        if (self.screen == "main") {
            if (key == "F12" && self.is_admin)
                self.enter_admin();
            else if (key == "ESCAPE")
                self.deleting = nil;
            else if (key == "RETURN")
                self.submit_post();
            else if (key == "BACKSPACE" && self.compose.len > 0)
                self.compose.pop();
            else if (key == "UP")
                self.scroll_to(self.scroll_y - 2 * CHAR_H);
            else if (key == "DOWN")
                self.scroll_to(self.scroll_y + 2 * CHAR_H);
        }
    }

    // Tests if the screen is animating and must be redrawn on every frame
    animating(self)
    {
        return self.screen == "intro";
    }

    // Updates state that depends on time: the end of the intro, the cursor
    // blink, and fetching older messages near the bottom of the list
    update(self)
    {
        let now = $time_current_ms();

        if (self.screen == "intro" && now - self.start_ms >= INTRO_END_MS)
            self.enter_main();

        let cursor_on = (now.idiv(500) % 2) == 0;
        if (cursor_on != self.cursor_on) {
            self.cursor_on = cursor_on;
            self.dirty = true;
        }

        if (self.screen == "canvas" && self.conn == "connected") {
            if (!self.canvas_polling && self.canvas_error == "" && now - self.last_poll_ms >= CANVAS_POLL_MS)
                self.poll_canvas();

            // Send the next painted pixel
            if (self.set_queue.len > 0 && now - self.last_set_ms >= SET_INTERVAL_MS) {
                let set = self.set_queue.remove(0);
                self.send({type: "canvas_set", x: set.x, y: set.y, color: set.color & 0xFF_FF_FF}, set);
                self.last_set_ms = now;
            }
        }

        if (self.screen == "main" && !self.loading_older && !self.no_more_older && self.messages.len > 0) {
            let remaining = self.content_height() - self.scroll_y - self.panel.height;

            if (remaining < 200) {
                let oldest = self.messages[self.messages.len - 1].id;

                if (self.send({type: "get_messages", before: oldest, limit: PAGE_SIZE}, {mode: "older"}))
                    self.loading_older = true;
            }
        }
    }

    // Tests if the frame needs to be drawn again
    needs_redraw(self)
    {
        return self.dirty || self.animating();
    }

    // Draws the current screen into the frame
    render(self)
    {
        self.buttons = [];
        self.frame.clear(BG);

        if (self.screen == "intro")
            self.render_intro();
        else if (self.screen == "admin")
            self.render_admin();
        else if (self.screen == "canvas")
            self.render_canvas();
        else
            self.render_main();

        if (self.screen != "intro")
            self.render_footer();

        if (self.modal && self.screen == "main")
            self.render_modal();

        self.dirty = false;
    }

    // Draws the intro: the letters of the logo appear one by one, stripe by
    // stripe, then the teddy bear, then its sunglasses drop into place
    render_intro(self)
    {
        let t = $time_current_ms() - self.start_ms;
        let stripes = [];

        for (let var i = 0; i < LOGO_LETTERS.len; ++i) {
            let letter_t = t - (LETTER_START_MS + i * LETTER_EVERY_MS);
            stripes.push(letter_t < 0 ? 0 : (letter_t.idiv(STRIPE_MS) + 1).min(NUM_STRIPES));
        }

        // The sunglasses fall quickly, then slow down as they land
        let var shades_y = nil;
        if (t >= SHADES_MS) {
            let p = ((t - SHADES_MS).to_f() / SHADES_DROP_MS).min(1.0);
            shades_y = -SHADES_DROP * (1.0 - p) * (1.0 - p);
        }

        let x = (WIDTH - logo_width(BIG_LOGO)).idiv(2);
        draw_logo(self.frame, x, INTRO_LOGO_Y, BIG_LOGO, stripes, t >= BEAR_MS, shades_y);

        if (t >= TAGLINE_MS)
            self.centered(INTRO_LOGO_Y + logo_height(BIG_LOGO) + 40, "guestbook", DIM);
    }

    // Draws a text field with its label
    field(self, x, y, w, label, value, index)
    {
        let h = 38;
        let focused = self.focus == index;

        self.text(self.frame, x, y, label, DIM, BG);
        let box_y = y + CHAR_H + 4;

        self.frame.fill_rect(x, box_y, w, h, FIELD);
        draw_rect(self.frame, x, box_y, w, h, focused ? FOCUS : BORDER);

        // Show the end of the value if it doesn't fit
        let max_chars = (w - 2 * TEXT_PAD).idiv(CHAR_W) - 1;
        let start = (value.len - max_chars).max(0);
        let shown = join(value.slice(start, value.len));
        let text_y = box_y + (h - CHAR_H).idiv(2);

        let placeholder = index == 0 && value.len == 0;
        if (placeholder)
            self.text(self.frame, x + TEXT_PAD, text_y, "choose a username", PLACEHOLDER, FIELD);
        else
            self.text(self.frame, x + TEXT_PAD, text_y, shown, TEXT, FIELD);

        if (focused && self.cursor_on) {
            let cursor_x = x + TEXT_PAD + num_chars(shown) * CHAR_W;
            if (placeholder)
                self.frame.fill_rect(cursor_x, text_y + CHAR_H - 4, CHAR_W, 2, FOCUS);
            else
                self.text(self.frame, cursor_x, text_y, "＿", FOCUS, FIELD);
        }

        self.buttons.push({x: x, y: box_y, w: w, h: h, action: "focus", arg: index});
    }

    // Draws a button and registers it for clicks
    button(self, x, y, w, h, label, color, action, arg)
    {
        self.frame.fill_rect(x, y, w, h, color);
        let tx = x + (w - num_chars(label) * CHAR_W).idiv(2);
        let text_color = color == PRIMARY_BUTTON ? BG : BUTTON_TEXT;
        self.text(self.frame, tx, y + (h - CHAR_H).idiv(2), label, text_color, color);
        self.buttons.push({x: x, y: y, w: w, h: h, action: action, arg: arg});
    }

    // Draws the box to register or log in, outlined, over the guestbook
    render_modal(self)
    {
        let frame = self.frame;
        let mx = (WIDTH - MODAL_W).idiv(2);
        let my = (HEIGHT - MODAL_H).idiv(2);

        // Only the box's own buttons can be clicked while it is open
        self.buttons = [];

        // A margin sets the outline apart from the messages behind
        frame.fill_rect(mx - 8, my - 8, MODAL_W + 16, MODAL_H + 16, BG);
        draw_rect(frame, mx, my, MODAL_W, MODAL_H, FOCUS);
        draw_rect(frame, mx + 1, my + 1, MODAL_W - 2, MODAL_H - 2, FOCUS);

        self.button(mx + MODAL_W - 40, my + 12, 28, 28, "x", FIELD, "close_modal", nil);

        let w = 360;
        let x = (WIDTH - w).idiv(2);
        let bw = 170;

        // Passwords are shown as stars
        fun stars(field) {
            let out = [];
            for (let var i = 0; i < field.len; ++i)
                out.push("*");
            return out;
        }

        let heading = self.post_after_auth ? "Register or log in to post your message" : "Create your new user account or sign in";
        self.centered(my + 24, heading, REGISTER_HEADING);
        self.field(x, my + 70, w, "Username", self.fields[0], 0);
        self.field(x, my + 144, w, "Password", stars(self.fields[1]), 1);
        self.field(x, my + 218, w, "Confirm (register only)", stars(self.fields[2]), 2);
        self.button(x, my + 302, bw, 40, "Register", PRIMARY_BUTTON, "submit", "register");
        self.button(x + w - bw, my + 302, bw, 40, "Log in", LOGIN_BUTTON, "submit", "login");
        self.centered(my + 356, self.modal_status, self.modal_status_color);
        self.centered(my + 392, "Enter logs in; in Confirm, Enter registers", DIM);
    }

    // Draws the admin page with the latest server snapshot
    render_admin(self)
    {
        let frame = self.frame;
        let panel_y = 72;
        let panel_w = WIDTH - 2 * MARGIN;
        let panel_h = FOOTER_Y - 8 - panel_y;
        let x = MARGIN + 24;
        let value_x = MARGIN + 310;

        draw_full_logo(frame, MARGIN, 14, SMALL_LOGO);
        self.text(frame, MARGIN + logo_width(SMALL_LOGO) + 12, 17, "admin", DIM, BG);

        frame.fill_rect(MARGIN, panel_y, panel_w, panel_h, PANEL);
        draw_rect(frame, MARGIN, panel_y, panel_w, panel_h, BORDER);

        if (self.conn != "connected") {
            self.text(frame, x, 100, "Connection lost, reconnecting...", ERROR, PANEL);
            return;
        }

        if (self.admin_info == nil) {
            let msg = self.admin_error == "" ? "Loading admin info..." : self.admin_error;
            self.text(frame, x, 100, msg, self.admin_error == "" ? DIM : ERROR, PANEL);
            return;
        }

        let info = self.admin_info;
        self.text(frame, x, 100, "Process uptime:", DIM, PANEL);
        self.text(frame, value_x, 100, info.uptime, TEXT, PANEL);
        self.text(frame, x, 144, "Unique IPs:", DIM, PANEL);
        self.text(frame, value_x, 144, info.unique_ips.comma_sep(), TEXT, PANEL);
        self.text(frame, x, 188, "Total user accounts:", DIM, PANEL);
        self.text(frame, value_x, 188, info.num_accounts.comma_sep(), TEXT, PANEL);
        self.text(frame, x, 232, "Filtered messages:", DIM, PANEL);
        let filtered = info.has("num_filtered") ? info.num_filtered.comma_sep() : "n/a";
        self.text(frame, value_x, 232, filtered, TEXT, PANEL);

        frame.fill_rect(x, 290, panel_w - 48, 1, FIELD);
        self.text(frame, x, 312, "Last 10 user accounts", TEXT, PANEL);

        for (let var i = 0; i < info.users.len; ++i) {
            let y = 354 + i * 34;
            self.text(frame, x, y, (i + 1).to_s() + ".", DIM, PANEL);
            self.text(frame, x + 4 * CHAR_W, y, info.users[i], name_color(info.users[i]), PANEL);
        }
    }

    // Draws the tabs at the bottom of the screen, one per view, each in its
    // own rainbow color: as the background of the tab of the current view,
    // and as the text color of the others
    render_footer(self)
    {
        let var x = MARGIN;

        for (let var i = 0; i < TABS.len; ++i) {
            let tab = TABS[i];
            let label = tab.key + " " + tab.label;
            let w = (num_chars(label) + 2) * CHAR_W;
            let active = tab.screen == self.screen;
            let bg = active ? RAINBOW[i] : FIELD;

            self.frame.fill_rect(x, FOOTER_Y, w, FOOTER_H, bg);
            self.text(self.frame, x + CHAR_W, FOOTER_Y + (FOOTER_H - CHAR_H).idiv(2), label, active ? BG : RAINBOW[i], bg);
            self.buttons.push({x: x, y: FOOTER_Y, w: w, h: FOOTER_H, action: "screen", arg: tab.screen});
            x = x + w + 8;
        }
    }

    // Draws the part of the canvas in view into the view image, each canvas
    // pixel as a square of the zoom's size
    render_view(self)
    {
        let cell = ZOOMS[self.zoom];
        let size = self.canvas_size;
        let num = self.visible().min(size - self.view_x).min(size - self.view_y);
        let src = self.canvas.bytes;
        let dst = self.view_img.bytes;

        self.view_img.clear(BG);

        for (let var y = 0; y < num; ++y) {
            let src_row = (self.view_y + y) * size + self.view_x;
            let dst_row = y * cell * VIEW_SIZE;

            if (cell == 1) {
                dst.memcpy(dst_row * 4, src, src_row * 4, num * 4);
                continue;
            }

            // Draw the top line of the row of squares, then copy it down
            for (let var x = 0; x < num; ++x)
                dst.fill_u32(dst_row + x * cell, cell, src.get_u32(src_row + x));

            for (let var k = 1; k < cell; ++k)
                dst.memcpy((dst_row + k * VIEW_SIZE) * 4, dst, dst_row * 4, num * cell * 4);
        }

        self.view_dirty = false;
    }

    // Draws the square of saturations and values for the current hue
    render_sv(self)
    {
        let cols = SIDE_W.idiv(PICK_BLOCK);
        let rows = PICK_H.idiv(PICK_BLOCK);

        for (let var j = 0; j < rows; ++j) {
            for (let var i = 0; i < cols; ++i) {
                let color = hsv_to_rgb(self.hsv.h, i.to_f() / (cols - 1), 1.0 - j.to_f() / (rows - 1));
                self.sv_img.fill_rect(i * PICK_BLOCK, j * PICK_BLOCK, PICK_BLOCK, PICK_BLOCK, color);
            }
        }

        self.sv_hue = self.hsv.h;
    }

    // Draws a marker around a point, visible on any color
    marker(self, x, y, w, h)
    {
        draw_rect(self.frame, x - 1, y - 1, w + 2, h + 2, rgb(0, 0, 0));
        draw_rect(self.frame, x - 2, y - 2, w + 4, h + 4, rgb(255, 255, 255));
    }

    // Draws the canvas screen: the view of the canvas, and on its right
    // the colors, the color picker and the zoom
    render_canvas(self)
    {
        let frame = self.frame;

        draw_full_logo(frame, MARGIN, 14, SMALL_LOGO);
        self.text(frame, MARGIN + logo_width(SMALL_LOGO) + 12, 17, "canvas", DIM, BG);

        // What is in the way of drawing, if anything
        let var status = "";
        let var loading = self.canvas == nil;
        for (let var i = 0; i < self.tiles.len; ++i)
            loading = loading || self.tiles[i].have == -1;

        if (self.conn != "connected")
            status = self.total_views == nil ? "connecting..." : "reconnecting...";
        else if (self.canvas_error != "")
            status = self.canvas_error;
        else if (loading)
            status = "loading...";
        else if (self.zoom < MIN_DRAW_ZOOM)
            status = "zoom in to draw";

        if (self.canvas == nil) {
            frame.fill_rect(VIEW_X, VIEW_Y, VIEW_SIZE, VIEW_SIZE, FIELD);
        } else {
            if (self.view_dirty)
                self.render_view();
            frame.blit(self.view_img, VIEW_X, VIEW_Y);
        }

        // Sets a dark canvas apart from the background
        draw_rect(frame, VIEW_X - 1, VIEW_Y - 1, VIEW_SIZE + 2, VIEW_SIZE + 2, BORDER);

        // The pixel under the mouse, in the color it would be painted
        let cell = ZOOMS[self.zoom];
        if (self.hover != nil && self.zoom >= MIN_DRAW_ZOOM) {
            let hx = VIEW_X + (self.hover.x - self.view_x) * cell;
            let hy = VIEW_Y + (self.hover.y - self.view_y) * cell;
            frame.fill_rect(hx, hy, cell, cell, self.color);
            self.marker(hx, hy, cell, cell);
        }

        // Colors to pick from
        for (let var i = 0; i < PALETTE.len; ++i) {
            let x = SIDE_X + (i % 4) * (SWATCH + SWATCH_GAP);
            let y = VIEW_Y + i.idiv(4) * (SWATCH + SWATCH_GAP);
            frame.fill_rect(x, y, SWATCH, SWATCH, PALETTE[i]);
            self.buttons.push({x: x, y: y, w: SWATCH, h: SWATCH, action: "color", arg: PALETTE[i]});

            if (!self.custom_selected && PALETTE[i] == self.color)
                self.marker(x, y, SWATCH, SWATCH);
        }

        // Color picker, with markers on the custom color
        if (self.sv_hue != self.hsv.h)
            self.render_sv();
        frame.blit(self.sv_img, SIDE_X, PICK_Y);
        frame.blit(self.hue_img, SIDE_X, HUE_Y);

        let sx = SIDE_X + (self.hsv.s * (SIDE_W - 1)).floor();
        let sy = PICK_Y + ((1.0 - self.hsv.v) * (PICK_H - 1)).floor();
        self.marker(sx - 3, sy - 3, 6, 6);
        let hue_x = SIDE_X + (self.hsv.h / 360.0 * (SIDE_W - 1)).floor();
        self.marker(hue_x - 2, HUE_Y, 4, HUE_H);

        // Custom color, which can be clicked like the palette's, and its
        // hex code
        let var y = HUE_Y + HUE_H + 16;
        frame.fill_rect(SIDE_X, y, SWATCH, 40, self.custom);
        self.buttons.push({x: SIDE_X, y: y, w: SWATCH, h: 40, action: "custom", arg: nil});

        if (self.custom_selected)
            self.marker(SIDE_X, y, SWATCH, 40);
        else
            draw_rect(frame, SIDE_X, y, SWATCH, 40, BORDER);

        let hex = "#" + (self.custom & 0xFF_FF_FF).to_hex(6).upper();
        self.text(frame, SIDE_X + SWATCH + 12, y + 8, hex, TEXT, BG);

        // Zoom, with buttons for the mouse
        y = y + 60;
        self.text(frame, SIDE_X, y, "zoom " + cell.to_s() + "x", TEXT, BG);
        self.button(SIDE_X + SIDE_W - 76, y - 2, 34, 28, "-", FIELD, "zoom", -1);
        self.button(SIDE_X + SIDE_W - 34, y - 2, 34, 28, "+", FIELD, "zoom", 1);

        // Position of the pixel under the mouse, or of the middle of the view
        y = y + 40;
        if (self.hover != nil)
            self.text(frame, SIDE_X, y, self.hover.x.to_s() + ", " + self.hover.y.to_s(), TEXT, BG);
        else if (self.canvas != nil)
            self.text(frame, SIDE_X, y, (self.view_x + self.visible().idiv(2)).to_s() + ", " + (self.view_y + self.visible().idiv(2)).to_s(), DIM, BG);

        self.text(frame, SIDE_X, y + 32, "arrows  move", DIM, BG);
        self.text(frame, SIDE_X, y + 58, "+ and -  zoom", DIM, BG);
        self.text(frame, SIDE_X, y + 90, status,self.conn == "connected" && self.canvas_error == "" ? DIM : ERROR, BG);
    }

    // Draws the guestbook screen: a header, the box to write a message,
    // and the list of messages
    render_main(self)
    {
        let frame = self.frame;

        // Header, with a small logo, the guestbook's stats and the user. The
        // stats that older servers don't send are left out.
        draw_full_logo(frame, MARGIN, 14, SMALL_LOGO);
        self.text(frame, MARGIN + logo_width(SMALL_LOGO) + 12, 17, "guestbook", DIM, BG);

        if (self.total_views != nil) {
            let var stats = self.total_views.comma_sep() + (self.total_views == 1 ? " view" : " views");
            if (self.messages_today != nil)
                stats = stats + ", " + self.messages_today.comma_sep() + (self.messages_today == 1 ? " message today" : " messages today");
            self.text(frame, WIDTH - MARGIN - num_chars(stats) * CHAR_W, 4, stats, DIM, BG);
        }

        // Guests get a button to register or log in instead of their name
        let var who_x = 0;
        if (self.username == nil) {
            let login_w = 18 * CHAR_W;
            who_x = WIDTH - MARGIN - login_w;
            self.button(who_x, 30, login_w, CHAR_H, "register / log in", LOGIN_BUTTON, "open_modal", nil);
        } else {
            let who = (self.is_admin ? "admin " : "") + self.username;
            let logout_w = 8 * CHAR_W;
            who_x = WIDTH - MARGIN - logout_w - 12 - num_chars(who) * CHAR_W;
            self.text(frame, who_x, 30, who, name_color(self.username), BG);
            self.button(WIDTH - MARGIN - logout_w, 30, logout_w, CHAR_H, "log out", FIELD, "logout", nil);
        }

        // Left out when a long username leaves no room next to the title
        if (self.num_accounts != nil) {
            let accounts = self.num_accounts.comma_sep() + (self.num_accounts == 1 ? " account" : " accounts");
            let accounts_x = who_x - 24 - num_chars(accounts) * CHAR_W;
            let title_end = MARGIN + logo_width(SMALL_LOGO) + 12 + num_chars("guestbook") * CHAR_W;

            if (accounts_x >= title_end + 12)
                self.text(frame, accounts_x, 30, accounts, DIM, BG);
        }

        // Box to write a message, showing its last lines
        let box_w = WIDTH - 2 * MARGIN;
        let box_h = COMPOSE_LINES * CHAR_H + 2 * TEXT_PAD;
        frame.fill_rect(MARGIN, COMPOSE_Y, box_w, box_h, FIELD);
        draw_rect(frame, MARGIN, COMPOSE_Y, box_w, box_h, FOCUS);

        let tx = MARGIN + TEXT_PAD;
        let ty = COMPOSE_Y + TEXT_PAD;

        // The cursor moves to the login box while it is open
        let cursor_on = self.cursor_on && !self.modal;

        if (self.compose.len == 0) {
            self.text(frame, tx, ty, "Write a message and press Enter...", DIM, FIELD);
            if (cursor_on)
                self.frame.fill_rect(tx, ty + CHAR_H - 4, CHAR_W, 2, FOCUS);
        } else {
            let lines = wrap(join(self.compose), COMPOSE_COLS);
            let first = (lines.len - COMPOSE_LINES).max(0);

            for (let var i = first; i < lines.len; ++i)
                self.text(frame, tx, ty + (i - first) * CHAR_H, lines[i], TEXT, FIELD);

            if (cursor_on) {
                let last = lines[lines.len - 1];
                let cx = tx + num_chars(last) * CHAR_W;
                self.text(frame, cx.min(MARGIN + box_w - TEXT_PAD - CHAR_W), ty + (lines.len - 1 - first) * CHAR_H, "＿", FOCUS, FIELD);
            }
        }

        // Character count, status and send button
        let row_y = COMPOSE_Y + box_h + 10;
        let count = self.compose.len.to_s() + "/" + MAX_MSG_LEN.to_s();
        self.text(frame, MARGIN, row_y + 6, count, self.compose.len >= MAX_MSG_LEN ? ERROR : DIM, BG);
        let status_x = MARGIN + 10 * CHAR_W;
        if (self.conn == "connected")
            self.text(frame, status_x, row_y + 6, self.status, self.status_color, BG);
        else if (self.total_views != nil)
            self.text(frame, status_x, row_y + 6, "Connection lost, reconnecting...", ERROR, BG);
        else if (self.conn == "connecting")
            self.text(frame, status_x, row_y + 6, "Connecting to " + self.addr + "...", DIM, BG);
        else
            self.text(frame, status_x, row_y + 6, "Could not connect to " + self.addr + ", retrying...", ERROR, BG);

        self.button(WIDTH - MARGIN - 110, row_y, 110, 36, "Send", BUTTON, "send", nil);

        self.render_messages();
        frame.blit(self.panel, MARGIN, PANEL_Y);

        // Scrollbar
        let bar = self.scrollbar();
        frame.fill_rect(bar.x, bar.y, SCROLLBAR_W, bar.h, FIELD);
        frame.fill_rect(bar.x + 2, bar.thumb_y, SCROLLBAR_W - 4, bar.thumb_h, self.drag_offset != nil ? FOCUS : BORDER);
    }

    // Draws the visible messages into the panel image
    render_messages(self)
    {
        let panel = self.panel;
        panel.clear(PANEL);

        let text_w = panel.width - SCROLLBAR_W;
        let var y = 8 - self.scroll_y;

        for (let var i = 0; i < self.messages.len; ++i) {
            let msg = self.messages[i];
            let h = self.block_height(msg);

            if (y + h > 0 && y < panel.height) {
                self.text(panel, TEXT_PAD, y, msg.username, name_color(msg.username), PANEL);
                self.text(panel, TEXT_PAD + (num_chars(msg.username) + 2) * CHAR_W, y, time_ago(msg.time), DIM, PANEL);

                for (let var j = 0; j < msg.lines.len; ++j)
                    self.text(panel, TEXT_PAD, y + (j + 1) * CHAR_H, msg.lines[j], TEXT, PANEL);

                if (self.is_admin)
                    self.admin_buttons(msg, y, text_w);

                panel.fill_rect(TEXT_PAD, y + h - 9, text_w - 2 * TEXT_PAD, 1, FIELD);
            }

            y = y + h;
        }

        let var footer = "";
        if (self.messages.len == 0)
            footer = self.no_more_older ? "No messages yet, be the first to sign!" : "Loading messages...";
        else if (self.no_more_older)
            footer = "You've reached the first message";
        else
            footer = "Loading older messages...";

        if (y < panel.height)
            self.text(panel, (text_w - num_chars(footer) * CHAR_W).idiv(2), y + 8, footer, DIM, PANEL);
    }

    // Draws a small button in the message list, from its right edge at x.
    // Returns the x coordinate of its left edge.
    list_button(self, x, y, label, color, action, arg)
    {
        let w = (num_chars(label) + 1) * CHAR_W;
        let left = x - w;
        self.panel.fill_rect(left, y, w, CHAR_H, color);
        self.text(self.panel, left + CHAR_W.idiv(2), y, label, BUTTON_TEXT, color);

        // Only clickable where it's visible
        if (y >= 0 && y + CHAR_H <= self.panel.height)
            self.buttons.push({x: MARGIN + left, y: PANEL_Y + y, w: w, h: CHAR_H, action: action, arg: arg});

        return left;
    }

    // Draws the admin's delete button for a message. Once clicked, it is
    // replaced by a button for each category to delete the message as, and
    // one to cancel.
    admin_buttons(self, msg, y, text_w)
    {
        let var x = text_w - TEXT_PAD;

        if (self.deleting != msg.id) {
            self.list_button(x, y, "delete", DANGER, "start_delete", msg.id);
            return;
        }

        x = self.list_button(x, y, "cancel", CANCEL, "cancel_delete", nil) - 12;

        // Drawn from right to left, so that they read hate, spam, other
        let tags = ["other", "spam", "hate"];
        for (let var i = 0; i < tags.len; ++i)
            x = self.list_button(x, y, tags[i], DANGER, "delete", {id: msg.id, tag: tags[i]}) - 6;
    }
}

// Server address from the command line: --local or --localhost for a
// server on this machine, an address, or the default server
fun server_addr()
{
    let arg = $cmd_get_arg_or(1, DEFAULT_SERVER);
    return arg == "--local" || arg == "--localhost" ? LOCAL_SERVER : arg;
}

// Opens the window and runs the client until the window is closed
fun main()
{
    let app = App(server_addr());
    let window = $window_create(WIDTH, HEIGHT, "Plush Guestbook", 0);

    app.connect();

    // Wakes us up every few seconds to check for new messages
    $actor_spawn(|| {
        loop {
            $actor_sleep(POLL_MS);
            $actor_send($actor_parent(), "tick");
        }
    });

    loop {
        loop {
            let msg = $actor_poll();

            if (msg == nil)
                break;

            if (msg instanceof UIEvent && msg.kind == "CLOSE_WINDOW")
                $exit(0);

            app.handle(msg);
        }

        app.update();

        if (app.needs_redraw()) {
            app.render();
            $window_draw_frame(window, app.frame.bytes);
        }

        $actor_sleep(16);
    }
}

if ($MAIN_UNIT) {
    main();
}
