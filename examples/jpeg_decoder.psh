// Decode a JPEG file, measure how long it takes and show it in a window.
// Run: plush examples/jpeg_decoder.psh [path/to/image.jpg]
// The default image is an 800-pixel-high copy of Hokusai's Great Wave.
// Source: https://commons.wikimedia.org/wiki/File:Katsushika_Hokusai_-_Thirty-Six_Views_of_Mount_Fuji-_The_Great_Wave_Off_the_Coast_of_Kanagawa_-_Google_Art_Project.jpg

from args import ArgParser;
from jpeg import decode_jpeg;

// Number of times the image is decoded to measure the decoding time
let NUM_RUNS = 5;

// Load, time, and display one JPEG, keeping the window alive until closed.
fun main() {
    let args = ArgParser("Decode a JPEG file, time it and show it in a window")
        .pos_str("path", "examples/data/great_wave_800.jpg", "JPEG file to decode")
        .parse_args();
    let path = args.path;
    let data = $read_file(path);
    if (data == nil) {
        $println("Could not read JPEG: " + path);
        return;
    }

    // Decode several times and keep the median, as timings are noisy
    let times = [];
    let var img = nil;
    for (let var i = 0; i < NUM_RUNS; ++i) {
        let start = $time_current_ms();
        img = decode_jpeg(data);
        if (img == nil) {
            $println("Could not decode JPEG: " + path);
            return;
        }

        // Insert the time so that the array stays sorted
        let elapsed = $time_current_ms() - start;
        let var idx = 0;
        while (idx < times.len && times[idx] < elapsed) {
            ++idx;
        }
        times.insert(idx, elapsed);
    }

    let median = times[NUM_RUNS.idiv(2)];
    let megapixels = img.width * img.height / 1000000.0;
    $println("Decoded " + img.width.to_s() + " x " + img.height.to_s() +
             " JPEG in " + median.to_s() + " ms (" +
             (megapixels * 1000 / median.max(1)).format_decimals(1) + " megapixels/s)");

    let window = $window_create(img.width, img.height, "JPEG decoder: " + path, 0);
    $window_draw_frame(window, img.bytes);

    loop {
        let event = $actor_recv();
        if (event instanceof UIEvent &&
            (event.kind == "CLOSE_WINDOW" ||
             (event.kind == "KEY_DOWN" && event.key == "ESCAPE"))) {
            break;
        }
    }
}

main();
