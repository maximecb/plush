from args import ArgParser;
from wav import load_wav;

fun main()
{
    let args = ArgParser("Play a WAV file")
        .pos_str("path", "examples/data/sample_nono.wav", "WAV file to play")
        .parse_args();

    let snd = load_wav(args.path);
    if (snd == nil) {
        $println("Error: could not read WAV file, or format not supported");
        return;
    }

    let dev = $audio_open_output(snd.sample_rate, snd.num_channels);
    if (dev == nil) {
        $println("Error: could not open audio device");
        return;
    }

    $println("Playing audio...");
    $audio_write_samples(dev, snd.samples);

    // Wait for the audio to finish playing
    $actor_sleep((snd.duration() * 1000.0).floor() + 100);
    $println("Playback finished.");
}

main();
