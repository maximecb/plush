// Arena GA, a small evolutionary 1v1 combat experiment.
//
// Each island samples two genomes to fight eight episodes in a randomly sized room.
// Total kills decide matches; damage, sighting, then exploration break episode ties.
// Age counts matches lived through.
// Every 2,000 matches, an island copies one random individual to a ring neighbour.
// The migrant replaces the youngest resident at the next match boundary.
//
// Run with: plush examples/arena.psh
// F cycles viewer playback through 1x, 2x, 4x, 8x, and 10x.
// SPACE pauses the viewer; N skips to the next offered match.
// Movement and turning outputs command bounded acceleration.
// Islands always train at full speed. Headless: --headless --matches 1000.
// --migrate-period N overrides the default of 2,000 for short experiments.
// --max-room N overrides the initial 5 to 10 metre room range.
// --check-movement runs movement and arena assertions without starting islands.
// Render check: --check-render verifies pickup, shot, and blast colors without a window.
// Energy check: --check-energy verifies replenishment, action costs, and exhaustion.
// Map check: --check-maps validates varied layouts, clearance, and spawning.
// Evolution check: --check-evolution verifies coverage selection and migration.
// Checkpoint check: --check-checkpoint verifies selection and named weight mapping.

from random import Xoshiro128;
from json import parse_json, format_json, write_json_file, Error;

fun has_flag(name) {
    for (let var i = 0; i < $cmd_num_args(); ++i)
        if ($cmd_get_arg(i) == name)
            return true;
    return false;
}

fun flag_int(name, fallback) {
    for (let var i = 0; i < $cmd_num_args() - 1; ++i) {
        if ($cmd_get_arg(i) == name) {
            let n = $cmd_get_arg(i + 1).parse_int(10);
            if (n != nil)
                return n;
        }
    }
    return fallback;
}

let HEADLESS = has_flag("--headless");
let MAX_MATCHES = flag_int("--matches", 0);
let NUM_ISLANDS = flag_int("--islands", 6).max(1);
let POP_SIZE = flag_int("--population", 64).max(2);
let SEED = flag_int("--seed", $time_current_ms());

let PI = 3.141592653589793;
let TAU = 2.0 * PI;
let DT = 0.1;
let EPISODE_TICKS = 300;
let EPISODES = 8;
let MIN_ROOM = 5;
let MAX_ROOM = flag_int("--max-room", 10).max(MIN_ROOM);
let BODY_RADIUS = 0.25;
let DRAW_BODY_RADIUS = 0.325;
let DOOR_SLIDE_RANGE = 0.6;
let DOOR_SLIDE_SPEED = 1.5;
let MAX_FORWARD = 3.0;
let MAX_STRAFE = 1.6;
let MAX_TURN = 3.5;
let FORWARD_ACCEL = 5.0;
let STRAFE_ACCEL = 5.0;
let TURN_ACCEL = 10.0;
let LINEAR_DRAG = 1.5;
let TURN_DRAG = 2.0;
// Mechanical-work equivalents, not dietary energy or a detailed fatigue model.
// Human cycling measurements suggest ~150 W sustained mechanical power.
// https://doi.org/10.1113/EP091429
// The smaller burst reserve is gameplay tuning for 30-second episodes.
let BODY_MASS = 75.0;
let MAX_ENERGY = 1_500.0;
let RECOVERY_POWER = 150.0;
// Running costs about 4 J/kg/metre metabolically. Use a fixed 25% conversion
// into our mechanical-work budget, not a detailed model of walking/running gaits.
// https://pubmed.ncbi.nlm.nih.gov/3569218/
let LOCOMOTION_J_PER_KG_METRE = 4.0 * 0.25;
// Stab impact energies are tens of joules; allow extra work for arm recovery.
// https://pubmed.ncbi.nlm.nih.gov/10464927/
// Attacking every 0.5 seconds exceeds the 150 W recovery budget.
let STAB_ENERGY = 150.0;
// Approximate trigger work: 20 N through 5 mm. Propellant supplies bullet energy.
let SHOT_ENERGY = 0.1;
let HEALTH = 100.0;
let KNIFE_RANGE = 1.0;
let KNIFE_DAMAGE = 34.0;
let KNIFE_DOT = 0.70710678;
let GUN_DAMAGE = 40.0;
let GUN_AMMO = 17;
let GUN_RADIUS = 0.3;
let GUN_PICKUP_RANGE = BODY_RADIUS + GUN_RADIUS;
let HEALTH_KIT_HEAL = 50.0;
let HEALTH_KIT_RADIUS = 0.3;
let HEALTH_KIT_PICKUP_RANGE = BODY_RADIUS + HEALTH_KIT_RADIUS;
let GRENADE_RADIUS = 0.2;
let GRENADE_PICKUP_RANGE = BODY_RADIUS + GRENADE_RADIUS;
let GRENADE_THROW_SPEED = 8.0;
let GRENADE_MAX_TRAVEL = 6.0;
let GRENADE_THROW_ENERGY = 30.0;
let GRENADE_FUSE_TICKS = 15;
let GRENADE_BLAST_RADIUS = 3.0;
let GRENADE_DAMAGE = 200.0;
let GRENADE_BLAST_TICKS = 4;
let SHOT_TRACE_TICKS = 4;
let ATTACK_COOLDOWN = 5;
let ATTACK_ANIM_TICKS = 2;
let NOTCH_CHANCE = 0.4;
let MAX_OBSTACLE_FRACTION = 0.28;
let ROOM_LAYOUT_CHANCE = 0.7;
let MIGRATE_PERIOD = flag_int("--migrate-period", 2_000).max(1);
let MATCH_OFFER_INTERVAL_MS = 1500;
let SAVE_INTERVAL_MS = 5 * 60 * 1000;
let SAVE_PATH = "examples/data/arena.json";

let VIEW_BINS = 7;
let VIEW_MIDDLE = VIEW_BINS.idiv(2);
let VIEW_HALF_ANGLE = PI / 3.0;
let OPPONENT_INPUT = VIEW_BINS;
let PICKUP_INPUT = OPPONENT_INPUT + 4;
let HEALTH_KIT_INPUT = PICKUP_INPUT + 3;
let GRENADE_INPUT = HEALTH_KIT_INPUT + 3;
let THROWN_GRENADE_INPUT = GRENADE_INPUT + 3;
let DOOR_INPUT = THROWN_GRENADE_INPUT + 3;
let VIEW_INPUTS = DOOR_INPUT + 1;
let BODY_INPUTS = 11;
let ENERGY_INPUT = VIEW_INPUTS + 8;
let TIME_INPUT = VIEW_INPUTS + 9;
let NUM_SENSORS = VIEW_INPUTS + BODY_INPUTS;
let HIDDEN = 16;
let OUTPUTS = 5;
let RECURRENT = 10;
let NUM_INPUTS = NUM_SENSORS + RECURRENT;
let NUM_WEIGHTS = HIDDEN * NUM_INPUTS + (OUTPUTS + RECURRENT) * HIDDEN;
let OUTPUT_BASE = HIDDEN * NUM_INPUTS;
let RECURRENT_BASE = OUTPUT_BASE + OUTPUTS * HIDDEN;
let W_SCALE = 1.0 / NUM_INPUTS.to_f().sqrt();
let INITIAL_MUTATION_RATE = 0.05;
let INITIAL_MUTATION_STRENGTH = 0.10;
let MIN_MUTATION_RATE = 0.008;
let MAX_MUTATION_RATE = 0.10;
let MIN_MUTATION_STRENGTH = 0.05;
let MAX_MUTATION_STRENGTH = 0.30;
let STRATEGY_MUTATION_CHANCE = 0.10;
let STRATEGY_MUTATION_STEP = 0.05;

// View rays cover 120 degrees with finer spacing near the centre of view.
let RAY_ANGLE = [];
let RAY_X = [];
let RAY_Y = [];
for (let var i = 0; i < VIEW_BINS; ++i) {
    let offset = i - VIEW_MIDDLE;
    let u = offset.abs().to_f() / VIEW_MIDDLE.to_f();
    let angle = (offset < 0 ? -1.0 : 1.0) * VIEW_HALF_ANGLE * u * u.sqrt();
    RAY_ANGLE.push(angle);
    RAY_X.push(angle.cos());
    RAY_Y.push(angle.sin());
}
// Names, rather than positions, identify weight columns across schema changes.
let INPUT_NAMES = [];
for (let var i = 0; i < VIEW_BINS; ++i)
    INPUT_NAMES.push("wall_ray_" + (i - VIEW_MIDDLE).to_s());
let BODY_NAMES = ["health", "forward_speed", "strafe_speed", "turn_speed",
                  "attack_cooldown", "random", "gun_ammo", "grenade_held",
                  "energy", "episode_time", "bias"];
let VISION_NAMES = ["opponent_visible", "opponent_angle", "opponent_proximity",
                    "opponent_has_gun", "pickup_gun_visible", "pickup_gun_angle",
                    "pickup_gun_proximity", "pickup_health_kit_visible",
                    "pickup_health_kit_angle", "pickup_health_kit_proximity",
                    "pickup_grenade_visible", "pickup_grenade_angle",
                    "pickup_grenade_proximity", "thrown_grenade_visible",
                    "thrown_grenade_angle", "thrown_grenade_proximity",
                    "door_visible"];
for (let var i = 0; i < VISION_NAMES.len; ++i)
    INPUT_NAMES.push(VISION_NAMES[i]);
for (let var i = 0; i < BODY_NAMES.len; ++i)
    INPUT_NAMES.push(BODY_NAMES[i]);
let OUTPUT_NAMES = ["forward", "turn", "strafe", "attack", "throw_grenade"];
for (let var i = 0; i < RECURRENT; ++i) {
    let name = "memory_" + i.to_s();
    INPUT_NAMES.push(name);
    OUTPUT_NAMES.push(name);
}
assert(INPUT_NAMES.len == NUM_INPUTS && OUTPUT_NAMES.len == OUTPUTS + RECURRENT);

fun name_index(names, target) {
    for (let var i = 0; i < names.len; ++i)
        if (names[i] == target)
            return i;
    return -1;
}

fun valid_weight(value) {
    return (value instanceof Float64 || value instanceof Int64) &&
           value > -1.0e6 && value < 1.0e6;
}

fun restore_genome(rng, saved, old_inputs, old_outputs) {
    if (!(saved instanceof Dict) || !saved.has("hidden") || !saved.has("output") ||
        !(saved.hidden instanceof Array) || !(saved.output instanceof Array))
        return nil;
    let weights = new_genome(rng);
    for (let var h = 0; h < HIDDEN.min(saved.hidden.len); ++h) {
        let row = saved.hidden[h];
        if (!(row instanceof Array))
            return nil;
        for (let var old_i = 0; old_i < old_inputs.len.min(row.len); ++old_i) {
            let current_i = name_index(INPUT_NAMES, old_inputs[old_i]);
            if (current_i >= 0) {
                if (!valid_weight(row[old_i]))
                    return nil;
                weights.set_f32(h * NUM_INPUTS + current_i, row[old_i]);
            }
        }
    }
    for (let var old_o = 0; old_o < old_outputs.len.min(saved.output.len); ++old_o) {
        let current_o = name_index(OUTPUT_NAMES, old_outputs[old_o]);
        if (current_o < 0)
            continue;
        let row = saved.output[old_o];
        if (!(row instanceof Array))
            return nil;
        for (let var h = 0; h < HIDDEN.min(row.len); ++h) {
            if (!valid_weight(row[h]))
                return nil;
            weights.set_f32(OUTPUT_BASE + current_o * HIDDEN + h, row[h]);
        }
    }
    return weights;
}

fun encode_individual(individual) {
    let hidden = [];
    let output = [];
    for (let var h = 0; h < HIDDEN; ++h) {
        let row = [];
        for (let var i = 0; i < NUM_INPUTS; ++i)
            row.push(individual.weights.get_f32(h * NUM_INPUTS + i));
        hidden.push(row);
    }
    for (let var o = 0; o < OUTPUT_NAMES.len; ++o) {
        let row = [];
        for (let var h = 0; h < HIDDEN; ++h)
            row.push(individual.weights.get_f32(OUTPUT_BASE + o * HIDDEN + h));
        output.push(row);
    }
    return {age: individual.age, name: individual.name, colors: individual.colors,
            hidden: hidden, output: output,
            mutation_rates: individual.mutation_rates,
            mutation_strengths: individual.mutation_strengths};
}

fun decode_individual(rng, saved, old_inputs, old_outputs) {
    if (!(saved instanceof Dict) || !saved.has("age") || !saved.has("name") ||
        !saved.has("colors") || !(saved.age instanceof Int64) || saved.age < 0 ||
        !(saved.name instanceof String) || saved.name.len > 8 ||
        !(saved.colors instanceof Array) || saved.colors.len != 3)
        return nil;
    for (let var i = 0; i < 3; ++i)
        if (!(saved.colors[i] instanceof Int64) ||
            saved.colors[i] < 0 || saved.colors[i] > 255)
            return nil;
    let weights = restore_genome(rng, saved, old_inputs, old_outputs);
    if (weights == nil)
        return nil;
    let rates = [INITIAL_MUTATION_RATE, INITIAL_MUTATION_RATE];
    let strengths = [INITIAL_MUTATION_STRENGTH, INITIAL_MUTATION_STRENGTH];
    if (saved.has("mutation_rates") && saved.has("mutation_strengths") &&
        saved.mutation_rates instanceof Array && saved.mutation_strengths instanceof Array &&
        saved.mutation_rates.len == 2 && saved.mutation_strengths.len == 2) {
        for (let var layer = 0; layer < 2; ++layer) {
            if (!valid_weight(saved.mutation_rates[layer]) ||
                !valid_weight(saved.mutation_strengths[layer]))
                return nil;
            rates[layer] = saved.mutation_rates[layer].clip(MIN_MUTATION_RATE, MAX_MUTATION_RATE);
            strengths[layer] = saved.mutation_strengths[layer].clip(
                MIN_MUTATION_STRENGTH, MAX_MUTATION_STRENGTH);
        }
    }
    return Individual(weights, saved.age, saved.name, saved.colors, rates, strengths);
}

fun read_checkpoint() {
    if (has_flag("--fresh-start"))
        return nil;
    let text = $read_file_utf8(SAVE_PATH);
    if (text == nil)
        return nil;
    let saved = parse_json(text);
    if (saved instanceof Error || !(saved instanceof Dict) || !saved.has("format") ||
        saved.format != 1 || !saved.has("inputs") || !saved.has("outputs") ||
        !saved.has("islands") || !(saved.inputs instanceof Array) ||
        !(saved.outputs instanceof Array) || !(saved.islands instanceof Array)) {
        $println("Could not load arena checkpoint; starting fresh");
        return nil;
    }
    $println("Loaded arena checkpoint from " + SAVE_PATH);
    return saved;
}

fun saved_island(saved, index) {
    if (saved == nil)
        return nil;
    for (let var i = 0; i < saved.islands.len; ++i) {
        let island = saved.islands[i];
        if (island instanceof Dict && island.has("index") && island.index == index &&
            island.has("individuals") && island.individuals instanceof Array)
            return island;
    }
    return nil;
}
fun new_genome(rng) {
    let weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    for (let var i = 0; i < NUM_WEIGHTS; ++i)
        weights.set_f32(i, rng.float(-W_SCALE, W_SCALE));
    return weights;
}

fun mutate(rng, parent, rates, strengths) {
    let weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    weights.memcpy(0, parent, 0, NUM_WEIGHTS * 4);
    let starts = [0, OUTPUT_BASE];
    let lengths = [OUTPUT_BASE, NUM_WEIGHTS - OUTPUT_BASE];
    for (let var layer = 0; layer < 2; ++layer) {
        let expected = lengths[layer].to_f() * rates[layer];
        let var count = expected.floor();
        if (rng.float(0.0, 1.0) < expected - count.to_f())
            count = count + 1;
        count = count.max(1);
        for (let var i = 0; i < count; ++i) {
            let idx = starts[layer] + rng.index(lengths[layer]);
            if (rng.float(0.0, 1.0) < 0.05)
                weights.set_f32(idx, rng.float(-W_SCALE, W_SCALE));
            else
                weights.set_f32(idx, rng.normal(weights.get_f32(idx), strengths[layer]));
        }
    }
    return weights;
}

fun mutate_strategy(rng, value, min_value, max_value) {
    let bounded = value.clip(min_value, max_value);
    if (rng.float(0.0, 1.0) >= STRATEGY_MUTATION_CHANCE)
        return bounded;
    return (bounded * rng.normal(0.0, STRATEGY_MUTATION_STEP).clip(-0.15, 0.15).exp())
           .clip(min_value, max_value);
}

fun random_name(rng) {
    let consonants = "BDFGKLMNPRSTVZ";
    let vowels = "AEIOU";
    let var name = "";
    let syllables = 2 + rng.index(3);
    for (let var i = 0; i < syllables; ++i) {
        name = name + consonants.char_at(rng.index(consonants.len));
        name = name + vowels.char_at(rng.index(vowels.len));
    }
    return name;
}

// Cosmetic genes never enter the neural network's perception or weights.
fun birth(rng, parent) {
    let colors = [];
    let rates = [];
    let strengths = [];
    for (let var i = 0; i < 3; ++i) {
        colors.push(parent == nil ? 80 + rng.index(176) :
                    (parent.colors[i] + rng.index(33) - 16).max(80).min(255));
    }
    for (let var layer = 0; layer < 2; ++layer) {
        rates.push(parent == nil ? INITIAL_MUTATION_RATE :
                   mutate_strategy(rng, parent.mutation_rates[layer],
                                   MIN_MUTATION_RATE, MAX_MUTATION_RATE));
        strengths.push(parent == nil ? INITIAL_MUTATION_STRENGTH :
                       mutate_strategy(rng, parent.mutation_strengths[layer],
                                       MIN_MUTATION_STRENGTH, MAX_MUTATION_STRENGTH));
    }
    return Individual(parent == nil ? new_genome(rng) :
                      mutate(rng, parent.weights, rates, strengths),
                      0, random_name(rng), colors, rates, strengths);
}

class Individual {
    init(self, weights, age, name, colors, mutation_rates, mutation_strengths) {
        self.weights = weights;
        self.age = age;
        self.name = name;
        self.colors = colors;
        self.mutation_rates = mutation_rates;
        self.mutation_strengths = mutation_strengths;
    }

    color(self) {
        return 0xFF_00_00_00 | (self.colors[0] << 16) |
               (self.colors[1] << 8) | self.colors[2];
    }
}

// The grid has one metre cells, a wall border, and sparse connected cover layouts.
class Arena {
    init(self, inner_w, inner_h, rng) {
        self.inner_w = inner_w;
        self.inner_h = inner_h;
        self.width = inner_w + 2;
        self.height = inner_h + 2;
        self.tiles = ByteArray.with_size(self.width * self.height * 4);
        for (let var y = 0; y < self.height; ++y) {
            for (let var x = 0; x < self.width; ++x) {
                if (x == 0 || y == 0 || x == self.width - 1 || y == self.height - 1)
                    self.tiles.set_u32(y * self.width + x, 1);
            }
        }
        if (rng != nil)
            self.generate_cover(rng);
    }

    generate_cover(self, rng) {
        let room_layout = rng.float(0.0, 1.0) < ROOM_LAYOUT_CHANCE;
        // Occasionally retain an open room; otherwise vary the amount of cover.
        if (!room_layout && rng.index(8) == 0)
            return;
        let fraction = room_layout ? MAX_OBSTACLE_FRACTION : 0.16;
        let limit = (self.inner_w * self.inner_h * fraction).floor().max(1);
        let var occupied = room_layout ? self.generate_rooms(rng, limit) : 0;
        let budget = room_layout ? (occupied + rng.index(3)).min(limit) : 1 + rng.index(limit);
        for (let var attempt = 0; attempt < 24 && occupied < budget; ++attempt) {
            let attached = rng.float(0.0, 1.0) < NOTCH_CHANCE;
            let var w = 1;
            let var h = 1;
            if (attached) {
                w = 1 + rng.index(2);
                h = 1 + rng.index(2);
            } else {
                let shape = rng.index(4);
                if (shape == 1)
                    w = 2 + rng.index(2);
                else if (shape == 2)
                    h = 2 + rng.index(2);
                else if (shape == 3) {
                    w = 2;
                    h = 2;
                }
            }
            if (occupied + w * h > budget)
                continue;
            // Interior cover has a floor path on all four sides.
            let var x = 2 + rng.index(self.inner_w - w - 1);
            let var y = 2 + rng.index(self.inner_h - h - 1);
            if (attached) {
                let wall = rng.index(4);
                if (wall == 0)
                    x = 1;
                else if (wall == 1)
                    x = self.inner_w - w + 1;
                else if (wall == 2)
                    y = 1;
                else
                    y = self.inner_h - h + 1;
            }
            // Leave a full tile between separate obstacles, including at corners.
            let var separated = true;
            for (let var cy = (y - 1).max(1); cy <= (y + h).min(self.inner_h); ++cy)
                for (let var cx = (x - 1).max(1); cx <= (x + w).min(self.inner_w); ++cx)
                    if (self.solid(cx, cy))
                        separated = false;
            if (separated && self.try_cover(x, y, w, h))
                occupied = occupied + w * h;
        }
    }

    generate_rooms(self, rng, limit) {
        let rooms = [[1, 1, self.inner_w, self.inner_h]];
        let var occupied = 0;
        let target_rooms = 2 + rng.index(3);
        for (let var attempt = 0; attempt < 16 && rooms.len < target_rooms; ++attempt) {
            let index = rng.index(rooms.len);
            let room = rooms[index];
            let x = room[0];
            let y = room[1];
            let w = room[2];
            let h = room[3];
            if (w < 5 && h < 5)
                continue;
            let vertical = w >= 5 && (h < 5 || rng.index(2) == 0);
            let span = vertical ? h : w;
            if (occupied + span - 1 > limit)
                continue;
            // Each side retains at least two floor tiles of depth.
            let split = 2 + rng.index((vertical ? w : h) - 4);
            let wall_x = vertical ? x + split : x;
            let wall_y = vertical ? y : y + split;
            // A one-metre opening admits the 0.5-metre body. Prefer non-corner doors.
            let door = span > 2 ? 1 + rng.index(span - 2) : rng.index(span);
            if (!self.try_partition(wall_x, wall_y, span, vertical, door))
                continue;
            occupied = occupied + span - 1;
            rooms[index] = vertical ? [x, y, split, h] : [x, y, w, split];
            rooms.push(vertical ? [wall_x + 1, y, w - split - 1, h] :
                                  [x, wall_y + 1, w, h - split - 1]);
        }
        return occupied;
    }

    try_partition(self, x, y, span, vertical, door) {
        let cells = [];
        for (let var i = 0; i < span; ++i) {
            let cx = x + (vertical ? 0 : i);
            let cy = y + (vertical ? i : 0);
            if (self.solid(cx, cy))
                return false;
            if (i != door)
                cells.push(cy * self.width + cx);
        }
        for (let var i = 0; i < cells.len; ++i)
            self.tiles.set_u32(cells[i], 1);
        // Check the complete wall and doorway together, including earlier rooms.
        if (self.connected())
            return true;
        for (let var i = 0; i < cells.len; ++i)
            self.tiles.set_u32(cells[i], 0);
        return false;
    }

    try_cover(self, x, y, w, h) {
        if (w <= 0 || h <= 0 || x < 1 || y < 1 ||
            x + w > self.inner_w + 1 || y + h > self.inner_h + 1)
            return false;
        for (let var cy = y; cy < y + h; ++cy)
            for (let var cx = x; cx < x + w; ++cx)
                if (self.solid(cx, cy))
                    return false;
        for (let var cy = y; cy < y + h; ++cy)
            for (let var cx = x; cx < x + w; ++cx)
                self.tiles.set_u32(cy * self.width + cx, 1);
        if (self.connected())
            return true;
        // Undo the entire proposal when any floor area would become unreachable.
        for (let var cy = y; cy < y + h; ++cy)
            for (let var cx = x; cx < x + w; ++cx)
                self.tiles.set_u32(cy * self.width + cx, 0);
        return false;
    }

    connected(self) {
        let var start = -1;
        let var floor_count = 0;
        for (let var y = 1; y <= self.inner_h; ++y) {
            for (let var x = 1; x <= self.inner_w; ++x) {
                if (!self.solid(x, y)) {
                    floor_count = floor_count + 1;
                    start = y * self.width + x;
                }
            }
        }
        if (start < 0)
            return false;
        let visited = Array.with_size(self.width * self.height, false);
        let queue = [start];
        let offsets = [-1, 1, -self.width, self.width];
        visited[start] = true;
        for (let var head = 0; head < queue.len; ++head) {
            for (let var i = 0; i < offsets.len; ++i) {
                let next = queue[head] + offsets[i];
                // The solid border keeps this four-neighbour traversal in bounds.
                if (!visited[next] && self.tiles.get_u32(next) == 0) {
                    visited[next] = true;
                    queue.push(next);
                }
            }
        }
        return queue.len == floor_count;
    }

    add_notch(self, x, y) {
        self.tiles.set_u32(y * self.width + x, 1);
    }

    solid(self, x, y) {
        if (x < 0 || y < 0 || x >= self.width || y >= self.height)
            return true;
        return self.tiles.get_u32(y * self.width + x) != 0;
    }

    blocked(self, x, y) {
        if (x < 1.0 + BODY_RADIUS || x > self.inner_w.to_f() + 1.0 - BODY_RADIUS ||
            y < 1.0 + BODY_RADIUS || y > self.inner_h.to_f() + 1.0 - BODY_RADIUS)
            return true;
        for (let var ty = (y - BODY_RADIUS).floor(); ty <= (y + BODY_RADIUS).floor(); ++ty) {
            for (let var tx = (x - BODY_RADIUS).floor(); tx <= (x + BODY_RADIUS).floor(); ++tx) {
                if (!self.solid(tx, ty))
                    continue;
                let nx = x.clip(tx.to_f(), tx.to_f() + 1.0);
                let ny = y.clip(ty.to_f(), ty.to_f() + 1.0);
                let dx = x - nx;
                let dy = y - ny;
                if (dx * dx + dy * dy < BODY_RADIUS * BODY_RADIUS)
                    return true;
            }
        }
        return false;
    }

    doorway_center(self, leading, lateral, along_x, positive) {
        let wall = (leading + (positive ? BODY_RADIUS : -BODY_RADIUS)).floor();
        let var nearest = nil;
        let var nearest_distance = DOOR_SLIDE_RANGE;
        for (let var cell = (lateral - DOOR_SLIDE_RANGE).floor();
             cell <= (lateral + DOOR_SLIDE_RANGE).floor(); ++cell) {
            let opening = along_x ? !self.solid(wall, cell) &&
                                    self.solid(wall, cell - 1) &&
                                    self.solid(wall, cell + 1) :
                                    !self.solid(cell, wall) &&
                                    self.solid(cell - 1, wall) &&
                                    self.solid(cell + 1, wall);
            let distance = (cell.to_f() + 0.5 - lateral).abs();
            if (opening && distance <= nearest_distance) {
                nearest = cell.to_f() + 0.5;
                nearest_distance = distance;
            }
        }
        return nearest;
    }

    door_on_ray(self, x, y, dx, dy) {
        let var cell_x = x.floor();
        let var cell_y = y.floor();
        let var step_x = 0;
        let var step_y = 0;
        let var tx = 1.0e20;
        let var ty = 1.0e20;
        let var delta_x = 1.0e20;
        let var delta_y = 1.0e20;
        if (dx > 0.0) {
            step_x = 1;
            delta_x = 1.0 / dx;
            tx = (cell_x.to_f() + 1.0 - x) * delta_x;
        } else if (dx < 0.0) {
            step_x = -1;
            delta_x = -1.0 / dx;
            tx = (x - cell_x.to_f()) * delta_x;
        }
        if (dy > 0.0) {
            step_y = 1;
            delta_y = 1.0 / dy;
            ty = (cell_y.to_f() + 1.0 - y) * delta_y;
        } else if (dy < 0.0) {
            step_y = -1;
            delta_y = -1.0 / dy;
            ty = (y - cell_y.to_f()) * delta_y;
        }
        loop {
            if (self.solid(cell_x, cell_y))
                return false;
            if ((self.solid(cell_x - 1, cell_y) && self.solid(cell_x + 1, cell_y)) ||
                (self.solid(cell_x, cell_y - 1) && self.solid(cell_x, cell_y + 1)))
                return true;
            if (tx < ty) {
                cell_x = cell_x + step_x;
                tx = tx + delta_x;
            } else {
                cell_y = cell_y + step_y;
                ty = ty + delta_y;
            }
        }
    }

    // Walk grid cells until the ray enters a solid tile.
    wall_distance(self, x, y, dx, dy) {
        let var cell_x = x.floor();
        let var cell_y = y.floor();
        let var step_x = 0;
        let var step_y = 0;
        let var tx = 1.0e20;
        let var ty = 1.0e20;
        let var delta_x = 1.0e20;
        let var delta_y = 1.0e20;
        if (dx > 0.0) {
            step_x = 1;
            delta_x = 1.0 / dx;
            tx = (cell_x.to_f() + 1.0 - x) * delta_x;
        } else if (dx < 0.0) {
            step_x = -1;
            delta_x = -1.0 / dx;
            tx = (x - cell_x.to_f()) * delta_x;
        }
        if (dy > 0.0) {
            step_y = 1;
            delta_y = 1.0 / dy;
            ty = (cell_y.to_f() + 1.0 - y) * delta_y;
        } else if (dy < 0.0) {
            step_y = -1;
            delta_y = -1.0 / dy;
            ty = (y - cell_y.to_f()) * delta_y;
        }
        loop {
            let var distance = 0.0;
            if (tx < ty) {
                cell_x = cell_x + step_x;
                distance = tx;
                tx = tx + delta_x;
            } else {
                cell_y = cell_y + step_y;
                distance = ty;
                ty = ty + delta_y;
            }
            if (self.solid(cell_x, cell_y))
                return distance;
        }
    }
}

class Fighter {
    init(self, individual) {
        self.individual = individual;
        self.inputs = ByteArray.with_size(NUM_INPUTS * 4);
        self.next_hidden = ByteArray.with_size(HIDDEN * 4);
        self.action = Array.with_size(OUTPUTS, 0.0);
        self.reset(2.0, 2.0, 0.0);
    }

    reset(self, x, y, angle) {
        self.x = x;
        self.y = y;
        self.angle = angle;
        self.vx = 0.0;
        self.vy = 0.0;
        self.turn_velocity = 0.0;
        self.health = HEALTH;
        self.energy = MAX_ENERGY;
        self.cooldown = 0;
        self.attack_ticks = 0;
        self.gun_ammo = 0;
        self.grenade_held = false;
        self.shot_ticks = 0;
        self.shot_start_x = x;
        self.shot_start_y = y;
        self.shot_end_x = x;
        self.shot_end_y = y;
        // Clear recurrent inputs along with perception for each new episode.
        self.inputs.fill_u32(0, NUM_INPUTS, 0);
        self.inputs.set_f32(ENERGY_INPUT, 1.0);
        self.inputs.set_f32(NUM_SENSORS - 1, 1.0);
    }

    recover(self) {
        self.energy = (self.energy + RECOVERY_POWER * DT).min(MAX_ENERGY);
    }

    sense(self, arena, other, gun_available, gun_x, gun_y,
          kit_available, kit_x, kit_y,
          grenade_available, grenade_x, grenade_y,
          thrown_active, thrown_x, thrown_y, episode_tick, rng) {
        let inputs = self.inputs;
        let c = self.angle.cos();
        let s = self.angle.sin();
        let ex = other.x - self.x;
        let ey = other.y - self.y;
        let dist2 = ex * ex + ey * ey;
        let var opponent_visible = false;
        let var opponent_angle = 0.0;
        let var opponent_near = 0.0;
        let var gun_angle = 0.0;
        let var gun_near = 0.0;
        let var gun_visible = false;
        let var kit_angle = 0.0;
        let var kit_near = 0.0;
        let var kit_visible = false;
        let var grenade_angle = 0.0;
        let var grenade_near = 0.0;
        let var grenade_visible = false;
        let var thrown_angle = 0.0;
        let var thrown_near = 0.0;
        let var thrown_visible = false;

        // One center ray per object prevents seeing pickups or opponents through walls.
        let forward = ex * c + ey * s;
        if (forward > 0.0 && dist2 > 0.000001) {
            let side = -ex * s + ey * c;
            let bearing = (side / forward).atan();
            if (bearing >= -VIEW_HALF_ANGLE && bearing <= VIEW_HALF_ANGLE) {
                let dist = dist2.sqrt();
                if (arena.wall_distance(self.x, self.y, ex / dist, ey / dist) >= dist) {
                    opponent_visible = true;
                    opponent_angle = bearing / VIEW_HALF_ANGLE;
                    opponent_near = 1.0 / (1.0 + (dist - BODY_RADIUS).max(0.0));
                }
            }
        }

        if (gun_available) {
            let gx = gun_x - self.x;
            let gy = gun_y - self.y;
            let gun_dist2 = gx * gx + gy * gy;
            let gun_forward = gx * c + gy * s;
            if (gun_forward > 0.0 && gun_dist2 > 0.000001) {
                let gun_side = -gx * s + gy * c;
                let gun_bearing = (gun_side / gun_forward).atan();
                if (gun_bearing >= -VIEW_HALF_ANGLE && gun_bearing <= VIEW_HALF_ANGLE) {
                    let dist = gun_dist2.sqrt();
                    if (arena.wall_distance(self.x, self.y, gx / dist, gy / dist) >= dist) {
                        gun_visible = true;
                        gun_angle = gun_bearing / VIEW_HALF_ANGLE;
                        gun_near = 1.0 / (1.0 + (dist - GUN_RADIUS).max(0.0));
                    }
                }
            }
            if (gun_dist2 <= 0.000001) {
                gun_visible = true;
                gun_near = 1.0;
            }
        }

        if (kit_available) {
            let kx = kit_x - self.x;
            let ky = kit_y - self.y;
            let kit_dist2 = kx * kx + ky * ky;
            let kit_forward = kx * c + ky * s;
            if (kit_forward > 0.0 && kit_dist2 > 0.000001) {
                let kit_side = -kx * s + ky * c;
                let kit_bearing = (kit_side / kit_forward).atan();
                if (kit_bearing >= -VIEW_HALF_ANGLE && kit_bearing <= VIEW_HALF_ANGLE) {
                    let dist = kit_dist2.sqrt();
                    if (arena.wall_distance(self.x, self.y, kx / dist, ky / dist) >= dist) {
                        kit_visible = true;
                        kit_angle = kit_bearing / VIEW_HALF_ANGLE;
                        kit_near = 1.0 / (1.0 + (dist - HEALTH_KIT_RADIUS).max(0.0));
                    }
                }
            }
            if (kit_dist2 <= 0.000001) {
                kit_visible = true;
                kit_near = 1.0;
            }
        }

        if (grenade_available) {
            let gx = grenade_x - self.x;
            let gy = grenade_y - self.y;
            let grenade_dist2 = gx * gx + gy * gy;
            let grenade_forward = gx * c + gy * s;
            if (grenade_forward > 0.0 && grenade_dist2 > 0.000001) {
                let grenade_side = -gx * s + gy * c;
                let grenade_bearing = (grenade_side / grenade_forward).atan();
                if (grenade_bearing >= -VIEW_HALF_ANGLE &&
                    grenade_bearing <= VIEW_HALF_ANGLE) {
                    let dist = grenade_dist2.sqrt();
                    if (arena.wall_distance(self.x, self.y, gx / dist, gy / dist) >= dist) {
                        grenade_visible = true;
                        grenade_angle = grenade_bearing / VIEW_HALF_ANGLE;
                        grenade_near = 1.0 / (1.0 + (dist - GRENADE_RADIUS).max(0.0));
                    }
                }
            }
            if (grenade_dist2 <= 0.000001) {
                grenade_visible = true;
                grenade_near = 1.0;
            }
        }

        if (thrown_active) {
            let gx = thrown_x - self.x;
            let gy = thrown_y - self.y;
            let thrown_dist2 = gx * gx + gy * gy;
            let thrown_forward = gx * c + gy * s;
            if (thrown_forward > 0.0 && thrown_dist2 > 0.000001) {
                let thrown_side = -gx * s + gy * c;
                let thrown_bearing = (thrown_side / thrown_forward).atan();
                if (thrown_bearing >= -VIEW_HALF_ANGLE &&
                    thrown_bearing <= VIEW_HALF_ANGLE) {
                    let dist = thrown_dist2.sqrt();
                    if (arena.wall_distance(self.x, self.y, gx / dist, gy / dist) >= dist) {
                        thrown_visible = true;
                        thrown_angle = thrown_bearing / VIEW_HALF_ANGLE;
                        thrown_near = 1.0 / (1.0 + (dist - GRENADE_RADIUS).max(0.0));
                    }
                }
            }
            if (thrown_dist2 <= 0.000001) {
                thrown_visible = true;
                thrown_near = 1.0;
            }
        }

        for (let var i = 0; i < VIEW_BINS; ++i) {
            let dx = c * RAY_X[i] - s * RAY_Y[i];
            let dy = s * RAY_X[i] + c * RAY_Y[i];
            let wall = arena.wall_distance(self.x, self.y, dx, dy);
            inputs.set_f32(i, 1.0 / (1.0 + wall));
        }
        inputs.set_f32(OPPONENT_INPUT, opponent_visible ? 1.0 : 0.0);
        inputs.set_f32(OPPONENT_INPUT + 1, opponent_angle);
        inputs.set_f32(OPPONENT_INPUT + 2, opponent_near);
        inputs.set_f32(OPPONENT_INPUT + 3,
                       opponent_visible && other.gun_ammo > 0 ? 1.0 : 0.0);
        inputs.set_f32(PICKUP_INPUT, gun_visible ? 1.0 : 0.0);
        inputs.set_f32(PICKUP_INPUT + 1, gun_angle);
        inputs.set_f32(PICKUP_INPUT + 2, gun_near);
        inputs.set_f32(HEALTH_KIT_INPUT, kit_visible ? 1.0 : 0.0);
        inputs.set_f32(HEALTH_KIT_INPUT + 1, kit_angle);
        inputs.set_f32(HEALTH_KIT_INPUT + 2, kit_near);
        inputs.set_f32(GRENADE_INPUT, grenade_visible ? 1.0 : 0.0);
        inputs.set_f32(GRENADE_INPUT + 1, grenade_angle);
        inputs.set_f32(GRENADE_INPUT + 2, grenade_near);
        inputs.set_f32(THROWN_GRENADE_INPUT, thrown_visible ? 1.0 : 0.0);
        inputs.set_f32(THROWN_GRENADE_INPUT + 1, thrown_angle);
        inputs.set_f32(THROWN_GRENADE_INPUT + 2, thrown_near);
        inputs.set_f32(DOOR_INPUT, arena.door_on_ray(self.x, self.y, c, s) ? 1.0 : 0.0);

        inputs.set_f32(VIEW_INPUTS, self.health / HEALTH);
        inputs.set_f32(VIEW_INPUTS + 1, (self.vx * c + self.vy * s) / MAX_FORWARD);
        inputs.set_f32(VIEW_INPUTS + 2, (-self.vx * s + self.vy * c) / MAX_STRAFE);
        inputs.set_f32(VIEW_INPUTS + 3, self.turn_velocity / MAX_TURN);
        inputs.set_f32(VIEW_INPUTS + 4, self.cooldown.to_f() / ATTACK_COOLDOWN.to_f());
        inputs.set_f32(VIEW_INPUTS + 5, rng.float(-1.0, 1.0));
        inputs.set_f32(VIEW_INPUTS + 6, self.gun_ammo.to_f() / GUN_AMMO.to_f());
        inputs.set_f32(VIEW_INPUTS + 7, self.grenade_held ? 1.0 : 0.0);
        inputs.set_f32(ENERGY_INPUT, (self.energy / MAX_ENERGY).clip(0.0, 1.0));
        inputs.set_f32(TIME_INPUT, (episode_tick.to_f() /
                       (EPISODE_TICKS - 1).to_f()).clip(0.0, 1.0));
    }

    think(self) {
        let weights = self.individual.weights;
        for (let var i = 0; i < HIDDEN; ++i) {
            let value = weights.dot_f32(i * NUM_INPUTS, 1, self.inputs, 0, 1, NUM_INPUTS);
            self.next_hidden.set_f32(i, value.clip(0.0, 8.0));
        }

        let out = self.action;
        for (let var i = 0; i < OUTPUTS; ++i) {
            let v = weights.dot_f32(OUTPUT_BASE + i * HIDDEN, 1, self.next_hidden, 0, 1, HIDDEN);
            out[i] = v / (1.0 + v.abs());
        }
        out[3] = (out[3] + 1.0) * 0.5;
        out[4] = (out[4] + 1.0) * 0.5;

        // Recurrent outputs become the next tick's memory inputs.
        for (let var i = 0; i < RECURRENT; ++i) {
            let v = weights.dot_f32(RECURRENT_BASE + i * HIDDEN, 1,
                                    self.next_hidden, 0, 1, HIDDEN);
            self.inputs.set_f32(NUM_SENSORS + i, v / (1.0 + v.abs()));
        }
        return out;
    }

    move(self, arena, action) {
        let turn_accel = (action[1] * TURN_ACCEL - self.turn_velocity * TURN_DRAG)
                         .clip(-TURN_ACCEL, TURN_ACCEL);
        self.turn_velocity = (self.turn_velocity + turn_accel * DT)
                             .clip(-MAX_TURN, MAX_TURN);
        self.angle = self.angle + self.turn_velocity * DT;
        if (self.angle > PI)
            self.angle = self.angle - TAU;
        else if (self.angle < -PI)
            self.angle = self.angle + TAU;

        let var f = action[0];
        let var side = action[2];
        let scale = (f * f + side * side).sqrt().max(1.0);
        f = f / scale;
        side = side / scale;
        let c = self.angle.cos();
        let s = self.angle.sin();
        let var ax = c * f * FORWARD_ACCEL - s * side * STRAFE_ACCEL - self.vx * LINEAR_DRAG;
        let var ay = s * f * FORWARD_ACCEL + c * side * STRAFE_ACCEL - self.vy * LINEAR_DRAG;
        let accel_scale = (ax * ax + ay * ay).sqrt().max(FORWARD_ACCEL) / FORWARD_ACCEL;
        ax = ax / accel_scale;
        ay = ay / accel_scale;
        let old_vx = self.vx;
        let old_vy = self.vy;
        let old_speed2 = old_vx * old_vx + old_vy * old_vy;
        self.vx = self.vx + ax * DT;
        self.vy = self.vy + ay * DT;

        // Cap each body-relative component, then cap diagonal running speed.
        let var forward_speed = (self.vx * c + self.vy * s).clip(-MAX_FORWARD, MAX_FORWARD);
        let var strafe_speed = (-self.vx * s + self.vy * c).clip(-MAX_STRAFE, MAX_STRAFE);
        let speed_scale = (forward_speed * forward_speed + strafe_speed * strafe_speed)
                          .sqrt().max(MAX_FORWARD) / MAX_FORWARD;
        forward_speed = forward_speed / speed_scale;
        strafe_speed = strafe_speed / speed_scale;
        self.vx = c * forward_speed - s * strafe_speed;
        self.vy = s * forward_speed + c * strafe_speed;

        // Charge footwork per metre plus positive changes in kinetic energy.
        // Drag only controls motion; overcoming it has no separate energy charge.
        let distance_cost = BODY_MASS * LOCOMOTION_J_PER_KG_METRE * DT;
        let wanted_speed2 = self.vx * self.vx + self.vy * self.vy;
        let wanted_cost = distance_cost * wanted_speed2.sqrt() +
                          0.5 * BODY_MASS * (wanted_speed2 - old_speed2).max(0.0);
        if (wanted_cost > self.energy) {
            // Solve for an affordable speed, including the acceleration surcharge.
            let var affordable = self.energy / distance_cost;
            if (self.energy > distance_cost * old_speed2.sqrt()) {
                let budget = self.energy + 0.5 * BODY_MASS * old_speed2;
                affordable = 2.0 * budget / (distance_cost +
                    (distance_cost * distance_cost + 2.0 * BODY_MASS * budget).sqrt());
            }
            let coast_x = old_vx * (1.0 - LINEAR_DRAG * DT);
            let coast_y = old_vy * (1.0 - LINEAR_DRAG * DT);
            let coast_speed2 = coast_x * coast_x + coast_y * coast_y;
            if (coast_speed2 > affordable * affordable) {
                // Exhaustion cannot erase momentum. Coast or brake until affordable.
                if (coast_speed2 < wanted_speed2) {
                    self.vx = coast_x;
                    self.vy = coast_y;
                }
            } else {
                // Intersect the requested velocity change with the affordable speed.
                let dvx = self.vx - coast_x;
                let dvy = self.vy - coast_y;
                let a = dvx * dvx + dvy * dvy;
                let b = coast_x * dvx + coast_y * dvy;
                let c0 = coast_speed2 - affordable * affordable;
                let u = ((-b + (b * b - a * c0).max(0.0).sqrt()) /
                         a.max(0.000000000001)).clip(0.0, 1.0);
                self.vx = coast_x + u * dvx;
                self.vy = coast_y + u * dvy;
            }
        }
        let speed2 = self.vx * self.vx + self.vy * self.vy;
        let spent = distance_cost * speed2.sqrt() +
                    0.5 * BODY_MASS * (speed2 - old_speed2).max(0.0);
        // Braking never refills energy; exhausted coasting cannot overdraw the reserve.
        self.energy = (self.energy - spent).max(0.0);

        // A tenth of a second is shorter than one tile at running speed.
        // Resolve each axis separately so fighters can slide along notches.
        let next_x = self.x + self.vx * DT;
        let candidate_x = next_x.clip(1.0 + BODY_RADIUS,
                                       arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
        if (arena.blocked(candidate_x, self.y)) {
            let door_y = arena.doorway_center(candidate_x, self.y, true, self.vx > 0.0);
            if (door_y != nil) {
                let var slide = (door_y - self.y).clip(-DOOR_SLIDE_SPEED * DT,
                                                        DOOR_SLIDE_SPEED * DT);
                slide = slide.clip(-self.vx.abs() * DT, self.vx.abs() * DT);
                if (!arena.blocked(self.x, self.y + slide))
                    self.y = self.y + slide;
            }
            let start_x = self.x;
            let var safe = 0.0;
            let var blocked = 1.0;
            for (let var i = 0; i < 6; ++i) {
                let middle = (safe + blocked) * 0.5;
                if (arena.blocked(start_x + (candidate_x - start_x) * middle, self.y))
                    blocked = middle;
                else
                    safe = middle;
            }
            self.x = start_x + (candidate_x - start_x) * safe;
        } else {
            self.x = candidate_x;
        }
        if (self.x != next_x)
            self.vx = 0.0;
        let next_y = self.y + self.vy * DT;
        let candidate_y = next_y.clip(1.0 + BODY_RADIUS,
                                       arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
        if (arena.blocked(self.x, candidate_y)) {
            let door_x = arena.doorway_center(candidate_y, self.x, false, self.vy > 0.0);
            if (door_x != nil) {
                let var slide = (door_x - self.x).clip(-DOOR_SLIDE_SPEED * DT,
                                                        DOOR_SLIDE_SPEED * DT);
                slide = slide.clip(-self.vy.abs() * DT, self.vy.abs() * DT);
                if (!arena.blocked(self.x + slide, self.y))
                    self.x = self.x + slide;
            }
            let start_y = self.y;
            let var safe = 0.0;
            let var blocked = 1.0;
            for (let var i = 0; i < 6; ++i) {
                let middle = (safe + blocked) * 0.5;
                if (arena.blocked(self.x, start_y + (candidate_y - start_y) * middle))
                    blocked = middle;
                else
                    safe = middle;
            }
            self.y = start_y + (candidate_y - start_y) * safe;
        } else {
            self.y = candidate_y;
        }
        if (self.y != next_y)
            self.vy = 0.0;
        if (self.cooldown > 0)
            self.cooldown = self.cooldown - 1;
        if (self.attack_ticks > 0)
            self.attack_ticks = self.attack_ticks - 1;
        if (self.shot_ticks > 0)
            self.shot_ticks = self.shot_ticks - 1;
    }

    push(self, arena, dx, dy) {
        let next_x = (self.x + dx).clip(1.0 + BODY_RADIUS,
                                       arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
        if (!arena.blocked(next_x, self.y))
            self.x = next_x;
        let next_y = (self.y + dy).clip(1.0 + BODY_RADIUS,
                                       arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
        if (!arena.blocked(self.x, next_y))
            self.y = next_y;
    }

    strikes(self, arena, other, attack_signal) {
        if (self.cooldown > 0 || attack_signal <= 0.5)
            return 0.0;
        let cost = self.gun_ammo > 0 ? SHOT_ENERGY : STAB_ENERGY;
        if (self.energy < cost)
            return 0.0;
        // An attempted attack costs energy even when it misses.
        self.energy = (self.energy - cost).max(0.0);
        self.cooldown = ATTACK_COOLDOWN;
        if (self.gun_ammo > 0) {
            self.gun_ammo = self.gun_ammo - 1;
            let c = self.angle.cos();
            let s = self.angle.sin();
            let wall = arena.wall_distance(self.x, self.y, c, s);
            let dx = other.x - self.x;
            let dy = other.y - self.y;
            let along = dx * c + dy * s;
            let side2 = dx * dx + dy * dy - along * along;
            let var hit = false;
            let var distance = wall;
            if (along >= 0.0 && side2 <= BODY_RADIUS * BODY_RADIUS) {
                let entry = (along - (BODY_RADIUS * BODY_RADIUS - side2).max(0.0).sqrt())
                            .max(0.0);
                if (entry <= wall) {
                    hit = true;
                    distance = entry;
                }
            }
            self.shot_start_x = self.x;
            self.shot_start_y = self.y;
            self.shot_end_x = self.x + c * distance;
            self.shot_end_y = self.y + s * distance;
            self.shot_ticks = SHOT_TRACE_TICKS;
            return hit ? GUN_DAMAGE : 0.0;
        }
        self.attack_ticks = ATTACK_ANIM_TICKS;
        let dx = other.x - self.x;
        let dy = other.y - self.y;
        let dist2 = dx * dx + dy * dy;
        let reach = KNIFE_RANGE + BODY_RADIUS;
        if (dist2 > reach * reach || dist2 < 0.000001)
            return 0.0;
        let dist = dist2.sqrt();
        if (arena.wall_distance(self.x, self.y, dx / dist, dy / dist) < dist - BODY_RADIUS)
            return 0.0;
        return (dx * self.angle.cos() + dy * self.angle.sin()) >= KNIFE_DOT * dist ?
               KNIFE_DAMAGE : 0.0;
    }
}

class Match {
    init(self, first, second, seed) {
        self.seed = seed;
        self.rng = Xoshiro128(seed);
        let rng = self.rng;
        let width = rng.index(MAX_ROOM - MIN_ROOM + 1) + MIN_ROOM;
        let height = rng.index(MAX_ROOM - MIN_ROOM + 1) + MIN_ROOM;
        self.arena = Arena(width, height, rng);
        self.fighters = [Fighter(first), Fighter(second)];
        self.kills = [0, 0];
        self.tiebreak_wins = [0, 0];
        self.episode = 0;
        self.tick = 0;
        self.done = false;
        self.needs_reset = false;
        self.reset_episode();
    }

    reset_episode(self) {
        let rng = self.rng;
        let arena = self.arena;
        let var ax = 0.0;
        let var ay = 0.0;
        loop {
            ax = rng.float(1.0 + BODY_RADIUS, arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
            ay = rng.float(1.0 + BODY_RADIUS, arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
            if (!arena.blocked(ax, ay))
                break;
        }
        let var bx = 0.0;
        let var by = 0.0;
        loop {
            bx = rng.float(1.0 + BODY_RADIUS, arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
            by = rng.float(1.0 + BODY_RADIUS, arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
            let dx = bx - ax;
            let dy = by - ay;
            if (dx * dx + dy * dy >= 4.0 && !arena.blocked(bx, by))
                break;
        }
        self.fighters[0].reset(ax, ay, rng.float(-PI, PI));
        self.fighters[1].reset(bx, by, rng.float(-PI, PI));
        self.min_x = [ax, bx];
        self.max_x = [ax, bx];
        self.min_y = [ay, by];
        self.max_y = [ay, by];
        self.saw_opponent = [false, false];
        self.damage_dealt = [0.0, 0.0];
        loop {
            self.gun_x = rng.float(1.0 + BODY_RADIUS,
                                   arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
            self.gun_y = rng.float(1.0 + BODY_RADIUS,
                                   arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
            let da_x = self.gun_x - ax;
            let da_y = self.gun_y - ay;
            let db_x = self.gun_x - bx;
            let db_y = self.gun_y - by;
            if (!arena.blocked(self.gun_x, self.gun_y) &&
                da_x * da_x + da_y * da_y >= 1.0 &&
                db_x * db_x + db_y * db_y >= 1.0)
                break;
        }
        self.gun_available = true;
        loop {
            self.kit_x = rng.float(1.0 + BODY_RADIUS,
                                   arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
            self.kit_y = rng.float(1.0 + BODY_RADIUS,
                                   arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
            let da_x = self.kit_x - ax;
            let da_y = self.kit_y - ay;
            let db_x = self.kit_x - bx;
            let db_y = self.kit_y - by;
            let gun_x = self.kit_x - self.gun_x;
            let gun_y = self.kit_y - self.gun_y;
            if (!arena.blocked(self.kit_x, self.kit_y) &&
                da_x * da_x + da_y * da_y >= 1.0 &&
                db_x * db_x + db_y * db_y >= 1.0 &&
                gun_x * gun_x + gun_y * gun_y >= 1.0)
                break;
        }
        self.kit_available = true;
        loop {
            self.grenade_x = rng.float(1.0 + BODY_RADIUS,
                                       arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
            self.grenade_y = rng.float(1.0 + BODY_RADIUS,
                                       arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
            let da_x = self.grenade_x - ax;
            let da_y = self.grenade_y - ay;
            let db_x = self.grenade_x - bx;
            let db_y = self.grenade_y - by;
            let gun_x = self.grenade_x - self.gun_x;
            let gun_y = self.grenade_y - self.gun_y;
            let kit_x = self.grenade_x - self.kit_x;
            let kit_y = self.grenade_y - self.kit_y;
            if (!arena.blocked(self.grenade_x, self.grenade_y) &&
                da_x * da_x + da_y * da_y >= 1.0 &&
                db_x * db_x + db_y * db_y >= 1.0 &&
                gun_x * gun_x + gun_y * gun_y >= 0.49 &&
                kit_x * kit_x + kit_y * kit_y >= 0.49)
                break;
        }
        self.grenade_available = true;
        self.grenade_active = false;
        self.grenade_vx = 0.0;
        self.grenade_vy = 0.0;
        self.grenade_travel = 0.0;
        self.grenade_thrower = 0;
        self.grenade_fuse = 0;
        self.blast_ticks = 0;
        self.tick = 0;
        self.needs_reset = false;
    }

    track_coverage(self) {
        for (let var side = 0; side < 2; ++side) {
            if (self.saw_opponent[side])
                continue;
            let fighter = self.fighters[side];
            self.min_x[side] = self.min_x[side].min(fighter.x);
            self.max_x[side] = self.max_x[side].max(fighter.x);
            self.min_y[side] = self.min_y[side].min(fighter.y);
            self.max_y[side] = self.max_y[side].max(fighter.y);
        }
    }

    coverage(self, side) {
        let width = self.max_x[side] - self.min_x[side];
        let height = self.max_y[side] - self.min_y[side];
        return width * height / (self.arena.inner_w * self.arena.inner_h).to_f();
    }

    episode_tiebreak_winner(self) {
        if (self.damage_dealt[0] != self.damage_dealt[1])
            return self.damage_dealt[0] > self.damage_dealt[1] ? 0 : 1;
        if (self.saw_opponent[0] != self.saw_opponent[1])
            return self.saw_opponent[0] ? 0 : 1;
        let coverage_a = self.coverage(0);
        let coverage_b = self.coverage(1);
        if (coverage_a != coverage_b)
            return coverage_a > coverage_b ? 0 : 1;
        return -1;
    }

    deal_damage(self, attacker_side, target_side, damage) {
        let target = self.fighters[target_side];
        if (attacker_side != target_side)
            self.damage_dealt[attacker_side] = self.damage_dealt[attacker_side] +
                                               damage.min(target.health.max(0.0));
        target.health = target.health - damage;
    }

    pickup_gun(self) {
        if (!self.gun_available)
            return;
        let a = self.fighters[0];
        let b = self.fighters[1];
        let ax = a.x - self.gun_x;
        let ay = a.y - self.gun_y;
        let bx = b.x - self.gun_x;
        let by = b.y - self.gun_y;
        let da = ax * ax + ay * ay;
        let db = bx * bx + by * by;
        let reach2 = GUN_PICKUP_RANGE * GUN_PICKUP_RANGE;
        if (da > reach2 && db > reach2)
            return;
        let owner = da <= db ? a : b;
        owner.gun_ammo = GUN_AMMO;
        self.gun_available = false;
    }

    pickup_health_kit(self) {
        if (!self.kit_available)
            return;
        let a = self.fighters[0];
        let b = self.fighters[1];
        let ax = a.x - self.kit_x;
        let ay = a.y - self.kit_y;
        let bx = b.x - self.kit_x;
        let by = b.y - self.kit_y;
        let da = ax * ax + ay * ay;
        let db = bx * bx + by * by;
        let reach2 = HEALTH_KIT_PICKUP_RANGE * HEALTH_KIT_PICKUP_RANGE;
        let can_a = a.health < HEALTH && da <= reach2;
        let can_b = b.health < HEALTH && db <= reach2;
        if (!can_a && !can_b)
            return;
        let owner = can_a && (!can_b || da <= db) ? a : b;
        owner.health = (owner.health + HEALTH_KIT_HEAL).min(HEALTH);
        self.kit_available = false;
    }

    pickup_grenade(self) {
        if (!self.grenade_available)
            return;
        let a = self.fighters[0];
        let b = self.fighters[1];
        let ax = a.x - self.grenade_x;
        let ay = a.y - self.grenade_y;
        let bx = b.x - self.grenade_x;
        let by = b.y - self.grenade_y;
        let da = ax * ax + ay * ay;
        let db = bx * bx + by * by;
        let reach2 = GRENADE_PICKUP_RANGE * GRENADE_PICKUP_RANGE;
        if (da > reach2 && db > reach2)
            return;
        let owner = da <= db ? a : b;
        owner.grenade_held = true;
        self.grenade_available = false;
    }

    throw_grenade(self, fighter, signal, side) {
        if (!fighter.grenade_held || signal <= 0.5 || fighter.cooldown > 0 ||
            fighter.energy < GRENADE_THROW_ENERGY || self.grenade_active)
            return false;
        fighter.energy = fighter.energy - GRENADE_THROW_ENERGY;
        fighter.cooldown = ATTACK_COOLDOWN;
        fighter.grenade_held = false;
        self.grenade_x = fighter.x;
        self.grenade_y = fighter.y;
        self.grenade_vx = fighter.angle.cos() * GRENADE_THROW_SPEED;
        self.grenade_vy = fighter.angle.sin() * GRENADE_THROW_SPEED;
        self.grenade_travel = 0.0;
        self.grenade_thrower = side;
        self.grenade_fuse = GRENADE_FUSE_TICKS;
        self.grenade_active = true;
        return true;
    }

    advance_grenade(self) {
        let speed = (self.grenade_vx * self.grenade_vx +
                     self.grenade_vy * self.grenade_vy).sqrt();
        if (speed > 0.0) {
            let dx = self.grenade_vx / speed;
            let dy = self.grenade_vy / speed;
            let remaining = (GRENADE_MAX_TRAVEL - self.grenade_travel).max(0.0);
            let var travel = (speed * DT).min(remaining);
            let reached_range = travel >= remaining;
            let enemy = self.fighters[1 - self.grenade_thrower];
            let ex = enemy.x - self.grenade_x;
            let ey = enemy.y - self.grenade_y;
            let along = ex * dx + ey * dy;
            let side2 = (ex * ex + ey * ey - along * along).max(0.0);
            let reach = BODY_RADIUS + GRENADE_RADIUS;
            if (along >= 0.0 && side2 <= reach * reach) {
                let entry = (along - (reach * reach - side2).sqrt()).max(0.0);
                if (entry <= travel) {
                    travel = entry;
                    self.grenade_vx = 0.0;
                    self.grenade_vy = 0.0;
                }
            }
            let wall = self.arena.wall_distance(self.grenade_x, self.grenade_y, dx, dy);
            if (wall <= travel + GRENADE_RADIUS) {
                travel = (wall - GRENADE_RADIUS).max(0.0);
                self.grenade_vx = 0.0;
                self.grenade_vy = 0.0;
            }
            if (reached_range) {
                self.grenade_vx = 0.0;
                self.grenade_vy = 0.0;
            }
            self.grenade_x = self.grenade_x + dx * travel;
            self.grenade_y = self.grenade_y + dy * travel;
            self.grenade_travel = self.grenade_travel + travel;
        }
        self.grenade_fuse = self.grenade_fuse - 1;
        if (self.grenade_fuse > 0)
            return;
        self.grenade_active = false;
        self.blast_ticks = GRENADE_BLAST_TICKS;
        for (let var side = 0; side < 2; ++side) {
            let target = self.fighters[side];
            let dx = target.x - self.grenade_x;
            let dy = target.y - self.grenade_y;
            let distance = (dx * dx + dy * dy).sqrt();
            if (distance < GRENADE_BLAST_RADIUS &&
                (distance <= 0.000001 ||
                 self.arena.wall_distance(self.grenade_x, self.grenade_y,
                                          dx / distance, dy / distance) >= distance))
                self.deal_damage(self.grenade_thrower, side,
                                 GRENADE_DAMAGE * (1.0 - distance / GRENADE_BLAST_RADIUS));
        }
    }

    step(self) {
        if (self.needs_reset) {
            self.episode = self.episode + 1;
            self.reset_episode();
        }
        let grenade_was_active = self.grenade_active;
        if (self.blast_ticks > 0)
            self.blast_ticks = self.blast_ticks - 1;
        let rng = self.rng;
        let a = self.fighters[0];
        let b = self.fighters[1];
        a.recover();
        b.recover();
        a.sense(self.arena, b, self.gun_available, self.gun_x, self.gun_y,
                self.kit_available, self.kit_x, self.kit_y,
                self.grenade_available, self.grenade_x, self.grenade_y,
                self.grenade_active, self.grenade_x, self.grenade_y, self.tick, rng);
        b.sense(self.arena, a, self.gun_available, self.gun_x, self.gun_y,
                self.kit_available, self.kit_x, self.kit_y,
                self.grenade_available, self.grenade_x, self.grenade_y,
                self.grenade_active, self.grenade_x, self.grenade_y, self.tick, rng);
        if (a.inputs.get_f32(OPPONENT_INPUT) > 0.5)
            self.saw_opponent[0] = true;
        if (b.inputs.get_f32(OPPONENT_INPUT) > 0.5)
            self.saw_opponent[1] = true;
        let aa = a.think();
        let ba = b.think();
        a.move(self.arena, aa);
        b.move(self.arena, ba);

        // Resolve body overlap symmetrically so neither side can walk
        // through its opponent or gain priority from acting first.
        let dx = b.x - a.x;
        let dy = b.y - a.y;
        let distance = (dx * dx + dy * dy).sqrt();
        if (distance < 2.0 * BODY_RADIUS && distance > 0.000001) {
            let push = (2.0 * BODY_RADIUS - distance) * 0.5 / distance;
            a.push(self.arena, -dx * push, -dy * push);
            b.push(self.arena, dx * push, dy * push);
            let nx = dx / distance;
            let ny = dy / distance;
            let closing_speed = (a.vx - b.vx) * nx + (a.vy - b.vy) * ny;
            if (closing_speed > 0.0) {
                a.vx = a.vx - nx * closing_speed * 0.5;
                a.vy = a.vy - ny * closing_speed * 0.5;
                b.vx = b.vx + nx * closing_speed * 0.5;
                b.vy = b.vy + ny * closing_speed * 0.5;
            }
        }
        self.track_coverage();

        self.pickup_gun();
        self.pickup_health_kit();
        self.pickup_grenade();
        let threw_a = self.throw_grenade(a, aa[4], 0);
        let threw_b = self.throw_grenade(b, ba[4], 1);
        let hit_a = a.strikes(self.arena, b, threw_a ? 0.0 : aa[3]);
        let hit_b = b.strikes(self.arena, a, threw_b ? 0.0 : ba[3]);
        self.deal_damage(0, 1, hit_a);
        self.deal_damage(1, 0, hit_b);
        if (grenade_was_active)
            self.advance_grenade();
        self.tick = self.tick + 1;

        if (a.health <= 0.0 || b.health <= 0.0 || self.tick >= EPISODE_TICKS) {
            if (b.health <= 0.0)
                self.kills[0] = self.kills[0] + 1;
            if (a.health <= 0.0)
                self.kills[1] = self.kills[1] + 1;
            if ((a.health <= 0.0) == (b.health <= 0.0)) {
                let winner = self.episode_tiebreak_winner();
                if (winner >= 0)
                    self.tiebreak_wins[winner] = self.tiebreak_wins[winner] + 1;
            }
            if (self.episode + 1 == EPISODES)
                self.done = true;
            else
                self.needs_reset = true;
        }
    }
}

fun check_room_connected(arena) {
    let visited = Array.with_size(arena.width * arena.height, false);
    let var start = -1;
    for (let var y = 1; y <= arena.inner_h; ++y)
        for (let var x = 1; x <= arena.inner_w; ++x)
            if (!arena.solid(x, y))
                start = y * arena.width + x;
    assert(start >= 0);
    let queue = [start];
    visited[start] = true;
    for (let var head = 0; head < queue.len; ++head) {
        let cell = queue[head];
        let x = cell % arena.width;
        let y = cell.idiv(arena.width);
        let neighbours = [[x - 1, y], [x + 1, y], [x, y - 1], [x, y + 1]];
        for (let var i = 0; i < neighbours.len; ++i) {
            let nx = neighbours[i][0];
            let ny = neighbours[i][1];
            if (arena.solid(nx, ny))
                continue;
            let next = ny * arena.width + nx;
            if (!visited[next]) {
                visited[next] = true;
                queue.push(next);
            }
        }
    }
    for (let var y = 1; y <= arena.inner_h; ++y)
        for (let var x = 1; x <= arena.inner_w; ++x)
            assert(arena.solid(x, y) || visited[y * arena.width + x]);
}

fun check_maps() {
    let barrier = Arena(5, 5, nil);
    assert(!barrier.try_cover(3, 1, 1, 5));
    for (let var y = 1; y <= 5; ++y)
        assert(!barrier.solid(3, y));
    assert(!barrier.try_cover(1, 1, 5, 5));
    assert(barrier.connected());
    assert(barrier.try_cover(2, 1, 1, 1));
    // A diagonal-only exit cannot rescue the corner at (1, 1).
    assert(!barrier.try_cover(1, 2, 1, 1));
    assert(!barrier.solid(1, 2) && barrier.solid(2, 1));
    assert(!barrier.try_cover(2, 1, 1, 2));
    assert(!barrier.solid(2, 2) && barrier.solid(2, 1));
    let pillar = Arena(5, 5, nil);
    assert(pillar.try_cover(2, 2, 1, 1));
    check_room_connected(pillar);

    let individual = Individual(ByteArray.with_size(NUM_WEIGHTS * 4), 0, "MAP", [80, 201, 255],
                                [INITIAL_MUTATION_RATE, INITIAL_MUTATION_RATE],
                                [INITIAL_MUTATION_STRENGTH, INITIAL_MUTATION_STRENGTH]);
    let duel = Match(individual, individual, 123);
    let var saw_open = false;
    let var saw_pillar = false;
    let var saw_wall = false;
    let var saw_square = false;
    let var saw_deep_recess = false;
    let var maps = 0;
    for (let var w = 5; w <= 10; ++w) {
        for (let var h = 5; h <= 10; ++h) {
            for (let var seed = 0; seed < 64; ++seed) {
                let map_seed = seed * 7919 + 12345;
                let arena = Arena(w, h, Xoshiro128(map_seed));
                let replay = Arena(w, h, Xoshiro128(map_seed));
                for (let var cell = 0; cell < arena.width * arena.height; ++cell)
                    assert(arena.tiles.get_u32(cell) == replay.tiles.get_u32(cell));
                assert(arena.connected());
                check_room_connected(arena);
                let var occupied = 0;
                for (let var y = 1; y <= h; ++y) {
                    for (let var x = 1; x <= w; ++x) {
                        if (arena.solid(x, y)) {
                            occupied = occupied + 1;
                            if (x > 1 && x < w && y > 1 && y < h) {
                                if (!arena.solid(x - 1, y) && !arena.solid(x + 1, y) &&
                                    !arena.solid(x, y - 1) && !arena.solid(x, y + 1))
                                    saw_pillar = true;
                                if ((x + 1 < w && arena.solid(x + 1, y)) ||
                                    (y + 1 < h && arena.solid(x, y + 1)))
                                    saw_wall = true;
                                if (x + 1 < w && y + 1 < h && arena.solid(x + 1, y) &&
                                    arena.solid(x, y + 1) && arena.solid(x + 1, y + 1))
                                    saw_square = true;
                            }
                            if ((x == 1 && arena.solid(2, y)) ||
                                (x == w && arena.solid(w - 1, y)) ||
                                (y == 1 && arena.solid(x, 2)) ||
                                (y == h && arena.solid(x, h - 1)))
                                saw_deep_recess = true;
                            continue;
                        }
                        // Verify physical body clearance along each flood-fill edge.
                        assert(!arena.blocked(x.to_f() + 0.5, y.to_f() + 0.5));
                        for (let var step = 1; step <= 4; ++step) {
                            let offset = step.to_f() * 0.25;
                            if (!arena.solid(x + 1, y))
                                assert(!arena.blocked(x.to_f() + 0.5 + offset, y.to_f() + 0.5));
                            if (!arena.solid(x, y + 1))
                                assert(!arena.blocked(x.to_f() + 0.5, y.to_f() + 0.5 + offset));
                        }
                    }
                }
                assert(occupied <= (w * h * MAX_OBSTACLE_FRACTION).floor());
                if (occupied == 0)
                    saw_open = true;
                duel.arena = arena;
                for (let var episode = 0; episode < 3; ++episode) {
                    duel.reset_episode();
                    let a = duel.fighters[0];
                    let b = duel.fighters[1];
                    assert(!arena.blocked(a.x, a.y) && !arena.blocked(b.x, b.y));
                    assert(!arena.blocked(duel.gun_x, duel.gun_y));
                    assert(!arena.blocked(duel.kit_x, duel.kit_y));
                    assert(!arena.blocked(duel.grenade_x, duel.grenade_y));
                    assert((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y) >= 4.0);
                }
                maps = maps + 1;
            }
        }
    }
    assert(saw_open && saw_pillar && saw_wall && saw_square && saw_deep_recess);
    $println("map checks passed: " + maps.to_s() + " layouts, 3 spawn rounds each");
}

if (has_flag("--check-maps")) {
    check_maps();
    $exit(0);
}

fun energy_scenario(individual, movement, attack_interval) {
    let arena = Arena(20, 20, nil);
    let fighter = Fighter(individual);
    let enemy = Fighter(individual);
    fighter.reset(10.0, 10.0, 0.0);
    enemy.reset(15.0, 10.0, 0.0);
    let var attacks = 0;
    let var first_denied_attack = -1;
    let var distance = 0.0;
    for (let var tick = 0; tick < EPISODE_TICKS; ++tick) {
        fighter.recover();
        fighter.move(arena, [movement, 0.0, 0.0, 0.0]);
        distance = distance + fighter.x - 10.0;
        if (attack_interval > 0 && tick % attack_interval == 0 && fighter.cooldown == 0) {
            fighter.strikes(arena, enemy, 1.0);
            if (fighter.cooldown > 0)
                attacks = attacks + 1;
            else if (first_denied_attack < 0)
                first_denied_attack = tick;
        }
        assert(fighter.energy >= 0.0 && fighter.energy <= MAX_ENERGY);
        // Simulate open ground; misses still spend energy, without ending the episode.
        fighter.x = 10.0;
        fighter.y = 10.0;
    }
    return {energy: fighter.energy, attacks: attacks,
            first_denied_attack: first_denied_attack, distance: distance};
}

fun check_energy() {
    let individual = Individual(ByteArray.with_size(NUM_WEIGHTS * 4), 0, "ENERGY", [80, 201, 255],
                                [INITIAL_MUTATION_RATE, INITIAL_MUTATION_RATE],
                                [INITIAL_MUTATION_STRENGTH, INITIAL_MUTATION_STRENGTH]);
    let fighter = Fighter(individual);
    let enemy = Fighter(individual);
    let arena = Arena(20, 20, nil);
    let rng = Xoshiro128(123);
    let forward = [1.0, 0.0, 0.0, 0.0];
    let idle = [0.0, 0.0, 0.0, 0.0];

    assert(fighter.energy == MAX_ENERGY);
    fighter.recover();
    assert(fighter.energy == MAX_ENERGY);
    fighter.energy = 0.0;
    fighter.recover();
    assert((fighter.energy - RECOVERY_POWER * DT).abs() < 0.000001);
    fighter.energy = MAX_ENERGY - 1.0;
    fighter.recover();
    assert(fighter.energy == MAX_ENERGY);
    for (let var i = 0; i <= 2; ++i) {
        fighter.energy = MAX_ENERGY * i.to_f() * 0.5;
        fighter.sense(arena, enemy, false, 0.0, 0.0, false, 0.0, 0.0,
                      false, 0.0, 0.0, false, 0.0, 0.0, 0, rng);
        assert(fighter.inputs.get_f32(ENERGY_INPUT) == i.to_f() * 0.5);
        assert(fighter.inputs.get_f32(NUM_SENSORS - 1) == 1.0);
    }

    // Starting from rest costs both kinetic energy and locomotion over the step.
    fighter.reset(10.0, 10.0, 0.0);
    fighter.move(arena, forward);
    let launch_cost = 0.5 * BODY_MASS * FORWARD_ACCEL * FORWARD_ACCEL * DT * DT +
                      BODY_MASS * LOCOMOTION_J_PER_KG_METRE * FORWARD_ACCEL * DT * DT;
    assert((MAX_ENERGY - fighter.energy - launch_cost).abs() < 0.000001);
    fighter.reset(10.0, 10.0, 0.0);
    let half_speed = FORWARD_ACCEL * DT * 0.5;
    fighter.energy = 0.5 * BODY_MASS * half_speed * half_speed +
                     BODY_MASS * LOCOMOTION_J_PER_KG_METRE * half_speed * DT;
    fighter.move(arena, forward);
    assert((fighter.vx - FORWARD_ACCEL * DT * 0.5).abs() < 0.000001);
    assert(fighter.energy >= 0.0 && fighter.energy < 0.000001);
    fighter.reset(10.0, 10.0, 0.0);
    fighter.energy = 0.0;
    fighter.move(arena, forward);
    assert(fighter.vx == 0.0 && fighter.x == 10.0 && fighter.energy == 0.0);
    fighter.move(arena, [0.0, 1.0, 0.0, 0.0]);
    assert(fighter.turn_velocity > 0.0 && fighter.energy == 0.0);

    // Exhausted agents coast to a stop instead of erasing their momentum instantly.
    fighter.reset(10.0, 10.0, 0.0);
    fighter.energy = 0.0;
    fighter.vx = MAX_FORWARD;
    fighter.move(arena, idle);
    assert((fighter.vx - MAX_FORWARD * (1.0 - LINEAR_DRAG * DT)).abs() < 0.000001);
    assert(fighter.energy == 0.0);
    fighter.reset(10.0, 10.0, 0.0);
    fighter.vx = MAX_FORWARD;
    fighter.move(arena, forward);
    assert(fighter.vx == MAX_FORWARD);
    // Constant speed charges only locomotion, not artificial drag or clipped acceleration.
    assert((MAX_ENERGY - fighter.energy -
            BODY_MASS * LOCOMOTION_J_PER_KG_METRE * MAX_FORWARD * DT).abs() < 0.000001);
    fighter.move(arena, [-1.0, 0.0, 0.0, 0.0]);
    assert(fighter.energy < MAX_ENERGY && fighter.energy >= 0.0);

    // Sustained running drains the burst reserve, then settles at a lower speed.
    fighter.reset(10.0, 10.0, 0.0);
    for (let var tick = 0; tick < 600; ++tick) {
        fighter.recover();
        fighter.move(arena, forward);
        assert(fighter.energy >= 0.0 && fighter.energy <= MAX_ENERGY);
        assert(fighter.vx >= 0.0 && fighter.vx <= MAX_FORWARD);
        // Keep this effort test away from walls without changing velocity.
        fighter.x = 10.0;
        fighter.y = 10.0;
    }
    assert(fighter.energy < RECOVERY_POWER * DT);
    assert(fighter.vx > 0.0 && fighter.vx < MAX_FORWARD * 0.75);
    for (let var tick = 0; tick < 1100; ++tick) {
        fighter.recover();
        fighter.move(arena, idle);
    }
    assert(fighter.energy == MAX_ENERGY);

    // Insufficient energy must not consume ammunition or start an attack cooldown.
    fighter.reset(10.0, 10.0, 0.0);
    enemy.reset(11.0, 10.0, 0.0);
    fighter.energy = STAB_ENERGY - 1.0;
    assert(fighter.strikes(arena, enemy, 1.0) == 0.0);
    assert(fighter.cooldown == 0 && fighter.attack_ticks == 0);
    assert(fighter.energy == STAB_ENERGY - 1.0);
    fighter.energy = STAB_ENERGY;
    assert(fighter.strikes(arena, enemy, 0.49) == 0.0);
    assert(fighter.strikes(arena, enemy, 0.5) == 0.0);
    assert(fighter.energy == STAB_ENERGY && fighter.cooldown == 0);
    assert(fighter.strikes(arena, enemy, 0.51) == KNIFE_DAMAGE);
    assert(fighter.energy == 0.0 && fighter.cooldown == ATTACK_COOLDOWN);
    fighter.cooldown = 0;
    fighter.energy = STAB_ENERGY;
    enemy.reset(15.0, 10.0, 0.0);
    assert(fighter.strikes(arena, enemy, 1.0) == 0.0);
    assert(fighter.energy == 0.0 && fighter.attack_ticks == ATTACK_ANIM_TICKS);
    fighter.cooldown = 0;
    fighter.gun_ammo = GUN_AMMO;
    assert(fighter.strikes(arena, enemy, 1.0) == 0.0);
    assert(fighter.gun_ammo == GUN_AMMO && fighter.cooldown == 0);
    fighter.energy = SHOT_ENERGY;
    assert(fighter.strikes(arena, enemy, 1.0) == GUN_DAMAGE);
    assert(fighter.energy == 0.0 && fighter.gun_ammo == GUN_AMMO - 1);

    // A network driven only by the energy sensor sees this tick's recovery.
    individual.weights.set_f32(ENERGY_INPUT, 1.0);
    individual.weights.set_f32(OUTPUT_BASE, 1.0);
    let duel = Match(individual, individual, 7);
    for (let var i = 0; i < 2; ++i)
        duel.fighters[i].energy = 0.0;
    duel.step();
    for (let var i = 0; i < 2; ++i) {
        let agent = duel.fighters[i];
        assert((agent.inputs.get_f32(ENERGY_INPUT) - RECOVERY_POWER * DT / MAX_ENERGY).abs() < 0.000001);
        assert(agent.action[0] > 0.0);
        assert(agent.energy > 0.0 && agent.energy < RECOVERY_POWER * DT);
    }
    duel.reset_episode();
    assert(duel.fighters[0].energy == MAX_ENERGY && duel.fighters[1].energy == MAX_ENERGY);

    let rushing = energy_scenario(individual, 1.0, 1);
    let running = energy_scenario(individual, 1.0, 0);
    let selective = energy_scenario(individual, 0.3, 20);
    let stationary = energy_scenario(individual, 0.0, 1);
    assert(rushing.first_denied_attack >= 0 && rushing.first_denied_attack < 100);
    assert(rushing.attacks < EPISODE_TICKS.idiv(ATTACK_COOLDOWN));
    assert(running.distance > rushing.distance);
    assert(selective.first_denied_attack == -1 && selective.attacks == EPISODE_TICKS.idiv(20));
    assert(selective.energy > MAX_ENERGY * 0.8);
    assert(stationary.first_denied_attack >= 0 && stationary.energy < STAB_ENERGY);
    $println("Run + stab: first denied attack at " +
             (rushing.first_denied_attack.to_f() * DT).to_s() + "s, " +
             rushing.attacks.to_s() + " attacks in 30s");
    $println("Slow + selective: " + selective.attacks.to_s() + " attacks, " +
             selective.energy.floor().to_s() + " J remaining");
    $println("energy checks passed");
}

if (has_flag("--check-energy")) {
    check_energy();
    $exit(0);
}

fun check_movement() {
    let fighter = Fighter(Individual(ByteArray.with_size(NUM_WEIGHTS * 4), 0, "TEST", [80, 201, 255],
                                     [INITIAL_MUTATION_RATE, INITIAL_MUTATION_RATE],
                                     [INITIAL_MUTATION_STRENGTH, INITIAL_MUTATION_STRENGTH]));
    let arena = Arena(20, 20, nil);
    let vision_arena = Arena(20, 20, nil);
    let enemy = Fighter(fighter.individual);
    let forward = [1.0, 0.0, 0.0, 0.0];
    let idle = [0.0, 0.0, 0.0, 0.0];

    assert(RAY_ANGLE[VIEW_MIDDLE] == 0.0);
    assert((RAY_ANGLE[0] + VIEW_HALF_ANGLE).abs() < 0.0001);
    assert((RAY_ANGLE[VIEW_BINS - 1] - VIEW_HALF_ANGLE).abs() < 0.0001);

    let memory_weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    memory_weights.set_f32(NUM_SENSORS - 1, 1.0);
    memory_weights.set_f32(NUM_INPUTS + NUM_SENSORS, 1.0);
    memory_weights.set_f32(OUTPUT_BASE, 1.0);
    memory_weights.set_f32(OUTPUT_BASE + HIDDEN + 1, 1.0);
    memory_weights.set_f32(RECURRENT_BASE, 1.0);
    let remembering = Fighter(Individual(memory_weights, 0, "MEMORY", [255, 155, 87],
                                        [INITIAL_MUTATION_RATE, INITIAL_MUTATION_RATE],
                                        [INITIAL_MUTATION_STRENGTH, INITIAL_MUTATION_STRENGTH]));
    let var actions = remembering.think();
    assert(actions[0] == 0.5 && actions[1] == 0.0);
    assert(remembering.inputs.get_f32(NUM_SENSORS) == 0.5);
    actions = remembering.think();
    assert(actions[0] == 0.5 && (actions[1] - 1.0 / 3.0).abs() < 0.000001);
    remembering.reset(2.0, 2.0, 0.0);
    assert(remembering.inputs.get_f32(NUM_SENSORS) == 0.0);
    actions = remembering.think();
    assert(actions[1] == 0.0 && remembering.inputs.get_f32(NUM_SENSORS) == 0.5);
    memory_weights.set_f32(RECURRENT_BASE, -1.0);
    remembering.reset(2.0, 2.0, 0.0);
    remembering.think();
    assert(remembering.inputs.get_f32(NUM_SENSORS) == -0.5);
    let memory_duel = Match(fighter.individual, fighter.individual, 7);
    for (let var side = 0; side < 2; ++side)
        for (let var unit = 0; unit < RECURRENT; ++unit)
            memory_duel.fighters[side].inputs.set_f32(NUM_SENSORS + unit, 0.75);
    memory_duel.needs_reset = true;
    memory_duel.step();
    assert(memory_duel.episode == 1);
    assert(memory_duel.fighters[0].inputs.get_f32(TIME_INPUT) == 0.0);
    for (let var side = 0; side < 2; ++side)
        for (let var unit = 0; unit < RECURRENT; ++unit)
            assert(memory_duel.fighters[side].inputs.get_f32(NUM_SENSORS + unit) == 0.0);
    memory_duel.step();
    assert((memory_duel.fighters[0].inputs.get_f32(TIME_INPUT) -
            1.0 / (EPISODE_TICKS - 1).to_f()).abs() < 0.000001);

    fighter.reset(10.0, 10.0, 0.0);
    enemy.reset(13.0, 10.0, 0.0);
    fighter.sense(vision_arena, enemy, true, 12.0, 10.0,
                  true, 12.0, 12.0, true, 12.0, 10.0,
                  true, 12.0, 10.0, 0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(OPPONENT_INPUT) == 1.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 2) > 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 3) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT) == 1.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 2) > 0.0);
    assert(fighter.inputs.get_f32(HEALTH_KIT_INPUT) == 1.0);
    assert((fighter.inputs.get_f32(HEALTH_KIT_INPUT + 1) - 0.75).abs() < 0.0001);
    assert(fighter.inputs.get_f32(HEALTH_KIT_INPUT + 2) > 0.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT) == 1.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT + 2) > 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT) == 1.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT + 2) > 0.0);
    assert(fighter.inputs.get_f32(TIME_INPUT) == 0.0);
    enemy.gun_ammo = GUN_AMMO;
    fighter.sense(vision_arena, enemy, true, 12.0, 10.0,
                  true, 12.0, 12.0, true, 12.0, 10.0,
                  true, 12.0, 10.0, EPISODE_TICKS.idiv(2), Xoshiro128(1));
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 3) == 1.0);
    assert((fighter.inputs.get_f32(TIME_INPUT) -
            EPISODE_TICKS.idiv(2).to_f() / (EPISODE_TICKS - 1).to_f()).abs() < 0.000001);
    enemy.gun_ammo = 0;
    let peripheral = 55.0 * PI / 180.0;
    enemy.reset(10.0 + 5.0 * peripheral.cos(), 10.0 + 5.0 * peripheral.sin(), 0.0);
    fighter.sense(vision_arena, enemy, false, 0.0, 0.0,
                  false, 0.0, 0.0, false, 0.0, 0.0,
                  true, 12.0, 10.0, EPISODE_TICKS - 1, Xoshiro128(1));
    assert(fighter.inputs.get_f32(OPPONENT_INPUT) == 1.0);
    assert((fighter.inputs.get_f32(OPPONENT_INPUT + 1) - 55.0 / 60.0).abs() < 0.0001);
    assert(fighter.inputs.get_f32(PICKUP_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(HEALTH_KIT_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(HEALTH_KIT_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(HEALTH_KIT_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT) == 1.0);
    assert(fighter.inputs.get_f32(TIME_INPUT) == 1.0);
    enemy.reset(13.0, 10.0, 0.0);
    enemy.gun_ammo = GUN_AMMO;
    vision_arena.add_notch(12, 10);
    fighter.sense(vision_arena, enemy, true, 13.0, 10.0,
                  true, 13.0, 10.0, true, 13.0, 10.0,
                  true, 13.0, 10.0, 0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(OPPONENT_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 3) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(HEALTH_KIT_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(HEALTH_KIT_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(HEALTH_KIT_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(GRENADE_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(VIEW_MIDDLE) > 0.0);
    fighter.sense(arena, enemy, false, 0.0, 0.0,
                  false, 0.0, 0.0, false, 0.0, 0.0,
                  false, 13.0, 10.0, 0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT + 2) == 0.0);
    fighter.sense(arena, enemy, false, 0.0, 0.0,
                  false, 0.0, 0.0, false, 0.0, 0.0,
                  true, 10.0, 10.0, 0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT) == 1.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(THROWN_GRENADE_INPUT + 2) == 1.0);

    fighter.reset(10.0, 10.0, 0.0);
    enemy.reset(13.0, 10.0, 0.0);
    fighter.gun_ammo = GUN_AMMO;
    fighter.sense(arena, enemy, false, 0.0, 0.0,
                  false, 0.0, 0.0, false, 0.0, 0.0,
                  false, 0.0, 0.0, 0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(VIEW_INPUTS + 6) == 1.0);
    fighter.grenade_held = true;
    fighter.sense(arena, enemy, false, 0.0, 0.0,
                  false, 0.0, 0.0, false, 0.0, 0.0,
                  false, 0.0, 0.0, 0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(VIEW_INPUTS + 7) == 1.0);
    fighter.grenade_held = false;
    assert(fighter.strikes(arena, enemy, 1.0) == GUN_DAMAGE);
    assert(fighter.gun_ammo == GUN_AMMO - 1 && fighter.shot_ticks == SHOT_TRACE_TICKS);
    assert((fighter.shot_end_x - (enemy.x - BODY_RADIUS)).abs() < 0.0001);
    for (let var shot = 1; shot < GUN_AMMO; ++shot) {
        fighter.cooldown = 0;
        assert(fighter.strikes(arena, enemy, 1.0) == GUN_DAMAGE);
    }
    assert(fighter.gun_ammo == 0);
    fighter.cooldown = 0;
    fighter.gun_ammo = 1;
    assert(fighter.strikes(vision_arena, enemy, 1.0) == 0.0);
    assert(fighter.gun_ammo == 0 && fighter.shot_end_x <= 12.0);
    fighter.cooldown = 0;
    enemy.reset(11.0, 10.0, 0.0);
    assert(fighter.strikes(arena, enemy, 1.0) == KNIFE_DAMAGE);

    let pickup = Match(fighter.individual, fighter.individual, 7);
    pickup.gun_x = pickup.fighters[0].x;
    pickup.gun_y = pickup.fighters[0].y;
    pickup.pickup_gun();
    assert(!pickup.gun_available && pickup.fighters[0].gun_ammo == GUN_AMMO);
    pickup.reset_episode();
    assert(pickup.gun_available && pickup.fighters[0].gun_ammo == 0);
    pickup.kit_x = pickup.fighters[0].x;
    pickup.kit_y = pickup.fighters[0].y;
    pickup.pickup_health_kit();
    assert(pickup.kit_available && pickup.fighters[0].health == HEALTH);
    pickup.fighters[0].health = 40.0;
    pickup.pickup_health_kit();
    assert(!pickup.kit_available && pickup.fighters[0].health == 90.0);
    pickup.reset_episode();
    assert(pickup.kit_available && pickup.fighters[0].health == HEALTH);
    pickup.kit_x = pickup.fighters[0].x;
    pickup.kit_y = pickup.fighters[0].y;
    pickup.fighters[0].health = 80.0;
    pickup.pickup_health_kit();
    assert(!pickup.kit_available && pickup.fighters[0].health == HEALTH);
    pickup.arena = Arena(30, 30, nil);
    pickup.fighters[0].reset(10.0, 10.0, 0.0);
    pickup.fighters[1].reset(15.0, 10.0, 0.0);
    pickup.grenade_x = 10.0;
    pickup.grenade_y = 10.0;
    pickup.pickup_grenade();
    assert(!pickup.grenade_available && pickup.fighters[0].grenade_held);
    assert(!pickup.throw_grenade(pickup.fighters[0], 0.5, 0));
    assert(pickup.throw_grenade(pickup.fighters[0], 1.0, 0));
    assert(!pickup.fighters[0].grenade_held && pickup.grenade_active);
    assert(pickup.grenade_fuse == GRENADE_FUSE_TICKS);
    assert(pickup.fighters[0].energy == MAX_ENERGY - GRENADE_THROW_ENERGY);
    for (let var i = 0; i < GRENADE_FUSE_TICKS - 1; ++i)
        pickup.advance_grenade();
    assert(pickup.grenade_active && pickup.grenade_fuse == 1);
    pickup.advance_grenade();
    assert(!pickup.grenade_active && pickup.blast_ticks == GRENADE_BLAST_TICKS);
    assert((pickup.grenade_x - (15.0 - BODY_RADIUS - GRENADE_RADIUS)).abs() < 0.0001);
    assert(pickup.grenade_vx == 0.0 && pickup.grenade_travel < GRENADE_MAX_TRAVEL);
    assert(pickup.fighters[0].health == HEALTH && pickup.fighters[1].health < 0.0);

    let range_throw = Match(fighter.individual, fighter.individual, 11);
    range_throw.arena = Arena(30, 30, nil);
    range_throw.fighters[0].reset(10.0, 10.0, 0.0);
    range_throw.fighters[1].reset(22.0, 10.0, 0.0);
    range_throw.fighters[0].grenade_held = true;
    assert(range_throw.throw_grenade(range_throw.fighters[0], 1.0, 0));
    for (let var i = 0; i < GRENADE_FUSE_TICKS; ++i)
        range_throw.advance_grenade();
    assert((range_throw.grenade_x - 16.0).abs() < 0.0001);
    assert((range_throw.grenade_travel - GRENADE_MAX_TRAVEL).abs() < 0.0001);
    assert(range_throw.grenade_vx == 0.0 && range_throw.fighters[1].health == HEALTH);
    range_throw.fighters[0].reset(15.0, 10.0, 0.0);
    range_throw.fighters[1].reset(10.0, 10.0, 0.0);
    range_throw.fighters[1].angle = 0.0;
    range_throw.fighters[1].grenade_held = true;
    assert(range_throw.throw_grenade(range_throw.fighters[1], 1.0, 1));
    for (let var i = 0; i < GRENADE_FUSE_TICKS; ++i)
        range_throw.advance_grenade();
    assert((range_throw.grenade_x - (15.0 - BODY_RADIUS - GRENADE_RADIUS)).abs() < 0.0001);
    assert(range_throw.fighters[0].health < 0.0);

    let blast = Match(fighter.individual, fighter.individual, 8);
    blast.arena = Arena(30, 30, nil);
    blast.fighters[0].reset(10.0, 10.0, 0.0);
    blast.fighters[1].reset(11.5, 10.0, 0.0);
    blast.grenade_x = 10.0;
    blast.grenade_y = 10.0;
    blast.grenade_vx = 0.0;
    blast.grenade_vy = 0.0;
    blast.grenade_fuse = 1;
    blast.grenade_active = true;
    blast.advance_grenade();
    assert(blast.fighters[0].health == -100.0 && blast.fighters[1].health == 0.0);
    blast.fighters[1].reset(13.0, 10.0, 0.0);
    blast.grenade_fuse = 1;
    blast.grenade_active = true;
    blast.advance_grenade();
    assert(blast.fighters[1].health == HEALTH);
    let shielded_blast = Match(fighter.individual, fighter.individual, 12);
    shielded_blast.arena = Arena(5, 5, nil);
    shielded_blast.arena.add_notch(3, 3);
    shielded_blast.fighters[0].reset(2.5, 4.5, 0.0);
    shielded_blast.fighters[1].reset(4.5, 3.5, 0.0);
    shielded_blast.grenade_x = 2.5;
    shielded_blast.grenade_y = 3.5;
    shielded_blast.grenade_vx = 0.0;
    shielded_blast.grenade_vy = 0.0;
    shielded_blast.grenade_fuse = 1;
    shielded_blast.grenade_active = true;
    shielded_blast.advance_grenade();
    assert(shielded_blast.fighters[0].health < HEALTH);
    assert(shielded_blast.fighters[1].health == HEALTH);
    let throw_weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    throw_weights.set_f32(NUM_SENSORS - 1, 1.0);
    throw_weights.set_f32(OUTPUT_BASE + 4 * HIDDEN, 1.0);
    let throw_agent = Individual(throw_weights, 0, "THROW", [80, 201, 255],
                                 [INITIAL_MUTATION_RATE, INITIAL_MUTATION_RATE],
                                 [INITIAL_MUTATION_STRENGTH, INITIAL_MUTATION_STRENGTH]);
    let throw_match = Match(throw_agent, throw_agent, 9);
    throw_match.grenade_x = throw_match.fighters[0].x;
    throw_match.grenade_y = throw_match.fighters[0].y;
    throw_match.step();
    assert(!throw_match.grenade_available && throw_match.grenade_active);
    assert(!throw_match.fighters[0].grenade_held &&
           throw_match.grenade_fuse == GRENADE_FUSE_TICKS);
    throw_match.reset_episode();
    assert(throw_match.grenade_available && !throw_match.grenade_active &&
           !throw_match.fighters[0].grenade_held);
    let wall_throw = Match(fighter.individual, fighter.individual, 10);
    wall_throw.arena = Arena(5, 5, nil);
    wall_throw.grenade_x = 5.5;
    wall_throw.grenade_y = 3.5;
    wall_throw.grenade_vx = GRENADE_THROW_SPEED;
    wall_throw.grenade_vy = 0.0;
    wall_throw.grenade_fuse = 2;
    wall_throw.grenade_active = true;
    wall_throw.advance_grenade();
    assert(wall_throw.grenade_x <= 6.0 - GRENADE_RADIUS &&
           wall_throw.grenade_vx == 0.0);
    wall_throw.advance_grenade();
    assert(!wall_throw.grenade_active && wall_throw.blast_ticks == GRENADE_BLAST_TICKS);

    fighter.reset(10.0, 10.0, 0.0);
    fighter.move(arena, forward);
    assert((fighter.vx - FORWARD_ACCEL * DT).abs() < 0.0001);
    for (let var i = 0; i < 30; ++i)
        fighter.move(arena, forward);
    assert((fighter.vx - MAX_FORWARD).abs() < 0.0001);
    fighter.move(arena, idle);
    assert(fighter.vx < MAX_FORWARD && fighter.vx > 0.0);
    let before_brake = fighter.vx;
    fighter.move(arena, [-1.0, 0.0, 0.0, 0.0]);
    assert(before_brake - fighter.vx <= FORWARD_ACCEL * DT + 0.0001);

    fighter.reset(10.0, 10.0, 0.0);
    let strafe = [0.0, 0.0, 1.0, 0.0];
    for (let var i = 0; i < 30; ++i)
        fighter.move(arena, strafe);
    assert((fighter.vy - MAX_STRAFE).abs() < 0.0001);

    fighter.reset(10.0, 10.0, 0.0);
    let diagonal = [1.0, 0.0, 1.0, 0.0];
    for (let var i = 0; i < 30; ++i)
        fighter.move(arena, diagonal);
    assert((fighter.vx * fighter.vx + fighter.vy * fighter.vy).sqrt() <= MAX_FORWARD + 0.0001);

    fighter.reset(10.0, 10.0, 0.0);
    let turn = [0.0, 1.0, 0.0, 0.0];
    fighter.move(arena, turn);
    assert((fighter.turn_velocity - TURN_ACCEL * DT).abs() < 0.0001);
    for (let var i = 0; i < 20; ++i)
        fighter.move(arena, turn);
    assert((fighter.turn_velocity - MAX_TURN).abs() < 0.0001);
    fighter.move(arena, idle);
    assert(fighter.turn_velocity < MAX_TURN);

    fighter.reset(20.0 + 1.0 - BODY_RADIUS - 0.05, 10.0, 0.0);
    fighter.vx = MAX_FORWARD;
    fighter.move(arena, idle);
    assert(fighter.x <= 21.0 - BODY_RADIUS && fighter.vx == 0.0);

    let notched = Arena(5, 5, nil);
    notched.add_notch(3, 1);
    assert(notched.solid(3, 1) && !notched.solid(3, 2));
    assert(notched.blocked(3.5, 2.1) && !notched.blocked(4.5, 2.5));
    assert((notched.wall_distance(3.5, 3.0, 0.0, -1.0) - 1.0).abs() < 0.0001);
    fighter.reset(3.5, 2.5, -PI * 0.5);
    fighter.vy = -MAX_FORWARD;
    fighter.move(notched, idle);
    assert(fighter.y >= 2.0 + BODY_RADIUS && fighter.y < 2.5 && fighter.vy == 0.0);
    assert(!notched.blocked(fighter.x, fighter.y));
    let doorway = Arena(5, 5, nil);
    for (let var y = 1; y <= 5; ++y)
        if (y != 3)
            doorway.add_notch(3, y);
    assert(!doorway.blocked(3.5, 3.26));
    assert(doorway.blocked(3.5, 3.24));
    assert(doorway.door_on_ray(2.5, 3.5, 1.0, 0.0));
    assert(doorway.door_on_ray(4.5, 3.5, -1.0, 0.0));
    assert(!doorway.door_on_ray(2.5, 2.5, 1.0, 0.0));
    fighter.reset(2.5, 3.5, 0.0);
    fighter.sense(doorway, enemy, false, 0.0, 0.0,
                  false, 0.0, 0.0, false, 0.0, 0.0,
                  false, 0.0, 0.0, 0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(DOOR_INPUT) == 1.0);
    fighter.angle = PI * 0.5;
    fighter.sense(doorway, enemy, false, 0.0, 0.0,
                  false, 0.0, 0.0, false, 0.0, 0.0,
                  false, 0.0, 0.0, 0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(DOOR_INPUT) == 0.0);
    fighter.reset(2.5, 3.05, 0.0);
    for (let var i = 0; i < 30; ++i) {
        fighter.move(doorway, forward);
        assert(!doorway.blocked(fighter.x, fighter.y));
    }
    assert(fighter.x > 3.5 && fighter.y > 3.25 && fighter.y < 3.75);
    fighter.reset(4.5, 3.95, PI);
    for (let var i = 0; i < 30; ++i) {
        fighter.move(doorway, forward);
        assert(!doorway.blocked(fighter.x, fighter.y));
    }
    assert(fighter.x < 2.5 && fighter.y > 3.25 && fighter.y < 3.75);
    fighter.reset(2.5, 2.8, 0.0);
    for (let var i = 0; i < 30; ++i)
        fighter.move(doorway, forward);
    assert(fighter.x <= 3.0 - BODY_RADIUS && fighter.y == 2.8);
    let horizontal_doorway = Arena(5, 5, nil);
    for (let var x = 1; x <= 5; ++x)
        if (x != 3)
            horizontal_doorway.add_notch(x, 3);
    assert(horizontal_doorway.door_on_ray(3.5, 2.5, 0.0, 1.0));
    fighter.reset(3.05, 2.5, PI * 0.5);
    for (let var i = 0; i < 30; ++i) {
        fighter.move(horizontal_doorway, forward);
        assert(!horizontal_doorway.blocked(fighter.x, fighter.y));
    }
    assert(fighter.y > 3.5 && fighter.x > 3.25 && fighter.x < 3.75);
    let closed_wall = Arena(5, 5, nil);
    for (let var y = 1; y <= 5; ++y)
        closed_wall.add_notch(3, y);
    closed_wall.add_notch(5, 2);
    closed_wall.add_notch(5, 4);
    assert(!closed_wall.door_on_ray(2.5, 3.5, 1.0, 0.0));
    fighter.reset(2.5, 3.05, 0.0);
    for (let var i = 0; i < 30; ++i)
        fighter.move(closed_wall, forward);
    assert(fighter.x <= 3.0 - BODY_RADIUS && fighter.y == 3.05);

    let var saw_rectangle = false;
    for (let var seed = 0; seed < 20; ++seed) {
        let duel = Match(fighter.individual, fighter.individual, seed);
        let replay = Match(fighter.individual, fighter.individual, seed);
        assert(duel.arena.inner_w >= MIN_ROOM && duel.arena.inner_w <= MAX_ROOM);
        assert(duel.arena.inner_h >= MIN_ROOM && duel.arena.inner_h <= MAX_ROOM);
        if (duel.arena.inner_w != duel.arena.inner_h)
            saw_rectangle = true;
        for (let var tile = 0; tile < duel.arena.width * duel.arena.height; ++tile)
            assert(duel.arena.tiles.get_u32(tile) == replay.arena.tiles.get_u32(tile));
        assert(duel.fighters[0].x == replay.fighters[0].x);
        assert(duel.fighters[0].y == replay.fighters[0].y);
        assert(duel.gun_x == replay.gun_x && duel.gun_y == replay.gun_y);
        assert(duel.kit_x == replay.kit_x && duel.kit_y == replay.kit_y);
        assert(duel.grenade_x == replay.grenade_x && duel.grenade_y == replay.grenade_y);
        assert(!duel.arena.blocked(duel.gun_x, duel.gun_y));
        assert(!duel.arena.blocked(duel.kit_x, duel.kit_y));
        assert(!duel.arena.blocked(duel.grenade_x, duel.grenade_y));
        check_room_connected(duel.arena);
        for (let var tick = 0; tick < 3; ++tick) {
            duel.step();
            replay.step();
            assert(duel.fighters[0].x == replay.fighters[0].x);
            assert(duel.fighters[0].y == replay.fighters[0].y);
            assert(duel.fighters[1].x == replay.fighters[1].x);
            assert(duel.fighters[1].y == replay.fighters[1].y);
            assert(duel.gun_available == replay.gun_available);
            assert(duel.kit_available == replay.kit_available);
            assert(duel.grenade_available == replay.grenade_available);
            assert(duel.grenade_active == replay.grenade_active);
            assert(duel.grenade_x == replay.grenade_x &&
                   duel.grenade_y == replay.grenade_y);
            assert(duel.fighters[0].gun_ammo == replay.fighters[0].gun_ammo);
            assert(duel.fighters[0].grenade_held == replay.fighters[0].grenade_held);
            assert(duel.fighters[1].grenade_held == replay.fighters[1].grenade_held);
            assert(duel.fighters[0].health == replay.fighters[0].health);
            assert(duel.fighters[1].health == replay.fighters[1].health);
            assert(duel.fighters[0].energy == replay.fighters[0].energy);
            assert(duel.fighters[1].energy == replay.fighters[1].energy);
        }
        for (let var episode = 0; episode < EPISODES; ++episode) {
            let a = duel.fighters[0];
            let b = duel.fighters[1];
            let dx = b.x - a.x;
            let dy = b.y - a.y;
            assert(!duel.arena.blocked(a.x, a.y));
            assert(!duel.arena.blocked(b.x, b.y));
            assert(dx * dx + dy * dy >= 4.0);
            assert(!duel.arena.blocked(duel.gun_x, duel.gun_y));
            assert(!duel.arena.blocked(duel.kit_x, duel.kit_y));
            assert(!duel.arena.blocked(duel.grenade_x, duel.grenade_y));
            duel.reset_episode();
        }
    }
    if (MAX_ROOM > MIN_ROOM)
        assert(saw_rectangle);
    $println("movement and arena checks passed");
}

if (has_flag("--check-movement")) {
    let identity_rng = Xoshiro128(123);
    let parent = birth(identity_rng, nil);
    let original_color = parent.color();
    let var color_changed = false;
    for (let var i = 0; i < 100; ++i) {
        let child = birth(identity_rng, parent);
        assert(child.name.len >= 4 && child.name.len <= 8);
        assert(child.age == 0 && child.colors != parent.colors);
        for (let var channel = 0; channel < 3; ++channel) {
            assert(child.colors[channel] >= 80 && child.colors[channel] <= 255);
            assert((child.colors[channel] - parent.colors[channel]).abs() <= 16);
        }
        if (child.color() != original_color)
            color_changed = true;
    }
    assert(color_changed && parent.color() == original_color);
    check_movement();
    $exit(0);
}

class Island {
    init(self, index, seed, checkpoint) {
        self.index = index;
        self.rng = Xoshiro128(seed + index * 7919);
        self.population = [];
        if (checkpoint != nil) {
            let var ages = "";
            for (let var i = 0; i < POP_SIZE.min(checkpoint.individuals.len); ++i) {
                let restored = decode_individual(self.rng, checkpoint.individuals[i],
                                                 checkpoint.inputs, checkpoint.outputs);
                if (restored != nil) {
                    self.population.push(restored);
                    ages = ages + (ages.len == 0 ? "" : ", ") + restored.age.to_s();
                }
            }
            $println("Loaded island " + index.to_s() + " individual ages: " + ages);
        }
        let loaded_count = self.population.len;
        while (self.population.len < POP_SIZE) {
            let parent = loaded_count == 0 ? nil :
                         self.population[self.rng.index(loaded_count)];
            self.population.push(birth(self.rng, parent));
        }
        self.pending_migrants = [];
        self.matches = 0;
        self.episodes = 0;
        self.kills = 0;
        self.zero_matches = 0;
        self.migrants_sent = 0;
        self.migrants_received = 0;
        self.last_offer_ms = -MATCH_OFFER_INTERVAL_MS;
        self.duel = nil;
        self.pick_match();
    }

    pick_match(self) {
        let a = self.rng.index(POP_SIZE);
        let var b = self.rng.index(POP_SIZE - 1);
        if (b >= a)
            b = b + 1;
        self.first_idx = a;
        self.second_idx = b;
        self.duel = Match(self.population[a], self.population[b],
                          self.rng.index(2_147_483_647));
    }

    receive(self, migrant) {
        self.pending_migrants.push(migrant);
    }

    migration_donor(self) {
        return self.population[self.rng.index(self.population.len)];
    }

    // Offer a complete match only when the oldest resident is selected.
    // The viewer gets genomes and a seed, then simulates its own copy.
    match_offer(self, now) {
        if (self.duel.episode != 0 || self.duel.tick != 0 ||
            now < self.last_offer_ms + MATCH_OFFER_INTERVAL_MS)
            return nil;
        let var oldest = 0;
        for (let var i = 1; i < POP_SIZE; ++i) {
            if (self.population[i].age > self.population[oldest].age)
                oldest = i;
        }
        if (oldest != self.first_idx && oldest != self.second_idx)
            return nil;
        self.last_offer_ms = now;
        return {
            kind: "MATCH", index: self.index, match_no: self.matches + 1,
            seed: self.duel.seed, room_w: self.duel.arena.inner_w,
            room_h: self.duel.arena.inner_h,
            oldest_age: self.population[oldest].age,
            oldest_side: oldest == self.first_idx ? 0 : 1,
            first_weights: self.population[self.first_idx].weights,
            second_weights: self.population[self.second_idx].weights,
            first_age: self.population[self.first_idx].age,
            second_age: self.population[self.second_idx].age,
            first_name: self.population[self.first_idx].name,
            second_name: self.population[self.second_idx].name,
            first_colors: self.population[self.first_idx].colors,
            second_colors: self.population[self.second_idx].colors,
            first_rates: self.population[self.first_idx].mutation_rates,
            second_rates: self.population[self.second_idx].mutation_rates,
            first_strengths: self.population[self.first_idx].mutation_strengths,
            second_strengths: self.population[self.second_idx].mutation_strengths
        };
    }

    apply_migrants(self) {
        if (self.pending_migrants.len == 0)
            return;
        let var replaced = Array.with_size(POP_SIZE, false);
        for (let var m = 0; m < self.pending_migrants.len; ++m) {
            if (m > 0 && m % POP_SIZE == 0)
                replaced = Array.with_size(POP_SIZE, false);
            let start = self.rng.index(POP_SIZE);
            let var youngest = -1;
            for (let var i = 0; i < POP_SIZE; ++i) {
                let idx = (start + i) % POP_SIZE;
                if (!replaced[idx] &&
                    (youngest < 0 || self.population[idx].age < self.population[youngest].age))
                    youngest = idx;
            }
            let migrant = self.pending_migrants[m];
            self.population[youngest] = Individual(migrant[0], migrant[1], migrant[2], migrant[3],
                                                   migrant[4], migrant[5]);
            replaced[youngest] = true;
            self.migrants_received = self.migrants_received + 1;
        }
        self.pending_migrants.resize(0, nil);
    }

    reproduce(self, ka, kb, wa, wb) {
        for (let var i = 0; i < POP_SIZE; ++i)
            self.population[i].age = self.population[i].age + 1;
        if (ka != kb || wa != wb) {
            let win_first = ka > kb || (ka == kb && wa > wb);
            let winner_idx = win_first ? self.first_idx : self.second_idx;
            let loser_idx = win_first ? self.second_idx : self.first_idx;
            let winner = self.population[winner_idx];
            self.population[loser_idx] = birth(self.rng, winner);
        } else if (ka == 0 && POP_SIZE > 2) {
            let eligible = [];
            for (let var i = 0; i < POP_SIZE; ++i)
                if (i != self.first_idx && i != self.second_idx)
                    eligible.push(i);
            let donor_a = self.rng.index(eligible.len);
            let var donor_b = eligible.len > 1 ? self.rng.index(eligible.len - 1) : donor_a;
            if (eligible.len > 1 && donor_b >= donor_a)
                donor_b = donor_b + 1;
            let first_parent = self.population[eligible[donor_a]];
            let second_parent = self.population[eligible[donor_b]];
            self.population[self.first_idx] = birth(self.rng, first_parent);
            self.population[self.second_idx] = birth(self.rng, second_parent);
        } else {
            // Scoring draws leave mutated children of both fighters.
            self.population[self.first_idx] = birth(self.rng, self.population[self.first_idx]);
            self.population[self.second_idx] = birth(self.rng, self.population[self.second_idx]);
        }
    }

    step(self) {
        if (MAX_MATCHES > 0 && self.matches >= MAX_MATCHES)
            return false;
        self.duel.step();
        if (!self.duel.done)
            return false;

        let ka = self.duel.kills[0];
        let kb = self.duel.kills[1];
        self.reproduce(ka, kb, self.duel.tiebreak_wins[0], self.duel.tiebreak_wins[1]);
        self.matches = self.matches + 1;
        self.episodes = self.episodes + EPISODES;
        self.kills = self.kills + ka + kb;
        if (ka == 0 && kb == 0)
            self.zero_matches = self.zero_matches + 1;
        self.apply_migrants();
        if (MAX_MATCHES == 0 || self.matches < MAX_MATCHES)
            self.pick_match();
        return self.matches % MIGRATE_PERIOD == 0;
    }

    snapshot(self) {
        let var oldest = 0;
        let var age_sum = 0;
        for (let var i = 0; i < POP_SIZE; ++i) {
            oldest = oldest.max(self.population[i].age);
            age_sum = age_sum + self.population[i].age;
        }
        return {
            kind: "STATS", index: self.index,
            matches: self.matches, episodes: self.episodes,
            kills: self.kills, zero_matches: self.zero_matches,
            migrants_sent: self.migrants_sent, migrants_received: self.migrants_received,
            oldest: oldest, mean_age: age_sum.idiv(POP_SIZE)
        };
    }

    elite_snapshot(self) {
        let selected = Array.with_size(POP_SIZE, false);
        let individuals = [];
        for (let var rank = 0; rank < POP_SIZE.min(4); ++rank) {
            let var best = -1;
            for (let var i = 0; i < POP_SIZE; ++i) {
                if (!selected[i] &&
                    (best < 0 || self.population[i].age > self.population[best].age))
                    best = i;
            }
            selected[best] = true;
            let agent = self.population[best];
            individuals.push({age: agent.age, name: agent.name, colors: agent.colors,
                              weights: agent.weights, mutation_rates: agent.mutation_rates,
                              mutation_strengths: agent.mutation_strengths});
        }
        return {kind: "CHECKPOINT", index: self.index, matches: self.matches,
                individuals: individuals};
    }
}

if (has_flag("--check-evolution")) {
    let island = Island(0, 123, nil);
    let strategy_parent = island.population[0];
    assert(strategy_parent.mutation_rates[0] == 0.05 &&
           strategy_parent.mutation_rates[1] == 0.05);
    assert(strategy_parent.mutation_strengths[0] == 0.10 &&
           strategy_parent.mutation_strengths[1] == 0.10);
    let strategy_rng = Xoshiro128(456);
    let var rate_changes = 0;
    let var strength_changes = 0;
    for (let var child_no = 0; child_no < 300; ++child_no) {
        let child = birth(strategy_rng, strategy_parent);
        for (let var layer = 0; layer < 2; ++layer) {
            let rate = child.mutation_rates[layer];
            let strength = child.mutation_strengths[layer];
            assert(rate >= MIN_MUTATION_RATE && rate <= MAX_MUTATION_RATE);
            assert(strength >= MIN_MUTATION_STRENGTH && strength <= MAX_MUTATION_STRENGTH);
            assert(rate / strategy_parent.mutation_rates[layer] <= 0.15.exp() + 0.000001);
            assert(rate / strategy_parent.mutation_rates[layer] >= (-0.15).exp() - 0.000001);
            assert(strength / strategy_parent.mutation_strengths[layer] <= 0.15.exp() + 0.000001);
            assert(strength / strategy_parent.mutation_strengths[layer] >= (-0.15).exp() - 0.000001);
            if (rate != strategy_parent.mutation_rates[layer])
                rate_changes = rate_changes + 1;
            if (strength != strategy_parent.mutation_strengths[layer])
                strength_changes = strength_changes + 1;
        }
    }
    assert(rate_changes > 0 && strength_changes > 0);
    assert(strategy_parent.mutation_rates[0] == INITIAL_MUTATION_RATE &&
           strategy_parent.mutation_strengths[0] == INITIAL_MUTATION_STRENGTH);
    let low_parent = Individual(strategy_parent.weights, 0, "LOW", [80, 80, 80],
                                [0.001, 0.007], [0.02, 0.04]);
    for (let var i = 0; i < 20; ++i) {
        let child = birth(strategy_rng, low_parent);
        for (let var layer = 0; layer < 2; ++layer) {
            assert(child.mutation_rates[layer] >= MIN_MUTATION_RATE);
            assert(child.mutation_strengths[layer] >= MIN_MUTATION_STRENGTH);
        }
    }
    island.first_idx = 0;
    island.second_idx = 1;
    let var first = island.population[0];
    let var second = island.population[1];
    let bystander = island.population[2];
    for (let var i = 2; i < POP_SIZE; ++i) {
        island.population[i].mutation_rates = [0.087, 0.091];
        island.population[i].mutation_strengths = [0.21, 0.24];
    }
    island.reproduce(0, 0, 0, 0);
    assert(island.population[0] != first && island.population[1] != second);
    assert(island.population[0].age == 0 && island.population[1].age == 0);
    assert(island.population[0].weights != first.weights);
    assert(island.population[1].weights != second.weights);
    assert(island.population[0].mutation_rates[0] > 0.07 &&
           island.population[1].mutation_rates[0] > 0.07);
    assert(island.population[0].mutation_strengths[0] > 0.17 &&
           island.population[1].mutation_strengths[0] > 0.17);
    assert(island.population[2] == bystander && bystander.age == 1);
    let scoring_draw = Island(0, 789, nil);
    scoring_draw.first_idx = 0;
    scoring_draw.second_idx = 1;
    scoring_draw.population[0].mutation_rates = [0.02, 0.02];
    scoring_draw.population[1].mutation_rates = [0.02, 0.02];
    scoring_draw.reproduce(1, 1, 0, 0);
    assert(scoring_draw.population[0].mutation_rates[0] < 0.03 &&
           scoring_draw.population[1].mutation_rates[0] < 0.03);
    first = island.population[0];
    second = island.population[1];
    island.reproduce(2, 1, 0, 8);
    assert(island.population[0] == first && first.age == 1);
    assert(island.population[1] != second && island.population[1].age == 0);
    let coverage_match = Match(strategy_parent, strategy_parent, 19);
    coverage_match.min_x = [2.0, 2.0];
    coverage_match.max_x = [2.0, 2.0];
    coverage_match.min_y = [2.0, 2.0];
    coverage_match.max_y = [2.0, 2.0];
    coverage_match.fighters[1].x = 2.0;
    coverage_match.fighters[1].y = 2.0;
    coverage_match.fighters[0].x = 4.0;
    coverage_match.fighters[0].y = 5.0;
    coverage_match.track_coverage();
    assert((coverage_match.coverage(0) -
            6.0 / (coverage_match.arena.inner_w * coverage_match.arena.inner_h).to_f()).abs()
           < 0.000001);
    assert(coverage_match.coverage(1) == 0.0);
    coverage_match.damage_dealt = [10.0, 5.0];
    coverage_match.saw_opponent = [false, true];
    assert(coverage_match.episode_tiebreak_winner() == 0);
    coverage_match.damage_dealt = [0.0, 0.0];
    assert(coverage_match.episode_tiebreak_winner() == 1);
    coverage_match.saw_opponent = [false, false];
    assert(coverage_match.episode_tiebreak_winner() == 0);
    coverage_match.saw_opponent[0] = true;
    coverage_match.fighters[0].x = 5.0;
    coverage_match.fighters[0].y = 6.0;
    coverage_match.track_coverage();
    assert((coverage_match.coverage(0) -
            6.0 / (coverage_match.arena.inner_w * coverage_match.arena.inner_h).to_f()).abs()
           < 0.000001);
    coverage_match.reset_episode();
    assert(coverage_match.coverage(0) == 0.0 && coverage_match.coverage(1) == 0.0);
    assert(!coverage_match.saw_opponent[0] && !coverage_match.saw_opponent[1]);
    coverage_match.fighters[1].health = 10.0;
    coverage_match.deal_damage(0, 1, 34.0);
    coverage_match.deal_damage(0, 1, 34.0);
    coverage_match.deal_damage(0, 0, 12.0);
    assert(coverage_match.damage_dealt[0] == 10.0 && coverage_match.damage_dealt[1] == 0.0);
    coverage_match.reset_episode();
    assert(coverage_match.damage_dealt[0] == 0.0 && coverage_match.damage_dealt[1] == 0.0);
    let quiet = Individual(ByteArray.with_size(NUM_WEIGHTS * 4), 0, "QUIET", [80, 80, 80],
                           [INITIAL_MUTATION_RATE, INITIAL_MUTATION_RATE],
                           [INITIAL_MUTATION_STRENGTH, INITIAL_MUTATION_STRENGTH]);
    let tied_episode = Match(quiet, quiet, 21);
    tied_episode.damage_dealt[0] = 1.0;
    tied_episode.tick = EPISODE_TICKS - 1;
    tied_episode.step();
    assert(tied_episode.kills[0] == 0 && tied_episode.kills[1] == 0);
    assert(tied_episode.tiebreak_wins[0] == 1 && tied_episode.tiebreak_wins[1] == 0);
    tied_episode.step();
    assert(tied_episode.episode == 1 && tied_episode.damage_dealt[0] == 0.0);
    assert(tied_episode.tiebreak_wins[0] == 1);
    let exploring_draw = Island(0, 790, nil);
    exploring_draw.first_idx = 0;
    exploring_draw.second_idx = 1;
    let exploring_first = exploring_draw.population[0];
    let var exploring_second = exploring_draw.population[1];
    exploring_draw.reproduce(0, 0, 2, 1);
    assert(exploring_draw.population[0] == exploring_first && exploring_first.age == 1);
    assert(exploring_draw.population[1] != exploring_second &&
           exploring_draw.population[1].age == 0);
    exploring_second = exploring_draw.population[1];
    exploring_draw.reproduce(1, 1, 1, 2);
    assert(exploring_draw.population[0] != exploring_first &&
           exploring_draw.population[0].age == 0);
    assert(exploring_draw.population[1] == exploring_second && exploring_second.age == 1);
    let var saw_oldest = false;
    let var saw_younger = false;
    first.age = 1000;
    for (let var i = 0; i < 1000; ++i) {
        let donor = island.migration_donor();
        if (donor == first)
            saw_oldest = true;
        else
            saw_younger = true;
    }
    assert(saw_oldest && saw_younger);
    first.name = "MIGRANT";
    first.mutation_rates = [0.074, 0.093];
    first.mutation_strengths = [0.12, 0.18];
    island.receive([first.weights, first.age, first.name, first.colors,
                    first.mutation_rates, first.mutation_strengths]);
    island.apply_migrants();
    let var found = false;
    for (let var i = 0; i < POP_SIZE; ++i) {
        let candidate = island.population[i];
        if (candidate != first && candidate.name == "MIGRANT") {
            found = true;
            assert(candidate.mutation_rates[0] == 0.074 &&
                   candidate.mutation_rates[1] == 0.093);
            assert(candidate.mutation_strengths[0] == 0.12 &&
                   candidate.mutation_strengths[1] == 0.18);
        }
    }
    assert(found);
    $println("evolution checks passed");
    $exit(0);
}

if (has_flag("--check-checkpoint")) {
    let island = Island(0, 123, nil);
    for (let var i = 0; i < POP_SIZE; ++i)
        island.population[i].age = 0;
    island.population[0].age = 2;
    island.population[1].age = 100;
    island.population[2].age = 5;
    island.population[3].age = 99;
    island.population[4].age = 98;
    island.population[5].age = 97;
    island.population[1].mutation_rates = [0.071, 0.089];
    island.population[1].mutation_strengths = [0.11, 0.19];
    let elites = island.elite_snapshot();
    assert(elites.individuals.len == 4);
    assert(elites.individuals[0].age == 100 && elites.individuals[1].age == 99 &&
           elites.individuals[2].age == 98 && elites.individuals[3].age == 97);
    let encoded = encode_individual(elites.individuals[0]);
    let decoded = parse_json(format_json(encoded));
    assert(!(decoded instanceof Error));
    let restored = decode_individual(Xoshiro128(7), decoded, INPUT_NAMES, OUTPUT_NAMES);
    assert(restored.age == encoded.age && restored.name == encoded.name);
    for (let var c = 0; c < 3; ++c)
        assert(restored.colors[c] == encoded.colors[c]);
    assert(restored.mutation_rates[0] == 0.071 && restored.mutation_rates[1] == 0.089);
    assert(restored.mutation_strengths[0] == 0.11 &&
           restored.mutation_strengths[1] == 0.19);
    let stale = parse_json(format_json(encoded));
    stale.mutation_rates = [0.001, 0.007];
    stale.mutation_strengths = [0.02, 0.04];
    let lifted = decode_individual(Xoshiro128(7), stale, INPUT_NAMES, OUTPUT_NAMES);
    for (let var layer = 0; layer < 2; ++layer) {
        assert(lifted.mutation_rates[layer] == MIN_MUTATION_RATE);
        assert(lifted.mutation_strengths[layer] == MIN_MUTATION_STRENGTH);
    }
    for (let var i = 0; i < NUM_WEIGHTS; ++i)
        assert(restored.weights.get_f32(i) == elites.individuals[0].weights.get_f32(i));
    let loaded = Island(0, 123, {inputs: INPUT_NAMES, outputs: OUTPUT_NAMES,
                                  individuals: [encoded]});
    assert(loaded.population.len == POP_SIZE);
    assert(loaded.population[0].age == restored.age &&
           loaded.population[0].name == restored.name);
    for (let var c = 0; c < 3; ++c)
        assert(loaded.population[0].colors[c] == restored.colors[c]);
    for (let var layer = 0; layer < 2; ++layer) {
        assert(loaded.population[0].mutation_rates[layer] == restored.mutation_rates[layer]);
        assert(loaded.population[0].mutation_strengths[layer] ==
               restored.mutation_strengths[layer]);
    }
    for (let var i = 0; i < NUM_WEIGHTS; ++i)
        assert(loaded.population[0].weights.get_f32(i) == restored.weights.get_f32(i));
    for (let var i = 1; i < POP_SIZE; ++i) {
        let child = loaded.population[i];
        assert(child.age == 0);
        for (let var layer = 0; layer < 2; ++layer) {
            assert(child.mutation_rates[layer] > 0.06);
            assert(child.mutation_strengths[layer] > 0.09);
        }
        let var changed = false;
        for (let var w = 0; w < NUM_WEIGHTS; ++w)
            if (child.weights.get_f32(w) != restored.weights.get_f32(w))
                changed = true;
        assert(changed);
    }
    let saved_four = [];
    for (let var i = 0; i < elites.individuals.len; ++i)
        saved_four.push(encode_individual(elites.individuals[i]));
    let loaded_four = Island(0, 123, {inputs: INPUT_NAMES, outputs: OUTPUT_NAMES,
                                       individuals: saved_four});
    for (let var i = 0; i < saved_four.len; ++i) {
        assert(loaded_four.population[i].age == saved_four[i].age);
        assert(loaded_four.population[i].name == saved_four[i].name);
        for (let var w = 0; w < NUM_WEIGHTS; ++w)
            assert(loaded_four.population[i].weights.get_f32(w) ==
                   elites.individuals[i].weights.get_f32(w));
    }

    // Unknown old inputs are ignored; new inputs retain their small random
    // initializers instead of shifting saved columns.
    let old_inputs = ["retired_sensor"];
    for (let var i = 0; i < INPUT_NAMES.len; ++i)
        if (INPUT_NAMES[i] != "energy" && INPUT_NAMES[i] != "episode_time" &&
            INPUT_NAMES[i] != "door_visible" &&
            INPUT_NAMES[i] != "thrown_grenade_visible" &&
            INPUT_NAMES[i] != "thrown_grenade_angle" &&
            INPUT_NAMES[i] != "thrown_grenade_proximity")
            old_inputs.push(INPUT_NAMES[i]);
    let shifted = encode_individual(elites.individuals[0]);
    for (let var h = 0; h < HIDDEN; ++h) {
        let row = [0.75];
        for (let var i = 0; i < INPUT_NAMES.len; ++i)
            if (INPUT_NAMES[i] != "energy" && INPUT_NAMES[i] != "episode_time" &&
                INPUT_NAMES[i] != "door_visible" &&
                INPUT_NAMES[i] != "thrown_grenade_visible" &&
                INPUT_NAMES[i] != "thrown_grenade_angle" &&
                INPUT_NAMES[i] != "thrown_grenade_proximity")
                row.push(shifted.hidden[h][i]);
        shifted.hidden[h] = row;
    }
    let baseline = new_genome(Xoshiro128(7));
    let var remapped = decode_individual(Xoshiro128(7), shifted, old_inputs, OUTPUT_NAMES);
    let energy_index = name_index(INPUT_NAMES, "energy");
    let time_index = name_index(INPUT_NAMES, "episode_time");
    let door_index = name_index(INPUT_NAMES, "door_visible");
    let thrown_index = name_index(INPUT_NAMES, "thrown_grenade_visible");
    for (let var h = 0; h < HIDDEN; ++h) {
        for (let var i = 0; i < NUM_INPUTS; ++i) {
            let idx = h * NUM_INPUTS + i;
            let expected = i == energy_index || i == time_index || i == door_index ||
                           (i >= thrown_index && i < thrown_index + 3) ?
                           baseline.get_f32(idx) :
                           elites.individuals[0].weights.get_f32(idx);
            assert(remapped.weights.get_f32(idx) == expected);
        }
    }
    let old_outputs = ["retired_action"];
    for (let var i = 0; i < OUTPUT_NAMES.len; ++i)
        if (OUTPUT_NAMES[i] != "memory_9")
            old_outputs.push(OUTPUT_NAMES[i]);
    let shifted_outputs = encode_individual(elites.individuals[0]);
    let rows = [Array.with_size(HIDDEN, 0.75)];
    for (let var i = 0; i < OUTPUT_NAMES.len; ++i)
        if (OUTPUT_NAMES[i] != "memory_9")
            rows.push(shifted_outputs.output[i]);
    shifted_outputs.output = rows;
    remapped = decode_individual(Xoshiro128(7), shifted_outputs, INPUT_NAMES, old_outputs);
    for (let var o = 0; o < OUTPUT_NAMES.len; ++o) {
        for (let var h = 0; h < HIDDEN; ++h) {
            let idx = OUTPUT_BASE + o * HIDDEN + h;
            let expected = OUTPUT_NAMES[o] == "memory_9" ? baseline.get_f32(idx) :
                           elites.individuals[0].weights.get_f32(idx);
            assert(remapped.weights.get_f32(idx) == expected);
        }
    }
    let legacy = {age: decoded.age, name: decoded.name, colors: decoded.colors,
                  hidden: decoded.hidden, output: decoded.output};
    let legacy_agent = decode_individual(Xoshiro128(7), legacy, INPUT_NAMES, OUTPUT_NAMES);
    assert(legacy_agent.mutation_rates[0] == INITIAL_MUTATION_RATE &&
           legacy_agent.mutation_rates[1] == INITIAL_MUTATION_RATE);
    assert(legacy_agent.mutation_strengths[0] == INITIAL_MUTATION_STRENGTH &&
           legacy_agent.mutation_strengths[1] == INITIAL_MUTATION_STRENGTH);
    $println("checkpoint checks passed");
    $exit(0);
}

let MSG_SETUP = 0;
let MSG_SNAPSHOT = 1;
let MSG_MIGRANT = 3;
let MSG_CHECKPOINT = 4;
let BATCH = 32;

fun island_actor() {
    let setup = $actor_recv();
    let ids = setup[3];
    let island = Island(setup[1], setup[2], setup[4]);
    let parent = $actor_parent();

    loop {
        loop {
            let msg = $actor_poll();
            if (msg == nil)
                break;
            if (msg[0] == MSG_SNAPSHOT)
                $actor_send(parent, island.snapshot());
            else if (msg[0] == MSG_CHECKPOINT)
                $actor_send(parent, island.elite_snapshot());
            else if (msg[0] == MSG_MIGRANT)
                island.receive(msg[1]);
        }

        for (let var i = 0; i < BATCH; ++i) {
            if (!HEADLESS && island.duel.episode == 0 && island.duel.tick == 0) {
                let offer = island.match_offer($time_current_ms());
                if (offer != nil)
                    $actor_send(parent, offer);
            }
            if (island.step()) {
                if (ids.len > 1) {
                    let side = island.rng.index(2) == 0 ? -1 : 1;
                    let neighbour = (island.index + ids.len + side) % ids.len;
                    let donor = island.migration_donor();
                    $actor_send(ids[neighbour], [MSG_MIGRANT,
                                [donor.weights, donor.age, donor.name, donor.colors,
                                 donor.mutation_rates, donor.mutation_strengths]]);
                    island.migrants_sent = island.migrants_sent + 1;
                    $println("Migration: island " + island.index.to_s() + " -> " +
                             neighbour.to_s() + " at match " + island.matches.to_s() +
                             ", migrant age " + donor.age.to_s());
                }
            }
        }

        if (MAX_MATCHES > 0 && island.matches >= MAX_MATCHES)
            $actor_sleep(10);
    }
}

fun spawn_islands(saved) {
    let ids = [];
    for (let var i = 0; i < NUM_ISLANDS; ++i)
        ids.push($actor_spawn(island_actor));
    for (let var i = 0; i < NUM_ISLANDS; ++i) {
        let saved_data = saved_island(saved, i);
        let checkpoint = saved_data == nil ? nil :
            {inputs: saved.inputs, outputs: saved.outputs,
             individuals: saved_data.individuals};
        $actor_send(ids[i], [MSG_SETUP, i, SEED, ids, checkpoint]);
    }
    return ids;
}

fun gather_checkpoints(ids) {
    let snaps = Array.with_size(ids.len, nil);
    for (let var i = 0; i < ids.len; ++i)
        $actor_send(ids[i], [MSG_CHECKPOINT]);
    for (let var i = 0; i < ids.len; ++i) {
        let snap = $actor_recv();
        assert(snap.kind == "CHECKPOINT");
        snaps[snap.index] = snap;
    }
    return snaps;
}

fun save_checkpoint(snaps) {
    let islands = [];
    for (let var i = 0; i < snaps.len; ++i) {
        let snap = snaps[i];
        let individuals = [];
        for (let var j = 0; j < snap.individuals.len; ++j)
            individuals.push(encode_individual(snap.individuals[j]));
        islands.push({index: snap.index, matches: snap.matches,
                      individuals: individuals});
    }
    let document = {format: 1, saved_at_ms: $time_current_ms(),
                    inputs: INPUT_NAMES, outputs: OUTPUT_NAMES, islands: islands};
    if (write_json_file(SAVE_PATH, document))
        $println("Saved arena checkpoint to " + SAVE_PATH);
    else
        $println("Could not save arena checkpoint to " + SAVE_PATH);
}

fun gather(ids) {
    let snaps = Array.with_size(ids.len, nil);
    for (let var i = 0; i < ids.len; ++i)
        $actor_send(ids[i], [MSG_SNAPSHOT]);
    for (let var i = 0; i < ids.len; ++i) {
        let snap = $actor_recv();
        snaps[snap.index] = snap;
    }
    return snaps;
}

fun run_headless(ids) {
    let limit = MAX_MATCHES > 0 ? MAX_MATCHES : 1000;
    let start = $time_current_ms();
    let var last_save_ms = start;
    $println("seed " + SEED.to_s() + "  islands " + NUM_ISLANDS.to_s() +
             "  population " + POP_SIZE.to_s() + "  matches/island " + limit.to_s());
    $println("island  matches  kills  zero  oldest  mean_age  sent  received");
    loop {
        let snaps = gather(ids);
        let var finished = true;
        for (let var i = 0; i < snaps.len; ++i) {
            let s = snaps[i];
            if (s.matches < limit)
                finished = false;
            $println(i.to_s().rpad(8, ' ') + s.matches.to_s().rpad(9, ' ') +
                     s.kills.to_s().rpad(7, ' ') + s.zero_matches.to_s().rpad(6, ' ') +
                     s.oldest.to_s().rpad(8, ' ') + s.mean_age.to_s().rpad(10, ' ') +
                     s.migrants_sent.to_s().rpad(6, ' ') + s.migrants_received.to_s());
        }
        if (finished) {
            save_checkpoint(gather_checkpoints(ids));
            $println("elapsed_ms " + ($time_current_ms() - start).to_s());
            return;
        }
        let now = $time_current_ms();
        if (now >= last_save_ms + SAVE_INTERVAL_MS) {
            save_checkpoint(gather_checkpoints(ids));
            last_save_ms = now;
        }
        $actor_sleep(1000);
    }
}

let FRAME_W = 900;
let FRAME_H = 640;
let VIEW_W = 620;
let PIXELS_PER_METRE = 44;
let COL_BG = 0xFF_17_1C_22;
let COL_FLOOR = 0xFF_29_32_3A;
let COL_WALL = 0xFF_61_6B_72;
let COL_A = 0xFF_52_C9_FF;
let COL_B = 0xFF_FF_9B_57;
let COL_TEXT = 0xFF_E1_E8_EB;
let COL_DIM = 0xFF_9B_A9_B0;
let COL_SKIN = 0xFF_F3_D1_AC;
let COL_BLADE = 0xFF_D8_E4_EA;
let COL_GUN = 0xFF_C4_C9_CD;
let COL_GUN_HIGHLIGHT = 0xFF_E3_E8_EA;
let COL_GUN_SHADOW = 0xFF_6D_78_80;
let COL_HEALTH_KIT = 0xFF_D8_3F_4B;
let COL_HEALTH_CROSS = 0xFF_FF_FF_FF;
let COL_GRENADE = 0xFF_72_86_62;
let COL_GRENADE_HIGHLIGHT = 0xFF_D7_E2_BE;
let COL_BLAST = 0xFF_FF_4B_4B;
let COL_SHOT = 0xFF_FF_E4_63;

fun fill_rect(buf, x, y, w, h, color) {
    let x0 = x.max(0);
    let y0 = y.max(0);
    let x1 = (x + w).min(FRAME_W);
    let y1 = (y + h).min(FRAME_H);
    for (let var row = y0; row < y1; ++row)
        if (x1 > x0)
            buf.fill_u32(row * FRAME_W + x0, x1 - x0, color);
}

fun draw_disc(buf, cx, cy, radius, color) {
    for (let var dy = -radius; dy <= radius; ++dy) {
        let half = (radius * radius - dy * dy).to_f().sqrt().floor();
        fill_rect(buf, cx - half, cy + dy, 2 * half + 1, 1, color);
    }
}

fun draw_segment(buf, x0, y0, x1, y1, radius, color) {
    let steps = (x1 - x0).abs().max((y1 - y0).abs()).max(1);
    for (let var i = 0; i <= steps; ++i) {
        let t = i.to_f() / steps.to_f();
        let x = (x0.to_f() + (x1 - x0).to_f() * t).floor();
        let y = (y0.to_f() + (y1 - y0).to_f() * t).floor();
        draw_disc(buf, x, y, radius, color);
    }
}

fun draw_pistol(buf, grip_x, grip_y, angle, metres) {
    let c = angle.cos();
    let s = angle.sin();
    let right_x = -s;
    let right_y = c;
    let rear_x = grip_x - (c * metres * 0.11).floor();
    let rear_y = grip_y - (s * metres * 0.11).floor();
    let muzzle_x = grip_x + (c * metres * 0.238).floor();
    let muzzle_y = grip_y + (s * metres * 0.238).floor();
    let handle_top_x = grip_x - (c * metres * 0.05).floor();
    let handle_top_y = grip_y - (s * metres * 0.05).floor();
    let handle_x = handle_top_x + (right_x * metres * 0.12).floor();
    let handle_y = handle_top_y + (right_y * metres * 0.12).floor();
    let half_handle = (metres * 0.12).floor().max(1);
    let guard_x = grip_x + (c * metres * 0.08).floor() +
                  (right_x * metres * 0.08).floor();
    let guard_y = grip_y + (s * metres * 0.08).floor() +
                  (right_y * metres * 0.08).floor();
    // Taper a single trapezoid toward its flat base, with a backward lean.
    let handle_bound = half_handle + 5;
    for (let var dy = -handle_bound; dy <= handle_bound; ++dy) {
        for (let var dx = -handle_bound; dx <= handle_bound; ++dx) {
            let down = -dx.to_f() * s + dy.to_f() * c;
            let forward = dx.to_f() * c + dy.to_f() * s;
            let t = ((down + half_handle.to_f()) / (2 * half_handle).to_f()).max(0.0).min(1.0);
            let center = -t * (2 * half_handle).to_f() * 0.10;
            let half_width = 3.0 - t * 1.25;
            let edge = half_width - (forward - center).abs();
            if (down.abs() <= (half_handle + 1).to_f() && edge >= -1.0)
                fill_rect(buf, handle_x + dx, handle_y + dy, 1, 1, COL_BG);
            if (down.abs() <= half_handle.to_f() && edge > -0.5) {
                // Smooth the sloping edges so this small grip reads as one shape.
                let coverage = (edge + 0.5).min(1.0);
                let var shade = 0xFF_00_00_00;
                for (let var shift = 0; shift <= 16; shift = shift + 8) {
                    let bg = (COL_BG >> shift) & 255;
                    let fg = (COL_GUN_SHADOW >> shift) & 255;
                    shade = shade | ((bg.to_f() + (fg - bg).to_f() * coverage).floor() << shift);
                }
                fill_rect(buf, handle_x + dx, handle_y + dy, 1, 1, shade);
            }
        }
    }
    draw_segment(buf, handle_top_x, handle_top_y, guard_x, guard_y, 0, COL_GUN_SHADOW);
    // A rectangular slide gives the pickup a flat top and squared ends.
    let slide_x = (rear_x + muzzle_x).idiv(2);
    let slide_y = (rear_y + muzzle_y).idiv(2);
    let half_slide = (metres * 0.174).floor().max(1);
    let slide_thickness = (3.0 * 0.8).floor();
    draw_body(buf, slide_x, slide_y, angle, half_slide + 1, slide_thickness + 1,
              (half_slide + 5).to_f(), COL_BG);
    draw_body(buf, slide_x, slide_y, angle, half_slide, slide_thickness,
              (half_slide + 5).to_f(), COL_GUN);
    draw_segment(buf, rear_x - right_x.floor(), rear_y - right_y.floor(),
                 muzzle_x - right_x.floor(), muzzle_y - right_y.floor(),
                 0, COL_GUN_HIGHLIGHT);
    draw_segment(buf, muzzle_x - (right_x * slide_thickness).floor(),
                 muzzle_y - (right_y * slide_thickness).floor(),
                 muzzle_x + (right_x * slide_thickness).floor(),
                 muzzle_y + (right_y * slide_thickness).floor(), 0, COL_GUN_SHADOW);
}

fun draw_floor_pistol(buf, center_x, center_y, scale) {
    let metres = scale.to_f() * 1.25;
    let rear = -(metres * 0.11).floor();
    let muzzle = (metres * 0.238).floor();
    let slide_mid = (rear + muzzle).idiv(2);
    let handle_bottom = (metres * 0.12).floor() + (metres * 0.12).floor().max(1);
    let slide_top = -((3.0 * 0.8).floor() + 1);
    let vertical_mid = (slide_top + handle_bottom).idiv(2);
    draw_pistol(buf, center_x - slide_mid, center_y - vertical_mid, 0.0, metres);
}

fun draw_health_kit(buf, center_x, center_y, scale) {
    let half_w = (scale.to_f() * 0.192).floor().max(3);
    let original_half_h = (scale.to_f() * 0.18).floor().max(3);
    let half_h = original_half_h + 1;
    let cross_half = ((original_half_h - 1).to_f() * 0.8 + 0.5).floor().max(2);
    fill_rect(buf, center_x - half_w - 1, center_y - half_h - 1,
              2 * half_w + 3, 2 * half_h + 3, COL_BG);
    fill_rect(buf, center_x - half_w, center_y - half_h,
              2 * half_w + 1, 2 * half_h + 1, COL_HEALTH_KIT);
    fill_rect(buf, center_x - 1, center_y - cross_half,
              3, 2 * cross_half + 1, COL_HEALTH_CROSS);
    fill_rect(buf, center_x - cross_half, center_y - 1,
              2 * cross_half + 1, 3, COL_HEALTH_CROSS);
}

fun draw_grenade(buf, center_x, center_y, scale) {
    let half_w = (scale.to_f() * 0.11).floor().max(3);
    let half_h = (scale.to_f() * 0.18).floor().max(5);
    let body_x = center_x - 1;
    let body_y = center_y + 1;
    for (let var dy = -half_h - 1; dy <= half_h + 1; ++dy) {
        let t = dy.to_f() / (half_h + 1).to_f();
        let half = ((half_w + 1).to_f() * (1.0 - t * t).sqrt()).floor();
        fill_rect(buf, body_x - half, body_y + dy, 2 * half + 1, 1, COL_BG);
    }
    for (let var dy = -half_h; dy <= half_h; ++dy) {
        let t = dy.to_f() / half_h.to_f();
        let half = (half_w.to_f() * (1.0 - t * t).sqrt()).floor();
        fill_rect(buf, body_x - half, body_y + dy, 2 * half + 1, 1, COL_GRENADE);
    }
    draw_disc(buf, center_x, center_y, 1, COL_GRENADE_HIGHLIGHT);
    let hook_x = body_x + half_w + 1;
    let hook_top = body_y - half_h - 1;
    let hook_bottom = body_y + 1;
    let hook_start = body_x - 1;
    fill_rect(buf, hook_start - 1, hook_top - 1,
              hook_x - hook_start + 4, 4, COL_BG);
    fill_rect(buf, hook_x, hook_top - 1,
              3, hook_bottom - hook_top + 2, COL_BG);
    fill_rect(buf, hook_start, hook_top,
              hook_x - hook_start + 2, 2, COL_GRENADE_HIGHLIGHT);
    fill_rect(buf, hook_x, hook_top,
              2, hook_bottom - hook_top + 1, COL_GRENADE_HIGHLIGHT);
}

fun draw_blast(buf, center_x, center_y, scale, ticks) {
    let progress = (GRENADE_BLAST_TICKS - ticks + 1).to_f() /
                   GRENADE_BLAST_TICKS.to_f();
    let radius = GRENADE_BLAST_RADIUS * scale.to_f() * progress;
    for (let var i = 0; i < 360; ++i) {
        let angle = TAU * i.to_f() / 360.0;
        let x = center_x + (radius * angle.cos()).floor();
        let y = center_y + (radius * angle.sin()).floor();
        if (x >= 2 && x < VIEW_W - 2 && y >= 2 && y < FRAME_H - 2)
            draw_disc(buf, x, y, 2, COL_BLAST);
    }
    draw_disc(buf, center_x, center_y, (scale.to_f() * 0.18).floor().max(3), COL_BLAST);
}

fun draw_body(buf, x, y, angle, half_length, half_width, radius, color) {
    let c = angle.cos();
    let s = angle.sin();
    let bound = radius.floor() + 1;
    for (let var dy = -bound; dy <= bound; ++dy) {
        for (let var dx = -bound; dx <= bound; ++dx) {
            if (dx * dx + dy * dy > radius * radius)
                continue;
            let forward = dx.to_f() * c + dy.to_f() * s;
            let side = -dx.to_f() * s + dy.to_f() * c;
            if (forward.abs() <= half_length.to_f() && side.abs() <= half_width.to_f())
                fill_rect(buf, x + dx, y + dy, 1, 1, color);
        }
    }
}

let FONT = {
    "0": [7,5,5,5,7], "1": [2,6,2,2,7], "2": [7,1,7,4,7], "3": [7,1,7,1,7],
    "4": [5,5,7,1,1], "5": [7,4,7,1,7], "6": [7,4,7,5,7], "7": [7,1,1,1,1],
    "8": [7,5,7,5,7], "9": [7,5,7,1,7],
    "A": [7,5,7,5,5], "B": [6,5,6,5,6], "C": [7,4,4,4,7], "D": [6,5,5,5,6],
    "E": [7,4,7,4,7], "F": [7,4,7,4,4], "G": [7,4,5,5,7], "H": [5,5,7,5,5],
    "I": [7,2,2,2,7], "J": [1,1,1,5,7], "K": [5,5,6,5,5], "L": [4,4,4,4,7],
    "M": [5,7,7,5,5], "N": [6,5,5,5,5], "O": [7,5,5,5,7], "P": [7,5,7,4,4],
    "R": [7,5,6,5,5], "S": [7,4,7,1,7], "T": [7,2,2,2,2], "U": [5,5,5,5,7],
    "V": [5,5,5,5,2], "W": [5,5,7,7,5], "X": [5,5,2,5,5], "Y": [5,5,2,2,2], "Z": [7,1,2,4,7],
    " ": [0,0,0,0,0], ",": [0,0,0,6,2], ":": [0,2,0,2,0],
    ".": [0,0,0,0,2], "%": [5,1,2,4,5], "σ": [0,7,5,5,7],
    "/": [1,1,2,4,4], "-": [0,0,7,0,0]
};

fun draw_text(buf, x, y, label, color) {
    let var column = 0;
    for (let var i = 0; i < label.len; ++i) {
        let ch = label.char_at(i);
        if (ch == nil)
            continue;
        if (!FONT.has(ch))
            continue;
        let rows = FONT[ch];
        for (let var row = 0; row < 5; ++row) {
            for (let var col = 0; col < 3; ++col) {
                if (((rows[row] >> (2 - col)) & 1) != 0)
                    fill_rect(buf, x + column * 8 + col * 2, y + row * 2, 2, 2, color);
            }
        }
        column = column + 1;
    }
}

fun draw_fighter(buf, x, y, angle, hp, attack_ticks, gun_ammo,
                 grenade_held, color, scale) {
    let c = angle.cos();
    let s = angle.sin();
    let right_x = -s;
    let right_y = c;
    let metres = scale.to_f();
    let body_radius = metres * DRAW_BODY_RADIUS;
    let half_length = (metres * DRAW_BODY_RADIUS * 0.62).floor().max(1);
    let half_width = (metres * DRAW_BODY_RADIUS * 0.78 * 1.20).floor().max(1);
    draw_body(buf, x, y, angle, half_length, half_width, body_radius, COL_BG);
    draw_body(buf, x, y, angle, (half_length - 1).max(1),
              (half_width - 1).max(1), body_radius, color);
    let head_radius = (metres * DRAW_BODY_RADIUS * 0.32 * 1.50).floor().max(2);
    draw_disc(buf, x, y, head_radius + 1, COL_BG);
    draw_disc(buf, x, y, head_radius, COL_SKIN);

    let thrust = gun_ammo > 0 ? 0.0 :
                 attack_ticks == 2 ? 0.20 : attack_ticks == 1 ? 0.10 : 0.0;
    let side_offset = gun_ammo > 0 && !grenade_held ? 0.0 : 0.22;
    let forward_offset = gun_ammo > 0 ? 0.32 : 0.09 + thrust;
    let hand_x = x + (c * metres * forward_offset + right_x * metres * side_offset).floor();
    let hand_y = y + (s * metres * forward_offset + right_y * metres * side_offset).floor();
    if (gun_ammo > 0) {
        // From above, the slide hides the grip and points ahead of the hands.
        let muzzle_x = hand_x + (c * metres * 0.28).floor();
        let muzzle_y = hand_y + (s * metres * 0.28).floor();
        draw_segment(buf, hand_x, hand_y, muzzle_x, muzzle_y, 3, COL_BG);
        draw_segment(buf, hand_x, hand_y, muzzle_x, muzzle_y, 2, COL_GUN);
        draw_segment(buf, hand_x, hand_y, muzzle_x, muzzle_y, 0, COL_GUN_HIGHLIGHT);
        draw_disc(buf, muzzle_x, muzzle_y, 1, COL_GUN_SHADOW);
    } else {
        let blade_x = hand_x + (c * metres * 0.08).floor();
        let blade_y = hand_y + (s * metres * 0.08).floor();
        let tip_x = hand_x + (c * metres * 0.36).floor();
        let tip_y = hand_y + (s * metres * 0.36).floor();
        draw_segment(buf, hand_x, hand_y, blade_x, blade_y, 2, COL_BG);
        draw_segment(buf, blade_x, blade_y, tip_x, tip_y, 1, COL_BLADE);
    }
    draw_disc(buf, hand_x, hand_y, (metres * 0.07).floor().max(2), COL_SKIN);
    if (grenade_held) {
        let grenade_hand_x = x + (c * metres * 0.09 - right_x * metres * 0.22).floor();
        let grenade_hand_y = y + (s * metres * 0.09 - right_y * metres * 0.22).floor();
        let grenade_x = grenade_hand_x + (c * metres * 0.20).floor();
        let grenade_y = grenade_hand_y + (s * metres * 0.20).floor();
        draw_disc(buf, grenade_x, grenade_y,
                  (metres * GRENADE_RADIUS * 0.6).floor().max(3), COL_GRENADE);
        draw_disc(buf, grenade_hand_x, grenade_hand_y,
                  (metres * 0.07).floor().max(2), COL_SKIN);
    }

    fill_rect(buf, x - 15, y - 21, 30, 4, COL_BG);
    fill_rect(buf, x - 15, y - 21, (hp.max(0.0) * 0.3).floor(), 4, color);
}

fun replay_snapshot(config, duel) {
    let a = duel.fighters[0];
    let b = duel.fighters[1];
    return {
        index: config.index, match_no: config.match_no,
        first_age: config.first_age, second_age: config.second_age,
        first_name: a.individual.name, second_name: b.individual.name,
        first_color: a.individual.color(), second_color: b.individual.color(),
        first_rates: a.individual.mutation_rates,
        first_strengths: a.individual.mutation_strengths,
        second_rates: b.individual.mutation_rates,
        second_strengths: b.individual.mutation_strengths,
        oldest_side: config.oldest_side,
        room_w: duel.arena.inner_w, room_h: duel.arena.inner_h,
        tiles: duel.arena.tiles,
        gun_available: duel.gun_available, gun_x: duel.gun_x, gun_y: duel.gun_y,
        kit_available: duel.kit_available, kit_x: duel.kit_x, kit_y: duel.kit_y,
        grenade_available: duel.grenade_available, grenade_active: duel.grenade_active,
        grenade_x: duel.grenade_x, grenade_y: duel.grenade_y,
        blast_ticks: duel.blast_ticks,
        episode: duel.episode.min(EPISODES - 1), tick: duel.tick,
        kills_a: duel.kills[0], kills_b: duel.kills[1],
        ax: a.x, ay: a.y, adir: a.angle, ahp: a.health, astab: a.attack_ticks,
        aammo: a.gun_ammo, agrenade: a.grenade_held,
        ashot: a.shot_ticks, aenergy: a.energy,
        asx: a.shot_start_x, asy: a.shot_start_y, aex: a.shot_end_x, aey: a.shot_end_y,
        bx: b.x, by: b.y, bdir: b.angle, bhp: b.health, bstab: b.attack_ticks,
        bammo: b.gun_ammo, bgrenade: b.grenade_held,
        bshot: b.shot_ticks, benergy: b.energy,
        bsx: b.shot_start_x, bsy: b.shot_start_y, bex: b.shot_end_x, bey: b.shot_end_y
    };
}

fun aggregate_stats(snaps, matches_per_sec) {
    let var matches = 0;
    let var kills = 0;
    let var zero_matches = 0;
    let var migrations = 0;
    let var oldest = 0;
    for (let var i = 0; i < snaps.len; ++i) {
        let s = snaps[i];
        if (s == nil)
            continue;
        matches = matches + s.matches;
        kills = kills + s.kills;
        zero_matches = zero_matches + s.zero_matches;
        migrations = migrations + s.migrants_sent;
        oldest = oldest.max(s.oldest);
    }
    return {
        matches: matches, matches_per_sec: matches_per_sec,
        kills: kills, zero_matches: zero_matches,
        migrations: migrations, oldest: oldest
    };
}

fun mutation_text(rates, strengths) {
    let var label = "";
    for (let var layer = 0; layer < 2; ++layer) {
        let rate_tenths = (rates[layer] * 1000.0 + 0.5).floor();
        let strength_hundredths = (strengths[layer] * 100.0 + 0.5).floor();
        label = label + (layer == 0 ? "H R" : " O R") +
                rate_tenths.idiv(10).to_s() + "." + (rate_tenths % 10).to_s() + "% σ0." +
                (strength_hundredths < 10 ? "0" : "") + strength_hundredths.to_s();
    }
    return label;
}

fun render(buf, snap, agg, view_speed, paused) {
    buf.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
    if (snap == nil) {
        draw_text(buf, 42, 300, "WAITING FOR OLDEST MATCH", COL_TEXT);
    } else {
        let scale = PIXELS_PER_METRE.min(VIEW_W.idiv(snap.room_w + 2))
                                     .min(FRAME_H.idiv(snap.room_h + 2)).max(4);
        let ox = (VIEW_W - (snap.room_w + 2) * scale).idiv(2);
        let oy = (FRAME_H - (snap.room_h + 2) * scale).idiv(2);
        let grid_w = snap.room_w + 2;
        for (let var y = 0; y < snap.room_h + 2; ++y) {
            for (let var x = 0; x < snap.room_w + 2; ++x) {
                let wall = snap.tiles.get_u32(y * grid_w + x) != 0;
                fill_rect(buf, ox + x * scale, oy + y * scale, scale - 1, scale - 1,
                          wall ? COL_WALL : COL_FLOOR);
            }
        }
        if (snap.gun_available) {
            let gun_px = ox + (snap.gun_x * scale).floor();
            let gun_py = oy + (snap.gun_y * scale).floor();
            draw_floor_pistol(buf, gun_px, gun_py, scale);
        }
        if (snap.kit_available) {
            let kit_px = ox + (snap.kit_x * scale).floor();
            let kit_py = oy + (snap.kit_y * scale).floor();
            draw_health_kit(buf, kit_px, kit_py, scale);
        }
        if (snap.grenade_available || snap.grenade_active) {
            let grenade_px = ox + (snap.grenade_x * scale).floor();
            let grenade_py = oy + (snap.grenade_y * scale).floor();
            draw_grenade(buf, grenade_px, grenade_py, scale);
        }
        if (snap.blast_ticks > 0) {
            let blast_px = ox + (snap.grenade_x * scale).floor();
            let blast_py = oy + (snap.grenade_y * scale).floor();
            draw_blast(buf, blast_px, blast_py, scale, snap.blast_ticks);
        }
        if (snap.ashot > 0)
            draw_segment(buf, ox + (snap.asx * scale).floor(), oy + (snap.asy * scale).floor(),
                         ox + (snap.aex * scale).floor(), oy + (snap.aey * scale).floor(),
                         0, COL_SHOT);
        if (snap.bshot > 0)
            draw_segment(buf, ox + (snap.bsx * scale).floor(), oy + (snap.bsy * scale).floor(),
                         ox + (snap.bex * scale).floor(), oy + (snap.bey * scale).floor(),
                         0, COL_SHOT);
        draw_fighter(buf, ox + (snap.ax * scale).floor(), oy + (snap.ay * scale).floor(),
                     snap.adir, snap.ahp, snap.astab, snap.aammo, snap.agrenade,
                     snap.first_color, scale);
        draw_fighter(buf, ox + (snap.bx * scale).floor(), oy + (snap.by * scale).floor(),
                     snap.bdir, snap.bhp, snap.bstab, snap.bammo, snap.bgrenade,
                     snap.second_color, scale);
    }

    let px = VIEW_W + 20;
    draw_text(buf, px, 20, "ALL " + NUM_ISLANDS.comma_sep() + " ISLANDS", COL_DIM);
    draw_text(buf, px, 50, "MATCHES " + agg.matches.comma_sep(), COL_TEXT);
    draw_text(buf, px, 74, "MATCHES/S " + agg.matches_per_sec.comma_sep(), COL_TEXT);
    draw_text(buf, px, 98, "KILLS " + agg.kills.comma_sep(), COL_TEXT);
    draw_text(buf, px, 122, "ZERO MATCHES " + agg.zero_matches.comma_sep(), COL_TEXT);
    draw_text(buf, px, 146, "MIGRATIONS " + agg.migrations.comma_sep(), COL_TEXT);
    draw_text(buf, px, 170, "OLDEST AGE " + agg.oldest.comma_sep(), COL_TEXT);
    fill_rect(buf, px, 197, 238, 1, COL_DIM);

    draw_text(buf, px, 215, "VIEWED MATCH", COL_DIM);
    if (snap != nil) {
        draw_text(buf, px, 245, "ISLAND " + snap.index.comma_sep(), COL_TEXT);
        draw_text(buf, px, 268, "MATCH " + snap.match_no.comma_sep(), COL_TEXT);
        draw_text(buf, px, 291, "EPISODE " + (snap.episode + 1).comma_sep() +
                  "/" + EPISODES.comma_sep(), COL_TEXT);
        draw_text(buf, px, 314, "TIME " + snap.tick.idiv(10).comma_sep() + "/30", COL_TEXT);
        draw_text(buf, px, 337, "ROOM " + snap.room_w.comma_sep() + " X " + snap.room_h.comma_sep(), COL_TEXT);
        draw_text(buf, px, 366, snap.first_name + " AGE " + snap.first_age.comma_sep(), snap.first_color);
        draw_text(buf, px, 380, "KILLS " + snap.kills_a.comma_sep(), snap.first_color);
        draw_text(buf, px + 160, 380,
                  snap.agrenade ? (snap.aammo > 0 ? "G" + snap.aammo.to_s() + " GR" : "GRENADE") :
                  snap.aammo > 0 ? "GUN " + snap.aammo.comma_sep() : "KNIFE", snap.first_color);
        draw_text(buf, px, 394, "ENERGY " + snap.aenergy.floor().comma_sep() + " J", COL_DIM);
        draw_text(buf, px, 408, mutation_text(snap.first_rates, snap.first_strengths), COL_DIM);
        draw_text(buf, px, 437, snap.second_name + " AGE " + snap.second_age.comma_sep(), snap.second_color);
        draw_text(buf, px, 451, "KILLS " + snap.kills_b.comma_sep(), snap.second_color);
        draw_text(buf, px + 160, 451,
                  snap.bgrenade ? (snap.bammo > 0 ? "G" + snap.bammo.to_s() + " GR" : "GRENADE") :
                  snap.bammo > 0 ? "GUN " + snap.bammo.comma_sep() : "KNIFE", snap.second_color);
        draw_text(buf, px, 465, "ENERGY " + snap.benergy.floor().comma_sep() + " J", COL_DIM);
        draw_text(buf, px, 479, mutation_text(snap.second_rates, snap.second_strengths), COL_DIM);
    } else {
        draw_text(buf, px, 245, "WAITING FOR MATCH", COL_TEXT);
    }
    if (paused)
        draw_text(buf, px, 502, "VIEW PAUSED", COL_TEXT);
    draw_text(buf, px, 526, "REPLAY " + view_speed.to_s() + "X", COL_TEXT);
    draw_text(buf, px, 550, "F VIEW SPEED", COL_DIM);
    draw_text(buf, px, 574, "SPACE PAUSE VIEW", COL_DIM);
    draw_text(buf, px, 598, "N NEXT MATCH", COL_DIM);
}

if (has_flag("--check-render")) {
    assert(FONT.has(".") && FONT.has("%") && FONT.has("σ"));
    assert(mutation_text([0.006, 0.007], [0.02, 0.05]) ==
           "H R0.6% σ0.02 O R0.7% σ0.05");
    let test_weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    let test_agent = Individual(test_weights, 0, "TEST", [80, 201, 255],
                                [INITIAL_MUTATION_RATE, INITIAL_MUTATION_RATE],
                                [INITIAL_MUTATION_STRENGTH, INITIAL_MUTATION_STRENGTH]);
    let test_duel = Match(test_agent, test_agent, 7);
    let test_config = {index: 0, match_no: 0, first_age: 0, second_age: 0,
                       oldest_side: 0};
    let test_stats = {matches: 0, matches_per_sec: 0, kills: 0,
                      zero_matches: 0, migrations: 0, oldest: 0};
    let test_frame = ByteArray.with_size(FRAME_W * FRAME_H * 4);
    test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
    draw_text(test_frame, 20, 20, ".%σ0", COL_TEXT);
    assert(test_frame.get_u32(28 * FRAME_W + 22) == COL_TEXT);
    assert(test_frame.get_u32(20 * FRAME_W + 28) == COL_TEXT);
    assert(test_frame.get_u32(22 * FRAME_W + 36) == COL_TEXT);
    assert(test_frame.get_u32(20 * FRAME_W + 44) == COL_TEXT);
    let test_scale = PIXELS_PER_METRE.min(VIEW_W.idiv(test_duel.arena.inner_w + 2))
                                      .min(FRAME_H.idiv(test_duel.arena.inner_h + 2)).max(4);
    let test_ox = (VIEW_W - test_duel.arena.width * test_scale).idiv(2);
    let test_oy = (FRAME_H - test_duel.arena.height * test_scale).idiv(2);
    let test_x = test_ox + (test_duel.gun_x * test_scale).floor();
    let test_y = test_oy + (test_duel.gun_y * test_scale).floor();
    let icon_scales = [8, 16, 24, 44];
    for (let var scale_idx = 0; scale_idx < icon_scales.len; ++scale_idx) {
        let scale = icon_scales[scale_idx];
        test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
        draw_floor_pistol(test_frame, test_x, test_y, scale);
        let var left = test_x + 40;
        let var right = test_x - 40;
        let var top = test_y + 40;
        let var bottom = test_y - 40;
        for (let var dy = -40; dy <= 40; ++dy) {
            for (let var dx = -40; dx <= 40; ++dx) {
                if (test_frame.get_u32((test_y + dy) * FRAME_W + test_x + dx) == COL_BG)
                    continue;
                left = left.min(test_x + dx);
                right = right.max(test_x + dx);
                top = top.min(test_y + dy);
                bottom = bottom.max(test_y + dy);
            }
        }
        assert(left <= right && top <= bottom);
        assert((left + right - 2 * test_x).abs() <= 2);
        assert((top + bottom - 2 * test_y).abs() <= 2);
        test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
        draw_health_kit(test_frame, 200, 200, scale);
        assert(test_frame.get_u32(200 * FRAME_W + 200) == COL_HEALTH_CROSS);
        let half_w = (scale.to_f() * 0.192).floor().max(3);
        let half_h = (scale.to_f() * 0.18).floor().max(3) + 1;
        assert(test_frame.get_u32(200 * FRAME_W + 200 - half_w) == COL_HEALTH_KIT);
        assert(test_frame.get_u32(200 * FRAME_W + 200 + half_w) == COL_HEALTH_KIT);
        assert(test_frame.get_u32((200 - half_h) * FRAME_W + 200) == COL_HEALTH_KIT);
        assert(test_frame.get_u32((200 + half_h) * FRAME_W + 200) == COL_HEALTH_KIT);
        if (scale == 44) {
            assert(test_frame.get_u32(200 * FRAME_W + 205) == COL_HEALTH_CROSS);
            assert(test_frame.get_u32(200 * FRAME_W + 206) == COL_HEALTH_KIT);
            assert(test_frame.get_u32(205 * FRAME_W + 200) == COL_HEALTH_CROSS);
            assert(test_frame.get_u32(206 * FRAME_W + 200) == COL_HEALTH_KIT);
        }
        test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
        draw_grenade(test_frame, 200, 200, scale);
        assert(test_frame.get_u32(200 * FRAME_W + 200) == COL_GRENADE_HIGHLIGHT);
        let grenade_half_w = (scale.to_f() * 0.11).floor().max(3);
        let grenade_half_h = (scale.to_f() * 0.18).floor().max(5);
        let hook_x = 199 + grenade_half_w + 1;
        let hook_top = 201 - grenade_half_h - 1;
        assert(test_frame.get_u32(201 * FRAME_W + 199 - grenade_half_w) == COL_GRENADE);
        assert(test_frame.get_u32(201 * FRAME_W + 199 + grenade_half_w) == COL_GRENADE);
        assert(test_frame.get_u32(201 * FRAME_W + hook_x) == COL_GRENADE_HIGHLIGHT);
        assert(test_frame.get_u32(hook_top * FRAME_W + 198) == COL_GRENADE_HIGHLIGHT);
        assert(test_frame.get_u32((hook_top + 1) * FRAME_W + 198) ==
               COL_GRENADE_HIGHLIGHT);
        assert(test_frame.get_u32(hook_top * FRAME_W + hook_x + 1) ==
               COL_GRENADE_HIGHLIGHT);
        assert(test_frame.get_u32(202 * FRAME_W + hook_x) == COL_GRENADE_HIGHLIGHT);
        assert(test_frame.get_u32(202 * FRAME_W + hook_x + 1) == COL_GRENADE_HIGHLIGHT);
    }
    test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
    let blast_outer = (GRENADE_BLAST_RADIUS * 44.0).floor();
    let blast_first = (GRENADE_BLAST_RADIUS * 44.0 /
                       GRENADE_BLAST_TICKS.to_f()).floor();
    draw_blast(test_frame, 200, 200, 44, GRENADE_BLAST_TICKS);
    assert(test_frame.get_u32(200 * FRAME_W + 200 + blast_first) == COL_BLAST);
    assert(test_frame.get_u32(200 * FRAME_W + 200 + blast_outer) == COL_BG);
    draw_blast(test_frame, 200, 200, 44, 1);
    assert(test_frame.get_u32(200 * FRAME_W + 200 + blast_outer) == COL_BLAST);
    let wall_blast = Match(test_agent, test_agent, 13);
    wall_blast.arena = Arena(5, 5, nil);
    wall_blast.arena.add_notch(3, 3);
    wall_blast.fighters[0].reset(1.5, 1.5, 0.0);
    wall_blast.fighters[1].reset(5.5, 5.5, 0.0);
    wall_blast.grenade_available = false;
    wall_blast.grenade_x = 2.5;
    wall_blast.grenade_y = 3.5;
    wall_blast.blast_ticks = GRENADE_BLAST_TICKS;
    render(test_frame, replay_snapshot(test_config, wall_blast), test_stats, 1, false);
    let wall_ox = (VIEW_W - 7 * PIXELS_PER_METRE).idiv(2);
    let wall_oy = (FRAME_H - 7 * PIXELS_PER_METRE).idiv(2);
    let wall_ring_x = wall_ox + (2.5 * PIXELS_PER_METRE).floor() +
                      (GRENADE_BLAST_RADIUS * PIXELS_PER_METRE.to_f() /
                       GRENADE_BLAST_TICKS.to_f()).floor();
    let wall_ring_y = wall_oy + (3.5 * PIXELS_PER_METRE).floor();
    assert(wall_ring_x >= wall_ox + 3 * PIXELS_PER_METRE &&
           wall_ring_x < wall_ox + 4 * PIXELS_PER_METRE);
    assert(test_frame.get_u32(wall_ring_y * FRAME_W + wall_ring_x) == COL_BLAST);
    render(test_frame, replay_snapshot(test_config, test_duel), test_stats, 1, false);
    let test_kit_x = test_ox + (test_duel.kit_x * test_scale).floor();
    let test_kit_y = test_oy + (test_duel.kit_y * test_scale).floor();
    assert(test_frame.get_u32(test_kit_y * FRAME_W + test_kit_x) == COL_HEALTH_CROSS);
    let test_grenade_x = test_ox + (test_duel.grenade_x * test_scale).floor();
    let test_grenade_y = test_oy + (test_duel.grenade_y * test_scale).floor();
    assert(test_frame.get_u32(test_grenade_y * FRAME_W + test_grenade_x) ==
           COL_GRENADE_HIGHLIGHT);
    test_duel.grenade_available = false;
    test_duel.blast_ticks = GRENADE_BLAST_TICKS;
    render(test_frame, replay_snapshot(test_config, test_duel), test_stats, 1, false);
    assert(test_frame.get_u32(test_grenade_y * FRAME_W + test_grenade_x) == COL_BLAST);
    test_duel.blast_ticks = 0;
    test_duel.kit_available = false;
    render(test_frame, replay_snapshot(test_config, test_duel), test_stats, 1, false);
    assert(test_frame.get_u32(test_kit_y * FRAME_W + test_kit_x) != COL_HEALTH_CROSS);
    let test_shooter = test_duel.fighters[0];
    test_duel.gun_available = false;
    test_shooter.gun_ammo = GUN_AMMO;
    render(test_frame, replay_snapshot(test_config, test_duel), test_stats, 1, false);
    let test_player_x = test_ox + (test_shooter.x * test_scale).floor();
    let test_player_y = test_oy + (test_shooter.y * test_scale).floor();
    let var held_gun_visible = false;
    for (let var dy = -30; dy <= 30; ++dy)
        for (let var dx = -30; dx <= 30; ++dx)
            if (test_frame.get_u32((test_player_y + dy) * FRAME_W + test_player_x + dx) == COL_GUN)
                held_gun_visible = true;
    assert(held_gun_visible);
    // The held slide stays ahead of the head at every facing direction.
    for (let var direction = 0; direction < 8; ++direction) {
        let angle = direction.to_f() * TAU / 8.0;
        test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
        draw_fighter(test_frame, 100, 100, angle, HEALTH, 0, GUN_AMMO, false,
                     test_agent.color(), PIXELS_PER_METRE);
        assert(test_frame.get_u32(100 * FRAME_W + 100) == COL_SKIN);
        let var visible = false;
        for (let var y = 65; y <= 135; ++y) {
            for (let var x = 65; x <= 135; ++x) {
                if (test_frame.get_u32(y * FRAME_W + x) == COL_GUN) {
                    visible = true;
                    let forward = (x - 100).to_f() * angle.cos() +
                                  (y - 100).to_f() * angle.sin();
                    assert(forward > PIXELS_PER_METRE.to_f() * DRAW_BODY_RADIUS * 0.48);
                }
            }
        }
        assert(visible);
        test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
        draw_fighter(test_frame, 100, 100, angle, HEALTH, 0, 0, true,
                     test_agent.color(), PIXELS_PER_METRE);
        let var held_grenade_visible = false;
        let var held_knife_visible = false;
        for (let var y = 65; y <= 135; ++y) {
            for (let var x = 65; x <= 135; ++x) {
                let pixel = test_frame.get_u32(y * FRAME_W + x);
                let side = -(x - 100).to_f() * angle.sin() +
                            (y - 100).to_f() * angle.cos();
                if (pixel == COL_GRENADE) {
                    held_grenade_visible = true;
                    let forward = (x - 100).to_f() * angle.cos() +
                                  (y - 100).to_f() * angle.sin();
                    assert(forward > 0.0);
                    assert(side < 0.0);
                }
                if (pixel == COL_BLADE) {
                    held_knife_visible = true;
                    assert(side > 0.0);
                }
                assert(pixel != COL_GRENADE_HIGHLIGHT);
            }
        }
        assert(held_grenade_visible && held_knife_visible);
        test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
        draw_fighter(test_frame, 100, 100, angle, HEALTH, 0, GUN_AMMO, true,
                     test_agent.color(), PIXELS_PER_METRE);
        let var grenade_with_gun_visible = false;
        let var right_hand_gun_visible = false;
        for (let var y = 65; y <= 135; ++y) {
            for (let var x = 65; x <= 135; ++x) {
                let pixel = test_frame.get_u32(y * FRAME_W + x);
                let side = -(x - 100).to_f() * angle.sin() +
                            (y - 100).to_f() * angle.cos();
                if (pixel == COL_GRENADE) {
                    grenade_with_gun_visible = true;
                    assert(side < 0.0);
                }
                if (pixel == COL_GUN) {
                    right_hand_gun_visible = true;
                    assert(side > 0.0);
                }
                assert(pixel != COL_GRENADE_HIGHLIGHT);
            }
        }
        assert(grenade_with_gun_visible && right_hand_gun_visible);
    }
    test_shooter.shot_ticks = SHOT_TRACE_TICKS;
    test_shooter.shot_start_x = test_duel.gun_x - 0.3;
    test_shooter.shot_start_y = test_duel.gun_y;
    test_shooter.shot_end_x = test_duel.gun_x + 0.3;
    test_shooter.shot_end_y = test_duel.gun_y;
    render(test_frame, replay_snapshot(test_config, test_duel), test_stats, 1, false);
    assert(test_frame.get_u32(test_y * FRAME_W + test_x) == COL_SHOT);
    $println("render checks passed");
    $exit(0);
}

let island_ids = spawn_islands(read_checkpoint());
if (HEADLESS) {
    run_headless(island_ids);
    $exit(0);
}

let window = $window_create(FRAME_W, FRAME_H, "Genetic Algorithm Arena", 0);
let frame = ByteArray.with_size(FRAME_W * FRAME_H * 4);
let var next_offer = nil;
let var view_config = nil;
let var view_duel = nil;
let var last_draw = 0;
let var last_play_ms = $time_current_ms();
let var play_credit = 0.0;
let VIEW_SPEEDS = [1, 2, 4, 8, 10];
let var view_speed_idx = 0;
let var paused = false;
let island_stats = Array.with_size(NUM_ISLANDS, nil);
let var stats_pending = false;
let var stats_received = 0;
let var last_stats_request = 0;
let var last_rate_ms = 0;
let var last_total_matches = 0;
let var matches_per_sec = 0;
let var checkpoint_pending = false;
let var checkpoint_snaps = Array.with_size(NUM_ISLANDS, nil);
let var checkpoint_received = 0;
let var last_checkpoint_ms = $time_current_ms();

loop {
    loop {
        let msg = $actor_poll();
        if (msg == nil)
            break;
        if (msg instanceof Dict) {
            if (msg.kind == "MATCH" &&
                (next_offer == nil || msg.oldest_age > next_offer.oldest_age ||
                 (msg.oldest_age == next_offer.oldest_age && msg.match_no > next_offer.match_no)))
                next_offer = msg;
            else if (msg.kind == "STATS") {
                island_stats[msg.index] = msg;
                if (stats_pending) {
                    stats_received = stats_received + 1;
                    if (stats_received == NUM_ISLANDS) {
                        stats_pending = false;
                        let sample_time = $time_current_ms();
                        let totals = aggregate_stats(island_stats, 0);
                        if (last_rate_ms > 0 && sample_time > last_rate_ms)
                            matches_per_sec = ((totals.matches - last_total_matches).to_f() *
                                               1000.0 / (sample_time - last_rate_ms).to_f()).floor().max(0);
                        last_total_matches = totals.matches;
                        last_rate_ms = sample_time;
                    }
                }
            } else if (msg.kind == "CHECKPOINT" && checkpoint_pending &&
                       checkpoint_snaps[msg.index] == nil) {
                checkpoint_snaps[msg.index] = msg;
                checkpoint_received = checkpoint_received + 1;
                if (checkpoint_received == NUM_ISLANDS) {
                    save_checkpoint(checkpoint_snaps);
                    checkpoint_pending = false;
                    last_checkpoint_ms = $time_current_ms();
                }
            }
        }
        else if (msg.kind == "CLOSE_WINDOW")
            $exit(0);
        else if (msg.kind == "KEY_DOWN") {
            if (msg.key == "F")
                view_speed_idx = (view_speed_idx + 1) % VIEW_SPEEDS.len;
            else if (msg.key == "SPACE")
                paused = !paused;
            else if (msg.key == "N") {
                view_duel = nil;
                view_config = nil;
                play_credit = 0.0;
                paused = false;
            }
        }
    }

    let now = $time_current_ms();
    if (!checkpoint_pending && now >= last_checkpoint_ms + SAVE_INTERVAL_MS) {
        checkpoint_snaps = Array.with_size(NUM_ISLANDS, nil);
        checkpoint_received = 0;
        for (let var i = 0; i < island_ids.len; ++i)
            $actor_send(island_ids[i], [MSG_CHECKPOINT]);
        checkpoint_pending = true;
    }
    if (!stats_pending && now >= last_stats_request + 1000) {
        for (let var i = 0; i < island_ids.len; ++i)
            $actor_send(island_ids[i], [MSG_SNAPSHOT]);
        stats_pending = true;
        stats_received = 0;
        last_stats_request = now;
    }

    if ((view_duel == nil || view_duel.done) && next_offer != nil) {
        view_config = next_offer;
        next_offer = nil;
        view_duel = Match(
            Individual(view_config.first_weights, view_config.first_age,
                       view_config.first_name, view_config.first_colors,
                       view_config.first_rates, view_config.first_strengths),
            Individual(view_config.second_weights, view_config.second_age,
                       view_config.second_name, view_config.second_colors,
                       view_config.second_rates, view_config.second_strengths),
            view_config.seed
        );
        $println("Viewing island " + view_config.index.to_s() + " match " +
                 view_config.match_no.to_s() + ", oldest age " +
                 view_config.oldest_age.to_s());
        play_credit = 0.0;
        last_play_ms = now;
    }

    let view_speed = VIEW_SPEEDS[view_speed_idx];
    if (view_duel != nil && !view_duel.done && !paused) {
        play_credit = play_credit + (now - last_play_ms).to_f() * view_speed.to_f() / 100.0;
        let steps = play_credit.floor();
        play_credit = play_credit - steps.to_f();
        for (let var i = 0; i < steps; ++i) {
            if (view_duel.done)
                break;
            view_duel.step();
        }
    }
    last_play_ms = now;

    if (now >= last_draw + 33) {
        let snap = view_duel == nil ? nil : replay_snapshot(view_config, view_duel);
        let agg = aggregate_stats(island_stats, matches_per_sec);
        render(frame, snap, agg, view_speed, paused);
        $window_draw_frame(window, frame);
        last_draw = now;
    }
    $actor_sleep(2);
}
