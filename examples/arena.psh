// Arena GA, a small evolutionary 1v1 combat experiment.
//
// Each island samples two genomes to fight eight episodes in a randomly sized room.
// The winner stays unchanged, and a mutated child replaces the loser.
// Age counts matches lived through.
// Every 2,000 matches, an island copies one oldest individual to a ring neighbour.
// The migrant replaces the youngest resident at the next match boundary.
//
// Run with: plush examples/arena.psh
// F cycles viewer playback through 1x, 2x, 4x, 8x, and 10x.
// SPACE pauses the viewer; N skips to the next offered match.
// Movement and turning outputs command bounded acceleration.
// Islands always train at full speed. Headless: --headless --matches 1000.
// --migrate-period N overrides the default of 2,000 for short experiments.
// --max-room N overrides the initial 5 to 10 metre room range.
// --check-movement runs movement and arena assertions without starting islands.
// Render check: --check-render verifies pickup and shot colors without a window.
// Energy check: --check-energy verifies replenishment, action costs, and exhaustion.
// Map check: --check-maps validates varied layouts, clearance, and spawning.

from random import Xoshiro128;

fun has_flag(name) {
    for (let var i = 0; i < $cmd_num_args(); ++i)
        if ($cmd_get_arg(i) == name)
            return true;
    return false;
}

fun flag_int(name, fallback) {
    for (let var i = 0; i < $cmd_num_args() - 1; ++i) {
        if ($cmd_get_arg(i) == name) {
            let n = $cmd_get_arg(i + 1).parse_int(10);
            if (n != nil)
                return n;
        }
    }
    return fallback;
}

let HEADLESS = has_flag("--headless");
let MAX_MATCHES = flag_int("--matches", 0);
let NUM_ISLANDS = flag_int("--islands", 6).max(1);
let POP_SIZE = flag_int("--population", 64).max(2);
let SEED = flag_int("--seed", $time_current_ms());

let PI = 3.141592653589793;
let TAU = 2.0 * PI;
let DT = 0.1;
let EPISODE_TICKS = 300;
let EPISODES = 8;
let MIN_ROOM = 5;
let MAX_ROOM = flag_int("--max-room", 10).max(MIN_ROOM);
let BODY_RADIUS = 0.325;
let MAX_FORWARD = 3.0;
let MAX_STRAFE = 1.6;
let MAX_TURN = 3.5;
let FORWARD_ACCEL = 5.0;
let STRAFE_ACCEL = 5.0;
let TURN_ACCEL = 10.0;
let LINEAR_DRAG = 1.5;
let TURN_DRAG = 2.0;
// Mechanical-work equivalents, not dietary energy or a detailed fatigue model.
// Human cycling measurements suggest ~150 W sustained mechanical power.
// https://doi.org/10.1113/EP091429
// The smaller burst reserve is gameplay tuning for 30-second episodes.
let BODY_MASS = 75.0;
let MAX_ENERGY = 1_500.0;
let RECOVERY_POWER = 150.0;
// Running costs about 4 J/kg/metre metabolically. Use a fixed 25% conversion
// into our mechanical-work budget, not a detailed model of walking/running gaits.
// https://pubmed.ncbi.nlm.nih.gov/3569218/
let LOCOMOTION_J_PER_KG_METRE = 4.0 * 0.25;
// Stab impact energies are tens of joules; allow extra work for arm recovery.
// https://pubmed.ncbi.nlm.nih.gov/10464927/
// Attacking every 0.5 seconds exceeds the 150 W recovery budget.
let STAB_ENERGY = 150.0;
// Approximate trigger work: 20 N through 5 mm. Propellant supplies bullet energy.
let SHOT_ENERGY = 0.1;
let HEALTH = 100.0;
let KNIFE_RANGE = 1.0;
let KNIFE_DAMAGE = 34.0;
let KNIFE_DOT = 0.70710678;
let GUN_DAMAGE = 40.0;
let GUN_AMMO = 17;
let GUN_RADIUS = 0.18;
let GUN_PICKUP_RANGE = BODY_RADIUS + GUN_RADIUS;
let SHOT_TRACE_TICKS = 4;
let ATTACK_COOLDOWN = 5;
let ATTACK_ANIM_TICKS = 2;
let NOTCH_CHANCE = 0.4;
let MAX_OBSTACLE_FRACTION = 0.28;
let ROOM_LAYOUT_CHANCE = 0.7;
let MIGRATE_PERIOD = flag_int("--migrate-period", 2_000).max(1);
let MATCH_OFFER_INTERVAL_MS = 1500;

let VIEW_BINS = 7;
let VIEW_MIDDLE = VIEW_BINS.idiv(2);
let VIEW_HALF_ANGLE = PI / 3.0;
let OPPONENT_INPUT = VIEW_BINS;
let PICKUP_INPUT = OPPONENT_INPUT + 4;
let VIEW_INPUTS = PICKUP_INPUT + 3;
let BODY_INPUTS = 9;
let ENERGY_INPUT = VIEW_INPUTS + 7;
let NUM_SENSORS = VIEW_INPUTS + BODY_INPUTS;
let HIDDEN = 16;
let OUTPUTS = 4;
let RECURRENT = 10;
let NUM_INPUTS = NUM_SENSORS + RECURRENT;
let NUM_WEIGHTS = HIDDEN * NUM_INPUTS + (OUTPUTS + RECURRENT) * HIDDEN;
let OUTPUT_BASE = HIDDEN * NUM_INPUTS;
let RECURRENT_BASE = OUTPUT_BASE + OUTPUTS * HIDDEN;
let W_SCALE = 1.0 / NUM_INPUTS.to_f().sqrt();

// View rays cover 120 degrees with finer spacing near the centre of view.
let RAY_ANGLE = [];
let RAY_X = [];
let RAY_Y = [];
for (let var i = 0; i < VIEW_BINS; ++i) {
    let offset = i - VIEW_MIDDLE;
    let u = offset.abs().to_f() / VIEW_MIDDLE.to_f();
    let angle = (offset < 0 ? -1.0 : 1.0) * VIEW_HALF_ANGLE * u * u.sqrt();
    RAY_ANGLE.push(angle);
    RAY_X.push(angle.cos());
    RAY_Y.push(angle.sin());
}
fun new_genome(rng) {
    let weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    for (let var i = 0; i < NUM_WEIGHTS; ++i)
        weights.set_f32(i, rng.float(-W_SCALE, W_SCALE));
    return weights;
}

fun mutate(rng, parent) {
    let weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    weights.memcpy(0, parent, 0, NUM_WEIGHTS * 4);
    let count = (NUM_WEIGHTS.to_f() * 0.02).floor().max(1);
    for (let var i = 0; i < count; ++i) {
        let idx = rng.index(NUM_WEIGHTS);
        if (rng.float(0.0, 1.0) < 0.05)
            weights.set_f32(idx, rng.float(-W_SCALE, W_SCALE));
        else
            weights.set_f32(idx, rng.normal(weights.get_f32(idx), 0.08));
    }
    return weights;
}

fun random_name(rng) {
    let consonants = "BDFGKLMNPRSTVZ";
    let vowels = "AEIOU";
    let var name = "";
    let syllables = 2 + rng.index(3);
    for (let var i = 0; i < syllables; ++i) {
        name = name + consonants.char_at(rng.index(consonants.len));
        name = name + vowels.char_at(rng.index(vowels.len));
    }
    return name;
}

// Cosmetic genes never enter the neural network's perception or weights.
fun birth(rng, parent) {
    let colors = [];
    for (let var i = 0; i < 3; ++i) {
        colors.push(parent == nil ? 80 + rng.index(176) :
                    (parent.colors[i] + rng.index(33) - 16).max(80).min(255));
    }
    return Individual(parent == nil ? new_genome(rng) : mutate(rng, parent.weights),
                      0, random_name(rng), colors);
}

class Individual {
    init(self, weights, age, name, colors) {
        self.weights = weights;
        self.age = age;
        self.name = name;
        self.colors = colors;
    }

    color(self) {
        return 0xFF_00_00_00 | (self.colors[0] << 16) |
               (self.colors[1] << 8) | self.colors[2];
    }
}

// The grid has one metre cells, a wall border, and sparse connected cover layouts.
class Arena {
    init(self, inner_w, inner_h, rng) {
        self.inner_w = inner_w;
        self.inner_h = inner_h;
        self.width = inner_w + 2;
        self.height = inner_h + 2;
        self.tiles = ByteArray.with_size(self.width * self.height * 4);
        for (let var y = 0; y < self.height; ++y) {
            for (let var x = 0; x < self.width; ++x) {
                if (x == 0 || y == 0 || x == self.width - 1 || y == self.height - 1)
                    self.tiles.set_u32(y * self.width + x, 1);
            }
        }
        if (rng != nil)
            self.generate_cover(rng);
    }

    generate_cover(self, rng) {
        let room_layout = rng.float(0.0, 1.0) < ROOM_LAYOUT_CHANCE;
        // Occasionally retain an open room; otherwise vary the amount of cover.
        if (!room_layout && rng.index(8) == 0)
            return;
        let fraction = room_layout ? MAX_OBSTACLE_FRACTION : 0.16;
        let limit = (self.inner_w * self.inner_h * fraction).floor().max(1);
        let var occupied = room_layout ? self.generate_rooms(rng, limit) : 0;
        let budget = room_layout ? (occupied + rng.index(3)).min(limit) : 1 + rng.index(limit);
        for (let var attempt = 0; attempt < 24 && occupied < budget; ++attempt) {
            let attached = rng.float(0.0, 1.0) < NOTCH_CHANCE;
            let var w = 1;
            let var h = 1;
            if (attached) {
                w = 1 + rng.index(2);
                h = 1 + rng.index(2);
            } else {
                let shape = rng.index(4);
                if (shape == 1)
                    w = 2 + rng.index(2);
                else if (shape == 2)
                    h = 2 + rng.index(2);
                else if (shape == 3) {
                    w = 2;
                    h = 2;
                }
            }
            if (occupied + w * h > budget)
                continue;
            // Interior cover has a floor path on all four sides.
            let var x = 2 + rng.index(self.inner_w - w - 1);
            let var y = 2 + rng.index(self.inner_h - h - 1);
            if (attached) {
                let wall = rng.index(4);
                if (wall == 0)
                    x = 1;
                else if (wall == 1)
                    x = self.inner_w - w + 1;
                else if (wall == 2)
                    y = 1;
                else
                    y = self.inner_h - h + 1;
            }
            // Leave a full tile between separate obstacles, including at corners.
            let var separated = true;
            for (let var cy = (y - 1).max(1); cy <= (y + h).min(self.inner_h); ++cy)
                for (let var cx = (x - 1).max(1); cx <= (x + w).min(self.inner_w); ++cx)
                    if (self.solid(cx, cy))
                        separated = false;
            if (separated && self.try_cover(x, y, w, h))
                occupied = occupied + w * h;
        }
    }

    generate_rooms(self, rng, limit) {
        let rooms = [[1, 1, self.inner_w, self.inner_h]];
        let var occupied = 0;
        let target_rooms = 2 + rng.index(3);
        for (let var attempt = 0; attempt < 16 && rooms.len < target_rooms; ++attempt) {
            let index = rng.index(rooms.len);
            let room = rooms[index];
            let x = room[0];
            let y = room[1];
            let w = room[2];
            let h = room[3];
            if (w < 5 && h < 5)
                continue;
            let vertical = w >= 5 && (h < 5 || rng.index(2) == 0);
            let span = vertical ? h : w;
            if (occupied + span - 1 > limit)
                continue;
            // Each side retains at least two floor tiles of depth.
            let split = 2 + rng.index((vertical ? w : h) - 4);
            let wall_x = vertical ? x + split : x;
            let wall_y = vertical ? y : y + split;
            // A one-metre opening admits the 0.65-metre body. Prefer non-corner doors.
            let door = span > 2 ? 1 + rng.index(span - 2) : rng.index(span);
            if (!self.try_partition(wall_x, wall_y, span, vertical, door))
                continue;
            occupied = occupied + span - 1;
            rooms[index] = vertical ? [x, y, split, h] : [x, y, w, split];
            rooms.push(vertical ? [wall_x + 1, y, w - split - 1, h] :
                                  [x, wall_y + 1, w, h - split - 1]);
        }
        return occupied;
    }

    try_partition(self, x, y, span, vertical, door) {
        let cells = [];
        for (let var i = 0; i < span; ++i) {
            let cx = x + (vertical ? 0 : i);
            let cy = y + (vertical ? i : 0);
            if (self.solid(cx, cy))
                return false;
            if (i != door)
                cells.push(cy * self.width + cx);
        }
        for (let var i = 0; i < cells.len; ++i)
            self.tiles.set_u32(cells[i], 1);
        // Check the complete wall and doorway together, including earlier rooms.
        if (self.connected())
            return true;
        for (let var i = 0; i < cells.len; ++i)
            self.tiles.set_u32(cells[i], 0);
        return false;
    }

    try_cover(self, x, y, w, h) {
        if (w <= 0 || h <= 0 || x < 1 || y < 1 ||
            x + w > self.inner_w + 1 || y + h > self.inner_h + 1)
            return false;
        for (let var cy = y; cy < y + h; ++cy)
            for (let var cx = x; cx < x + w; ++cx)
                if (self.solid(cx, cy))
                    return false;
        for (let var cy = y; cy < y + h; ++cy)
            for (let var cx = x; cx < x + w; ++cx)
                self.tiles.set_u32(cy * self.width + cx, 1);
        if (self.connected())
            return true;
        // Undo the entire proposal when any floor area would become unreachable.
        for (let var cy = y; cy < y + h; ++cy)
            for (let var cx = x; cx < x + w; ++cx)
                self.tiles.set_u32(cy * self.width + cx, 0);
        return false;
    }

    connected(self) {
        let var start = -1;
        let var floor_count = 0;
        for (let var y = 1; y <= self.inner_h; ++y) {
            for (let var x = 1; x <= self.inner_w; ++x) {
                if (!self.solid(x, y)) {
                    floor_count = floor_count + 1;
                    start = y * self.width + x;
                }
            }
        }
        if (start < 0)
            return false;
        let visited = Array.with_size(self.width * self.height, false);
        let queue = [start];
        let offsets = [-1, 1, -self.width, self.width];
        visited[start] = true;
        for (let var head = 0; head < queue.len; ++head) {
            for (let var i = 0; i < offsets.len; ++i) {
                let next = queue[head] + offsets[i];
                // The solid border keeps this four-neighbour traversal in bounds.
                if (!visited[next] && self.tiles.get_u32(next) == 0) {
                    visited[next] = true;
                    queue.push(next);
                }
            }
        }
        return queue.len == floor_count;
    }

    add_notch(self, x, y) {
        self.tiles.set_u32(y * self.width + x, 1);
    }

    solid(self, x, y) {
        if (x < 0 || y < 0 || x >= self.width || y >= self.height)
            return true;
        return self.tiles.get_u32(y * self.width + x) != 0;
    }

    blocked(self, x, y) {
        if (x < 1.0 + BODY_RADIUS || x > self.inner_w.to_f() + 1.0 - BODY_RADIUS ||
            y < 1.0 + BODY_RADIUS || y > self.inner_h.to_f() + 1.0 - BODY_RADIUS)
            return true;
        for (let var ty = (y - BODY_RADIUS).floor(); ty <= (y + BODY_RADIUS).floor(); ++ty) {
            for (let var tx = (x - BODY_RADIUS).floor(); tx <= (x + BODY_RADIUS).floor(); ++tx) {
                if (!self.solid(tx, ty))
                    continue;
                let nx = x.clip(tx.to_f(), tx.to_f() + 1.0);
                let ny = y.clip(ty.to_f(), ty.to_f() + 1.0);
                let dx = x - nx;
                let dy = y - ny;
                if (dx * dx + dy * dy < BODY_RADIUS * BODY_RADIUS)
                    return true;
            }
        }
        return false;
    }

    // Walk grid cells until the ray enters a solid tile.
    wall_distance(self, x, y, dx, dy) {
        let var cell_x = x.floor();
        let var cell_y = y.floor();
        let var step_x = 0;
        let var step_y = 0;
        let var tx = 1.0e20;
        let var ty = 1.0e20;
        let var delta_x = 1.0e20;
        let var delta_y = 1.0e20;
        if (dx > 0.0) {
            step_x = 1;
            delta_x = 1.0 / dx;
            tx = (cell_x.to_f() + 1.0 - x) * delta_x;
        } else if (dx < 0.0) {
            step_x = -1;
            delta_x = -1.0 / dx;
            tx = (x - cell_x.to_f()) * delta_x;
        }
        if (dy > 0.0) {
            step_y = 1;
            delta_y = 1.0 / dy;
            ty = (cell_y.to_f() + 1.0 - y) * delta_y;
        } else if (dy < 0.0) {
            step_y = -1;
            delta_y = -1.0 / dy;
            ty = (y - cell_y.to_f()) * delta_y;
        }
        loop {
            let var distance = 0.0;
            if (tx < ty) {
                cell_x = cell_x + step_x;
                distance = tx;
                tx = tx + delta_x;
            } else {
                cell_y = cell_y + step_y;
                distance = ty;
                ty = ty + delta_y;
            }
            if (self.solid(cell_x, cell_y))
                return distance;
        }
    }
}

class Fighter {
    init(self, individual) {
        self.individual = individual;
        self.inputs = ByteArray.with_size(NUM_INPUTS * 4);
        self.next_hidden = ByteArray.with_size(HIDDEN * 4);
        self.action = Array.with_size(OUTPUTS, 0.0);
        self.reset(2.0, 2.0, 0.0);
    }

    reset(self, x, y, angle) {
        self.x = x;
        self.y = y;
        self.angle = angle;
        self.vx = 0.0;
        self.vy = 0.0;
        self.turn_velocity = 0.0;
        self.health = HEALTH;
        self.energy = MAX_ENERGY;
        self.cooldown = 0;
        self.attack_ticks = 0;
        self.gun_ammo = 0;
        self.shot_ticks = 0;
        self.shot_start_x = x;
        self.shot_start_y = y;
        self.shot_end_x = x;
        self.shot_end_y = y;
        self.inputs.fill_u32(0, NUM_INPUTS, 0);
        self.inputs.set_f32(ENERGY_INPUT, 1.0);
        self.inputs.set_f32(NUM_SENSORS - 1, 1.0);
    }

    recover(self) {
        self.energy = (self.energy + RECOVERY_POWER * DT).min(MAX_ENERGY);
    }

    sense(self, arena, other, gun_available, gun_x, gun_y, rng) {
        let inputs = self.inputs;
        let c = self.angle.cos();
        let s = self.angle.sin();
        let ex = other.x - self.x;
        let ey = other.y - self.y;
        let dist2 = ex * ex + ey * ey;
        let var opponent_visible = false;
        let var opponent_angle = 0.0;
        let var opponent_near = 0.0;
        let var gun_angle = 0.0;
        let var gun_near = 0.0;
        let var gun_visible = false;

        // One center ray per object prevents seeing pickups or opponents through walls.
        let forward = ex * c + ey * s;
        if (forward > 0.0 && dist2 > 0.000001) {
            let side = -ex * s + ey * c;
            let bearing = (side / forward).atan();
            if (bearing >= -VIEW_HALF_ANGLE && bearing <= VIEW_HALF_ANGLE) {
                let dist = dist2.sqrt();
                if (arena.wall_distance(self.x, self.y, ex / dist, ey / dist) >= dist) {
                    opponent_visible = true;
                    opponent_angle = bearing / VIEW_HALF_ANGLE;
                    opponent_near = 1.0 / (1.0 + (dist - BODY_RADIUS).max(0.0));
                }
            }
        }

        if (gun_available) {
            let gx = gun_x - self.x;
            let gy = gun_y - self.y;
            let gun_dist2 = gx * gx + gy * gy;
            let gun_forward = gx * c + gy * s;
            if (gun_forward > 0.0 && gun_dist2 > 0.000001) {
                let gun_side = -gx * s + gy * c;
                let gun_bearing = (gun_side / gun_forward).atan();
                if (gun_bearing >= -VIEW_HALF_ANGLE && gun_bearing <= VIEW_HALF_ANGLE) {
                    let dist = gun_dist2.sqrt();
                    if (arena.wall_distance(self.x, self.y, gx / dist, gy / dist) >= dist) {
                        gun_visible = true;
                        gun_angle = gun_bearing / VIEW_HALF_ANGLE;
                        gun_near = 1.0 / (1.0 + (dist - GUN_RADIUS).max(0.0));
                    }
                }
            }
            if (gun_dist2 <= 0.000001) {
                gun_visible = true;
                gun_near = 1.0;
            }
        }

        for (let var i = 0; i < VIEW_BINS; ++i) {
            let dx = c * RAY_X[i] - s * RAY_Y[i];
            let dy = s * RAY_X[i] + c * RAY_Y[i];
            let wall = arena.wall_distance(self.x, self.y, dx, dy);
            inputs.set_f32(i, 1.0 / (1.0 + wall));
        }
        inputs.set_f32(OPPONENT_INPUT, opponent_visible ? 1.0 : 0.0);
        inputs.set_f32(OPPONENT_INPUT + 1, opponent_angle);
        inputs.set_f32(OPPONENT_INPUT + 2, opponent_near);
        inputs.set_f32(OPPONENT_INPUT + 3,
                       opponent_visible && other.gun_ammo > 0 ? 1.0 : 0.0);
        inputs.set_f32(PICKUP_INPUT, gun_visible ? 1.0 : 0.0);
        inputs.set_f32(PICKUP_INPUT + 1, gun_angle);
        inputs.set_f32(PICKUP_INPUT + 2, gun_near);

        inputs.set_f32(VIEW_INPUTS, self.health / HEALTH);
        inputs.set_f32(VIEW_INPUTS + 1, (self.vx * c + self.vy * s) / MAX_FORWARD);
        inputs.set_f32(VIEW_INPUTS + 2, (-self.vx * s + self.vy * c) / MAX_STRAFE);
        inputs.set_f32(VIEW_INPUTS + 3, self.turn_velocity / MAX_TURN);
        inputs.set_f32(VIEW_INPUTS + 4, self.cooldown.to_f() / ATTACK_COOLDOWN.to_f());
        inputs.set_f32(VIEW_INPUTS + 5, rng.float(-1.0, 1.0));
        inputs.set_f32(VIEW_INPUTS + 6, self.gun_ammo.to_f() / GUN_AMMO.to_f());
        inputs.set_f32(ENERGY_INPUT, (self.energy / MAX_ENERGY).clip(0.0, 1.0));
    }

    think(self) {
        let weights = self.individual.weights;
        for (let var i = 0; i < HIDDEN; ++i) {
            let value = weights.dot_f32(i * NUM_INPUTS, 1, self.inputs, 0, 1, NUM_INPUTS);
            self.next_hidden.set_f32(i, value.clip(0.0, 8.0));
        }

        let out = self.action;
        for (let var i = 0; i < OUTPUTS; ++i) {
            let v = weights.dot_f32(OUTPUT_BASE + i * HIDDEN, 1, self.next_hidden, 0, 1, HIDDEN);
            out[i] = v / (1.0 + v.abs());
        }
        out[3] = (out[3] + 1.0) * 0.5;

        // Recurrent outputs become the next tick's memory inputs.
        for (let var i = 0; i < RECURRENT; ++i) {
            let v = weights.dot_f32(RECURRENT_BASE + i * HIDDEN, 1,
                                    self.next_hidden, 0, 1, HIDDEN);
            self.inputs.set_f32(NUM_SENSORS + i, v / (1.0 + v.abs()));
        }
        return out;
    }

    move(self, arena, action) {
        let turn_accel = (action[1] * TURN_ACCEL - self.turn_velocity * TURN_DRAG)
                         .clip(-TURN_ACCEL, TURN_ACCEL);
        self.turn_velocity = (self.turn_velocity + turn_accel * DT)
                             .clip(-MAX_TURN, MAX_TURN);
        self.angle = self.angle + self.turn_velocity * DT;
        if (self.angle > PI)
            self.angle = self.angle - TAU;
        else if (self.angle < -PI)
            self.angle = self.angle + TAU;

        let var f = action[0];
        let var side = action[2];
        let scale = (f * f + side * side).sqrt().max(1.0);
        f = f / scale;
        side = side / scale;
        let c = self.angle.cos();
        let s = self.angle.sin();
        let var ax = c * f * FORWARD_ACCEL - s * side * STRAFE_ACCEL - self.vx * LINEAR_DRAG;
        let var ay = s * f * FORWARD_ACCEL + c * side * STRAFE_ACCEL - self.vy * LINEAR_DRAG;
        let accel_scale = (ax * ax + ay * ay).sqrt().max(FORWARD_ACCEL) / FORWARD_ACCEL;
        ax = ax / accel_scale;
        ay = ay / accel_scale;
        let old_vx = self.vx;
        let old_vy = self.vy;
        let old_speed2 = old_vx * old_vx + old_vy * old_vy;
        self.vx = self.vx + ax * DT;
        self.vy = self.vy + ay * DT;

        // Cap each body-relative component, then cap diagonal running speed.
        let var forward_speed = (self.vx * c + self.vy * s).clip(-MAX_FORWARD, MAX_FORWARD);
        let var strafe_speed = (-self.vx * s + self.vy * c).clip(-MAX_STRAFE, MAX_STRAFE);
        let speed_scale = (forward_speed * forward_speed + strafe_speed * strafe_speed)
                          .sqrt().max(MAX_FORWARD) / MAX_FORWARD;
        forward_speed = forward_speed / speed_scale;
        strafe_speed = strafe_speed / speed_scale;
        self.vx = c * forward_speed - s * strafe_speed;
        self.vy = s * forward_speed + c * strafe_speed;

        // Charge footwork per metre plus positive changes in kinetic energy.
        // Drag only controls motion; overcoming it has no separate energy charge.
        let distance_cost = BODY_MASS * LOCOMOTION_J_PER_KG_METRE * DT;
        let wanted_speed2 = self.vx * self.vx + self.vy * self.vy;
        let wanted_cost = distance_cost * wanted_speed2.sqrt() +
                          0.5 * BODY_MASS * (wanted_speed2 - old_speed2).max(0.0);
        if (wanted_cost > self.energy) {
            // Solve for an affordable speed, including the acceleration surcharge.
            let var affordable = self.energy / distance_cost;
            if (self.energy > distance_cost * old_speed2.sqrt()) {
                let budget = self.energy + 0.5 * BODY_MASS * old_speed2;
                affordable = 2.0 * budget / (distance_cost +
                    (distance_cost * distance_cost + 2.0 * BODY_MASS * budget).sqrt());
            }
            let coast_x = old_vx * (1.0 - LINEAR_DRAG * DT);
            let coast_y = old_vy * (1.0 - LINEAR_DRAG * DT);
            let coast_speed2 = coast_x * coast_x + coast_y * coast_y;
            if (coast_speed2 > affordable * affordable) {
                // Exhaustion cannot erase momentum. Coast or brake until affordable.
                if (coast_speed2 < wanted_speed2) {
                    self.vx = coast_x;
                    self.vy = coast_y;
                }
            } else {
                // Intersect the requested velocity change with the affordable speed.
                let dvx = self.vx - coast_x;
                let dvy = self.vy - coast_y;
                let a = dvx * dvx + dvy * dvy;
                let b = coast_x * dvx + coast_y * dvy;
                let c0 = coast_speed2 - affordable * affordable;
                let u = ((-b + (b * b - a * c0).max(0.0).sqrt()) /
                         a.max(0.000000000001)).clip(0.0, 1.0);
                self.vx = coast_x + u * dvx;
                self.vy = coast_y + u * dvy;
            }
        }
        let speed2 = self.vx * self.vx + self.vy * self.vy;
        let spent = distance_cost * speed2.sqrt() +
                    0.5 * BODY_MASS * (speed2 - old_speed2).max(0.0);
        // Braking never refills energy; exhausted coasting cannot overdraw the reserve.
        self.energy = (self.energy - spent).max(0.0);

        // A tenth of a second is shorter than one tile at running speed.
        // Resolve each axis separately so fighters can slide along notches.
        let next_x = self.x + self.vx * DT;
        let next_y = self.y + self.vy * DT;
        let candidate_x = next_x.clip(1.0 + BODY_RADIUS,
                                       arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
        if (arena.blocked(candidate_x, self.y)) {
            let start_x = self.x;
            let var safe = 0.0;
            let var blocked = 1.0;
            for (let var i = 0; i < 6; ++i) {
                let middle = (safe + blocked) * 0.5;
                if (arena.blocked(start_x + (candidate_x - start_x) * middle, self.y))
                    blocked = middle;
                else
                    safe = middle;
            }
            self.x = start_x + (candidate_x - start_x) * safe;
        } else {
            self.x = candidate_x;
        }
        if (self.x != next_x)
            self.vx = 0.0;
        let candidate_y = next_y.clip(1.0 + BODY_RADIUS,
                                       arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
        if (arena.blocked(self.x, candidate_y)) {
            let start_y = self.y;
            let var safe = 0.0;
            let var blocked = 1.0;
            for (let var i = 0; i < 6; ++i) {
                let middle = (safe + blocked) * 0.5;
                if (arena.blocked(self.x, start_y + (candidate_y - start_y) * middle))
                    blocked = middle;
                else
                    safe = middle;
            }
            self.y = start_y + (candidate_y - start_y) * safe;
        } else {
            self.y = candidate_y;
        }
        if (self.y != next_y)
            self.vy = 0.0;
        if (self.cooldown > 0)
            self.cooldown = self.cooldown - 1;
        if (self.attack_ticks > 0)
            self.attack_ticks = self.attack_ticks - 1;
        if (self.shot_ticks > 0)
            self.shot_ticks = self.shot_ticks - 1;
    }

    push(self, arena, dx, dy) {
        let next_x = (self.x + dx).clip(1.0 + BODY_RADIUS,
                                       arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
        if (!arena.blocked(next_x, self.y))
            self.x = next_x;
        let next_y = (self.y + dy).clip(1.0 + BODY_RADIUS,
                                       arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
        if (!arena.blocked(self.x, next_y))
            self.y = next_y;
    }

    strikes(self, arena, other, attack_signal) {
        if (self.cooldown > 0 || attack_signal <= 0.5)
            return 0.0;
        let cost = self.gun_ammo > 0 ? SHOT_ENERGY : STAB_ENERGY;
        if (self.energy < cost)
            return 0.0;
        // An attempted attack costs energy even when it misses.
        self.energy = (self.energy - cost).max(0.0);
        self.cooldown = ATTACK_COOLDOWN;
        if (self.gun_ammo > 0) {
            self.gun_ammo = self.gun_ammo - 1;
            let c = self.angle.cos();
            let s = self.angle.sin();
            let wall = arena.wall_distance(self.x, self.y, c, s);
            let dx = other.x - self.x;
            let dy = other.y - self.y;
            let along = dx * c + dy * s;
            let side2 = dx * dx + dy * dy - along * along;
            let var hit = false;
            let var distance = wall;
            if (along >= 0.0 && side2 <= BODY_RADIUS * BODY_RADIUS) {
                let entry = (along - (BODY_RADIUS * BODY_RADIUS - side2).max(0.0).sqrt())
                            .max(0.0);
                if (entry <= wall) {
                    hit = true;
                    distance = entry;
                }
            }
            self.shot_start_x = self.x;
            self.shot_start_y = self.y;
            self.shot_end_x = self.x + c * distance;
            self.shot_end_y = self.y + s * distance;
            self.shot_ticks = SHOT_TRACE_TICKS;
            return hit ? GUN_DAMAGE : 0.0;
        }
        self.attack_ticks = ATTACK_ANIM_TICKS;
        let dx = other.x - self.x;
        let dy = other.y - self.y;
        let dist2 = dx * dx + dy * dy;
        let reach = KNIFE_RANGE + BODY_RADIUS;
        if (dist2 > reach * reach || dist2 < 0.000001)
            return 0.0;
        let dist = dist2.sqrt();
        if (arena.wall_distance(self.x, self.y, dx / dist, dy / dist) < dist - BODY_RADIUS)
            return 0.0;
        return (dx * self.angle.cos() + dy * self.angle.sin()) >= KNIFE_DOT * dist ?
               KNIFE_DAMAGE : 0.0;
    }
}

class Match {
    init(self, first, second, seed) {
        self.seed = seed;
        self.rng = Xoshiro128(seed);
        let rng = self.rng;
        let width = rng.index(MAX_ROOM - MIN_ROOM + 1) + MIN_ROOM;
        let height = rng.index(MAX_ROOM - MIN_ROOM + 1) + MIN_ROOM;
        self.arena = Arena(width, height, rng);
        self.fighters = [Fighter(first), Fighter(second)];
        self.kills = [0, 0];
        self.episode = 0;
        self.tick = 0;
        self.done = false;
        self.needs_reset = false;
        self.reset_episode();
    }

    reset_episode(self) {
        let rng = self.rng;
        let arena = self.arena;
        let var ax = 0.0;
        let var ay = 0.0;
        loop {
            ax = rng.float(1.0 + BODY_RADIUS, arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
            ay = rng.float(1.0 + BODY_RADIUS, arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
            if (!arena.blocked(ax, ay))
                break;
        }
        let var bx = 0.0;
        let var by = 0.0;
        loop {
            bx = rng.float(1.0 + BODY_RADIUS, arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
            by = rng.float(1.0 + BODY_RADIUS, arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
            let dx = bx - ax;
            let dy = by - ay;
            if (dx * dx + dy * dy >= 4.0 && !arena.blocked(bx, by))
                break;
        }
        self.fighters[0].reset(ax, ay, rng.float(-PI, PI));
        self.fighters[1].reset(bx, by, rng.float(-PI, PI));
        loop {
            self.gun_x = rng.float(1.0 + BODY_RADIUS,
                                   arena.inner_w.to_f() + 1.0 - BODY_RADIUS);
            self.gun_y = rng.float(1.0 + BODY_RADIUS,
                                   arena.inner_h.to_f() + 1.0 - BODY_RADIUS);
            let da_x = self.gun_x - ax;
            let da_y = self.gun_y - ay;
            let db_x = self.gun_x - bx;
            let db_y = self.gun_y - by;
            if (!arena.blocked(self.gun_x, self.gun_y) &&
                da_x * da_x + da_y * da_y >= 1.0 &&
                db_x * db_x + db_y * db_y >= 1.0)
                break;
        }
        self.gun_available = true;
        self.tick = 0;
        self.needs_reset = false;
    }

    pickup_gun(self) {
        if (!self.gun_available)
            return;
        let a = self.fighters[0];
        let b = self.fighters[1];
        let ax = a.x - self.gun_x;
        let ay = a.y - self.gun_y;
        let bx = b.x - self.gun_x;
        let by = b.y - self.gun_y;
        let da = ax * ax + ay * ay;
        let db = bx * bx + by * by;
        let reach2 = GUN_PICKUP_RANGE * GUN_PICKUP_RANGE;
        if (da > reach2 && db > reach2)
            return;
        let owner = da <= db ? a : b;
        owner.gun_ammo = GUN_AMMO;
        self.gun_available = false;
    }

    step(self) {
        if (self.needs_reset) {
            self.episode = self.episode + 1;
            self.reset_episode();
        }
        let rng = self.rng;
        let a = self.fighters[0];
        let b = self.fighters[1];
        a.recover();
        b.recover();
        a.sense(self.arena, b, self.gun_available, self.gun_x, self.gun_y, rng);
        b.sense(self.arena, a, self.gun_available, self.gun_x, self.gun_y, rng);
        let aa = a.think();
        let ba = b.think();
        a.move(self.arena, aa);
        b.move(self.arena, ba);

        // Resolve body overlap symmetrically so neither side can walk
        // through its opponent or gain priority from acting first.
        let dx = b.x - a.x;
        let dy = b.y - a.y;
        let distance = (dx * dx + dy * dy).sqrt();
        if (distance < 2.0 * BODY_RADIUS && distance > 0.000001) {
            let push = (2.0 * BODY_RADIUS - distance) * 0.5 / distance;
            a.push(self.arena, -dx * push, -dy * push);
            b.push(self.arena, dx * push, dy * push);
            let nx = dx / distance;
            let ny = dy / distance;
            let closing_speed = (a.vx - b.vx) * nx + (a.vy - b.vy) * ny;
            if (closing_speed > 0.0) {
                a.vx = a.vx - nx * closing_speed * 0.5;
                a.vy = a.vy - ny * closing_speed * 0.5;
                b.vx = b.vx + nx * closing_speed * 0.5;
                b.vy = b.vy + ny * closing_speed * 0.5;
            }
        }

        self.pickup_gun();
        let hit_a = a.strikes(self.arena, b, aa[3]);
        let hit_b = b.strikes(self.arena, a, ba[3]);
        b.health = b.health - hit_a;
        a.health = a.health - hit_b;
        self.tick = self.tick + 1;

        if (a.health <= 0.0 || b.health <= 0.0 || self.tick >= EPISODE_TICKS) {
            if (b.health <= 0.0)
                self.kills[0] = self.kills[0] + 1;
            if (a.health <= 0.0)
                self.kills[1] = self.kills[1] + 1;
            if (self.episode + 1 == EPISODES)
                self.done = true;
            else
                self.needs_reset = true;
        }
    }
}

fun check_room_connected(arena) {
    let visited = Array.with_size(arena.width * arena.height, false);
    let var start = -1;
    for (let var y = 1; y <= arena.inner_h; ++y)
        for (let var x = 1; x <= arena.inner_w; ++x)
            if (!arena.solid(x, y))
                start = y * arena.width + x;
    assert(start >= 0);
    let queue = [start];
    visited[start] = true;
    for (let var head = 0; head < queue.len; ++head) {
        let cell = queue[head];
        let x = cell % arena.width;
        let y = cell.idiv(arena.width);
        let neighbours = [[x - 1, y], [x + 1, y], [x, y - 1], [x, y + 1]];
        for (let var i = 0; i < neighbours.len; ++i) {
            let nx = neighbours[i][0];
            let ny = neighbours[i][1];
            if (arena.solid(nx, ny))
                continue;
            let next = ny * arena.width + nx;
            if (!visited[next]) {
                visited[next] = true;
                queue.push(next);
            }
        }
    }
    for (let var y = 1; y <= arena.inner_h; ++y)
        for (let var x = 1; x <= arena.inner_w; ++x)
            assert(arena.solid(x, y) || visited[y * arena.width + x]);
}

fun check_maps() {
    let barrier = Arena(5, 5, nil);
    assert(!barrier.try_cover(3, 1, 1, 5));
    for (let var y = 1; y <= 5; ++y)
        assert(!barrier.solid(3, y));
    assert(!barrier.try_cover(1, 1, 5, 5));
    assert(barrier.connected());
    assert(barrier.try_cover(2, 1, 1, 1));
    // A diagonal-only exit cannot rescue the corner at (1, 1).
    assert(!barrier.try_cover(1, 2, 1, 1));
    assert(!barrier.solid(1, 2) && barrier.solid(2, 1));
    assert(!barrier.try_cover(2, 1, 1, 2));
    assert(!barrier.solid(2, 2) && barrier.solid(2, 1));
    let pillar = Arena(5, 5, nil);
    assert(pillar.try_cover(2, 2, 1, 1));
    check_room_connected(pillar);

    let individual = Individual(ByteArray.with_size(NUM_WEIGHTS * 4), 0, "MAP", [80, 201, 255]);
    let duel = Match(individual, individual, 123);
    let var saw_open = false;
    let var saw_pillar = false;
    let var saw_wall = false;
    let var saw_square = false;
    let var saw_deep_recess = false;
    let var maps = 0;
    for (let var w = 5; w <= 10; ++w) {
        for (let var h = 5; h <= 10; ++h) {
            for (let var seed = 0; seed < 64; ++seed) {
                let map_seed = seed * 7919 + 12345;
                let arena = Arena(w, h, Xoshiro128(map_seed));
                let replay = Arena(w, h, Xoshiro128(map_seed));
                for (let var cell = 0; cell < arena.width * arena.height; ++cell)
                    assert(arena.tiles.get_u32(cell) == replay.tiles.get_u32(cell));
                assert(arena.connected());
                check_room_connected(arena);
                let var occupied = 0;
                for (let var y = 1; y <= h; ++y) {
                    for (let var x = 1; x <= w; ++x) {
                        if (arena.solid(x, y)) {
                            occupied = occupied + 1;
                            if (x > 1 && x < w && y > 1 && y < h) {
                                if (!arena.solid(x - 1, y) && !arena.solid(x + 1, y) &&
                                    !arena.solid(x, y - 1) && !arena.solid(x, y + 1))
                                    saw_pillar = true;
                                if ((x + 1 < w && arena.solid(x + 1, y)) ||
                                    (y + 1 < h && arena.solid(x, y + 1)))
                                    saw_wall = true;
                                if (x + 1 < w && y + 1 < h && arena.solid(x + 1, y) &&
                                    arena.solid(x, y + 1) && arena.solid(x + 1, y + 1))
                                    saw_square = true;
                            }
                            if ((x == 1 && arena.solid(2, y)) ||
                                (x == w && arena.solid(w - 1, y)) ||
                                (y == 1 && arena.solid(x, 2)) ||
                                (y == h && arena.solid(x, h - 1)))
                                saw_deep_recess = true;
                            continue;
                        }
                        // Verify physical body clearance along each flood-fill edge.
                        assert(!arena.blocked(x.to_f() + 0.5, y.to_f() + 0.5));
                        for (let var step = 1; step <= 4; ++step) {
                            let offset = step.to_f() * 0.25;
                            if (!arena.solid(x + 1, y))
                                assert(!arena.blocked(x.to_f() + 0.5 + offset, y.to_f() + 0.5));
                            if (!arena.solid(x, y + 1))
                                assert(!arena.blocked(x.to_f() + 0.5, y.to_f() + 0.5 + offset));
                        }
                    }
                }
                assert(occupied <= (w * h * MAX_OBSTACLE_FRACTION).floor());
                if (occupied == 0)
                    saw_open = true;
                duel.arena = arena;
                for (let var episode = 0; episode < 3; ++episode) {
                    duel.reset_episode();
                    let a = duel.fighters[0];
                    let b = duel.fighters[1];
                    assert(!arena.blocked(a.x, a.y) && !arena.blocked(b.x, b.y));
                    assert(!arena.blocked(duel.gun_x, duel.gun_y));
                    assert((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y) >= 4.0);
                }
                maps = maps + 1;
            }
        }
    }
    assert(saw_open && saw_pillar && saw_wall && saw_square && saw_deep_recess);
    $println("map checks passed: " + maps.to_s() + " layouts, 3 spawn rounds each");
}

if (has_flag("--check-maps")) {
    check_maps();
    $exit(0);
}

fun energy_scenario(individual, movement, attack_interval) {
    let arena = Arena(20, 20, nil);
    let fighter = Fighter(individual);
    let enemy = Fighter(individual);
    fighter.reset(10.0, 10.0, 0.0);
    enemy.reset(15.0, 10.0, 0.0);
    let var attacks = 0;
    let var first_denied_attack = -1;
    let var distance = 0.0;
    for (let var tick = 0; tick < EPISODE_TICKS; ++tick) {
        fighter.recover();
        fighter.move(arena, [movement, 0.0, 0.0, 0.0]);
        distance = distance + fighter.x - 10.0;
        if (attack_interval > 0 && tick % attack_interval == 0 && fighter.cooldown == 0) {
            fighter.strikes(arena, enemy, 1.0);
            if (fighter.cooldown > 0)
                attacks = attacks + 1;
            else if (first_denied_attack < 0)
                first_denied_attack = tick;
        }
        assert(fighter.energy >= 0.0 && fighter.energy <= MAX_ENERGY);
        // Simulate open ground; misses still spend energy, without ending the episode.
        fighter.x = 10.0;
        fighter.y = 10.0;
    }
    return {energy: fighter.energy, attacks: attacks,
            first_denied_attack: first_denied_attack, distance: distance};
}

fun check_energy() {
    let individual = Individual(ByteArray.with_size(NUM_WEIGHTS * 4), 0, "ENERGY", [80, 201, 255]);
    let fighter = Fighter(individual);
    let enemy = Fighter(individual);
    let arena = Arena(20, 20, nil);
    let rng = Xoshiro128(123);
    let forward = [1.0, 0.0, 0.0, 0.0];
    let idle = [0.0, 0.0, 0.0, 0.0];

    assert(fighter.energy == MAX_ENERGY);
    fighter.recover();
    assert(fighter.energy == MAX_ENERGY);
    fighter.energy = 0.0;
    fighter.recover();
    assert((fighter.energy - RECOVERY_POWER * DT).abs() < 0.000001);
    fighter.energy = MAX_ENERGY - 1.0;
    fighter.recover();
    assert(fighter.energy == MAX_ENERGY);
    for (let var i = 0; i <= 2; ++i) {
        fighter.energy = MAX_ENERGY * i.to_f() * 0.5;
        fighter.sense(arena, enemy, false, 0.0, 0.0, rng);
        assert(fighter.inputs.get_f32(ENERGY_INPUT) == i.to_f() * 0.5);
        assert(fighter.inputs.get_f32(NUM_SENSORS - 1) == 1.0);
    }

    // Starting from rest costs both kinetic energy and locomotion over the step.
    fighter.reset(10.0, 10.0, 0.0);
    fighter.move(arena, forward);
    let launch_cost = 0.5 * BODY_MASS * FORWARD_ACCEL * FORWARD_ACCEL * DT * DT +
                      BODY_MASS * LOCOMOTION_J_PER_KG_METRE * FORWARD_ACCEL * DT * DT;
    assert((MAX_ENERGY - fighter.energy - launch_cost).abs() < 0.000001);
    fighter.reset(10.0, 10.0, 0.0);
    let half_speed = FORWARD_ACCEL * DT * 0.5;
    fighter.energy = 0.5 * BODY_MASS * half_speed * half_speed +
                     BODY_MASS * LOCOMOTION_J_PER_KG_METRE * half_speed * DT;
    fighter.move(arena, forward);
    assert((fighter.vx - FORWARD_ACCEL * DT * 0.5).abs() < 0.000001);
    assert(fighter.energy >= 0.0 && fighter.energy < 0.000001);
    fighter.reset(10.0, 10.0, 0.0);
    fighter.energy = 0.0;
    fighter.move(arena, forward);
    assert(fighter.vx == 0.0 && fighter.x == 10.0 && fighter.energy == 0.0);
    fighter.move(arena, [0.0, 1.0, 0.0, 0.0]);
    assert(fighter.turn_velocity > 0.0 && fighter.energy == 0.0);

    // Exhausted agents coast to a stop instead of erasing their momentum instantly.
    fighter.reset(10.0, 10.0, 0.0);
    fighter.energy = 0.0;
    fighter.vx = MAX_FORWARD;
    fighter.move(arena, idle);
    assert((fighter.vx - MAX_FORWARD * (1.0 - LINEAR_DRAG * DT)).abs() < 0.000001);
    assert(fighter.energy == 0.0);
    fighter.reset(10.0, 10.0, 0.0);
    fighter.vx = MAX_FORWARD;
    fighter.move(arena, forward);
    assert(fighter.vx == MAX_FORWARD);
    // Constant speed charges only locomotion, not artificial drag or clipped acceleration.
    assert((MAX_ENERGY - fighter.energy -
            BODY_MASS * LOCOMOTION_J_PER_KG_METRE * MAX_FORWARD * DT).abs() < 0.000001);
    fighter.move(arena, [-1.0, 0.0, 0.0, 0.0]);
    assert(fighter.energy < MAX_ENERGY && fighter.energy >= 0.0);

    // Sustained running drains the burst reserve, then settles at a lower speed.
    fighter.reset(10.0, 10.0, 0.0);
    for (let var tick = 0; tick < 600; ++tick) {
        fighter.recover();
        fighter.move(arena, forward);
        assert(fighter.energy >= 0.0 && fighter.energy <= MAX_ENERGY);
        assert(fighter.vx >= 0.0 && fighter.vx <= MAX_FORWARD);
        // Keep this effort test away from walls without changing velocity.
        fighter.x = 10.0;
        fighter.y = 10.0;
    }
    assert(fighter.energy < RECOVERY_POWER * DT);
    assert(fighter.vx > 0.0 && fighter.vx < MAX_FORWARD * 0.75);
    for (let var tick = 0; tick < 1100; ++tick) {
        fighter.recover();
        fighter.move(arena, idle);
    }
    assert(fighter.energy == MAX_ENERGY);

    // Insufficient energy must not consume ammunition or start an attack cooldown.
    fighter.reset(10.0, 10.0, 0.0);
    enemy.reset(11.0, 10.0, 0.0);
    fighter.energy = STAB_ENERGY - 1.0;
    assert(fighter.strikes(arena, enemy, 1.0) == 0.0);
    assert(fighter.cooldown == 0 && fighter.attack_ticks == 0);
    assert(fighter.energy == STAB_ENERGY - 1.0);
    fighter.energy = STAB_ENERGY;
    assert(fighter.strikes(arena, enemy, 0.49) == 0.0);
    assert(fighter.strikes(arena, enemy, 0.5) == 0.0);
    assert(fighter.energy == STAB_ENERGY && fighter.cooldown == 0);
    assert(fighter.strikes(arena, enemy, 0.51) == KNIFE_DAMAGE);
    assert(fighter.energy == 0.0 && fighter.cooldown == ATTACK_COOLDOWN);
    fighter.cooldown = 0;
    fighter.energy = STAB_ENERGY;
    enemy.reset(15.0, 10.0, 0.0);
    assert(fighter.strikes(arena, enemy, 1.0) == 0.0);
    assert(fighter.energy == 0.0 && fighter.attack_ticks == ATTACK_ANIM_TICKS);
    fighter.cooldown = 0;
    fighter.gun_ammo = GUN_AMMO;
    assert(fighter.strikes(arena, enemy, 1.0) == 0.0);
    assert(fighter.gun_ammo == GUN_AMMO && fighter.cooldown == 0);
    fighter.energy = SHOT_ENERGY;
    assert(fighter.strikes(arena, enemy, 1.0) == GUN_DAMAGE);
    assert(fighter.energy == 0.0 && fighter.gun_ammo == GUN_AMMO - 1);

    // A network driven only by the energy sensor sees this tick's recovery.
    individual.weights.set_f32(ENERGY_INPUT, 1.0);
    individual.weights.set_f32(OUTPUT_BASE, 1.0);
    let duel = Match(individual, individual, 7);
    for (let var i = 0; i < 2; ++i)
        duel.fighters[i].energy = 0.0;
    duel.step();
    for (let var i = 0; i < 2; ++i) {
        let agent = duel.fighters[i];
        assert((agent.inputs.get_f32(ENERGY_INPUT) - RECOVERY_POWER * DT / MAX_ENERGY).abs() < 0.000001);
        assert(agent.action[0] > 0.0);
        assert(agent.energy > 0.0 && agent.energy < RECOVERY_POWER * DT);
    }
    duel.reset_episode();
    assert(duel.fighters[0].energy == MAX_ENERGY && duel.fighters[1].energy == MAX_ENERGY);

    let rushing = energy_scenario(individual, 1.0, 1);
    let running = energy_scenario(individual, 1.0, 0);
    let selective = energy_scenario(individual, 0.3, 20);
    let stationary = energy_scenario(individual, 0.0, 1);
    assert(rushing.first_denied_attack >= 0 && rushing.first_denied_attack < 100);
    assert(rushing.attacks < EPISODE_TICKS.idiv(ATTACK_COOLDOWN));
    assert(running.distance > rushing.distance);
    assert(selective.first_denied_attack == -1 && selective.attacks == EPISODE_TICKS.idiv(20));
    assert(selective.energy > MAX_ENERGY * 0.8);
    assert(stationary.first_denied_attack >= 0 && stationary.energy < STAB_ENERGY);
    $println("Run + stab: first denied attack at " +
             (rushing.first_denied_attack.to_f() * DT).to_s() + "s, " +
             rushing.attacks.to_s() + " attacks in 30s");
    $println("Slow + selective: " + selective.attacks.to_s() + " attacks, " +
             selective.energy.floor().to_s() + " J remaining");
    $println("energy checks passed");
}

if (has_flag("--check-energy")) {
    check_energy();
    $exit(0);
}

fun check_movement() {
    let fighter = Fighter(Individual(ByteArray.with_size(NUM_WEIGHTS * 4), 0, "TEST", [80, 201, 255]));
    let arena = Arena(20, 20, nil);
    let vision_arena = Arena(20, 20, nil);
    let enemy = Fighter(fighter.individual);
    let forward = [1.0, 0.0, 0.0, 0.0];
    let idle = [0.0, 0.0, 0.0, 0.0];

    assert(RAY_ANGLE[VIEW_MIDDLE] == 0.0);
    assert((RAY_ANGLE[0] + VIEW_HALF_ANGLE).abs() < 0.0001);
    assert((RAY_ANGLE[VIEW_BINS - 1] - VIEW_HALF_ANGLE).abs() < 0.0001);

    let memory_weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    memory_weights.set_f32(NUM_SENSORS - 1, 1.0);
    memory_weights.set_f32(NUM_INPUTS + NUM_SENSORS, 1.0);
    memory_weights.set_f32(OUTPUT_BASE, 1.0);
    memory_weights.set_f32(OUTPUT_BASE + HIDDEN + 1, 1.0);
    memory_weights.set_f32(RECURRENT_BASE, 1.0);
    let remembering = Fighter(Individual(memory_weights, 0, "MEMORY", [255, 155, 87]));
    let var actions = remembering.think();
    assert(actions[0] == 0.5 && actions[1] == 0.0);
    assert(remembering.inputs.get_f32(NUM_SENSORS) == 0.5);
    actions = remembering.think();
    assert(actions[0] == 0.5 && (actions[1] - 1.0 / 3.0).abs() < 0.000001);
    remembering.reset(2.0, 2.0, 0.0);
    assert(remembering.inputs.get_f32(NUM_SENSORS) == 0.0);
    actions = remembering.think();
    assert(actions[1] == 0.0 && remembering.inputs.get_f32(NUM_SENSORS) == 0.5);
    memory_weights.set_f32(RECURRENT_BASE, -1.0);
    remembering.reset(2.0, 2.0, 0.0);
    remembering.think();
    assert(remembering.inputs.get_f32(NUM_SENSORS) == -0.5);

    fighter.reset(10.0, 10.0, 0.0);
    enemy.reset(13.0, 10.0, 0.0);
    fighter.sense(vision_arena, enemy, true, 12.0, 10.0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(OPPONENT_INPUT) == 1.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 2) > 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 3) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT) == 1.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 2) > 0.0);
    enemy.gun_ammo = GUN_AMMO;
    fighter.sense(vision_arena, enemy, true, 12.0, 10.0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 3) == 1.0);
    enemy.gun_ammo = 0;
    let peripheral = 55.0 * PI / 180.0;
    enemy.reset(10.0 + 5.0 * peripheral.cos(), 10.0 + 5.0 * peripheral.sin(), 0.0);
    fighter.sense(vision_arena, enemy, false, 0.0, 0.0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(OPPONENT_INPUT) == 1.0);
    assert((fighter.inputs.get_f32(OPPONENT_INPUT + 1) - 55.0 / 60.0).abs() < 0.0001);
    assert(fighter.inputs.get_f32(PICKUP_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 2) == 0.0);
    enemy.reset(13.0, 10.0, 0.0);
    enemy.gun_ammo = GUN_AMMO;
    vision_arena.add_notch(12, 10);
    fighter.sense(vision_arena, enemy, true, 13.0, 10.0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(OPPONENT_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 1) == 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(OPPONENT_INPUT + 3) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT) == 0.0);
    assert(fighter.inputs.get_f32(PICKUP_INPUT + 2) == 0.0);
    assert(fighter.inputs.get_f32(VIEW_MIDDLE) > 0.0);

    fighter.reset(10.0, 10.0, 0.0);
    enemy.reset(13.0, 10.0, 0.0);
    fighter.gun_ammo = GUN_AMMO;
    fighter.sense(arena, enemy, false, 0.0, 0.0, Xoshiro128(1));
    assert(fighter.inputs.get_f32(VIEW_INPUTS + 6) == 1.0);
    assert(fighter.strikes(arena, enemy, 1.0) == GUN_DAMAGE);
    assert(fighter.gun_ammo == GUN_AMMO - 1 && fighter.shot_ticks == SHOT_TRACE_TICKS);
    assert((fighter.shot_end_x - (enemy.x - BODY_RADIUS)).abs() < 0.0001);
    for (let var shot = 1; shot < GUN_AMMO; ++shot) {
        fighter.cooldown = 0;
        assert(fighter.strikes(arena, enemy, 1.0) == GUN_DAMAGE);
    }
    assert(fighter.gun_ammo == 0);
    fighter.cooldown = 0;
    fighter.gun_ammo = 1;
    assert(fighter.strikes(vision_arena, enemy, 1.0) == 0.0);
    assert(fighter.gun_ammo == 0 && fighter.shot_end_x <= 12.0);
    fighter.cooldown = 0;
    enemy.reset(11.0, 10.0, 0.0);
    assert(fighter.strikes(arena, enemy, 1.0) == KNIFE_DAMAGE);

    let pickup = Match(fighter.individual, fighter.individual, 7);
    pickup.gun_x = pickup.fighters[0].x;
    pickup.gun_y = pickup.fighters[0].y;
    pickup.pickup_gun();
    assert(!pickup.gun_available && pickup.fighters[0].gun_ammo == GUN_AMMO);
    pickup.reset_episode();
    assert(pickup.gun_available && pickup.fighters[0].gun_ammo == 0);

    fighter.reset(10.0, 10.0, 0.0);
    fighter.move(arena, forward);
    assert((fighter.vx - FORWARD_ACCEL * DT).abs() < 0.0001);
    for (let var i = 0; i < 30; ++i)
        fighter.move(arena, forward);
    assert((fighter.vx - MAX_FORWARD).abs() < 0.0001);
    fighter.move(arena, idle);
    assert(fighter.vx < MAX_FORWARD && fighter.vx > 0.0);
    let before_brake = fighter.vx;
    fighter.move(arena, [-1.0, 0.0, 0.0, 0.0]);
    assert(before_brake - fighter.vx <= FORWARD_ACCEL * DT + 0.0001);

    fighter.reset(10.0, 10.0, 0.0);
    let strafe = [0.0, 0.0, 1.0, 0.0];
    for (let var i = 0; i < 30; ++i)
        fighter.move(arena, strafe);
    assert((fighter.vy - MAX_STRAFE).abs() < 0.0001);

    fighter.reset(10.0, 10.0, 0.0);
    let diagonal = [1.0, 0.0, 1.0, 0.0];
    for (let var i = 0; i < 30; ++i)
        fighter.move(arena, diagonal);
    assert((fighter.vx * fighter.vx + fighter.vy * fighter.vy).sqrt() <= MAX_FORWARD + 0.0001);

    fighter.reset(10.0, 10.0, 0.0);
    let turn = [0.0, 1.0, 0.0, 0.0];
    fighter.move(arena, turn);
    assert((fighter.turn_velocity - TURN_ACCEL * DT).abs() < 0.0001);
    for (let var i = 0; i < 20; ++i)
        fighter.move(arena, turn);
    assert((fighter.turn_velocity - MAX_TURN).abs() < 0.0001);
    fighter.move(arena, idle);
    assert(fighter.turn_velocity < MAX_TURN);

    fighter.reset(20.0 + 1.0 - BODY_RADIUS - 0.05, 10.0, 0.0);
    fighter.vx = MAX_FORWARD;
    fighter.move(arena, idle);
    assert(fighter.x <= 21.0 - BODY_RADIUS && fighter.vx == 0.0);

    let notched = Arena(5, 5, nil);
    notched.add_notch(3, 1);
    assert(notched.solid(3, 1) && !notched.solid(3, 2));
    assert(notched.blocked(3.5, 2.1) && !notched.blocked(4.5, 2.5));
    assert((notched.wall_distance(3.5, 3.0, 0.0, -1.0) - 1.0).abs() < 0.0001);
    fighter.reset(3.5, 2.5, -PI * 0.5);
    fighter.vy = -MAX_FORWARD;
    fighter.move(notched, idle);
    assert(fighter.y >= 2.0 + BODY_RADIUS && fighter.y < 2.5 && fighter.vy == 0.0);
    assert(!notched.blocked(fighter.x, fighter.y));

    let var saw_rectangle = false;
    for (let var seed = 0; seed < 20; ++seed) {
        let duel = Match(fighter.individual, fighter.individual, seed);
        let replay = Match(fighter.individual, fighter.individual, seed);
        assert(duel.arena.inner_w >= MIN_ROOM && duel.arena.inner_w <= MAX_ROOM);
        assert(duel.arena.inner_h >= MIN_ROOM && duel.arena.inner_h <= MAX_ROOM);
        if (duel.arena.inner_w != duel.arena.inner_h)
            saw_rectangle = true;
        for (let var tile = 0; tile < duel.arena.width * duel.arena.height; ++tile)
            assert(duel.arena.tiles.get_u32(tile) == replay.arena.tiles.get_u32(tile));
        assert(duel.fighters[0].x == replay.fighters[0].x);
        assert(duel.fighters[0].y == replay.fighters[0].y);
        assert(duel.gun_x == replay.gun_x && duel.gun_y == replay.gun_y);
        assert(!duel.arena.blocked(duel.gun_x, duel.gun_y));
        check_room_connected(duel.arena);
        for (let var tick = 0; tick < 3; ++tick) {
            duel.step();
            replay.step();
            assert(duel.fighters[0].x == replay.fighters[0].x);
            assert(duel.fighters[0].y == replay.fighters[0].y);
            assert(duel.fighters[1].x == replay.fighters[1].x);
            assert(duel.fighters[1].y == replay.fighters[1].y);
            assert(duel.gun_available == replay.gun_available);
            assert(duel.fighters[0].gun_ammo == replay.fighters[0].gun_ammo);
            assert(duel.fighters[0].energy == replay.fighters[0].energy);
            assert(duel.fighters[1].energy == replay.fighters[1].energy);
        }
        for (let var episode = 0; episode < EPISODES; ++episode) {
            let a = duel.fighters[0];
            let b = duel.fighters[1];
            let dx = b.x - a.x;
            let dy = b.y - a.y;
            assert(!duel.arena.blocked(a.x, a.y));
            assert(!duel.arena.blocked(b.x, b.y));
            assert(dx * dx + dy * dy >= 4.0);
            assert(!duel.arena.blocked(duel.gun_x, duel.gun_y));
            duel.reset_episode();
        }
    }
    if (MAX_ROOM > MIN_ROOM)
        assert(saw_rectangle);
    $println("movement and arena checks passed");
}

if (has_flag("--check-movement")) {
    let identity_rng = Xoshiro128(123);
    let parent = birth(identity_rng, nil);
    let original_color = parent.color();
    let var color_changed = false;
    for (let var i = 0; i < 100; ++i) {
        let child = birth(identity_rng, parent);
        assert(child.name.len >= 4 && child.name.len <= 8);
        assert(child.age == 0 && child.colors != parent.colors);
        for (let var channel = 0; channel < 3; ++channel) {
            assert(child.colors[channel] >= 80 && child.colors[channel] <= 255);
            assert((child.colors[channel] - parent.colors[channel]).abs() <= 16);
        }
        if (child.color() != original_color)
            color_changed = true;
    }
    assert(color_changed && parent.color() == original_color);
    check_movement();
    $exit(0);
}

class Island {
    init(self, index, seed) {
        self.index = index;
        self.rng = Xoshiro128(seed + index * 7919);
        self.population = [];
        for (let var i = 0; i < POP_SIZE; ++i)
            self.population.push(birth(self.rng, nil));
        self.pending_migrants = [];
        self.matches = 0;
        self.episodes = 0;
        self.kills = 0;
        self.zero_matches = 0;
        self.migrants_sent = 0;
        self.migrants_received = 0;
        self.last_offer_ms = -MATCH_OFFER_INTERVAL_MS;
        self.duel = nil;
        self.pick_match();
    }

    pick_match(self) {
        let a = self.rng.index(POP_SIZE);
        let var b = self.rng.index(POP_SIZE - 1);
        if (b >= a)
            b = b + 1;
        self.first_idx = a;
        self.second_idx = b;
        self.duel = Match(self.population[a], self.population[b],
                          self.rng.index(2_147_483_647));
    }

    receive(self, migrant) {
        self.pending_migrants.push(migrant);
    }

    migration_donor(self) {
        let var oldest = self.population[0];
        let var ties = 1;
        for (let var i = 1; i < self.population.len; ++i) {
            let candidate = self.population[i];
            if (candidate.age > oldest.age) {
                oldest = candidate;
                ties = 1;
            } else if (candidate.age == oldest.age) {
                // Choose uniformly among equally old residents.
                ties = ties + 1;
                if (self.rng.index(ties) == 0)
                    oldest = candidate;
            }
        }
        return oldest;
    }

    // Offer a complete match only when the oldest resident is selected.
    // The viewer gets genomes and a seed, then simulates its own copy.
    match_offer(self, now) {
        if (self.duel.episode != 0 || self.duel.tick != 0 ||
            now < self.last_offer_ms + MATCH_OFFER_INTERVAL_MS)
            return nil;
        let var oldest = 0;
        for (let var i = 1; i < POP_SIZE; ++i) {
            if (self.population[i].age > self.population[oldest].age)
                oldest = i;
        }
        if (oldest != self.first_idx && oldest != self.second_idx)
            return nil;
        self.last_offer_ms = now;
        return {
            kind: "MATCH", index: self.index, match_no: self.matches + 1,
            seed: self.duel.seed, room_w: self.duel.arena.inner_w,
            room_h: self.duel.arena.inner_h,
            oldest_age: self.population[oldest].age,
            oldest_side: oldest == self.first_idx ? 0 : 1,
            first_weights: self.population[self.first_idx].weights,
            second_weights: self.population[self.second_idx].weights,
            first_age: self.population[self.first_idx].age,
            second_age: self.population[self.second_idx].age,
            first_name: self.population[self.first_idx].name,
            second_name: self.population[self.second_idx].name,
            first_colors: self.population[self.first_idx].colors,
            second_colors: self.population[self.second_idx].colors
        };
    }

    apply_migrants(self) {
        if (self.pending_migrants.len == 0)
            return;
        let var replaced = Array.with_size(POP_SIZE, false);
        for (let var m = 0; m < self.pending_migrants.len; ++m) {
            if (m > 0 && m % POP_SIZE == 0)
                replaced = Array.with_size(POP_SIZE, false);
            let start = self.rng.index(POP_SIZE);
            let var youngest = -1;
            for (let var i = 0; i < POP_SIZE; ++i) {
                let idx = (start + i) % POP_SIZE;
                if (!replaced[idx] &&
                    (youngest < 0 || self.population[idx].age < self.population[youngest].age))
                    youngest = idx;
            }
            let migrant = self.pending_migrants[m];
            self.population[youngest] = Individual(migrant[0], migrant[1], migrant[2], migrant[3]);
            replaced[youngest] = true;
            self.migrants_received = self.migrants_received + 1;
        }
        self.pending_migrants.resize(0, nil);
    }

    step(self) {
        if (MAX_MATCHES > 0 && self.matches >= MAX_MATCHES)
            return false;
        self.duel.step();
        if (!self.duel.done)
            return false;

        let ka = self.duel.kills[0];
        let kb = self.duel.kills[1];
        for (let var i = 0; i < POP_SIZE; ++i)
            self.population[i].age = self.population[i].age + 1;
        if (ka != kb) {
            let win_first = ka > kb;
            let winner_idx = win_first ? self.first_idx : self.second_idx;
            let loser_idx = win_first ? self.second_idx : self.first_idx;
            let winner = self.population[winner_idx];
            self.population[loser_idx] = birth(self.rng, winner);
        }
        self.matches = self.matches + 1;
        self.episodes = self.episodes + EPISODES;
        self.kills = self.kills + ka + kb;
        if (ka == 0 && kb == 0)
            self.zero_matches = self.zero_matches + 1;
        self.apply_migrants();
        if (MAX_MATCHES == 0 || self.matches < MAX_MATCHES)
            self.pick_match();
        return self.matches % MIGRATE_PERIOD == 0;
    }

    snapshot(self) {
        let var oldest = 0;
        let var age_sum = 0;
        for (let var i = 0; i < POP_SIZE; ++i) {
            oldest = oldest.max(self.population[i].age);
            age_sum = age_sum + self.population[i].age;
        }
        return {
            kind: "STATS", index: self.index,
            matches: self.matches, episodes: self.episodes,
            kills: self.kills, zero_matches: self.zero_matches,
            migrants_sent: self.migrants_sent, migrants_received: self.migrants_received,
            oldest: oldest, mean_age: age_sum.idiv(POP_SIZE)
        };
    }
}

let MSG_SETUP = 0;
let MSG_SNAPSHOT = 1;
let MSG_MIGRANT = 3;
let BATCH = 32;

fun island_actor() {
    let setup = $actor_recv();
    let ids = setup[3];
    let island = Island(setup[1], setup[2]);
    let parent = $actor_parent();

    loop {
        loop {
            let msg = $actor_poll();
            if (msg == nil)
                break;
            if (msg[0] == MSG_SNAPSHOT)
                $actor_send(parent, island.snapshot());
            else if (msg[0] == MSG_MIGRANT)
                island.receive(msg[1]);
        }

        for (let var i = 0; i < BATCH; ++i) {
            if (!HEADLESS && island.duel.episode == 0 && island.duel.tick == 0) {
                let offer = island.match_offer($time_current_ms());
                if (offer != nil)
                    $actor_send(parent, offer);
            }
            if (island.step()) {
                if (ids.len > 1) {
                    let side = island.rng.index(2) == 0 ? -1 : 1;
                    let neighbour = (island.index + ids.len + side) % ids.len;
                    let donor = island.migration_donor();
                    $actor_send(ids[neighbour], [MSG_MIGRANT,
                                [donor.weights, donor.age, donor.name, donor.colors]]);
                    island.migrants_sent = island.migrants_sent + 1;
                    $println("Migration: island " + island.index.to_s() + " -> " +
                             neighbour.to_s() + " at match " + island.matches.to_s() +
                             ", migrant age " + donor.age.to_s());
                }
            }
        }

        if (MAX_MATCHES > 0 && island.matches >= MAX_MATCHES)
            $actor_sleep(10);
    }
}

fun spawn_islands() {
    let ids = [];
    for (let var i = 0; i < NUM_ISLANDS; ++i)
        ids.push($actor_spawn(island_actor));
    for (let var i = 0; i < NUM_ISLANDS; ++i)
        $actor_send(ids[i], [MSG_SETUP, i, SEED, ids]);
    return ids;
}

fun gather(ids) {
    let snaps = Array.with_size(ids.len, nil);
    for (let var i = 0; i < ids.len; ++i)
        $actor_send(ids[i], [MSG_SNAPSHOT]);
    for (let var i = 0; i < ids.len; ++i) {
        let snap = $actor_recv();
        snaps[snap.index] = snap;
    }
    return snaps;
}

fun run_headless(ids) {
    let limit = MAX_MATCHES > 0 ? MAX_MATCHES : 1000;
    let start = $time_current_ms();
    $println("seed " + SEED.to_s() + "  islands " + NUM_ISLANDS.to_s() +
             "  population " + POP_SIZE.to_s() + "  matches/island " + limit.to_s());
    $println("island  matches  kills  zero  oldest  mean_age  sent  received");
    loop {
        let snaps = gather(ids);
        let var finished = true;
        for (let var i = 0; i < snaps.len; ++i) {
            let s = snaps[i];
            if (s.matches < limit)
                finished = false;
            $println(i.to_s().rpad(8, ' ') + s.matches.to_s().rpad(9, ' ') +
                     s.kills.to_s().rpad(7, ' ') + s.zero_matches.to_s().rpad(6, ' ') +
                     s.oldest.to_s().rpad(8, ' ') + s.mean_age.to_s().rpad(10, ' ') +
                     s.migrants_sent.to_s().rpad(6, ' ') + s.migrants_received.to_s());
        }
        if (finished) {
            $println("elapsed_ms " + ($time_current_ms() - start).to_s());
            return;
        }
        $actor_sleep(1000);
    }
}

let FRAME_W = 900;
let FRAME_H = 640;
let VIEW_W = 620;
let PIXELS_PER_METRE = 44;
let COL_BG = 0xFF_17_1C_22;
let COL_FLOOR = 0xFF_29_32_3A;
let COL_WALL = 0xFF_61_6B_72;
let COL_A = 0xFF_52_C9_FF;
let COL_B = 0xFF_FF_9B_57;
let COL_TEXT = 0xFF_E1_E8_EB;
let COL_DIM = 0xFF_9B_A9_B0;
let COL_SKIN = 0xFF_F3_D1_AC;
let COL_BLADE = 0xFF_D8_E4_EA;
let COL_GUN = 0xFF_C4_C9_CD;
let COL_GUN_HIGHLIGHT = 0xFF_E3_E8_EA;
let COL_GUN_SHADOW = 0xFF_6D_78_80;
let COL_SHOT = 0xFF_FF_E4_63;

fun fill_rect(buf, x, y, w, h, color) {
    let x0 = x.max(0);
    let y0 = y.max(0);
    let x1 = (x + w).min(FRAME_W);
    let y1 = (y + h).min(FRAME_H);
    for (let var row = y0; row < y1; ++row)
        if (x1 > x0)
            buf.fill_u32(row * FRAME_W + x0, x1 - x0, color);
}

fun draw_disc(buf, cx, cy, radius, color) {
    for (let var dy = -radius; dy <= radius; ++dy) {
        let half = (radius * radius - dy * dy).to_f().sqrt().floor();
        fill_rect(buf, cx - half, cy + dy, 2 * half + 1, 1, color);
    }
}

fun draw_segment(buf, x0, y0, x1, y1, radius, color) {
    let steps = (x1 - x0).abs().max((y1 - y0).abs()).max(1);
    for (let var i = 0; i <= steps; ++i) {
        let t = i.to_f() / steps.to_f();
        let x = (x0.to_f() + (x1 - x0).to_f() * t).floor();
        let y = (y0.to_f() + (y1 - y0).to_f() * t).floor();
        draw_disc(buf, x, y, radius, color);
    }
}

fun draw_pistol(buf, grip_x, grip_y, angle, metres) {
    let c = angle.cos();
    let s = angle.sin();
    let right_x = -s;
    let right_y = c;
    let rear_x = grip_x - (c * metres * 0.11).floor();
    let rear_y = grip_y - (s * metres * 0.11).floor();
    let muzzle_x = grip_x + (c * metres * 0.238).floor();
    let muzzle_y = grip_y + (s * metres * 0.238).floor();
    let handle_top_x = grip_x - (c * metres * 0.05).floor();
    let handle_top_y = grip_y - (s * metres * 0.05).floor();
    let handle_x = handle_top_x + (right_x * metres * 0.12).floor();
    let handle_y = handle_top_y + (right_y * metres * 0.12).floor();
    let half_handle = (metres * 0.12).floor().max(1);
    let guard_x = grip_x + (c * metres * 0.08).floor() +
                  (right_x * metres * 0.08).floor();
    let guard_y = grip_y + (s * metres * 0.08).floor() +
                  (right_y * metres * 0.08).floor();
    // Taper a single trapezoid toward its flat base, with a backward lean.
    let handle_bound = half_handle + 5;
    for (let var dy = -handle_bound; dy <= handle_bound; ++dy) {
        for (let var dx = -handle_bound; dx <= handle_bound; ++dx) {
            let down = -dx.to_f() * s + dy.to_f() * c;
            let forward = dx.to_f() * c + dy.to_f() * s;
            let t = ((down + half_handle.to_f()) / (2 * half_handle).to_f()).max(0.0).min(1.0);
            let center = -t * (2 * half_handle).to_f() * 0.10;
            let half_width = 3.0 - t * 1.25;
            let edge = half_width - (forward - center).abs();
            if (down.abs() <= (half_handle + 1).to_f() && edge >= -1.0)
                fill_rect(buf, handle_x + dx, handle_y + dy, 1, 1, COL_BG);
            if (down.abs() <= half_handle.to_f() && edge > -0.5) {
                // Smooth the sloping edges so this small grip reads as one shape.
                let coverage = (edge + 0.5).min(1.0);
                let var shade = 0xFF_00_00_00;
                for (let var shift = 0; shift <= 16; shift = shift + 8) {
                    let bg = (COL_BG >> shift) & 255;
                    let fg = (COL_GUN_SHADOW >> shift) & 255;
                    shade = shade | ((bg.to_f() + (fg - bg).to_f() * coverage).floor() << shift);
                }
                fill_rect(buf, handle_x + dx, handle_y + dy, 1, 1, shade);
            }
        }
    }
    draw_segment(buf, handle_top_x, handle_top_y, guard_x, guard_y, 0, COL_GUN_SHADOW);
    // A rectangular slide gives the pickup a flat top and squared ends.
    let slide_x = (rear_x + muzzle_x).idiv(2);
    let slide_y = (rear_y + muzzle_y).idiv(2);
    let half_slide = (metres * 0.174).floor().max(1);
    let slide_thickness = (3.0 * 0.8).floor();
    draw_body(buf, slide_x, slide_y, angle, half_slide + 1, slide_thickness + 1,
              (half_slide + 5).to_f(), COL_BG);
    draw_body(buf, slide_x, slide_y, angle, half_slide, slide_thickness,
              (half_slide + 5).to_f(), COL_GUN);
    draw_segment(buf, rear_x - right_x.floor(), rear_y - right_y.floor(),
                 muzzle_x - right_x.floor(), muzzle_y - right_y.floor(),
                 0, COL_GUN_HIGHLIGHT);
    draw_segment(buf, muzzle_x - (right_x * slide_thickness).floor(),
                 muzzle_y - (right_y * slide_thickness).floor(),
                 muzzle_x + (right_x * slide_thickness).floor(),
                 muzzle_y + (right_y * slide_thickness).floor(), 0, COL_GUN_SHADOW);
}

fun draw_body(buf, x, y, angle, half_length, half_width, radius, color) {
    let c = angle.cos();
    let s = angle.sin();
    let bound = radius.floor() + 1;
    for (let var dy = -bound; dy <= bound; ++dy) {
        for (let var dx = -bound; dx <= bound; ++dx) {
            if (dx * dx + dy * dy > radius * radius)
                continue;
            let forward = dx.to_f() * c + dy.to_f() * s;
            let side = -dx.to_f() * s + dy.to_f() * c;
            if (forward.abs() <= half_length.to_f() && side.abs() <= half_width.to_f())
                fill_rect(buf, x + dx, y + dy, 1, 1, color);
        }
    }
}

let FONT = {
    "0": [7,5,5,5,7], "1": [2,6,2,2,7], "2": [7,1,7,4,7], "3": [7,1,7,1,7],
    "4": [5,5,7,1,1], "5": [7,4,7,1,7], "6": [7,4,7,5,7], "7": [7,1,1,1,1],
    "8": [7,5,7,5,7], "9": [7,5,7,1,7],
    "A": [7,5,7,5,5], "B": [6,5,6,5,6], "C": [7,4,4,4,7], "D": [6,5,5,5,6],
    "E": [7,4,7,4,7], "F": [7,4,7,4,4], "G": [7,4,5,5,7], "H": [5,5,7,5,5],
    "I": [7,2,2,2,7], "J": [1,1,1,5,7], "K": [5,5,6,5,5], "L": [4,4,4,4,7],
    "M": [5,7,7,5,5], "N": [6,5,5,5,5], "O": [7,5,5,5,7], "P": [7,5,7,4,4],
    "R": [7,5,6,5,5], "S": [7,4,7,1,7], "T": [7,2,2,2,2], "U": [5,5,5,5,7],
    "V": [5,5,5,5,2], "W": [5,5,7,7,5], "X": [5,5,2,5,5], "Y": [5,5,2,2,2], "Z": [7,1,2,4,7],
    " ": [0,0,0,0,0], ",": [0,0,0,6,2], ":": [0,2,0,2,0],
    "/": [1,1,2,4,4], "-": [0,0,7,0,0]
};

fun draw_text(buf, x, y, label, color) {
    for (let var i = 0; i < label.len; ++i) {
        let ch = label.char_at(i);
        if (!FONT.has(ch))
            continue;
        let rows = FONT[ch];
        for (let var row = 0; row < 5; ++row) {
            for (let var col = 0; col < 3; ++col) {
                if (((rows[row] >> (2 - col)) & 1) != 0)
                    fill_rect(buf, x + i * 8 + col * 2, y + row * 2, 2, 2, color);
            }
        }
    }
}

fun draw_fighter(buf, x, y, angle, hp, attack_ticks, gun_ammo, color, scale) {
    let c = angle.cos();
    let s = angle.sin();
    let right_x = -s;
    let right_y = c;
    let metres = scale.to_f();
    let body_radius = metres * BODY_RADIUS;
    let half_length = (metres * BODY_RADIUS * 0.62).floor().max(1);
    let half_width = (metres * BODY_RADIUS * 0.78 * 1.20).floor().max(1);
    draw_body(buf, x, y, angle, half_length, half_width, body_radius, COL_BG);
    draw_body(buf, x, y, angle, (half_length - 1).max(1),
              (half_width - 1).max(1), body_radius, color);
    let head_radius = (metres * BODY_RADIUS * 0.32 * 1.50).floor().max(2);
    draw_disc(buf, x, y, head_radius + 1, COL_BG);
    draw_disc(buf, x, y, head_radius, COL_SKIN);

    let thrust = gun_ammo > 0 ? 0.0 :
                 attack_ticks == 2 ? 0.20 : attack_ticks == 1 ? 0.10 : 0.0;
    let side_offset = gun_ammo > 0 ? 0.0 : 0.22;
    let forward_offset = gun_ammo > 0 ? 0.32 : 0.09 + thrust;
    let hand_x = x + (c * metres * forward_offset + right_x * metres * side_offset).floor();
    let hand_y = y + (s * metres * forward_offset + right_y * metres * side_offset).floor();
    if (gun_ammo > 0) {
        // From above, the slide hides the grip and points ahead of the hands.
        let muzzle_x = hand_x + (c * metres * 0.28).floor();
        let muzzle_y = hand_y + (s * metres * 0.28).floor();
        draw_segment(buf, hand_x, hand_y, muzzle_x, muzzle_y, 3, COL_BG);
        draw_segment(buf, hand_x, hand_y, muzzle_x, muzzle_y, 2, COL_GUN);
        draw_segment(buf, hand_x, hand_y, muzzle_x, muzzle_y, 0, COL_GUN_HIGHLIGHT);
        draw_disc(buf, muzzle_x, muzzle_y, 1, COL_GUN_SHADOW);
    } else {
        let blade_x = hand_x + (c * metres * 0.08).floor();
        let blade_y = hand_y + (s * metres * 0.08).floor();
        let tip_x = hand_x + (c * metres * 0.36).floor();
        let tip_y = hand_y + (s * metres * 0.36).floor();
        draw_segment(buf, hand_x, hand_y, blade_x, blade_y, 2, COL_BG);
        draw_segment(buf, blade_x, blade_y, tip_x, tip_y, 1, COL_BLADE);
    }
    draw_disc(buf, hand_x, hand_y, (metres * 0.07).floor().max(2), COL_SKIN);

    fill_rect(buf, x - 15, y - 21, 30, 4, COL_BG);
    fill_rect(buf, x - 15, y - 21, (hp.max(0.0) * 0.3).floor(), 4, color);
}

fun replay_snapshot(config, duel) {
    let a = duel.fighters[0];
    let b = duel.fighters[1];
    return {
        index: config.index, match_no: config.match_no,
        first_age: config.first_age, second_age: config.second_age,
        first_name: a.individual.name, second_name: b.individual.name,
        first_color: a.individual.color(), second_color: b.individual.color(),
        oldest_side: config.oldest_side,
        room_w: duel.arena.inner_w, room_h: duel.arena.inner_h,
        tiles: duel.arena.tiles,
        gun_available: duel.gun_available, gun_x: duel.gun_x, gun_y: duel.gun_y,
        episode: duel.episode.min(EPISODES - 1), tick: duel.tick,
        kills_a: duel.kills[0], kills_b: duel.kills[1],
        ax: a.x, ay: a.y, adir: a.angle, ahp: a.health, astab: a.attack_ticks,
        aammo: a.gun_ammo, ashot: a.shot_ticks, aenergy: a.energy,
        asx: a.shot_start_x, asy: a.shot_start_y, aex: a.shot_end_x, aey: a.shot_end_y,
        bx: b.x, by: b.y, bdir: b.angle, bhp: b.health, bstab: b.attack_ticks,
        bammo: b.gun_ammo, bshot: b.shot_ticks, benergy: b.energy,
        bsx: b.shot_start_x, bsy: b.shot_start_y, bex: b.shot_end_x, bey: b.shot_end_y
    };
}

fun aggregate_stats(snaps, matches_per_sec) {
    let var matches = 0;
    let var kills = 0;
    let var zero_matches = 0;
    let var migrations = 0;
    let var oldest = 0;
    for (let var i = 0; i < snaps.len; ++i) {
        let s = snaps[i];
        if (s == nil)
            continue;
        matches = matches + s.matches;
        kills = kills + s.kills;
        zero_matches = zero_matches + s.zero_matches;
        migrations = migrations + s.migrants_sent;
        oldest = oldest.max(s.oldest);
    }
    return {
        matches: matches, matches_per_sec: matches_per_sec,
        kills: kills, zero_matches: zero_matches,
        migrations: migrations, oldest: oldest
    };
}

fun render(buf, snap, agg, view_speed, paused) {
    buf.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
    if (snap == nil) {
        draw_text(buf, 42, 300, "WAITING FOR OLDEST MATCH", COL_TEXT);
    } else {
        let scale = PIXELS_PER_METRE.min(VIEW_W.idiv(snap.room_w + 2))
                                     .min(FRAME_H.idiv(snap.room_h + 2)).max(4);
        let ox = (VIEW_W - (snap.room_w + 2) * scale).idiv(2);
        let oy = (FRAME_H - (snap.room_h + 2) * scale).idiv(2);
        let grid_w = snap.room_w + 2;
        for (let var y = 0; y < snap.room_h + 2; ++y) {
            for (let var x = 0; x < snap.room_w + 2; ++x) {
                let wall = snap.tiles.get_u32(y * grid_w + x) != 0;
                fill_rect(buf, ox + x * scale, oy + y * scale, scale - 1, scale - 1,
                          wall ? COL_WALL : COL_FLOOR);
            }
        }
        if (snap.gun_available) {
            let gun_px = ox + (snap.gun_x * scale).floor();
            let gun_py = oy + (snap.gun_y * scale).floor();
            draw_pistol(buf, gun_px, gun_py, 0.0, scale.to_f() * 1.25);
        }
        if (snap.ashot > 0)
            draw_segment(buf, ox + (snap.asx * scale).floor(), oy + (snap.asy * scale).floor(),
                         ox + (snap.aex * scale).floor(), oy + (snap.aey * scale).floor(),
                         0, COL_SHOT);
        if (snap.bshot > 0)
            draw_segment(buf, ox + (snap.bsx * scale).floor(), oy + (snap.bsy * scale).floor(),
                         ox + (snap.bex * scale).floor(), oy + (snap.bey * scale).floor(),
                         0, COL_SHOT);
        draw_fighter(buf, ox + (snap.ax * scale).floor(), oy + (snap.ay * scale).floor(),
                     snap.adir, snap.ahp, snap.astab, snap.aammo, snap.first_color, scale);
        draw_fighter(buf, ox + (snap.bx * scale).floor(), oy + (snap.by * scale).floor(),
                     snap.bdir, snap.bhp, snap.bstab, snap.bammo, snap.second_color, scale);
    }

    let px = VIEW_W + 20;
    draw_text(buf, px, 20, "ALL " + NUM_ISLANDS.comma_sep() + " ISLANDS", COL_DIM);
    draw_text(buf, px, 50, "MATCHES " + agg.matches.comma_sep(), COL_TEXT);
    draw_text(buf, px, 74, "MATCHES/S " + agg.matches_per_sec.comma_sep(), COL_TEXT);
    draw_text(buf, px, 98, "KILLS " + agg.kills.comma_sep(), COL_TEXT);
    draw_text(buf, px, 122, "ZERO MATCHES " + agg.zero_matches.comma_sep(), COL_TEXT);
    draw_text(buf, px, 146, "MIGRATIONS " + agg.migrations.comma_sep(), COL_TEXT);
    draw_text(buf, px, 170, "OLDEST AGE " + agg.oldest.comma_sep(), COL_TEXT);
    fill_rect(buf, px, 197, 238, 1, COL_DIM);

    draw_text(buf, px, 215, "VIEWED MATCH", COL_DIM);
    if (snap != nil) {
        draw_text(buf, px, 245, "ISLAND " + snap.index.comma_sep(), COL_TEXT);
        draw_text(buf, px, 268, "MATCH " + snap.match_no.comma_sep(), COL_TEXT);
        draw_text(buf, px, 291, "EPISODE " + (snap.episode + 1).comma_sep() +
                  "/" + EPISODES.comma_sep(), COL_TEXT);
        draw_text(buf, px, 314, "TIME " + snap.tick.idiv(10).comma_sep() + "/30", COL_TEXT);
        draw_text(buf, px, 337, "ROOM " + snap.room_w.comma_sep() + " X " + snap.room_h.comma_sep(), COL_TEXT);
        draw_text(buf, px, 366, snap.first_name + " AGE " + snap.first_age.comma_sep(), snap.first_color);
        draw_text(buf, px, 380, "KILLS " + snap.kills_a.comma_sep(), snap.first_color);
        draw_text(buf, px + 160, 380,
                  snap.aammo > 0 ? "GUN " + snap.aammo.comma_sep() : "KNIFE", snap.first_color);
        draw_text(buf, px, 394, "ENERGY " + snap.aenergy.floor().comma_sep() + " J", COL_DIM);
        draw_text(buf, px, 417, snap.second_name + " AGE " + snap.second_age.comma_sep(), snap.second_color);
        draw_text(buf, px, 431, "KILLS " + snap.kills_b.comma_sep(), snap.second_color);
        draw_text(buf, px + 160, 431,
                  snap.bammo > 0 ? "GUN " + snap.bammo.comma_sep() : "KNIFE", snap.second_color);
        draw_text(buf, px, 445, "ENERGY " + snap.benergy.floor().comma_sep() + " J", COL_DIM);
    } else {
        draw_text(buf, px, 245, "WAITING FOR MATCH", COL_TEXT);
    }
    if (paused)
        draw_text(buf, px, 485, "VIEW PAUSED", COL_TEXT);
    draw_text(buf, px, 526, "REPLAY " + view_speed.to_s() + "X", COL_TEXT);
    draw_text(buf, px, 550, "F VIEW SPEED", COL_DIM);
    draw_text(buf, px, 574, "SPACE PAUSE VIEW", COL_DIM);
    draw_text(buf, px, 598, "N NEXT MATCH", COL_DIM);
}

if (has_flag("--check-render")) {
    let test_weights = ByteArray.with_size(NUM_WEIGHTS * 4);
    let test_agent = Individual(test_weights, 0, "TEST", [80, 201, 255]);
    let test_duel = Match(test_agent, test_agent, 7);
    let test_config = {index: 0, match_no: 0, first_age: 0, second_age: 0,
                       oldest_side: 0};
    let test_stats = {matches: 0, matches_per_sec: 0, kills: 0,
                      zero_matches: 0, migrations: 0, oldest: 0};
    let test_frame = ByteArray.with_size(FRAME_W * FRAME_H * 4);
    let test_scale = PIXELS_PER_METRE.min(VIEW_W.idiv(test_duel.arena.inner_w + 2))
                                      .min(FRAME_H.idiv(test_duel.arena.inner_h + 2)).max(4);
    let test_ox = (VIEW_W - test_duel.arena.width * test_scale).idiv(2);
    let test_oy = (FRAME_H - test_duel.arena.height * test_scale).idiv(2);
    let test_x = test_ox + (test_duel.gun_x * test_scale).floor();
    let test_y = test_oy + (test_duel.gun_y * test_scale).floor();
    render(test_frame, replay_snapshot(test_config, test_duel), test_stats, 1, false);
    assert(test_frame.get_u32(test_y * FRAME_W + test_x + 4) == COL_GUN);
    let test_shooter = test_duel.fighters[0];
    test_duel.gun_available = false;
    test_shooter.gun_ammo = GUN_AMMO;
    render(test_frame, replay_snapshot(test_config, test_duel), test_stats, 1, false);
    let test_player_x = test_ox + (test_shooter.x * test_scale).floor();
    let test_player_y = test_oy + (test_shooter.y * test_scale).floor();
    let var held_gun_visible = false;
    for (let var dy = -30; dy <= 30; ++dy)
        for (let var dx = -30; dx <= 30; ++dx)
            if (test_frame.get_u32((test_player_y + dy) * FRAME_W + test_player_x + dx) == COL_GUN)
                held_gun_visible = true;
    assert(held_gun_visible);
    // The held slide stays ahead of the head at every facing direction.
    for (let var direction = 0; direction < 8; ++direction) {
        let angle = direction.to_f() * TAU / 8.0;
        test_frame.fill_u32(0, FRAME_W * FRAME_H, COL_BG);
        draw_fighter(test_frame, 100, 100, angle, HEALTH, 0, GUN_AMMO,
                     test_agent.color(), PIXELS_PER_METRE);
        assert(test_frame.get_u32(100 * FRAME_W + 100) == COL_SKIN);
        let var visible = false;
        for (let var y = 65; y <= 135; ++y) {
            for (let var x = 65; x <= 135; ++x) {
                if (test_frame.get_u32(y * FRAME_W + x) == COL_GUN) {
                    visible = true;
                    let forward = (x - 100).to_f() * angle.cos() +
                                  (y - 100).to_f() * angle.sin();
                    assert(forward > PIXELS_PER_METRE.to_f() * BODY_RADIUS * 0.48);
                }
            }
        }
        assert(visible);
    }
    test_shooter.shot_ticks = SHOT_TRACE_TICKS;
    test_shooter.shot_start_x = test_duel.gun_x - 0.3;
    test_shooter.shot_start_y = test_duel.gun_y;
    test_shooter.shot_end_x = test_duel.gun_x + 0.3;
    test_shooter.shot_end_y = test_duel.gun_y;
    render(test_frame, replay_snapshot(test_config, test_duel), test_stats, 1, false);
    assert(test_frame.get_u32(test_y * FRAME_W + test_x) == COL_SHOT);
    $println("render checks passed");
    $exit(0);
}

let island_ids = spawn_islands();
if (HEADLESS) {
    run_headless(island_ids);
    $exit(0);
}

let window = $window_create(FRAME_W, FRAME_H, "Genetic Algorithm Arena", 0);
let frame = ByteArray.with_size(FRAME_W * FRAME_H * 4);
let var next_offer = nil;
let var view_config = nil;
let var view_duel = nil;
let var last_draw = 0;
let var last_play_ms = $time_current_ms();
let var play_credit = 0.0;
let VIEW_SPEEDS = [1, 2, 4, 8, 10];
let var view_speed_idx = 0;
let var paused = false;
let island_stats = Array.with_size(NUM_ISLANDS, nil);
let var stats_pending = false;
let var stats_received = 0;
let var last_stats_request = 0;
let var last_rate_ms = 0;
let var last_total_matches = 0;
let var matches_per_sec = 0;

loop {
    loop {
        let msg = $actor_poll();
        if (msg == nil)
            break;
        if (msg instanceof Dict) {
            if (msg.kind == "MATCH" &&
                (next_offer == nil || msg.oldest_age > next_offer.oldest_age ||
                 (msg.oldest_age == next_offer.oldest_age && msg.match_no > next_offer.match_no)))
                next_offer = msg;
            else if (msg.kind == "STATS") {
                island_stats[msg.index] = msg;
                if (stats_pending) {
                    stats_received = stats_received + 1;
                    if (stats_received == NUM_ISLANDS) {
                        stats_pending = false;
                        let sample_time = $time_current_ms();
                        let totals = aggregate_stats(island_stats, 0);
                        if (last_rate_ms > 0 && sample_time > last_rate_ms)
                            matches_per_sec = ((totals.matches - last_total_matches).to_f() *
                                               1000.0 / (sample_time - last_rate_ms).to_f()).floor().max(0);
                        last_total_matches = totals.matches;
                        last_rate_ms = sample_time;
                    }
                }
            }
        }
        else if (msg.kind == "CLOSE_WINDOW")
            $exit(0);
        else if (msg.kind == "KEY_DOWN") {
            if (msg.key == "F")
                view_speed_idx = (view_speed_idx + 1) % VIEW_SPEEDS.len;
            else if (msg.key == "SPACE")
                paused = !paused;
            else if (msg.key == "N") {
                view_duel = nil;
                view_config = nil;
                play_credit = 0.0;
                paused = false;
            }
        }
    }

    let now = $time_current_ms();
    if (!stats_pending && now >= last_stats_request + 1000) {
        for (let var i = 0; i < island_ids.len; ++i)
            $actor_send(island_ids[i], [MSG_SNAPSHOT]);
        stats_pending = true;
        stats_received = 0;
        last_stats_request = now;
    }

    if ((view_duel == nil || view_duel.done) && next_offer != nil) {
        view_config = next_offer;
        next_offer = nil;
        view_duel = Match(
            Individual(view_config.first_weights, view_config.first_age,
                       view_config.first_name, view_config.first_colors),
            Individual(view_config.second_weights, view_config.second_age,
                       view_config.second_name, view_config.second_colors),
            view_config.seed
        );
        $println("Viewing island " + view_config.index.to_s() + " match " +
                 view_config.match_no.to_s() + ", oldest age " +
                 view_config.oldest_age.to_s());
        play_credit = 0.0;
        last_play_ms = now;
    }

    let view_speed = VIEW_SPEEDS[view_speed_idx];
    if (view_duel != nil && !view_duel.done && !paused) {
        play_credit = play_credit + (now - last_play_ms).to_f() * view_speed.to_f() / 100.0;
        let steps = play_credit.floor();
        play_credit = play_credit - steps.to_f();
        for (let var i = 0; i < steps; ++i) {
            if (view_duel.done)
                break;
            view_duel.step();
        }
    }
    last_play_ms = now;

    if (now >= last_draw + 33) {
        let snap = view_duel == nil ? nil : replay_snapshot(view_config, view_duel);
        let agg = aggregate_stats(island_stats, matches_per_sec);
        render(frame, snap, agg, view_speed, paused);
        $window_draw_frame(window, frame);
        last_draw = now;
    }
    $actor_sleep(2);
}
