// A small 3D rigid-body biped playground. Units: metres, kilograms, seconds,
// radians and newton-metres. +Y is up, +Z is forward, +X is the robot's left.
//
// Usage: plush examples/bipedal_sim.psh [seed]
//        plush examples/bipedal_sim.psh --headless [seconds] [seed] [shot.tga|-] [hold]
//        plush examples/bipedal_sim.psh --bench [frames] [seed] [orbit]
//        plush examples/bipedal_sim.psh --evaluate [episode_seed] [model_seed]
//        plush examples/bipedal_sim.psh --policy [episode_seed] [model_seed]
//        plush examples/bipedal_sim.psh --train [episode_seed] [model_seed] [islands]
//        plush examples/bipedal_sim.psh --train-headless [minutes] [model_seed] [islands]
// Controls: R random reset, SPACE pause, N single step, arrows orbit,
//           W/S zoom, H toggle pose motors. Close the window to exit.
// Policy mode replays each episode; R tries the next starting pose.
//
// The neutral body is 1.78 m tall and weighs 80 kg. Box inertia, small fixed
// steps and position-based rigid-body constraints keep this implementation
// compact. All body boxes collide with the floor; there is no self-collision.
// The default is a passive fall, not a balance or walking controller.
//
// Joint ranges loosely follow adult ROM reference values, rounded for this
// model: https://archive.cdc.gov/www_cdc_gov/ncbddd/jointrom/index.html
// Shoulder swing, hip spread and ankle extension are narrowed further to
// what walking and running use, and joints unused for locomotion are locked.
// Motor torque/speed settings are approximate engineering choices, not a
// fitted human muscle model. Human torque depends on angle and speed:
// https://pubmed.ncbi.nlm.nih.gov/17485097/
//
// A controller can call joint.set_target(Vec3(x, y, z)) in radians and enable
// joint.enabled. Targets are range-clamped, slew-limited and driven by bounded
// torque with a simple torque-speed envelope. Impacts can exceed motor speed;
// skeletal stops/contact forces are not limited by muscle strength.

from image import Image, save_tga;
from random import Xoshiro128;

let PI = 3.141592653589793;
let DEG = PI / 180.0;
let STEP = 1.0 / 240.0;
let EPISODE_SECONDS = 10.0;
// Fitness bonus per second before falling. It outweighs diving forward, so
// that controllers learn to balance before they learn to walk
let UPRIGHT_WEIGHT = 2.0;
// Coefficient of friction between the soles and the ground, as for rubber
// on a track surface
let FRICTION = 1.0;
// An episode ends in a fall once the torso is below this fraction of its
// starting height, or tilted more than 55 degrees from vertical
let FALL_HEIGHT_FRACTION = 0.55;
let FALL_TILT_COS = (55.0 * DEG).cos();
// Scales the width of every starting pose range around its midpoint
let POSE_RANDOMNESS = 0.5;
let CONTROL_SUBSTEPS = 4;
// The constraint solver stops once every joint anchor gap and ground
// penetration is within LINEAR_TOLERANCE metres, and every joint limit
// within ANGULAR_TOLERANCE, or after MAX_ITERATIONS passes
let MAX_ITERATIONS = 12;
let LINEAR_TOLERANCE = 0.001;
let ANGULAR_TOLERANCE = 0.5 * DEG;
let WIDTH = 800;
let HEIGHT = 600;
let BRIGHTNESS = 1.25;
let SKY_STEPS = 256;
// A 60 m straight in the robot's forward direction, plus 4 m of runoff at
// either end. At 5 m/s the marked section provides twelve seconds of travel.
let TRACK_WIDTH = 3.0;
let TRACK_LENGTH = 60.0;
// Active joint axes in Simulator.joints order. The knee only bends on X;
// the ankle and shoulder use X and Z. Each pair is [joint index, local Euler
// axis]. The waist's twist and side bend, and the hips' and shoulders'
// twist, are locked, so each has zero range. The head is welded to the
// torso, and the forearms to the upper arms.
let CONTROL_AXES = [[0,0],
                    [1,0],[1,2], [2,0], [3,0],[3,2], [4,0],[4,2],
                    [5,0],[5,2], [6,0], [7,0],[7,2], [8,0],[8,2]];
let CONTROL_JOINT_AXES = CONTROL_AXES.len;
let CONTROL_FOOT_POINTS = 8;
let CONTROL_OUTPUTS = CONTROL_JOINT_AXES;
let CONTROL_DT = CONTROL_SUBSTEPS * STEP;
let EPISODE_CONTROL_STEPS = (EPISODE_SECONDS / CONTROL_DT + 0.5).floor();
let FOOT_SENSOR_CORNERS = [0,1,4,5];

// Encoded observation layout for the controller. Values are scaled into
// [-1, 1], contacts and height into [0, 1].
// The up direction is estimated from the head's sensors by filter_up(). The
// compass gives the track's forward direction, and the height the head's
// height above the ground, as a rangefinder or eyes would
let OBS_ANGLES = 0;
let OBS_SPEEDS = OBS_ANGLES + CONTROL_JOINT_AXES;
let OBS_ACCEL = OBS_SPEEDS + CONTROL_JOINT_AXES;
let OBS_GYRO = OBS_ACCEL + 3;
let OBS_UP = OBS_GYRO + 3;
let OBS_COMPASS = OBS_UP + 3;
let OBS_HEIGHT = OBS_COMPASS + 3;
let OBS_CONTACTS = OBS_HEIGHT + 1;
let OBS_SIZE = OBS_CONTACTS + CONTROL_FOOT_POINTS;
let HEIGHT_SCALE = 2.0;  // Head heights are encoded in units of this many metres

// Fraction of the way the up estimate moves toward the accelerometer's
// reading at each control step, which sets how quickly gyro drift is undone
let UP_FILTER_GAIN = 0.02;

// The controller sees the observation and its own previous action
let CONTROL_INPUTS = OBS_SIZE + CONTROL_OUTPUTS;
let CONTROL_HIDDEN = 32;
let UP = Vec3(0.0, 1.0, 0.0);
let TRACK_FORWARD = Vec3(0.0, 0.0, 1.0);
let AXES = [Vec3(1.0, 0.0, 0.0), UP, Vec3(0.0, 0.0, 1.0)];
let SUN_DIRECTION = Vec3(-3.0,5.0,-4.0).unit();
let FILL_DIRECTION = Vec3(3.0,4.0,5.0).unit();

class Vec3 {
    init(self, x, y, z) { self.x = x; self.y = y; self.z = z; }
    add(self, b) { return Vec3(self.x + b.x, self.y + b.y, self.z + b.z); }
    sub(self, b) { return Vec3(self.x - b.x, self.y - b.y, self.z - b.z); }
    mul(self, s) { return Vec3(self.x * s, self.y * s, self.z * s); }
    dot(self, b) { return self.x * b.x + self.y * b.y + self.z * b.z; }
    cross(self, b) {
        return Vec3(self.y * b.z - self.z * b.y,
                    self.z * b.x - self.x * b.z, self.x * b.y - self.y * b.x);
    }
    length(self) { return self.dot(self).sqrt(); }
    unit(self) { return self.mul(1.0 / self.length().max(0.000000001)); }
    at(self, i) { if (i == 0) return self.x; if (i == 1) return self.y; return self.z; }
    set_at(self, i, value) {
        if (i == 0) self.x = value;
        else if (i == 1) self.y = value;
        else self.z = value;
    }
}

fun zero() { return Vec3(0.0, 0.0, 0.0); }
fun atan2(y, x) {
    if (x > 0.0) return (y / x).atan();
    if (x < 0.0) return (y / x).atan() + (y >= 0.0 ? PI : -PI);
    if (y == 0.0) return 0.0;
    return y > 0.0 ? PI * 0.5 : -PI * 0.5;
}

class Quat {
    init(self, w, x, y, z) { self.w = w; self.x = x; self.y = y; self.z = z; }
    conj(self) { return Quat(self.w, -self.x, -self.y, -self.z); }
    mul(self, b) {
        return Quat(self.w*b.w - self.x*b.x - self.y*b.y - self.z*b.z,
                    self.w*b.x + self.x*b.w + self.y*b.z - self.z*b.y,
                    self.w*b.y - self.x*b.z + self.y*b.w + self.z*b.x,
                    self.w*b.z + self.x*b.y - self.y*b.x + self.z*b.w);
    }
    unit(self) {
        let s = 1.0 / (self.w*self.w + self.x*self.x + self.y*self.y + self.z*self.z).sqrt();
        return Quat(self.w*s, self.x*s, self.y*s, self.z*s);
    }
    rotate(self, v) {
        // Expand the two cross products to avoid six temporary vectors in
        // this inner physics operation. Keep the arithmetic order unchanged.
        let x = self.x; let y = self.y; let z = self.z; let w = self.w;
        let tx = (y*v.z-z*v.y)*2.0;
        let ty = (z*v.x-x*v.z)*2.0;
        let tz = (x*v.y-y*v.x)*2.0;
        return Vec3((v.x+tx*w)+(y*tz-z*ty),
                    (v.y+ty*w)+(z*tx-x*tz), (v.z+tz*w)+(x*ty-y*tx));
    }
    // Euler convention: Rz(z) Ry(y) Rx(x). Y stays away from +/-90 degrees.
    angles(self) {
        let s = (2.0 * (self.w*self.y - self.z*self.x)).clip(-1.0, 1.0);
        return Vec3(atan2(2.0*(self.w*self.x + self.y*self.z),
                          1.0 - 2.0*(self.x*self.x + self.y*self.y)),
                    atan2(s, (1.0 - s*s).max(0.0).sqrt()),
                    atan2(2.0*(self.w*self.z + self.x*self.y),
                          1.0 - 2.0*(self.y*self.y + self.z*self.z)));
    }
}

fun identity() { return Quat(1.0, 0.0, 0.0, 0.0); }
fun rotation(v) {
    let a = v.length();
    if (a < 0.00000001) return Quat(1.0, v.x*0.5, v.y*0.5, v.z*0.5).unit();
    let s = (a*0.5).sin() / a;
    return Quat((a*0.5).cos(), v.x*s, v.y*s, v.z*s);
}
fun euler(v) {
    return rotation(Vec3(0.0, 0.0, v.z)).mul(rotation(Vec3(0.0, v.y, 0.0)))
        .mul(rotation(Vec3(v.x, 0.0, 0.0)));
}

// A rigid body welded from one or more boxes, each given as [name, mass,
// size, world centre, color]. The body's origin is their centre of mass.
// Each box collides with its own corners and is drawn separately
class Body {
    init(self, name, boxes) {
        self.name = name;
        let var mass = 0.0; let var com = zero();
        for (let var i = 0; i < boxes.len; ++i) {
            mass += boxes[i][1]; com = com.add(boxes[i][3].mul(boxes[i][1]));
        }
        com = com.mul(1.0 / mass);
        self.mass = mass; self.im = 1.0 / mass;
        self.p = com; self.q = identity();
        self.v = zero(); self.w = zero();
        self.old_p = com; self.old_q = self.q;

        // Inertia about the centre of mass. Boxes are stacked along Y, so
        // the products of inertia vanish
        let var ix = 0.0; let var iy = 0.0; let var iz = 0.0;
        self.parts = []; self.corners = [];
        for (let var i = 0; i < boxes.len; ++i) {
            let m = boxes[i][1]; let size = boxes[i][2];
            let o = boxes[i][3].sub(com);
            assert(o.x.abs() < 1.0e-9 && o.z.abs() < 1.0e-9);
            ix += m*(size.y*size.y + size.z*size.z)/12.0 + m*o.y*o.y;
            iy += m*(size.x*size.x + size.z*size.z)/12.0;
            iz += m*(size.x*size.x + size.y*size.y)/12.0 + m*o.y*o.y;
            self.parts.push([boxes[i][0], o, size, boxes[i][4]]);
            for (let var k = 0; k < 8; ++k) {
                self.corners.push(Vec3(o.x + ((k & 1) == 0 ? -size.x*0.5 : size.x*0.5),
                                       o.y + ((k & 2) == 0 ? -size.y*0.5 : size.y*0.5),
                                       o.z + ((k & 4) == 0 ? -size.z*0.5 : size.z*0.5)));
            }
        }
        self.ii = Vec3(1.0/ix, 1.0/iy, 1.0/iz);
        self.support = Array.with_size(self.corners.len, 0.0);
        // Tangential positional impulse from static friction this step
        self.traction = Array.with_size(self.corners.len, 0.0);
    }
    inertia(self, v) {
        let a = self.q.conj().rotate(v);
        return self.q.rotate(Vec3(a.x*self.ii.x, a.y*self.ii.y, a.z*self.ii.z));
    }
    turn(self, angle) { self.q = rotation(angle).mul(self.q).unit(); }
    world(self, local) { return self.p.add(self.q.rotate(local)); }
    weight(self, r, n) { let c = r.cross(n); return self.im + c.dot(self.inertia(c)); }
    move(self, impulse, r) {
        self.p = self.p.add(impulse.mul(self.im));
        self.turn(self.inertia(r.cross(impulse)));
    }
    impulse(self, impulse, r) {
        self.v = self.v.add(impulse.mul(self.im));
        self.w = self.w.add(self.inertia(r.cross(impulse)));
    }
}

class Joint {
    init(self, name, a, b, anchor, lo, hi, torque, speed) {
        self.name = name; self.a = a; self.b = b;
        self.ra = anchor.sub(a.p); self.rb = anchor.sub(b.p);
        self.lo = lo.mul(DEG); self.hi = hi.mul(DEG);
        self.torque = torque; self.speed = speed;
        self.target = zero(); self.command = zero(); self.enabled = false;
        self.policy_torque = zero(); self.policy_enabled = false;
        self.last_torque = zero();
    }
    angles(self) { return self.a.q.conj().mul(self.b.q).angles(); }
    set_target(self, v) {
        self.target = Vec3(v.x.clip(self.lo.x, self.hi.x),
                           v.y.clip(self.lo.y, self.hi.y), v.z.clip(self.lo.z, self.hi.z));
    }
    // The gradient of each Euler coordinate with respect to relative world
    // rotation. Reciprocal axes handle coupled flexion/twist correctly.
    gradients(self, angles) {
        let cz = angles.z.cos(); let sz = angles.z.sin();
        let cy = angles.y.cos(); let sy = angles.y.sin();
        return [self.a.q.rotate(Vec3(cz/cy, sz/cy, 0.0)),
                self.a.q.rotate(Vec3(-sz, cz, 0.0)),
                self.a.q.rotate(Vec3(cz*sy/cy, sz*sy/cy, 1.0))];
    }
    motors(self, dt) {
        let angles = self.angles();
        let axes = self.gradients(angles);
        let commands = []; let torques = [];
        for (let var i = 0; i < 3; ++i) {
            let axis = axes[i];
            let velocity = self.b.w.sub(self.a.w).dot(axis);
            let speed = self.speed.at(i);
            let command = self.command.at(i) + (self.target.at(i) - self.command.at(i)).clip(-speed*dt, speed*dt);
            commands.push(command);
            // Backward-Euler damping avoids overshooting on low-inertia feet.
            let weight = axis.dot(self.a.inertia(axis).add(self.b.inertia(axis)));
            let damping = self.enabled ? 6.0 : 0.35;
            let var drive = self.enabled ? 90.0*(command - angles.at(i)) : 0.0;
            if (self.policy_enabled) drive += self.policy_torque.at(i);
            let var torque = (drive - damping*velocity) / (1.0 + damping*dt*weight);
            let var cap = self.torque.at(i);
            if (torque*velocity > 0.0) cap *= (1.0 - velocity.abs()/speed).max(0.0);
            torque = torque.clip(-cap, cap);
            if (self.lo.at(i) == self.hi.at(i)) torque = 0.0;
            torques.push(torque);
            let impulse = axis.mul(torque*dt);
            self.a.w = self.a.w.sub(self.a.inertia(impulse));
            self.b.w = self.b.w.add(self.b.inertia(impulse));
        }
        self.command = Vec3(commands[0], commands[1], commands[2]);
        self.last_torque = Vec3(torques[0], torques[1], torques[2]);
    }
    // Returns whether the joint's errors were within tolerance before solving
    solve(self) {
        let var met = true;
        // Angular stops use the bodies' inverse inertia, so a light limb moves
        // more than the torso. These are skeletal constraints, not actuators.
        let var angles = self.angles();
        for (let var i = 0; i < 3; ++i) {
            let a = angles.at(i);
            let error = a - a.clip(self.lo.at(i), self.hi.at(i));
            if (error.abs() < 0.00001) continue;
            if (error.abs() > ANGULAR_TOLERANCE) met = false;
            let axis = self.gradients(angles)[i];
            let ia = self.a.inertia(axis); let ib = self.b.inertia(axis);
            let impulse = error.clip(-0.2, 0.2) / axis.dot(ia.add(ib));
            self.a.turn(ia.mul(impulse));
            self.b.turn(ib.mul(-impulse));
            // Only a correction changes the relative angles for the next axis.
            if (i < 2) angles = self.angles();
        }
        // Solve the anchor along three axes. Recompute the arms after each
        // correction because rotating a body also moves its anchor.
        for (let var i = 0; i < 3; ++i) {
            let ra = self.a.q.rotate(self.ra); let rb = self.b.q.rotate(self.rb);
            let n = AXES[i];
            let error = self.b.p.add(rb).sub(self.a.p.add(ra)).dot(n);
            if (error.abs() > LINEAR_TOLERANCE) met = false;
            let impulse = n.mul(error / (self.a.weight(ra, n) + self.b.weight(rb, n)));
            self.a.move(impulse, ra);
            self.b.move(impulse.mul(-1.0), rb);
        }
        return met;
    }
}

// Sensors for a controller policy. Angles and angular speeds follow
// CONTROL_AXES: waist X, then each side's hip XZ, knee X, ankle XZ and
// shoulder XZ. Locked axes are omitted.
// Contact order for each foot is heel -X, heel +X, toe -X, toe +X, where X
// is local to that foot. Distances/loads can be converted with foot_contact().
class BipedObservation {
    init(self) {
        self.angles = ByteArray.with_size(CONTROL_JOINT_AXES*4);
        self.speeds = ByteArray.with_size(CONTROL_JOINT_AXES*4);
        self.contacts = ByteArray.with_size(CONTROL_FOOT_POINTS*4);
        // Head accelerometer readings are specific force in units of g,
        // measured in head-local coordinates: rest reads roughly +1 on Y.
        self.head_accel_g = Vec3(0.0,1.0,0.0);
        self.head_gyro = zero();
        // The track's forward direction in head-local coordinates, as a
        // compass reads it, and the head's height above the ground.
        self.compass = TRACK_FORWARD;
        self.head_height = 0.0;
    }
    set_contact(self, index, distance_m, normal_force_n) {
        assert(index >= 0 && index < CONTROL_FOOT_POINTS);
        self.contacts.set_f32(index,foot_contact(distance_m,normal_force_n));
    }
}

// A continuous contact signal. Proximity starts at 4 cm, and pressure raises
// a close corner from 0.5 toward 1.0. Use the same scale for all eight points.
fun foot_contact(distance_m, normal_force_n) {
    let proximity = ((0.04-distance_m)/0.04).clip(0.0,1.0);
    let pressure = (normal_force_n/120.0).clip(0.0,1.0);
    return proximity*(0.5+0.5*pressure);
}

// Dense network with ReLU hidden layers and a linear output layer. Weights
// are f32 row-major, so the inner loops run on the host through dot_f32 and
// axpy_f32, as in benchmarks/mlp.psh. forward() reuses its output buffers
class Network
{
    init(self, sizes, seed)
    {
        let rng = Xoshiro128(seed);
        self.sizes = sizes;
        self.num_layers = sizes.len - 1;
        self.weights = [];
        self.biases = [];
        self.acts = [];

        // Initialization range of each layer, also used by mutation resets
        self.bounds = [];

        for (let var l = 0; l < self.num_layers; ++l) {
            let rows = sizes[l + 1];
            let cols = sizes[l];
            let bound = ((l + 1 < self.num_layers ? 6.0 : 3.0) / cols).sqrt();

            let w = ByteArray.with_size(rows * cols * 4);
            for (let var i = 0; i < rows * cols; ++i)
                w.set_f32(i, rng.float(-bound, bound));

            self.weights.push(w);
            self.biases.push(ByteArray.with_size(rows * 4));
            self.acts.push(ByteArray.with_size(rows * 4));
            self.bounds.push(bound);
        }
    }

    forward(self, input)
    {
        let var x = input;
        for (let var l = 0; l < self.num_layers; ++l) {
            let rows = self.sizes[l + 1];
            let cols = self.sizes[l];
            let w = self.weights[l];
            let b = self.biases[l];
            let out = self.acts[l];
            let relu = l + 1 < self.num_layers;

            for (let var r = 0; r < rows; ++r) {
                let var v = w.dot_f32(r * cols, 1, x, 0, 1, cols) + b.get_f32(r);
                if (relu && v < 0.0)
                    v = 0.0;
                out.set_f32(r, v);
            }

            x = out;
        }
        return x;
    }

    // Weights and biases, interleaved by layer
    params(self)
    {
        let params = [];
        for (let var l = 0; l < self.num_layers; ++l) {
            params.push(self.weights[l]);
            params.push(self.biases[l]);
        }
        return params;
    }

    copy_from(self, other)
    {
        let dst = self.params();
        let src = other.params();
        for (let var i = 0; i < dst.len; ++i)
            dst[i].memcpy(0, src[i], 0, src[i].len);
    }

    // Copies of the parameters, safe to send in an actor message
    snapshot(self)
    {
        let params = self.params();
        let snapshot = [];
        for (let var i = 0; i < params.len; ++i) {
            let copy = ByteArray.with_size(params[i].len);
            copy.memcpy(0, params[i], 0, copy.len);
            snapshot.push(copy);
        }
        return snapshot;
    }

    load(self, snapshot)
    {
        let params = self.params();
        assert(snapshot.len == params.len);
        for (let var i = 0; i < params.len; ++i) {
            assert(snapshot[i].len == params[i].len);
            params[i].memcpy(0, snapshot[i], 0, params[i].len);
        }
    }
}

// Picks one action in [-1, 1] per joint axis from an encoded observation,
// scaled by the torque limits into newton-metres. Joint.motors() enforces
// actuator torque and speed limits when these are applied. The previous
// action is an input, which gives the controller a little memory
class Controller
{
    init(self, seed, torque_limits)
    {
        assert(torque_limits.len == CONTROL_OUTPUTS);
        self.limits = torque_limits;
        self.network = Network([CONTROL_INPUTS, CONTROL_HIDDEN, CONTROL_OUTPUTS], seed);
        self.input = ByteArray.with_size(CONTROL_INPUTS * 4);
        self.action = ByteArray.with_size(CONTROL_OUTPUTS * 4);
        self.torque_values = ByteArray.with_size(CONTROL_OUTPUTS * 4);

        // Gaussian noise added to actions while exploring, which needs an rng
        self.noise = 0.0;
        self.rng = nil;
    }

    reset(self)
    {
        self.action.zero_fill();
    }

    act(self, obs)
    {
        self.input.memcpy(0, obs, 0, OBS_SIZE * 4);
        self.input.memcpy(OBS_SIZE * 4, self.action, 0, CONTROL_OUTPUTS * 4);
        let raw = self.network.forward(self.input);
        for (let var i = 0; i < CONTROL_OUTPUTS; ++i) {
            let x = raw.get_f32(i);
            let var a = x / (1.0 + x.abs());
            if (self.noise > 0.0)
                a = (a + self.noise * gauss(self.rng)).clip(-1.0, 1.0);
            self.action.set_f32(i, a);
        }
        return self.action;
    }

    torques(self)
    {
        for (let var i = 0; i < CONTROL_OUTPUTS; ++i)
            self.torque_values.set_f32(i, self.action.get_f32(i) * self.limits[i]);
        return self.torque_values;
    }
}

// Default torque limits mirror the active axes in Simulator.reset().
fun biped_torque_limits() {
    return [140.0,
            200.0,110.0, 160.0, 120.0,35.0, 70.0,60.0,
            200.0,110.0, 160.0, 120.0,35.0, 70.0,60.0];
}

// A signed-distance contact interface leaves room for ramps/triangle meshes.
// Replace sample() and draw() together when adding terrain. The first version
// is an infinite plane with a painted running track and surrounding grass.
class Ground {
    // Increment revision after changing terrain geometry or appearance.
    init(self) {
        self.revision = 0;
        self.paint = []; self.base = []; self.built = false;
    }
    sample(self, p) { return p.y; }
    normal(self, p) { return UP; }
    patch(self, renderer, x0, z0, x1, z1, height, color) {
        let patch = [Vec3(x0,height,z0),Vec3(x0,height,z1),
                     Vec3(x1,height,z1),Vec3(x1,height,z0),color];
        if (height > 0.0) self.paint.push(patch);
        else self.base.push(patch);
    }
    draw(self, renderer) {
        if (self.built) {
            self.draw_patches(renderer); return;
        }
        let half = TRACK_WIDTH*0.5;
        let paint = 0xF3EAD5;
        // Short strips keep the existing vertex lighting smooth along the
        // straight. The entire surface is still cached while the camera rests.
        for (let var z = -12; z < TRACK_LENGTH+12; z += 2) {
            let grass = ((z >> 1) & 1) == 0 ? 0x718574 : 0x758978;
            if (z < -4 || z >= TRACK_LENGTH+4) {
                self.patch(renderer,-16.0,z.to_f(),16.0,z+2.0,0.0,grass);
                continue;
            }
            self.patch(renderer,-16.0,z.to_f(),-half-0.18,z+2.0,0.0,grass);
            self.patch(renderer,half+0.18,z.to_f(),16.0,z+2.0,0.0,grass);
            self.patch(renderer,-half-0.18,z.to_f(),-half,z+2.0,0.0,0xC4B69C);
            self.patch(renderer,half,z.to_f(),half+0.18,z+2.0,0.0,0xC4B69C);
            let rubber = ((z/10).floor() & 1) == 0 ? 0xBF7058 : 0xB96A53;
            self.patch(renderer,-half,z.to_f(),half,z+2.0,0.0,rubber);
            self.patch(renderer,-half+0.05,z.to_f(),-half+0.10,z+2.0,0.002,paint);
            self.patch(renderer,half-0.10,z.to_f(),half-0.05,z+2.0,0.002,paint);
        }
        // The robot starts at the broad start line. Edge ticks every 5 m and
        // paired ticks every 10 m make progress and scale visible during a run.
        self.patch(renderer,-half,0.0,half,0.10,0.002,paint);
        for (let var z = 5; z < TRACK_LENGTH; z += 5) {
            self.patch(renderer,-half,z.to_f(),-half+0.35,z+0.06,0.002,paint);
            self.patch(renderer,half-0.35,z.to_f(),half,z+0.06,0.002,paint);
            if (z % 10 == 0) {
                self.patch(renderer,-half,z+0.16,-half+0.35,z+0.22,0.002,paint);
                self.patch(renderer,half-0.35,z+0.16,half,z+0.22,0.002,paint);
            }
        }
        // A two-row chequered finish at 60 m, followed by the runoff area.
        for (let var row = 0; row < 2; ++row) {
            for (let var col = 0; col < 12; ++col) {
                let x = -half + col*TRACK_WIDTH/12.0;
                let color = ((row+col) & 1) == 0 ? paint : 0x344352;
                self.patch(renderer,x,TRACK_LENGTH+row*0.25,
                           x+TRACK_WIDTH/12.0,TRACK_LENGTH+(row+1)*0.25,0.002,color);
            }
        }
        self.built = true;
        self.draw_patches(renderer);
    }
    draw_patches(self, renderer) {
        // All paint is 2 mm above the ground. The camera remains above the
        // plane, so paint is always in front of base geometry along a ray.
        for (let var i = 0; i < self.paint.len; ++i) {
            let p = self.paint[i]; renderer.quad(p[0],p[1],p[2],p[3],p[4]);
        }
        for (let var i = 0; i < self.base.len; ++i) {
            let p = self.base[i]; renderer.quad(p[0],p[1],p[2],p[3],p[4]);
        }
    }
}

class Simulator {
    init(self, seed) {
        self.ground = Ground(); self.rng = Xoshiro128(seed); self.reset();
    }
    body(self, name, mass, size, pos, color) {
        return self.welded(name, [[name, mass, size, pos, color]]);
    }
    welded(self, name, boxes) {
        let b = Body(name, boxes); self.bodies.push(b); return b;
    }
    joint(self, name, a, b, p, lo, hi, torque, speed) {
        let j = Joint(name, a, b, p, lo, hi, torque, speed); self.joints.push(j); return j;
    }
    // A random starting pose value, from a range narrowed by POSE_RANDOMNESS
    pose_float(self, lo, hi) {
        let mid = 0.5 * (lo + hi);
        let half = 0.5 * POSE_RANDOMNESS * (hi - lo);
        return self.rng.float(mid - half, mid + half);
    }
    reset(self) {
        self.bodies = []; self.joints = []; self.time = 0.0; self.hold = false;
        // Eighties sportswear: red jacket, navy trousers, cream trainers
        // and an ivory head shell. Both sides belong to the same outfit.
        let pelvis = self.body("Pelvis", 12.0, Vec3(0.30, 0.20, 0.22), Vec3(0.0, 1.03, 0.0), 0x344764);
        // The head is welded to the torso, with no neck joint
        let torso = self.welded("Torso", [
            ["Torso", 30.0, Vec3(0.39, 0.41, 0.23), Vec3(0.0, 1.335, 0.0), 0xDC3F3B],
            ["Head", 5.0, Vec3(0.18, 0.21, 0.19), Vec3(0.0, 1.675, 0.0), 0xE9DBC1]
        ]);
        self.pelvis = pelvis; self.torso = torso; self.feet = [];
        // Where the head's sensors sit, in the torso's frame
        self.head_offset = torso.parts[1][1];
        self.joint("Waist", pelvis, torso, Vec3(0.0, 1.13, 0.0), Vec3(-15.0,0.0,0.0), Vec3(30.0,0.0,0.0), Vec3(140.0,70.0,100.0), Vec3(4.0,3.0,3.0));
        for (let var side = 0; side < 2; ++side) {
            let s = side == 0 ? -1.0 : 1.0;
            let name = side == 0 ? "Right " : "Left ";
            let thigh = self.body(name+"thigh", 8.0, Vec3(0.135,0.43,0.15), Vec3(s*0.105,0.765,0.0), 0x344764);
            let shin = self.body(name+"shin", 3.5, Vec3(0.105,0.43,0.115), Vec3(s*0.105,0.335,0.0), 0x435E80);
            let foot = self.body(name+"foot", 1.5, Vec3(0.12,0.12,0.26), Vec3(s*0.105,0.06,0.065), 0xF2D09A);
            self.feet.push(foot);
            self.joint(name+"hip", pelvis, thigh, Vec3(s*0.105,0.98,0.0), Vec3(-130.0,0.0,-30.0), Vec3(18.0,0.0,30.0), Vec3(200.0,80.0,110.0), Vec3(6.0,4.0,4.0));
            self.joint(name+"knee", thigh, shin, Vec3(s*0.105,0.55,0.0), zero(), Vec3(120.0,0.0,0.0), Vec3(160.0,0.0,0.0), Vec3(10.0,1.0,1.0));
            self.joint(name+"ankle", shin, foot, Vec3(s*0.105,0.12,0.0), Vec3(-15.0,0.0,-20.0), Vec3(44.0,0.0,20.0), Vec3(120.0,0.0,35.0), Vec3(6.0,1.0,3.0));
            // The upper arm and forearm are welded, with no elbow joint
            let arm = self.welded(name+"arm", [
                [name+"upper arm", 2.0, Vec3(0.085,0.29,0.10), Vec3(s*0.245,1.345,0.0), 0xB52E34],
                [name+"forearm", 1.5, Vec3(0.075,0.30,0.085), Vec3(s*0.245,1.05,0.0), 0xE04A42]
            ]);
            // Arms can raise outwards, which is -Z on the right and +Z on the left
            self.joint(name+"shoulder", torso, arm, Vec3(s*0.245,1.49,0.0), Vec3(-70.0,0.0,(s*30.0).min(0.0)), Vec3(60.0,0.0,(s*30.0).max(0.0)),Vec3(70.0,35.0,60.0), Vec3(6.0,4.0,5.0));
        }
        // Sample a shared stride and leg spread, then add small independent
        // offsets. Either foot can lead; outward hip rotation widens the stance.
        // Rebuild down the tree so every randomized pose has connected joints.
        let stagger = self.pose_float(-0.32,0.32);
        let spread = self.pose_float(-0.015,0.25);
        let hip_bias = self.pose_float(-0.12,-0.04);
        // Tilt the whole body forward or back, with an independent waist bend.
        // Their combined pitch can reach roughly 15 degrees in either direction.
        pelvis.q = euler(Vec3(self.pose_float(-0.18,0.22), self.pose_float(-0.15,0.15), self.pose_float(-0.10,0.10)));
        let level_feet = euler(Vec3(0.0,pelvis.q.angles().y,0.0));
        for (let var i = 0; i < self.joints.len; ++i) {
            let j = self.joints[i];
            let var pose = Vec3(self.pose_float(-0.12,0.12),
                                self.pose_float(-0.04,0.04), self.pose_float(-0.06,0.06));
            if (j.name == "Waist") pose = Vec3(self.pose_float(-0.38,0.38),pose.y,pose.z);
            if (j.name == "Right hip" || j.name == "Left hip") {
                let side = j.name == "Right hip" ? -1.0 : 1.0;
                pose = Vec3(hip_bias + side*stagger + self.pose_float(-0.04,0.04),
                            pose.y, side*spread + self.pose_float(-0.01,0.01));
            }
            if (j.name == "Right knee" || j.name == "Left knee") {
                pose = Vec3(self.pose_float(0.06,0.32),0.0,0.0);
            }
            if (j.name == "Right ankle" || j.name == "Left ankle") {
                // Aim the soles toward level, subject to the ankle stops.
                // Different knee bends can still leave one foot slightly raised.
                pose = j.a.q.conj().mul(level_feet).angles();
            }
            j.set_target(pose); pose = j.target; j.command = pose;
            j.b.q = j.a.q.mul(euler(pose));
            j.b.p = j.a.world(j.ra).sub(j.b.q.rotate(j.rb));
        }
        let var bottom = 100.0;
        for (let var i = 0; i < self.bodies.len; ++i) {
            let b = self.bodies[i];
            for (let var k = 0; k < b.corners.len; ++k) bottom = bottom.min(b.world(b.corners[k]).y);
        }
        for (let var i = 0; i < self.bodies.len; ++i) {
            let b = self.bodies[i]; b.p = b.p.add(Vec3(0.0,0.025-bottom,0.0));
        }
    }
    toggle_hold(self) {
        self.hold = !self.hold;
        for (let var i = 0; i < self.joints.len; ++i) self.joints[i].enabled = self.hold;
    }
    // Hold a policy's torque commands until the next control update. Motor
    // torque and speed limits are still enforced inside Joint.motors().
    set_policy_torques(self, torques) {
        assert(torques.len == CONTROL_OUTPUTS*4);
        for (let var i = 0; i < self.joints.len; ++i) {
            let j = self.joints[i]; j.policy_torque = zero(); j.policy_enabled = true;
        }
        for (let var i = 0; i < CONTROL_OUTPUTS; ++i) {
            let pair = CONTROL_AXES[i];
            self.joints[pair[0]].policy_torque.set_at(pair[1],torques.get_f32(i));
        }
    }
    // The head's centre and its velocity, as its sensors see them. The head
    // turns with the torso
    head_position(self) { return self.torso.world(self.head_offset); }
    head_velocity(self) {
        let t = self.torso;
        return t.v.add(t.w.cross(t.q.rotate(self.head_offset)));
    }
    clear_policy_torques(self) {
        for (let var i = 0; i < self.joints.len; ++i) {
            self.joints[i].policy_enabled = false;
        }
    }
    // Returns whether every corner was within LINEAR_TOLERANCE of the ground
    contacts(self, b) {
        let var met = true;
        for (let var i = 0; i < b.corners.len; ++i) {
            let r = b.q.rotate(b.corners[i]); let p = b.p.add(r);
            let d = self.ground.sample(p);
            if (d >= 0.0) continue;
            if (d < -LINEAR_TOLERANCE) met = false;
            let n = self.ground.normal(p);
            let impulse = -d / b.weight(r,n);
            b.move(n.mul(impulse), r);
            b.support[i] += impulse;

            // Static friction: undo the corner's sliding along the ground
            // since the start of the step, within the friction cone of the
            // normal correction so far. Otherwise joint projections drag
            // planted feet sideways, which velocity friction cannot undo.
            let rc = b.q.rotate(b.corners[i]);
            let slide = b.p.add(rc).sub(b.old_p.add(b.old_q.rotate(b.corners[i])));
            let tangential = slide.sub(n.mul(slide.dot(n)));
            let length = tangential.length();
            let budget = FRICTION*b.support[i] - b.traction[i];
            if (length > 0.000000001 && budget > 0.0) {
                let t = tangential.mul(1.0/length);
                let traction = (length/b.weight(rc,t)).min(budget);
                b.move(t.mul(-traction), rc);
                b.traction[i] += traction;
            }
        }
        return met;
    }
    step(self) {
        for (let var i = 0; i < self.joints.len; ++i) self.joints[i].motors(STEP);
        for (let var i = 0; i < self.bodies.len; ++i) {
            let b = self.bodies[i]; b.old_p = b.p; b.old_q = b.q;
            b.v = b.v.add(Vec3(0.0,-9.81*STEP,0.0));
            b.p = b.p.add(b.v.mul(STEP)); b.turn(b.w.mul(STEP));
            for (let var k = 0; k < b.corners.len; ++k) { b.support[k] = 0.0; b.traction[k] = 0.0; }
        }
        for (let var pass = 0; pass < MAX_ITERATIONS; ++pass) {
            // Alternate traversal to reduce directional bias in the chain.
            let var met = true;
            for (let var i = 0; i < self.joints.len; ++i) {
                let idx = (pass & 1) == 0 ? i : self.joints.len-1-i;
                if (!self.joints[idx].solve()) met = false;
            }
            for (let var i = 0; i < self.bodies.len; ++i) {
                if (!self.contacts(self.bodies[i])) met = false;
            }
            if (met) break;
        }
        for (let var i = 0; i < self.bodies.len; ++i) {
            let b = self.bodies[i];
            b.v = b.p.sub(b.old_p).mul(1.0/STEP);
            let dq = b.q.mul(b.old_q.conj());
            let axis = Vec3(dq.x,dq.y,dq.z);
            let len = axis.length();
            let sign = dq.w < 0.0 ? -1.0 : 1.0;
            b.w = axis.mul(sign*2.0*atan2(len,dq.w.abs()) / (STEP*len.max(0.000000001)));
            // Inelastic normal impulses and Coulomb friction. The positional
            // normal correction supplies the resting weight/friction budget.
            for (let var k = 0; k < b.corners.len; ++k) {
                if (b.support[k] == 0.0) continue;
                let r = b.q.rotate(b.corners[k]);
                let n = self.ground.normal(b.p.add(r));
                let velocity = b.v.add(b.w.cross(r));
                let vn = velocity.dot(n);
                let normal_impulse = (-vn / b.weight(r,n)).max(0.0);
                b.impulse(n.mul(normal_impulse), r);
                let after = b.v.add(b.w.cross(r));
                let tangent = after.sub(n.mul(after.dot(n)));
                let speed = tangent.length();
                if (speed > 0.000001) {
                    let t = tangent.mul(1.0/speed);
                    let friction = (speed/b.weight(r,t)).min(FRICTION*(normal_impulse + b.support[k]/STEP));
                    b.impulse(t.mul(-friction), r);
                }
            }
        }
        self.time += STEP;
    }
    render(self, renderer) {
        renderer.begin(self.ground);
        for (let var i = 0; i < self.bodies.len; ++i) renderer.body(self.bodies[i]);
    }
    // Return maximum anchor gap, penetration, angular limit error, and energy.
    // Headless mode checks these throughout a fall, not just in the last frame.
    metrics(self) {
        let var gap = 0.0; let var depth = 0.0; let var angle = 0.0; let var energy = 0.0;
        for (let var i = 0; i < self.joints.len; ++i) {
            let j = self.joints[i];
            gap = gap.max(j.a.world(j.ra).sub(j.b.world(j.rb)).length());
            let a = j.angles();
            for (let var k = 0; k < 3; ++k) angle = angle.max((a.at(k)-a.at(k).clip(j.lo.at(k),j.hi.at(k))).abs());
        }
        for (let var i = 0; i < self.bodies.len; ++i) {
            let b = self.bodies[i];
            assert(b.p.dot(b.p) < 10000.0);
            let w = b.q.conj().rotate(b.w);
            energy += 0.5*b.mass*b.v.dot(b.v) + 0.5*(w.x*w.x/b.ii.x + w.y*w.y/b.ii.y + w.z*w.z/b.ii.z);
            for (let var k = 0; k < b.corners.len; ++k) depth = depth.max(-self.ground.sample(b.world(b.corners[k])));
        }
        return [gap,depth,angle,energy];
    }
}

// Read only the channels the policy receives. Joint speeds are rates of the
// same local Euler coordinates as the angles, measured from relative body
// angular velocity. Four bottom corners of each foot provide graded contact.
fun observe_biped(sim, observation, previous_head_velocity, interval) {
    let var current_joint = -1;
    let var angles = zero(); let var axes = []; let var relative_rate = zero();
    for (let var i = 0; i < CONTROL_OUTPUTS; ++i) {
        let pair = CONTROL_AXES[i];
        if (pair[0] != current_joint) {
            current_joint = pair[0];
            let joint = sim.joints[current_joint];
            angles = joint.angles();
            axes = joint.gradients(angles);
            relative_rate = joint.b.w.sub(joint.a.w);
        }
        observation.angles.set_f32(i,angles.at(pair[1]));
        observation.speeds.set_f32(i,relative_rate.dot(axes[pair[1]]));
    }
    let head = sim.torso;
    let head_velocity = sim.head_velocity();
    let acceleration = head_velocity.sub(previous_head_velocity).mul(1.0/interval);
    observation.head_accel_g = head.q.conj().rotate(
        acceleration.add(Vec3(0.0,9.81,0.0)).mul(1.0/9.81));
    observation.head_gyro = head.q.conj().rotate(head.w);
    observation.compass = head.q.conj().rotate(TRACK_FORWARD);
    observation.head_height = sim.ground.sample(sim.head_position());
    for (let var side = 0; side < 2; ++side) {
        let foot = sim.feet[side];
        for (let var k = 0; k < 4; ++k) {
            let corner = FOOT_SENSOR_CORNERS[k];
            let distance = sim.ground.sample(foot.world(foot.corners[corner]));
            // PBD support is a positional impulse with mass*metre units. An
            // approximate force is obtained by dividing by the squared step.
            let force = foot.support[corner]/(STEP*STEP);
            observation.set_contact(side*4+k,distance,force);
        }
    }
    return head_velocity;
}

// Packs an observation into the OBS_* layout, scaled to about unit range
fun encode_observation(observation, out)
{
    for (let var i = 0; i < CONTROL_JOINT_AXES; ++i) {
        out.set_f32(OBS_ANGLES + i, (observation.angles.get_f32(i) / PI).clip(-1.0, 1.0));
        out.set_f32(OBS_SPEEDS + i, (observation.speeds.get_f32(i) / 10.0).clip(-1.0, 1.0));
    }

    let a = observation.head_accel_g;
    let g = observation.head_gyro;
    out.set_f32(OBS_ACCEL, (a.x / 8.0).clip(-1.0, 1.0));
    out.set_f32(OBS_ACCEL + 1, (a.y / 8.0).clip(-1.0, 1.0));
    out.set_f32(OBS_ACCEL + 2, (a.z / 8.0).clip(-1.0, 1.0));
    out.set_f32(OBS_GYRO, (g.x / 10.0).clip(-1.0, 1.0));
    out.set_f32(OBS_GYRO + 1, (g.y / 10.0).clip(-1.0, 1.0));
    out.set_f32(OBS_GYRO + 2, (g.z / 10.0).clip(-1.0, 1.0));

    let c = observation.compass;
    out.set_f32(OBS_COMPASS, c.x);
    out.set_f32(OBS_COMPASS + 1, c.y);
    out.set_f32(OBS_COMPASS + 2, c.z);
    out.set_f32(OBS_HEIGHT, (observation.head_height / HEIGHT_SCALE).clip(0.0, 1.0));

    for (let var i = 0; i < CONTROL_FOOT_POINTS; ++i)
        out.set_f32(OBS_CONTACTS + i, observation.contacts.get_f32(i).clip(0.0, 1.0));
}

// A direction fixed in the world, in head-local coordinates, turned against
// the head's rotation over one control step, from the encoded gyro reading
// at base in obs
fun turn_with_gyro(v, obs, base)
{
    let w = Vec3(
        obs.get_f32(base + OBS_GYRO) * 10.0,
        obs.get_f32(base + OBS_GYRO + 1) * 10.0,
        obs.get_f32(base + OBS_GYRO + 2) * 10.0
    );
    return v.add(v.cross(w).mul(CONTROL_DT));
}

// Complementary filter estimating the up direction in the head frame, from
// the encoded accelerometer and gyro readings at base in obs. The previous
// estimate is turned by the gyro reading, then pulled slightly toward the
// accelerometer, which reads the opposite of gravity when the head is not
// accelerating. The first estimate comes from the accelerometer alone. The
// new estimate is written into obs and returned
fun filter_up(prev, obs, base)
{
    let ax = obs.get_f32(base + OBS_ACCEL) * 8.0;
    let ay = obs.get_f32(base + OBS_ACCEL + 1) * 8.0;
    let az = obs.get_f32(base + OBS_ACCEL + 2) * 8.0;
    let accel_len = (ax * ax + ay * ay + az * az).sqrt();

    let var up = UP;
    if (prev == nil) {
        if (accel_len > 0.1)
            up = Vec3(ax, ay, az);
    } else {
        up = turn_with_gyro(prev, obs, base);

        // Only trust the accelerometer near 1 g, when it mostly reads gravity
        if (accel_len > 0.5 && accel_len < 1.5)
            up = up.mul(1.0 - UP_FILTER_GAIN).add(Vec3(ax, ay, az).mul(UP_FILTER_GAIN / accel_len));
    }

    up = up.unit();
    obs.set_f32(base + OBS_UP, up.x);
    obs.set_f32(base + OBS_UP + 1, up.y);
    obs.set_f32(base + OBS_UP + 2, up.z);
    return up;
}

class EpisodeResult {
    init(self, fitness, progress, max_lateral, seconds, fell) {
        self.fitness = fitness;
        self.progress = progress;
        self.max_lateral = max_lateral;
        self.seconds = seconds;
        self.fell = fell;
    }
}

// The evaluator, trainer and viewer use the same observation, torque and
// stop logic
class PolicyEpisode {
    init(self, controller, episode_seed, max_seconds) {
        assert(max_seconds > 0.0 && max_seconds <= EPISODE_SECONDS);
        self.sim = Simulator(episode_seed);
        self.controller = controller;
        self.observation = BipedObservation();
        self.obs = ByteArray.with_size(OBS_SIZE * 4);
        self.up = nil;
        controller.reset();
        self.previous_head_velocity = self.sim.head_velocity();
        self.fall_height = FALL_HEIGHT_FRACTION*self.sim.torso.p.y;
        self.starting_pelvis = self.sim.pelvis.p;
        self.max_lateral = self.sim.pelvis.p.x.abs();
        self.fell = false;
        self.done = false;
        self.steps = 0;
        self.max_steps = (max_seconds/STEP).floor();
    }
    observe(self) {
        self.previous_head_velocity = observe_biped(
            self.sim, self.observation, self.previous_head_velocity, CONTROL_DT);
        encode_observation(self.observation, self.obs);
        self.up = filter_up(self.up, self.obs, 0);
    }
    step(self) {
        if (self.done) return;
        if (self.steps % CONTROL_SUBSTEPS == 0) {
            self.observe();
            self.controller.act(self.obs);
            self.sim.set_policy_torques(self.controller.torques());
        }
        self.sim.step();
        self.steps += 1;
        self.max_lateral = self.max_lateral.max(self.sim.pelvis.p.x.abs());
        // The robot has fallen once its torso is low or tilted too far
        let torso = self.sim.torso;
        self.fell = torso.p.y < self.fall_height || torso.q.rotate(UP).y < FALL_TILT_COS;
        self.done = self.fell || self.steps >= self.max_steps;
    }
    result(self) {
        // Fitness is displacement projected on the forward vector, so sideways
        // travel earns nothing and only moving backwards scores negative. A
        // bonus per second before falling rewards learning to balance
        let progress = self.sim.pelvis.p.sub(self.starting_pelvis).dot(TRACK_FORWARD);
        let fitness = progress + UPRIGHT_WEIGHT * self.sim.time;
        return EpisodeResult(fitness,progress,self.max_lateral,self.sim.time,self.fell);
    }
}

// Runs one episode to completion and returns its result
fun evaluate_controller(controller, episode_seed, max_seconds) {
    let episode = PolicyEpisode(controller,episode_seed,max_seconds);
    while (!episode.done) episode.step();
    return episode.result();
}

// --- Evolution ---
//
// Each island actor evolves a population of controllers in the simulator.
// Every individual is scored on the same EVAL_EPISODES starting poses,
// redrawn each generation, and its fitness is the mean over those rollouts.
// The best few carry over unchanged, and the rest of the population is
// replaced by mutated children of the top ones. Islands form a ring, and
// periodically send a few parents to their neighbours.

let NUM_ISLANDS = 14;
let POP_SIZE = 64;
let NUM_ELITES = 8;
let NUM_PARENTS = 28;
let EVAL_EPISODES = 4;
let MUTATION_PROB = 0.02;
let MUTATION_SIGMA = 0.18;
let MUTATION_RESET_PROB = 0.1;
let MIGRATION_PERIOD = 20;
let NUM_MIGRANTS = 2;  // Sent to each neighbour, so an island receives four

// How often the viewer switches to the best controller
let VIEWER_PERIOD_MS = 10_000;

// Setup for an island: index, seed, island ids
let MSG_SETUP = 0;
let MSG_MIGRANT = 1;   // A controller snapshot arriving from a neighbour
let MSG_STOP = 2;

// Island index, generation, best fitness, mean fitness, ms taken, snapshot
// of the best controller
let MSG_REPORT = 3;

// Standard normal sample using Box-Muller
fun gauss(rng)
{
    let u1 = rng.float(1.0e-9, 1.0);
    let u2 = rng.float(0.0, 1.0);
    return (-2.0 * u1.ln()).sqrt() * (6.28318530717959 * u2).cos();
}

// Fills order with the indices of values, sorted from highest to lowest
fun sort_indices(order, values)
{
    for (let var i = 0; i < order.len; ++i)
        order[i] = i;

    for (let var i = 1; i < order.len; ++i) {
        let idx = order[i];
        let var j = i - 1;
        while (j >= 0 && values[order[j]] < values[idx]) {
            order[j + 1] = order[j];
            j -= 1;
        }
        order[j + 1] = idx;
    }
}

// Each parameter is mutated with probability MUTATION_PROB. Rather than
// rolling for every parameter, jump straight to the next mutated one, since
// the gaps between them are geometrically distributed. Output biases get the
// full sigma since they act on the torques directly
fun mutate_network(network, rng, sigma)
{
    let arrays = network.params();
    let log_keep = (1.0 - MUTATION_PROB).ln();

    for (let var group = 0; group < arrays.len; ++group) {
        let array = arrays[group];
        let len = array.len >> 2;
        let scale = group == arrays.len - 1 ? sigma : sigma * 0.5;
        let bound = network.bounds[group >> 1];

        let var idx = -1;
        loop {
            idx += 1 + (rng.float(1.0e-9, 1.0).ln() / log_keep).floor();
            if (idx >= len)
                break;

            // Most mutations nudge, a few redraw, which lets a lineage get
            // out of a corner that nudging alone cannot leave
            if (rng.float(0.0, 1.0) < MUTATION_RESET_PROB)
                array.set_f32(idx, rng.float(-bound, bound));
            else
                array.set_f32(idx, array.get_f32(idx) + gauss(rng) * scale);
        }
    }
}

class Island
{
    init(self, seed)
    {
        self.rng = Xoshiro128(seed);

        // The next generation is written into next_pop, then the two are
        // swapped, so networks are allocated once rather than every generation
        let limits = biped_torque_limits();
        self.pop = [];
        self.next_pop = [];
        for (let var i = 0; i < POP_SIZE; ++i) {
            self.pop.push(Controller(self.rng.int(0, 0x40000000), limits));
            self.next_pop.push(Controller(0, limits));
        }

        self.seeds = Array.with_size(EVAL_EPISODES, 0);
        self.fitness = Array.with_size(POP_SIZE, 0.0);
        self.order = Array.with_size(POP_SIZE, 0);

        self.immigrants = [];
        self.generation = 0;
        self.best_fitness = 0.0;
        self.mean_fitness = 0.0;
    }

    // Picks this generation's starting poses. Every individual is scored
    // with the same ones, so rankings reflect the controllers, not the poses
    draw_seeds(self)
    {
        for (let var k = 0; k < EVAL_EPISODES; ++k)
            self.seeds[k] = self.rng.int(0, 0x40000000);
    }

    evaluate(self, i)
    {
        let var total = 0.0;
        for (let var k = 0; k < EVAL_EPISODES; ++k)
            total += evaluate_controller(self.pop[i], self.seeds[k], EPISODE_SECONDS).fitness;
        self.fitness[i] = total / EVAL_EPISODES;
    }

    // Sorts the population by fitness, best first, and records this
    // generation's statistics
    rank(self)
    {
        sort_indices(self.order, self.fitness);

        let var total = 0.0;
        for (let var i = 0; i < POP_SIZE; ++i)
            total += self.fitness[i];
        self.best_fitness = self.fitness[self.order[0]];
        self.mean_fitness = total / POP_SIZE;
    }

    // A snapshot of a random parent, to send to a neighbouring island
    emigrant(self)
    {
        return self.pop[self.order[self.rng.index(NUM_PARENTS)]].network.snapshot();
    }

    // Keeps the elites unchanged and fills the rest of the population with
    // mutated children of the parents. Must be called after rank()
    reproduce(self)
    {
        for (let var i = 0; i < POP_SIZE; ++i) {
            let child = self.next_pop[i].network;
            if (i < NUM_ELITES) {
                child.copy_from(self.pop[self.order[i]].network);
            } else {
                child.copy_from(self.pop[self.order[(i - NUM_ELITES) % NUM_PARENTS]].network);
                mutate_network(child, self.rng, MUTATION_SIGMA);
            }
        }

        // Immigrants replace the last children, and arrive unmutated so the
        // next generation scores them as they are
        let num = self.immigrants.len.min(POP_SIZE);
        for (let var i = 0; i < num; ++i)
            self.next_pop[POP_SIZE - 1 - i].network.load(self.immigrants[i]);
        self.immigrants.resize(0, nil);

        let tmp = self.pop;
        self.pop = self.next_pop;
        self.next_pop = tmp;
        self.generation += 1;
    }
}

fun island_actor()
{
    let setup = $actor_recv();
    let index = setup[1];
    let ids = setup[3];
    let parent = $actor_parent();

    // Each island gets its own stream, so they do not evolve in lockstep
    let island = Island(setup[2] + index * 7919);

    let neighbours = [
        ids[(index + 1) % ids.len],
        ids[(index + ids.len - 1) % ids.len]
    ];

    loop {
        let start_ms = $time_current_ms();
        island.draw_seeds();

        for (let var i = 0; i < POP_SIZE; ++i) {
            island.evaluate(i);

            loop {
                let msg = $actor_poll();
                if (msg == nil)
                    break;
                if (msg[0] == MSG_STOP)
                    return island.generation;
                if (msg[0] == MSG_MIGRANT)
                    island.immigrants.push(msg[1]);
            }
        }

        island.rank();
        $actor_send(parent, [
            MSG_REPORT,
            index,
            island.generation,
            island.best_fitness,
            island.mean_fitness,
            $time_current_ms() - start_ms,
            island.pop[island.order[0]].network.snapshot()
        ]);

        if (ids.len > 1 && (island.generation + 1) % MIGRATION_PERIOD == 0) {
            for (let var n = 0; n < neighbours.len; ++n) {
                for (let var i = 0; i < NUM_MIGRANTS; ++i)
                    $actor_send(neighbours[n], [MSG_MIGRANT, island.emigrant()]);
            }
        }

        island.reproduce();
    }
}

// Spawns the ring of islands, and tells each who the others are. Actor ids
// only exist once everything has been spawned, which is why setup is a
// message rather than an argument. Returns the island ids
fun spawn_training(num_islands, seed)
{
    let ids = [];
    for (let var i = 0; i < num_islands; ++i)
        ids.push($actor_spawn(island_actor));

    for (let var i = 0; i < num_islands; ++i)
        $actor_send(ids[i], [MSG_SETUP, i, seed, ids]);

    return ids;
}

// Stops every island, and returns the total number of island generations
fun stop_training(ids)
{
    for (let var i = 0; i < ids.len; ++i)
        $actor_send(ids[i], [MSG_STOP]);

    let var generations = 0;
    for (let var i = 0; i < ids.len; ++i)
        generations += $actor_join(ids[i]);
    return generations;
}

// Runs in the main actor: prints each island's report, and keeps the latest
// one, whose best controller the viewer can show
class Coordinator
{
    init(self, ids)
    {
        self.latest = Array.with_size(ids.len, nil);
    }

    // Handles a message from the islands, if it is one
    handle(self, msg)
    {
        if (!(msg instanceof Array) || msg[0] != MSG_REPORT)
            return false;

        self.latest[msg[1]] = msg;
        $println(
            "Island " + msg[1].to_s() +
            ", generation " + msg[2].to_s() +
            ": best fitness " + msg[3].format_decimals(3) +
            ", mean " + msg[4].format_decimals(3) +
            ", " + (msg[5].to_f() / 1000.0).format_decimals(1) + " s"
        );
        return true;
    }

    // The island whose latest best fitness is highest, or nil before any
    // report
    best(self)
    {
        let var best = nil;
        for (let var i = 0; i < self.latest.len; ++i) {
            if (self.latest[i] != nil && (best == nil || self.latest[i][3] > self.latest[best][3]))
                best = i;
        }
        return best;
    }
}

// The frame of one box within a body, offset from the body's origin
class PartFrame {
    init(self, body, offset) { self.body = body; self.offset = offset; }
    world(self, local) { return self.body.world(self.offset.add(local)); }
}

// Perspective projection with near clipping, backface culling, interpolated
// vertex lighting and a depth buffer. The scanline loop follows the approach
// in benchmarks/raster_vertlight.psh, with solid colors instead of textures.
class ScreenVertex {
    init(self, x, y, z, light) { self.x = x; self.y = y; self.z = z; self.light = light; }
}

// The ground pass submits its opaque polygons in layer order, paint first.
// Each scanline stores a sorted union of covered intervals. Inserting a span
// reports only its uncovered pieces, so covered pixels never reach the inner
// raster loop. This is the compact opaque case of Tremor's S-buffer.
class SBuffer {
    init(self) {
        self.head = Array.with_size(HEIGHT,-1);
        self.x0 = []; self.x1 = []; self.next = [];
        self.visible_x0 = Array.with_size(WIDTH,0);
        self.visible_x1 = Array.with_size(WIDTH,0);
        self.used = 0;
    }
    reset(self) {
        for (let var y = 0; y < HEIGHT; ++y) self.head[y] = -1;
        self.used = 0;
    }
    allocate(self, x0, x1, next) {
        let i = self.used; self.used += 1;
        if (i == self.x0.len) {
            self.x0.push(x0); self.x1.push(x1); self.next.push(next);
        } else {
            self.x0[i] = x0; self.x1[i] = x1; self.next[i] = next;
        }
        return i;
    }
    insert(self, y, x0, x1) {
        let var prev = -1;
        let var cur = self.head[y];
        while (cur != -1 && self.x1[cur] < x0) {
            prev = cur; cur = self.next[cur];
        }
        let var count = 0;
        let var mx0 = x0; let var mx1 = x1;
        let var cursor = x0; let var scan = cur;
        while (scan != -1 && self.x0[scan] <= x1) {
            let sx0 = self.x0[scan]; let sx1 = self.x1[scan];
            if (cursor < sx0) {
                self.visible_x0[count] = cursor;
                self.visible_x1[count] = sx0.min(x1);
                count += 1;
            }
            cursor = cursor.max(sx1);
            mx0 = mx0.min(sx0); mx1 = mx1.max(sx1);
            scan = self.next[scan];
        }
        if (cursor < x1) {
            self.visible_x0[count] = cursor;
            self.visible_x1[count] = x1;
            count += 1;
        }
        if (count == 0) return 0;
        if (cur == scan) {
            let item = self.allocate(mx0,mx1,scan);
            if (prev == -1) self.head[y] = item;
            else self.next[prev] = item;
        } else {
            self.x0[cur] = mx0; self.x1[cur] = mx1; self.next[cur] = scan;
        }
        return count;
    }
}

class Renderer {
    init(self) {
        self.image = Image(WIDTH,HEIGHT); self.depth = ByteArray.with_size(WIDTH*HEIGHT*4);
        self.yaw = 2.8; self.pitch = 0.28; self.distance = 4.2;
        self.target = Vec3(0.0,0.85,0.0);
        self.faces = [[0,4,6,2],[1,3,7,5],[0,1,5,4],[2,6,7,3],[0,2,3,1],[4,5,7,6]];
        self.ground_pixels = ByteArray.with_size(WIDTH*HEIGHT*4);
        self.ground_depth = ByteArray.with_size(WIDTH*HEIGHT*4);
        self.cached_ground = nil;
        self.sbuffer = SBuffer(); self.floor_pass = false;
        // Sky colors from zenith (0) to horizon (SKY_STEPS-1)
        self.sky_colors = [];
        for (let var i = 0; i < SKY_STEPS; ++i) {
            let t = i.to_f() / (SKY_STEPS-1).to_f();
            // Quadratic falloff brightens the sky faster near the horizon
            let s = t * t;
            let r = (70.0 + (205.0-70.0)*s).floor();
            let g = (130.0 + (228.0-130.0)*s).floor();
            let b = (210.0 + (245.0-210.0)*s).floor();
            self.sky_colors.push(0xFF000000 | (r << 16) | (g << 8) | b);
        }
    }
    sky(self) {
        // Rows at or below the horizon get the horizon haze color
        let horizon = HEIGHT*0.5 - 620.0*self.pitch.tan();
        let last = SKY_STEPS-1;
        for (let var y = 0; y < HEIGHT; ++y) {
            let var i = last;
            if (y.to_f() < horizon) i = (y.to_f()/horizon*last).floor();
            self.image.bytes.fill_u32(y*WIDTH, WIDTH, self.sky_colors[i]);
        }
    }
    begin(self, ground) {
        self.eye = self.target.add(Vec3(self.yaw.sin()*self.pitch.cos(),self.pitch.sin(),self.yaw.cos()*self.pitch.cos()).mul(self.distance));
        self.forward = self.target.sub(self.eye).unit();
        self.right = self.forward.cross(UP).unit(); self.up = self.right.cross(self.forward);
        // Both color and depth are cached, so body/ground occlusion is identical
        // to drawing the static floor again. Any camera change invalidates it.
        if (self.cached_ground == ground && self.cached_revision == ground.revision
            && self.cached_yaw == self.yaw && self.cached_pitch == self.pitch
            && self.cached_distance == self.distance
            && self.cached_target.x == self.target.x && self.cached_target.y == self.target.y
            && self.cached_target.z == self.target.z) {
            self.image.bytes.memcpy(0,self.ground_pixels,0,WIDTH*HEIGHT*4);
            self.depth.memcpy(0,self.ground_depth,0,WIDTH*HEIGHT*4);
            return;
        }
        self.sky(); self.depth.fill_u32(0,WIDTH*HEIGHT,0);
        self.sbuffer.reset(); self.floor_pass = true;
        ground.draw(self);
        self.floor_pass = false;
        self.ground_pixels.memcpy(0,self.image.bytes,0,WIDTH*HEIGHT*4);
        self.ground_depth.memcpy(0,self.depth,0,WIDTH*HEIGHT*4);
        self.cached_ground = ground; self.cached_revision = ground.revision;
        self.cached_yaw = self.yaw; self.cached_pitch = self.pitch; self.cached_distance = self.distance;
        self.cached_target = Vec3(self.target.x,self.target.y,self.target.z);
    }
    camera(self, p) {
        let d = p.sub(self.eye); return Vec3(d.dot(self.right),d.dot(self.up),d.dot(self.forward));
    }
    light(self, p, n) {
        // Outdoor sunlight and soft fill keep the full straight illuminated,
        // including the far end, and make both sides of the outfit readable.
        return BRIGHTNESS * (0.28 + 0.50*n.dot(SUN_DIRECTION).max(0.0)
                                 + 0.20*n.dot(FILL_DIRECTION).max(0.0));
    }
    box(self, f, size, color) {
        let vertices = [];
        for (let var i = 0; i < 8; ++i) {
            vertices.push(f.world(Vec3((i & 1) == 0 ? -size.x*0.5 : size.x*0.5,
                                       (i & 2) == 0 ? -size.y*0.5 : size.y*0.5,
                                       (i & 4) == 0 ? -size.z*0.5 : size.z*0.5)));
        }
        for (let var i = 0; i < 6; ++i) {
            let f = self.faces[i];
            self.quad(vertices[f[0]],vertices[f[1]],vertices[f[2]],vertices[f[3]],color);
        }
    }
    body(self, b) {
        for (let var i = 0; i < b.parts.len; ++i) {
            let part = b.parts[i];
            self.part(PartFrame(b, part[1]), part[0], part[2], part[3]);
        }
    }
    // Draws one box of a body and its details, in the box's own frame
    part(self, f, name, size, color) {
        self.box(f, size, color);
        // Chunky trapezoidal sunglasses: separate tinted lenses, a bridge,
        // side arms and small reflections distinguish them from a robot visor.
        if (name == "Head") {
            for (let var side = 0; side < 2; ++side) {
                let x = side == 0 ? -0.087 : 0.007;
                self.quad(f.world(Vec3(x+0.010,0.006,0.098)),f.world(Vec3(x+0.070,0.006,0.098)),
                          f.world(Vec3(x+0.080,0.070,0.098)),f.world(Vec3(x,0.070,0.098)),0x151720);
                self.quad(f.world(Vec3(x+0.016,0.015,0.100)),f.world(Vec3(x+0.064,0.015,0.100)),
                          f.world(Vec3(x+0.070,0.058,0.100)),f.world(Vec3(x+0.010,0.058,0.100)),0x334052);
                self.quad(f.world(Vec3(x+0.014,0.047,0.101)),f.world(Vec3(x+0.036,0.047,0.101)),
                          f.world(Vec3(x+0.044,0.055,0.101)),f.world(Vec3(x+0.016,0.055,0.101)),0x91AAA9);
            }
            self.quad(f.world(Vec3(-0.010,0.042,0.099)),f.world(Vec3(0.010,0.042,0.099)),
                      f.world(Vec3(0.010,0.060,0.099)),f.world(Vec3(-0.010,0.060,0.099)),0x151720);
            self.quad(f.world(Vec3(-0.091,0.047,-0.045)),f.world(Vec3(-0.091,0.047,0.098)),
                      f.world(Vec3(-0.091,0.067,0.098)),f.world(Vec3(-0.091,0.067,-0.045)),0x151720);
            self.quad(f.world(Vec3(0.091,0.047,0.098)),f.world(Vec3(0.091,0.047,-0.045)),
                      f.world(Vec3(0.091,0.067,-0.045)),f.world(Vec3(0.091,0.067,0.098)),0x151720);
        }
        if (name == "Torso") {
            // A silver zip details the red jacket.
            self.quad(f.world(Vec3(-0.008,-0.20,0.117)),f.world(Vec3(0.008,-0.20,0.117)),
                      f.world(Vec3(0.008,0.20,0.117)),f.world(Vec3(-0.008,0.20,0.117)),0xD1DFD6);
        }
        let right_leg = name == "Right thigh" || name == "Right shin";
        if (right_leg || name == "Left thigh" || name == "Left shin") {
            // A cream stripe runs down the outer side of each trouser leg.
            let x = (right_leg ? -0.5 : 0.5)*size.x + (right_leg ? -0.001 : 0.001);
            let y0 = -0.5*size.y; let y1 = 0.5*size.y;
            let w = 0.018;
            if (right_leg) {
                self.quad(f.world(Vec3(x,y0,-w)),f.world(Vec3(x,y0,w)),
                          f.world(Vec3(x,y1,w)),f.world(Vec3(x,y1,-w)),0xF3EAD5);
            } else {
                self.quad(f.world(Vec3(x,y0,w)),f.world(Vec3(x,y0,-w)),
                          f.world(Vec3(x,y1,-w)),f.world(Vec3(x,y1,w)),0xF3EAD5);
            }
        }
    }
    quad(self, a, b, c, d, color) {
        let n = b.sub(a).cross(c.sub(a)).unit();
        // Cull backfaces before projection, clipping or S-buffer insertion.
        if (n.dot(self.eye.sub(a)) <= 0.0) return;
        let points = [a,b,c,d]; let poly = [];
        for (let var i = 0; i < 4; ++i) {
            let p = self.camera(points[i]); poly.push(ScreenVertex(p.x,p.y,p.z,self.light(points[i],n)));
        }
        // Sutherland-Hodgman near-plane clipping, including vertex light.
        let clipped = [];
        let var prev = poly[3];
        for (let var i = 0; i < 4; ++i) {
            let p = poly[i];
            if ((p.z >= 0.08) != (prev.z >= 0.08)) {
                let t = (0.08-prev.z)/(p.z-prev.z);
                clipped.push(ScreenVertex(prev.x+t*(p.x-prev.x),prev.y+t*(p.y-prev.y),0.08,prev.light+t*(p.light-prev.light)));
            }
            if (p.z >= 0.08) clipped.push(p);
            prev = p;
        }
        for (let var i = 0; i < clipped.len; ++i) {
            let p = clipped[i]; let inv = 1.0/p.z;
            p.x = WIDTH*0.5 + 620.0*p.x*inv; p.y = HEIGHT*0.5 - 620.0*p.y*inv;
            p.z = inv; p.light *= inv;
        }
        for (let var i = 1; i+1 < clipped.len; ++i) self.triangle(clipped[0],clipped[i],clipped[i+1],color);
    }
    triangle(self, a, b, c, color) {
        let dx1 = b.x-a.x; let dy1 = b.y-a.y; let dx2 = c.x-a.x; let dy2 = c.y-a.y;
        let det = dx1*dy2-dx2*dy1;
        if (det.abs() < 0.000001) return;
        let zx = ((b.z-a.z)*dy2-(c.z-a.z)*dy1)/det;
        let zy = ((c.z-a.z)*dx1-(b.z-a.z)*dx2)/det;
        let lx = ((b.light-a.light)*dy2-(c.light-a.light)*dy1)/det;
        let ly = ((c.light-a.light)*dx1-(b.light-a.light)*dx2)/det;
        let y0 = (a.y.min(b.y).min(c.y)-0.5).ceil().max(0);
        let y1 = (a.y.max(b.y).max(c.y)-0.5).ceil().min(HEIGHT);
        let vertices = [a,b,c];
        let r = (color >> 16) & 255; let g = (color >> 8) & 255; let blue = color & 255;
        let fb = self.image.bytes; let depth = self.depth;
        let floor_pass = self.floor_pass;
        let sbuffer = self.sbuffer;
        // Outdoor light is directional, so every vertex on a planar face has
        // the same shade. The S-buffer makes its ground pixels write only once.
        let floor_shade = (a.light/a.z).clip(0.0,1.0);
        let floor_pixel = 0xFF000000 | ((r*floor_shade).floor() << 16)
                         | ((g*floor_shade).floor() << 8) | (blue*floor_shade).floor();
        for (let var y = y0; y < y1; ++y) {
            let py = y+0.5; let var left = 1.0e20; let var right = -1.0e20;
            for (let var e = 0; e < 3; ++e) {
                let p = vertices[e]; let q = vertices[(e+1)%3];
                if ((p.y <= py && q.y > py) || (q.y <= py && p.y > py)) {
                    let x = p.x+(py-p.y)*(q.x-p.x)/(q.y-p.y);
                    left = left.min(x); right = right.max(x);
                }
            }
            // Clip as floats before converting, including empty scanlines.
            if (left >= right) continue;
            let x0 = (left-0.5).clip(0.0,WIDTH.to_f()).ceil();
            let x1 = (right-0.5).clip(0.0,WIDTH.to_f()).ceil();
            if (floor_pass) {
                let count = sbuffer.insert(y,x0,x1);
                for (let var piece = 0; piece < count; ++piece) {
                    let start_x = sbuffer.visible_x0[piece];
                    let var zi = a.z+zx*(start_x+0.5-a.x)+zy*(py-a.y);
                    let var pixel_idx = y*WIDTH+start_x;
                    let end_idx = y*WIDTH+sbuffer.visible_x1[piece];
                    while (pixel_idx < end_idx) {
                        fb.set_u32(pixel_idx,floor_pixel);
                        depth.set_f32(pixel_idx,zi);
                        zi += zx; ++pixel_idx;
                    }
                }
                continue;
            }
            let var z = a.z+zx*(x0+0.5-a.x)+zy*(py-a.y);
            let var light = a.light+lx*(x0+0.5-a.x)+ly*(py-a.y);
            let var idx = y*WIDTH+x0; let end = y*WIDTH+x1;
            while (idx < end) {
                if (z > depth.get_f32(idx)) {
                    let shade = (light/z).clip(0.0,1.0);
                    fb.set_u32(idx,0xFF000000 | ((r*shade).floor() << 16) | ((g*shade).floor() << 8) | (blue*shade).floor());
                    depth.set_f32(idx,z);
                }
                z += zx; light += lx; ++idx;
            }
        }
    }
}

if ($cmd_get_arg_or(1,"") == "--evaluate") {
    let episode_seed = $cmd_get_arg_or(2,"1").parse_int(10);
    let model_seed = $cmd_get_arg_or(3,"1").parse_int(10);
    if (episode_seed == nil || model_seed == nil) {
        $println("Expected integer episode and model seeds"); $exit(1);
    }
    let controller = Controller(model_seed,biped_torque_limits());
    let result = evaluate_controller(controller,episode_seed,EPISODE_SECONDS);
    $println("Fitness: " + result.fitness.format_decimals(3)
        + " | forward: " + result.progress.format_decimals(3) + " m"
        + " | max lateral: " + result.max_lateral.format_decimals(3) + " m"
        + " | time: " + result.seconds.format_decimals(3) + " s"
        + " | fell: " + result.fell.to_s());
    $exit(0);
}

if ($cmd_get_arg_or(1,"") == "--train-headless") {
    let minutes = $cmd_get_arg_or(2, "10").parse_float();
    let model_seed = $cmd_get_arg_or(3, "1").parse_int(10);
    let num_islands = $cmd_get_arg_or(4, NUM_ISLANDS.to_s()).parse_int(10);
    if (minutes == nil || model_seed == nil || num_islands == nil || minutes <= 0.0 || num_islands <= 0) {
        $println("Expected a positive duration in minutes, an integer seed and a positive island count");
        $exit(1);
    }
    let training = spawn_training(num_islands, model_seed);
    let coordinator = Coordinator(training);
    $println("Evolving " + num_islands.to_s() + " islands for " + minutes.to_s() + " minutes");

    let start_ms = $time_current_ms();
    let end_ms = start_ms + (minutes * 60_000.0).floor();
    while ($time_current_ms() < end_ms) {
        let msg = $actor_poll();
        if (msg == nil)
            $actor_sleep(20);
        else
            coordinator.handle(msg);
    }

    $println("Training stopped after " + stop_training(training).comma_sep() + " generations across all islands");
    $exit(0);
}

// Measure a fixed workload, independently of display refresh and frame pacing.
// Four physics steps advance 1/60 s. Interleave runs when comparing versions.
if ($cmd_get_arg_or(1,"") == "--bench") {
    let frames = $cmd_get_arg_or(2,"180").parse_int(10);
    let bench_seed = $cmd_get_arg_or(3,"1").parse_int(10);
    if (frames == nil || bench_seed == nil) { $println("Expected integer frames and seed"); $exit(1); }
    if (frames <= 0) { $println("Frames must be positive"); $exit(1); }
    let bench_sim = Simulator(bench_seed); let bench_renderer = Renderer();
    bench_sim.render(bench_renderer);
    let var physics_ms = 0; let var render_ms = 0;
    for (let var frame = 0; frame < frames; ++frame) {
        if ($cmd_get_arg_or(4,"") == "orbit") bench_renderer.yaw += 0.01;
        let start = $time_current_ms();
        for (let var i = 0; i < 4; ++i) bench_sim.step();
        let middle = $time_current_ms();
        bench_sim.render(bench_renderer);
        let end = $time_current_ms();
        physics_ms += middle-start; render_ms += end-middle;
    }
    $println("Physics (1/60 s): " + (physics_ms.to_f()/frames).format_decimals(3)
        + " ms; render: " + (render_ms.to_f()/frames).format_decimals(3) + " ms/frame");
    $println("Final energy: " + bench_sim.metrics()[3].format_decimals(3) + " J");
    let var checksum = 0;
    for (let var i = 0; i < WIDTH*HEIGHT; ++i) checksum = (checksum*31 + bench_renderer.image.bytes.get_u32(i)) & 0xFFFFFFFF;
    $println("Frame checksum: " + checksum.to_s());
    $exit(0);
}

let headless = $cmd_get_arg_or(1,"") == "--headless";
let policy_mode = $cmd_get_arg_or(1,"") == "--policy";
let train_mode = $cmd_get_arg_or(1,"") == "--train";
let viewer_mode = policy_mode || train_mode;
let var duration = 8.0;
let var seed = $time_current_ms();
let var model_seed = 1;
let var num_islands = NUM_ISLANDS;
if (headless) {
    duration = $cmd_get_arg_or(2,"8").parse_float();
    seed = $cmd_get_arg_or(3,"1").parse_int(10);
} else if (viewer_mode) {
    seed = $cmd_get_arg_or(2,"1").parse_int(10);
    model_seed = $cmd_get_arg_or(3,"1").parse_int(10);
    num_islands = $cmd_get_arg_or(4, NUM_ISLANDS.to_s()).parse_int(10);
} else if ($cmd_get_arg(1) != nil) {
    seed = $cmd_get_arg(1).parse_int(10);
}
if (seed == nil || model_seed == nil || duration == nil || num_islands == nil || num_islands <= 0) {
    $println("Usage: plush examples/bipedal_sim.psh [seed] | --policy [episode_seed] [model_seed] | --train [episode_seed] [model_seed] [islands] | --headless [seconds] [seed] [shot.tga]");
    $exit(1);
}
if (!(duration > 0.0 && duration <= 3600.0)) { $println("Seconds must be in (0, 3600]"); $exit(1); }
let training = train_mode ? spawn_training(num_islands, model_seed) : nil;
let coordinator = train_mode ? Coordinator(training) : nil;
let var last_viewer_ms = $time_current_ms();
let controller = viewer_mode ? Controller(model_seed,biped_torque_limits()) : nil;
let var episode = viewer_mode ? PolicyEpisode(controller,seed,EPISODE_SECONDS) : nil;
let var sim = viewer_mode ? episode.sim : Simulator(seed);
let renderer = Renderer();
$println("Biped: 1.78 m, 80 kg, 9 bodies. Seed: " + seed.to_s());
if (headless) {
    if ($cmd_get_arg_or(5,"") == "hold") sim.toggle_hold();
    let count = (duration/STEP).ceil();
    let maxima = [0.0,0.0,0.0,0.0];
    for (let var i = 0; i < count; ++i) {
        sim.step();
        let m = sim.metrics();
        for (let var k = 0; k < 4; ++k) maxima[k] = maxima[k].max(m[k]);
        assert(m[0] < 0.04);
        assert(m[1] < 0.025);
        assert(m[2] < 12.0*DEG);
        assert(m[3] < 2000.0);
    }
    sim.render(renderer);
    let path = $cmd_get_arg(4);
    if (path != nil && path != "-") assert(save_tga(path,renderer.image));
    $println("Simulated " + sim.time.format_decimals(2) + " s; max anchor gap " + (maxima[0]*1000.0).format_decimals(2) + " mm; penetration " + (maxima[1]*1000.0).format_decimals(2) + " mm; limit error " + (maxima[2]/DEG).format_decimals(2) + " deg");
    $println("Peak kinetic energy " + maxima[3].format_decimals(2) + " J; final " + sim.metrics()[3].format_decimals(3) + " J");
    $exit(0);
}

if (train_mode) {
    $println("Evolving " + num_islands.to_s() + " islands in the simulator; watching the island with the best latest generation. Episodes replay after a short pause.");
    $println("R next pose | SPACE pause | N step | Arrows orbit | W/S zoom | Close window to exit");
} else if (policy_mode) {
    $println("Watching untrained policy (model seed " + model_seed.to_s() + "). Episodes replay after a short pause.");
    $println("R next pose | SPACE pause | N step | Arrows orbit | W/S zoom | Close window to exit");
} else {
    $println("R reset | SPACE pause | N step | Arrows orbit | W/S zoom | H pose motors | Close window to exit");
}
let title = train_mode ? "Biped training | R next pose | SPACE pause | N step | Arrows orbit | W/S zoom"
            : policy_mode ? "Biped policy | R next pose | SPACE pause | N step | Arrows orbit | W/S zoom"
            : "Biped | R reset | SPACE pause | N step | Arrows orbit | W/S zoom | H motors";
let window = $window_create(WIDTH,HEIGHT,title,0);
let var paused = false; let var accumulator = 0.0; let var last_ms = $time_current_ms();
let var replay_ms = 0;
let var viewer_revision = 0; let var reported_revision = -1;
let var left = false; let var right = false; let var up = false; let var down = false;
let var closer = false; let var farther = false;
loop {
    let start = $time_current_ms();
    let dt = ((start-last_ms)*0.001).clip(0.0,0.05); last_ms = start;
    let var quit = false;
    loop {
        let msg = $actor_poll(); if (msg == nil) break;
        if (train_mode && coordinator.handle(msg))
            continue;
        if (!(msg instanceof UIEvent)) continue;
        if (msg.kind == 'CLOSE_WINDOW') { quit = true; break; }
        if (msg.kind != 'KEY_DOWN' && msg.kind != 'KEY_UP') continue;
        let pressed = msg.kind == 'KEY_DOWN';
        if (msg.key == 'LEFT') left = pressed;
        if (msg.key == 'RIGHT') right = pressed;
        if (msg.key == 'UP') up = pressed;
        if (msg.key == 'DOWN') down = pressed;
        if (msg.key == 'W') closer = pressed;
        if (msg.key == 'S') farther = pressed;
        if (!pressed) continue;
        if (msg.key == 'ESCAPE') continue;
        if (msg.key == 'R') {
            if (viewer_mode) {
                seed += 1;
                episode = PolicyEpisode(controller,seed,EPISODE_SECONDS);
                sim = episode.sim;
                renderer.target.z = 0.0;
                replay_ms = 0;
                reported_revision = -1;
                $println("Episode seed: " + seed.to_s());
            } else sim.reset();
            accumulator = 0.0;
        }
        if (msg.key == 'SPACE') { paused = !paused; accumulator = 0.0; $println(paused ? "Paused" : "Running"); }
        if (msg.key == 'N') {
            paused = true; accumulator = 0.0;
            for (let var i = 0; i < 4; ++i) {
                if (viewer_mode) episode.step(); else sim.step();
            }
        }
        if (msg.key == 'H' && !viewer_mode) { sim.toggle_hold(); $println(sim.hold ? "Pose motors ON (no balance controller)" : "Passive joints"); }
    }
    if (quit) break;

    // Periodically switch to the best controller of the island whose latest
    // generation scores best
    if (train_mode) {
        let best = coordinator.best();
        if (best != nil && start - last_viewer_ms >= VIEWER_PERIOD_MS) {
            let latest = coordinator.latest[best];
            controller.network.load(latest[6]);
            episode = PolicyEpisode(controller,seed,EPISODE_SECONDS);
            sim = episode.sim;
            renderer.target.z = 0.0;
            accumulator = 0.0;
            replay_ms = 0;
            viewer_revision += 1;
            last_viewer_ms = start;
            $println("Viewer: island " + best.to_s() + ", fitness " + latest[3].format_decimals(3));
        }
    }

    if (left) renderer.yaw -= dt;
    if (right) renderer.yaw += dt;
    if (up) renderer.pitch += dt*0.7;
    if (down) renderer.pitch -= dt*0.7;
    if (closer) renderer.distance -= dt*2.0;
    if (farther) renderer.distance += dt*2.0;
    renderer.pitch = renderer.pitch.clip(0.05,1.35); renderer.distance = renderer.distance.clip(2.2,45.0);
    if (viewer_mode) {
        if (episode.done && replay_ms == 0) {
            if (!train_mode || reported_revision != viewer_revision) {
                let result = episode.result();
                $println("Fitness: " + result.fitness.format_decimals(3)
                    + " | forward: " + result.progress.format_decimals(3) + " m"
                    + " | time: " + result.seconds.format_decimals(3) + " s"
                    + " | fell: " + result.fell.to_s());
                reported_revision = viewer_revision;
            }
            replay_ms = $time_current_ms()+1200;
        }
        if (!paused && episode.done && $time_current_ms() >= replay_ms) {
            episode = PolicyEpisode(controller,seed,EPISODE_SECONDS);
            sim = episode.sim;
            renderer.target.z = 0.0;
            accumulator = 0.0;
            replay_ms = 0;
        }
        if (!paused && !episode.done) {
            accumulator += dt;
            while (accumulator >= STEP && !episode.done) {
                episode.step(); accumulator -= STEP;
            }
        }
        if ((sim.pelvis.p.z-renderer.target.z).abs() > 0.75) renderer.target.z = sim.pelvis.p.z;
    } else if (!paused) {
        accumulator += dt;
        while (accumulator >= STEP) { sim.step(); accumulator -= STEP; }
    }
    sim.render(renderer); $window_draw_frame(window,renderer.image.bytes);
    let remaining = 16-($time_current_ms()-start);
    if (remaining > 0) $actor_sleep(remaining);
}
if (train_mode) {
    $println("Stopping training...");
    $println("Training stopped after " + stop_training(training).comma_sep() + " generations across all islands");
}
