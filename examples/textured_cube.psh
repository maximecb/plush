// Rotating texture-mapped cube
//
// Draws a crate spinning in perspective at 800x600, with nearest-neighbor
// texture sampling and directional lighting. The rasterizer is the one from
// benchmarks/raster_tex.psh: affine mapping, with u and v interpolated in
// fixed point and packed into one integer so that a single add steps both.
//
// Usage: plush examples/textured_cube.psh

let FRAME_WIDTH = 800;
let FRAME_HEIGHT = 600;
let BG_COLOR = 0xFF101418;

let TEX_PATH = "examples/wood_crate_128.tga";

// Power-of-two texture, so that wrapping is a bitwise and
let TEX_SHIFT = 7;
let TEX_SIZE = 1 << TEX_SHIFT;
let TEX_MASK = TEX_SIZE - 1;

// The span loop interpolates texture coordinates in fixed point, with u and v
// packed into the two halves of one integer so that a single add steps both:
//
//   bits 63..32: v, as 16.16 fixed point
//   bits 31..0:  u, as 16.16 fixed point
//
// Both halves are biased by 256 texels so that the u half never borrows from
// the v half when u steps backwards. The bias is a whole number of texture
// widths, so the wrap-around mask below removes it again.
//
// Integers in this VM are 62-bit fixnums, and going past that boxes the value
// and allocates, which would be ruinous in a per-pixel loop. The bias and the
// gradient limit below are both sized to keep the packed value well inside
// that range: the v half reaches about 2^25, so the packed value stays near
// 2^57.
let FP_BITS = 16;
let FP_ONE = 65536.0;
let FP_BIAS_F = 16777216.0;
let FP_LIMIT = 1024.0;

// Screen x is only meaningful inside the frame, so edge positions and the
// slopes that walk them are clipped to a few frame widths before going to
// fixed point. Anything past that is off screen and clamps to the border
// anyway, while leaving it unbounded lets an edge that is a hair off
// horizontal produce a slope big enough to leave the fixnum range.
let X_LIMIT = (4 * FRAME_WIDTH).to_f();

// Extracting the texel index from the packed value: shift each half down so
// that its integer part lands where the texture index wants it, then mask.
// The v mask keeps the fractional bits of v out of the row index.
let U_SHIFT = FP_BITS;
let U_MASK = TEX_MASK;
let V_SHIFT = 32 + FP_BITS - TEX_SHIFT;
let V_MASK = TEX_MASK << TEX_SHIFT;

// Camera. The cube never comes near the eye, so no near-plane clipping is
// needed: every projected vertex has a positive z.
let CAM_DIST = 5.0;
let FOCAL = 650.0;
let CENTER_X = FRAME_WIDTH / 2;
let CENTER_Y = FRAME_HEIGHT / 2;

// Each cube face is drawn as a grid of this many quads per side. Affine
// mapping is only correct per triangle, so subdividing the face keeps the
// perspective from visibly shearing across it.
let SUBDIV = 4;
let GRID_PITCH = SUBDIV + 1;

// Directional lighting is baked into copies of the texture, one per shade
// level, so that the span loop stays a plain texel copy. The levels cover
// only the range the lighting actually produces, from fully shadowed to
// fully lit, so none of them go to waste. Faces are flat shaded, which means
// a level is a visible step: too few and a face jumps from one shade to the
// next as the cube turns.
let NUM_SHADES = 64;
let AMBIENT = 0.35;

class Vec3 {
    init(self, x, y, z) {
        self.x = x;
        self.y = y;
        self.z = z;
    }
}

// Screen position and texture coordinates of one vertex. The texture
// coordinates are in texels, not normalized.
class Vertex {
    init(self, x, y, u, v) {
        self.x = x;
        self.y = y;
        self.u = u;
        self.v = v;
    }
}

// --- Texture ---

// Reads an uncompressed 32-bit TGA. Its BGRA byte order is the pixel format
// the frame buffer uses, so the pixels only need to be copied out.
fun load_tga(path) {
    let data = $read_file(path);
    if (data == nil) {
        $println("could not read " + path);
        $exit(1);
    }

    let img_type = data[2];
    let width = data.load_u16(12);
    let height = data.load_u16(14);
    let bpp = data[16];
    let top_down = (data[17] & 0x20) != 0;
    let start = 18 + data[0];

    if (img_type != 2 || bpp != 32) {
        $println(path + ": expected an uncompressed 32-bit TGA");
        $exit(1);
    }

    let pixels = ByteArray.with_size(width * height * 4);
    let pitch = width * 4;
    if (top_down) {
        pixels.memcpy(0, data, start, height * pitch);
    } else {
        for (let var y = 0; y < height; ++y) {
            pixels.memcpy(y * pitch, data, start + (height - 1 - y) * pitch, pitch);
        }
    }

    return [pixels, width, height];
}

// One darkened copy of the texture per shade level. Lighting a face is then
// picking a texture, instead of blending every pixel it covers. Level s
// stands for a diffuse term of s / (NUM_SHADES - 1), so level 0 is a face
// facing away from the light and the last level one facing straight at it.
fun make_shade_table(tex) {
    let num_texels = TEX_SIZE * TEX_SIZE;
    let table = [];

    for (let var s = 0; s < NUM_SHADES; ++s) {
        let scale = AMBIENT + (1.0 - AMBIENT) * (s / (NUM_SHADES - 1));

        // Scaling the 256 possible channel values once beats doing the same
        // multiply for every texel
        let ramp = [];
        for (let var c = 0; c < 256; ++c) ramp.push((c.to_f() * scale).floor());

        let shaded = ByteArray.with_size(num_texels * 4);
        for (let var i = 0; i < num_texels; ++i) {
            let p = tex.get_u32(i);
            shaded.set_u32(i, 0xFF000000
                | (ramp[(p >> 16) & 0xFF] << 16)
                | (ramp[(p >> 8) & 0xFF] << 8)
                | ramp[p & 0xFF]);
        }

        table.push(shaded);
    }

    return table;
}

let tga = load_tga(TEX_PATH);
if (tga[1] != TEX_SIZE || tga[2] != TEX_SIZE) {
    $println(TEX_PATH + ": expected a " + TEX_SIZE.to_s() + "x" + TEX_SIZE.to_s() + " texture");
    $exit(1);
}
let shade_table = make_shade_table(tga[0]);

// --- Rasterization ---

// This function expects the coordinates to be floats such that
// x is in [0, FRAME_WIDTH] and +x points right
// y is in [0, FRAME_HEIGHT] and +y points down
//
// Texture coordinates are in texels and wrap around the texture.
fun rasterize_tri_tex(v0, v1, v2, fb, tex) {
    let var p0 = v0;
    let var p1 = v1;
    let var p2 = v2;
    if (p0.y > p1.y) { let tmp = p0; p0 = p1; p1 = tmp; }
    if (p0.y > p2.y) { let tmp = p0; p0 = p2; p2 = tmp; }
    if (p1.y > p2.y) { let tmp = p1; p1 = p2; p2 = tmp; }

    let py0 = p0.y;
    let py1 = p1.y;
    let py2 = p2.y;

    let y0 = py0.floor();
    let y1 = py1.floor();
    let y2 = py2.floor();

    if (y0 == y2) return;

    let x0 = p0.x;
    let x1 = p1.x;
    let x2 = p2.x;

    // Texture gradients. With no perspective, u and v are affine in screen
    // space, so these hold for the whole triangle.
    let e1x = x1 - x0; let e1y = py1 - py0;
    let e2x = x2 - x0; let e2y = py2 - py0;
    let det = e1x * e2y - e2x * e1y;
    if (det == 0.0) return;
    let inv_det = 1.0 / det;

    let u0 = p0.u; let e1u = p1.u - u0; let e2u = p2.u - u0;
    let v0t = p0.v; let e1v = p1.v - v0t; let e2v = p2.v - v0t;

    let dudx = (e1u * e2y - e2u * e1y) * inv_det;
    let dudy = (e2u * e1x - e1u * e2x) * inv_det;
    let dvdx = (e1v * e2y - e2v * e1y) * inv_det;
    let dvdy = (e2v * e1x - e1v * e2x) * inv_det;

    // Past this many texels per pixel the packed step leaves the fixnum range.
    // Only a sliver a small fraction of a pixel wide gets there, and skipping
    // it costs nothing visible.
    if (dudx.abs() >= FP_LIMIT || dvdx.abs() >= FP_LIMIT) return;
    if (dudy.abs() >= FP_LIMIT || dvdy.abs() >= FP_LIMIT) return;

    // The x gradient, packed: dt steps the span one pixel right. It carries no
    // bias, so it can be negative and still add correctly, the packed value
    // being just an integer.
    let dt = ((dvdx * FP_ONE).floor() << 32) + (dudx * FP_ONE).floor();

    // The gradients again, pre-scaled to fixed point, for stepping the span
    // start from one scanline to the next
    let dudx_fx = dudx * FP_ONE;
    let dudy_fx = dudy * FP_ONE;
    let dvdx_fx = dvdx * FP_ONE;
    let dvdy_fx = dvdy * FP_ONE;

    // The edges are walked in 16.16 fixed point as well, so that a scanline
    // start is a shift rather than a call to floor()
    let var inv_slope1 = 0.0;
    if (py1 > py0) inv_slope1 = (x1 - x0) / (py1 - py0);
    let slope1_fx = (inv_slope1.clip(-X_LIMIT, X_LIMIT) * FP_ONE).floor();

    let var inv_slope2 = 0.0;
    if (py2 > py0) inv_slope2 = (x2 - x0) / (py2 - py0);
    let slope2_fx = (inv_slope2.clip(-X_LIMIT, X_LIMIT) * FP_ONE).floor();

    let start_scanline_y_top = y0.max(0);
    let end_scanline_y_top = y1.min(FRAME_HEIGHT);

    // Top half of triangle
    if (start_scanline_y_top < end_scanline_y_top) {
        let dy = start_scanline_y_top + 1 - py0;
        let xa = ((x0 + dy * inv_slope1).clip(-X_LIMIT, X_LIMIT) * FP_ONE).floor();
        let xb = ((x0 + dy * inv_slope2).clip(-X_LIMIT, X_LIMIT) * FP_ONE).floor();

        // Both edges radiate from p0, so which of the two is the left one is
        // fixed for the whole half and the winding decides it: a positive
        // determinant puts p1 right of p0p2, making the edge to p2 the left
        // one. Comparing the two edge positions instead would tie whenever
        // they are still less than a fixed-point step apart, just below p0,
        // and drop the whole half by walking the edges crossed over.
        let var cur_xl = xa; let var slope_l = slope1_fx;
        let var cur_xr = xb; let var slope_r = slope2_fx;
        if (det > 0.0) {
            cur_xl = xb; slope_l = slope2_fx;
            cur_xr = xa; slope_r = slope1_fx;
        }

        // Texture coordinates at x = 0 of the current scanline, pre-scaled and
        // biased. These stay floats: at x = 0 the value can sit far outside
        // the triangle, which a float carries without losing the precision
        // that matters once a span start brings it back inside.
        let y_off = start_scanline_y_top + 0.5 - py0;
        let var u_row_fx = (u0 + (0.5 - x0) * dudx + y_off * dudy) * FP_ONE + FP_BIAS_F;
        let var v_row_fx = (v0t + (0.5 - x0) * dvdx + y_off * dvdy) * FP_ONE + FP_BIAS_F;
        let var row = start_scanline_y_top * FRAME_WIDTH;
        let end_row = end_scanline_y_top * FRAME_WIDTH;

        while (row < end_row) {
            // Clamping with a branch rather than min/max, which are method
            // calls, and the branch is almost never taken
            let var start_x = cur_xl >> FP_BITS;
            if (start_x < 0) start_x = 0;
            let var end_x = cur_xr >> FP_BITS;
            if (end_x > FRAME_WIDTH) end_x = FRAME_WIDTH;
            if (start_x < end_x) {
                // Packed at the span start, which is always inside the
                // triangle, so both halves of the value stay small
                let var t = ((v_row_fx + start_x * dvdx_fx).floor() << 32)
                          + (u_row_fx + start_x * dudx_fx).floor();
                let var i = row + start_x;
                let end_i = row + end_x;
                while (i < end_i) {
                    fb.set_u32(i, tex.get_u32(((t >> V_SHIFT) & V_MASK) | ((t >> U_SHIFT) & U_MASK)));
                    t = t + dt;
                    ++i;
                }
            }
            cur_xl = cur_xl + slope_l;
            cur_xr = cur_xr + slope_r;
            u_row_fx = u_row_fx + dudy_fx;
            v_row_fx = v_row_fx + dvdy_fx;
            row = row + FRAME_WIDTH;
        }
    }

    let var inv_slope3 = 0.0;
    if (py2 > py1) inv_slope3 = (x2 - x1) / (py2 - py1);
    let slope3_fx = (inv_slope3.clip(-X_LIMIT, X_LIMIT) * FP_ONE).floor();

    let start_scanline_y_bot = y1.max(0);
    let end_scanline_y_bot = y2.min(FRAME_HEIGHT);

    // Bottom half of triangle
    if (start_scanline_y_bot < end_scanline_y_bot) {
        let xa = ((x1 + (start_scanline_y_bot + 1 - py1) * inv_slope3).clip(-X_LIMIT, X_LIMIT) * FP_ONE).floor();
        let xb = ((x0 + (start_scanline_y_bot + 1 - py0) * inv_slope2).clip(-X_LIMIT, X_LIMIT) * FP_ONE).floor();

        // Both edges converge on p2, so the left/right order is fixed here
        // too, and the same determinant decides it
        let var cur_xl = xa; let var slope_l = slope3_fx;
        let var cur_xr = xb; let var slope_r = slope2_fx;
        if (det > 0.0) {
            cur_xl = xb; slope_l = slope2_fx;
            cur_xr = xa; slope_r = slope3_fx;
        }

        // Texture coordinates at x = 0 of the current scanline, pre-scaled and
        // biased. These stay floats: at x = 0 the value can sit far outside
        // the triangle, which a float carries without losing the precision
        // that matters once a span start brings it back inside.
        let y_off = start_scanline_y_bot + 0.5 - py0;
        let var u_row_fx = (u0 + (0.5 - x0) * dudx + y_off * dudy) * FP_ONE + FP_BIAS_F;
        let var v_row_fx = (v0t + (0.5 - x0) * dvdx + y_off * dvdy) * FP_ONE + FP_BIAS_F;
        let var row = start_scanline_y_bot * FRAME_WIDTH;
        let end_row = end_scanline_y_bot * FRAME_WIDTH;

        while (row < end_row) {
            let var start_x = cur_xl >> FP_BITS;
            if (start_x < 0) start_x = 0;
            let var end_x = cur_xr >> FP_BITS;
            if (end_x > FRAME_WIDTH) end_x = FRAME_WIDTH;
            if (start_x < end_x) {
                // Packed at the span start, which is always inside the
                // triangle, so both halves of the value stay small
                let var t = ((v_row_fx + start_x * dvdx_fx).floor() << 32)
                          + (u_row_fx + start_x * dudx_fx).floor();
                let var i = row + start_x;
                let end_i = row + end_x;
                while (i < end_i) {
                    fb.set_u32(i, tex.get_u32(((t >> V_SHIFT) & V_MASK) | ((t >> U_SHIFT) & U_MASK)));
                    t = t + dt;
                    ++i;
                }
            }
            cur_xl = cur_xl + slope_l;
            cur_xr = cur_xr + slope_r;
            u_row_fx = u_row_fx + dudy_fx;
            v_row_fx = v_row_fx + dvdy_fx;
            row = row + FRAME_WIDTH;
        }
    }
}

// --- Cube ---

// Corners of the cube: 0..3 are the front face, 4..7 the back one
let corners = [
    Vec3(-1.0,  1.0, -1.0),
    Vec3( 1.0,  1.0, -1.0),
    Vec3( 1.0, -1.0, -1.0),
    Vec3(-1.0, -1.0, -1.0),
    Vec3(-1.0,  1.0,  1.0),
    Vec3( 1.0,  1.0,  1.0),
    Vec3( 1.0, -1.0,  1.0),
    Vec3(-1.0, -1.0,  1.0)
];

// Each face lists its corners starting at the one the texture's top left
// lands on and running around the face, so the crate is upright on all six
let faces = [
    [0, 1, 2, 3],   // front
    [5, 4, 7, 6],   // back
    [1, 5, 6, 2],   // right
    [4, 0, 3, 7],   // left
    [4, 5, 1, 0],   // top
    [3, 2, 6, 7]    // bottom
];

let normals = [
    Vec3( 0.0,  0.0, -1.0),
    Vec3( 0.0,  0.0,  1.0),
    Vec3( 1.0,  0.0,  0.0),
    Vec3(-1.0,  0.0,  0.0),
    Vec3( 0.0,  1.0,  0.0),
    Vec3( 0.0, -1.0,  0.0)
];

// Direction from a surface towards the light, normalized
let LIGHT_X = -0.357;
let LIGHT_Y = 0.625;
let LIGHT_Z = -0.694;

// Corners and normals rotated into view space, refilled every frame
let view = [];
let view_normals = [];
for (let var i = 0; i < 8; ++i) view.push(Vec3(0.0, 0.0, 0.0));
for (let var i = 0; i < 6; ++i) view_normals.push(Vec3(0.0, 0.0, 0.0));

// Projected vertices of the face being drawn. Reused so that drawing a
// frame allocates nothing.
let grid = [];
for (let var i = 0; i < GRID_PITCH * GRID_PITCH; ++i) grid.push(Vertex(0.0, 0.0, 0.0, 0.0));

// Rotate a point by yaw then pitch, and move it away from the eye
fun to_view(p, dst, sy, cy, sp, cp) {
    let x = p.x * cy + p.z * sy;
    let z = p.z * cy - p.x * sy;
    dst.x = x;
    dst.y = p.y * cp - z * sp;
    dst.z = z * cp + p.y * sp;
}

// Split a face into SUBDIV x SUBDIV quads, project their corners, and draw
// each quad as two triangles. The subdivision happens in view space, before
// the projection, which is what keeps the mapping true in perspective.
fun draw_face(face, fb, tex) {
    let c0 = view[face[0]];
    let c1 = view[face[1]];
    let c2 = view[face[2]];
    let c3 = view[face[3]];

    for (let var r = 0; r < GRID_PITCH; ++r) {
        let tr = r / SUBDIV;

        // Ends of this row of the grid, on the two side edges of the face
        let lx = c0.x + (c3.x - c0.x) * tr;
        let ly = c0.y + (c3.y - c0.y) * tr;
        let lz = c0.z + (c3.z - c0.z) * tr;
        let rx = c1.x + (c2.x - c1.x) * tr;
        let ry = c1.y + (c2.y - c1.y) * tr;
        let rz = c1.z + (c2.z - c1.z) * tr;

        let row = r * GRID_PITCH;
        for (let var c = 0; c < GRID_PITCH; ++c) {
            let tc = c / SUBDIV;
            let z = lz + (rz - lz) * tc;
            let inv_z = FOCAL / z;

            let vert = grid[row + c];
            vert.x = CENTER_X + (lx + (rx - lx) * tc) * inv_z;
            vert.y = CENTER_Y - (ly + (ry - ly) * tc) * inv_z;
            vert.u = tc * TEX_SIZE;
            vert.v = tr * TEX_SIZE;
        }
    }

    for (let var r = 0; r < SUBDIV; ++r) {
        let top = r * GRID_PITCH;
        let bot = top + GRID_PITCH;
        for (let var c = 0; c < SUBDIV; ++c) {
            let v00 = grid[top + c];
            let v10 = grid[top + c + 1];
            let v11 = grid[bot + c + 1];
            let v01 = grid[bot + c];
            rasterize_tri_tex(v00, v10, v11, fb, tex);
            rasterize_tri_tex(v00, v11, v01, fb, tex);
        }
    }
}

// --- Rendering ---

let frame_buffer = ByteArray.with_size(FRAME_WIDTH * FRAME_HEIGHT * 4);
let window = $window_create(FRAME_WIDTH, FRAME_HEIGHT, "Rotating textured cube", 0);

// Rendering is timed on its own, without the wait for vsync that
// $window_draw_frame ends a frame with, and averaged over each report
let start_ms = $time_current_ms();
let var frame_count = 0;
let var render_ms_total = 0;
let var last_report_ms = start_ms;

loop {
    let now_ms = $time_current_ms();
    let time_s = (now_ms - start_ms).to_f() * 0.001;

    let yaw = time_s * 0.7;
    let pitch = time_s * 0.43;
    let sy = yaw.sin(); let cy = yaw.cos();
    let sp = pitch.sin(); let cp = pitch.cos();

    for (let var i = 0; i < 8; ++i) {
        to_view(corners[i], view[i], sy, cy, sp, cp);
        view[i].z = view[i].z + CAM_DIST;
    }
    for (let var i = 0; i < 6; ++i) {
        to_view(normals[i], view_normals[i], sy, cy, sp, cp);
    }

    frame_buffer.fill_u32(0, FRAME_WIDTH * FRAME_HEIGHT, BG_COLOR);

    for (let var f = 0; f < 6; ++f) {
        let face = faces[f];
        let n = view_normals[f];
        let c = view[face[0]];

        // The cube is convex, so culling the faces pointing away from the eye
        // is all the visibility it needs, with no depth buffer
        if (n.x * c.x + n.y * c.y + n.z * c.z >= 0.0) continue;

        // Diffuse term, straight to the nearest shade level
        let lit = (n.x * LIGHT_X + n.y * LIGHT_Y + n.z * LIGHT_Z).max(0.0);
        let var shade = (lit * (NUM_SHADES - 1) + 0.5).floor();
        if (shade >= NUM_SHADES) shade = NUM_SHADES - 1;

        draw_face(face, frame_buffer, shade_table[shade]);
    }

    render_ms_total = render_ms_total + ($time_current_ms() - now_ms);

    $window_draw_frame(window, frame_buffer);

    ++frame_count;
    if (now_ms - last_report_ms >= 1000) {
        let render_ms = render_ms_total.to_f() / frame_count.to_f();
        let fps = 1000.0 / render_ms.max(0.001);
        $println("render: " + render_ms.format_decimals(1) + "ms (" + fps.format_decimals(1) + " fps)");
        frame_count = 0;
        render_ms_total = 0;
        last_report_ms = now_ms;
    }

    let msg = $actor_poll();
    if (msg == nil) continue;
    if (!(msg instanceof UIEvent)) continue;
    if (msg.kind == 'CLOSE_WINDOW') break;
    if (msg.kind == 'KEY_DOWN' && (msg.key == 'ESCAPE' || msg.key == 'Q')) break;
}
