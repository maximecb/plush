// The greyscale image with its data split over four chunks, one of them
// empty, and with other kinds of chunks before and among them
let PNG_SPLIT = #[\x
    89 50 4E 47 0D 0A 1A 0A 00 00 00 0D 49 48 44 52 00 00 00 15 00 00 00 0C
    08 00 00 00 00 A8 A5 A9 19 00 00 00 04 67 41 4D 41 00 00 B1 8F 0B FC 61
    05 00 00 00 07 49 44 41 54 78 DA 63 62 50 F5 CA 14 0F 58 D2 00 00 00 00
    49 44 41 54 35 AF 06 1E 00 00 00 03 74 45 58 74 6B 00 76 CB 04 F3 90 00
    00 00 21 49 44 41 54 9F B2 F3 1E B3 86 6F D1 F4 3D 0F D9 B4 03 4A 67 ED
    7F C2 9C EA EA E6 E6 EE 76 DC DD C3 DD C3 E3 E4 4E 86 F9 67 00 00 00 92
    49 44 41 54 09 4F 4F 2F 4F AF 53 A7 59 52 D5 80 20 03 44 A8 65 83 49 B5
    3C 35 35 06 FD D0 9A 45 1A C8 60 EF 13 2E 43 C6 29 EA EA EA F2 0C 48 80
    19 28 C0 94 9A 9A 96 86 2C C8 90 9B 97 97 CF FC C8 DD DD 63 25 B2 E8 B2
    D3 67 7C 58 52 35 34 35 50 D5 6A 6A 68 32 68 04 56 2D 46 B1 ED 21 97 71
    0C 63 AF A6 16 26 64 02 5A 96 9E 9E 91 91 99 99 95 95 9D 9D 93 93 0B B2
    2C 9F F9 9E 87 A7 87 E7 C9 53 9E 5E 5E DE A7 4E 7B FB 78 FB F8 9C F5 F1
    05 00 28 19 42 12 6B 74 B8 46 00 00 00 00 49 45 4E 44 AE 42 60 82
];

let WIDTH = 21;
let HEIGHT = 12;

// The value of a channel of a pixel in the images above. There is a
// flat area in the middle, and values with no pattern around it.
fun sample(x, y, c)
{
    if (x >= 4 && x < 17 && y >= 3 && y < 9) {
        return 40 * (c + 1);
    }

    return (x * 37 + y * 101 + c * 59 + ((x * y) >> 1)) & 255;
}

// Decodes an image and checks every pixel against a function that
// gives the expected color
fun check(data, color_fn)
{
    let img = decode_png(data);
    assert(img != nil);
    assert(img.width == WIDTH);
    assert(img.height == HEIGHT);

    for (let var y = 0; y < HEIGHT; ++y) {
        for (let var x = 0; x < WIDTH; ++x) {
            assert(img.get_pixel(x, y) == color_fn(x, y));
        }
    }
}

// The color of an entry of the palette image's palette
fun palette_color(idx)
{
    let alpha = idx < 10 ? idx * 20 : 255;
    return rgba(idx * 5, 255 - idx * 3, (idx * idx) & 255, alpha);
}

fun grey(x, y)
{
    let v = sample(x, y, 0);
    return rgb(v, v, v);
}

fun grey_alpha(x, y)
{
    let v = sample(x, y, 0);
    return rgba(v, v, v, sample(x, y, 1));
}

check(PNG_GREY, grey);
check(PNG_SPLIT, grey);
check(PNG_GREY_ALPHA, grey_alpha);
check(PNG_RGB, |x, y| rgb(sample(x, y, 0), sample(x, y, 1), sample(x, y, 2)));
check(PNG_RGBA, |x, y| rgba(sample(x, y, 0), sample(x, y, 1), sample(x, y, 2), sample(x, y, 3)));
check(PNG_PALETTE, |x, y| palette_color(sample(x, y, 0) % 40));

// Appends a big-endian 32-bit integer
fun push_u32_be(out, val)
{
    out.push_u8((val >> 24) & 255);
    out.push_u8((val >> 16) & 255);
    out.push_u8((val >> 8) & 255);
    out.push_u8(val & 255);
}

// Appends a chunk. The checksum is left as zero, the decoder ignores it.
fun push_chunk(out, kind, body)
{
    push_u32_be(out, body.len);
    out.push_string(kind);

    let pos = out.len;
    out.resize(pos + body.len);
    out.memcpy(pos, body, 0, body.len);
    out.push_u32(0);
}

// Builds a PNG file with a given header, around the bytes of filtered
// rows. These are stored without compression, which takes no encoder.
fun make_png(width, height, depth, color_type, interlace, raw)
{
    let out = #[\x 89 50 4E 47 0D 0A 1A 0A];

    let header = ByteArray.with_size(0);
    push_u32_be(header, width);
    push_u32_be(header, height);
    header.push_u8(depth);
    header.push_u8(color_type);
    header.push_u8(0);
    header.push_u8(0);
    header.push_u8(interlace);
    push_chunk(out, "IHDR", header);

    // A zlib header, one stored block, and a checksum left as zero
    let idat = #[\x 78 01 01];
    idat.push_u16(raw.len);
    idat.push_u16(raw.len ^ 0xFFFF);
    let pos = idat.len;
    idat.resize(pos + raw.len);
    idat.memcpy(pos, raw, 0, raw.len);
    idat.push_u32(0);
    push_chunk(out, "IDAT", idat);

    push_chunk(out, "IEND", ByteArray.with_size(0));
    return out;
}

// A 2 by 2 greyscale image, to check that make_png() works
let small = decode_png(make_png(2, 2, 8, 0, 0, #[\x 00 0A 14 00 1E 28]));
assert(small.width == 2);
assert(small.height == 2);
assert(small.get_pixel(0, 0) == rgb(10, 10, 10));
assert(small.get_pixel(1, 0) == rgb(20, 20, 20));
assert(small.get_pixel(0, 1) == rgb(30, 30, 30));
assert(small.get_pixel(1, 1) == rgb(40, 40, 40));

// A single pixel
let pixel = decode_png(make_png(1, 1, 8, 6, 0, #[\x 00 01 02 03 04]));
assert(pixel.get_pixel(0, 0) == rgba(1, 2, 3, 4));

// Filter types that don't exist
assert(decode_png(make_png(2, 2, 8, 0, 0, #[\x 05 0A 14 00 1E 28])) == nil);
assert(decode_png(make_png(2, 2, 8, 0, 0, #[\x 00 0A 14 FF 1E 28])) == nil);

// Too few rows and too many
assert(decode_png(make_png(2, 2, 8, 0, 0, #[\x 00 0A 14 00 1E])) == nil);
assert(decode_png(make_png(2, 2, 8, 0, 0, #[\x 00 0A 14 00 1E 28 00])) == nil);
assert(decode_png(make_png(2, 2, 8, 0, 0, ByteArray.with_size(0))) == nil);

// Formats that are not supported: other bit depths and interlacing
assert(decode_png(make_png(2, 2, 16, 0, 0, #[\x 00 0A 14 00 1E 28])) == nil);
assert(decode_png(make_png(2, 2, 4, 0, 0, #[\x 00 0A 00 1E])) == nil);
assert(decode_png(make_png(2, 2, 8, 0, 1, #[\x 00 0A 14 00 1E 28])) == nil);

// Color types that don't exist
assert(decode_png(make_png(2, 2, 8, 1, 0, #[\x 00 0A 14 00 1E 28])) == nil);
assert(decode_png(make_png(2, 2, 8, 5, 0, #[\x 00 0A 14 00 1E 28])) == nil);
assert(decode_png(make_png(2, 2, 8, 7, 0, #[\x 00 0A 14 00 1E 28])) == nil);

// A palette image with no palette
assert(decode_png(make_png(2, 2, 8, 3, 0, #[\x 00 0A 14 00 1E 28])) == nil);

// Empty sizes
assert(decode_png(make_png(0, 2, 8, 0, 0, #[\x 00 00])) == nil);
assert(decode_png(make_png(2, 0, 8, 0, 0, ByteArray.with_size(0))) == nil);

// Enormous sizes, which must fail without allocating or overflowing
assert(decode_png(make_png(60000, 60000, 8, 6, 0, #[\x 00 0A 14 00 1E 28])) == nil);
assert(decode_png(make_png(0xFFFFFFFF, 0xFFFFFFFF, 8, 6, 0, #[\x 00 0A 14 00 1E 28])) == nil);
assert(decode_png(make_png(1, 0xFFFFFFFF, 8, 0, 0, #[\x 00 0A 14 00 1E 28])) == nil);

// Not a PNG file
assert(decode_png(ByteArray.with_size(0)) == nil);
assert(decode_png(ByteArray.with_size(100)) == nil);

// A file cut short anywhere
for (let var count = 0; count < PNG_GREY.len; ++count) {
    let part = ByteArray.with_size(count);
    part.memcpy(0, PNG_GREY, 0, count);
    assert(decode_png(part) == nil);
}
