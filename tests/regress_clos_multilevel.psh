// Variables captured across multiple closure levels retain their values.
fun make_reader()
{
    let a = 3;
    return || {
        return |n| { return a + n; };
    };
}

let reader = make_reader()();
assert(reader(4) == 7);

fun make_deep_reader(x)
{
    return || {
        let y = 5;
        return || {
            return || { return x + y; };
        };
    };
}

assert(make_deep_reader(2)()()() == 7);

// Mutable captures share the same cell across closure levels.
fun make_counter()
{
    let var count = 0;
    return || {
        return || {
            count = count + 1;
            return count;
        };
    };
}

let counter = make_counter()();
assert(counter() == 1);
assert(counter() == 2);
