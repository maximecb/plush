// Mono at 16000 Hz, 8 frames with one granule each, and nothing that
// tells the delay of the encoder
let MP3_MONO = #[\x
    FF F3 28 C4 00 0C B0 06 E5 1F 41 18 02 E1 39 6E FF FF C0 03 07 C1 F3 E5
    01 F0 7C 1F 3E 88 20 08 47 83 E0 F8 3F 50 20 EC B8 7F 94 DD CB F4 86 38
    0D FA 41 0E 03 3F A4 10 E0 33 FA 43 1C BF BB A5 52 A4 01 69 4E FE 01 31
    FF F3 28 C4 08 0E C8 B6 A0 01 9B 50 00 B1 C0 25 AC 40 0C B8 8B 06 39 A4
    6D A0 06 02 04 46 14 D0 0D 0C 09 F9 00 D0 19 01 5F C5 61 14 22 88 7F C7
    A3 D2 21 F0 FB E5 41 51 11 EF AC 15 11 1E FE 0A AA E5 76 B2 EC AE 43 01
    FF F3 28 C4 07 0D 90 5A 48 01 DE 00 00 90 30 0B 89 D1 82 B8 63 18 76 82
    E1 85 F8 E1 19 25 8F 71 F5 B8 67 99 93 0E 89 83 40 1A 18 0D 80 D1 81 F8
    1C 01 80 2C C0 18 01 CB 8C D7 DA 6F 2A D6 EE 47 D9 E0 E8 02 66 02 A8 65
    FF F3 28 C4 0B 0D E9 46 2C 00 FF 04 68 E0 80 0C 04 00 07 87 00 B2 60 5A
    80 C2 72 52 16 5A 7F D0 F8 43 40 58 96 34 14 44 75 34 70 22 75 3F FF DF
    FF FF FF FF FF E0 BF FF FF 55 DE AB C7 19 F8 A0 02 46 04 50 63 06 00 58
    FF F3 28 C4 0E 0F 81 4A 2C 00 FF 04 68 05 E5 50 02 83 80 4B 30 2B 80 A4
    38 F0 D0 4C 3F 70 F0 CC A0 50 82 20 90 4D 0A 14 DD AD C3 15 FF FF D7 FF
    FF FF FF FF E1 FF FF FF FF FF FF FF EA AF 24 77 26 C4 20 1E 60 62 06 A6
    FF F3 28 C4 0B 0E 48 56 48 01 5E 00 00 07 E2 46 60 D6 1D E6 21 61 3E 62
    08 3D 06 55 C4 EC 7C 2D 29 A6 6E A5 7E 62 DA 0B A9 F4 60 54 08 C6 05 40
    08 5D 05 6C 4B C5 F9 FF FF FF F4 2A ED 84 14 46 77 49 E6 51 00 65 81 83
    FF F3 28 C4 0C 0E D0 CA A8 01 9B 58 00 81 99 D9 82 36 B2 94 96 8F 98 C0
    78 F0 1C 00 F1 FE 01 E2 20 80 29 26 95 7F 8E C3 12 F3 78 73 67 FF 50 E3
    24 FB 58 3F 8B 04 04 FF AD 0C 7F FA 2A 45 0B 70 6A 85 C9 0A 86 5F 44 94
    FF F3 28 C4 0B 0C 70 7D F0 01 CF 10 01 4C 4F 90 2E 81 85 00 1C 40 66 0E
    A4 98 84 99 50 D5 AA D7 B1 70 F9 F3 06 02 02 1B 14 5C 50 5E 05 70 28 EE
    9B D0 5F CA 4C 41 4D 45 33 2E 31 30 30 AA AA AA AA AA AA AA AA AA AA AA
];

let PI = 3.141592653589793;

// Largest difference to accept between a sample and its source, as the
// encoding is lossy
let TOLERANCE = 0.05;

// Samples at both ends that are left out of comparisons with the source,
// where the encoder and the filters of the decoder ring
let EDGE = 600;

// Delay in samples of the mono clip, which isn't trimmed
let MONO_DELAY = 1105;

// Value at a time in seconds of a tone of the source clips: 441 and 1260
// Hz for the two channels of the stereo one, and 320 Hz for the mono one
fun source(freq, level, time)
{
    return level * (2 * PI * freq * time).sin();
}

// Reads all the samples of a decoder from its start, count at a time
fun read_all(dec, count)
{
    let out = ByteArray.with_size(dec.num_samples * dec.num_channels * 4);
    let var pos = 0;

    dec.seek(0);
    loop {
        let num = dec.read(out, pos * dec.num_channels, count);
        if (num == 0) {
            break;
        }

        assert(num <= count);
        pos += num;
        assert(dec.pos == pos);
    }

    assert(pos == dec.num_samples);
    return out;
}

// Tells whether two runs of f32 values are the same
fun same(a, a_idx, b, b_idx, count)
{
    for (let var i = 0; i < count; ++i) {
        if (a.get_f32(a_idx + i) != b.get_f32(b_idx + i)) {
            return false;
        }
    }

    return true;
}

// Checks the samples of the stereo clip, in the format of a decoder,
// against the source
fun check_stereo(dec, samples)
{
    let num_channels = dec.num_channels;

    for (let var i = EDGE; i < dec.num_samples - EDGE; ++i) {
        let time = i / dec.sample_rate;
        let left = source(441, 0.5, time);
        let right = source(1260, 0.3, time);

        if (num_channels == 2) {
            assert((samples.get_f32(2 * i) - left).abs() < TOLERANCE);
            assert((samples.get_f32(2 * i + 1) - right).abs() < TOLERANCE);
        } else {
            assert((samples.get_f32(i) - (left + right) / 2).abs() < TOLERANCE);
        }
    }
}

// Checks that seeking gives the same samples as reading through
fun check_seeks(dec, samples)
{
    let num_channels = dec.num_channels;
    let buf = ByteArray.with_size(1500 * num_channels * 4);

    for (let var pos = 0; pos <= dec.num_samples; pos += 397) {
        dec.seek(pos);
        assert(dec.pos == pos);

        let num = dec.read(buf, 0, 1500);
        assert(num == (dec.num_samples - pos).min(1500));
        assert(same(buf, 0, samples, pos * num_channels, num * num_channels));
    }

    // Positions past either end are brought back to it
    dec.seek(-5);
    assert(dec.pos == 0);
    dec.seek(dec.num_samples + 5);
    assert(dec.pos == dec.num_samples);
    assert(dec.read(buf, 0, 1500) == 0);
}

// The stereo clip has the length of its source, and starts with it
let stereo = MP3Decoder.from_bytes(MP3_STEREO);
assert(stereo != nil);
assert(stereo.sample_rate == 44100);
assert(stereo.num_channels == 2);
assert(stereo.num_samples == 4410);
assert(stereo.pos == 0);
assert(stereo.duration() == 0.1);

let stereo_samples = read_all(stereo, 1152);
check_stereo(stereo, stereo_samples);
check_seeks(stereo, stereo_samples);

// How many samples are read at a time makes no difference
assert(same(stereo_samples, 0, read_all(stereo, 1), 0, 2 * 4410));
assert(same(stereo_samples, 0, read_all(stereo, 777), 0, 2 * 4410));
assert(same(stereo_samples, 0, read_all(stereo, 10000), 0, 2 * 4410));

// Samples go where they are asked to, and nowhere else
let part = ByteArray.with_size(100 * 4);
stereo.seek(1000);
assert(stereo.read(part, 20, 30) == 30);
assert(same(part, 20, stereo_samples, 2000, 60));
for (let var i = 0; i < 100; ++i) {
    assert((i >= 20 && i < 80) || part.get_f32(i) == 0);
}

// Mono is the mean of the two channels
stereo.set_out_format(44100, 1);
assert(stereo.num_channels == 1);
assert(stereo.num_samples == 4410);
let mixed = read_all(stereo, 1000);
for (let var i = 0; i < 4410; ++i) {
    let mean = (stereo_samples.get_f32(2 * i) + stereo_samples.get_f32(2 * i + 1)) / 2;
    assert((mixed.get_f32(i) - mean).abs() < 0.000001);
}
check_seeks(stereo, mixed);

// Other sample rates, higher and lower, give the same tones
stereo.set_out_format(48000, 2);
assert(stereo.sample_rate == 48000);
assert(stereo.num_samples == 4800);
assert(stereo.duration() == 0.1);
let faster = read_all(stereo, 1000);
check_stereo(stereo, faster);
check_seeks(stereo, faster);
assert(same(faster, 0, read_all(stereo, 333), 0, 2 * 4800));

stereo.set_out_format(22050, 1);
assert(stereo.num_samples == 2205);
let slower = read_all(stereo, 1000);
check_stereo(stereo, slower);
check_seeks(stereo, slower);

// A change of format keeps the position in time
stereo.seek(1100);
stereo.set_out_format(44100, 2);
assert(stereo.pos == 2200);
stereo.seek(stereo.num_samples);
stereo.set_out_format(8000, 1);
assert(stereo.pos == stereo.num_samples);
assert(stereo.num_samples == 800);

// The mono clip has whole frames, and its source after the delay
let mono = MP3Decoder.from_bytes(MP3_MONO);
assert(mono != nil);
assert(mono.sample_rate == 16000);
assert(mono.num_channels == 1);
assert(mono.num_samples == 8 * 576);

let mono_samples = read_all(mono, 500);
for (let var i = MONO_DELAY + EDGE; i < MONO_DELAY + 3200 - EDGE; ++i) {
    let tone = source(320, 0.4, (i - MONO_DELAY) / 16000);
    assert((mono_samples.get_f32(i) - tone).abs() < TOLERANCE);
}
check_seeks(mono, mono_samples);

// Stereo from mono is the same samples twice
mono.set_out_format(16000, 2);
let doubled = read_all(mono, 500);
for (let var i = 0; i < mono.num_samples; ++i) {
    assert(doubled.get_f32(2 * i) == mono_samples.get_f32(i));
    assert(doubled.get_f32(2 * i + 1) == mono_samples.get_f32(i));
}

// Returns a copy of the first count bytes of some data
fun prefix(data, count)
{
    let out = ByteArray.with_size(count);
    out.memcpy(0, data, 0, count);
    return out;
}

// Returns some data with other data before and after it
fun wrap(before, data, after)
{
    let out = ByteArray.with_size(before.len + data.len + after.len);
    out.memcpy(0, before, 0, before.len);
    out.memcpy(before.len, data, 0, data.len);
    out.memcpy(before.len + data.len, after, 0, after.len);
    return out;
}

// Tags before and after the audio are skipped: an ID3v2 tag of 300 bytes
// that holds what looks like frames, and an ID3v1 tag
let id3v2 = ByteArray.with_size(310);
id3v2.memcpy(0, #[\x 49 44 33 04 00 00 00 00 02 2C], 0, 10);
id3v2.memcpy(10, MP3_MONO, 0, 300);
let id3v1 = ByteArray.with_size(128);
id3v1.memcpy(0, #[\aTAG], 0, 3);

let tagged = MP3Decoder.from_bytes(wrap(id3v2, MP3_STEREO, id3v1));
assert(tagged != nil);
assert(tagged.sample_rate == 44100);
assert(tagged.num_samples == 4410);
assert(same(read_all(tagged, 1152), 0, stereo_samples, 0, 2 * 4410));

// Bytes that are not audio between two frames are skipped too
let junk = ByteArray.with_size(57);
for (let var i = 0; i < junk.len; ++i) {
    junk[i] = (i * 37 + 11) & 0xFF;
}
let split = wrap(prefix(MP3_MONO, 216), junk, ByteArray.with_size(0));
let damaged = MP3Decoder.from_bytes(wrap(split, prefix(MP3_MONO, 576), ByteArray.with_size(0)));
assert(damaged != nil);
assert(damaged.num_samples == 11 * 576);

// Not MP3 data
assert(MP3Decoder.from_bytes(ByteArray.with_size(0)) == nil);
assert(MP3Decoder.from_bytes(ByteArray.with_size(1000)) == nil);
assert(MP3Decoder.from_bytes(junk) == nil);
assert(MP3Decoder.from_bytes(#[\x FF FB 60 44]) == nil);

// Decodes whatever a decoder gives, which must not fail
fun exercise(dec)
{
    if (dec == nil) {
        return;
    }

    let buf = ByteArray.with_size(700 * dec.num_channels * 4);
    let var total = 0;
    loop {
        let num = dec.read(buf, 0, 700);
        if (num == 0) {
            break;
        }
        total += num;
    }
    assert(total == dec.num_samples);

    dec.seek(dec.num_samples.idiv(2));
    dec.read(buf, 0, 700);
}

// Data cut short anywhere gives the frames that are whole
for (let var count = 0; count < MP3_MONO.len; ++count) {
    let dec = MP3Decoder.from_bytes(prefix(MP3_MONO, count));
    assert(dec == nil || dec.num_samples == count.idiv(72) * 576);
    exercise(dec);
}
for (let var count = 0; count < MP3_STEREO.len; count += 13) {
    exercise(MP3Decoder.from_bytes(prefix(MP3_STEREO, count)));
}

// A wrong byte anywhere may or may not yield samples, but must not
// make the decoder fail in some other way
fun corrupt(data, step)
{
    for (let var pos = 0; pos < data.len; pos += step) {
        let copy = prefix(data, data.len);
        copy[pos] = copy[pos] ^ 0xFF;
        exercise(MP3Decoder.from_bytes(copy));
    }
}

corrupt(MP3_MONO, 1);
corrupt(MP3_STEREO, 3);
