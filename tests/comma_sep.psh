assert((0).comma_sep() == "0");
assert((7).comma_sep() == "7");
assert((999).comma_sep() == "999");
assert((1000).comma_sep() == "1,000");
assert((1234).comma_sep() == "1,234");
assert((12345).comma_sep() == "12,345");
assert((123456).comma_sep() == "123,456");
assert((1000000).comma_sep() == "1,000,000");
assert((1234567890).comma_sep() == "1,234,567,890");

// Negative values keep the sign attached to the first digit group
assert((-1).comma_sep() == "-1");
assert((-999).comma_sep() == "-999");
assert((-1000).comma_sep() == "-1,000");
assert((-123456).comma_sep() == "-123,456");

let n = 9223372036854775807;
assert(n.comma_sep() == "9,223,372,036,854,775,807");
assert((-n - 1).comma_sep() == "-9,223,372,036,854,775,808");

// Works on a computed value, not just a literal
let var sum = 0;
for (let var i = 0; i < 1000; ++i)
    sum += i;
assert(sum.comma_sep() == "499,500");
