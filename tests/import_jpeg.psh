// Largest difference to accept between a channel and its expected value,
// as the encoder and the decoder each round values a few times
let TOLERANCE = 4;

// The channels of a pixel of the source images. Each is a gradient plus
// a pattern, which is the same for the three so that it has no color.
// The position may be a float.
fun pattern(x, y) { return ((x * 7 + y * 13) % 5) * 4; }
fun source_r(x, y) { return 30 + 7 * x; }
fun source_g(x, y) { return 20 + 12 * y; }
fun source_b(x, y) { return 215 - 3 * x - 5 * y; }

// Brightness of a color, the Y of YCbCr
fun luma(r, g, b)
{
    return 0.299 * r + 0.587 * g + 0.114 * b;
}

// Mean position of the pixels that share a chroma sample with a pixel,
// in one direction. Past the edge, the encoder repeats the last pixel.
fun chroma_pos(pos, step, size)
{
    let first = pos - pos % step;
    let var sum = 0;

    for (let var i = 0; i < step; ++i) {
        sum += (first + i).min(size - 1);
    }

    return sum / step;
}

// Decodes an image and checks its size and every pixel. One chroma
// sample covers hstep by vstep pixels, and nil is for a greyscale image.
fun check(data, width, height, hstep, vstep)
{
    let img = decode_jpeg(data);
    assert(img != nil);
    assert(img.width == width);
    assert(img.height == height);

    for (let var y = 0; y < height; ++y) {
        for (let var x = 0; x < width; ++x) {
            let var r = source_g(x, y) + pattern(x, y);
            let var g = r;
            let var b = r;

            if (hstep != nil) {
                // The pixel has its own brightness, and the color of the
                // gradients at the middle of its chroma sample
                let cx = chroma_pos(x, hstep, width);
                let cy = chroma_pos(y, vstep, height);
                let cr = source_r(cx, cy);
                let cg = source_g(cx, cy);
                let cb = source_b(cx, cy);
                let shift = luma(source_r(x, y), source_g(x, y), source_b(x, y)) - luma(cr, cg, cb);

                r = cr + shift + pattern(x, y);
                g = cg + shift + pattern(x, y);
                b = cb + shift + pattern(x, y);
            }

            let pixel = img.get_pixel(x, y);
            assert(pixel >> 24 == 255);
            assert((color_r(pixel) - r).abs() <= TOLERANCE);
            assert((color_g(pixel) - g).abs() <= TOLERANCE);
            assert((color_b(pixel) - b).abs() <= TOLERANCE);
        }
    }
}

check(JPEG_GREY, 27, 17, nil, nil);
check(JPEG_444, 27, 17, 1, 1);
check(JPEG_420, 27, 17, 2, 2);
check(JPEG_422, 19, 11, 2, 1);
check(JPEG_RGB, 13, 9, 1, 1);

// Returns the position of the first marker of a given kind
fun find_marker(data, marker)
{
    for (let var pos = 0; pos + 1 < data.len; ++pos) {
        if (data[pos] == 0xFF && data[pos + 1] == marker) {
            return pos;
        }
    }

    assert(false);
}

// Returns a copy of the first count bytes of some data
fun prefix(data, count)
{
    let out = ByteArray.with_size(count);
    out.memcpy(0, data, 0, count);
    return out;
}

// Returns a copy of some data with one byte changed
fun patch(data, pos, value)
{
    let out = prefix(data, data.len);
    out[pos] = value;
    return out;
}

// Positions of the frame header, and of the first table of each kind
let frame = find_marker(JPEG_420, 0xC0);
let quant = find_marker(JPEG_420, 0xDB);
let huffman = find_marker(JPEG_420, 0xC4);
let scan = find_marker(JPEG_420, 0xDA);

// An extended sequential frame is decoded like a baseline one
check(patch(JPEG_420, frame + 1, 0xC1), 27, 17, 2, 2);

// Formats that are not supported: progressive, arithmetic coding, 12 bits
// per sample, and components that aren't a whole number of pixels
assert(decode_jpeg(patch(JPEG_420, frame + 1, 0xC2)) == nil);
assert(decode_jpeg(patch(JPEG_420, frame + 1, 0xC9)) == nil);
assert(decode_jpeg(patch(JPEG_420, frame + 4, 12)) == nil);
assert(decode_jpeg(patch(JPEG_420, frame + 14, 0x31)) == nil);

// Empty sizes
assert(decode_jpeg(patch(JPEG_420, frame + 6, 0)) == nil);
assert(decode_jpeg(patch(JPEG_420, frame + 8, 0)) == nil);

// Enormous sizes, which must fail without allocating
assert(decode_jpeg(patch(JPEG_420, frame + 5, 0xFF)) == nil);
assert(decode_jpeg(patch(JPEG_420, frame + 7, 0xFF)) == nil);
assert(decode_jpeg(patch(patch(JPEG_420, frame + 5, 0xFF), frame + 7, 0xFF)) == nil);

// A missing table or scan, with its segment turned into a comment
assert(decode_jpeg(patch(JPEG_420, quant + 1, 0xFE)) == nil);
assert(decode_jpeg(patch(JPEG_420, huffman + 1, 0xFE)) == nil);
assert(decode_jpeg(patch(JPEG_420, scan + 1, 0xFE)) == nil);
assert(decode_jpeg(patch(JPEG_422, find_marker(JPEG_422, 0xDA) + 1, 0xFE)) == nil);

// Restart markers out of order, and at the wrong interval
let interval = find_marker(JPEG_444, 0xDD);
assert(decode_jpeg(patch(JPEG_444, find_marker(JPEG_444, 0xD3) + 1, 0xD4)) == nil);
assert(decode_jpeg(patch(JPEG_444, interval + 5, 2)) == nil);

// Not a JPEG file
assert(decode_jpeg(ByteArray.with_size(0)) == nil);
assert(decode_jpeg(ByteArray.with_size(100)) == nil);
assert(decode_jpeg(#[\x FF D8 FF D9]) == nil);

// A file cut short anywhere
for (let var count = 0; count < JPEG_420.len; ++count) {
    assert(decode_jpeg(prefix(JPEG_420, count)) == nil);
}
for (let var count = 0; count < JPEG_422.len; ++count) {
    assert(decode_jpeg(prefix(JPEG_422, count)) == nil);
}

// A wrong byte anywhere may or may not yield an image, but must not
// make the decoder fail in some other way
fun corrupt(data)
{
    for (let var pos = 0; pos < data.len; ++pos) {
        let img = decode_jpeg(patch(data, pos, data[pos] ^ 0xFF));
        assert(img == nil || img.bytes.len == 4 * img.width * img.height);
    }
}

corrupt(JPEG_444);
corrupt(JPEG_420);
corrupt(JPEG_422);
