// Color, 13 by 9, stored as RGB rather than YCbCr
let JPEG_RGB = #[\x
    FF D8 FF EE 00 0E 41 64 6F 62 65 00 64 00 00 00 00 00 FF DB 00 43 00 01
    01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01
    01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 01
    01 01 01 01 01 01 01 01 01 01 01 01 01 01 01 FF C0 00 11 08 00 09 00 0D
    03 52 11 00 47 11 00 42 11 00 FF C4 00 18 00 01 00 03 01 00 00 00 00 00
    00 00 00 00 00 00 00 09 02 08 0A 03 FF C4 00 2E 10 00 02 02 01 02 02 08
    05 05 00 00 00 00 00 00 00 02 03 01 04 05 12 13 00 07 06 08 11 14 15 34
