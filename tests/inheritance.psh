class Foo
{
    init(self)
    {
        self.a = 1;
        self.b = 2;
    }

    m1(self)
    {
        return 'foo1';
    }

    m2(self)
    {
        return 'foo2';
    }
}

class Bar extends Foo
{
    init(self)
    {
        Foo.init(self);
        self.b = 77;
        self.c = 4;
    }

    m2(self)
    {
        return 'bar';
    }
}

let f = Foo();
assert(f instanceof Foo);
assert(f.a == 1);
assert(f.b == 2);

let b = Bar();
assert(b instanceof Bar);
assert(b.a == 1);
assert(b.b == 77);
assert(b.c == 4);
assert(b.m1() == 'foo1');
assert(b.m2() == 'bar');

// Instantiated before the classes are declared
fun make_leaf()
{
    return Leaf(5);
}

// Leaf and Mid inherit their constructor from Base
class Base
{
    init(self, x)
    {
        self.x = x;
    }
}

class Mid extends Base
{
}

class Leaf extends Mid
{
    get_x(self)
    {
        return self.x;
    }
}

let m = Mid(3);
assert(m instanceof Base);
assert(m.x == 3);

let l = make_leaf();
assert(l instanceof Mid);
assert(l.get_x() == 5);
