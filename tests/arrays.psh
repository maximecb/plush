let a = [0, 1, 2];
let removed = a.remove(0);
assert(removed == 0);
assert(a.len == 2);
assert(a[0] == 1);
assert(a[1] == 2);

let a2 = [0, 1, 2];
a2.insert(1, 55);
assert(a2.len == 4);
assert(a2[0] == 0);
assert(a2[1] == 55);
assert(a2[2] == 1);

let a3 = [1, 2];
let b3 = [3, 4];
a3.append(b3);
assert(a3.len == 4);
assert(a3[0] == 1);
assert(a3[1] == 2);
assert(a3[2] == 3);
assert(a3[3] == 4);
assert(b3.len == 2);

// Appending into spare capacity, so no new table is allocated
let d3 = [1, 2, 3];
d3.push(4);
d3.append([5]);
assert(d3.len == 5);
assert(d3[3] == 4);
assert(d3[4] == 5);

let c3 = [1, 2];
c3.append(c3);
assert(c3.len == 4);
assert(c3[0] == 1);
assert(c3[1] == 2);
assert(c3[2] == 1);
assert(c3[3] == 2);

// Growing beyond capacity fills with the fill value
let r = [1, 2];
r.resize(5, 0);
assert(r.len == 5);
assert(r[1] == 2);
assert(r[2] == 0);
assert(r[4] == 0);

// Shrinking, then growing back into the spare capacity
r.resize(1, nil);
assert(r.len == 1);
assert(r[0] == 1);
r.resize(3, 7);
assert(r.len == 3);
assert(r[1] == 7);
assert(r[2] == 7);

r.resize(0, nil);
assert(r.len == 0);

let s = [10, 20, 30, 40, 50];

let s1 = s.slice(1, 4);
assert(s1.len == 3);
assert(s1[0] == 20);
assert(s1[1] == 30);
assert(s1[2] == 40);

// Slicing the full range copies every element
let s2 = s.slice(0, s.len);
assert(s2.len == 5);
assert(s2[0] == 10);
assert(s2[4] == 50);

// An empty range produces an empty array
let s3 = s.slice(2, 2);
assert(s3.len == 0);

// The slice is a copy: mutating it doesn't affect the source array
s1.push(99);
assert(s1.len == 4);
assert(s.len == 5);
assert(s[1] == 20);

$println("Array tests passed.");
