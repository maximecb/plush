let d1 = { a:1 };
assert(d1.has('b') == false);
assert(d1.len == 1);
assert({}.len == 0);
assert({ a: 1, b: 2 }.len == 2);

assert({}.has('a') == false);
assert({}.has(' ') == false);
assert({ a:1 }.has('a') == true);

let d = { a: 1};
for (let var i = 0; i < 200; ++i)
{
    d[i.to_s()] = i;
}
assert(d.has('a'));
assert(d.has('100'));
assert(!d.has('500'));
assert(!d.has(' '));
assert(d.len == 201);

// Overwriting a key must not grow the table, so a dict holding one
// entry stays that size no matter how many times it is written
let d2 = {};
for (let var i = 0; i < 100000; ++i)
{
    d2['x'] = i;
}
assert(d2['x'] == 99999);
assert(d2.has('x'));
assert(!d2.has('y'));
assert(d2.len == 1);

// Rewriting every key of a grown dict leaves the entries it already had
for (let var i = 0; i < 200; ++i)
{
    d[i.to_s()] = i * 2;
}
assert(d['100'] == 200);
assert(d.has('a'));
assert(d.len == 201);

// The len field reports the entry count; indexing still accesses a key named len.
let with_len_key = { len: 42 };
assert(with_len_key.len == 1);
assert(with_len_key['len'] == 42);
with_len_key.len = 99;
assert(with_len_key.len == 1);
assert(with_len_key['len'] == 99);

// keys() lists every key exactly once, and nothing else
assert({}.keys().len == 0);
let ks = d.keys();
assert(ks.len == 201);
let seen = {};
for (let var i = 0; i < ks.len; ++i)
{
    assert(d.has(ks[i]));
    assert(!seen.has(ks[i]));
    seen[ks[i]] = true;
}

// Overwritten keys are not listed twice
assert(d2.keys().len == 1);
assert(d2.keys()[0] == 'x');
