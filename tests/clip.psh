// Test the .clip() method for Int64 and Float64

// Test Int64.clip()
assert((5).clip(0, 10) == 5);
assert((-5).clip(0, 10) == 0);
assert((15).clip(0, 10) == 10);
assert((0).clip(0, 10) == 0);
assert((10).clip(0, 10) == 10);
assert((-20).clip(-10, -5) == -10);
assert((0).clip(-10, -5) == -5);
assert((7).clip(7, 7) == 7);

// Test Float64.clip()
assert((5.5).clip(0.0, 10.0) == 5.5);
assert((-5.5).clip(0.0, 10.0) == 0.0);
assert((15.5).clip(0.0, 10.0) == 10.0);

$println("clip tests passed!");
