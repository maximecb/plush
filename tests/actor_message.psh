// These classes represent two different kinds of messages
class Inc
{
    init(self, amount)
    {
        self.amount = amount;
    }
}

class Get
{
    init(self) {}
}

let var g = 0;

// Event loop for a new actor
fun f()
{
    while (true)
    {
        let msg = $actor_recv();

        if (msg instanceof Inc)
            g = g + msg.amount;

        if (msg instanceof Get)
            $actor_send(0, g);
    }
}

let id = $actor_spawn(f);

for (let var i = 0; i < 10; ++i)
    $actor_send(id, Inc(i));

$actor_send(id, Get());
let sum = $actor_recv();
$println(sum);
assert(sum == 45);
