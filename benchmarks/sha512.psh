// SHA-512 benchmark
// Heavy on integer arithmetic, bit manipulation and array indexing.
// Fixnums are 62-bit, so each 64-bit word is split into a high and a
// low 32-bit half, and additions propagate the carry by hand.

let MASK = 0xFFFFFFFF;

// Round constants as (high, low) 32-bit pairs
let K = [
    0x428a2f98, 0xd728ae22, 0x71374491, 0x23ef65cd,
    0xb5c0fbcf, 0xec4d3b2f, 0xe9b5dba5, 0x8189dbbc,
    0x3956c25b, 0xf348b538, 0x59f111f1, 0xb605d019,
    0x923f82a4, 0xaf194f9b, 0xab1c5ed5, 0xda6d8118,
    0xd807aa98, 0xa3030242, 0x12835b01, 0x45706fbe,
    0x243185be, 0x4ee4b28c, 0x550c7dc3, 0xd5ffb4e2,
    0x72be5d74, 0xf27b896f, 0x80deb1fe, 0x3b1696b1,
    0x9bdc06a7, 0x25c71235, 0xc19bf174, 0xcf692694,
    0xe49b69c1, 0x9ef14ad2, 0xefbe4786, 0x384f25e3,
    0x0fc19dc6, 0x8b8cd5b5, 0x240ca1cc, 0x77ac9c65,
    0x2de92c6f, 0x592b0275, 0x4a7484aa, 0x6ea6e483,
    0x5cb0a9dc, 0xbd41fbd4, 0x76f988da, 0x831153b5,
    0x983e5152, 0xee66dfab, 0xa831c66d, 0x2db43210,
    0xb00327c8, 0x98fb213f, 0xbf597fc7, 0xbeef0ee4,
    0xc6e00bf3, 0x3da88fc2, 0xd5a79147, 0x930aa725,
    0x06ca6351, 0xe003826f, 0x14292967, 0x0a0e6e70,
    0x27b70a85, 0x46d22ffc, 0x2e1b2138, 0x5c26c926,
    0x4d2c6dfc, 0x5ac42aed, 0x53380d13, 0x9d95b3df,
    0x650a7354, 0x8baf63de, 0x766a0abb, 0x3c77b2a8,
    0x81c2c92e, 0x47edaee6, 0x92722c85, 0x1482353b,
    0xa2bfe8a1, 0x4cf10364, 0xa81a664b, 0xbc423001,
    0xc24b8b70, 0xd0f89791, 0xc76c51a3, 0x0654be30,
    0xd192e819, 0xd6ef5218, 0xd6990624, 0x5565a910,
    0xf40e3585, 0x5771202a, 0x106aa070, 0x32bbd1b8,
    0x19a4c116, 0xb8d2d0c8, 0x1e376c08, 0x5141ab53,
    0x2748774c, 0xdf8eeb99, 0x34b0bcb5, 0xe19b48a8,
    0x391c0cb3, 0xc5c95a63, 0x4ed8aa4a, 0xe3418acb,
    0x5b9cca4f, 0x7763e373, 0x682e6ff3, 0xd6b2b8a3,
    0x748f82ee, 0x5defb2fc, 0x78a5636f, 0x43172f60,
    0x84c87814, 0xa1f0ab72, 0x8cc70208, 0x1a6439ec,
    0x90befffa, 0x23631e28, 0xa4506ceb, 0xde82bde9,
    0xbef9a3f7, 0xb2c67915, 0xc67178f2, 0xe372532b,
    0xca273ece, 0xea26619c, 0xd186b8c7, 0x21c0c207,
    0xeada7dd6, 0xcde0eb1e, 0xf57d4f7f, 0xee6ed178,
    0x06f067aa, 0x72176fba, 0x0a637dc5, 0xa2c898a6,
    0x113f9804, 0xbef90dae, 0x1b710b35, 0x131c471b,
    0x28db77f5, 0x23047d84, 0x32caab7b, 0x40c72493,
    0x3c9ebe0a, 0x15c9bebc, 0x431d67c4, 0x9c100d4c,
    0x4cc5d4be, 0xcb3e42b6, 0x597f299c, 0xfc657e2a,
    0x5fcb6fab, 0x3ad6faec, 0x6c44198c, 0x4a475817,
];

// Message schedule halves, reused across blocks
let W_HI = Array.with_size(80, 0);
let W_LO = Array.with_size(80, 0);

// Hash a ByteArray that has already been padded to a multiple of 128 bytes.
// Returns the digest as an array of 16 32-bit words, high half first.
fun sha512(msg) {
    let var h0h = 0x6a09e667; let var h0l = 0xf3bcc908;
    let var h1h = 0xbb67ae85; let var h1l = 0x84caa73b;
    let var h2h = 0x3c6ef372; let var h2l = 0xfe94f82b;
    let var h3h = 0xa54ff53a; let var h3l = 0x5f1d36f1;
    let var h4h = 0x510e527f; let var h4l = 0xade682d1;
    let var h5h = 0x9b05688c; let var h5l = 0x2b3e6c1f;
    let var h6h = 0x1f83d9ab; let var h6l = 0xfb41bd6b;
    let var h7h = 0x5be0cd19; let var h7l = 0x137e2179;

    let num_blocks = msg.len.idiv(128);

    for (let var blk = 0; blk < num_blocks; ++blk) {
        let base = blk * 128;

        // Read the 16 big-endian 64-bit words of this block
        for (let var i = 0; i < 16; ++i) {
            let j = base + i * 8;
            W_HI[i] = (msg[j] << 24) | (msg[j + 1] << 16) | (msg[j + 2] << 8) | msg[j + 3];
            W_LO[i] = (msg[j + 4] << 24) | (msg[j + 5] << 16) | (msg[j + 6] << 8) | msg[j + 7];
        }

        // Extend into the remaining 64 words
        for (let var i = 16; i < 80; ++i) {
            // s0 = rotr(x, 1) ^ rotr(x, 8) ^ (x >> 7)
            let xh = W_HI[i - 15];
            let xl = W_LO[i - 15];
            let s0h = ((xh >> 1) | ((xl & 0x1) << 31)) ^ ((xh >> 8) | ((xl & 0xFF) << 24)) ^ (xh >> 7);
            let s0l = ((xl >> 1) | ((xh & 0x1) << 31)) ^ ((xl >> 8) | ((xh & 0xFF) << 24)) ^ ((xl >> 7) | ((xh & 0x7F) << 25));

            // s1 = rotr(y, 19) ^ rotr(y, 61) ^ (y >> 6)
            let yh = W_HI[i - 2];
            let yl = W_LO[i - 2];
            let s1h = ((yh >> 19) | ((yl & 0x7FFFF) << 13)) ^ ((yl >> 29) | ((yh & 0x1FFFFFFF) << 3)) ^ (yh >> 6);
            let s1l = ((yl >> 19) | ((yh & 0x7FFFF) << 13)) ^ ((yh >> 29) | ((yl & 0x1FFFFFFF) << 3)) ^ ((yl >> 6) | ((yh & 0x3F) << 26));

            let lo = W_LO[i - 16] + s0l + W_LO[i - 7] + s1l;
            W_HI[i] = (W_HI[i - 16] + s0h + W_HI[i - 7] + s1h + (lo >> 32)) & MASK;
            W_LO[i] = lo & MASK;
        }

        let var ah = h0h; let var al = h0l;
        let var bh = h1h; let var bl = h1l;
        let var ch = h2h; let var cl = h2l;
        let var dh = h3h; let var dl = h3l;
        let var eh = h4h; let var el = h4l;
        let var fh = h5h; let var fl = h5l;
        let var gh = h6h; let var gl = h6l;
        let var hh = h7h; let var hl = h7l;

        for (let var i = 0; i < 80; ++i) {
            // s1 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41)
            let s1h = ((eh >> 14) | ((el & 0x3FFF) << 18)) ^ ((eh >> 18) | ((el & 0x3FFFF) << 14)) ^ ((el >> 9) | ((eh & 0x1FF) << 23));
            let s1l = ((el >> 14) | ((eh & 0x3FFF) << 18)) ^ ((el >> 18) | ((eh & 0x3FFFF) << 14)) ^ ((eh >> 9) | ((el & 0x1FF) << 23));

            let chh = (eh & fh) ^ ((eh ^ MASK) & gh);
            let chl = (el & fl) ^ ((el ^ MASK) & gl);

            let t1l = hl + s1l + chl + K[2 * i + 1] + W_LO[i];
            let t1h = (hh + s1h + chh + K[2 * i] + W_HI[i] + (t1l >> 32)) & MASK;

            // s0 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39)
            let s0h = ((ah >> 28) | ((al & 0xFFFFFFF) << 4)) ^ ((al >> 2) | ((ah & 0x3) << 30)) ^ ((al >> 7) | ((ah & 0x7F) << 25));
            let s0l = ((al >> 28) | ((ah & 0xFFFFFFF) << 4)) ^ ((ah >> 2) | ((al & 0x3) << 30)) ^ ((ah >> 7) | ((al & 0x7F) << 25));

            let majh = (ah & bh) ^ (ah & ch) ^ (bh & ch);
            let majl = (al & bl) ^ (al & cl) ^ (bl & cl);

            // Low half of t1 is kept unmasked, its carry is folded in below
            let t1lm = t1l & MASK;

            hh = gh; hl = gl;
            gh = fh; gl = fl;
            fh = eh; fl = el;

            let el2 = dl + t1lm;
            eh = (dh + t1h + (el2 >> 32)) & MASK;
            el = el2 & MASK;

            dh = ch; dl = cl;
            ch = bh; cl = bl;
            bh = ah; bl = al;

            let al2 = t1lm + s0l + majl;
            ah = (t1h + s0h + majh + (al2 >> 32)) & MASK;
            al = al2 & MASK;
        }

        let var t = h0l + al; h0h = (h0h + ah + (t >> 32)) & MASK; h0l = t & MASK;
        t = h1l + bl; h1h = (h1h + bh + (t >> 32)) & MASK; h1l = t & MASK;
        t = h2l + cl; h2h = (h2h + ch + (t >> 32)) & MASK; h2l = t & MASK;
        t = h3l + dl; h3h = (h3h + dh + (t >> 32)) & MASK; h3l = t & MASK;
        t = h4l + el; h4h = (h4h + eh + (t >> 32)) & MASK; h4l = t & MASK;
        t = h5l + fl; h5h = (h5h + fh + (t >> 32)) & MASK; h5l = t & MASK;
        t = h6l + gl; h6h = (h6h + gh + (t >> 32)) & MASK; h6l = t & MASK;
        t = h7l + hl; h7h = (h7h + hh + (t >> 32)) & MASK; h7l = t & MASK;
    }

    return [h0h, h0l, h1h, h1l, h2h, h2l, h3h, h3l, h4h, h4l, h5h, h5l, h6h, h6l, h7h, h7l];
}

// Copy msg_len bytes of data into a new buffer with SHA-512 padding appended
fun pad(data, msg_len) {
    let padded_len = ((msg_len + 16).idiv(128) + 1) * 128;
    let buf = ByteArray.with_size(padded_len);

    for (let var i = 0; i < msg_len; ++i) {
        buf[i] = data[i];
    }

    buf[msg_len] = 0x80;

    // Message length in bits, big-endian, in the last 16 bytes.
    // The top 8 bytes are always zero for lengths that fit in memory.
    let bit_len = msg_len * 8;
    for (let var i = 0; i < 8; ++i) {
        buf[padded_len - 1 - i] = (bit_len >> (i * 8)) & 0xFF;
    }

    return buf;
}

fun digest_to_s(d) {
    let var s = "";
    for (let var i = 0; i < 16; ++i) {
        s = s + d[i].to_hex(8).lower();
    }
    return s;
}

fun main() {
    // Check the digest of "abc" against the known SHA-512 test vector
    let abc = ByteArray.with_size(3);
    abc[0] = 97;
    abc[1] = 98;
    abc[2] = 99;
    let test = digest_to_s(sha512(pad(abc, 3)));
    let expected = "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f";

    if (test != expected) {
        $println("SHA-512 self-test FAILED");
        $println("  got:      " + test);
        $println("  expected: " + expected);
        return;
    }

    // Hash a buffer filled with a simple byte pattern
    let NUM_BYTES = 8 * 1536 * 1024;
    let data = ByteArray.with_size(NUM_BYTES);
    for (let var i = 0; i < NUM_BYTES; ++i) {
        data[i] = i & 0xFF;
    }
    let msg = pad(data, NUM_BYTES);

    let start_time = $time_current_ms();
    let d = sha512(msg);
    let end_time = $time_current_ms();

    let time_ms = end_time - start_time;
    let bytes_per_sec = (NUM_BYTES * 1000).idiv(time_ms.max(1));

    $println("SHA-512 of " + NUM_BYTES.comma_sep() + " bytes took " + time_ms.to_s() + " ms");
    $println("throughput: " + bytes_per_sec.comma_sep() + " bytes/s");
    $println("digest: " + digest_to_s(d));
}

main();
