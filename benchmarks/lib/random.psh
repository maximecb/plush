// A simple Linear Congruential Generator (LCG)
// This is a basic pseudo-random number generator.
//
// Import it with:
//   from ./lib/random import *;
//
// This lives in a subdirectory so that run_benchmarks.sh, which globs
// benchmarks/*.psh, does not try to run it as a benchmark. It mirrors
// examples/random.psh: imports cannot reach outside their own directory,
// so the benchmarks cannot share that copy.
//
// Importing does not seed the generator. A unit that wants a different
// sequence on each run has to call rand_init() itself.

// LCG state
let var lcg_seed = 1;

// Initializes the random number generator with a seed value.
fun rand_init(seed) {
    // We use a bitwise AND to keep the seed as a positive 31-bit integer.
    lcg_seed = seed & 0x7FFFFFFF;
}

// Advances the generator and returns the raw 31-bit state.
fun rand_next() {
    // The multiplier is bounded by the fixnum range rather than by the
    // modulus. Integers are 62-bit fixnums, so a product at or above 2^61 is
    // boxed on the heap, and with a 31-bit state that caps the multiplier at
    // 2^30. POSIX uses 1103515245, which is 3% over that line and so allocates
    // on 2.7% of the calls, costing about 9%. This one is the best 2D spectral
    // merit found under the cap, and it beats POSIX's on that measure.
    lcg_seed = (lcg_seed * 1073716837 + 12345) & 0x7FFFFFFF;
    return lcg_seed;
}

// Returns a random integer in the range [min_val, max_val).
fun rand_int(min_val, max_val) {
    // The lowest bits of an LCG are the least random, so we drop them.
    // The remaining 23 bits are well above the ranges asked for here.
    let bits = rand_next() >> 8;
    return min_val + (bits % (max_val - min_val));
}

// Returns a random float in the range [min_val, max_val).
fun rand_float(min_val, max_val) {
    // The state is 31 bits, so dividing by 2^31 gives a t in [0.0, 1.0).
    let t = rand_next().to_f() / 2147483648.0;
    return min_val + t * (max_val - min_val);
}
