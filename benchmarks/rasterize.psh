// Triangle rasterization benchmark
//
// Splits a 1024x1024 frame buffer into 8192 equal-area triangles and
// rasterizes all of them, once per frame.
// Usage: plush benchmarks/rasterize.psh [num_frames]

let FRAME_WIDTH = 1024;
let FRAME_HEIGHT = 1024;

// Grid of cells, each split into two triangles: 64 * 64 * 2 = 8192 triangles
let GRID_COLS = 64;
let GRID_ROWS = 64;

// Command-line argument for the number of frames to render
let num_frames = $cmd_get_arg_or(1, "300").parse_int(10);
if (num_frames == nil) {
    $println("expected an integer number of frames");
    $exit(1);
}

class Vec2 {
    init(self, x, y) {
        self.x = x;
        self.y = y;
    }
}

// This function expects the coordinates to be floats such that
// x is in [0, FRAME_WIDTH] and +x points right
// y is in [0, FRAME_HEIGHT] and +y points down
fun rasterize_triangle(v0, v1, v2, color, fb) {
    let var p0 = v0;
    let var p1 = v1;
    let var p2 = v2;
    if (p0.y > p1.y) { let tmp = p0; p0 = p1; p1 = tmp; }
    if (p0.y > p2.y) { let tmp = p0; p0 = p2; p2 = tmp; }
    if (p1.y > p2.y) { let tmp = p1; p1 = p2; p2 = tmp; }

    let py0 = p0.y;
    let py1 = p1.y;
    let py2 = p2.y;

    let y0 = py0.floor();
    let y1 = py1.floor();
    let y2 = py2.floor();

    if (y0 == y2) return;

    let x0 = p0.x;
    let x1 = p1.x;
    let x2 = p2.x;

    let var inv_slope1 = 0.0;
    if (py1 > py0) inv_slope1 = (x1 - x0) / (py1 - py0);

    let var inv_slope2 = 0.0;
    if (py2 > py0) inv_slope2 = (x2 - x0) / (py2 - py0);

    let start_scanline_y_top = y0.max(0);
    let end_scanline_y_top = y1.min(FRAME_HEIGHT);

    // Top half of triangle
    if (start_scanline_y_top < end_scanline_y_top) {
        let dy = start_scanline_y_top + 1 - py0;
        let xa = x0 + dy * inv_slope1;
        let xb = x0 + dy * inv_slope2;

        // Both edges radiate from p0, so which of the two is the left one
        // is fixed for the whole half and can be decided once
        let var cur_xl = xa; let var slope_l = inv_slope1;
        let var cur_xr = xb; let var slope_r = inv_slope2;
        if (xb < xa) {
            cur_xl = xb; slope_l = inv_slope2;
            cur_xr = xa; slope_r = inv_slope1;
        }

        for (let var scanline_y = start_scanline_y_top; scanline_y < end_scanline_y_top; ++scanline_y) {
            let start_x = cur_xl.floor().max(0);
            let end_x = cur_xr.floor().min(FRAME_WIDTH);
            if (start_x < end_x) {
                fb.fill_u32(scanline_y * FRAME_WIDTH + start_x, end_x - start_x, color);
            }
            cur_xl = cur_xl + slope_l;
            cur_xr = cur_xr + slope_r;
        }
    }

    let var inv_slope3 = 0.0;
    if (py2 > py1) inv_slope3 = (x2 - x1) / (py2 - py1);

    let start_scanline_y_bot = y1.max(0);
    let end_scanline_y_bot = y2.min(FRAME_HEIGHT);

    // Bottom half of triangle
    if (start_scanline_y_bot < end_scanline_y_bot) {
        let xa = x1 + (start_scanline_y_bot + 1 - py1) * inv_slope3;
        let xb = x0 + (start_scanline_y_bot + 1 - py0) * inv_slope2;

        // Both edges converge on p2, so the left/right order is fixed here too
        let var cur_xl = xa; let var slope_l = inv_slope3;
        let var cur_xr = xb; let var slope_r = inv_slope2;
        if (xb < xa) {
            cur_xl = xb; slope_l = inv_slope2;
            cur_xr = xa; slope_r = inv_slope3;
        }

        for (let var scanline_y = start_scanline_y_bot; scanline_y < end_scanline_y_bot; ++scanline_y) {
            let start_x = cur_xl.floor().max(0);
            let end_x = cur_xr.floor().min(FRAME_WIDTH);
            if (start_x < end_x) {
                fb.fill_u32(scanline_y * FRAME_WIDTH + start_x, end_x - start_x, color);
            }
            cur_xl = cur_xl + slope_l;
            cur_xr = cur_xr + slope_r;
        }
    }
}

// --- Pre-generated geometry ---

// Grid of vertices, GRID_COLS + 1 of them per row
let vertices = [];
for (let var r = 0; r <= GRID_ROWS; ++r) {
    for (let var c = 0; c <= GRID_COLS; ++c) {
        vertices.push(Vec2(
            (c * FRAME_WIDTH) / GRID_COLS,
            (r * FRAME_HEIGHT) / GRID_ROWS
        ));
    }
}

// Two triangles per cell, as indices into the vertex array
let indices = [];
let colors = [];
for (let var r = 0; r < GRID_ROWS; ++r) {
    for (let var c = 0; c < GRID_COLS; ++c) {
        let i00 = r * (GRID_COLS + 1) + c;
        let i11 = i00 + GRID_COLS + 2;

        indices.push(i00); indices.push(i00 + 1); indices.push(i11);
        indices.push(i00); indices.push(i11); indices.push(i11 - 1);

        let base = 0xFF000000 | ((c * 4) << 16) | ((r * 4) << 8);
        colors.push(base | 0x40);
        colors.push(base | 0xC0);
    }
}

let frame_buffer = ByteArray.with_size(FRAME_WIDTH * FRAME_HEIGHT * 4);
let num_tris = colors.len;

// --- Rendering ---

// The triangles tile the whole frame, so there is no need to clear it
let start_ms = $time_current_ms();

for (let var frame = 0; frame < num_frames; ++frame) {
    let var i = 0;
    for (let var t = 0; t < num_tris; ++t) {
        rasterize_triangle(
            vertices[indices[i]],
            vertices[indices[i + 1]],
            vertices[indices[i + 2]],
            colors[t],
            frame_buffer
        );
        i += 3;
    }
}

let total_ms = $time_current_ms() - start_ms;
let fps = (num_frames * 1000) / total_ms;

$println(num_frames.to_s() + " frames of " + num_tris.to_s() + " triangles");
$println("total time: " + total_ms.to_s() + "ms");
$println("fps: " + fps.format_decimals(1));
