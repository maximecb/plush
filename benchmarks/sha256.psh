// SHA-256 benchmark, using the standard library implementation
// Heavy on 32-bit integer arithmetic, bit manipulation and array indexing

from sha256 import sha256;

fun main() {
    // Check the digest of "abc" against the known SHA-256 test vector
    let test = sha256("abc").to_hex();
    let expected = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";

    if (test != expected) {
        $println("SHA-256 self-test FAILED");
        $println("  got:      " + test);
        $println("  expected: " + expected);
        return;
    }

    // Hash a buffer filled with a simple byte pattern
    let NUM_BYTES = 8 * 1536 * 1024;
    let data = ByteArray.with_size(NUM_BYTES);
    for (let var i = 0; i < NUM_BYTES; ++i) {
        data[i] = i & 0xFF;
    }

    let start_time = $time_current_ms();
    let d = sha256(data);
    let end_time = $time_current_ms();

    let time_ms = end_time - start_time;
    let bytes_per_sec = (NUM_BYTES * 1000).idiv(time_ms.max(1));

    $println("SHA-256 of " + NUM_BYTES.comma_sep() + " bytes took " + time_ms.to_s() + " ms");
    $println("throughput: " + bytes_per_sec.comma_sep() + " bytes/s");
    $println("digest: " + d.to_hex());
}

main();
