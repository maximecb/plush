// N-body simulation benchmark (the Sun and the four gas giants)
// Heavy on floating-point arithmetic and array accesses

let PI = 3.141592653589793;
let SOLAR_MASS = 4.0 * PI * PI;
let DAYS_PER_YEAR = 365.24;

let NUM_BODIES = 5;

// Position, velocity and mass of each body, in flat arrays
let px = [0.0, 4.84143144246472090, 8.34336671824457987, 12.8943695621391310, 15.3796971148509165];
let py = [0.0, -1.16032004402742839, 4.12479856412430479, -15.1111514016986312, -25.9193146099879641];
let pz = [0.0, -0.103622044471123109, -0.403523417114321381, -0.223307578892655734, 0.179258772950371181];

let vx = [
    0.0,
    0.00166007664274403694 * DAYS_PER_YEAR,
    -0.00276742510726862411 * DAYS_PER_YEAR,
    0.00296460137564761618 * DAYS_PER_YEAR,
    0.00268067772490389322 * DAYS_PER_YEAR,
];
let vy = [
    0.0,
    0.00769901118419740425 * DAYS_PER_YEAR,
    0.00499852801234917238 * DAYS_PER_YEAR,
    0.00237847173959480950 * DAYS_PER_YEAR,
    0.00162824170038242295 * DAYS_PER_YEAR,
];
let vz = [
    0.0,
    -0.0000690460016972063023 * DAYS_PER_YEAR,
    0.0000230417297573763929 * DAYS_PER_YEAR,
    -0.0000296589568540237556 * DAYS_PER_YEAR,
    -0.0000951592254519715870 * DAYS_PER_YEAR,
];

let mass = [
    SOLAR_MASS,
    0.000954791938424326609 * SOLAR_MASS,
    0.000285885980666130812 * SOLAR_MASS,
    0.0000436624404335156298 * SOLAR_MASS,
    0.0000515138902046611451 * SOLAR_MASS,
];

// Give the Sun the momentum that cancels out that of the other bodies,
// so that the system as a whole stays put
fun offset_momentum() {
    let var sx = 0.0;
    let var sy = 0.0;
    let var sz = 0.0;

    for (let var i = 0; i < NUM_BODIES; ++i) {
        sx = sx + vx[i] * mass[i];
        sy = sy + vy[i] * mass[i];
        sz = sz + vz[i] * mass[i];
    }

    vx[0] = -sx / SOLAR_MASS;
    vy[0] = -sy / SOLAR_MASS;
    vz[0] = -sz / SOLAR_MASS;
}

// Total energy of the system, which the simulation should conserve
fun energy() {
    let var e = 0.0;

    for (let var i = 0; i < NUM_BODIES; ++i) {
        e = e + 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);

        for (let var j = i + 1; j < NUM_BODIES; ++j) {
            let dx = px[i] - px[j];
            let dy = py[i] - py[j];
            let dz = pz[i] - pz[j];
            e = e - (mass[i] * mass[j]) / (dx * dx + dy * dy + dz * dz).sqrt();
        }
    }

    return e;
}

fun advance(dt) {
    for (let var i = 0; i < NUM_BODIES; ++i) {
        let ix = px[i];
        let iy = py[i];
        let iz = pz[i];
        let im = mass[i];

        let var ivx = vx[i];
        let var ivy = vy[i];
        let var ivz = vz[i];

        for (let var j = i + 1; j < NUM_BODIES; ++j) {
            let dx = ix - px[j];
            let dy = iy - py[j];
            let dz = iz - pz[j];

            let d2 = dx * dx + dy * dy + dz * dz;
            let mag = dt / (d2 * d2.sqrt());

            let jm = mass[j] * mag;
            ivx = ivx - dx * jm;
            ivy = ivy - dy * jm;
            ivz = ivz - dz * jm;

            let imag = im * mag;
            vx[j] = vx[j] + dx * imag;
            vy[j] = vy[j] + dy * imag;
            vz[j] = vz[j] + dz * imag;
        }

        vx[i] = ivx;
        vy[i] = ivy;
        vz[i] = ivz;
    }

    for (let var i = 0; i < NUM_BODIES; ++i) {
        px[i] = px[i] + dt * vx[i];
        py[i] = py[i] + dt * vy[i];
        pz[i] = pz[i] + dt * vz[i];
    }
}

fun main() {
    let NUM_STEPS = 1_000_000;

    offset_momentum();
    $println("initial energy: " + energy().format_decimals(9));

    let start_time = $time_current_ms();
    for (let var i = 0; i < NUM_STEPS; ++i) {
        advance(0.01);
    }
    let end_time = $time_current_ms();

    $println("final energy:   " + energy().format_decimals(9));
    $println(NUM_STEPS.to_s() + " steps took " + (end_time - start_time).to_s() + " ms");
}

main();
