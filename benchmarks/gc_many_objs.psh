class Node
{
    init(self, val, next)
    {
        self.val = val;
        self.next = next;
    }
}

let var list = nil;
let num_nodes = 1_000_000;

// Create a linked list with 1M objects
for (let var i = 0; i < num_nodes; ++i)
{
    list = Node(1, list);
}

// Trigger many GC cycles in a loop
// We want to measure the steady-state GC time
let num_colls = 1000;
let var total_ms = 0;
for (let var i = 0; i < num_colls; ++i)
{
    let start_ms = $time_current_ms();
    $gc_collect();
    total_ms = total_ms + ($time_current_ms() - start_ms);
}

$println("avg collection time: " + (total_ms / num_colls).format_decimals(1) + "ms");
