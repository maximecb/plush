class Node
{
    init(self, val, next)
    {
        self.val = val;
        self.next = next;
    }
}

let num_nodes = 100_000;
let num_arrays = 4096;
let array_size = 256 * 1024; // 256KB

// Linked list with 100K objects
let var list = nil;
for (let var i = 0; i < num_nodes; ++i)
{
    list = Node(1, list);
}

// 4096 byte arrays of 256KB each (1GB total)
// This could represent texture data for a game
let arrays = [];
for (let var i = 0; i < num_arrays; ++i)
{
    arrays.push(ByteArray.with_size(array_size));
}

// Trigger many GC cycles in a loop
// We want to measure the steady-state GC time
let num_colls = 100;
let var total_ms = 0;
for (let var i = 0; i < num_colls; ++i)
{
    let start_ms = $time_current_ms();
    $vm_gc_collect();
    total_ms = total_ms + ($time_current_ms() - start_ms);
}

$println("avg collection time: " + (total_ms / num_colls).format_decimals(1) + "ms");
