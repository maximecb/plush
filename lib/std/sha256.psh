// SHA-256 hashing
//
//   from sha256 import sha256, to_hex;
//   $println(to_hex(sha256("abc")));
//
// Data that arrives in pieces can be hashed incrementally:
//
//   let h = SHA256();
//   h.update(chunk1);
//   h.update(chunk2);
//   let digest = h.digest();
//
// Digests are ByteArrays of 32 bytes. SHA-256 is defined big-endian, while
// ByteArray reads integers little-endian, so digest.get_u32(0) is not the
// number spelled by the first 8 hex digits.

// Round constants
let K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

// Mixes one 64-byte block of bytes, starting at offset, into the state h.
// The message schedule w is passed in so that it can be reused.
fun compress(h, w, bytes, offset)
{
    let MASK = 0xFFFFFFFF;

    // Read the 16 big-endian words of this block
    for (let var i = 0; i < 16; ++i) {
        let j = offset + i * 4;
        w[i] = (bytes[j] << 24) | (bytes[j + 1] << 16) | (bytes[j + 2] << 8) | bytes[j + 3];
    }

    // Extend into the remaining 48 words
    for (let var i = 16; i < 64; ++i) {
        let x = w[i - 15];
        let s0 = (((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3)) & MASK;
        let y = w[i - 2];
        let s1 = (((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10)) & MASK;
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & MASK;
    }

    let var a = h[0];
    let var b = h[1];
    let var c = h[2];
    let var d = h[3];
    let var e = h[4];
    let var f = h[5];
    let var g = h[6];
    let var hh = h[7];

    for (let var i = 0; i < 64; ++i) {
        let s1 = (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & MASK;
        let ch = (e & f) ^ ((e ^ MASK) & g);
        let temp1 = (hh + s1 + ch + K[i] + w[i]) & MASK;
        // Rotating by 2 shifts a left by 30, which would leave the fixnum
        // range, so only the 2 bits that survive the mask are shifted
        let s0 = (((a >> 2) | ((a & 0x3) << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & MASK;
        let maj = (a & b) ^ (a & c) ^ (b & c);
        let temp2 = (s0 + maj) & MASK;

        hh = g;
        g = f;
        f = e;
        e = (d + temp1) & MASK;
        d = c;
        c = b;
        b = a;
        a = (temp1 + temp2) & MASK;
    }

    h[0] = (h[0] + a) & MASK;
    h[1] = (h[1] + b) & MASK;
    h[2] = (h[2] + c) & MASK;
    h[3] = (h[3] + d) & MASK;
    h[4] = (h[4] + e) & MASK;
    h[5] = (h[5] + f) & MASK;
    h[6] = (h[6] + g) & MASK;
    h[7] = (h[7] + hh) & MASK;
}

// Returns the bytes of a ByteArray or String
fun to_bytes(data)
{
    if (data instanceof String) {
        let bytes = ByteArray.with_size(0);
        bytes.push_string(data);
        return bytes;
    }

    assert(data instanceof ByteArray);
    return data;
}

// Incremental SHA-256 hasher
class SHA256
{
    init(self)
    {
        self.h = [
            0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
            0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
        ];

        self.w = Array.with_size(64, 0);

        // The start of an incomplete block, waiting for more data
        self.buf = ByteArray.with_size(64);
        self.buf_len = 0;

        // Message length so far, in bytes
        self.msg_len = 0;
    }

    // Appends data to the message, as a ByteArray or a String
    update(self, data)
    {
        let bytes = to_bytes(data);
        let n = bytes.len;
        let var i = 0;

        self.msg_len = self.msg_len + n;

        // Complete a block started by an earlier update
        if (self.buf_len > 0) {
            let take = (64 - self.buf_len).min(n);
            self.buf.memcpy(self.buf_len, bytes, 0, take);
            self.buf_len = self.buf_len + take;
            i = take;

            if (self.buf_len < 64) {
                return;
            }

            compress(self.h, self.w, self.buf, 0);
            self.buf_len = 0;
        }

        // Whole blocks are read straight from the input
        while (i + 64 <= n) {
            compress(self.h, self.w, bytes, i);
            i = i + 64;
        }

        // Keep the rest for later
        self.buf.memcpy(0, bytes, i, n - i);
        self.buf_len = n - i;
    }

    // Returns the digest of the message so far, as 32 bytes. The hasher is
    // left unchanged, so more data can still be appended afterwards.
    digest(self)
    {
        let h = self.h.slice(0, 8);

        // Padding is a 1 bit, zeros, then the length in bits as a 64-bit
        // big-endian number, which may spill into a second block
        let tail_len = self.buf_len < 56 ? 64 : 128;
        let tail = ByteArray.with_size(tail_len);
        tail.zero_fill();
        tail.memcpy(0, self.buf, 0, self.buf_len);
        tail[self.buf_len] = 0x80;

        let bit_len = self.msg_len * 8;
        for (let var i = 0; i < 8; ++i) {
            tail[tail_len - 1 - i] = (bit_len >> (i * 8)) & 0xFF;
        }

        for (let var offset = 0; offset < tail_len; offset = offset + 64) {
            compress(h, self.w, tail, offset);
        }

        let out = ByteArray.with_size(32);
        for (let var i = 0; i < 8; ++i) {
            out[i * 4] = h[i] >> 24;
            out[i * 4 + 1] = (h[i] >> 16) & 0xFF;
            out[i * 4 + 2] = (h[i] >> 8) & 0xFF;
            out[i * 4 + 3] = h[i] & 0xFF;
        }

        return out;
    }
}

// Returns the SHA-256 digest of a ByteArray or String, as 32 bytes
fun sha256(data)
{
    let hasher = SHA256();
    hasher.update(data);
    return hasher.digest();
}

// Formats bytes as a lowercase hexadecimal string, e.g. to print a digest
fun to_hex(bytes)
{
    let var s = "";
    for (let var i = 0; i < bytes.len; ++i) {
        s = s + bytes[i].to_hex(2).lower();
    }
    return s;
}

if (!$MAIN_UNIT) {
    return;
}

$println(to_hex(sha256("abc")));
