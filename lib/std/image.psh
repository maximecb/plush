// Images and colors
//
//   from image import Image, rgb;
//
//   let img = Image(640, 480);
//   img.fill_rect(10, 10, 100, 50, rgb(255, 0, 0));
//   $window_draw_frame(window, img.bytes);
//
// Pixel format:
//
// A color is a 32-bit integer 0xAARRGGBB: alpha in the top byte, then red,
// green and blue. Pixels are stored little-endian, so in memory each pixel
// is the 4 bytes B, G, R, A, lowest address first (BGRA32). This is the
// format $window_draw_frame() expects, so an image's bytes can be drawn to a
// window as they are.
//
// Pixels are stored row by row from the top-left corner, with no padding
// between rows. The pixel at (x, y) is at byte offset 4 * (y * width + x),
// or index y * width + x for get_u32() and set_u32().

let COLOR_BLACK     = 0xFF_00_00_00;
let COLOR_WHITE     = 0xFF_FF_FF_FF;
let COLOR_GREY      = 0xFF_80_80_80;
let COLOR_RED       = 0xFF_FF_00_00;
let COLOR_GREEN     = 0xFF_00_FF_00;
let COLOR_BLUE      = 0xFF_00_00_FF;
let COLOR_ORANGE    = 0xFF_FF_A5_00;
let COLOR_YELLOW    = 0xFF_FF_FF_00;
let COLOR_MAGENTA   = 0xFF_FF_00_FF;
let COLOR_PURPLE    = 0xFF_D6_00_FF;
let COLOR_TURQUOISE = 0xFF_40_E0_D0;
let COLOR_C64_BLUE  = 0xFF_09_40_DD;

// Classic 7-band ROYGBIV rainbow
let RAINBOW = [
    0xFF_FF_00_00,
    0xFF_FF_7F_00,
    0xFF_FF_FF_00,
    0xFF_00_FF_00,
    0xFF_00_00_FF,
    0xFF_4B_00_82,
    0xFF_94_00_D3,
];

// 12-band rainbow colors,
// with some colors modified to help with
// color vision deficiency and computer
// monitors with low color accuracy
let RAINBOW12 = [
    0xFF_97_1C_93,
    0xFF_51_24_CD,
    0xFF_05_51_FF,
    0xFF_00_93_93,
    0xFF_00_FA_00,
    0xFF_CB_FA_00,
    0xFF_FE_FB_00,
    0xFF_FE_C8_02,
    0xFF_FF_95_01,
    0xFF_FF_50_04,
    0xFF_FE_22_04,
    0xFF_D8_1D_52,
];

// Builds a color from components in [0, 255]
fun rgba(r, g, b, a) {
    return (a << 24) | (r << 16) | (g << 8) | b;
}

// Builds a fully opaque color from components in [0, 255]
fun rgb(r, g, b) {
    return (0xFF << 24) | (r << 16) | (g << 8) | b;
}

// Extract the components of a color
fun color_a(p) { return (p >> 24) & 0xFF; }
fun color_r(p) { return (p >> 16) & 0xFF; }
fun color_g(p) { return (p >>  8) & 0xFF; }
fun color_b(p) { return (p >>  0) & 0xFF; }

class Image
{
    init(self, width, height)
    {
        assert(width instanceof Int64);
        assert(height instanceof Int64);

        self.width = width;
        self.height = height;
        self.bytes = ByteArray.with_size(4 * width * height);
    }

    clear(self, color)
    {
        self.bytes.fill_u32(0, self.width * self.height, color);
    }

    get_pixel(self, x, y)
    {
        let idx = y * self.width + x;
        return(self.bytes.get_u32(idx));
    }

    set_pixel(self, x, y, color)
    {
        let idx = y * self.width + x;
        self.bytes.set_u32(idx, color);
    }

    // Copy a source image into this image at a given position, one
    // contiguous row at a time
    blit(self, src_img, dst_x, dst_y)
    {
        // Clip the destination rectangle against this image
        let x0 = (0).max(dst_x);
        let y0 = (0).max(dst_y);
        let x1 = self.width.min(dst_x + src_img.width);
        let y1 = self.height.min(dst_y + src_img.height);

        let row_bytes = (x1 - x0) * 4;
        if (row_bytes <= 0) return;

        for (let var y = y0; y < y1; ++y) {
            let dst_idx = (y * self.width + x0) * 4;
            let src_idx = ((y - dst_y) * src_img.width + (x0 - dst_x)) * 4;
            self.bytes.memcpy(dst_idx, src_img.bytes, src_idx, row_bytes);
        }
    }

    // Return a new image with other placed to the right of this one
    hcat(self, other)
    {
        assert(self.height == other.height);

        let out = Image(self.width + other.width, self.height);
        out.blit(self, 0, 0);
        out.blit(other, self.width, 0);
        return out;
    }

    // Return a new image with other placed below this one
    vcat(self, other)
    {
        assert(self.width == other.width);

        let out = Image(self.width, self.height + other.height);
        out.blit(self, 0, 0);
        out.blit(other, 0, self.height);
        return out;
    }

    // Return a new image holding a rectangular region of this one. Areas
    // outside of this image are left as transparent black.
    crop(self, x, y, w, h)
    {
        let out = Image(w, h);
        out.blit(self, -x, -y);
        return out;
    }

    // Return a new image mirrored left to right
    hflip(self)
    {
        let out = Image(self.width, self.height);
        let last = self.width - 1;

        for (let var y = 0; y < self.height; ++y) {
            let row = y * self.width;
            for (let var x = 0; x < self.width; ++x) {
                out.bytes.set_u32(row + x, self.bytes.get_u32(row + last - x));
            }
        }

        return out;
    }

    // Return a new image mirrored top to bottom
    vflip(self)
    {
        let out = Image(self.width, self.height);
        let pitch = self.width * 4;
        let last = self.height - 1;

        for (let var y = 0; y < self.height; ++y) {
            out.bytes.memcpy(y * pitch, self.bytes, (last - y) * pitch, pitch);
        }

        return out;
    }

    // Bresenham's algorithm
    draw_line(self, x0, y0, x1, y1, color) {
        let sx = (x0 < x1 ? 1 : -1);
        let sy = (y0 < y1 ? 1 : -1);
        let dx = (x1 - x0).abs();
        let dy = (y1 - y0).abs();

        let var err = dx - dy;
        let var x = x0;
        let var y = y0;

        loop {
            self.set_pixel(x, y, color);
            if (x == x1 && y == y1) {
                return;
            }

            let e2 = 2 * err;
            if (e2 > -dy) {
                err = err - dy;
                x = x + sx;
            }

            if (e2 < dx) {
                err = err + dx;
                y = y + sy;
            }
        }
    }

    // Draw a filled rectangle
    fill_rect(self, x, y, w, h, color)
    {
        let var rx = x;
        let var ry = y;
        let var rw = w;
        let var rh = h;

        // Clipping
        if (rx < 0) { rw = rw + rx; rx = 0; }
        if (ry < 0) { rh = rh + ry; ry = 0; }
        if (rx + rw > self.width) { rw = self.width - rx; }
        if (ry + rh > self.height) { rh = self.height - ry; }

        if (rw <= 0 || rh <= 0) { return; }

        for (let var j = 0; j < rh; ++j) {
            let idx = (ry + j) * self.width + rx;
            self.bytes.fill_u32(idx, rw, color);
        }
    }

    // Draw a filled circle
    fill_circle(self, x0, y0, r, color)
    {
        let var x = 0;
        let var y = r;
        let var d = 3 - 2 * r;

        while (y >= x) {
            self.fill_rect(x0 - y, y0 + x, 2 * y + 1, 1, color);
            self.fill_rect(x0 - y, y0 - x, 2 * y + 1, 1, color);
            self.fill_rect(x0 - x, y0 + y, 2 * x + 1, 1, color);
            self.fill_rect(x0 - x, y0 - y, 2 * x + 1, 1, color);

            x = x + 1;
            if (d > 0) {
                y = y - 1;
                d = d + 4 * (x - y) + 10;
            } else {
                d = d + 4 * x + 6;
            }
        }
    }
}

// Appends count pixels of a ByteArray of 32-bit pixels, starting at pixel
// index idx, to out as TGA run-length packets. Each packet holds up to 128
// pixels: either one pixel to repeat, or pixels stored as they are.
fun rle_encode_pixels(out, bytes, idx, count)
{
    let end = idx + count;
    let var i = idx;

    while (i < end) {
        let p = bytes.get_u32(i);
        let var n = 1;

        while (i + n < end && n < 128 && bytes.get_u32(i + n) == p) {
            n = n + 1;
        }

        if (n > 1) {
            out.push_u8(0x80 | (n - 1));
            out.push_u32(p);
            i = i + n;
            continue;
        }

        // Raw packet, up to where the next run starts
        let start = i;
        i = i + 1;
        while (i < end && i - start < 128) {
            if (i + 1 < end && bytes.get_u32(i) == bytes.get_u32(i + 1)) {
                break;
            }
            i = i + 1;
        }

        let num_bytes = (i - start) * 4;
        let pos = out.len + 1;
        out.push_u8(i - start - 1);
        out.resize(pos + num_bytes);
        out.memcpy(pos, bytes, start * 4, num_bytes);
    }
}

// Encodes an Image as the bytes of a 32-bit TGA file, run-length encoded
// if rle is true and uncompressed otherwise
fun encode_tga(img, rle)
{
    let out = ByteArray.with_size(18);
    out.zero_fill();

    // True-color, with 8 bits of alpha and rows stored top-down (0x20),
    // so the pixels can be written out in the order they are in
    out[2] = rle ? 10 : 2;
    out.store_u16(12, img.width);
    out.store_u16(14, img.height);
    out[16] = 32;
    out[17] = 0x28;

    if (!rle) {
        let num_bytes = img.width * img.height * 4;
        out.resize(18 + num_bytes);
        out.memcpy(18, img.bytes, 0, num_bytes);
        return out;
    }

    // Packets don't cross rows, as the TGA specification asks
    for (let var y = 0; y < img.height; ++y) {
        rle_encode_pixels(out, img.bytes, y * img.width, img.width);
    }

    return out;
}

// Decodes the bytes of a TGA file into an Image. Handles true-color images
// with 24 or 32 bits per pixel, uncompressed or run-length encoded. TGA
// stores pixels in BGRA byte order, the same format as Image. Returns nil
// if the data is not in one of these formats or is cut short.
fun decode_tga(data)
{
    if (data == nil || data.len < 18) {
        return nil;
    }

    let img_type = data[2];
    let width = data.load_u16(12);
    let height = data.load_u16(14);
    let bpp = data[16];
    let top_down = (data[17] & 0x20) != 0;
    let px = bpp.idiv(8);
    let num_pixels = width * height;

    if (data[1] != 0 || (img_type != 2 && img_type != 10) || (bpp != 24 && bpp != 32)) {
        return nil;
    }

    let img = Image(width, height);
    let dst = img.bytes;

    // Reads the pixel at a byte position. 24-bit pixels are made opaque.
    fun read_pixel(pos) {
        if (bpp == 32) {
            return data.load_u32(pos);
        }
        return 0xFF_00_00_00 | (data[pos + 2] << 16) | (data[pos + 1] << 8) | data[pos];
    }

    // Copies count pixels stored as they are at a byte position
    fun copy_pixels(idx, pos, count) {
        if (bpp == 32) {
            dst.memcpy(idx * 4, data, pos, count * 4);
            return;
        }
        for (let var i = 0; i < count; ++i) {
            dst.set_u32(idx + i, read_pixel(pos + i * 3));
        }
    }

    let var pos = 18 + data[0];

    if (img_type == 2) {
        if (data.len < pos + num_pixels * px) {
            return nil;
        }
        copy_pixels(0, pos, num_pixels);
    } else {
        let var idx = 0;

        while (idx < num_pixels) {
            if (pos >= data.len) {
                return nil;
            }

            let head = data[pos];
            let count = (head & 0x7F) + 1;
            let packed = (head & 0x80) != 0;
            let num_bytes = packed ? px : count * px;
            pos = pos + 1;

            if (idx + count > num_pixels || pos + num_bytes > data.len) {
                return nil;
            }

            if (packed) {
                dst.fill_u32(idx, count, read_pixel(pos));
            } else {
                copy_pixels(idx, pos, count);
            }

            pos = pos + num_bytes;
            idx = idx + count;
        }
    }

    // Rows are stored bottom-up unless the header says otherwise
    return top_down ? img : img.vflip();
}

// Reads a TGA file into an Image, see decode_tga() for the formats handled.
// Returns nil if the file can't be read or is not in one of these formats.
fun load_tga(path)
{
    return decode_tga($read_file(path));
}

// Writes an Image to a file as an uncompressed 32-bit TGA.
// Returns true on success and false on failure, like $write_file().
fun save_tga(path, img)
{
    return $write_file(path, encode_tga(img, false));
}

// Writes an Image to a file as a run-length encoded 32-bit TGA.
// Returns true on success and false on failure, like $write_file().
fun save_tga_rle(path, img)
{
    return $write_file(path, encode_tga(img, true));
}
