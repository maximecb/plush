// The codes of the first table of groups of four values that are -1, 0
// or 1, with a bit per value that isn't zero. The codes of the second
// table are the four bits, inverted.
let HUFF_QUAD = #[\x
    06 0B 06 0F 06 0D 06 0E 06 07 06 05 05 09 05 06 05 03 05 0A 05 0C 04 02
    04 01 04 04 04 08 01 00
